          {
            "if": { "compare_int": [ { "context_val": "var", "var_name": "if_input" }, "==", { "const": 0 } ] },
            "then": { "set_string_var": "zero", "target_var": { "global_val": "test_if_else_nested" } },
            "else": { "set_string_var": "negative", "target_var": { "global_val": "test_if_else_nested" } }
          }
        ]
      },
