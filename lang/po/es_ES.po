msgstr[1] "paraguas"
msgstr[2] "paraguas"

#. ~ Description of "umbrella"
#: data/json/items/tool/misc.json
msgid "An umbrella with a pointy end, useful for keeping dry when wielded."
msgstr ""
"Un paraguas con la punta puntiaguda, y si lo empuñas te va a mantener seco."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "vortex stone"
msgid_plural "vortex stones"
msgstr[0] "piedra vórtice"
msgstr[1] "piedras vórtices"
msgstr[2] "piedras vórtices"

#. ~ Description of "vortex stone"
#: data/json/items/tool/misc.json
msgid ""
"This is a stone with spirals all over it, and holes around its perimeter.  "
"Though it is fairly large, it weighs next to nothing.  Air seems to gather "
"around it."
msgstr ""
"Es una piedra con espirales por todas partes, y agujeros a lo largo de su "
"perímetro. Aunque es bastante grande, no pesa casi nada. El aire parece "
"juntarse alrededor de ella."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "sandbox kit"
msgid_plural "sandbox kits"
msgstr[0] "kit de arenero"
msgstr[1] "kits de areneros"
msgstr[2] "kits de areneros"

#. ~ Description of "sandbox kit"
#: data/json/items/tool/misc.json
msgid ""
"A plastic bucket holding a small spade and rake, perfect to build sand "
"castles!"
msgstr ""
"Un cubo de plástico con una pequeña pala y un rastrillo, ¡perfecto para "
"construir castillos de arena!"

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "whistle multitool"
msgid_plural "whistle multitools"
msgstr[0] "silbato multiherramienta"
msgstr[1] "silbatos multiherramienta"
msgstr[2] "silbatos multiherramienta"

#. ~ Description of "whistle multitool"
#: data/json/items/tool/misc.json
msgid ""
"A cheap gadget combining a whistle, thermometer, magnifying glass, and "
"compass."
msgstr ""
"Un artilugio barato que combina un silbato, un termómetro, una lupa y una "
"brújula."

#. ~ Description of "aluminum stepladder"
#: data/json/items/tool/misc.json
msgid "This is an aluminum stepladder.  Use it to set it down."
msgstr "Esto es una escalera de aluminio.  Úsala para montarla."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "handheld glass cutter"
msgid_plural "handheld glass cutters"
msgstr[0] "cortavidrios portátil"
msgstr[1] "cortavidrios portátiles"
msgstr[2] "cortavidrios portátiles"

#. ~ Description of "handheld glass cutter"
#: data/json/items/tool/misc.json
msgid ""
"A handheld tool used for controlled breaking of glass.  A necessity for any "
"glass cutting projects."
msgstr ""
"Una herramienta de mano utilizada para romper de manera controlada un "
"vidrio. Necesaria para cualquier proyecto que implique cortar vidrios."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "novelty pneumatic launcher"
msgid_plural "novelty pneumatic launchers"
msgstr[0] "lanzador neumático de juguete"
msgstr[1] "lanzadores neumáticos de juguete"
msgstr[2] "lanzadores neumáticos de juguete"

#. ~ Description of "novelty pneumatic launcher"
#: data/json/items/tool/misc.json
msgid ""
"This toy uses compressed air to launch small objects for the amusement of "
"children.  It is very tiring to reload, and completely ineffective as a "
"weapon.  Pump sold separately."
msgstr ""
"Este juguete utiliza aire comprimido para lanzar pequeños objetos para que "
"los niños se diviertan. Cuesta mucho recargar y es completamente ineficaz "
"como arma. La bomba se vende por separado."

