"A favorite tool of mutineers everywhere, this is a standard issue oxygen "
"candle deliberately tampered to explode upon activation.  Its fuse is "
"dangerously short, so you won't want to waste any time."
msgstr ""

#. ~ "menu_text" action message of item "oxygen bomb"
#: data/mods/Aftershock/items/grenades.json
msgid "Pull the pin"
msgstr ""

#. ~ "msg" action message of item "oxygen bomb"
#: data/mods/Aftershock/items/grenades.json
