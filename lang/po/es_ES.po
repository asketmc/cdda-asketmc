#. ~ Profession name for male
#: data/json/professions.json
msgctxt "profession_male"
msgid "Novice Martial Artist"
msgstr "Artista Marcial Novato"

#. ~ Description of profession "Novice Martial Artist" for male
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You've decided today is the day to take your first lesson at the local dojo."
"  You'll be great at it, you're sure of it."
msgstr ""
"Has decidido que hoy es el día de tu primera clase en el dojo local. Lo "
"harás muy bien, estás seguro de ello."

