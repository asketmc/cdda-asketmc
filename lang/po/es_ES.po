msgstr "Recordar para olvidar. Olvidar para recordar."

#. ~ Snippet in category "lab_postit_portal"
#: data/json/snippets/lab.json
msgid "Scream at Maintenance for a replacement again"
msgstr "Grita a Mantenimiento para que te reemplacen de nuevo."

#. ~ Snippet in category "lab_postit_tech"
#: data/json/snippets/lab.json
