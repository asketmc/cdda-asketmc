msgid_plural "injectable irons"
msgstr[0] "hierro inyectable"
msgstr[1] "hierro inyectables"
msgstr[2] "hierro inyectables"

#. ~ Description of "injectable iron"
#: data/json/items/comestibles/med.json
msgid ""
"A small vial of dark yellow liquid containing soluble iron for injection."
msgstr ""
"Pequeño vial de líquido amarillo oscuro que contiene hierro soluble "
"inyectable."

#. ~ "activation_message" action message of item "injectable iron"
#: data/json/items/comestibles/med.json
