msgstr[1] "analgesicos de amapola"
msgstr[2] "analgesicos de amapola"

#. ~ Description of "poppy painkiller"
#: data/json/items/comestibles/med.json
msgid ""
"A potent opioid palliative produced by the refining of the mutated poppy.  "
"Notably devoid of euphoric or sedative effects, but as an opiate it can "
"still be addictive."
msgstr ""
"Paliativo opiáceo potente producido mediante la refinación de la amapola "
"mutada. Aunque carece de efectos eufóricos o sedantes, como opiáceo puede "
"ser adictivo."

#. ~ "activation_message" action message of item "poppy painkiller"
#: data/json/items/comestibles/med.json
msgid "You take some poppy painkiller."
msgstr "Te tomas un analgésico de amapola."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "poppy sleep"
msgid_plural "poppy sleeps"
msgstr[0] "somnifero de amapola"
msgstr[1] "somniferos de amapola"
msgstr[2] "somniferos de amapola"

#. ~ Description of "poppy sleep"
#: data/json/items/comestibles/med.json
msgid ""
"A potent sleep aid extracted from mutated poppy seeds.  Effective, but as an"
" opiate it can be addictive."
msgstr ""
"Un somnífero potente extraído de semillas mutadas de amapola. Efectivas, "
"pero como es un opiáceo, puede ser adictivo."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "poppy cough syrup"
