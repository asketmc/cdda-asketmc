msgid_plural "Chihuahuas"
msgstr[0] "Chihuahua"
msgstr[1] "Chihuahuas"
msgstr[2] "Chihuahuas"

#. ~ Description of monster "Chihuahua"
#: data/json/monsters/mammal.json
msgid ""
"It's a tiny Chihuahua.  How it has managed to survive is a miracle, although"
" its small size and aggressive nature may have proven useful."
msgstr ""
"Es un pequeño Chihuahua. La forma en que ha logrado sobrevivir es un "
"milagro, aunque su pequeño tamaño y su naturaleza agresiva pueden haber sido"
" útiles."

#. ~ Monster name
#: data/json/monsters/mammal.json
msgid "Chihuahua puppy"
msgid_plural "Chihuahua puppies"
msgstr[0] "cachorro de Chihuahua"
