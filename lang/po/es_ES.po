#. ~ Profession name for male
#: data/json/professions.json
msgctxt "profession_male"
msgid "Bhikkhu"
msgstr "Bhikkhu"

#. ~ Description of profession "Bhikkhu" for male
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"Your life was simple at the Vihara, doing household chores and meditating.  "
"Your Sangha wanted to attain liberation from suffering, now their rotting "
"corpses will suffer forever."
msgstr ""
"Tu vida era sencilla en el Vihara, haciendo tareas domésticas y meditando. "
"Tu Sangha quería alcanzar la liberación del sufrimiento, ahora sus cadáveres"
" podridos sufrirán para siempre."

#. ~ Profession name for female
#: data/json/professions.json
msgctxt "profession_female"
msgid "Bhikkhuni"
msgstr "Bhikkhuni"

#. ~ Description of profession "Bhikkhuni" for female
