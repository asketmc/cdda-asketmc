msgstr[2] "arañas de goma"

#. ~ Description of monster "gum spider"
#: data/mods/My_Sweet_Cataclysm/sweet_monsters.json
msgid ""
"A giant piece of gum stretched in the shape of a spider.  You'd best not get"
" gummed up in its web, literally."
msgstr ""
"Un chicle gigante estirado en forma de araña. Será mejor que no te quedes "
"pringado en su tela, literalmente."

#. ~ Monster name
#: data/mods/My_Sweet_Cataclysm/sweet_monsters.json
msgid "caffeinated gum spider"
msgid_plural "caffeinated gum spiders"
msgstr[0] "araña de gominola con cafeína"
msgstr[1] "arañas de gominola con cafeína"
msgstr[2] "arañas de gominola con cafeína"

#. ~ Description of monster "caffeinated gum spider"
#: data/mods/My_Sweet_Cataclysm/sweet_monsters.json
msgid ""
"A giant piece of gum stretched in the shape of a spider.  It jitters and "
"darts about rapidly as if it had too much energy to stand still."
msgstr ""
"Un chicle gigante estirado en forma de araña. Se agita y se mueve "
"rápidamente como si tuviera demasiada energía para quedarse quieta."

#. ~ Monster name
#: data/mods/My_Sweet_Cataclysm/sweet_monsters.json
