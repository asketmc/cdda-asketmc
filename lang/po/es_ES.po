#. ~ Monster name
#: data/json/monsters/defense_bot.json
msgid "M202A1 autonomous TALON UGV"
msgid_plural "M202A1 autonomous TALON UGVs"
msgstr[0] "TALÓN UGV M202A1 autonomo"
msgstr[1] "TALÓN UGV M202A1 autonomos"
msgstr[2] "TALÓN UGV M202A1 autonomos"

#. ~ Description of monster "M202A1 autonomous TALON UGV"
#: data/json/monsters/defense_bot.json
msgid ""
"A TALON unmanned ground vehicle equipped with an M202A1 FLASH.  It is a "
"small tracked UGV with an array of motors and sensors covering its weapon "
"mount."
msgstr ""
"Un vehículo terrestre no tripulado TALON equipado con un M202A1 FLASH. Es un"
" pequeño UGV de orugas con un conjunto de motores y sensores que cubren la "
"montura de su arma."

#. ~ Monster name
#: data/json/monsters/defense_bot.json
msgid "autonomous TALON UGV Liberty Edition"
msgid_plural "autonomous TALON UGV Liberty Editions"
msgstr[0] "TALON UGV autónomo Edición Libertad"
msgstr[1] "TALON UGV autónomos Ediciones Libertad"
msgstr[2] "TALON UGV autónomos Ediciones Libertad"

#. ~ Description of monster "autonomous TALON UGV Liberty Edition"
#: data/json/monsters/defense_bot.json
msgid ""
"A TALON unmanned ground vehicle equipped with a fireworks cannon in place of"
" its usual M16A4.  It is a small tracked UGV with an array of motors and "
"sensors covering its weapon mount.  This one has been plastered with an "
"american flag decal."
msgstr ""
"Un vehículo terrestre no tripulado TALON equipado con un cañón de fuegos "
"artificiales en lugar de la típica M16A4. Es un pequeño UGV oruga con un "
"conjunto de motores y sensores que cubren la montura del arma. Este ha sido "
"cubierto con una calcomanía de la bandera estadounidense."

#. ~ Death message of monster "autonomous TALON UGV Liberty Edition"
#: data/json/monsters/defense_bot.json
#, c-format
msgid "Loud rock music blares as the %s explodes!"
msgstr "¡La música de rock suena a todo volumen mientras %s  explota!"

#. ~ Description of special attack of monster "autonomous TALON UGV Liberty
#. Edition"
#: data/json/monsters/defense_bot.json
msgid "Fireworks explode out of the turret!"
msgstr "¡Los fuegos artificiales explotan fuera de la torreta!"

#. ~ Targeting sound of special attack of monster "autonomous TALON UGV
#. Liberty Edition"
#: data/json/monsters/defense_bot.json
msgid "\"Proud to be an American.\""
msgstr "\"Orgulloso de ser Americano\"."

#. ~ No ammo sound of special attack of monster "autonomous TALON UGV Liberty
#. Edition"
#: data/json/monsters/defense_bot.json
msgid "an igniter clicks rapidly!"
msgstr "¡un encendedor hace clic rápidamente!"

#. ~ Monster name
#: data/json/monsters/defense_bot.json
msgid "skitterbot"
msgid_plural "skitterbots"
msgstr[0] "arañabot"
msgstr[1] "arañabots"
msgstr[2] "arañabots"

#. ~ Description of monster "skitterbot"
#: data/json/monsters/defense_bot.json
msgid ""
"An insectoid robot the size of a small dog, designed for home security.  "
"Armed with two close-range tazers, it can skate across the ground with great"
" speed."
msgstr ""
"Un robot insectoide del tamaño de un perro chico, diseñado para la seguridad"
" en el hogar. Armado con dos pistolas eléctricas de corto alcance, puede "
"deslizarse por el suelo a gran velocidad."

#. ~ Monster name
#: data/json/monsters/defense_bot.json
msgid "experimental lab bot"
msgid_plural "experimental lab bots"
msgstr[0] "robot de laboratorio experimental"
msgstr[1] "robots de laboratorio experimental"
msgstr[2] "robots de laboratorio experimental"

#. ~ Description of monster "experimental lab bot"
#: data/json/monsters/defense_bot.json
msgid ""
"This robot looks like a large metal spider, a bit bigger than a person, with"
" its thorax covered in tiny holes.  An ominous buzzing emanates from it."
msgstr ""
"Este robot parece una gran araña de metal, un poco más grande que una "
"persona, con su tórax cubierto de pequeños agujeros. Un zumbido ominoso "
"emana de ella."

#. ~ Monster name
#: data/json/monsters/defense_bot.json
msgid "prototype robot"
msgid_plural "prototype robots"
msgstr[0] "robot prototipo"
msgstr[1] "robots prototipos"
msgstr[2] "robots prototipos"

#. ~ Description of monster "prototype robot"
#: data/json/monsters/defense_bot.json
msgid ""
"This robot's single, glowing eye surveys the landscape periodically as it "
"performs the endless slaughter dictated by a misinterpreted and cruel "
"routine.  Between half-built plates, you can see the machinery and cables "
"that animate it, and yet it moves deftly as it switches between one target "
"and the next."
msgstr ""
"El ojo único y brillante de este robot observa periódicamente el paisaje "
"mientras realiza la interminable matanza dictada por una rutina mal "
"interpretada y cruel. Entre las placas a medio construir, se puede ver la "
"maquinaria y los cables que lo animan y, sin embargo, se mueve con destreza "
"mientras cambia de un objetivo a otro."

#. ~ Monster name
#: data/json/monsters/defense_bot.json
msgid "NR-031 Dispatch"
msgid_plural "NR-031 Dispatches"
msgstr[0] "NR-031 despachador"
msgstr[1] "NR-031 despachadores"
msgstr[2] "NR-031 despachadores"

#. ~ Description of monster "NR-031 Dispatch"
#: data/json/monsters/defense_bot.json
msgid ""
"The Northrop Dispatch, designed for crowd control situations, carries and "
"deploys kamikaze drones of various types.  The bright green-and-yellow paint"
" marks a low-force variant - *comparatively* low-force, anyways - typically "
"deployed as guards after an area has been cleared."
msgstr ""
"El despachador Northrop, diseñado para situaciones de control de multitudes,"
" transporta y despliega drones kamikaze de varios tipos. La pintura verde y "
"amarilla brillante marca una variante de baja fuerza - *comparativamente* "
"baja fuerza, de todos modos- típicamente desplegada como guardias después de"
" que un área ha sido despejada."

#. ~ Monster name
#: data/json/monsters/defense_bot.json
msgid "NR-V05-M Dispatch"
msgid_plural "NR-V05-M Dispatches"
msgstr[0] "NR-V05-M despachador"
msgstr[1] "NR-V05-M despachadores"
msgstr[2] "NR-V05-M despachadores"

#. ~ Description of monster "NR-V05-M Dispatch"
#: data/json/monsters/defense_bot.json
msgid ""
"The Northrop Dispatch, designed for crowd control situations, carries and "
"deploys kamikaze drones of various types.  The dark green paint job marks "
"the lethal and feared military variant, carrying extreme and deadly "
"firepower."
msgstr ""
"El Despacho Northrop, diseñado para situaciones de control de multitudes, "
"transporta y despliega drones kamikaze de varios tipos. La pintura verde "
"oscuro marca la letal y temida variante militar, que lleva una potencia de "
"fuego extrema y mortal."

#. ~ Monster name
#: data/json/monsters/drones.json
msgid "autonomous drone"
msgid_plural "autonomous drones"
msgstr[0] "dron autónomo"
msgstr[1] "drones autónomos"
msgstr[2] "drones autónomos"

#. ~ Death message of monster "autonomous drone"
#: data/json/monsters/drones.json
#, c-format
msgid "The %s's interior compartment sizzles with destructive energy."
msgstr ""
"Los compartimientos interiores del %s chisporrotean por la energía "
"destructiva."

#. ~ Monster name
#: data/json/monsters/drones.json
msgid "EMP hack"
msgid_plural "EMP hacks"
msgstr[0] "hack EMP"
msgstr[1] "hacks EMP"
msgstr[2] "hacks EMP"

#. ~ Description of monster "EMP hack"
#: data/json/monsters/drones.json
msgid ""
"An automated kamikaze drone, this small quadcopter robot appears to have an "
"EMP grenade inside."
msgstr ""
"Un dron kamikaze automatizado, este pequeño robot cuadricóptero parece tener"
" una granada EMP en su interior."

#. ~ Monster name
#: data/json/monsters/drones.json
msgid "C-4 hack"
msgid_plural "C-4 hacks"
msgstr[0] "hack C-4"
msgstr[1] "hacks C-4"
msgstr[2] "hacks C-4"

#. ~ Description of monster "C-4 hack"
#: data/json/monsters/drones.json
msgid ""
"An automated kamikaze drone, this small quadcopter robot appears to have "
"some C-4 inside."
msgstr ""
"Un dron kamikaze automatizado, este pequeño robot cuadricóptero parece tener"
" algo de C-4 en su interior."

#. ~ Monster name
#: data/json/monsters/drones.json
msgid "flashbang hack"
msgid_plural "flashbang hacks"
msgstr[0] " hack explosión cegadora"
msgstr[1] " hacks explosión cegadora"
msgstr[2] " hacks explosión cegadora"

#. ~ Description of monster "flashbang hack"
#: data/json/monsters/drones.json
msgid ""
"An automated kamikaze drone, this small quadcopter robot appears to have a "
"flashbang inside."
msgstr ""
"Un dron kamikaze automatizado, este pequeño robot cuadricóptero parece tener"
" una granada cegadora en su interior."

#. ~ Monster name
#: data/json/monsters/drones.json
msgid "tear gas hack"
msgid_plural "tear gas hacks"
msgstr[0] "hack gas lacrimógeno"
msgstr[1] "hacks gas lacrimógeno"
msgstr[2] "hacks gas lacrimógeno"

#. ~ Description of monster "tear gas hack"
#: data/json/monsters/drones.json
msgid ""
"An automated kamikaze drone, this small quadcopter robot appears to have a "
"tear gas canister inside."
msgstr ""
"Un dron kamikaze automatizado, este pequeño robot cuadricóptero parece tener"
" un contenedor de gas lacrimógeno en su interior."

#. ~ Monster name
#: data/json/monsters/drones.json
msgid "grenade hack"
msgid_plural "grenade hacks"
msgstr[0] "hack granada"
msgstr[1] "hacks granada"
msgstr[2] "hacks granada"

#. ~ Description of monster "grenade hack"
#: data/json/monsters/drones.json
msgid ""
"An automated kamikaze drone, this small quadcopter robot appears to have a "
"grenade inside."
msgstr ""
"Un dron kamikaze automatizado, este pequeño robot cuadricóptero parece tener"
" una granada en su interior."

#. ~ Monster name
#: data/json/monsters/drones.json
msgid "manhack"
msgid_plural "manhacks"
msgstr[0] "manhack"
msgstr[1] "manhacks"
msgstr[2] "manhacks"

#. ~ Description of monster "manhack"
#: data/json/monsters/drones.json
msgid ""
"An automated anti-personnel drone, a small quadcopter robot surrounded by "
"whirring blades."
msgstr ""
"Un dron antipersona automatizado, un pequeño robot cuadricóptero rodeado de "
"cuchillas zumbantes."

#. ~ Monster name
#: data/json/monsters/drones.json
msgid "mininuke hack"
msgid_plural "mininuke hacks"
msgstr[0] "hack mininuke"
msgstr[1] "hacks mininuke"
msgstr[2] "hacks mininuke"

#. ~ Description of monster "mininuke hack"
#: data/json/monsters/drones.json
msgid ""
"Many times as large as a normal manhack, this flying quadcopter drone "
"appears to have a mininuke inside.  If this is targeting you… run."
msgstr ""
"Muchas veces más grande que una manhack normal, este avión teledirigido "
"parece tener un mininuke en su interior. Si esto te está apuntando... Corre."

#. ~ Monster name
#: data/json/monsters/drones.json
msgid "balloon sniper-drone"
msgid_plural "balloon sniper-drones"
msgstr[0] "globo francotiradore-dron"
msgstr[1] "globos francotiradore-dron"
msgstr[2] "globos francotiradore-dron"

#. ~ Description of monster "balloon sniper-drone"
#: data/json/monsters/drones.json
msgid ""
"This unusual contraption looks like a combination of a weather balloon and a"
" quadcopter.  Beneath the crude box containing its components hangs a small "
"articulated rig wielding an integrated rifle.  Its propellers flicker to "
"life briefly, then shut down again, keeping it mostly stationary despite the"
" air currents.  It looks capable of hanging in the air for quite a long time"
" before running out of power."
msgstr ""
"Este inusual artilugio parece una combinación de un globo meteorológico y un"
" cuadricóptero. Debajo de la caja cruda que contiene sus componentes cuelga "
"un pequeño aparejo articulado con un rifle integrado. Sus hélices parpadean "
"brevemente y luego se apagan de nuevo, manteniéndolo casi inmóvil a pesar de"
" las corrientes de aire. Parece capaz de permanecer en el aire durante mucho"
" tiempo antes de quedarse sin energía."

#. ~ No ammo sound of special attack of monster "balloon sniper-drone"
#: data/json/monsters/drones.json
msgid "tick!"
msgstr "¡tick!"

#. ~ Monster name
#: data/json/monsters/drones.json
msgid "tazer hack"
msgid_plural "tazer hacks"
msgstr[0] "tazer-hack"
msgstr[1] "tazer-hacks"
msgstr[2] "tazer-hacks"

#. ~ Description of monster "tazer hack"
#: data/json/monsters/drones.json
msgid ""
"An automated drone, this small quadcopter robot appears to have a tazer "
"strapped to the front.  While extremely fast, it is very fragile."
msgstr ""
"Un dron automatizado, este pequeño robot cuadricóptero parece tener un tazer"
" sujeto a la parte delantera. Aunque es extremadamente rápido, es muy "
"frágil."

#. ~ Monster name
#: data/json/monsters/feral_humans.json
msgid "feral human"
msgid_plural "feral humans"
msgstr[0] "humano salvaje"
msgstr[1] "humanos salvajes"
msgstr[2] "humanos salvajes"

#. ~ Description of monster "feral human"
#: data/json/monsters/feral_humans.json
msgid ""
"Their pupils are dilated and what can be seen of the iris and sclera are "
"bloodshot.  This pipe-wielding maniac still breathes, but the zombies treat "
"them like one of their own."
msgstr ""
"Sus pupilas están dilatadas y lo que queda visible del iris y la esclerótica"
" parecen ensangrentadan. Este maníaco que empuña la tubería todavía respira,"
" pero los zombis lo tratan como a uno de los suyos."

#. ~ Description of special attack of monster "feral human"
#: data/json/monsters/feral_humans.json
msgid "The feral human throws a rock!"
msgstr "¡El humano salvaje lanza una piedra!"

#. ~ Monster name
#: data/json/monsters/feral_humans.json
msgid "cunning feral"
msgid_plural "cunning ferals"
msgstr[0] "salvaje astuto"
msgstr[1] "salvajes astutos"
msgstr[2] "salvajes astutos"

#. ~ Description of monster "cunning feral"
#: data/json/monsters/feral_humans.json
msgid ""
"This feral human's eyes look more focused, and its movements steadier, than "
"others of their kind.  They're carrying a crude spear, and have assembled "
"some basic armor from scavenged clothing and bits of riot armor, though you "
"can see several gaps.  Despite these signs of greater intelligence, this "
"creature is still only a few steps away from being a zombie themself."
msgstr ""
"Los ojos de este humano salvaje parecen más concentrados, y sus movimientos "
"más firmes, que los de otros de su clase. Lleva una lanza rudimentaria y ha "
"montado una armadura básica con ropas rebuscadas y trozos de armadura "
"antidisturbios, aunque se pueden ver varias lagunas. A pesar de estos signos"
" de mayor inteligencia, esta criatura está a pocos pasos de ser un zombi en "
"sí mismo."

#. ~ Monster name
#: data/json/monsters/feral_humans.json
msgid "feral troglobite"
msgid_plural "feral troglobites"
msgstr[0] "troglobita salvaje"
msgstr[1] "troglobitas salvajes"
msgstr[2] "troglobitas salvajes"

#. ~ Description of monster "feral troglobite"
#: data/json/monsters/feral_humans.json
msgid ""
"This person is still alive but completely crazed, changed by something they "
"are exposed to down here.  Their face is dominated by unnaturally large, "
"faintly glowing eyes and needle-sharp teeth poking through their lips.  They"
" remind you of something out of a campy monster movie - and of the good "
"times when underground cannibals were less of a real concern."
msgstr ""
"Esta persona sigue viva, pero está completamente enloquecida, cambiada por "
"algo a lo que se expuso aquí abajo. Su rostro está dominado por unos ojos "
"anormalmente grandes y débilmente brillantes y unos dientes afilados como "
"agujas que asoman por los labios. Recuerdan a algo sacado de una película de"
" monstruos, y a los buenos tiempos en los que los caníbales subterráneos no "
"eran una preocupación real."

#. ~ Description of monster "mon_feral_human_crowbar"
#: data/json/monsters/feral_humans.json
msgid ""
"Their pupils are dilated and what can be seen of the iris and sclera are "
"bloodshot.  This crowbar-wielding maniac still breathes, but the zombies "
"treat them like one of their own."
msgstr ""
"Sus pupilas están dilatadas y lo que queda visible del iris y la esclerótica"
" parecen ensangrentadan. Este maníaco que empuña una palanca todavía "
"respira, pero los zombis lo tratan como a uno de los suyos."

#. ~ Monster name
#: data/json/monsters/feral_humans.json
msgid "deranged axeman"
msgid_plural "deranged axemen"
msgstr[0] "leñador loco"
msgstr[1] "leñadores locos"
msgstr[2] "leñadores locos"

#. ~ Description of monster "deranged axeman"
#: data/json/monsters/feral_humans.json
msgid ""
"They stumble along dragging a large bloodstained axe.  Their face is twisted"
" into a sadistic grin, and they walk among the dead as though already one of"
" them."
msgstr ""
"Avanza a tropezones arrastrando un gran hacha manchada de sangre. Su cara "
"está retorcida en un gesto sádico y camina entre los muertos como si ya "
"fuera uno de ellos."

#. ~ Monster name
#: data/json/monsters/feral_humans.json
msgid "feral mechanic"
msgid_plural "feral mechanics"
msgstr[0] "mecánico salvaje"
msgstr[1] "mecánicos salvajes"
msgstr[2] "mecánicos salvajes"

#. ~ Description of monster "feral mechanic"
#: data/json/monsters/feral_humans.json
msgid ""
"This wild human-like creature was probably a mechanic before the Cataclysm."
"  You can see it by his worker uniform, or by his blood-covered hammer in "
"hand, or by his all-hating view."
msgstr ""
"Esta criatura salvaje aparentemente humana fue probablemente un mecánico "
"antes del Cataclismo. Puedes verlo en su uniforme de trabajo, en su martillo"
" cubierto de sangre, o por su vista odiosa."

#. ~ Description of monster "mon_feral_human_pipe_fungal_corpse"
#: data/json/monsters/feral_humans.json
msgid ""
"Delicate fungal stalks sprout in rows from sores covering this person's "
"body, and their facial expression is pure agony."
msgstr ""
"Delicados tallos de hongos brotan en hileras de las llagas que cubren el "
"cuerpo de esta persona, y su expresión facial es pura agonía."

#. ~ Description of monster "mon_feral_human_crowbar_fungal_corpse"
#: data/json/monsters/feral_humans.json
msgid ""
"Delicate fungal stalks sprout in rows from sores on this person's arms, and "
"their facial expression is pure agony.  Their mouth opens and closes softly "
"in a silent moan."
msgstr ""
"Delicados tallos de hongos brotan en hileras de las llagas en los brazos de "
"esta persona, y su expresión facial es pura agonía. Su boca se abre y se "
"cierra suavemente en un gemido silencioso."

#. ~ Description of monster "mon_feral_human_axe_fungal_corpse"
#: data/json/monsters/feral_humans.json
msgid ""
"Delicate fungal stalks sprout in rows from sores on this person's arms, and "
"their facial expression is pure agony."
msgstr ""
"Delicados tallos de hongos brotan en hileras de las llagas en los brazos de "
"esta persona, y su expresión facial es pura agonía."

#. ~ Monster name
#: data/json/monsters/feral_humans.json
msgid "mad scientist"
msgid_plural "mad scientists"
msgstr[0] "científico loco"
msgstr[1] "científicos locos"
msgstr[2] "científicos locos"

#. ~ Description of monster "mad scientist"
#: data/json/monsters/feral_humans.json
msgid ""
"A researcher who has stared too long into the abyss, and now shambles about "
"muttering nonsense under their breath.  For some reason, the zombies don't "
"seem to mind that this person is obviously still alive.  They're clutching a"
" tiny but razor-sharp blade in one shaky hand."
msgstr ""
"Un investigador que ha mirado demasiado tiempo al abismo, y que ahora se "
"tambalea murmurando sin sentidos bajo su respiración. Por alguna razón, a "
"los zombis no parece importarles que esta persona esté obviamente viva. Los "
"suyos sostienen una hoja diminuta pero afilada en su mano temblorosa."

#. ~ Monster name
#: data/json/monsters/feral_humans.json
msgid "feral security guard"
msgid_plural "feral security guards"
msgstr[0] "guardia de seguridad salvaje"
msgstr[1] "guardias de seguridad salvajes"
msgstr[2] "guardias de seguridad salvajes"

#. ~ Description of monster "feral security guard"
#: data/json/monsters/feral_humans.json
msgid ""
"This security guard still breathes, but has been lost to some terrible "
"madness.  They move among the undead, handgun at the ready and saucer pupils"
" scanning for threats in a mockery of their former duty."
msgstr ""
"Este guardia de seguridad aún respira, pero se ha perdido en medio de una "
"terrible locura. Los suyos se mueven entre los muertos vivientes, con la "
"pistola en ristre y las pupilas en forma de platillos escudriñando en busca "
"de amenazas en un remedo de su antiguo deber."

#. ~ Description of special attack of monster "feral security guard"
#: data/json/monsters/feral_humans.json
msgid "The feral security guard fires their Beretta M9A1!"
msgstr "¡El guardia de seguridad salvaje dispara su Beretta M9A1!"

#. ~ Description of monster "mon_feral_labsecurity_flashlight"
#: data/json/monsters/feral_humans.json
msgid ""
"At first glance, this disheveled figure could almost pass for a survivor, "
"but the bloodshot eyes give them away as one of the humans who have gone "
"feral and joined the undead without dying.  Their uniform suggests that this"
" was at some point a security guard, and they still carry a stun gun and a "
"heavy-duty flashlight that looks like it could easily double as a club."
msgstr ""
"A primera vista, esta figura desaliñada casi podría pasar por un "
"superviviente, pero los ojos inyectados en sangre lo delatan como uno de los"
" humanos que se han vuelto salvajes y se han unido a los no muertos sin "
"morir. Su uniforme sugiere que en algún momento fue un guardia de seguridad,"
" y todavía lleva una pistola de aturdimiento y una linterna de gran potencia"
" que parece que podría servir de garrote."

#. ~ Monster name
#: data/json/monsters/feral_humans.json
msgid "feral servant"
msgid_plural "feral servants"
msgstr[0] "sirviente salvaje"
msgstr[1] "sirvientes salvajes"
msgstr[2] "sirvientes salvajes"

#. ~ Description of monster "feral servant"
#: data/json/monsters/feral_humans.json
msgid ""
"Once a fancy servant of some rich family, this maniac walks around with a "
"broom in hand, searching for a victim to sweep off this mortal coil."
msgstr ""
"Este maníaco, que en su día fue un elegante sirviente de alguna familia "
"rica, se pasea con una escoba en la mano en busca de una víctima a la que "
"barrer de este mundo mortal."

#. ~ Description of monster "feral servant"
#: data/json/monsters/feral_humans.json
msgid ""
"Once a fancy servant of some rich family, this maniac walks around with a "
"candlestick in hand, ready to snuff out your life."
msgstr ""
"Este maníaco, que en su día fue un elegante sirviente de alguna familia "
"rica, se pasea con un candelabro en la mano, dispuesto a apagar tu vida."

#. ~ Description of monster "feral servant"
#: data/json/monsters/feral_humans.json
msgid ""
"Once a fancy servant of some rich family, this maniac walks around with a "
"knife in hand, searching for some victims to butcher."
msgstr ""
"Este maníaco, que en su día fue un lujoso sirviente de alguna familia rica, "
"se pasea con un cuchillo en la mano en busca de algunas víctimas a las que "
"descuartizar."

#. ~ Monster name
#: data/json/monsters/feral_humans.json
msgid "well dressed feral"
msgid_plural "well dressed ferals"
msgstr[0] "salvaje bien vestido"
msgstr[1] "salvajes bien vestidos"
msgstr[2] "salvajes bien vestidos"

#. ~ Description of monster "well dressed feral"
#: data/json/monsters/feral_humans.json
msgid ""
"Wearing fancy clothes and with a rapier in hand, this maniac was once a "
"socialite.  They smile with madness and seem like they want to invite you to"
" dinner."
msgstr ""
"Con ropas elegantes y una espada ropera en la mano, este maníaco fue una vez"
" una persona de la alta sociedad. Sonríe con locura y parece que quiera "
"invitarte a cenar."

#. ~ Description of monster "well dressed feral"
#: data/json/monsters/feral_humans.json
msgid ""
"Wearing fancy clothes and with a crossbow in hand, this maniac was once a "
"socialite.  Their hands caress the crossbow as if touching a loved one."
msgstr ""
"Con ropas elegantes y una ballesta en la mano, este maníaco fue una vez una "
"persona de la alta sociedad. Sus manos acarician la ballesta como si tocaran"
" a un ser querido."

#. ~ Description of special attack of monster "well dressed feral"
#: data/json/monsters/feral_humans.json
msgid "The feral human shoots its crossbow!"
msgstr "¡El humano salvaje dispara su ballesta!"

#. ~ Monster name
#: data/json/monsters/feral_humans.json
msgid "armored feral"
msgid_plural "armored ferals"
msgstr[0] "salvaje armado"
msgstr[1] "salvajes armados"
msgstr[2] "salvajes armados"

#. ~ Description of monster "armored feral"
#: data/json/monsters/feral_humans.json
msgid ""
"Clad in ancient armor and with a mace in hand, this maniac walks around in "
"search of their next prey.  You can see stains of dried blood all over their"
" mace."
msgstr ""
"Vestido con una armadura antigua y con una maza en la mano, este maníaco "
"camina en busca de su próxima presa. Se pueden ver manchas de sangre seca "
"por toda su maza."

#. ~ Description of monster "armored feral"
#: data/json/monsters/feral_humans.json
msgid ""
"Clad in ancient armor and with a battle axe in hand, this maniac walks "
"around in search of their next prey.  You can see stains of dried blood all "
"over their axe."
msgstr ""
"Vestido con una armadura antigua y con un hacha de batalla en la mano, este "
"maníaco camina en busca de su próxima presa. Se pueden ver manchas de sangre"
" seca por todo su hacha."

#. ~ Monster name
#: data/json/monsters/feral_humans.json
msgid "feral prepper"
msgid_plural "feral preppers"
msgstr[0] "preparador salvaje"
msgstr[1] "preparadores salvajes"
msgstr[2] "preparadores salvajes"

#. ~ Description of monster "feral prepper"
#: data/json/monsters/feral_humans.json
msgid ""
"A quick glance at this person would suggest that they have prepared well "
"enough for the apocalypse.  Unfortunately, their bloodshot eyes, and the "
"excluding treatment by the undead, shows that they have turned feral.  One "
"of their hands clasps the handle of a makeshift weapon, while the other "
"grips a handgun."
msgstr ""
"Un rápido vistazo a esta persona sugeriría que se ha preparado bastante bien"
" para el apocalipsis. Por desgracia, sus ojos inyectados en sangre, y el "
"trato excluyente de los no muertos, demuestran que se ha vuelto salvaje. Una"
" de sus manos agarra el mango de un arma improvisada, mientras que la otra "
"empuña una pistola."

#. ~ Description of special attack of monster "feral prepper"
#: data/json/monsters/feral_humans.json
msgid "The feral prepper haphazardly fires their firearm!"
msgstr "¡El preparador salvaja dispara su arma de fuego al azar!"

#. ~ Monster name
#: data/json/monsters/feral_humans.json
msgid "crazed survivalist"
msgid_plural "crazed survivalists"
msgstr[0] "supervivencialista loco"
msgstr[1] "supervivencialistas locos"
msgstr[2] "supervivencialistas locos"

#. ~ Description of monster "crazed survivalist"
#: data/json/monsters/feral_humans.json
msgid ""
"Grasping a sharp bladed weapon, this feral prepper has an athletic physique,"
" a sign that they trained extensively before turning feral.  In addition to "
"remembering how to use a flashlight, their survival instincts seem to kick "
"in when critically harmed, causing them to act in self-preservation unlike "
"most of their fellows."
msgstr ""
"Agarrando un arma afilada, este preparador salvaje tiene un físico atlético,"
" señal de que se entrenó mucho antes de volverse salvaje. Además de recordar"
" cómo usar una linterna, su instinto de supervivencia parece activarse "
"cuando sufre un daño crítico, lo que hace que actúe para preservarse, a "
"diferencia de la mayoría de sus congéneres."

#. ~ Monster name
#: data/json/monsters/feral_humans.json
msgid "mad militia"
msgid_plural "mad militias"
msgstr[0] "miliciano loco"
msgstr[1] "milicianos locos"
msgstr[2] "milicianos locos"

#. ~ Description of monster "mad militia"
#: data/json/monsters/feral_humans.json
msgid ""
"Wearing a tactical camo uniform with a Kevlar vest, this person seems to "
"have been a militia member, now turned feral.  Their hands grip unto a semi-"
"automatic rifle as their bloodshot eyes scan for threats; a flashlight "
"strapped to their forehead illuminates their presence and surroundings."
msgstr ""
"Esta persona tiene puesto un uniforme táctico camuflado con un chaleco de "
"kevlar. Parece haber sido miembro de la milicia y ahora se ha vuelto "
"salvaje. En sus manos tiene un rifle semiautomático y sus ojos inyectados en"
" sangre buscan amenazas. Una linterna atada a su frente ilumina su presencia"
" y sus alrededores."

#. ~ Description of special attack of monster "mad militia"
#: data/json/monsters/feral_humans.json
msgid "The mad militiaman fires their rifle!"
msgstr "¡El miliciano loco dispara su rifle!"

#. ~ Monster name
#: data/json/monsters/feral_humans.json
msgid "feral soldier"
msgid_plural "feral soldiers"
msgstr[0] "soldado salvaje"
msgstr[1] "soldados salvajes"
msgstr[2] "soldados salvajes"

#. ~ Description of monster "feral soldier"
#: data/json/monsters/feral_humans.json
msgid ""
"Wearing a military uniform with an armored vest, this person seems to be a "
"highly trained military professional, now turned feral.  Tense, dirty hands "
"grip a combat knife as their bloodshot eyes scan for threats."
msgstr ""
"Esta persona tiene puesto un uniforme militar con un chaleco blindado. "
"Parece haber sido entrenado profesionalmente en el ejército y ahora se ha "
"vuelto salvaje. En sus manos tensas y sucias tiene un cuchillo de combate y "
"sus ojos inyectados en sangre buscan amenazas."

#. ~ Monster name
#: data/json/monsters/feral_humans.json
msgid "feral biker"
msgid_plural "feral bikers"
msgstr[0] "motero salvaje"
msgstr[1] "moteros salvajes"
msgstr[2] "moteros salvajes"

#. ~ Description of monster "feral biker"
#: data/json/monsters/feral_humans.json
msgid ""
"A rough-looking feral human, clad in black leather and wielding a pump-"
"action shotgun.  It seems body-armor wasn't one of their priorities however."
msgstr ""
"Un humano salvaje de aspecto rudo, vestido con cuero negro y con una "
"escopeta en la mano. Pero parece que su protección no fue una de sus "
"prioridades."

#. ~ Description of special attack of monster "feral biker"
#: data/json/monsters/feral_humans.json
msgid "The feral biker fires their shotgun!"
msgstr "¡El motero salvaje dispara su escopeta!"

#. ~ Monster name
#: data/json/monsters/feral_humans.json
msgid "feral swimmer"
msgid_plural "feral swimmers"
msgstr[0] "nadador salvaje"
msgstr[1] "nadadores salvajes"
msgstr[2] "nadadores salvajes"

#. ~ Description of monster "feral swimmer"
#: data/json/monsters/feral_humans.json
msgid ""
"Clad in swimwear and with a swimming kickboard in hand, this once normal "
"person is now a bloodthirsty maniac, capable of swimming behind its victims "
"and drown them with a smile on its face."
msgstr ""
"Vestido con un traje de baño y con una tabla de nado en la mano, esto alguna"
" vez fue una persona normal, pero ahora es un maníaco sanguinario capaz de "
"nadar detrás de sus víctimas y ahogarlos con una sonrisa en la cara."

#. ~ Monster name
#: data/json/monsters/feral_humans.json
msgid "feral diver"
msgid_plural "feral divers"
msgstr[0] "buzo salvaje"
msgstr[1] "buzos salvajes"
msgstr[2] "buzos salvajes"

#. ~ Description of monster "feral diver"
#: data/json/monsters/feral_humans.json
msgid ""
"Once an avid diver, this masked maniac now follows its prey until the "
"deepest of the oceans, wielding a dive knife with which to murder them."
msgstr ""
"Alguna vez fue un ávido buzo y ahora este maníaco enmascarado sigue a su "
"presa por las profundidades de los océanos, empuñando un cuchillo de buzo "
"con el cual los asesina."

#. ~ Monster name
#: data/json/monsters/feral_humans.json
msgid "feral crewman"
msgid_plural "feral crewmen"
msgstr[0] "tripulante salvaje"
msgstr[1] "tripulantes salvajes"
msgstr[2] "tripulantes salvajes"

#. ~ Description of monster "feral crewman"
#: data/json/monsters/feral_humans.json
msgid ""
"Clad in a grimy and tattered naval uniform, this former sailor clutches a "
"massive wrench as some form of makeshift weapon.  At a distance, you could "
"mistake them as being another survivor.  However, upon closer inspection you"
" make note of how their veins are visibly bulging, their wide open eyes have"
" a primal, animalistic quality to their gaze, and their breaths come in "
"ragged, wheezing pants.  Whatever the Cataclysm has done to the military "
"crewman that this twitching shell of their former self once was, you’re "
"certain that they're not fully human anymore."
msgstr ""
"Vestido con un uniforme marino sucio y harapiento, esto que alguna vez fue "
"un marinero se aferra a una llave enorme como si fuera un arma. A distancia,"
" podrías confundirlo con otro sobreviviente normal. Sin embargo, al verlo "
"más de cerca puedes ver sus venas palpitando, sus grandes ojos poseen una "
"mirada primigenia y bestial, y su respiración son jadeos irregulares y "
"sibilantes. Lo que sea que el Cataclismo le haya hecho a los tripulantes "
"militares, estás seguro de que ya no son humanos."

#. ~ Description of monster "mon_feral_sailor_axe"
#: data/json/monsters/feral_humans.json
msgid ""
"Spattered from head to toe in large swaths of dried viscera, the deep blue "
"of this person’s tattered naval uniform has been stained the color of rust."
"  Having seemingly had enough presence of mind to consider arming itself, "
"this former crewman carries a crash axe in its shaking hands.  The veins on "
"the back of their neck are visibly bulging, their eyes bloodshot, and a mass"
" of crisscrossing blackened veins stand out against the pale skin of their "
"face as they regard the area around them for perceived threats."
msgstr ""
"Esta persona está salpicada de pies a cabeza con franjas de vísceras secas, "
"y su uniforme harapiento de color azul marino tiene manchas color óxido. "
"Teniendo la suficiente claridad mental como para considerar armarse, este "
"marinero lleva un hacha en sus manos temblorosas. Las venas en la nuca están"
" latiendo, sus ojos están inyectados en sangre y una masa de negras venas "
"entrecruzadas sobresalen de la piel pálida de su cara mientras mira el área "
"buscando amenazas."

#. ~ Description of monster "mon_feral_sailor_mop"
#: data/json/monsters/feral_humans.json
msgid ""
"Clutching a stout mop in their quivering hands, this crewman was presumably "
"assigned to basic deck sweeping in their final moments, before the Cataclysm"
" struck and stripped them of their humanity.  Dressed in basic naval "
"fatigues, you’d be forgiven for believing them to be another survivor.  "
"However, their bloodshot eyes, blackened veins, and spastic twitching tell a"
" far different story."
msgstr ""
"Este marino parece haber sido asignado a la limpieza de la cubierta en sus "
"últimos momentos antes de que el Cataclismo le quitara toda su humanidad. Se"
" aferra a una resistente fregona con sus manos temblorosas. Vestido con el "
"uniforme básico de marino, se te perdonaría si creyeras que es otro "
"sobreviviente normal. Sin embargo, sus ojos inyectados en sangre, sus venas "
"ennegrecidas y sus espasmos te cuentan una historia diferente."

#. ~ Description of monster "mon_feral_sailor_lug_wrench"
#: data/json/monsters/feral_humans.json
msgid ""
"Still dressed in a grease spattered uniform, this crewman appears to have "
"once been a naval engineer.  With tangled hair, oil stained working attire, "
"and a lug wrench clenched in their fist, you assume that they were either "
"assigned to shipside maintenance or responsible for servicing onboard "
"aircraft.  Now all that’s left of the crewman that this person once was is a"
" madly twitching, psychopathic monster."
msgstr ""
"Este tripulante, todavía vestido con un uniforme salpicado de grasa, parece "
"haber sido un ingeniero naval. Con el pelo enmarañado, la ropa de trabajo "
"manchada de aceite y una llave inglesa apretada en el puño, supones que "
"estaba asignado al mantenimiento de los barcos o que era responsable del "
"mantenimiento de los aviones a bordo. Ahora, todo lo que queda del "
"tripulante que fue esta persona es un monstruo psicópata que se retuerce "
"enloquecido."

#. ~ Monster name
#: data/json/monsters/feral_humans.json
msgid "feral marine"
msgid_plural "feral marines"
msgstr[0] "marino salvaje"
msgstr[1] "marinos salvajes"
msgstr[2] "marinos salvajes"

#. ~ Description of monster "feral marine"
#: data/json/monsters/feral_humans.json
msgid ""
"This twitching, bloodied person is still clad in a ragged naval uniform, the"
" insignia of the marines visible on their coat and a corresponding tattoo on"
" their forearm.  Clutching a rifle in their quivering hands, you see them "
"repeatedly pull the weapon’s trigger, constantly muttering incoherently and "
"yanking back on the gun’s charging handle every time the rifle fails to "
"fire.  Seemingly having lost the capability to comprehend that their weapon "
"is empty, you’d feel relatively safe were it not for the gleaming bayonet "
"still attached to the end of their firearm."
msgstr ""
"Esta persona sangrienta que se retuerce todavía lleva puesto su uniforme "
"naval harapiento, la insignia de los marinos visible en su saco y el "
"correspondiente tatuaje en su antebrazo. Aferrado a un rifle con sus manos "
"temblorosas, lo ves apretar el gatillo repetidamente, murmurando "
"constantemente de manera incoherente y tirando del cerrojo del rifle cada "
"vez que falla el disparo. Parece haber perdido la capacidad de comprender "
"que su arma está vacía, así que te sientes relativamente seguro salvo por la"
" bayoneta resplandeciente que todavía tiene la punta del arma."

#. ~ Monster name
#: data/json/monsters/feral_humans.json
msgid "feral officer"
msgid_plural "feral officers"
msgstr[0] "oficial salvaje"
msgstr[1] "oficiales salvajes"
msgstr[2] "oficiales salvajes"

#. ~ Description of monster "feral officer"
#: data/json/monsters/feral_humans.json
msgid ""
"This person, clad in the tattered uniform of a naval officer, twitches "
"erratically as their bloodshot eyes dart about and their breaths come in "
"ragged pants.  The Cataclysm has clearly done something horrible to this "
"military professional, inaudible mutterings emanating from their lips as "
"they creep about like a skittish animal.  In their quivering hands they "
"clutch a service pistol, the officer’s fingers nervously fidgeting with the "
"weapon.  They may not be an undead corpse, but you doubt that they’re any "
"more rational than the zombies which now infest the world."
msgstr ""
"Esta persona vestida con el uniforme harapiento de un oficial naval, se "
"retuerce de manera errática mientras sus ojos inyectados en sangre se mueven"
" a toda velocidad y respira en jadeos irregulares.  El Cataclismo le ha "
"hecho algo horrible a este profesional militar, murmullos inaudibles emanan "
"de sus labios mientras se mueve como un animal asustadizo.  En sus "
"temblorosas manos tiene aferrada una pistola, los dedos del oficial se "
"mueven inquietos por el arma.  Puede no ser un cadáver viviente pero tienes "
"dudas de que sea un poco más racional que los zombis que infestan el mundo."

#. ~ Description of special attack of monster "feral officer"
#: data/json/monsters/feral_humans.json
msgid "The feral officer fires their M18!"
msgstr "¡El oficial salvaje dispara su M18!"

#. ~ Monster name
#: data/json/monsters/fish.json
msgid "alpha razorclaw"
msgid_plural "alpha razorclaws"
msgstr[0] "alfa garracuchilla"
msgstr[1] "alfa garracuchillas"
msgstr[2] "alfa garracuchillas"

#. ~ Description of monster "alpha razorclaw"
#: data/json/monsters/fish.json
msgid ""
"A blood-red, gigantic razorclaw.  With its sword-like pincers, it serves as "
"a protector of the nest."
msgstr ""
"Un gigantesco garra cuchilla de color rojo sangre. Con sus pinzas en forma "
"de espada, sirve como protector del nido."

#. ~ Monster name
#: data/json/monsters/fish.json
msgid "tiny fish"
msgid_plural "tiny fish"
msgstr[0] "pez diminuto"
msgstr[1] "peces diminutos"
msgstr[2] "peces diminutos"

#. ~ Description of monster "tiny fish"
#: data/json/monsters/fish.json
msgid "A tiny fish."
msgstr "Un pez diminuto."

#. ~ Monster name
#: data/json/monsters/fish.json
msgid "small fish"
msgid_plural "small fish"
msgstr[0] "pez pequeño"
msgstr[1] "peces pequeños"
msgstr[2] "peces pequeños"

#. ~ Description of monster "small fish"
#: data/json/monsters/fish.json
msgid "A small fish."
msgstr "Un pez pequeño"

#. ~ Monster name
#: data/json/monsters/fish.json
msgid "medium fish"
msgid_plural "medium fish"
msgstr[0] "pez mediano"
msgstr[1] "peces mediano"
msgstr[2] "peces mediano"

#. ~ Description of monster "medium fish"
#: data/json/monsters/fish.json
msgid "A medium fish."
msgstr "Un pez mediano"

#. ~ Monster name
#: data/json/monsters/fish.json
msgid "large fish"
msgid_plural "large fish"
msgstr[0] "pez grande"
msgstr[1] "peces grandes"
msgstr[2] "peces grandes"

#. ~ Description of monster "large fish"
#: data/json/monsters/fish.json
msgid "A large fish."
msgstr "Es un pez... grande."

#. ~ Monster name
#: data/json/monsters/fish.json
msgid "huge fish"
msgid_plural "huge fish"
msgstr[0] "pez enorme"
msgstr[1] "peces enorme"
msgstr[2] "peces enorme"

#. ~ Description of monster "huge fish"
#: data/json/monsters/fish.json
msgid "A huge fish."
msgstr "Un pez enorme"

#. ~ Monster name
#: data/json/monsters/fish.json
msgid "fish fry"
msgid_plural "fish fry"
msgstr[0] "alevin de pez"
msgstr[1] "alevines de pez"
msgstr[2] "alevines de pez"

#. ~ Description of monster "fish fry"
