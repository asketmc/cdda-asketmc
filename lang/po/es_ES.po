#: data/mods/DinoMod/monsters/zinosaur_upgrade.json
#, c-format
msgid "The %s's body leaks acid."
msgstr "El cuerpo del %s chorrea ácido."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
#: data/mods/Tamable_Wildlife/insect_spider.json
msgid "acidic ant larva"
msgid_plural "acidic ant larvae"
msgstr[0] "larva de hormiga ácida"
msgstr[1] "larvas de hormiga ácida"
msgstr[2] "larvas de hormiga ácida"

#. ~ Description of monster "acidic ant larva"
#: data/json/monsters/insect_spider.json
msgid ""
"A squirming yellow grub that seems to be oozing liquid from both ends of its"
" body.  It appears its chitin hasn't developed enough to resist acid."
msgstr ""
"Es una larva brillante que parece estar chorreando un líquido viscoso de las"
" dos extremos de su cuerpo. Parece que su quitina todavía no se ha "
"desarrollado lo suficiente como para resistir el ácido."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "acidic queen ant"
msgid_plural "acidic queen ants"
msgstr[0] "hormiga ácida reina"
msgstr[1] "hormigas ácidas reina"
msgstr[2] "hormigas ácidas reina"

#. ~ Description of monster "acidic queen ant"
#: data/json/monsters/insect_spider.json
msgid ""
"An enormous brown ant with an elongated, pulsating abdomen.  Her orifice "
"seems developed only for egg-laying rather than spraying acid like the rest "
"of the colony, but she doesn't seem affected by the acrid liquid either."
msgstr ""
"Una enorme hormiga marrón con el abdomen hinchado y palpitante. Parece tener"
" un orificio desarrollado solo para poner huevos en lugar de escupir ácido "
"como las otras hormigas, pero tampoco parece ser afectada por el agrio "
"líquido."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
#: data/mods/Tamable_Wildlife/insect_spider.json
msgid "acidic soldier ant"
msgid_plural "acidic soldier ants"
msgstr[0] "hormiga ácida soldado"
msgstr[1] "hormigas ácidas soldado"
msgstr[2] "hormigas ácidas soldado"

#. ~ Description of monster "acidic soldier ant"
#: data/json/monsters/insect_spider.json
msgid ""
"A massive woolly brown ant that towers over the worker ants with a giant "
"head crest.  Along with her huge mandibles, a corrosive liquid seeps from "
"the end of her bloated abdomen."
msgstr ""
"Una inmensa hormiga marrón y peluda que sobresale entre las hormigas obreras"
" con su gigante cabeza con cresta. Además de sus enormes mandíbulas, un "
"líquido corrosivo se filtra desde el fondo de su hinchado abdomen."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "super soldier acid ant"
msgid_plural "super soldier acid ants"
msgstr[0] "hormiga super soldado ácida"
msgstr[1] "hormigas super soldado ácidas"
msgstr[2] "hormigas super soldado ácidas"

#. ~ Description of monster "super soldier acid ant"
#: data/json/monsters/insect_spider.json
msgid ""
"A cow-sized, woolly brown ant.  Corrosive liquid seeping from her huge "
"mandibles.  Given the relative strength of ants to their body size, you "
"don't doubt that this one could shove cars around or rip through solid "
"walls."
msgstr ""
"Una hormiga marrón peluda del tamaño de una vaca. Unas abultadas pinzas "
"salen de sus mandíbulas. Dada la fuerza relativa de las hormigas en relación"
" con el tamaño de su cuerpo, no dudas de que ésta podría empujar coches o "
"atravesar paredes sólidas."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
#: data/mods/Tamable_Wildlife/insect_spider.json
msgid "ant larva"
msgid_plural "ant larvae"
msgstr[0] "larva de hormiga"
msgstr[1] "larvas de hormiga"
msgstr[2] "larvas de hormiga"

#. ~ Description of monster "ant larva"
#: data/json/monsters/insect_spider.json
msgid ""
"A pulsating sausage of glistening white flesh, the size of a large cat.  On "
"one end is a set of squirming mouth parts."
msgstr ""
"Como una salchicha de reluciente carne blanca que palpita, del tamaño de un "
"gato grande. En un extremo hay un conjunto de piezas bucales que se "
"retuercen."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "queen ant"
msgid_plural "queen ants"
msgstr[0] "hormiga reina"
msgstr[1] "hormigas reinas"
msgstr[2] "hormigas reinas"

#. ~ Description of monster "queen ant"
#: data/json/monsters/insect_spider.json
msgid ""
"A colossal red ant with a bulging, bloated thorax.  She moves slowly and "
"deliberately, tending to nearby eggs and continually laying more."
msgstr ""
"Una colosal hormiga roja con un tórax hinchado y saltón. Se mueve lenta y "
"deliberadamente, cuidando los huevos cercanos y continuamente poniendo más."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
#: data/mods/Tamable_Wildlife/insect_spider.json
msgid "soldier ant"
msgid_plural "soldier ants"
msgstr[0] "hormiga soldado"
msgstr[1] "hormigas soldado"
msgstr[2] "hormigas soldado"

#. ~ Description of monster "soldier ant"
#: data/json/monsters/insect_spider.json
msgid ""
"A huge and hairy red ant almost twice the size of other giant ants.  Bulging"
" pincers extend from her jaws."
msgstr ""
"Una hormiga roja enorme y peluda, casi del doble de tamaño que las otras "
"hormigas gigantes. Grandes pinzas se extienden de su mandíbula."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
#: data/mods/Tamable_Wildlife/insect_spider.json
msgid "super soldier ant"
msgid_plural "super soldier ants"
msgstr[0] "hormiga super soldado"
msgstr[1] "hormigas super soldado"
msgstr[2] "hormigas super soldado"

#. ~ Description of monster "super soldier ant"
#: data/json/monsters/insect_spider.json
msgid ""
"A cow-sized, hairy red ant.  Bulging pincers extend from her jaws.  Given "
"the relative strength of ants to their body size, you don't doubt that this "
"one could shove cars around or rip through solid walls."
msgstr ""
"Una hormiga roja peluda del tamaño de una vaca. Unas abultadas pinzas salen "
"de sus mandíbulas. Dada la fuerza relativa de las hormigas en relación con "
"el tamaño de su cuerpo, no dudas de que ésta podría empujar coches o "
"atravesar paredes sólidas."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "locust"
msgid_plural "locusts"
msgstr[0] "langosta (insecto)"
msgstr[1] "langostas (insecto)"
msgstr[2] "langostas (insecto)"

#. ~ Description of monster "locust"
#: data/json/monsters/insect_spider.json
msgid ""
"A yellow and brown mutated locust the size of a small dog, with big eyes and"
" long, powerful legs."
msgstr ""
"Una langosta mutada amarilla y marrón del tamaño de un perro pequeño con "
"grandes ojos y largas y poderosas patas."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
#: data/mods/Tamable_Wildlife/insect_spider.json
msgid "giant locust"
msgid_plural "giant locusts"
msgstr[0] "langosta gigante"
msgstr[1] "langostas gigantes"
msgstr[2] "langostas gigantes"

#. ~ Description of monster "giant locust"
#: data/json/monsters/insect_spider.json
msgid ""
"A yellow and brown mutated locust the size of a dog with big eyes and long, "
"powerful legs.  You don't think it'll eat you, but it could cause massive "
"damage to nearby plants."
msgstr ""
"Una langosta mutada amarilla y marrón del tamaño de un perro con grandes "
"ojos y largas y poderosas patas. No crees que te comerá pero podría causar "
"mucho daño a las plantas cercanas."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
#: data/mods/Tamable_Wildlife/insect_spider.json
msgid "famine"
msgid_plural "famines"
msgstr[0] "hambruna"
msgstr[1] "hambrunas"
msgstr[2] "hambrunas"

#. ~ Description of monster "famine"
#: data/json/monsters/insect_spider.json
msgid ""
"A cow-sized yellow and brown mutated locust with huge, staring eyes and "
"long, powerful legs.  The bane of the post-apocalyptic farmer."
msgstr ""
"Una langosta mutada del tamaño de una vaca, de color amarillo y marrón, con "
"ojos enormes y fijos y patas largas y poderosas. La perdición del agricultor"
" postapocalíptico."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
#: data/mods/Tamable_Wildlife/insect_spider.json
msgid "locust nymph"
msgid_plural "locust nymphs"
msgstr[0] "ninfa de langosta (Insecto)"
msgstr[1] "ninfas de langosta (Insecto)"
msgstr[2] "ninfas de langosta (Insecto)"

#. ~ Description of monster "locust nymph"
#: data/json/monsters/insect_spider.json
msgid ""
"A locust the size of a rabbit.  You'd hate to think what a swarm of these "
"could do."
msgstr ""
"Una langosta(Insecto) del tamaño de un conejo. Odiarías pensar lo que un "
"enjambre de estos podría hacer."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
#: data/mods/Tamable_Wildlife/insect_spider.json
#: data/mods/innawood/monsters/insect_spider.json
msgid "aphid"
msgid_plural "aphids"
msgstr[0] "pulgón"
msgstr[1] "pulgones"
msgstr[2] "pulgones"

#. ~ Description of monster "aphid"
#: data/json/monsters/insect_spider.json
#: data/mods/innawood/monsters/insect_spider.json
msgid ""
"This huge aphid is as big as a hamster.  It's not as thirsty as bigger ones,"
" but a herd of these could eat your crops easily."
msgstr ""
"Este enorme pulgón es del tamaño de un hámster. No es tan sediento como los "
"más grandes pero una horda de estos te podrían comer tu cosecha fácilmente."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
#: data/mods/Tamable_Wildlife/insect_spider.json
#: data/mods/innawood/monsters/insect_spider.json
msgid "giant aphid"
msgid_plural "giant aphids"
msgstr[0] "pulgón gigante"
msgstr[1] "pulgones gigantes"
msgstr[2] "pulgones gigantes"

#. ~ Description of monster "giant aphid"
#: data/json/monsters/insect_spider.json
#: data/mods/innawood/monsters/insect_spider.json
msgid ""
"A green aphid about the size of a rabbit.  It is constantly searching for "
"plants to suck from."
msgstr ""
"Un pulgón verde del tamaño de un conejo. Está constantemente buscando "
"plantas para succionar su savia."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "praying mantis"
msgid_plural "praying mantises"
msgstr[0] "mantis religiosa"
msgstr[1] "mantis religiosas"
msgstr[2] "mantis religiosas"

#. ~ Description of monster "praying mantis"
#: data/json/monsters/insect_spider.json
msgid ""
"A green mutant insect with sharp grappling spikes on its front legs.  It's a"
" little smaller than an adult person."
msgstr ""
"Un insecto mutante verde con púas afiladas de agarre en sus patas "
"delanteras. Un poco más pequeño que un humano adulto."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
#: data/mods/Tamable_Wildlife/insect_spider.json
msgid "giant praying mantis"
msgid_plural "giant praying mantises"
msgstr[0] "mantis religiosa gigante"
msgstr[1] "mantis religiosas gigantes"
msgstr[2] "mantis religiosas gigantes"

#. ~ Description of monster "giant praying mantis"
#: data/json/monsters/insect_spider.json
msgid ""
"An enormous green insect grown to about the size of a bear.  It moves in a "
"weird, dance-like pattern and looks ready to chop your head off at any "
"moment."
msgstr ""
"Un enorme insecto verde del tamaño de un oso. Se mueve con un extraño patrón"
" de baile y parece dispuesto a cortarte la cabeza en cualquier momento."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
#: data/mods/Tamable_Wildlife/insect_spider.json
msgid "praying mantis nymph"
msgid_plural "praying mantis nymphs"
msgstr[0] "mantis religiosa ninfa"
msgstr[1] "mantis religiosas ninfas"
msgstr[2] "mantis religiosas ninfas"

#. ~ Description of monster "praying mantis nymph"
#: data/json/monsters/insect_spider.json
msgid ""
"A mantis nymph about the size of a dog.  Even though its far smaller than "
"the adults, you have a feeling it wouldn't take kindly to you coming too "
"close."
msgstr ""
"Una mantis ninfa del tamaño de un perro. Aunque es mucho más pequeña que las"
" adultas, tienes la sensación de que no aceptaría agradablemente que te "
"acercaras mucho."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
#: data/mods/Tamable_Wildlife/insect_spider.json
msgid "great mantis"
msgid_plural "great mantises"
msgstr[0] "gran mantis"
msgstr[1] "grandes mantis"
msgstr[2] "grandes mantis"

#. ~ Description of monster "great mantis"
#: data/json/monsters/insect_spider.json
msgid ""
"This ferocious cow-sized mantis stalks the fields of New England.  It's "
"probably capable of killing a moose with its powerful arms."
msgstr ""
"Esta feroz mantis del tamaño de una vaca acecha los campos de Nueva "
"Inglaterra. Probablemente sea capaz de matar a un alce con sus poderosos "
"brazos."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "giant mole cricket"
msgid_plural "giant mole crickets"
msgstr[0] "grillo topo gigante"
msgstr[1] "grillos topo gigantes"
msgstr[2] "grillos topo gigantes"

#. ~ Description of monster "giant mole cricket"
#: data/json/monsters/insect_spider.json
msgid ""
"An enormous underground bug.  Beware its ear-splitting screech and strong "
"shovel-like front legs."
msgstr ""
"Un enorme insecto subterráneo. Ten cuidado del alarido estridente y de las "
"poderosas patas delanteras que parecen palas."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "lady bug"
msgid_plural "lady bugs"
msgstr[0] "mariquita"
msgstr[1] "mariquitas"
msgstr[2] "mariquitas"

#. ~ Description of monster "lady bug"
#: data/json/monsters/insect_spider.json
msgid ""
"This is a mutated lady bug the size of a big dog.  While not as dangerous as"
" her giant sisters, she's still troublesome to deal with."
msgstr ""
"Una mariquita de San Antonio mutada del tamaño de un perro grande. Aunque no"
" es tan peligrosa como sus hermanas gigantes, puede ser un problema lidiar "
"con ella."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "giant lady bug"
msgid_plural "giant lady bugs"
msgstr[0] "mariquita gigante"
msgstr[1] "mariquitas gigantes"
msgstr[2] "mariquitas gigantes"

#. ~ Description of monster "giant lady bug"
#: data/json/monsters/insect_spider.json
msgid ""
"The normal-sized version of this red and black beetle is generally "
"considered cute, and is adored by children and associated with good luck.  "
"This monster, on the other hand is clearly a ferocious predator capable of "
"killing swarms of ants, aphids, and unprepared humans."
msgstr ""
"La versión de tamaño normal de este escarabajo rojo y negro se considera "
"generalmente simpática, y es adorada por los niños y asociada a la buena "
"suerte. Este monstruo, en cambio, es claramente un feroz depredador capaz de"
" matar enjambres de hormigas, pulgones y humanos desprevenidos."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "grasshopper"
msgid_plural "grasshoppers"
msgstr[0] "saltamonte"
msgstr[1] "saltamontes"
msgstr[2] "saltamontes"

#. ~ Description of monster "grasshopper"
#: data/json/monsters/insect_spider.json
msgid "A large grasshopper a few times bigger than a regular one."
msgstr "Un saltamontes grande, unas pocas veces más grande que uno normal."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
#: data/mods/Tamable_Wildlife/insect_spider.json
msgid "giant grasshopper"
msgid_plural "giant grasshoppers"
msgstr[0] "saltamontes gigante"
msgstr[1] "saltamontes gigantes"
msgstr[2] "saltamontes gigantes"

#. ~ Description of monster "giant grasshopper"
#: data/json/monsters/insect_spider.json
msgid ""
"A huge green grasshopper about the size of a big dog, with long and strong "
"back legs.  It hops, it hops and never stops."
msgstr ""
"Un enorme saltamontes verde del tamaño de un perro grande, con largas y "
"fuertes patas traseras. Salta, salta y nunca para."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
#: data/mods/Tamable_Wildlife/insect_spider.json
msgid "grasshopper nymph"
msgid_plural "grasshopper nymphs"
msgstr[0] "saltamontes ninfa"
msgstr[1] "saltamontes ninfas"
msgstr[2] "saltamontes ninfas"

#. ~ Description of monster "grasshopper nymph"
#: data/json/monsters/insect_spider.json
msgid "A grasshopper nymph the size of a rabbit."
msgstr "Un saltamontes ninfa del tamaño de un conejo."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
#: data/mods/Tamable_Wildlife/insect_spider.json
msgid "giant stag beetle larva"
msgid_plural "giant stag beetle larvae"
msgstr[0] "larva gigantes de escarabajo ciervo"
msgstr[1] "larvas gigantes de escarabajo ciervo"
msgstr[2] "larvas gigantes de escarabajo ciervo"

#. ~ Description of monster "giant stag beetle larva"
#: data/json/monsters/insect_spider.json
msgid ""
"Something about this cow-sized larva is pitiable, despite its immense size "
"and sickening cream color."
msgstr ""
"Hay algo en esta larva del tamaño de una vaca que da pena, a pesar de su "
"inmenso tamaño y su enfermizo color crema."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "giant stag beetle"
msgid_plural "giant stag beetles"
msgstr[0] "escarabajo ciervo gigante"
msgstr[1] "escarabajos ciervos gigantes"
msgstr[2] "escarabajos ciervos gigantes"

#. ~ Description of monster "giant stag beetle"
#: data/json/monsters/insect_spider.json
msgid ""
"It was called a giant even before the Cataclysm, but now this mutant beetle "
"is the size of a small horse.  It looks ready to molt again, even though "
"parts of the shell are still soft."
msgstr ""
"Antes del Cataclismo ya se le llamaba gigante, pero ahora este escarabajo "
"mutante tiene el tamaño de un caballo pequeño. Parece listo para mudar de "
"nuevo, aunque partes del caparazón aún están blandas."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "massive stag beetle"
msgid_plural "massive stag beetles"
msgstr[0] "escarabajo ciervo masivo"
msgstr[1] "escarabajos ciervos masivos"
msgstr[2] "escarabajos ciervos gigantes"

#. ~ Description of monster "massive stag beetle"
#: data/json/monsters/insect_spider.json
msgid ""
"This enormous stag beetle has reached mutated maturity, but continues to "
"grow.  Thankfully, that growth is exposing vulnerable cracks of flesh in the"
" strained chitin."
msgstr ""
"Este enorme escarabajo ciervo ha alcanzado la madurez mutante, pero sigue "
"creciendo. Afortunadamente, ese crecimiento está exponiendo grietas "
"vulnerables de carne en la quitina tensa."

#. ~ Sentence fragment describing a weakpoint for monster "massive stag
#. beetle"
#: data/json/monsters/insect_spider.json
msgid "a soft section of chitin"
msgstr "una parte suave de quitina"

#. ~ Sentence fragment describing a weakpoint for monster "massive stag
#. beetle"
#: data/json/monsters/insect_spider.json
msgid "a crack in the chitin"
msgstr "una grieta en la quitina"

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "titan stag beetle"
msgid_plural "titan stag beetles"
msgstr[0] "escarabajo ciervo titán"
msgstr[1] "escarabajos ciervo titán"
msgstr[2] "escarabajos ciervo titán"

#. ~ Description of monster "titan stag beetle"
#: data/json/monsters/insect_spider.json
msgid ""
"This stag beetle rivals an armored personnel carrier in size, bearing horns "
"that could fell a tree and chitin thick enough to ignore most bullets.  Its "
"bulky shell looks nigh-impenetrable, and the cracks have sealed with a foul "
"paste."
msgstr ""
"Este escarabajo ciervo rivaliza en tamaño con un vehículo blindado de "
"transporte de personal, con unos cuernos que podrían derribar un árbol y una"
" quitina lo suficientemente gruesa como para ignorar la mayoría de las "
"balas. Su voluminoso caparazón parece casi impenetrable, y las grietas se "
"han sellado con una pasta asquerosa."

#. ~ Sentence fragment describing a weakpoint for monster "titan stag beetle"
#: data/json/monsters/insect_spider.json
msgid "a foul scar in the chitin"
msgstr "una cicatriz sucia en la quitina"

#. ~ Monster name
#: data/json/monsters/insect_spider.json
#: data/mods/Tamable_Wildlife/insect_spider.json
msgid "giant antlion larva"
msgid_plural "giant antlion larvae"
msgstr[0] "larva de hormiga león gigante"
msgstr[1] "larvas de hormiga león gigante"
msgstr[2] "larvas de hormiga león gigante"

#. ~ Description of monster "giant antlion larva"
#: data/json/monsters/insect_spider.json
msgid ""
"This huge grub has powerful mandibles and a hungry look.  It hides in the "
"dirt and awaits its prey."
msgstr ""
"Esta enorme larva tiene mandíbulas poderosas y una apariencia hambrienta. Se"
" esconde en la tierra y espera a su presa."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
#: data/mods/Tamable_Wildlife/insect_spider.json
msgid "giant adult antlion"
msgid_plural "giant adult antlions"
msgstr[0] "hormiga león gigante adulta"
msgstr[1] "hormigas león gigantes adultas"
msgstr[2] "hormigas león gigantes adultas"

#. ~ Description of monster "giant adult antlion"
#: data/json/monsters/insect_spider.json
msgid ""
"A ferocious mutant flying antlion as big as a cat, darting through the air "
"with a cluster of fangs for a mouth.  Despite its dangerous looks, it "
"doesn't seem interested in you."
msgstr ""
"Una hormiga león voladora mutante y feroz, grande como un gato, "
"desplazándose por el aire a gran velocidad con un grupo de colmillos en "
"lugar de boca. Pero a pesar de su apariencia peligrosa, no parece estar "
"interesada en ti."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "water strider"
msgid_plural "water striders"
msgstr[0] "zapatero de agua"
msgstr[1] "zapateros de agua"
msgstr[2] "zapateros de agua"

#. ~ Description of monster "water strider"
#: data/json/monsters/insect_spider.json
msgid ""
"This water bug is several times larger than a regular one.  Its movements "
"are fast and fluid."
msgstr ""
"Este insecto acuático es varias veces más grande que uno normal. Sus "
"movimientos son rápidos y fluidos."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
#: data/mods/Tamable_Wildlife/insect_spider.json
msgid "giant water strider"
msgid_plural "giant water striders"
msgstr[0] "zapatero de agua gigante"
msgstr[1] "zapateros de agua gigantes "
msgstr[2] "zapateros de agua gigantes "

#. ~ Description of monster "giant water strider"
#: data/json/monsters/insect_spider.json
msgid ""
"This water glider is about as big as a domestic cat.  Its legs are more fin-"
"like and a swollen body is mostly submerged underwater."
msgstr ""
"Este zapatero es del tamaño de un gato. Sus patas son más parecidas a aletas"
" y tiene el cuerpo hinchado en su mayoría sumergido en el agua."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
#: data/mods/Tamable_Wildlife/insect_spider.json
msgid "water strider nymph"
msgid_plural "water strider nymphs"
msgstr[0] "zapatero ninfa"
msgstr[1] "zapateros ninfas"
msgstr[2] "zapateros ninfas"

#. ~ Description of monster "water strider nymph"
#: data/json/monsters/insect_spider.json
msgid "A water strider nymph the size of a rabbit."
msgstr "Un zapatero ninfa del tamaño de un conejo."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "mutated butterfly"
msgid_plural "mutated butterflies"
msgstr[0] "mariposa mutada"
msgstr[1] "mariposas mutadas"
msgstr[2] "mariposas mutadas"

#. ~ Description of monster "mutated butterfly"
#: data/json/monsters/insect_spider.json
msgid ""
"An oversized butterfly with vibrant colored markings.  Unlike the other big "
"insects of the Cataclysm this is a very peaceful nectivore."
msgstr ""
"Una mariposa de gran tamaño con marcas de colores vibrantes. A diferencia de"
" los otros grandes insectos del Cataclismo, este es un nectivoro muy "
"pacífico."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "giant butterfly"
msgid_plural "giant butterflies"
msgstr[0] "mariposa gigante"
msgstr[1] "mariposas gigantes"
msgstr[2] "mariposas gigantes"

#. ~ Description of monster "giant butterfly"
#: data/json/monsters/insect_spider.json
msgid ""
"A mutated butterfly larger than a human.  Despite its size it is very "
"lightweight and feeds mainly on the nectar produced by triffid flowers."
msgstr ""
"Una mariposa mutante más grande que un ser humano. A pesar de su tamaño es "
"muy ligera y se alimenta principalmente del néctar que producen las flores "
"de los trífidos."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "emperor butterfly"
msgid_plural "emperor butterflies"
msgstr[0] "mariposa emperador"
msgstr[1] "mariposas emperador"
msgstr[2] "mariposas emperador"

#. ~ Description of monster "emperor butterfly"
#: data/json/monsters/insect_spider.json
msgid ""
"An enormous butterfly with regal looking wings.  This giant of the sky flies"
" cheerfully under the sun, leaving dust as it passes."
msgstr ""
"Una enorme mariposa con alas de aspecto regio. Este gigante del cielo vuela "
"alegremente bajo el sol, dejando polvo a su paso."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "mutated moth"
msgid_plural "mutated moths"
msgstr[0] "polilla mutada"
msgstr[1] "polillas mutadas"
msgstr[2] "polillas mutadas"

#. ~ Description of monster "mutated moth"
#: data/json/monsters/insect_spider.json
msgid ""
"An oversized moth with its typical wood-like motifs.  It is as peaceful as "
"the mutated butterflies found during the day."
msgstr ""
"Una polilla de gran tamaño con sus típicos motivos de madera. Es tan "
"pacífica como las mariposas mutantes que se encuentran durante el día."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "giant moth"
msgid_plural "giant moths"
msgstr[0] "polilla gigante"
msgstr[1] "polillas gigantes"
msgstr[2] "polillas gigantes"

#. ~ Description of monster "giant moth"
#: data/json/monsters/insect_spider.json
msgid ""
"A mutated moth larger than a human.  It silently flies with its huge wings "
"after dusk looking for nocturnal flowers to feed upon."
msgstr ""
"Una polilla mutada más grande que un humano. Vuela silenciosamente con sus "
"enormes alas después del atardecer en busca de flores nocturnas para "
"alimentarse."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "lunar moth"
msgid_plural "lunar moths"
msgstr[0] "polilla lunar"
msgstr[1] "polillas lunares"
msgstr[2] "polillas lunares"

#. ~ Description of monster "lunar moth"
#: data/json/monsters/insect_spider.json
msgid ""
"A majestic moth painted in pale colors.  This giant of the night only comes "
"out after the moon is out, leaving glittering dust."
msgstr ""
"Una majestuosa polilla pintada de colores pálidos. Este gigante de la noche "
"solo sale con la luna, dejando un polvo brillante."

#. ~ Monster name
#: data/json/monsters/insect_spider.json data/json/monsters/obsolete.json
msgid "giant caterpillar"
msgid_plural "giant caterpillars"
msgstr[0] "oruga gigante"
msgstr[1] "orugas gigantes"
msgstr[2] "orugas gigantes"

#. ~ Description of monster "giant caterpillar"
#: data/json/monsters/insect_spider.json
msgid ""
"The larval stage of a butterfly or a moth.  This one appears to be about "
"your size so you can only imagine the size of the insect that it will grow "
"into."
msgstr ""
"El estado larval de una mariposa o de una polilla. Este parece ser de tu "
"tamaño así que te puedes imaginar el tamaño del insecto cuando crezca."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "giant cocoon"
msgid_plural "giant cocoons"
msgstr[0] "capullo gigante"
msgstr[1] "capullos gigantes"
msgstr[2] "capullos gigantes"

#. ~ Description of monster "giant cocoon"
#: data/json/monsters/insect_spider.json
msgid ""
"A caterpillar undergoing a metamorphosis.  Considering the size of the "
"cocoon you have a feeling the emerging adult will be massive as well."
msgstr ""
"Una oruga en proceso de metamorfosis. Considerando el tamaño del capullo, "
"tienes la sensación de que el adulto que salga será enorme."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
#: data/mods/Tamable_Wildlife/insect_spider.json
msgid "cicada nymph"
msgid_plural "cicada nymphs"
msgstr[0] "cigarra ninfa"
msgstr[1] "cigarras ninfas"
msgstr[2] "cigarras ninfas"

#. ~ Description of monster "cicada nymph"
#: data/json/monsters/insect_spider.json
msgid ""
"The mutated larval form of a Cicada.  It doesn't produce noise like the "
"adults but its digging claws seem suited for scratching."
msgstr ""
"La larva mutada de una cigarra. No produce ningún ruido a diferencia de las "
"adultas pero sus garras parecen adecuadas para rasguñar."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
#: data/mods/Tamable_Wildlife/insect_spider.json
msgid "giant cicada"
msgid_plural "giant cicadas"
msgstr[0] "cigarra gigante"
msgstr[1] "cigarras gigantes"
msgstr[2] "cigarras gigantes"

#. ~ Description of monster "giant cicada"
#: data/json/monsters/insect_spider.json
msgid ""
"A huge Cicada the size of a person.  These insects are mostly harmless but "
"may bite if attacked and produce a loud buzzing sound."
msgstr ""
"Una enorme cigarra del tamaño de una persona. Estos insectos son mayormente "
"inofensivos pero pueden morder si son atacados y producir un fuerte zumbido."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
#: data/mods/Tamable_Wildlife/insect_spider.json
msgid "giant woodlouse"
msgid_plural "giant woodlice"
msgstr[0] "bicho bolita gigante"
msgstr[1] "bichos bolita gigantes"
msgstr[2] "bichos bolita gigantes"

#. ~ Description of monster "giant woodlouse"
#: data/json/monsters/insect_spider.json
msgid ""
"A woodlouse grown to the size of a dog.  These humble crustaceans are "
"harmless and enjoy damp places."
msgstr ""
"Un bicho bolita del tamaño de un perro. Estos humildes crustáceos son "
"inofensivos y disfrutan de los lugares húmedos."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
#: data/mods/Tamable_Wildlife/insect_spider.json
msgid "baby woodlouse"
msgid_plural "baby woodlice"
msgstr[0] "bicho bolita bebé"
msgstr[1] "bichos bolita bebés"
msgstr[2] "bichos bolita bebés"

#. ~ Description of monster "baby woodlouse"
#: data/json/monsters/insect_spider.json
msgid ""
"Woodlice reproduce by carrying their eggs in a pouch and releasing them as "
"juveniles.  Their mancae look like small adults except for their pale color."
msgstr ""
"Los bichos bolita se reproducen cargando sus huevos en una bolsa y "
"liberándolos cuando son jóvenes. En su etapa manca es como un adulto más "
"pequeño pero con un color pálido."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
#: data/mods/Tamable_Wildlife/insect_spider.json
msgid "giant water tiger"
msgid_plural "giant water tigers"
msgstr[0] "tigre de agua gigante"
msgstr[1] "tigres de agua gigantes"
msgstr[2] "tigres de agua gigantes"

#. ~ Description of monster "giant water tiger"
#: data/json/monsters/insect_spider.json
msgid ""
"The predatory, aquatic larva of a diving beetle grown to large proportions."
"  It is quite slow but still a good ambusher."
msgstr ""
"La larva acuática depredadora de un escarabajo buceador que ha crecido hasta"
" alcanzar grandes proporciones. Es bastante lenta pero sigue siendo una "
"buena emboscadora."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
#: data/mods/Tamable_Wildlife/insect_spider.json
msgid "giant diving beetle"
msgid_plural "giant diving beetles"
msgstr[0] "escarabajo buceador gigante"
msgstr[1] "escarabajos buceadores gigantes"
msgstr[2] "escarabajos buceadores gigantes"

#. ~ Description of monster "giant diving beetle"
#: data/json/monsters/insect_spider.json
msgid ""
"Water beetles can be found in all freshwater environments, with diving "
"beetles being their predatory variant.  These however seem to have grown far"
" larger with the Cataclysm."
msgstr ""
"Los escarabajos acuáticos pueden encontrarse en ambientes de agua dulce, "
"siendo los escarabajos buceadores la variante depredadora. Sin embargo, este"
" parece haber crecido mucho más grande durante el Cataclismo."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
#: data/mods/Tamable_Wildlife/insect_spider.json
msgid "giant water scorpion"
msgid_plural "giant water scorpions"
msgstr[0] "escorpión gigante de agua"
msgstr[1] "escorpiones gigantes de agua"
msgstr[2] "escorpiones gigantes de agua"

#. ~ Description of monster "giant water scorpion"
#: data/json/monsters/insect_spider.json
msgid ""
"A slender relative of the water bug, grown close to human size.  It uses its"
" long tail as a snorkel while ambushing prey."
msgstr ""
"Un pariente flaco de los insectos de agua, crecido a casi el tamaño de un "
"humano. Utiliza su larga cola como un snorkel mientras embosca a su presa."

#. ~ Monster name
#: data/json/monsters/insect_spider.json
#: data/mods/Tamable_Wildlife/insect_spider.json
msgid "water scorpion nymph"
msgid_plural "water scorpion nymphs"
msgstr[0] "ninfa de escorpión de agua"
msgstr[1] "ninfas de escorpión de agua"
msgstr[2] "ninfas de escorpión de agua"

#. ~ Description of monster "water scorpion nymph"
#: data/json/monsters/insect_spider.json
msgid ""
"The nymph of a water scorpion, looks like a smaller version of its parents."
msgstr ""
"La ninfa de un escorpión de agua, parece una versión más pequeña de sus "
"padres."

#. ~ Monster name
#: data/json/monsters/jabberwock.json
msgid "fleshy shambler"
msgid_plural "fleshy shamblers"
msgstr[0] "desastre carnoso"
msgstr[1] "desastres carnosos"
msgstr[2] "desastres carnosos"

#. ~ Description of monster "fleshy shambler"
#: data/json/monsters/jabberwock.json
msgid ""
"An amalgamation of throbbing organs from various creatures have fused "
"together into this lurching, vaguely-humanoid shape.  Its myriad roughly-"
"formed mouths susurrate in a chorus of sibilant groans and whispers."
msgstr ""
"Una amalgama de órganos palpitantes de varias criaturas que se han fusionado"
" en esta forma tambaleante y vagamente humanoide. Sus innumerables bocas de "
"forma tosca susurran en un coro de gemidos y susurros sibilantes."

#. ~ Monster name
#: data/json/monsters/jabberwock.json
msgid "flesh golem"
msgid_plural "flesh golems"
msgstr[0] "golem de carne"
msgstr[1] "golems de carne"
msgstr[2] "golems de carne"

#. ~ Description of monster "flesh golem"
#: data/json/monsters/jabberwock.json
msgid ""
"A seeping conglomeration of spasming muscle and organs have fused together "
"into this towering caricature of the human form.  Various organs fall off of"
" its hulking body only to be reabsorbed moments later."
msgstr ""
"Un conglomerado de músculos y órganos espasmódicos se han fusionado en esta "
"imponente caricatura de la forma humana. Varios órganos se caen de su cuerpo"
" mole sólo para ser reabsorbidos momentos después."

#. ~ Monster name
#: data/json/monsters/jabberwock.json
msgid "jabberwock"
msgid_plural "jabberwocks"
msgstr[0] "jabberwock"
msgstr[1] "jabberwocks"
msgstr[2] "jabberwocks"

#. ~ Description of monster "jabberwock"
#: data/json/monsters/jabberwock.json
msgid ""
"A putrid amalgamation of body parts from humans and other creatures have "
"fused together in this aberration of flesh.  The eyes of all the heads dart "
"about rapidly and the mouths form a chorus of groaning screams."
msgstr ""
"Es una combinación pútrida de partes de cuerpos humanos y otras criaturas "
"que se han fusionado para formar esta aberración de carnes. Los ojos de "
"todas las cabezas se mueven rápidamente y las bocas arman un coro de gritos "
"y quejidos."

#. ~ Monster name
#: data/json/monsters/kraken_spawn.json
msgid "stalker octopus"
msgid_plural "stalker octopuses"
msgstr[0] "pulpo mimético"
msgstr[1] "pulpos miméticos"
msgstr[2] "pulpos miméticos"

#. ~ Description of monster "stalker octopus"
#: data/json/monsters/kraken_spawn.json
msgid ""
"This octopus seems larger than you remember from visits to the aquarium and "
"doesn't seem as slowed by land as would be expected.  Its body seems to "
"mimic its surroundings."
msgstr ""
"Este pulpo parece más grande de lo que recuerdas haber visto en tus visitas "
"al acuario y no parece ser lento en tierra como sería de esperar. Su cuerpo "
"parece imitar sus alrededores."

#. ~ Monster name
#: data/json/monsters/kraken_spawn.json
msgid "octopus spawn"
msgid_plural "octopus spawns"
msgstr[0] "hueva de pulpo"
msgstr[1] "huevas de pulpo"
msgstr[2] "huevas de pulpo"

#. ~ Description of monster "octopus spawn"
#. ~ Description of monster "Cecaelian Spawn"
#: data/json/monsters/kraken_spawn.json
#: data/mods/Aftershock/mobs/uplifted_monsters.json
msgid ""
"A young Cecaelia.  If one is out here, a very protective parent is likely "
"nearby."
msgstr ""
"Una joven Cecaliano. Si uno está aquí, es probable que un padre muy "
"protector esté cerca."

#. ~ Monster name
#: data/json/monsters/kraken_spawn.json
msgid "kraken"
msgid_plural "kraken"
msgstr[0] "kraken"
msgstr[1] "kraken"
msgstr[2] "kraken"

#. ~ Description of monster "kraken"
#: data/json/monsters/kraken_spawn.json
msgid "The kind of octopus that can take down small boats by itself."
msgstr "El tipo de pulpo que puede hundir pequeños barcos."

#. ~ Monster name
#: data/json/monsters/kraken_spawn.json
msgid "scylla"
msgid_plural "scylla"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "scylla"
#: data/json/monsters/kraken_spawn.json
msgid ""
"The water froths as a great bulk of tentacles breach the surface.  A great "
"bulk swiftly rises until the beak rises above the water and a shriek erupts "
"from the beast."
msgstr ""

#. ~ Spell name
#: data/json/monsters/lab_security_drones.json
