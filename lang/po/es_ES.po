#: data/json/items/generic/string.json
msgid "rubber band"
msgid_plural "rubber bands"
msgstr[0] "goma elásticas"
msgstr[1] "gomas elásticas"
msgstr[2] "gomas elásticas"

#. ~ Description of "rubber band"
#: data/json/items/generic/string.json
msgid ""
"An elastic loop of rubber commonly used to hold multiple objects together."
msgstr ""
"Un círculo elástico de goma que se suele utilizar para mantener unidos "
"varios objetos."

#. ~ Item name
#: data/json/items/generic/toys_and_sports.json
msgid "talking doll"
msgid_plural "talking dolls"
msgstr[0] "muñeca parlante"
msgstr[1] "muñecas parlantes"
msgstr[2] "muñecas parlantes"

#. ~ Description of "talking doll"
#: data/json/items/generic/toys_and_sports.json
msgid ""
"This is a talking doll, meant for children.  Fortunately it still works, and"
" you could unload the batteries out of it."
msgstr ""
"Es una muñeca que habla, un juguete para niños. Por suerte, todavía funciona"
" y le podrías sacar las baterías."

#. ~ Item name
#: data/json/items/generic/toys_and_sports.json
msgid "figurine"
msgid_plural "figurines"
msgstr[0] "muñeco"
msgstr[1] "muñecos"
msgstr[2] "muñecos"

#. ~ Description of "figurine"
#: data/json/items/generic/toys_and_sports.json
msgid "Some kind of figurine.  It does not have much use nowadays."
msgstr "Algún tipo de muñeco. No tiene mucho uso hoy en día."

#. ~ Snippet of item "figurine"
#: data/json/items/generic/toys_and_sports.json
msgid "Shaped like a human female.  It was made to wear different clothes."
msgstr ""
"Tiene forma de mujer humana. Estaba diseñada para llevar diferentes "
"vestidos."

#. ~ Snippet of item "figurine"
#: data/json/items/generic/toys_and_sports.json
msgid ""
"This one wears a hat.  It wears a glove on it's right hand that has three "
"blades sticking out."
msgstr ""
"Este lleva un sombrero. Lleva un guante con tres hojas metálicas "
"sobresaliendo en su mano derecha."

#. ~ Snippet of item "figurine"
#: data/json/items/generic/toys_and_sports.json
msgid ""
"A blue unicorn that covers it's eyes with it's hooves.  It's in a sitting "
"position."
msgstr "Un unicornio azul que cubre sus ojos con sus pezuñas. Esta sentado."

#. ~ Snippet of item "figurine"
#: data/json/items/generic/toys_and_sports.json
msgid ""
"A pink unicorn that covers it's ears with it's hooves.  It's in a sitting "
"position."
msgstr "Un unicornio rosa que cubre su orejas con sus pezuñas. Esta sentado."

#. ~ Snippet of item "figurine"
#: data/json/items/generic/toys_and_sports.json
msgid ""
"A purple unicorn that covers it's mouth with it's hooves.  It's in a sitting"
" position."
msgstr "Un unicornio purpura que cubre su boca con sus pezuñas. Esta sentado."

#. ~ Snippet of item "figurine"
#: data/json/items/generic/toys_and_sports.json
msgid "It seems to wear a reindeer suit.  It has a skull for a head."
msgstr ""
"Parece que lleva un traje de reno. Tiene una calavera en vez de cabeza."

#. ~ Snippet of item "figurine"
#: data/json/items/generic/toys_and_sports.json
msgid "It looks like a swamp monster with scales over it's body."
msgstr "Parece un monstruo de la ciénaga con escamas sobre su cuerpo."

#. ~ Snippet of item "figurine"
#: data/json/items/generic/toys_and_sports.json
msgid "It looks like the reaper.  In it's left hand is a scythe."
msgstr "Parece la muerte. Tiene una guadaña en su mano izquierda."

#. ~ Snippet of item "figurine"
#: data/json/items/generic/toys_and_sports.json
msgid "A mermaid sitting on a rock.  It has red hair."
msgstr "Un sirena sentada en una roca. Tiene el pelo rojo."

#. ~ Snippet of item "figurine"
#: data/json/items/generic/toys_and_sports.json
msgid ""
"It seems to wear an avocado suit.  In the left hand is a salt shaker and in "
"the right hand is a spoon.  It's in a sitting position."
msgstr ""
"Parece llevar un traje de aguacate. En su mano izquierda sujeta un salero y "
"una cuchara en la derecha. Esta sentado."

#. ~ Snippet of item "figurine"
#: data/json/items/generic/toys_and_sports.json
msgid ""
"Looks like someone's hero.  You can bend the arms and legs to give it "
"different stances."
msgstr ""
"Parece el típico héroe. Puedes doblar los brazos y piernas para darle "
"diferentes posturas."

#. ~ Item name
#: data/json/items/generic/toys_and_sports.json
msgid "swimming kickboard"
msgid_plural "swimming kickboards"
msgstr[0] "tabla de nadar"
msgstr[1] "tablas de nadar"
msgstr[2] "tablas de nadar"

#. ~ Description of "swimming kickboard"
#: data/json/items/generic/toys_and_sports.json
msgid ""
"A swimming kickboard, would be a great training aid for the beach or the "
"pool, if only they weren't full of zombies and mutant fish."
msgstr ""
"Una tabla de nadar que sería perfecta para entrenar en la playa o en la "
"piscina si no fuera porque está lleno de zombis y peces mutantes."

#. ~ Item name
#: data/json/items/generic/toys_and_sports.json
msgid "badminton shuttlecock"
msgid_plural "shuttlecocks"
msgstr[0] "volante de badminton"
msgstr[1] "volantes de badminton"
msgstr[2] "volantes de badminton"

#. ~ Description of "badminton shuttlecock"
#: data/json/items/generic/toys_and_sports.json
msgid "A high-drag projectile used in the sport of badminton."
msgstr "Un proyectil de alta resistencia usado en el deporte del bádminton."

#. ~ Item name
#: data/json/items/generic/toys_and_sports.json
msgid "golf tee"
msgid_plural "golf tees"
msgstr[0] "tee"
msgstr[1] "tees"
msgstr[2] "tees"

#. ~ Description of "golf tee"
#: data/json/items/generic/toys_and_sports.json
msgid ""
"A pin-shaped piece of wood meant for holding a golf ball slightly off the "
"ground."
msgstr ""
"Una pieza de madera con forma de alfiler, que se usa para sostener una "
"pelota de golf levantada del suelo."

#. ~ Item name
#: data/json/items/generic/toys_and_sports.json
msgid "golf ball"
msgid_plural "golf balls"
msgstr[0] "bola de golf"
msgstr[1] "bolas de golf"
msgstr[2] "bolas de golf"

#. ~ Description of "golf ball"
#: data/json/items/generic/toys_and_sports.json
msgid "A small, hard plastic ball with round indentations on it."
msgstr "Una pequeña bola con agujeritos circulares en su superficie."

#. ~ Item name
#: data/json/items/generic/toys_and_sports.json
msgid "pool ball"
msgid_plural "pool balls"
msgstr[0] "bola de billar"
msgstr[1] "bolas de billar"
msgstr[2] "bolas de billar"

#. ~ Description of "pool ball"
#: data/json/items/generic/toys_and_sports.json
msgid ""
"A colorful, hard plastic ball for playing games on a pool table.  "
"Essentially a rock."
msgstr ""
"Una colorida bola de plástico duro que se usa para jugar en una mesa de "
"billar. Es, básicamente, una piedra."

#. ~ Item name
#: data/json/items/generic/toys_and_sports.json
msgid "bowling ball"
msgid_plural "bowling balls"
msgstr[0] "bola de bolos"
msgstr[1] "bolas de bolos"
msgstr[2] "bolas de bolos"

#. ~ Description of "bowling ball"
#: data/json/items/generic/toys_and_sports.json
msgid ""
"A large, heavy ball with finger holes for better grip.  Before the "
"apocalypse, its main purpose was to be rolled along waxed floors."
msgstr ""
"Una bola grande y pesada con agujeros para poder agarrarla con los dedos. "
"Antes del apocalipsis, su principal propósito era rodar por suelos "
"encerados."

#. ~ Item name
#: data/json/items/generic/toys_and_sports.json
msgid "baseball"
msgid_plural "baseballs"
msgstr[0] "pelota de béisbol"
msgstr[1] "pelotas de béisbol"
msgstr[2] "pelotas de béisbol"

#. ~ Description of "baseball"
#: data/json/items/generic/toys_and_sports.json
msgid ""
"A baseball, good for throwing at enemies.  Getting hit with one of these "
"hurts a lot more than you might think."
msgstr ""
"Una pelota de béisbol, sirve para tirarle a los enemigos. Si te pegan con "
"una de estas, te va a doler mucho más de lo que te imaginás."

#. ~ Item name
#: data/json/items/generic/toys_and_sports.json
msgid "football"
msgid_plural "footballs"
msgstr[0] "pelota de fútbol americano"
msgstr[1] "pelotas de fútbol americano"
msgstr[2] "pelotas de fútbol americano"

#. ~ Description of "football"
#: data/json/items/generic/toys_and_sports.json
msgid ""
"An oval-shaped ball made of leather and string, it's easily thrown but does "
"little damage.  You could take it apart into leather if you wanted."
msgstr ""
"Una pelota en forma de óvalo hecha de cuero y cuerda, fácil de lanzar pero "
"que hace poco daño. La puedes desarmar para recuperar el cuero, si "
"quisieras."

#. ~ Item name
#: data/json/items/generic/toys_and_sports.json
#: data/mods/Dark-Skies-Above/overrides/items/generics.json
msgid "basketball"
msgid_plural "basketballs"
msgstr[0] "balón de baloncesto"
msgstr[1] "balones de baloncesto"
msgstr[2] "balones de baloncesto"

#. ~ Description of "basketball"
#: data/json/items/generic/toys_and_sports.json
msgid "A high-quality, size 7 indoor basketball."
msgstr "Una pelota de baloncesto número 7 de buena calidad."

#. ~ Item name
#: data/json/items/generic/toys_and_sports.json
msgid "volleyball"
msgid_plural "volleyballs"
msgstr[0] "pelota de volleyball"
msgstr[1] "pelotas de volleyball"
msgstr[2] "pelotas de volleyball"

#. ~ Description of "volleyball"
#: data/json/items/generic/toys_and_sports.json
msgid "A standard regulation volleyball."
msgstr "Una pelota de volleyball de regulación estándar."

#. ~ lazerlyte trainer target was used as a reference
#. ~ Item name
#: data/json/items/generic/toys_and_sports.json
msgid "aim game target practice kit"
msgid_plural "aim game target practice kits"
msgstr[0] "objetivo de práctica de juego de puntería"
msgstr[1] "objetivos de práctica de juego de puntería"
msgstr[2] "objetivos de práctica de juego de puntería"

#. ~ lazerlyte trainer target was used as a reference
#. ~ Description of "aim game target practice kit"
#: data/json/items/generic/toys_and_sports.json
msgid ""
"A collection of laser guns and targets designed to help you practice "
"shooting.  The spot you 'hit' is displayed on the targets."
msgstr ""
"Un conjunto de armas y objetivos láser diseñados para ayudarte a practicar "
"la puntería. El lugar dónde 'impactas' queda marcado en los objetivos."

#. ~ Item name
#: data/json/items/generic/toys_and_sports.json
msgid "beach volleyball"
msgid_plural "beach volleyballs"
msgstr[0] "pelota de voley playa"
msgstr[1] "pelotas de voley playa"
msgstr[2] "pelotas de voley playa"

#. ~ Description of "beach volleyball"
#: data/json/items/generic/toys_and_sports.json
msgid ""
"A brightly colored beach volleyball.  It is slightly larger than a regular "
"white one."
msgstr ""
"Una colorida pelota de volleyball playa. Es ligeramente más grande que una "
"pelota de volleyball blanca normal."

#. ~ Item name
#: data/json/items/generic/toys_and_sports.json
msgid "hockey puck"
msgid_plural "hockey pucks"
msgstr[0] "disco de hockey"
msgstr[1] "discos de hockey"
msgstr[2] "discos de hockey"

#. ~ Description of "hockey puck"
#: data/json/items/generic/toys_and_sports.json
msgid ""
"A heavy circular block of solid rubber, normally used for playing hockey.  "
"You can throw it to cause some serious harm."
msgstr ""
"Es un disco pesado de goma sólida, normalmente utilizado para jugar al "
"hockey sobre hielo. Se lo puedes lanzar a un enemigo para causar daño "
"bastante serio."

#. ~ Description of "mannequin"
#: data/json/items/generic/toys_and_sports.json
msgid ""
"A figure of an adult human, as seen in the display case at the mall.  It "
"might be able to fool some zombies if it could attract their attention."
msgstr ""
"Es la figura de un humano adulto, la que se encuentra en los escaparates de "
"una tienda. Puede ser capaz de engañar a algún zombie si atrajera su "
"atención."

#. ~ Item name
#. ~ Monster name
#: data/json/items/generic/toys_and_sports.json data/json/monsters/misc.json
msgid "mannequin decoy"
msgid_plural "mannequin decoys"
msgstr[0] "maniquí señuelo"
msgstr[1] "maniquíes señuelo"
msgstr[2] "maniquíes señuelo"

#. ~ Description of "mannequin decoy"
#: data/json/items/generic/toys_and_sports.json
msgid ""
"A figure of an adult human, as seen in the display case at the mall.  This "
"one is cradling a talking doll.  It can make sound when powered by batteries"
" and can be used to distract some zombies."
msgstr ""
"Es la figura de un humano adulto, la que se encuentra en los escaparates de "
"las tiendas. Este está sosteniendo un muñeca parlante. Puede emitir sonidos "
"cuando está alimentado con baterías y se puede usar para distraer a los "
"zombis."

#. ~ "friendly_msg" action message of item "mannequin decoy"
#: data/json/items/generic/toys_and_sports.json
msgid "You activate the talking doll on the mannequin."
msgstr "Activas el muñeco parlante del maniquí."

#. ~ "hostile_msg" action message of item "mannequin decoy"
#: data/json/items/generic/toys_and_sports.json
msgid ""
"Your mannequin seems to have a mind of its own!  If you see this, an error "
"has occurred."
msgstr ""
"¡Tu maniquí parece tener voluntad propia! Si te aparece esto, sucedió algún "
"error."

#. ~ Name of a gun
#: data/json/items/gun/10mm.json
msgid "10mm/.40 revolver"
msgid_plural "10mm/.40 revolvers"
msgstr[0] "revólver 10mm/.40"
msgstr[1] "revólveres 10mm/.40"
msgstr[2] "revólveres 10mm/.40"

#. ~ Description of gun "10mm/.40 revolver"
#: data/json/items/gun/10mm.json
msgid "A classic six-shooter revolver chambered for 10mm and .40 rounds."
msgstr ""
"Un revólver clásico de seis tiros con cámara para munición 10mm y .40."

#. ~ Variant name of gun "10mm/.40 revolver"
#: data/json/items/gun/10mm.json
msgid "S&W 610"
msgid_plural "S&W 610"
msgstr[0] "S&W 610"
msgstr[1] "S&W 610"
msgstr[2] "S&W 610"

#. ~ Description of variant "10mm/.40 revolver" of gun "S&W 610"
#: data/json/items/gun/10mm.json
msgid ""
"The Smith and Wesson 610 is a classic six-shooter revolver chambered for "
"10mm rounds, or for S&W's own .40 round."
msgstr ""
"La Smith & Wesson 610 es un revólver clásico de seis disparos para balas "
"calibre 10mm, o para las propias de la marca S$W, el calibre .40."

#. ~ Name of a gun
#: data/json/items/gun/10mm.json
msgid "compact Glock pistol"
msgid_plural "compact Glock pistols"
msgstr[0] "pistola compacta Glock"
msgstr[1] "pistolas compactas Glock"
msgstr[2] "pistolas compactas Glock"

#. ~ Description of gun "compact Glock pistol"
#: data/json/items/gun/10mm.json
msgid ""
"A small pistol accepting Glock magazines and chambered in 10mm.  Because of "
"its size, it is easy to carry, but it has rather fierce recoil."
msgstr ""
"Una pistola pequeña que acepta cargadores Glock y que tiene recámara de 10 "
"mm.  Debido a su tamaño, es fácil de llevar, pero tiene un retroceso "
"bastante fuerte."

#. ~ Variant name of gun "compact Glock pistol"
#: data/json/items/gun/10mm.json
msgid "Glock 29"
msgid_plural "Glock 29s"
msgstr[0] "Glock 29"
msgstr[1] "Glocks 29"
msgstr[2] "Glocks 29"

#. ~ Description of variant "compact Glock pistol" of gun "Glock 29"
#: data/json/items/gun/10mm.json
msgid ""
"A modestly sized version of the highly successful Glock, chambered in hard-"
"hitting 10mm Auto.  It is easy to carry because of its small size, but also "
"recoils fiercely."
msgstr ""
"Una versión de tamaño modesto de la exitosa Glock, con recámara de 10mm "
"Auto. Es fácil de llevar debido a su pequeño tamaño, pero también retrocede "
"ferozmente."

#. ~ Name of a gun
#: data/json/items/gun/10mm.json data/json/items/gun/45.json
msgid "Glock pistol"
msgid_plural "Glock pistols"
msgstr[0] "pistola Glock"
msgstr[1] "pistolas Glock"
msgstr[2] "pistolas Glock"

#. ~ Description of gun "Glock pistol"
#: data/json/items/gun/10mm.json
msgid ""
"A semi-automatic pistol chambered in 10mm and accepting Glock magazines."
msgstr ""
"Una pistola semiautomática con recámara de 10mm que acepta cargadores Glock."

#. ~ Variant name of gun "Glock pistol"
#: data/json/items/gun/10mm.json
msgid "Glock 20"
msgid_plural "Glock 20s"
msgstr[0] "Glock 20"
msgstr[1] "Glocks 20"
msgstr[2] "Glocks 20"

#. ~ Description of variant "Glock pistol" of gun "Glock 20"
#: data/json/items/gun/10mm.json
msgid ""
"A full-sized version of the highly successful Glock, chambered in hard-"
"hitting 10mm Auto.  The third model of Glock designed, all other full-sized,"
" large framed Glocks are adaptations of this one."
msgstr ""
"Una versión de tamaño completo de la exitosa Glock, con recámara de 10mm "
"Auto. El tercer modelo de Glock diseñado, todas las demás Glock de otros "
"tamaños y estructura grandes son adaptaciones de esta."

#. ~ Variant name of gun "Glock pistol"
#: data/json/items/gun/10mm.json
msgid "Glock 40 MOS"
msgid_plural "Glock 40 MOSs"
msgstr[0] "Glock 40 SOM"
msgstr[1] "Glocks 40 SOM"
msgstr[2] "Glocks 40 SOM"

#. ~ Description of variant "Glock pistol" of gun "Glock 40 MOS"
#: data/json/items/gun/10mm.json
msgid ""
"A full-sized, long-slide version of the highly successful Glock, chambered "
"in hard-hitting 10mm Auto.  The extra barrel length makes for slightly more "
"accurate and powerful shots, and the extra slide length means the sights are"
" a little easier to use.  It also features Glock's Modular Optic System, "
"making aftermarket optics much easier to mount."
msgstr ""
"Una versión de tamaño completo de corredera larga de la exitosa Glock, con "
"el potente calibre 10mm Auto. El tamaño más largo del cañón le da un poco "
"más de precisión y potencia a los disparos, y la mayor longitud de la "
"corredera significa que las miras son un poco más fáciles de usar. También "
"posee el Sistema Óptico Modular de Glock, lo que hace que las ópticas de "
"mercados secundarios sean mucho más fáciles de montar."

#. ~ Name of a gun
#: data/json/items/gun/10mm.json
msgid "BA10 rifle"
msgid_plural "BA10 rifles"
msgstr[0] "rifle BA10"
msgstr[1] "rifles BA10"
msgstr[2] "rifles BA10"

#. ~ Description of gun "BA10 rifle"
#: data/json/items/gun/10mm.json
msgid "A semi-automatic rifle chambered in 10mm and accepting BA10 magazines."
msgstr "Un rifle semiautomático de calibre 10mm que utiliza cargadores BA10."

#. ~ Variant name of gun "BA10 rifle"
#: data/json/items/gun/10mm.json
msgid "BA10"
msgid_plural "BA10s"
msgstr[0] "BA10"
msgstr[1] "BA10s"
msgstr[2] "BA10s"

#. ~ Description of variant "BA10 rifle" of gun "BA10"
#: data/json/items/gun/10mm.json
msgid ""
"The MP5/10 served the FBI briefly alongside their 10mm Auto pistols, adding "
"to the caliber's overall mystique.  Though the gun's usage was short-lived, "
"a handful of clones were made and sold occasionally.  This semi-automatic "
"clone manufactured by Brethren Arms features a welded-on M1913 rail and a "
"collapsible arm brace."
msgstr ""
"La MP5/10 sirvió brevemente al FBI junto con sus pistolas Auto de 10 mm, lo "
"que aumentó la mística general del calibre.  Aunque su uso fue breve, se "
"fabricaron algunos clones que se vendieron ocasionalmente.  Este clon "
"semiautomático fabricado por Brethren Arms cuenta con un raíl M1913 soldado "
"y un soporte de brazo plegable."

