msgid "Corpse-like"
msgstr "Como un cadáver"

#. ~ Name of effect type id "withering"
#: data/mods/Xedra_Evolved/effects/effects.json
msgid "Eternal Slumber"
msgstr "Sueño eterno"

#. ~ Name of effect type id "withering"
