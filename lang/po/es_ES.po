#: data/json/effects.json
msgid "Your acid glands got all leaky."
msgstr "Tus glándulas de ácido tienen fugas."

#. ~ Name of effect type id "elec_charged"
#: data/json/effects.json
msgid "Charged Capacitor"
msgstr "Condensador cargado"

#. ~ Description of effect type "Charged Capacitor"
#: data/json/effects.json
msgid "Your capacitors sizzle with bioelectricity."
msgstr "Tus condensadores chisporrotean de bioelectricidad."

#. ~ Name of effect type id "maimed_capacitor"
#: data/json/effects.json
msgid "Maimed Capacitor"
msgstr "Condensador Mutilado"

