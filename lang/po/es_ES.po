msgstr "Sordo"

#. ~ Name of effect type id "deaf"
#: data/json/effects.json
msgid "Impaired Hearing"
msgstr "Audición Disminuida"

#. ~ Name of effect type id "deaf"
#: data/json/effects.json
msgid "Ringing Ears"
msgstr "Zumbido en Oídos"

