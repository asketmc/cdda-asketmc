msgstr[2] "pulmsnes a la provenza"

#. ~ Description of "lung provence"
#: data/json/items/comestibles/offal_dishes.json
msgid ""
"A French lung dish, made by poaching the lungs before pan-frying them with "
"onion, tomato, seasonings, and a generous amount of wine."
msgstr ""
"Un plato francés con pulmón, hecho hirviendo los pulmones antes de freírlos "
"con cebolla, tomate, condimentos y una generosa cantidad de vino."

#. ~ Item name
#: data/json/items/comestibles/offal_dishes.json
msgid "töttchen"
msgid_plural "töttchens"
msgstr[0] "töttchen"
msgstr[1] "töttchens"
msgstr[2] "töttchens"

#. ~ Description of "töttchen"
#: data/json/items/comestibles/offal_dishes.json
msgid ""
"A German peasant dish that converts many less-desirable meat cuts and organs"
" into a palatable meal with the liberal application of butter, sugar, and "
"wine."
msgstr ""
"Un plato campesino alemán que convierte cualquier corte de carne u órganos "
"no tan deseables en una comida más apetitosa con la libre aplicación de "
"manteca, azúcar y vino."

#. ~ Item name
#: data/json/items/comestibles/offal_dishes.json
msgid "scrambled eggs and brain"
msgid_plural "scrambled eggs and brains"
msgstr[0] "huevos revueltos y cerebro"
msgstr[1] "huevos revueltos y cerebros"
msgstr[2] "huevos revueltos y cerebros"

#. ~ Description of "scrambled eggs and brain"
#: data/json/items/comestibles/offal_dishes.json
msgid "Brain and eggs, why didn't you ever think to put these together?"
msgstr ""
"Cerebros y huevos ¿por qué no se te había ocurrido nunca ponerlos juntos?"

#. ~ Item name
#: data/json/items/comestibles/offal_dishes.json
msgid "sausage casing"
msgid_plural "sausage casings"
