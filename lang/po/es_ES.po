#: data/mods/Xedra_Evolved/items/drugs.json
#, c-format
msgid "You take the %s."
msgstr "Te tomas una %s."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "calcium tablet"
msgid_plural "calcium tablets"
msgstr[0] "comprimido de calcio"
msgstr[1] "comprimidos de calcio"
msgstr[2] "comprimidos de calcio"

#. ~ Description of "calcium tablet"
#: data/json/items/comestibles/med.json
msgid ""
"A white calcium tablet.  Widely used by elderly people with osteoporosis as "
"a method to supplement calcium before the apocalypse."
msgstr ""
"Un comprimido blanco de calcio.  Antes del apocalipsis era comúnmente usadao"
" por gente anciana con osteoporosis como una manera de suplementar el "
"calcio."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "bone meal tablet"
msgid_plural "bone meal tablets"
msgstr[0] "comprimido de harina de huesos"
msgstr[1] "comprimidos de harina de huesos"
msgstr[2] "comprimidos de harina de huesos"

#. ~ Description of "bone meal tablet"
#: data/json/items/comestibles/med.json
msgid ""
"A homemade calcium supplement made out of bone meal.  Tastes horrible and is"
" hard to swallow but it does its job."
msgstr ""
"Suplemento de calcio casero hecho de harina de huesos. Sabe horrible y es "
"difícil de tragar, pero cumple su función."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "flavored bone meal tablet"
msgid_plural "flavored bone meal tablets"
msgstr[0] "comprimido de harina de huesos con sabor"
msgstr[1] "comprimidos de harina de huesos con sabor"
msgstr[2] "comprimidos de harina de huesos con sabor"

#. ~ Description of "flavored bone meal tablet"
#: data/json/items/comestibles/med.json
msgid ""
"A homemade calcium supplement made out of bone meal.  Due to some sweeteners"
" mixed in to counteract the powdery texture and the taste of ash, it's "
"almost as palatable as the pre-Cataclysm tablets."
msgstr ""
"Un suplemento de calcio casero hecho de harina de hueso.  Debido a algún "
"endulzante que ha sido mezclado para contrarrestar la textura de polvo y el "
"gusto a ceniza, es casi tan apetitoso como una píldora de antes del "
"Cataclismo."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "gummy vitamin"
msgid_plural "gummy vitamins"
msgstr[0] "vitamina masticable"
msgstr[1] "vitaminas masticables"
msgstr[2] "vitaminas masticables"

#. ~ Description of "gummy vitamin"
#: data/json/items/comestibles/med.json
msgid ""
"Essential dietary nutrients conveniently packaged in a fruit-flavored chewy "
"candy form.  An option of last resort when a balanced diet is not possible."
"  Excess use can cause hypervitaminosis."
msgstr ""
"Nutrientes dietéticos esenciales convenientemente envasados en forma de "
"caramelo masticable con sabor a fruta. Una opción de último recurso cuando "
"no es posible seguir una dieta equilibrada. Su uso excesivo puede causar "
"hipervitaminosis."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "homeopathic pill"
msgid_plural "homeopathic pills"
msgstr[0] "pildora homeopática"
msgstr[1] "pildoras homeopáticas"
msgstr[2] "pildoras homeopáticas"

#. ~ Description of "homeopathic pill"
#: data/json/items/comestibles/med.json
msgid ""
"A homeopathic pill, prepared through the repeated dilution of an active "
"ingredient with water.  The label purports that these pills are able to "
"maintain general wellness."
msgstr ""
"Una píldora homeopática, preparada mediante la disolución repetida de un "
"ingrediente activo con agua. La etiqueta afirma que estas píldoras son "
"capaces de mantener el bienestar general."

#. ~ "activation_message" action message of item "homeopathic pill"
#: data/json/items/comestibles/med.json
#, c-format
msgid "You swallow the %s.  You wait in anticipation of its effects."
msgstr "Te tragas la %s. Esperas en anticipación sus efectos."

#. ~ Snippet of item "homeopathic pill"
#: data/json/items/comestibles/med.json
msgid ""
"An Oscillococcinum homeopathic pill, prepared through the dilution of one "
"part duck offal with 10^400 parts water.  The label purports that these "
"pills are able to treat flu-like symptoms and maintain general wellness."
msgstr ""
"Una pastilla homeopática Oscillococcinum, preparada a través de la "
"disolución de una parte de achuras de pato en 10^400 partes de agua. La "
"etiqueta afirma que esta pastilla es capaz de tratar los síntomas similares "
"a la gripe y mantener el bienestar general."

#. ~ Snippet of item "homeopathic pill"
#: data/json/items/comestibles/med.json
msgid ""
"An Arsenicum album homeopathic pill, prepared through the dilution of one "
"part arsenic trioxide with 10^24 parts water.  Purported to treat anxiety, "
"various digestive disorders, and arsenic poisoning."
msgstr ""
"Una pastilla homeopática Arsenicum, preparada a través de la disolución de "
"una parte de trióxido de arsénico en 10^24 partes de agua. Pensada para "
"tratar la ansiedad, varios desórdenes digestivos y el envenenamiento por "
"arsénico."

#. ~ Snippet of item "homeopathic pill"
#: data/json/items/comestibles/med.json
msgid ""
"An Allium cepa homeopathic pill, prepared through the dilution of one part "
"onion with 10^30 parts water.  The label states that these pills can "
"ameliorate symptoms of asthma, gastrointestinal disorders, and bronchitis.  "
"You briefly wonder if it can cure fungal infections."
msgstr ""
"Una pastilla homeopática Allium cepa, preparada a través de la disolución de"
" una parte de cebolla en 10^30 partes de agua. La etiqueta establece que "
"esta pastilla puede aliviar los síntomas del asma, desórdenes "
"gastrointestinales y bronquitis. Por un momento, te preguntas si curará las "
"infecciones fúngicas."

#. ~ Snippet of item "homeopathic pill"
#: data/json/items/comestibles/med.json
msgid ""
"An Arum tryphillum homeopathic pill, prepared through the dilution of the "
"jack-in-the-pulpit plant with 10^30 parts water.  The label claims that the "
"pills are able to treat voice loss."
msgstr ""
"Una pastilla homeopática Arum tryphillum, preparada a través de la "
"disolución de la planta Arisaema triphyllum en 10^400 partes de agua. La "
"etiqueta dice que la pastilla es capaz de tratar la pérdida de la voz."

#. ~ Snippet of item "homeopathic pill"
#: data/json/items/comestibles/med.json
msgid ""
"An Aesculus hippocastanum homeopathic pill, prepared through the dilution of"
" horse chestnut with 10^30 parts water.  These pills are meant to treat "
"dysentery and hemorrhoids."
msgstr ""
"Una pastilla homeopática Aesculus hippocastanum, preparada a través de la "
"disolución de castaña de Indias con 10^30 partes de agua. Se supone que esta"
" pastilla trata la disentería y las hemorroides."

#. ~ Snippet of item "homeopathic pill"
#: data/json/items/comestibles/med.json
msgid ""
"A Lachesis mutus pill, prepared through the dilution of the venom of the "
"bushmaster snake with 10^1000 parts water.  These pills are claimed to be an"
" effective treatment for sore throat."
msgstr ""
"Una pastilla Lachesis mutus, preparada a través de la disolución de veneno "
"de una víbora cascabel en 10^1000 partes de agua. Estas pastillas dicen ser "
"efectiva en el tratamiento del dolor de garganta."

#. ~ Item name
#: data/json/items/comestibles/med.json
