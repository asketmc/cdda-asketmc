#. ~ Profession name for male
#: data/json/hobbies.json
msgctxt "profession_male"
msgid "Butchering"
msgstr "Descuartizador"

#. ~ Description of profession "Butchering" for male
#: data/json/hobbies.json
msgctxt "prof_desc_male"
msgid ""
"You absolutely love meat, and dislike eating fruits and vegetables.  Your "
"particular tastes have turned you into a decent amateur butcher."
msgstr ""
"Te encanta la carne y no te gusta comer frutas y verduras. Tus particulares "
"gustos te han convertido en un decente carnicero aficionado."

