#: data/json/effects.json
msgid "At least one of your bionics is producing heat and warming you."
msgstr "Al menos uno de tus biónicos está produciendo calor y calentándote."

#. ~ Name of effect type id "winded"
#: data/json/effects.json
msgid "Winded"
msgstr "Faltando el aire"

#. ~ Description of effect type "Winded"
#: data/json/effects.json
msgid ""
"You're short of breath.  Running and fighting will be difficult until you "
"recover."
msgstr ""
"Te falta el aire. Correr y pelear será difícil hasta que puedas recuperar el"
" aliento."

#. ~ Apply message of effect type "Winded"
#: data/json/effects.json
msgid "Your breath gives out!"
msgstr "¡Te falla la respiración!"

#. ~ Remove message of effect type "Winded"
#: data/json/effects.json
msgid "You catch your breath."
msgstr "Recuperas el aliento."

#. ~ Apply message of effect type "darkness"
#: data/json/effects.json
msgid "Your vision flickers and goes gray!"
msgstr "¡Tu visión va y viene y ves todo gris!"

#. ~ Remove message of effect type "darkness"
#: data/json/effects.json
msgid "The world flickers back to normality."
msgstr "El mundo parpadea y vuelve a la normalidad."

#. ~ Name of effect type id "stunned"
#: data/json/effects.json
msgid "Stunned"
msgstr "Aturdido"

#. ~ Description of effect type "Stunned"
#: data/json/effects.json
msgid "Your movement is randomized."
msgstr "Tu movimiento es aleatorio."

#. ~ Apply message of effect type "Stunned"
#. ~ Apply message of effect type "Sensor scrambling"
#: data/json/effects.json
msgid "You're stunned!"
msgstr "¡Estás aturdido!"

#. ~ Name of effect type id "sensor_stun"
#: data/json/effects.json
msgid "Sensor scrambling"
msgstr "Sensores mezclados"

