#. ~ Item name
#: data/json/items/comestibles/brewing.json
msgid "seltzer wort"
msgid_plural "seltzer worts"
msgstr[0] "mosto de seltzer"
msgstr[1] "mostos de seltzer"
msgstr[2] "mostos de seltzer"

#. ~ Description of "seltzer wort"
#: data/json/items/comestibles/brewing.json
