#: data/json/items/comestibles/alcohol.json
msgid "A tasty craft beer, as dark in color as the days ahead."
msgstr ""
"Una sabrosa cerveza artesanal, tan negra de color como los días futuros."

#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "Belgian ale"
msgid_plural "Belgian ale"
msgstr[0] "Ale Belga"
msgstr[1] "Ale Belga"
msgstr[2] "Ale Belga"

#. ~ Description of "Belgian ale"
#: data/json/items/comestibles/alcohol.json
msgid ""
"A flavorful and filling beer brewed by monks in Belgium.  Best served in a "
"goblet."
msgstr ""
"Una cerveza sabrosa y que llena elaborada por monjes en Bélgica. Se sirve "
"mejor en un cáliz."

#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "imperial stout"
msgid_plural "imperial stout"
msgstr[0] "stout imperial"
msgstr[1] "stout imperial"
msgstr[2] "stout imperial"

#. ~ Description of "imperial stout"
#: data/json/items/comestibles/alcohol.json
msgid ""
"A very flavorful beer that has been aged in bourbon barrels.  It is as black"
" as midnight on a moonless night and has the viscosity of oil.  While very "
"tasty, it also has an alcohol content on par with wine."
msgstr ""
"Una cerveza muy sabrosa que ha sido envejecida en barriles de bourbon. Es "
"tan negra como la medianoche en una noche sin luna y tiene la viscosidad del"
" aceite. Aunque es muy sabrosa, también tiene una graduación alcohólica a la"
" altura del vino."

#. ~ Item name
#: data/json/items/comestibles/alcohol.json
