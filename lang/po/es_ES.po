#: data/json/effects.json
msgid "Weak Player Venom"
msgstr "Veneno de Jugador Débil"

#. ~ Description of effect type "Weak Player Venom"
#: data/json/effects.json
msgid "Don't worry, you shouldn't get this."
msgstr "No te preocupes, no deberías tener esto."

#. ~ Name of effect type id "venom_player2"
#: data/json/effects.json
