msgid_plural "glass terrariums"
msgstr[0] "terrario de vidrio"
msgstr[1] "terrarios de vidrio"
msgstr[2] "terrarios de vidrio"

#. ~ Description of "glass terrarium"
#: data/json/items/tool/pets.json
