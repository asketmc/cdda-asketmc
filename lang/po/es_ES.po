msgid_plural "border collies"
msgstr[0] "border collie"
msgstr[1] "border collies"
msgstr[2] "border collies"

#. ~ Description of monster "border collie"
#: data/json/monsters/mammal.json
msgid ""
"An athletic and hyperactive dog that loves to herd animals and jump, the "
"Border Collie is an agile attacker.  Although they can be easy to train, "
"they don't work well in packs."
msgstr ""
"Un perro atlético e hiperactivo al que le encanta arrear animales y saltar, "
"el Border Collie es un ágil atacante. Aunque pueden ser fáciles de entrenar,"
" no funcionan bien en manadas."

#. ~ Monster name
#: data/json/monsters/mammal.json
msgid "border collie puppy"
msgid_plural "border collie puppies"
msgstr[0] "cachorro de border collie"
msgstr[1] "cachorros de border collie"
msgstr[2] "cachorros de border collie"

