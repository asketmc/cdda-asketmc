#. ~ Profession name for male
#: data/json/professions.json
#: data/mods/Dark-Skies-Above/overrides/professions.json
msgctxt "profession_male"
msgid "Nursing Assistant"
msgstr "Auxiliar de enfermería"

#. ~ Description of profession "Nursing Assistant" for male
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You went on providing in-home care for the elderly even as the whole world "
"fell apart around you.  You can only pray that you don't see your former "
"clients among the walking dead…"
msgstr ""
"Seguiste proporcionando cuidados a domicilio a los ancianos incluso cuando "
"el mundo entero se desmoronaba a tu alrededor. Sólo puedes rezar para no ver"
" a tus antiguos clientes entre los muertos vivientes..."

#. ~ Profession name for female
#: data/json/professions.json
#: data/mods/Dark-Skies-Above/overrides/professions.json
