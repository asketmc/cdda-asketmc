#. ~ Item name
#: data/json/items/tool_armor.json
msgid "RM13 combat armor"
msgid_plural "RM13 combat armors"
msgstr[0] "armadura de combate RM13"
msgstr[1] "armaduras de combate RM13"
msgstr[2] "armaduras de combate RM13"

#. ~ Description of "RM13 combat armor"
#: data/json/items/tool_armor.json
msgid ""
"This full-body suit of sleek black military armor represents the pinnacle of"
" Rivtech's powered armor technology.  It has a proprietary internal battery "
"recharged by UPS.  Use it to turn it on."
msgstr ""
"Este traje de cuerpo entero de elegante armadura militar negra representa la"
" cúspide de la tecnología de armaduras eléctricas de Rivtech. Tiene una "
"batería interna propia que se recarga con un UPS. Usar para encender."

#. ~ Item name
#: data/json/items/tool_armor.json
msgid "RM13 combat armor (on)"
msgid_plural "RM13 combat armors (on)"
msgstr[0] "armadura de combate RM13 (on)"
msgstr[1] "armaduras de combate RM13 (on)"
msgstr[2] "armaduras de combate RM13 (on)"

#. ~ Description of "RM13 combat armor (on)"
#: data/json/items/tool_armor.json
msgid ""
"This full-body suit of sleek black military armor represents the pinnacle of"
" Rivtech's powered armor technology.  As you move your fingers over the "
"surface the armor tenses almost as though it were alive.  Use it to turn it "
"off."
msgstr ""
"Este traje de cuerpo entero de elegante armadura militar negra representa la"
" cúspide de la tecnología de armaduras motorizadas de Rivtech. Al mover los "
"dedos sobre la superficie, la armadura se tensa casi como si estuviera viva."
" Usar para apagar."

#. ~ Item name
#: data/json/items/tool_armor.json
msgid "5-point anchor"
msgid_plural "5-point anchors"
msgstr[0] "Ancla de 5 puntos"
msgstr[1] "Anclas de 5 puntos"
msgstr[2] "Anclas de 5 puntos"

#. ~ Description of "5-point anchor"
#: data/json/items/tool_armor.json
msgid ""
"A featureless, disc-shaped device mounted on a harness.  The words "
"\"X.E.D.R.A\" and \"5-point anchor\" are inscribed on its front and back."
msgstr ""
"Un dispositivo sin características, en forma de disco, montado en un arnés. "
"Las palabras \"X.E.D.R.A\" y \"ancla de 5 puntos\" están inscritas en su "
"parte delantera y trasera."

#. ~ "msg" action message of item "5-point anchor"
#: data/json/items/tool_armor.json
#, c-format
msgid "A LED light in the %s flickers on."
msgstr "Una luz LED en el %s parpadea"

#. ~ "need_charges_msg" action message of item "5-point anchor"
#. ~ "need_charges_msg" action message of item "malfunctioning 5-point anchor"
#. ~ "need_charges_msg" action message of item "Hub 01 modular defense anchor"
#: data/json/items/armor/robofac_armor.json data/json/items/tool_armor.json
msgid "It seems like this device needs power."
msgstr "Tiene pinta de que el dispositivo necesita mas energía."

#. ~ Item name
#: data/json/items/tool_armor.json
msgid "5-point anchor (on)"
msgid_plural "5-point anchors (on)"
msgstr[0] "Ancla de 5 puntos (on)"
msgstr[1] "Anclas de 5 puntos (on)"
msgstr[2] "Anclas de 5 puntos (on)"

#. ~ Description of "5-point anchor (on)"
#: data/json/items/tool_armor.json
msgid ""
"The harness' shoulder mounted LED glows with a soft green hue.  There's no "
"further indication of anything happening."
msgstr ""
"El LED montado en el hombro del arnés brilla con un suave tono verde. No hay"
" más indicaciones de que algo esté pasando."

#. ~ "msg" action message of item "5-point anchor (on)"
#: data/json/items/tool_armor.json
#, c-format
msgid "The %s LED light flickers off."
msgstr "La luz LED %s se apaga."

#. ~ Item name
#: data/json/items/tool_armor.json
msgid "malfunctioning 5-point anchor"
msgid_plural "malfunctioning 5-point anchors"
msgstr[0] "ancla de 5 puntos en mal funcionamiento"
msgstr[1] "anclas de 5 puntos en mal funcionamiento"
msgstr[2] "anclas de 5 puntos en mal funcionamiento"

#. ~ Description of "malfunctioning 5-point anchor"
#: data/json/items/tool_armor.json
msgid ""
"A battered, disc-shaped device mounted on a harness.  The inscriptions "
"\"X.E.D.R.A\" and \"5-point anchor\" are barely legible in its radiation "
"stained front and back."
msgstr ""
"Un dispositivo maltratado, con forma de disco, montado en un arnés. Las "
"inscripciones \"X.E.D.R.A\" y \"ancla de 5 puntos\" son dificilmente "
"legibles en su radioactiva parte delantera y trasera."

#. ~ "msg" action message of item "malfunctioning 5-point anchor"
#: data/json/items/tool_armor.json
#, c-format
msgid ""
"The %s emits a low pitched clicking alarm as its mounted LED light flashes "
"yellow."
msgstr ""
"El %s emite una alarma de bajo tono mientras su luz LED montada parpadea en "
"amarillo."

#. ~ Item name
#: data/json/items/tool_armor.json
msgid "phase immersion suit"
msgid_plural "phase immersion suits"
msgstr[0] "traje de inmersión en fase"
msgstr[1] "trajes de inmersión en fase"
msgstr[2] "trajes de inmersión en fase"

#. ~ Description of "phase immersion suit"
#: data/json/items/tool_armor.json
msgid ""
"Covered in interlocking plates of reflective metal, this advanced suit "
"resembles both plate armor and an astronaut's spacesuit.  Designed to "
"protect its wearer during extra dimensional excursions, it offers "
"unparalleled environmental protection, both in this Earth and beyond.  Use "
"it to turn it on."
msgstr ""
"Cubierto con placas de metal reflectante, este avanzado traje se asemeja "
"tanto a una armadura de placas como al traje espacial de un astronauta. "
"Diseñado para proteger a su portador durante las excursiones extra "
"dimensionales, ofrece una protección medioambiental sin igual, tanto en esta"
" Tierra como más allá. Usar para encender."

#. ~ "msg" action message of item "phase immersion suit"
#: data/json/items/tool_armor.json
msgid ""
"Initiating\n"
"Running suit integrity diagnostics…\n"
"All systems operational."
msgstr ""
"Iniciando\n"
"Ejecutando los diagnósticos de integridad del traje...\n"
"Todos los sistemas operacionales.."

#. ~ "need_charges_msg" action message of item "phase immersion suit"
#: data/json/items/tool_armor.json
msgid "Warning: Operating on minimal power.  Protection compromised."
msgstr "Advertencia: Operando con potencia mínima. Protección comprometida."

#. ~ Item name
#: data/json/items/tool_armor.json
msgid "phase immersion suit (on)"
msgid_plural "phase immersion suits (on)"
msgstr[0] "traje de inmersión en fase (on)"
msgstr[1] "trajes de inmersión en fase (on)"
msgstr[2] "trajes de inmersión en fase (on)"

#. ~ Description of "phase immersion suit (on)"
#: data/json/items/tool_armor.json
msgid ""
"Covered in interlocking plates of reflective metal, this advanced suit "
"resembles both plate armor and an astronaut's spacesuit.  It is turned on, "
"and continually draining power.  Use it to turn it off."
msgstr ""
"Cubierto con placas de metal reflectante, este avanzado traje se asemeja "
"tanto a una armadura de placas como al traje espacial de un astronauta. Está"
" encendido, y continuamente está drenando energía. Usar para apagar."

#. ~ "msg" action message of item "phase immersion suit (on)"
#: data/json/items/tool_armor.json
msgid "Suit shutting down."
msgstr "El traje se está apagando."

#. ~ Item name
#: data/json/items/tool_armor.json
msgid "rebreather mask"
msgid_plural "rebreather masks"
msgstr[0] "máscara rebreather"
msgstr[1] "máscaras rebreather"
msgstr[2] "máscaras rebreather"

#. ~ Description of "rebreather mask"
#: data/json/items/tool_armor.json
msgid ""
"A mask worn over your mouth which, when loaded with the proper filters, "
"recycles your exhaled breath for rebreathing while underwater.  Use it to "
"turn it on."
msgstr ""
"Una máscara que se usa sobre la boca y que cuando está cargada con el filtro"
" adecuado, permite reciclar tu exhalación para poder respirar debajo del "
"agua. Usar para encender."

#. ~ "need_charges_msg" action message of item "rebreather mask"
#. ~ "need_charges_msg" action message of item "XL rebreather mask"
#. ~ "need_charges_msg" action message of item "XS rebreather mask"
