#: data/json/furniture_and_terrain/terrain-fences-gates.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#: data/mods/Aftershock/maps/furniture_and_terrain/terrain.json
msgid "thump!"
msgstr "¡pum!"

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-graves.json
msgid "gravestone"
msgstr "tumba"

#. ~ Description of furniture "gravestone"
#: data/json/furniture_and_terrain/furniture-graves.json
msgid ""
"An upright slab of stone with information engraved on the face about whoever"
" lies beneath.  While only a solemn reminder of the countless casualties of "
"the Cataclysm, a proper final resting place grants an odd sense of peace."
msgstr ""
"Una losa vertical de piedra con información grabada en la cara sobre quien "
"yace debajo. Aunque sólo es un solemne recordatorio de las innumerables "
"víctimas del Cataclismo, un lugar de descanso final adecuado otorga una "
"extraña sensación de paz."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-graves.json
msgid "worn gravestone"
msgstr "tumba desgastada"

#. ~ Description of furniture "worn gravestone"
#: data/json/furniture_and_terrain/furniture-graves.json
msgid ""
"An aged and eroded gravestone, damaged to the point of rendering the "
"inscription illegible.  Whoever's buried here was probably lucky enough to "
"pass before all this chaos began."
msgstr ""
"Una lápida envejecida y erosionada, dañada hasta el punto de hacer ilegible "
"la inscripción. Quienquiera que esté enterrado aquí probablemente tuvo la "
"suerte de pasar antes de que empezara todo este caos."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-graves.json
msgid "obelisk"
msgstr "obelisco"

#. ~ Description of furniture "obelisk"
#: data/json/furniture_and_terrain/furniture-graves.json
msgid ""
"A magnificent carved statue with an engraved plaque fixed to the base.  It "
"serves to honor the passing of somebody significant, something one wishes "
"was still a practical goal."
msgstr ""
"Una magnífica estatua tallada con una placa grabada fijada en la base. Sirve"
" para honrar el fallecimiento de alguien significativo, algo que uno "
"desearía que siguiera siendo un objetivo práctico."

#. ~ Bashing failed sound of furniture "obelisk"
#. ~ Bashing failed sound of furniture "electrical conduit"
#: data/json/furniture_and_terrain/furniture-graves.json
#: data/json/furniture_and_terrain/furniture-industrial.json
msgid "thunk!"
msgstr "thunk!"

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-graves.json
msgid "battlefield cross"
msgstr "cruz de batalla"

#. ~ Description of furniture "battlefield cross"
#: data/json/furniture_and_terrain/furniture-graves.json
msgid ""
"A makeshift memorial marker, made of a service rifle - buried in the dirt, "
"or nestled in a pair of boots - with a helmet perched on the stock.  A small"
" way to honor the dead."
msgstr ""
"Una placa conmemorativa improvisada, hecha con un fusil de servicio "
"-enterrado en la tierra, o encajado en un par de botas-, con un casco "
"encaramado a la culata. Una pequeña forma de honrar a los muertos."

#. ~ Bashing failed sound of furniture "battlefield cross"
#. ~ Bashing failed sound of furniture "bed frame"
#: data/json/furniture_and_terrain/furniture-graves.json
#: data/json/furniture_and_terrain/furniture-sleep.json
msgid "whack."
msgstr "porrazo."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-industrial.json
msgid "robotic assembler"
msgstr "ensamblador robótico"

#. ~ Description of furniture "robotic assembler"
#: data/json/furniture_and_terrain/furniture-industrial.json
msgid ""
"A durable and versatile robotic arm with a tool fitted to the end, for "
"working on an assembly line.  Despite its specialized purpose being all but "
"lost now, it could provide a plethora of useful parts if disassembled."
msgstr ""
"Un brazo robótico duradero y versátil con una herramienta instalada en el "
"extremo, para trabajar en una cadena de montaje. A pesar de que su propósito"
" específico ya casi se ha perdido, podría proporcionar una plétora de piezas"
" útiles si se desmonta."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-industrial.json
msgid "chemical mixer"
msgstr "mezclador químico"

#. ~ Description of furniture "chemical mixer"
#: data/json/furniture_and_terrain/furniture-industrial.json
msgid ""
"A large vat with a motorized mixing device for combining large quantities of"
" chemicals."
msgstr ""
"Una gran cuba con un dispositivo de mezcla motorizado para combinar grandes "
"cantidades de productos químicos."

#. ~ Description of furniture "Compact Advanced Sterling Radioisotope
#. Generator"
#: data/json/furniture_and_terrain/furniture-industrial.json
msgid ""
"This hefty lump of steel and lead is the housing unit for a stirling "
"generator powered by plutonium-238, originally designed by NASA and "
"repurposed by the military.  It is plastered with warning signs.  It's "
"really heavy owing to the thick armor plating, but you could take this down "
"and use it for your own purposes if you wanted."
msgstr ""
"Este enorme bulto de acero y plomo es la unidad de alojamiento de un "
"generador stirling alimentado por plutonio-238, diseñado originalmente por "
"la NASA y reutilizado por los militares. Está cubierto de señales de "
"advertencia. Es realmente pesado debido al grueso blindaje, pero podrías "
"desmontarlo y utilizarlo para tus propios fines si así lo deseas."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-industrial.json
msgid "mobile antenna"
msgstr "antena móvil"

#. ~ Description of furniture "mobile antenna"
#: data/json/furniture_and_terrain/furniture-industrial.json
msgid ""
"A stark black directional antenna, seemingly part of a monitoring setup.  A "
"led mounted on its back lights up with a lazy and irregular rhythm."
msgstr ""
"Una antena direccional de color negro, que parece formar parte de un sistema"
" de vigilancia. Un led montado en su parte trasera se ilumina con un ritmo "
"perezoso e irregular."

#. ~ Description of furniture "old machinery"
#: data/json/furniture_and_terrain/furniture-industrial.json
msgid "Assorted old, rusty machinery.  You could scavenge it for parts."
msgstr ""
"Maquinaría oxidada, vieja y variada. Podrías rebuscar en ello por partes."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-industrial.json
msgid "robotic arm"
msgstr "brazo robótico"

#. ~ Description of furniture "robotic arm"
#: data/json/furniture_and_terrain/furniture-industrial.json
msgid ""
"An automated robotic arm used in assembly lines, which appears to be more "
"general-purpose than specially designed assemblers.  Despite being "
"functionless now, the parts could be useful."
msgstr ""
"Un brazo robótico automatizado utilizado en las cadenas de montaje, que "
"parece ser más de uso general que los ensambladores especialmente diseñados."
" A pesar de no ser funcional ahora, las piezas podrían ser útiles."

#. ~ Bashing failed sound of furniture "robotic arm"
#. ~ Bashing failed sound of terrain "water pump"
#. ~ Bashing failed sound of terrain "wooden well"
#. ~ Bashing failed sound of terrain "salt water pump"
#. ~ Bashing failed sound of terrain "water dispenser"
#: data/json/furniture_and_terrain/furniture-industrial.json
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "thunk."
msgstr "tonk,"

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-industrial.json
msgid "ground cable"
msgstr "cable de tierra"

#. ~ Description of furniture "ground cable"
#: data/json/furniture_and_terrain/furniture-industrial.json
msgid "A bunch of loose cables snake along the floor."
msgstr "Un montón de cables sueltos serpentean por el suelo."

#. ~ Bashing sound of furniture "ground cable"
#: data/json/furniture_and_terrain/furniture-industrial.json
msgid "shred!"
msgstr "¡triturado!"

#. ~ Bashing failed sound of furniture "ground cable"
#. ~ Bashing failed sound of furniture "pallet of cement bags"
#. ~ Bashing failed sound of terrain "mound of clay"
#. ~ Bashing failed sound of terrain "mound of sand"
#: data/json/furniture_and_terrain/furniture-industrial.json
#: data/json/furniture_and_terrain/furniture-pallet.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "thud!"
msgstr "¡golpes secos!"

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-industrial.json
msgid "electrical conduit"
msgstr "conducto eléctrico"

#. ~ Description of furniture "electrical conduit"
#: data/json/furniture_and_terrain/furniture-industrial.json
msgid "A thick bundle of electrical wiring protected by a metal conduit."
msgstr ""
"Un grueso grupo de cableado eléctrico protegido por un conducto de metal."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-industrial.json
msgid "capacitor bank"
msgstr "banco condensador"

#. ~ Description of furniture "capacitor bank"
#: data/json/furniture_and_terrain/furniture-industrial.json
msgid "A bank of heavy metal cylinders connected by large wires."
msgstr ""
"Un banco de pesados cilindros metálicos conectados por grandes cables."

#. ~ Furniture name
#. ~ Item name
#. ~ Vehicle part name
#: data/json/furniture_and_terrain/furniture-industrial.json
#: data/mods/Aftershock/vehicles/part_items.json
#: data/mods/Aftershock/vehicles/vehicle_parts.json
msgid "control station"
msgid_plural "control stations"
msgstr[0] "estación de control"
msgstr[1] "estaciones de control"
msgstr[2] "estaciones de control"

#. ~ Description of furniture "control station"
#: data/json/furniture_and_terrain/furniture-industrial.json
msgid ""
"Assorted electronic interfaces and screens.  You could scavenge it for "
"parts."
msgstr ""
"Pantalla e interfaces electrónicas variadas. Podrías rebuscar en ello por "
"partes."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-industrial.json
msgid "nuclear fuel cell"
msgstr "celda de combustible nuclear"

#. ~ Description of furniture "nuclear fuel cell"
#: data/json/furniture_and_terrain/furniture-industrial.json
msgid ""
"This fuel assembly consists of cylindrical rods put into bundles.  A uranium"
" oxide ceramic is formed into pellets and inserted into Zircaloy tubes that "
"are bundled together.  The Zircaloy tubes are pressurized with helium to try"
" to minimize pellet-cladding interaction which can lead to fuel rod failure "
"over long periods.  This fuel cell is used in nuclear power stations to "
"produce heat to power turbines."
msgstr ""
"Este conjunto de combustible está formado por varillas cilíndricas colocadas"
" en haces. Una cerámica de óxido de uranio se forma en pastillas y se "
"introduce en tubos de Zircaloy que se agrupan. Los tubos de Zircaloy se "
"presurizan con helio para tratar de minimizar la interacción entre las "
"pastillas y el revestimiento, que puede provocar el fallo de la varilla de "
"combustible en periodos prolongados. Esta pila de combustible se utiliza en "
"las centrales nucleares para producir calor para alimentar las turbinas."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-industrial.json
msgid "active backup generator"
msgstr "generador de reserva activo"

#. ~ Description of furniture "active backup generator"
#: data/json/furniture_and_terrain/furniture-industrial.json
msgid ""
"A ubiquitous piece of compact machinery meant for running anything from the "
"bathroom lights to electric stoves and other necessities when grid "
"electricity is unavailable.  This one is currently running.  You can hear it"
" humming slightly when you are very close."
msgstr ""
"Una pieza omnipresente de maquinaria compacta pensada para hacer funcionar "
"cualquier cosa, desde luces de baño a estufas eléctricos y otras necesidades"
" cuando una red eléctrica no esta disponible. Este esta encendido ahora. "
"Puedes oír un ligero ronroneo cuando te acercas mucho."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-medical.json
msgid "Autodoc Mk. XI"
msgstr "Autodoc Mk. XI"

#. ~ Description of furniture "Autodoc Mk. XI"
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"A surgical apparatus used for installation and removal of bionics.  The term"
" name 'Autodoc' is something of a misnomer, as it can only operate if "
"programmed beforehand, something that a plethora of labels warn against "
"doing without expertise."
msgstr ""
"Un aparato quirúrgico utilizado para la instalación y retirada de biónicos. "
"El nombre de \"Autodoc\" es un poco erróneo, ya que sólo puede funcionar si "
"se programa de antemano, algo que una plétora de etiquetas advierten que no "
"se debe hacer sin experiencia."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-medical.json
msgid "Autodoc operation couch"
msgstr "Camilla de operación autodoc"

#. ~ Description of furniture "Autodoc operation couch"
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"A plush red sofa made less comfortable by the medical machinery directly "
"above it.  It has a single leather strap on the right armrest."
msgstr ""
"Es un sofá rojo de felpa que se ha vuelto menos cómodo por las máquinas "
"médicas que tiene arriba. Tiene una correa de cuero en el apoyabrazos "
"derecho."

#. ~ Furniture name
#. ~ Item name
#. ~ Vehicle part name
#: data/json/furniture_and_terrain/furniture-medical.json
#: data/json/items/appliances.json data/json/vehicleparts/vehicle_parts.json
#: data/mods/Aftershock/maps/furniture_lab.json
msgid "autoclave"
msgid_plural "autoclaves"
msgstr[0] "autoclave"
msgstr[1] "autoclaves"
msgstr[2] "autoclaves"

#. ~ Description of furniture "autoclave"
#. ~ Description of furniture "filled autoclave"
#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
msgid ""
"A device that can steam its contents at high enough temperatures to "
"completely sterilize them, killing any possible contaminants."
msgstr ""
"Un dispositivo que puede vaporizar su contenido a temperaturas lo "
"suficientemente altas como para esterilizarlo completamente, matando "
"cualquier posible contaminante."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
msgid "filled autoclave"
msgstr "autoclave lleno"

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
msgid "sample freezer"
msgstr "congelador de muestras"

#. ~ Description of furniture "sample freezer"
#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
msgid ""
"A specialized freezer capable of maintaining temperatures of -80 Celsius, "
"and is often used only for the preservation of delicate scientific samples."
msgstr ""
"Un congelador especializado capaz de mantener temperaturas de -80 grados "
"centígrados y que suele utilizarse únicamente para la conservación de "
"muestras científicas delicadas."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-medical.json
msgid "lab workbench"
msgstr "banco de trabajo de laboratorio"

#. ~ Description of furniture "lab workbench"
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"A metal storage cabinet topped by a durable resin countertop resistant to "
"most chemical spills and burns.  It has wired in electrical and gas "
"fittings."
msgstr ""
"Un gabinete de almacenamiento de metal coronado por una encimera de resina "
"duradera resistente a la mayoría de los derrames y quemaduras químicas. "
"Tiene cableado en los accesorios eléctricos y de gas."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-medical.json
msgid "fume hood"
msgstr "campana extractora"

#. ~ Description of furniture "fume hood"
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"A metal hood overtop of a lab workspace, with durable glass shutters.  A fan"
" in the hood draws fumes and smoke from dangerous chemicals up into a "
"ventilation duct."
msgstr ""
"Una capucha de metal sobre el espacio de trabajo de un laboratorio, con "
"duras persianas de vidrio. Un ventilador en la campana atrae los vapores y "
"el humo de los productos químicos peligrosos hacia un conducto de "
"ventilación."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
msgid "shaker incubator"
msgstr "incubadora vibratoria"

#. ~ Description of furniture "shaker incubator"
#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
msgid ""
"A tool for keeping chemical broth nicely mixed, at just the right "
"temperature to grow bacteria.  Although, more bacteria is probably the last "
"thing you need, considering the circumstances."
msgstr ""
"Una herramienta para mantener el caldo químico bien mezclado, a la "
"temperatura justa para cultivar bacterias. Aunque, probablemente, más "
"bacterias es lo último que necesitas, teniendo en cuenta las circunstancias."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-medical.json
msgid "emergency wash station"
msgstr "estación de lavado de emergencia"

#. ~ Description of furniture "emergency wash station"
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"A standing sink with a pair of nozzles, along with a large and brightly-"
"colored handle.  It is specially designed to quickly remove contaminants "
"from the eyes, and is easily usable without being able to see very well.  A "
"sizable notice warns against drinking the water it uses."
msgstr ""
"Un lavabo de pie con un par de boquillas, junto con un mango grande y de "
"color brillante. Está especialmente diseñado para eliminar rápidamente los "
"contaminantes de los ojos, y es fácilmente utilizable sin poder ver muy "
"bien. Un aviso de tamaño considerable advierte que no se debe beber el agua "
"que utiliza."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-medical.json
msgid "IV pole"
msgstr "Polo IV"

#. ~ Description of furniture "IV pole"
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"A tall wire frame on a set of small wheels used for holding an IV bag, "
"useful for unattended administration."
msgstr ""
"Un marco de alambre alto sobre un conjunto de ruedas pequeñas utilizado para"
" sostener una bolsa intravenosa, útil para la administración desatendida."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-medical.json
msgid "high performance liquid chromatographer"
msgstr "cromatógrafo de líquidos de alto rendimiento"

#. ~ Description of furniture "high performance liquid chromatographer"
#. ~ Description of furniture "high-performance liquid chromatographer"
#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
msgid ""
"This high-tech tool would, with electricity and an experienced user, be a "
"very useful way to separate chemicals in a liquid or aqueous phase, based on"
" their affinity, to the stationary phase in a tube.  At least, that's what "
"the label says."
msgstr ""
"Esta herramienta de alta tecnología sería, con electricidad y un usuario "
"experimentado, una forma muy útil de separar sustancias químicas en una fase"
" líquida o acuosa, en función de su afinidad, a la fase estacionaria en un "
"tubo. Al menos, eso es lo que dice la etiqueta."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
msgid "gas chromatographer"
msgstr "cromatógrafo de gases"

#. ~ Description of furniture "gas chromatographer"
#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
msgid ""
"This high-tech tool would, with electricity and an experienced user, be a "
"very useful way to separate chemicals in a gaseous phase, based on their "
"affinity, to a stationary phase in a tube.  At least, that's what the label "
"says."
msgstr ""
"Esta herramienta de alta tecnología sería, con electricidad y un usuario "
"experimentado, una forma muy útil de separar los productos químicos en una "
"fase gaseosa, en función de su afinidad, a una fase estacionaria en un tubo."
" Al menos, eso es lo que dice la etiqueta."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
msgid "mass spectrometer"
msgstr "espectrómetro de masas"

#. ~ Description of furniture "mass spectrometer"
#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
msgid ""
"Inside this large white box is a carefully balanced set of electric field "
"generators that can precisely separate ionized particles based on their "
"charge-to-mass ratio, firing them into a detector that measures the exact "
"mass of the particle hitting it.  Invaluable for chemical analysis and other"
" advanced sciences, it's not as useful anymore."
msgstr ""
"Dentro de esta gran caja blanca hay un conjunto cuidadosamente equilibrado "
"de generadores de campo eléctrico que pueden separar con precisión las "
"partículas ionizadas en función de su relación carga-masa, disparándolas a "
"un detector que mide la masa exacta de la partícula que choca con él. "
"Inestimable para el análisis químico y otras ciencias avanzadas, ya no es "
"tan útil."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
msgid "nuclear magnetic resonance spectrometer"
msgstr "espectrómetro de resonancia magnética nuclear"

#. ~ Description of furniture "nuclear magnetic resonance spectrometer"
#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
msgid ""
"This is a giant electromagnet with carefully tuned measurement equipment "
"used to observe how magnetic fields affect nuclear spins.  It is a common "
"workhorse for the discovery and study of chemical structures."
msgstr ""
"Se trata de un electroimán gigante con un equipo de medición cuidadosamente "
"ajustado que se utiliza para observar cómo los campos magnéticos afectan a "
"los espines nucleares. Es un caballo de batalla habitual para el "
"descubrimiento y el estudio de las estructuras químicas."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-medical.json
msgid "electron microscope"
msgstr "microscopio electrónico"

#. ~ Description of furniture "electron microscope"
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"An enormous observational tool for studying the details of samples on an "
"immensely small scale."
msgstr ""
"Una enorme herramienta de observación para estudiar los detalles de las "
"muestras a una escala inmensamente pequeña."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-medical.json
msgid "CT scanner"
msgstr "Escáner CT"

#. ~ Description of furniture "CT scanner"
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"A massive piece of machinery used to take hundreds of X-ray images from 360 "
"degrees, often used for medical examinations of patients."
msgstr ""
"Una enorme maquinaria utilizada para tomar cientos de imágenes de rayos X de"
" 360 grados, a menudo utilizada para los exámenes médicos de los pacientes."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-medical.json
msgid "MRI machine"
msgstr "Máquina de resonancia magnética"

#. ~ Description of furniture "MRI machine"
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"A massive tool used to take NMR images of a patient placed inside, providing"
" invaluable medical insight."
msgstr ""
"Una herramienta masiva utilizada para tomar imágenes de Resonancia Magnética"
" de un paciente colocado en su interior, proporcionando una visión médica "
"inestimable."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-medical.json
msgid "scanner bed"
msgstr "cama de escáner"

#. ~ Description of furniture "scanner bed"
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"This is a narrow, flat, and frankly uncomfortable bed for putting someone "
"into an imaging machine for medical observations."
msgstr ""
"Se trata de una cama estrecha, plana y francamente incómoda para meter a "
"alguien en una máquina de imágenes para observaciones médicas."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-medical.json
msgid "anesthetic machine"
msgstr "máquina anestésica"

#. ~ Description of furniture "anesthetic machine"
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"A large machine with various tanks, tubes, and monitoring devices used to "
"maintain precise levels of anesthesia in a patient to ensure they, at least "
"ideally, remain asleep, unfeeling, but alive."
msgstr ""
"Una gran máquina con varios tanques, tubos y dispositivos de monitorización "
"utilizados para mantener niveles precisos de anestesia en un paciente para "
"asegurar que, al menos idealmente, permanezca dormido, sin sentir, pero "
"vivo."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-medical.json
msgid "dialysis machine"
msgstr "máquina de diálisis"

#. ~ Description of furniture "dialysis machine"
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"A large machine for pumping and filtering the blood of somebody without the "
"function of their kidneys.  Largely obsolete for those with access to "
"bionics, but a lifeline to those that need it."
msgstr ""
"Una gran máquina para bombear y filtrar la sangre de alguien sin la función "
"de sus riñones. En gran medida obsoleta para los que tienen acceso a la "
"biónica, pero un salvavidas para los que la necesitan."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-medical.json
msgid "medical ventilator"
msgstr "ventilador médico"

#. ~ Description of furniture "medical ventilator"
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"A sizable box on a set of wheels that will pump air in and out of a "
"patient's lungs when they are incapable of breathing, though often only "
"needed temporarily."
msgstr ""
"Una caja de tamaño considerable sobre un conjunto de ruedas que bombea aire "
"dentro y fuera de los pulmones de un paciente cuando éste es incapaz de "
"respirar, aunque a menudo sólo se necesita temporalmente."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-medical.json
msgid "privacy curtain"
msgstr "cortina de privacidad"

#. ~ Description of furniture "privacy curtain"
#: data/json/furniture_and_terrain/furniture-medical.json
msgid "No peeking!"
msgstr "¡No mires!"

#. ~ Bashing sound of furniture "privacy curtain"
#. ~ Bashing sound of furniture "open privacy curtain"
#: data/json/furniture_and_terrain/furniture-medical.json
msgid "swish!"
msgstr "¡Swish!"

#. ~ Bashing failed sound of furniture "privacy curtain"
#. ~ Bashing failed sound of furniture "open privacy curtain"
#: data/json/furniture_and_terrain/furniture-medical.json
msgid "clattering metal!"
msgstr "¡Un metal que hace ruido!"

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-medical.json
msgid "open privacy curtain"
msgstr "abrir la cortina de privacidad"

#. ~ Description of furniture "open privacy curtain"
#: data/json/furniture_and_terrain/furniture-medical.json
msgid "Stop peeking!"
msgstr "¡Deja de mirar!"

#. ~ Description of furniture "centrifuge"
#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
msgid ""
"This is a centrifuge, a liquid separating device with an automated analyzer "
"unit.  For some reason, this one has an attached battery pack.  It could be "
"used to analyze a medical fluid sample, such as blood, if a test tube was "
"placed in it."
msgstr ""
"Esta es una centrífugadora, un dispositivo de separación de líquidos con una"
" unidad de análisis automatizada. Por alguna razón, éste tiene una batería "
"adjunta. Podría utilizarse para analizar una muestra de fluido médico, como "
"la sangre, si se colocara un tubo de ensayo en él."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-pallet.json
msgid "pallet of bricks"
msgstr "paleta de ladrillos"

#. ~ Description of furniture "pallet of bricks"
#: data/json/furniture_and_terrain/furniture-pallet.json
msgid ""
"A massive packed-together block of bricks wrapped around with plastic "
"packaging.  It makes for easy storage of building materials for masonry "
"constructions."
msgstr ""
"Un enorme paquete de ladrillos envuelto en un embalaje plástico. Facilita el"
" almacenamiento de materiales de construcción para obras de albañilería."

#. ~ Bashing failed sound of furniture "pallet of bricks"
#. ~ Bashing failed sound of furniture "pallet of adobe bricks"
#. ~ Bashing failed sound of terrain "brick wall with embrasure"
#. ~ Bashing failed sound of terrain "adobe wall with embrasure"
#. ~ Bashing failed sound of terrain "half-built brick wall"
#. ~ Bashing failed sound of terrain "brick wall"
#. ~ Bashing failed sound of terrain "half-built adobe wall"
#. ~ Bashing failed sound of terrain "adobe wall"
#: data/json/furniture_and_terrain/furniture-pallet.json
#: data/json/furniture_and_terrain/terrain-embrasures.json
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "bash!"
msgstr "¡golpear!"

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-pallet.json
msgid "pallet of adobe bricks"
msgstr "paleta de ladrillos de adobe"

#. ~ Description of furniture "pallet of adobe bricks"
#: data/json/furniture_and_terrain/furniture-pallet.json
msgid ""
"A massive packed-together block of adobe bricks wrapped around with plastic "
"packaging.  It makes for easy storage of building materials for masonry "
"constructions."
msgstr ""
"Un enorme paquete de ladrillos de adobe envuelto en un embalaje plástico. "
"Facilita el almacenamiento de materiales de construcción para obras de "
"albañilería."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-pallet.json
msgid "pallet of cement bags"
msgstr "paleta de bolsas de cemento"

#. ~ Description of furniture "pallet of cement bags"
#: data/json/furniture_and_terrain/furniture-pallet.json
msgid ""
"A massive packed-together block of cement bags wrapped around with plastic "
"packaging.  It makes for easy storage of building materials for masonry "
"constructions."
msgstr ""
"Un enorme paquete de bolsas de cemento envuelto en un embalaje plástico. "
"Facilita el almacenamiento de materiales de construcción para obras de "
"albañilería."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-pallet.json
msgid "stack of wooden planks"
msgstr "pila de tablones de madera"

#. ~ Description of furniture "stack of wooden planks"
#: data/json/furniture_and_terrain/furniture-pallet.json
msgid ""
"Dozens of construction planks tied together for easier transport.  "
"Deconstruct to untie them."
msgstr ""
"Decenas de tablones de construcción atados para facilitar su transporte. "
"Desmontalo para desatarlos."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid "bathtub"
msgstr "bañera"

#. ~ Description of furniture "bathtub"
#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid ""
"An ordinary ceramic tub, with a now-functionless steel faucet and a plug "
"fixed over the drain.  Watertight and relatively clean, it would make for a "
"good water trough."
msgstr ""
"Una bañera de cerámica ordinaria, con un grifo de acero que ya no funciona y"
" un tapón fijado sobre el desagüe. Hermética y relativamente limpia, sería "
"un buen abrevadero."

#. ~ Bashing sound of furniture "bathtub"
#. ~ Bashing sound of furniture "shower"
#. ~ Bashing sound of furniture "sink"
#. ~ Bashing sound of furniture "toilet"
#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid "porcelain breaking!"
msgstr "¡porcelana rompiéndose!"

#. ~ Bashing failed sound of furniture "bathtub"
#. ~ Bashing failed sound of furniture "shower"
#. ~ Bashing failed sound of furniture "sink"
#. ~ Bashing failed sound of furniture "toilet"
#. ~ Bashing failed sound of terrain "clearcrete wall"
#. ~ Bashing failed sound of furniture "water cooler"
#. ~ Bashing failed sound of terrain "glassteel vault wall"
#: data/json/furniture_and_terrain/furniture-plumbing.json
#: data/mods/Aftershock/maps/furniture_and_terrain/terrain.json
#: data/mods/Backrooms/furniture_terrain.json data/mods/Magiclysm/terrain.json
msgid "whunk!"
msgstr "¡whunk!"

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid "shower"
msgstr "ducha"

#. ~ Description of furniture "shower"
#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid ""
"A small enclosed ceramic room with a glass door and plumbing fixtures for "
"cleaning oneself.  Before it was a commonplace amenity, but now it's hard to"
" imagine wasting that much water."
msgstr ""
"Un pequeño cuarto de cerámica cerrado con una puerta de cristal y con "
"instalaciones de fontanería para limpiarse. Antes era una comodidad "
"habitual, pero ahora es difícil imaginar que se desperdicie tanta agua."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid "sink"
msgstr "lavabo"

#. ~ Description of furniture "sink"
#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid ""
"A porcelain water basin with a water tap and drain, designed to be fitted "
"into an opening on a countertop."
msgstr ""
"Lavabo de porcelana con grifo y desagüe, diseñado para encajar en un hueco "
"de la encimera."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid "toilet"
msgstr "inodoro"

#. ~ Description of furniture "toilet"
#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid ""
"An invaluable fixture in any home, it would be a miracle to have one that "
"works.  The standing tank may hold a moderate amount of water, but while "
"better than anything that would be in the bowl, it would not be the "
"cleanest."
msgstr ""
"Un accesorio invaluable en cualquier hogar, sería un milagro tener uno que "
"funcione. El depósito horizontal puede contener una cantidad moderada de "
"agua, pero aunque es mejor que todo lo que habría en la taza, no sería lo "
"más limpio."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid "water heater"
msgstr "calentador de agua"

#. ~ Description of furniture "water heater"
#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid ""
"An insulated metal tank with a small fire used to maintain near-boiling "
"temperatures.  Now that there's no way to power it, the large tank could "
"still be used to store large amounts of clean water."
msgstr ""
"Un tanque metálico aislado con un pequeño fuego utilizado para mantener "
"temperaturas cercanas al punto de ebullición. Ahora que no hay forma de "
"alimentarlo, el gran tanque podría seguir utilizándose para almacenar "
"grandes cantidades de agua limpia."

#. ~ Furniture name
#. ~ All vehicle water purifiers need to use the same pseudo-item because
#. vehicle.cpp matches against a specific id
#. ~ Item name
#. ~ Vehicle part name
#: data/json/furniture_and_terrain/furniture-plumbing.json
#: data/json/items/fake.json data/json/items/tool/cooking.json
#: data/json/vehicleparts/vehicle_parts.json
msgid "water purifier"
msgid_plural "water purifiers"
msgstr[0] "purificador de agua"
msgstr[1] "purificadores de agua"
msgstr[2] "purificadores de agua"

#. ~ Description of furniture "water purifier"
#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid ""
"This device effectively sterilizes water.  You can plug it in to your own "
"power grid to use it."
msgstr ""
"Este aparato esteriliza eficazmente el agua. Puedes conectarlo a tu propia "
"red eléctrica para utilizarlo."

#. ~ Furniture name
#. ~ Item name
#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/fake.json
msgid "exercise machine"
msgid_plural "exercise machines"
msgstr[0] "máquina de ejercicio"
msgstr[1] "máquinas de ejercicio"
msgstr[2] "máquinas de ejercicio"

#. ~ Description of furniture "exercise machine"
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"A heavy set of weightlifting equipment for strength training, with a pair of"
" heavy weights affixed to opposite ends of a sturdy pipe.  You can adjust "
"the set by hand-picking the weights you wish to use."
msgstr ""
"Un conjunto pesado de equipos de levantamiento de pesas para el "
"entrenamiento de fuerza, con un par de pesas pesadas fijadas en los extremos"
" opuestos de un tubo resistente. Puedes ajustar el conjunto eligiendo a mano"
" las pesas que desees utilizar."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "ball machine"
msgstr "máquina lanzapelotas"

#. ~ Description of furniture "ball machine"
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"A simple machine for launching sports balls of various types, with a pair of"
" motorized wheels that, if spun up, would fling the ball at moderate speeds."
"  Probably not the most effective ranged weapon against the undead."
msgstr ""
"Una sencilla máquina para lanzar pelotas deportivas de varios tipos, con un "
"par de ruedas motorizadas que, si se hacen girar, lanzan la pelota a "
"velocidades moderadas. Probablemente no sea el arma a distancia más eficaz "
"contra los muertos vivientes."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "parkour bars"
msgstr "barras de parkour"

#. ~ Description of furniture "parkour bars"
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"A complicated set of monkey bars, to be used by adults to train parkour."
msgstr ""
"Un complicado conjunto de barras de mono, para ser utilizado por los adultos"
" para entrenar haciendo parkour."

#. ~ Bashing sound of furniture "parkour bars"
#. ~ Bashing sound of terrain "railing"
#. ~ Bashing sound of terrain "slide"
#. ~ Bashing sound of terrain "monkey bars"
#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/furniture_and_terrain/terrain-fences-gates.json
#: data/json/furniture_and_terrain/terrain-recreational.json
msgid "crack!"
msgstr "¡crack!"

#. ~ Bashing failed sound of furniture "parkour bars"
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "ping."
msgstr "ping."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "pool table"
msgstr "mesa de billar"

#. ~ Description of furniture "pool table"
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"A large wooden table with green felt carpeting on top, and a set of "
"symmetrical holes that carry billiards balls to an opening on one side.  "
"While not the most useful as a normal table, there is a substantial amount "
"of wood."
msgstr ""
"Una gran mesa de madera con un tapete de fieltro verde en la parte superior,"
" y un conjunto de agujeros simétricos que llevan las bolas de billar a una "
"abertura en un lado. Aunque no es lo más útil como mesa normal, hay una "
"cantidad considerable de madera."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "diving block"
msgstr "podio de salida de natación"

#. ~ Description of furniture "diving block"
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"A chunky plastic stool bolted onto the ground, intended as a safe way of "
"diving forward into a body of water."
msgstr ""
"Un grueso taburete de plástico atornillado al suelo, pensado como una forma "
"segura de sumergirse en una masa de agua."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "target"
msgstr "diana"

#. ~ Description of furniture "target"
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"A long sheet of metal held upright by a pipe frame, the sheet is cut in a "
"roughly human shape.  There are two bullseye targets painted onto it, a "
"large one on the torso, and a smaller one on the head.  It is peppered with "
"small dents and holes, and a large amount of the paint has flaked or chipped"
" off."
msgstr ""
"Una larga plancha de metal sostenida por una estructura de tubos, cortada en"
" forma de hombre. Hay dos dianas pintadas en ella, una grande en el torso y "
"otra más pequeña en la cabeza. Está salpicada de pequeñas abolladuras y "
"agujeros, y gran parte de la pintura se ha descascarillado o desconchado."

#. ~ Description of furniture "arcade machine"
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"A bulky upright arcade cabinet, brightly painted and slightly worn with age."
"  Useless for its intended purpose without power, it's bound to have "
"valuable parts."
msgstr ""
"Un voluminoso armario arcade vertical, brillantemente pintado y ligeramente "
"desgastado por el tiempo. Inútil para su propósito sin energía, seguro que "
"tiene piezas valiosas."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "pinball machine"
msgstr "pinball"

#. ~ Description of furniture "pinball machine"
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"An iconic game, this machine has a brightly decorated background on its "
"intricate obstacle course, which is covered by a long sheet of glass.  While"
" inoperable without power, it's still impressive to look at, though probably"
" more useful if disassembled."
msgstr ""
"Esta máquina, un juego icónico, tiene un fondo brillantemente decorado en su"
" intrincada pista de obstáculos, que está cubierta por una larga hoja de "
"vidrio. Aunque es inoperable sin energía, sigue siendo impresionante de ver,"
" aunque probablemente sea más útil si se desmonta."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "ergometer"
msgstr "ergómetro"

#. ~ Description of furniture "ergometer"
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"An exercise machine with a set of handles and plates meant to emulate rowing"
" a boat.  Without power it can't be operated, but it might have useful parts"
" to be scavenged."
msgstr ""
"Una máquina de ejercicios con un conjunto de asas y placas que pretende "
"emular el remo de un barco. Sin energía no puede funcionar, pero puede ser "
"rebuscado por partes útiles."

#. ~ Furniture name
#. ~ Item name
#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/fake.json
msgid "mechanical ergometer"
msgid_plural "mechanical ergometers"
msgstr[0] "ergómetro mecánico"
msgstr[1] "ergómetros mecánicos"
msgstr[2] "ergómetros mecánicos"

#. ~ Description of furniture "mechanical ergometer"
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"An exercise machine with a set of handles and plates meant to emulate rowing"
" a boat.  This an older model with mechanical resistance adjustments, but it"
" works without power."
msgstr ""
"Una máquina de ejercicios con un conjunto de asas y placas que pretende "
"emular el remo de una embarcación. Se trata de un modelo antiguo con ajustes"
" de resistencia mecánica, pero que funciona sin energía."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "treadmill"
msgstr "cinta para correr"

#. ~ Description of furniture "treadmill"
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"A motorized conveyor belt with a control panel for running in place.  "
"Without power, it's an immense challenge to move the belt.  Regardless, "
"you're probably getting enough cardio on your own."
msgstr ""
"Una cinta transportadora motorizada con un panel de control para su "
"funcionamiento en el lugar. Sin energía, es un reto inmenso mover la cinta. "
"A pesar de ello, es probable que estés haciendo suficiente cardio por tu "
"cuenta."

#. ~ Furniture name
#. ~ Item name
#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/fake.json
msgid "gravity treadmill"
msgid_plural "gravity treadmills"
msgstr[0] "cinta de correr inclinada"
msgstr[1] "cintas de correr inclinadas"
msgstr[2] "cintas de correr inclinadas"

#. ~ Description of furniture "gravity treadmill"
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"A gravity driven conveyor belt with a mechanical control panel for running "
"in place.  Conveyor belt is positioned in a steep, but adjustable incline, "
"so it slides back under your weight."
msgstr ""
"Una cinta transportadora impulsada por la gravedad con un panel de control "
"mecánico para correr en el lugar. La cinta transportadora está colocada en "
"una inclinación pronunciada, pero ajustable, para que se deslice hacia atrás"
" bajo tu peso."

#. ~ Furniture name
#. ~ Item name
#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/fake.json
msgid "heavy punching bag"
msgid_plural "heavy punching bags"
msgstr[0] "bolsa de boxeo pesada"
msgstr[1] "bolsas de boxeo pesadas"
msgstr[2] "bolsas de boxeo pesadas"

#. ~ Description of furniture "heavy punching bag"
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"A hefty leather bag in an oblong shape, suspended from a ceiling mount with "
"a steel chain.  It can be used for exercise and combat training, with the "
"notable advantage that it doesn't fight back."
msgstr ""
"Una bolsa de cuero de forma oblonga, suspendida de un soporte de techo con "
"una cadena de acero. Puede utilizarse para hacer ejercicio y entrenar el "
"combate, con la notable ventaja de que no se defiende."

#. ~ Bashing failed sound of furniture "heavy punching bag"
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "whud."
msgstr "whud."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "piano"
msgstr "piano"

#. ~ Description of furniture "piano"
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"An elegant piano, capable of producing beautiful music if used by a skilled "
"player.  A set of off-white and black keys all linked to a set of hammers, "
"which strike their corresponding tightly-coiled wire to produce sound."
msgstr ""
"Un elegante piano, capaz de producir una bella música si es utilizado por un"
" intérprete hábil. Un conjunto de teclas blancas y negras unidas a un "
"conjunto de martillos, que golpean su correspondiente alambre tensado para "
"producir el sonido."

#. ~ Bashing sound of furniture "piano"
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "a suffering piano!"
msgstr "un piano sufrido"

#. ~ Bashing failed sound of furniture "piano"
#. ~ Bashing failed sound of furniture "pipe organ"
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "kerchang."
msgstr "kerchang."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "speaker cabinet"
msgstr "gabinete de altavoz"

#. ~ Description of furniture "speaker cabinet"
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"An upright wood-panel case of large speakers, built to produce a potentially"
" deafening volume level.  While this is a terrible idea to use now, it could"
" hold useful parts."
msgstr ""
"Una caja vertical de paneles de madera con grandes altavoces, construida "
"para producir un nivel de volumen potencialmente ensordecedor. Aunque es una"
" idea terrible usarlo ahora, podría contener piezas útiles."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "dancing pole"
msgstr "Barra de baile"

#. ~ Description of furniture "dancing pole"
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"A tall steel pipe mounted vertically, securely fastened to the ceiling and "
"floor.  Usually used for various forms of dancing, often in adult-oriented "
"venues."
msgstr ""
"Una barra de acero alta montada verticalmente, fijado de forma segura al "
"techo y al suelo. Suele utilizarse para diversas formas de baile, a menudo "
"en locales orientados a los adultos."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "roulette table"
msgstr "mesa de ruleta"

#. ~ Description of furniture "roulette table"
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"A huge table specially made for a specific form of gambling, with a grid "
"painted onto the felt top, and a concave spinning wheel intended to give a "
"random selection of the inscribed possibilities."
msgstr ""
"Una enorme mesa hecha especialmente para una forma específica de juego, con "
"una cuadrícula pintada en el tablero de fieltro, y una rueda giratoria "
"cóncava destinada a dar una selección aleatoria de las posibilidades "
"inscritas."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "pipe organ"
msgstr "órgano tubular"

#. ~ Description of furniture "pipe organ"
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"A majestic pipe organ.  Dubbed \"the king of instruments\", it is capable of"
" producing powerful sound harmonies if used by a skilled player.  Rows of "
"off-white and black keys all linked to a set of iron pipes, which resonate "
"at a specific pitch when pressurized air is driven through them."
msgstr ""
"Un majestuoso órgano tubular. Apodado \"el rey de los instrumentos\", es "
"capaz de producir potentes armonías sonoras si lo utiliza un intérprete "
"hábil. Filas de teclas blancas y negras unidas a un conjunto de tubos de "
"hierro, que resuenan en un tono específico cuando se impulsa aire a presión "
"a través de ellos."

#. ~ Bashing sound of furniture "pipe organ"
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "a dramatic pipe organ!"
msgstr "¡un dramático órgano tubular!"

#. ~ Furniture name
#. ~ Item name
#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/fake.json data/json/items/generic.json
msgid "training dummy"
msgid_plural "training dummies"
msgstr[0] "maniquíes de entrenamiento"
msgstr[1] "maniquíes de entrenamiento"
msgstr[2] "maniquíes de entrenamiento"

#. ~ Description of furniture "training dummy"
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"A hand-made humanoid figure, useful for training in close quarters combat.  "
"This one is made from wood and it has some duct tape to mark the striking "
"points."
msgstr ""
"Una figura humanoide hecha a mano, útil para entrenar el combate cuerpo a "
"cuerpo. Esta está hecha de madera y tiene un poco de cinta americana para "
"marcar los puntos de golpeo."

#. ~ Furniture name
#. ~ Item name
#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/fake.json data/json/items/generic.json
msgid "armored training dummy"
msgid_plural "armored training dummies"
msgstr[0] "maniquíes de entrenamiento blindados"
msgstr[1] "maniquíes de entrenamiento blindados"
msgstr[2] "maniquíes de entrenamiento blindados"

#. ~ Description of furniture "armored training dummy"
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"A hand-made humanoid figure, useful for training in close quarters combat.  "
"This one is covered in scrap armor and looks on guard."
msgstr ""
"Una figura humanoide hecha a mano, útil para entrenar el combate cuerpo a "
"cuerpo. Esta está cubierta con una armadura de chatarra y parece estar en "
"guardia."

#. ~ Furniture name
#. ~ Item name
#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/fake.json data/json/items/generic.json
msgid "box archery target"
msgid_plural "box archery targets"
msgstr[0] "objetivos de caja para tiro con arco"
msgstr[1] "objetivos de caja para tiro con arco"
msgstr[2] "objetivos de caja para tiro con arco"

#. ~ Description of furniture "box archery target"
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"A soft target for archery consisting of tightly-packed cloth stuffed into a "
"cardboard box, with a bullseye marked on the front."
msgstr ""
"Una diana blanda para el tiro con arco. Consiste en una tela prensada metida"
" en una caja de cartón, con una diana marcada en la parte delantera."

#. ~ Bashing sound of furniture "box archery target"
#. ~ Bashing sound of furniture "bale archery target"
#. ~ Bashing sound of furniture "bale of hay"
#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/furniture_and_terrain/furniture-rural.json
msgid "whish!"
msgstr "¡frufrú!"

#. ~ Furniture name
#. ~ Item name
#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/fake.json
msgid "bale archery target"
msgid_plural "bale archery targets"
msgstr[0] "blancos de tiro al blanco"
msgstr[1] "blancos de tiro al blanco"
msgstr[2] "blancos de tiro al blanco"

#. ~ Description of furniture "bale archery target"
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"A soft target for archery consisting of a bale of hay with a bullseye marked"
" on the front."
msgstr ""
"Una diana blanda para el tiro con arco que consiste en un fardo de heno con "
"una diana marcada en la parte delantera."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-regional-pseudo.json
msgid "this should never actually show up, it's a pseudo furniture"
msgstr "esto nunca debería aparecer, es un pseudo-mueble"

#. ~ Description of furniture "this should never actually show up, it's a
#. pseudo furniture"
#: data/json/furniture_and_terrain/furniture-regional-pseudo.json
msgid ""
"This is pseudo-furniture and should never actually show up.  Please report "
"this bug."
msgstr ""
"Esto es un pseudo-mueble y no debería aparecer nunca. Por favor, informa de "
"este error."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-roof.json
msgid "cell phone signal booster"
msgstr "un potenciador de la señal de los teléfonos celulares"

#. ~ Description of furniture "cell phone signal booster"
#: data/json/furniture_and_terrain/furniture-roof.json
msgid ""
"A specialized piece of equipment that receives phone signals and amplifies "
"them to reach further destinations with more clarity.  Now that there's no "
"longer signals for them to boost, they're only good for parts."
msgstr ""
"Son equipos especializados que reciben las señales telefónicas y las "
"amplifican para llegar a lugares más lejanos con mayor claridad. Ahora que "
"ya no hay señales que puedan amplificar, solo sirven para piezas."

#. ~ Bashing failed sound of furniture "cell phone signal booster"
#: data/json/furniture_and_terrain/furniture-roof.json
msgid "womp!"
msgstr "¡womp!"

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-roof.json
msgid "satellite dish"
msgstr "antena parabólica"

#. ~ Description of furniture "satellite dish"
#: data/json/furniture_and_terrain/furniture-roof.json
msgid ""
"A small sheet metal disc designed to receive radio waves from orbital "
"satellites.  Satellites that will assuredly continue to orbit, with nothing "
"to broadcast."
msgstr ""
"Un pequeño disco de chapa diseñado para recibir las ondas de radio de los "
"satélites orbitales. Satélites que seguramente seguirán en órbita, sin nada "
"que emitir."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-roof.json
msgid "chimney crown"
msgstr "corona de chimenea"

#. ~ Description of furniture "chimney crown"
#: data/json/furniture_and_terrain/furniture-roof.json
msgid ""
"The top of a brick chimney, the opening is stained black with soot.  "
"Definitely too narrow to fit in."
msgstr ""
"La parte superior de una chimenea de ladrillo, la apertura está manchada de "
"negro con hollín. Definitivamente es demasiado estrecho para entrar."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-roof.json
msgid "TV antenna"
msgstr "Antena de TV"

#. ~ Description of furniture "TV antenna"
#: data/json/furniture_and_terrain/furniture-roof.json
msgid ""
"A simple metal antenna to increase the reception of non-cable television "
"broadcasts.  Almost wholly obsolete for years, only being good for parts "
"isn't new for this item."
msgstr ""
"Una simple antena metálica para aumentar la recepción de las emisiones de "
"televisión no por cable. Casi totalmente obsoleta desde hace años, sólo "
"sirve para piezas nada nuevo para este artículo."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-roof.json
msgid "vent pipe"
msgstr "conducto de ventilación"

#. ~ Description of furniture "vent pipe"
#: data/json/furniture_and_terrain/furniture-roof.json
msgid ""
"A sort of chimney spout for a building's internal ventilation system, this "
"can be used for circulation, venting fumes, and other such functions."
msgstr ""
"Una especie de chimenea para el sistema de ventilación interna de un "
"edificio, que puede utilizarse por la circulación, la salida de humos y "
"otras funciones similares."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-roof.json
msgid "wind vane"
msgstr "veleta"

#. ~ Description of furniture "wind vane"
#: data/json/furniture_and_terrain/furniture-roof.json
msgid ""
"A metal fin that swivels around a central pivot, indicating the direction of"
" prevailing wind."
msgstr ""
"Una aleta metálica que gira alrededor de un pivote central y que indica la "
"dirección del viento predominante."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-roof.json
msgid "roof turbine vent"
msgstr "turbina de ventilación de techo"

#. ~ Description of furniture "roof turbine vent"
#: data/json/furniture_and_terrain/furniture-roof.json
msgid ""
"A rotary wind turbine that will catch the wind and pull out air from inside."
"  It is most commonly used for improving air circulation, particularly in "
"poorly-ventilated areas like attics."
msgstr ""
"Una turbina eólica rotativa que capta el viento y extrae el aire de su "
"interior. Se utiliza sobre todo para mejorar la circulación del aire, "
"especialmente en zonas poco ventiladas como los áticos."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-rural.json
msgid "bale of hay"
msgstr "fardo de heno"

#. ~ Description of furniture "bale of hay"
#: data/json/furniture_and_terrain/furniture-rural.json
msgid ""
"A massive packed-together block of hay, it makes for easy storage of straw "
"for livestock.  If your only other option is the floor, it makes a tolerable"
" bed."
msgstr ""
"Un enorme bloque de heno empaquetado, facilita el almacenamiento de paja "
"para el ganado. Si tu única opción es el suelo, constituye una cama "
"tolerable."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-rural.json
msgid "pile of woodchips"
msgstr "pila de astillas de madera"

#. ~ Description of furniture "pile of woodchips"
#: data/json/furniture_and_terrain/furniture-rural.json
msgid ""
"A large mound of piled wood chips.  Unpleasant to lay on, hard to walk "
"through, and a large fire hazard, it's probably best to shovel it out of the"
" way."
msgstr ""
"Un gran montículo de astillas apiladas. Desagradable de pisar, difícil de "
"atravesar y un gran peligro de incendio, probablemente sea mejor quitarla "
"con una pala."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-seats.json
msgid "bench"
msgstr "banco"

#. ~ Description of furniture "bench"
#: data/json/furniture_and_terrain/furniture-seats.json
msgid ""
"A simple bench with wood slats nailed to a frame.  While uncomfortably flat "
"and just as cold as the ground, it could serve as a bed if needed."
msgstr ""
"Un simple banco con listones de madera clavados en un marco. Aunque es "
"incómodo y tan frío como el suelo, puede servir de cama si es necesario."

#. ~ Furniture name
#. ~ Item name
#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture.json
msgid "armchair"
msgid_plural "armchairs"
msgstr[0] "sillón"
msgstr[1] "sillones"
msgstr[2] "sillones"

#. ~ Description of furniture "armchair"
#. ~ Description of "armchair"
#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture.json
msgid ""
"A simple upholstered chair with armrests.  Soft and fairly warm, it "
"definitely beats the ground for sleeping on, though not by much."
msgstr ""
"Una simple silla tapizada con reposabrazos. Suave y bastante cálida, "
"definitivamente es mejor que el suelo para dormir, aunque no por mucho."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-seats.json
msgid "airplane seat"
msgstr "asiento del avión"

#. ~ Description of furniture "airplane seat"
#: data/json/furniture_and_terrain/furniture-seats.json
msgid ""
"A cheaply upholstered folding airplane seat, it has a simple across-the-lap "
"seatbelt.  You likely wouldn't be the first to sleep in this."
msgstr ""
"Un asiento de avión plegable y barato, con un simple cinturón de seguridad "
"cruzado. Probablemente no serías el primero en dormir en él."

#. ~ Furniture name
#. ~ Item name
#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture.json
msgid "wooden chair"
msgid_plural "wooden chairs"
msgstr[0] "silla de madera"
msgstr[1] "sillas de madera"
msgstr[2] "sillas de madera"

#. ~ Description of furniture "wooden chair"
#. ~ Description of "wooden chair"
#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture.json
msgid ""
"A simple wooden chair, with four legs, a seat, and a back.  It's nice to "
"rest your feet for once, and if coupled with a suitable table, you could eat"
" a meal properly and almost pretend that things were normal again."
msgstr ""
"Una simple silla de madera, con cuatro patas, un asiento y un respaldo. Es "
"agradable para descansar los pies por una vez, y si se combina con una mesa "
"adecuada, se podría comer una comida como es debido y casi fingir que las "
"cosas vuelven a ser normales."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-seats.json
msgid "sofa"
msgstr "sofá"

#. ~ Description of furniture "sofa"
#: data/json/furniture_and_terrain/furniture-seats.json
msgid ""
"A wide upholstered bench, large enough for two people to comfortably sit "
"alongside one another, or one person to lay back on.  It's not quite a bed, "
"but it's a hell of a lot more comfortable than the floor."
msgstr ""
"Un amplio banco tapizado, lo suficientemente grande como para que dos "
"personas se sienten cómodamente una al lado de la otra, o una persona se "
"recueste en él. No es exactamente una cama, pero es mucho más cómodo que el "
"suelo."

#. ~ Furniture name
#. ~ Item name
#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture.json
msgid "wooden stool"
msgid_plural "wooden stools"
msgstr[0] "taburete de madera"
msgstr[1] "taburetes de madera"
msgstr[2] "taburetes de madera"

#. ~ Description of furniture "wooden stool"
#. ~ Description of "wooden stool"
#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture.json
msgid ""
"A simple stool, with four legs and a seat.  While it's a touch more "
"maneuverable to sit on, the lack of back support means it's significantly "
"less comfortable than a normal chair."
msgstr ""
"Un simple taburete, con cuatro patas y un asiento. Aunque es un poco más "
"maniobrable para sentarse, la falta de un apoyo para la espalda significa "
"que es significativamente menos cómodo que una silla normal."

#. ~ Furniture name
#. ~ values based on basic real world folding camp chair
#. ~ Item name
#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/tool/deployable.json
msgid "camp chair"
msgid_plural "camp chairs"
msgstr[0] "silla de campamento"
msgstr[1] "sillas de campamento"
msgstr[2] "sillas de campamento"

#. ~ Description of furniture "camp chair"
#: data/json/furniture_and_terrain/furniture-seats.json
msgid ""
"A somewhat uncomfortable folding chair, with fabric strung across a metal "
"frame.  Not the best, but better than nothing, and a lot easier to pack up."
msgstr ""
"Una silla plegable algo incómoda, con tela ensartada en un marco de metal. "
"No es lo mejor, pero es mejor que nada, y es mucho más fácil de empaquetar."

#. ~ Furniture name
#. ~ Item name
#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture.json
msgid "log stool"
msgid_plural "log stools"
msgstr[0] "taburete de troncos"
msgstr[1] "taburetes de troncos"
msgstr[2] "taburetes de troncos"

#. ~ Description of furniture "log stool"
#. ~ Description of "log stool"
#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture.json
msgid ""
"A short section from a tree trunk with one of the flat ends smoothed down.  "
"Makes for a decent place to sit, but not quite a real chair."
msgstr ""
"Una sección corta de un tronco de árbol con uno de los extremos planos "
"alisados. Es un lugar decente para sentarse, pero no es una verdadera silla."

#. ~ Furniture name
#. ~ Item name
#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/tool/deployable.json
msgid "deck chair"
msgid_plural "deck chairs"
msgstr[0] "tumbona"
msgstr[1] "tumbonas"
msgstr[2] "tumbonas"

#. ~ Description of furniture "deck chair"
#: data/json/furniture_and_terrain/furniture-seats.json
msgid ""
"A folding deck chair with fabric sheets mounted to a wooden frame.  While "
"it's built to take outdoor conditions and is an improvement over the ground,"
" it's not particularly comfortable."
msgstr ""
"Una tumbona plegable con láminas de tela montadas en una estructura de "
"madera. Aunque está construida para soportar las condiciones de la "
"intemperie y es una mejora respecto al suelo, no es especialmente cómoda."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-seats.json
msgid "metal bench"
msgstr "banco de metal"

#. ~ Description of furniture "metal bench"
#: data/json/furniture_and_terrain/furniture-seats.json
msgid ""
"A bench made of metal.  Not the most comfortable furniture you've ever seen."
msgstr "Un banco hecho de metal. No es el mueble más cómodo que hayas visto."

#. ~ Furniture name
#. ~ Vehicle part name
#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/vehicleparts/vehicle_parts.json
msgid "wooden bench"
msgstr "banco de madera"

#. ~ Description of furniture "wooden bench"
#: data/json/furniture_and_terrain/furniture-seats.json
msgid ""
"A simple wooden bench made of two makeshift thick legs and a flat piece of "
"wood on top.  Certainly nowhere near as good as a bed but at least it feels "
"like you're out camping."
msgstr ""
"Un sencillo banco de madera hecho con dos gruesas patas improvisadas y un "
"trozo de madera plano encima. Desde luego, no es ni mucho menos tan bueno "
"como una cama, pero al menos da la sensación de estar de acampada."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-seats.json
msgid "park bench"
msgstr "banco de parque"

#. ~ Description of furniture "park bench"
#: data/json/furniture_and_terrain/furniture-seats.json
msgid ""
"A wooden bench with a metal frame and a back support.  Still cold and "
"uncomfortable to sleep on but sitting on it is not terrible."
msgstr ""
"Un banco de madera con un marco de metal y un soporte para la espalda. Sigue"
" siendo frío e incómodo para dormir, pero sentarse en él no es terrible."

#. ~ Furniture name
#. ~ Item name
#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture.json
msgid "bar stool"
msgid_plural "bar stools"
msgstr[0] "taburete de bar"
msgstr[1] "taburetes de bar"
msgstr[2] "taburetes de bar"

#. ~ Description of furniture "bar stool"
#. ~ Description of "bar stool"
#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture.json
msgid ""
"A bar stool with a leather seat on a steel support.  Not practical for "
"sleeping at all but it does feel nicer than sitting on the ground."
msgstr ""
"Un taburete de bar con un asiento de cuero sobre un soporte de acero. No es "
"nada práctico para dormir, pero resulta más agradable que sentarse en el "
"suelo."

#. ~ Furniture name
#. ~ Item name
#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/tool/deployable.json
msgid "folding chair"
msgid_plural "folding chairs"
msgstr[0] "silla plegable"
msgstr[1] "sillas plegables"
msgstr[2] "sillas plegables"

#. ~ Description of furniture "folding chair"
#: data/json/furniture_and_terrain/furniture-seats.json
msgid ""
"A black foldable plastic chair on a steel frame.  Not particularly "
"comfortable but at least you have something to sit on."
msgstr ""
"Una silla negra de plástico plegable sobre una estructura de acero. No es "
"especialmente cómoda, pero al menos tienes algo en lo que sentarte."

#. ~ Furniture name
#. ~ Item name
#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture.json
msgid "plywood chair"
msgid_plural "plywood chairs"
msgstr[0] "silla de madera contrachapada"
msgstr[1] "sillas de madera contrachapada"
msgstr[2] "sillas de madera contrachapada"

#. ~ Description of furniture "plywood chair"
#. ~ Description of "plywood chair"
#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture.json
msgid ""
"A simple chair made of plywood on a steel frame.  Quite uncomfortable but "
"works for sleeping if it's the only option available."
msgstr ""
"Una sencilla silla hecha de madera contrachapada sobre una estructura de "
"acero. Bastante incómoda, pero sirve para dormir si es la única opción "
"disponible."

#. ~ Furniture name
#. ~ Item name
#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture.json
msgid "black wooden chair"
msgid_plural "black wooden chairs"
msgstr[0] "silla de madera negra"
msgstr[1] "sillas de madera negras"
msgstr[2] "sillas de madera negras"

#. ~ Description of furniture "black wooden chair"
#. ~ Description of "black wooden chair"
#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture.json
msgid ""
"A simple wooden chair, with four legs, a seat, and a back.  It's nice to "
"rest your feet for once, and if coupled with a suitable table, you could eat"
" a meal properly and almost pretend that things were normal again.  This "
"particular chair was painted black."
msgstr ""
"Una sencilla silla de madera, con cuatro patas, un asiento y un respaldo. Es"
" agradable para descansar los pies por una vez, y si se combina con una mesa"
" adecuada, se puede comer bien y casi fingir que las cosas vuelven a ser "
"normales. Esta silla en particular estaba pintada de negro."

#. ~ Furniture name
#. ~ Item name
#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture.json
msgid "white wooden chair"
msgid_plural "white wooden chairs"
msgstr[0] "silla de madera blanca"
msgstr[1] "sillas de madera blancas"
msgstr[2] "sillas de madera blancas"

#. ~ Description of furniture "white wooden chair"
#. ~ Description of "white wooden chair"
#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture.json
msgid ""
"A simple wooden chair, with four legs, a seat, and a back.  It's nice to "
"rest your feet for once, and if coupled with a suitable table, you could eat"
" a meal properly and almost pretend that things were normal again.  This "
"particular chair was painted white."
msgstr ""
"Una sencilla silla de madera, con cuatro patas, un asiento y un respaldo. Es"
" agradable para descansar los pies por una vez, y si se combina con una mesa"
" adecuada, se puede comer bien y casi fingir que las cosas vuelven a ser "
"normales. Esta silla en particular estaba pintada de blanco."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-signs.json
#: data/mods/innawood/furniture_and_terrain/furniture-tools.json
msgid "bulletin board"
msgstr "tablero de avisos"

#. ~ Description of furniture "bulletin board"
#: data/json/furniture_and_terrain/furniture-signs.json
msgid ""
"A wide wooden frame with a sheet of corkboard inside.  Good for pinning "
"various notices for other survivors to read."
msgstr ""
"Una estructura ancha de madera con una hoja de corcho en su interior. Sirve "
"para fijar varios avisos para que otros supervivientes los lean."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-signs.json
msgid "sign"
msgstr "cartel"

#. ~ Description of furniture "sign"
#: data/json/furniture_and_terrain/furniture-signs.json
msgid ""
"A simple signpost made of wood.  Basically two planks alongside each other "
"nailed to another plank that holds them up."
msgstr ""
"Un simple poste de señalización hecho de madera. Básicamente son dos "
"tablones uno al lado del otro clavados a otro tablón que los sostiene."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-signs.json
msgid "warning sign"
msgstr "señal de advertencia"

#. ~ Description of furniture "warning sign"
#: data/json/furniture_and_terrain/furniture-signs.json
msgid ""
"A triangular signpost painted white with a red border.  Designed to easily "
"catch the eye, signs of this nature seldom display anything but bad news."
msgstr ""
"Un poste indicador triangular pintado de blanco con un borde rojo. Diseñados"
" para captar fácilmente la atención, los carteles de esta naturaleza rara "
"vez muestran algo que no sean malas noticias."

#. ~ Furniture name
#. ~ Vehicle part name
#: data/json/furniture_and_terrain/furniture-sleep.json
#: data/json/vehicleparts/vehicle_parts.json
msgid "bed"
msgstr "cama"

#. ~ Description of furniture "bed"
#: data/json/furniture_and_terrain/furniture-sleep.json
msgid ""
"A standard mattress on a sturdy wooden frame.  Even without blankets or "
"pillows, and despite being a completely ordinary mattress, it's a sight for "
"sore, tired eyes."
msgstr ""
"Un colchón estándar sobre un estructura robusta de madera. Incluso sin "
"mantas ni almohadas, y a pesar de ser un colchón completamente normal, es un"
" espectáculo para los ojos cansados y doloridos."

#. ~ Furniture name
#. ~ Blueprint name of recipe crafting "faction_base_outpost_cross_bed_0"
#. ~ Blueprint name of recipe crafting "faction_base_outpost_normal_bed_0"
#: data/json/furniture_and_terrain/furniture-sleep.json
#: data/json/recipes/basecamps/base/fbmc_outpost/recipe_modular_outpost_cross.json
#: data/json/recipes/basecamps/base/fbmc_outpost/recipe_modular_outpost_normal.json
msgid "bunk bed"
msgstr "litera"

#. ~ Description of furniture "bunk bed"
#: data/json/furniture_and_terrain/furniture-sleep.json
msgid ""
"A bunk bed with a sturdy wooden frame built to hold two single-person "
"mattresses above one another.  While these usually mean sleeping closer than"
" you'd like to somebody you wouldn't normally want to share a mattress with,"
" a bed's a bed."
msgstr ""
"Una litera con una robusta estructura de madera construida para sostener dos"
" colchones de una persona encima de otro. Aunque suelen suponer dormir más "
"cerca de lo que te gustaría de alguien con quien normalmente no querrías "
"compartir colchón, una cama es una cama."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-sleep.json
msgid "triple berth"
msgstr "litera triple"

#. ~ Description of furniture "triple berth"
#: data/json/furniture_and_terrain/furniture-sleep.json
msgid ""
"This bunk bed can hold 3 person at once - perfect solution for places with "
"lack of free space."
msgstr ""
"Esta litera tiene capacidad para 3 personas a la vez - solución perfecta "
"para lugares con falta de espacio libre."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-sleep.json
msgid "bed frame"
msgstr "estructura de cama"

#. ~ Description of furniture "bed frame"
#: data/json/furniture_and_terrain/furniture-sleep.json
msgid ""
"A sturdy wooden bed frame built to hold most standard mattresses.  Despite "
"being one half of a bed, it's just about impossible to lay on by itself."
msgstr ""
"Una robusta estructura de cama de madera construido para sostener la mayoría"
" de los colchones estándar. A pesar de ser una mitad de la cama, es casi "
"imposible acostarse en ella sola."

#. ~ Furniture name
#. ~ Item name
#: data/json/furniture_and_terrain/furniture-sleep.json
#: data/json/items/resources/misc.json
msgid "mattress"
msgid_plural "mattresses"
msgstr[0] "colchón"
msgstr[1] "colchones"
msgstr[2] "colchones"

#. ~ Description of furniture "mattress"
#: data/json/furniture_and_terrain/furniture-sleep.json
msgid ""
"An ordinary mattress left on the floor.  While it's not as comfortable as an"
" entire bed without the mattress, it's pretty close.  If it's someplace "
"actually safe to sleep, it's practically a luxury in and of itself."
msgstr ""
"Un colchón normal tirado en el suelo. Aunque no es tan cómodo como una cama "
"entera sin el colchón, se acerca bastante. Si es un lugar realmente seguro "
"para dormir, es prácticamente un lujo en sí mismo."

