msgid_plural "pedal powered grindstones"
msgstr[0] "piedra de amolar a pedal"
msgstr[1] "piedras de amolar a pedal"
msgstr[2] "piedras de amolar a pedal"

#. ~ Description of "pedal powered grindstone"
#: data/json/items/tool/metalworking.json
msgid "A round, pedal-powered grindstone, useful for grinding metal."
msgstr ""
"Una piedra de amolar circular que se acciona a pedal, útil para pulir metal."

#. ~ Item name
#: data/json/items/tool/metalworking.json
msgid "steel scraper"
msgid_plural "steel scrapers"
msgstr[0] "espátula de acero"
msgstr[1] "espátulas de acero"
msgstr[2] "espátulas de acero"

#. ~ Description of "steel scraper"
#: data/json/items/tool/metalworking.json
msgid "A hardened steel tool similar to a drawknife, but for metal."
msgstr ""
"Una herramienta de acero endurecido similar a un bastren pero para trabajar "
"metal."

#. ~ Based on the Whisper Daddy 3 Burner Forge, large enough to craft tools
#. and small weapons.
#. ~ Item name
#: data/json/items/tool/metalworking.json
msgid "gas forge"
msgid_plural "gas forges"
msgstr[0] "forja de gas"
msgstr[1] "forjas de gas"
msgstr[2] "forjas de gas"

#. ~ Based on the Whisper Daddy 3 Burner Forge, large enough to craft tools
#. and small weapons.
#. ~ Description of "gas forge"
#: data/json/items/tool/metalworking.json
msgid ""
"This is a gas-fueled metalworking forge.  If combined with the right tools, "
"you could use this for metalworking."
msgstr ""
"Esta es una fragua para trabajar el metal que funciona con gas. Si se "
"combina con herramientas adecuadas, se puede utilizar para trabajar el "
"metal."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "compressed air horn"
msgid_plural "compressed air horns"
msgstr[0] "bocina de aire comprimido"
msgstr[1] "bocinas de aire comprimido"
msgstr[2] "bocinas de aire comprimido"

#. ~ Description of "compressed air horn"
#: data/json/items/tool/misc.json
msgid ""
"This is a small can of compressed air attached to a plastic horn.  Pressing "
"the button on top causes it to emit a loud honking sound."
msgstr ""
"Es una pequeña lata de aire comprimido conectado a una bocina de plástico. "
"Apretar el botón de arriba hace que se emita un bocinazo muy fuerte."

#. ~ "noise_message" action message of item "compressed air horn"
#: data/json/items/tool/misc.json
msgid "HOOOOONK!"
msgstr "¡HOOOOONK!"

#. ~ "use_message" action message of item "compressed air horn"
#: data/json/items/tool/misc.json
msgid "You honk your airhorn."
msgstr "Tocas la bocina de aire."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "alarm clock"
msgid_plural "alarm clocks"
msgstr[0] "reloj despertador"
msgstr[1] "relojes despertador"
msgstr[2] "relojes despertador"

#. ~ Description of "alarm clock"
#: data/json/items/tool/misc.json
msgid ""
"A wind-up alarm clock.  Though the noise it makes is unpleasant to wake up "
"to, it's always good to get an early start to your day.  Can also be "
"disassembled into some useful parts."
msgstr ""
"Un reloj despertador a cuerda. Aunque es desagradable despertarse con el "
"ruido que hace, siempre es bueno levantarse tempranito. También puede ser "
"desmóntado para recuperar sus partes."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "can of butane"
msgid_plural "cans of butane"
msgstr[0] "lata de butano"
msgstr[1] "latas de butano"
msgstr[2] "latas de butano"

#. ~ Description of "can of butane"
#: data/json/items/tool/misc.json
msgid ""
"A non-refillable can of butane with an adapter for refilling lighters.  It "
"could be useful as a fuel, but also as a solvent or chemical reagent."
msgstr ""
"Una lata de butano que no se puede recargar con un adaptador para cargar un "
"encendedor. Puede ser útil como combustible pero también como solvente o "
"reactivo químico."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "clay urn"
msgid_plural "clay urns"
msgstr[0] "urna de arcilla"
msgstr[1] "urnas de arcilla"
msgstr[2] "urnas de arcilla"

#. ~ Description of "clay urn"
#: data/json/items/tool/misc.json
msgid "A clay container for storing cremated ashes."
msgstr "Recipiente de arcilla para guardar las cenizas incineradas."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "cow bell"
msgid_plural "cow bells"
msgstr[0] "cencerro"
msgstr[1] "cencerros"
msgstr[2] "cencerros"

#. ~ Description of "cow bell"
#: data/json/items/tool/misc.json
msgid "A brass cow bell.  You feel like you need more of it."
msgstr "Un cencerro de latón. Sientes que necesitas mas."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "crystal urn"
msgid_plural "crystal urns"
msgstr[0] "urna de cristal"
msgstr[1] "urnas de cristal"
msgstr[2] "urnas de cristal"

#. ~ Description of "crystal urn"
#: data/json/items/tool/misc.json
msgid ""
"An exquisite, translucent container for cremated ashes, decorated with "
"floral patterns."
msgstr ""
"Un recipiente precioso y translúcido para guardar cenizas de algún cuerpo "
"cremado, decorado con un diseño floral."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "entrenching tool"
msgid_plural "entrenching tools"
msgstr[0] "herramienta de trinchera"
msgstr[1] "herramientas de trinchera"
msgstr[2] "herramientas de trinchera"

#. ~ Description of "entrenching tool"
#: data/json/items/tool/misc.json
msgid ""
"This is a stout collapsible spade.  It's commonly used by military forces "
"and favored by hikers for digging."
msgstr ""
"Es una pala fuerte y plegable. Es comúnmente utilizada por las fuerzas "
"militares y la favorita para cavar de los excursionistas."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "etched human skull"
msgid_plural "etched human skulls"
msgstr[0] "calavera humana grabada"
msgstr[1] "calaveras humanas grabadas"
msgstr[2] "calaveras humanas grabadas"

#. ~ Description of "etched human skull"
#: data/json/items/tool/misc.json
msgid "This is a human skull with strange etchings covering it."
msgstr "Es una calavera humana con unos extraños grabados sobre ella."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "fur rollmat"
msgid_plural "fur rollmats"
msgstr[0] "colchoneta de piel"
msgstr[1] "colchonetas de piel"
msgstr[2] "colchonetas de piel"

#. ~ Description of "fur rollmat"
#: data/json/items/tool/misc.json
msgid ""
"This is a bedroll made of pelts which can be rolled up for transport.  It "
"insulates you from the floor, making it easier to sleep.  Use it to unroll "
"and place on the ground."
msgstr ""
"Un saco de dormir hecho de pelajes que puede ser enrollado para ser fácil de"
" transportar. Te aísla del suelo, lo que facilita dormir. Úsalo para "
"desenrollarlo y ponerlo en el suelo."

#. ~ "done_message" action message of item "fur rollmat"
#: data/json/items/tool/misc.json
msgid "You unroll the fur mat and lay it on the ground."
msgstr "Desenrollas la colchoneta de piel y la colocas en el suelo."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "garden hose"
msgid_plural "garden hoses"
msgstr[0] "manguera de jardín"
msgstr[1] "mangueras de jardín"
msgstr[2] "mangueras de jardín"

#. ~ Description of "garden hose"
#: data/json/items/tool/misc.json
msgid ""
"This is a flexible garden hose.  If you cut it in smaller pieces, it could "
"be used for crafting, or siphoning fuel from a vehicle."
msgstr ""
"Esta es una manguera de jardín flexible. Si la cortas en piezas pequeñas, se"
" podría usar para fabricar, o para transvasar la gasolina a un vehículo."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "grappling hook"
msgid_plural "grappling hooks"
msgstr[0] "gancho de escalada"
msgstr[1] "ganchos de escalada"
msgstr[2] "ganchos de escalada"

#. ~ Description of "grappling hook"
#: data/json/items/tool/misc.json
msgid ""
"A folding grappling hook attached to a stout 30-foot long piece of "
"lightweight cord.  Useful for keeping yourself safe from falls.  Can be used"
" in place of a long rope for butchering, in a pinch."
msgstr ""
"Un gancho de escalada plegable unido a un robusto trozo de cuerda ligera de "
"30 pies de largo. Útil para mantenerte a salvo de las caídas. Se puede usar "
"en lugar de una cuerda larga para descuartizar, en caso de necesidad."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "grip hook"
msgid_plural "grip hooks"
msgstr[0] "gancho de agarre"
msgstr[1] "ganchos de agarre"
msgstr[2] "ganchos de agarre"

#. ~ Description of "grip hook"
#: data/json/items/tool/misc.json
msgid "A simple steel meathook with a circular steel handle."
msgstr "Un simple gancho de carne de acero con un mango circular de acero."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "hand pump"
msgid_plural "hand pumps"
msgstr[0] "inflador de mano"
msgstr[1] "infladores de mano"
msgstr[2] "infladores de mano"

#. ~ Description of "hand pump"
#: data/json/items/tool/misc.json
msgid "This pump is suitable for pumping air into inflatable objects."
msgstr ""
"Este inflador se puede usar para meterle aire a los objetos inflables."

#. ~ Item name
#. ~ Vehicle part name
#: data/json/items/tool/misc.json data/json/vehicleparts/vehicle_parts.json
msgid "bicycle horn"
msgid_plural "bicycle horns"
msgstr[0] "bocina de bicicleta"
msgstr[1] "bocinas de bicicleta"
msgstr[2] "bocinas de bicicleta"

#. ~ Description of "bicycle horn"
#: data/json/items/tool/misc.json
msgid ""
"This is a simple bulb horn, found on many bicycles.  Use to honk.  Honk "
"honk."
msgstr ""
"Es una de esas simples bocinas de corneta, que tienen muchas bicicletas. "
"Usala para hacerla sonar. Honk honk."

#. ~ "noise_message" action message of item "bicycle horn"
#: data/json/items/tool/misc.json
msgid "honk."
msgstr "bocina."

#. ~ "use_message" action message of item "bicycle horn"
#: data/json/items/tool/misc.json
msgid "You honk the bicycle horn."
msgstr "Tocas la bocina de la bicicleta."

#. ~ Item name
#. ~ Vehicle part name
#: data/json/items/tool/misc.json data/json/vehicleparts/vehicle_parts.json
msgid "truck horn"
msgid_plural "truck horns"
msgstr[0] "bocina de camión"
msgstr[1] "bocinas de camión"
msgstr[2] "bocinas de camión"

#. ~ Description of "truck horn"
#: data/json/items/tool/misc.json
msgid "This is a very loud horn, usually found on large trucks like semis."
msgstr ""
"Esta es una bocina muy ruidosa, de las que tienen los grandes camiones como "
"los semirremolques."

#. ~ Item name
#. ~ Vehicle part name
#: data/json/items/tool/misc.json data/json/vehicleparts/vehicle_parts.json
msgid "car horn"
msgid_plural "car horns"
msgstr[0] "cláxon"
msgstr[1] "cláxones"
msgstr[2] "cláxones"

#. ~ Description of "car horn"
#: data/json/items/tool/misc.json
msgid "This is a car horn meant to be attached to a car's electrical system."
msgstr ""
"Esta es una bocina de auto diseñada para ser conectada a un sistema "
"eléctrico de auto."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "large space heater"
msgid_plural "large space heaters"
msgstr[0] "calefactor grande"
msgstr[1] "calefactores grandes"
msgstr[2] "calefactores grandes"

#. ~ Description of "large space heater"
#. ~ Description of "large space heater (on)"
#: data/json/items/tool/misc.json
msgid ""
"A portable electric heater that steadily emits warm air.  Raises temperature"
" about 10 degrees C and fills a larger volume of air than the smaller "
"version."
msgstr ""
"Un calentador eléctrico portátil que emite constantemente aire caliente. "
"Eleva la temperatura unos 10 grados centigrados y llena un mayor volumen de "
"aire que la versión más pequeña."

#. ~ "msg" action message of item "large space heater"
#. ~ "msg" action message of item "small space heater"
#: data/json/items/tool/misc.json
msgid "You turn on the heater."
msgstr "Enciende el calentador."

#. ~ "need_charges_msg" action message of item "large space heater"
#. ~ "need_charges_msg" action message of item "small space heater"
#: data/json/items/tool/misc.json
msgid "The heater needs more charge."
msgstr "El calentador necesita más carga."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "large space heater (on)"
msgid_plural "large space heaters (on)"
msgstr[0] "calefactor grande (on)"
msgstr[1] "calefactores grandes (on)"
msgstr[2] "calefactores grandes (on)"

#. ~ "msg" action message of item "large space heater (on)"
#. ~ "msg" action message of item "small space heater (on)"
#: data/json/items/tool/misc.json
msgid "You turn off the heater."
msgstr "Apaga el calentador."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "lifestraw"
msgid_plural "lifestraws"
msgstr[0] "lifestraw (filtro de agua)"
msgstr[1] "lifestraws (filtros de agua)"
msgstr[2] "lifestraws (filtros de agua)"

#. ~ Description of "lifestraw"
#: data/json/items/tool/misc.json
msgid ""
"Set the lifestraw in suspect water, let sit for one minute then drink.  The "
"two part filtration system will purify the water you drink.  Water taken "
"from uncertain sources like a river may be dirty."
msgstr ""
"Ponga la cuerda salvavidas en el agua sospechosa, siéntese un minuto y beba."
" El sistema de filtración de dos partes purificará el agua que usted beba. "
"El agua tomada de fuentes inciertas como un río puede estar sucia."

#. ~ gasket sizes range from 1in diameter to 6in.
#. ~ Item name
#: data/json/items/tool/misc.json
msgid "plastic gasket"
msgid_plural "plastic gaskets"
msgstr[0] "empaquetadura de plástico"
msgstr[1] "empaquetaduras de plástico"
msgstr[2] "empaquetaduras de plástico"

#. ~ gasket sizes range from 1in diameter to 6in.
#. ~ Description of "plastic gasket"
#: data/json/items/tool/misc.json
msgid "A single-use plastic gasket."
msgstr "Una empaquetadura de plástico de un solo uso."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "permanent marker"
msgid_plural "permanent markers"
msgstr[0] "rotulador permanente"
msgstr[1] "rotuladores permanentes"
msgstr[2] "rotuladores permanentes"

#. ~ Description of "permanent marker"
#: data/json/items/tool/misc.json
msgid ""
"This is a King Size™ industrial strength permanent marker, about halfway "
"between a typical marker and a can of spray paint in size.  Use it to write "
"something down.  However, writing \"Elbereth\" probably won't help you."
msgstr ""
"Un rotulador indeleble King Size™ industrial, un producto intermedio entre "
"un marcador típico y una lata de pintura en aerosol.  Úsalo para escribir "
"cosas.  Aunque escribir \"Elbereth\" probablemente no tenga utilidad alguna."

#. ~ "gerund" action message of item "permanent marker"
#. ~ "gerund" action message of item "survival marker"
#. ~ "gerund" action message of item "pen"
#. ~ "gerund" action message of item "pencil"
#. ~ "gerund" action message of item "black pen"
#. ~ "gerund" action message of item "blue pen"
#. ~ "gerund" action message of item "red pen"
#. ~ "gerund" action message of item "green pen"
#: data/json/items/tool/misc.json data/json/items/tool/stationary.json
msgid "Written"
msgstr "Escrito"

#. ~ "verb" action message of item "permanent marker"
#. ~ "verb" action message of item "survival marker"
#. ~ "verb" action message of item "pen"
#. ~ "verb" action message of item "pencil"
#. ~ "verb" action message of item "black pen"
#. ~ "verb" action message of item "blue pen"
#. ~ "verb" action message of item "red pen"
#. ~ "verb" action message of item "green pen"
#: data/json/items/tool/misc.json data/json/items/tool/stationary.json
msgid "Write"
msgstr "Escribir"

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "pocket watch"
msgid_plural "pocket watches"
msgstr[0] "reloj de bolsillo"
msgstr[1] "relojes de bolsillo"
msgstr[2] "relojes de bolsillo"

#. ~ Description of "pocket watch"
#: data/json/items/tool/misc.json
msgid ""
"An old-fashioned pocket watch.  This one tells you the time and looks good "
"doing it.  Can also be disassembled into some useful parts."
msgstr ""
"Un anticuado reloj de bolsillo. Este te dice la hora y se ve bien al "
"hacerlo. También puede ser desmóntado en algunas partes útiles."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "porcelain urn"
msgid_plural "porcelain urns"
msgstr[0] "urna de porcelana"
msgstr[1] "urnas de porcelana"
msgstr[2] "urnas de porcelana"

#. ~ Description of "porcelain urn"
#: data/json/items/tool/misc.json
msgid ""
"A container for holding the remains of a loved one.  Its prior owners must "
"have kept good care of it, as you can see your face reflected clearly upon "
"its surface."
msgstr ""
"Un recipiente para contener los restos de una persona querida. Sus dueños "
"deben haberla cuidado muy bien ya que puedes ver tu cara reflejada en su "
"superficie."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "rollmat"
msgid_plural "rollmats"
msgstr[0] "colchoneta"
msgstr[1] "colchonetas"
msgstr[2] "colchonetas"

#. ~ Description of "rollmat"
#: data/json/items/tool/misc.json
msgid ""
"This is a sheet of foam which can be rolled tightly for storage.  It "
"insulates you from the floor, making it easier to sleep.  Use it to unroll "
"and place on the ground."
msgstr ""
"Esta es una lámina de gomespuma que puede ser enrollada para ser fácil de "
"guardar. Te aísla del suelo, lo que facilita dormir. Usala para "
"desenrollarla y ponerla en el suelo."

#. ~ "done_message" action message of item "rollmat"
#: data/json/items/tool/misc.json
msgid "You unroll the mat and lay it on the ground."
msgstr "Desenrollas la colchoneta y la colocas en el suelo."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "safe deposit box"
msgid_plural "safe deposit boxes"
msgstr[0] "caja de seguridad"
msgstr[1] "cajas de seguridad"
msgstr[2] "cajas de seguridad"

#. ~ Description of "safe deposit box"
#: data/json/items/tool/misc.json
msgid ""
"This is a secure combination lock box.  Sadly, you don't know the "
"combination.  Breaking inside it would destroy anything of value."
msgstr ""
"Es una caja de seguridad con combinación. Lamentablemente, no conoces la "
"combinación. Romperla para abrirla va a destruir las cosas de valor."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "sarcophagus access code"
msgid_plural "sarcophagus access codes"
msgstr[0] "código de acceso a sarcófago"
msgstr[1] "códigos de acceso a sarcófago"
msgstr[2] "códigos de acceso a sarcófago"

#. ~ Description of "sarcophagus access code"
#: data/json/items/tool/misc.json
msgid ""
"This printout is a string of numbers to access the elevator in the hazardous"
" waste sarcophagus."
msgstr ""
"Este impreso es una cadena de números para acceder al ascensor en el "
"sarcófago de residuos peligrosos."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "small space heater"
msgid_plural "small space heaters"
msgstr[0] "calefactor pequeño"
msgstr[1] "calefactores pequeños"
msgstr[2] "calefactores pequeños"

#. ~ Description of "small space heater"
#. ~ Description of "small space heater (on)"
#: data/json/items/tool/misc.json
msgid ""
"A portable electric heater that steadily emits warm air.  Raises temperature"
" about 10 degrees C."
msgstr ""
"Un calentador eléctrico portátil que emite constantemente aire caliente. "
"Aumenta la temperatura unos 10 grados Centigrados."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "small space heater (on)"
msgid_plural "small space heaters (on)"
msgstr[0] "calefactor pequeño (on)"
msgstr[1] "calefactores pequeños (on)"
msgstr[2] "calefactores pequeños (on)"

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "spray can"
msgid_plural "spray cans"
msgstr[0] "aerosol"
msgstr[1] "aerosoles"
msgstr[2] "aerosoles"

#. ~ Description of "spray can"
#: data/json/items/tool/misc.json
msgid ""
"This is a spray can, filled with paint.  Use this tool to make graffiti on "
"the floor."
msgstr ""
"Es una lata de aerosol, llena de pintura. Úsala para hacer un grafiti en el "
"suelo."

#. ~ Description of "wooden stepladder"
#: data/json/items/tool/misc.json
msgid "This is a wooden stepladder.  Use it to set it down."
msgstr "Es una escalera de mano de madera. Usala para ubicarla."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "survival marker"
msgid_plural "survival markers"
msgstr[0] "marcador de supervivencia"
msgstr[1] "marcadores de supervivencia"
msgstr[2] "marcadores de supervivencia"

#. ~ Description of "survival marker"
#: data/json/items/tool/misc.json
msgid ""
"This is a sharpened piece of charcoal that is almost guaranteed to make your"
" hands all covered in charcoal.  Use it to write something down."
msgstr ""
"Esta es una pieza afilada de carbón vegetal que casi garantiza que "
"terminarás con las manos todas manchadas de carbón vegetal. Úsalo para "
"escribir alguna cosa."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "retractable telescope"
msgid_plural "retractable telescopes"
msgstr[0] "telescopio retráctil"
msgstr[1] "telescopios retráctiles"
msgstr[2] "telescopios retráctiles"

#. ~ Description of "retractable telescope"
#: data/json/items/tool/misc.json
msgid ""
"A homemade collapsible telescope, perfect for a pirate.  Too large and "
"inaccurate to use as a weapon scope, but carrying this item in your "
"inventory will double the distance that is mapped around you during your "
"travels."
msgstr ""
"Un telescopio casero y retráctil, perfecto para un pirata. Es demasiado "
"largo y poco preciso para usarlo como mira para un arma, pero tener este "
"objeto en tu inventario duplica la distancia que ves en el mapa."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "tear gas payload"
