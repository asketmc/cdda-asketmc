msgid "Bionic Boffin"
msgstr "Cerebrito Biónico"

#. ~ Description of profession "Bionic Boffin" for male
#: data/mods/package_bionic_professions/bionic_professions.json
msgctxt "prof_desc_male"
msgid ""
"You were employed by a major international corporation as a representative "
"and technical advisor, utilizing the incredible power of your cybernetically"
" augmented mind."
msgstr ""
