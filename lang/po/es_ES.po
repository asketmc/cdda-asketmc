msgstr[1] "tripas para salchichas"
msgstr[2] "tripas para salchichas"

#. ~ Description of "sausage casing"
#: data/json/items/comestibles/offal_dishes.json
msgid ""
"Sausage casings made from animal intestines.  Ready to be used for forming "
"meat products."
msgstr ""
"Tripas de salchicha hechas de intestinos de origen animal. Listas para ser "
"usadas para formar productos cárnicos."

#. ~ Item name
#: data/json/items/comestibles/offal_dishes.json
msgid "artificial sausage casing"
msgid_plural "artificial sausage casings"
msgstr[0] "tripa artificial para salchicha"
msgstr[1] "tripas artificiales para salchichas"
msgstr[2] "tripas artificiales para salchichas"

#. ~ Description of "artificial sausage casing"
#: data/json/items/comestibles/offal_dishes.json
msgid ""
"Sausage casings made from plastic bags.  Ready to be used for forming meat "
"products."
msgstr ""
"Tripas para embutidos fabricadas con bolsas de plástico. Listas para ser "
"utilizadas para formar productos cárnicos."

#. ~ Item name
#: data/json/items/comestibles/offal_dishes.json
msgid "homemade hot dog"
msgid_plural "homemade hot dogs"
msgstr[0] "perrito caliente casero"
msgstr[1] "perritos calientes caseros"
msgstr[2] "perritos calientes caseros"

#. ~ Item name
