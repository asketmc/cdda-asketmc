#: data/json/recipes/nested.json
msgid "canvas dusters"
msgstr ""

#. ~ Description of the category "canvas dusters"
#: data/json/recipes/nested.json
msgid "Recipes related to tailoring long coats from cotton, known as dusters."
msgstr ""

#. ~ name of the nested group
#: data/json/recipes/nested.json
msgid "fur dusters"
