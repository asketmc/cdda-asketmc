msgstr[0] "dron de seguridad MAZ (Mantenimiento Azul)"
msgstr[1] "drones de seguridad MAZ (Mantenimiento Azul)"
msgstr[2] "drones de seguridad MAZ (Mantenimiento Azul)"

#. ~ Spell name
#: data/json/monsters/lab_security_drones.json
