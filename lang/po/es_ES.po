#. ~ Item name
#: data/mods/Aftershock/items/items.json
#: data/mods/BlazeIndustries/items/items.json
msgid "titanium"
msgid_plural "titanium"
msgstr[0] "titanio"
msgstr[1] "titanio"
msgstr[2] "titanio"

#. ~ Density 4.506g/cm³ ~ 1.127kg/250ml @ stack 1000 = 1g/unit
#. ~ Description of "titanium"
#: data/mods/Aftershock/items/items.json
#: data/mods/BlazeIndustries/items/items.json
msgid ""
"A strong, durable metal.  Highly valued for its weight to strength ratio and"
" an excellent upgrade to aluminum for those properties - albeit a lot more "
"expensive due to rarity.  More commonly used in jewelry and medical "
"implants."
msgstr ""
"Un metal duradero y fuerte. Muy valorado por su relación peso/resistencia y "
"una excelente mejora respecto al aluminio por dichas propiedades aunque "
"mucho más caro debido a su rareza. Se usa comunmente en joyería e implantes "
"médicos."

#. ~ Item name
#: data/mods/Aftershock/items/items.json
msgid "titanium implant"
msgid_plural "titanium implants"
msgstr[0] "implante de titanio"
msgstr[1] "implantes de titanio"
msgstr[2] "implantes de titanio"

#. ~ Description of "titanium implant"
#: data/mods/Aftershock/items/items.json
msgid ""
"An internal implant to correct a musculoskeletal problem such as a bad hip "
"or back.  It is made of titanium due to its biocompatibility."
msgstr ""
"Un implante interno para corregir problemas musculo esqueléticos como mala "
"cadera o espalda. Esta hecho de titanio por temas de evitar rechazo "
"biológico."

#. ~ Item name
#: data/mods/Aftershock/items/items.json
msgid "titanium tooth"
msgid_plural "titanium tooths"
msgstr[0] "diente de titanio"
msgstr[1] "dientes de titanio"
msgstr[2] "dientes de titanio"

#. ~ Description of "titanium tooth"
#: data/mods/Aftershock/items/items.json
msgid ""
"A dental implant made of pure titanium, used to replace teeth due to its "
"biocompatibility and durability."
msgstr ""
"Un implante dental de titanio puro, utilizado para sustituir dientes debido "
"a su biocompatibilidad y durabilidad."

#. ~ Item name
#: data/mods/Aftershock/items/items.json
msgid "titanium watch"
msgid_plural "titanium watches"
msgstr[0] "reloj de titanio"
msgstr[1] "relojes de titanio"
msgstr[2] "relojes de titanio"

#. ~ Description of "titanium watch"
#: data/mods/Aftershock/items/items.json
msgid ""
"A thick, masculine watch made out of titanium.  It is durable, light-weight "
"and water-resistant, an excellent watch to have in a hostile environment."
msgstr ""
"Un grueso y masculino reloj hecho de titanio. Es duradero, ligero y "
"resistente al agua, un excelente reloj para tener en un ambiente hostil."

#. ~ Item name
#: data/mods/Aftershock/items/items.json
