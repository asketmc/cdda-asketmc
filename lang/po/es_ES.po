"A harmonica with a holder, so that you can play it without a free hand."
msgstr ""
"Es una armónica con un soporte, así puedes tocarla y mantener tus manos "
"libres, como León Gieco."

#. ~ Item name
#: data/json/items/tool/musical_instruments.json
msgid "acoustic guitar"
msgid_plural "acoustic guitars"
msgstr[0] "guitarra acústica"
msgstr[1] "guitarras acústicas"
msgstr[2] "guitarras acústicas"

#. ~ Description of "acoustic guitar"
#: data/json/items/tool/musical_instruments.json
