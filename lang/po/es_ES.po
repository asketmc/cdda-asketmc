msgstr "Troglobita"

#. ~ "mutagen_message" of mutation class "Troglobite"
#: data/json/mutations/mutation_category.json
msgid "You yearn for a cool, dark place to hide."
msgstr "Anhelas un lugar fresco y oscuro donde esconderte."

#. ~ Memorial message of mutation class "Troglobite" for male
#: data/json/mutations/mutation_category.json
msgctxt "memorial_male"
msgid "Adapted to underground living."
msgstr "Adaptado a vivir bajo tierra."

#. ~ Memorial message of mutation class "Troglobite" for female
#: data/json/mutations/mutation_category.json
msgctxt "memorial_female"
msgid "Adapted to underground living."
msgstr "Adaptada a vivir bajo tierra."

#. ~ Mutation class name
#: data/json/mutations/mutation_category.json
msgid "Alpha"
msgstr "Alpha"

#. ~ "mutagen_message" of mutation class "Alpha"
#: data/json/mutations/mutation_category.json
msgid "You feel… better.  Somehow."
msgstr "Te sientes... mejor. De alguna manera."

#. ~ Memorial message of mutation class "Alpha" for male
#: data/json/mutations/mutation_category.json
msgctxt "memorial_male"
msgid "Started representing."
msgstr "Comenzaste a representar."

#. ~ Memorial message of mutation class "Alpha" for female
#: data/json/mutations/mutation_category.json
msgctxt "memorial_female"
msgid "Started representing."
msgstr "Comenzaste a representar."

#. ~ Mutation class name
#: data/json/mutations/mutation_category.json
msgid "Medical"
msgstr "Medicinal"

#. ~ "mutagen_message" of mutation class "Medical"
#: data/json/mutations/mutation_category.json
msgid ""
"You can feel the blood rushing through your veins and a strange, medicated "
"feeling washes over your senses."
msgstr ""
"Puedes sentir la sangre corriendo por tus venas y una extraña sensación de "
"estar medicado te inunda los sentidos."

#. ~ Memorial message of mutation class "Medical" for male
#: data/json/mutations/mutation_category.json
msgctxt "memorial_male"
msgid "Resumed clinical trials."
msgstr "Continuaste tus pruebas médicas."

#. ~ Memorial message of mutation class "Medical" for female
#: data/json/mutations/mutation_category.json
msgctxt "memorial_female"
msgid "Resumed clinical trials."
msgstr "Continuaste tus pruebas médicas."

#. ~ Mutation class name
#: data/json/mutations/mutation_category.json
msgid "Chimera"
msgstr "Quimera"

#. ~ "mutagen_message" of mutation class "Chimera"
#: data/json/mutations/mutation_category.json
msgid "You need to roar, bask, bite, and flap.  NOW."
msgstr "Necesitas rugir, tirarte al sol, morder, y aletear. YA."

#. ~ Memorial message of mutation class "Chimera" for male
#: data/json/mutations/mutation_category.json
msgctxt "memorial_male"
msgid "United disunity."
msgstr "Desunión unida."

#. ~ Memorial message of mutation class "Chimera" for female
#: data/json/mutations/mutation_category.json
msgctxt "memorial_female"
msgid "United disunity."
msgstr "Desunión unida."

#. ~ Mutation class name
#: data/json/mutations/mutation_category.json
msgid "Elf-A"
msgstr "Elf-A"

#. ~ "mutagen_message" of mutation class "Elf-A"
#: data/json/mutations/mutation_category.json
msgid "Everything goes green for a second.  Nature is becoming one with you…"
msgstr ""
"Todo se vuelve verde por un segundo. Te estás uniendo con la naturaleza…"

#. ~ Memorial message of mutation class "Elf-A" for male
#: data/json/mutations/mutation_category.json
msgctxt "memorial_male"
msgid "Accepted a more natural way of life."
msgstr "Aceptaste una forma de vida más natural."

#. ~ Memorial message of mutation class "Elf-A" for female
#: data/json/mutations/mutation_category.json
msgctxt "memorial_female"
msgid "Accepted a more natural way of life."
msgstr "Aceptaste una forma de vida más natural."

