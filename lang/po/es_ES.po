msgid_plural "blanching acorns"
msgstr[0] "bellota blanqueándose"
msgstr[1] "bellotas blanqueándose"
msgstr[2] "bellotas blanqueándose"

#. ~ Description of "blanching acorns"
#: data/json/items/comestibles/nuts.json
msgid ""
"A mix of water and hulled acorns, slowly leaching the tannins.  It'll take "
"about a week before they're palatable."
msgstr ""
"Una mezcla de agua y bellotas peladas blanqueando lentamente los taninos. "
"Puede tardar una semana antes de volverse agradable para comer."

#. ~ "msg" action message of item "blanching acorns"
#: data/json/items/comestibles/nuts.json
msgid ""
"After a week of changing water and taste-testing, the acorns are no longer "
"bitter and ready to decant."
msgstr ""
"Después de una semana cambiando el agua y probando las bellotas, ya no están"
" amargas y están listas para decantar."

#. ~ "not_ready_msg" action message of item "blanching acorns"
#: data/json/items/comestibles/nuts.json
msgid "The acorns are still bitter."
msgstr "Las bellotas todavía están amargas."

