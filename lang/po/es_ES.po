msgstr "Tus alas están inservibles y te limitan volar libremente."

#. ~ Name of effect type id "downed"
#: data/json/effects.json
msgid "Downed"
msgstr "Caído"

#. ~ Description of effect type "Downed"
#: data/json/effects.json
