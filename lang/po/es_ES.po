#. ~ Description of vehicle part "wheel hub assembly"
#: data/json/vehicleparts/wheel.json
msgid ""
"Connection where wheels can be connected on.  This particular one is fit for"
" normal car wheels."
msgstr ""
"Conexión en la que se pueden conectar las ruedas. Esta en particular es "
"adecuada para las ruedas de los coches normales."

#. ~ Vehicle part name
#: data/json/vehicleparts/wheel.json
msgid "wheel hub assembly (steerable)"
msgstr "ensamblaje de bujes de la rueda (orientable)"

#. ~ Description of vehicle part "heavy wheel hub assembly"
#: data/json/vehicleparts/wheel.json
