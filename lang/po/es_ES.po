msgstr "cepillo."

#. ~ Description of terrain "underbrush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"Small plants and shrubs that decorate the forest.  It has been rummaged "
"through and doesn't have anything useful left to forage from it."
msgstr ""
"Pequeñas plantas y arbustos que decoran el bosque. Ha sido escarbado y no "
"queda nada útil que buscar en él."

#. ~ Description of terrain "underbrush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"Small plants and shrubs that decorate the forest.  It has been rummaged "
"through and doesn't have anything useful left to forage from it.  Frost "
"covers it."
msgstr ""
"Pequeñas plantas y arbustos que decoran el bosque. Ha sido escarbado y no "
"queda nada útil que buscar en él. La escarcha lo cubre."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "shrub"
msgstr "arbusto"

#. ~ Description of terrain "shrub"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small shrub."
msgstr "Un pequeño arbusto."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "peanut bush"
msgstr "arbusto de cacahuete"

#. ~ Description of terrain "peanut bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small bush of crunchy peanuts."
msgstr "Es un pequeño arbusto de crujientes cacahuetes."

#. ~ Description of terrain "peanut bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small peanut bush that's fruitless."
msgstr "Un pequeño arbusto de cacahuetes sin cacahuetes"

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "blueberry bush"
msgstr "arbusto de arándanos"

#. ~ Description of terrain "blueberry bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small bush of sweet blueberries."
msgstr "Un pequeño arbusto de arándanos dulces."

#. ~ Description of terrain "blueberry bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small blueberry bush that's fruitless."
msgstr "Un pequeño arbusto de arándanos que sin frutos."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "strawberry bush"
msgstr "arbusto de fresas"

#. ~ Description of terrain "strawberry bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small bush of juicy strawberries."
msgstr "Un pequeño arbusto de fresas jugosas."

#. ~ Description of terrain "strawberry bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small strawberry bush that's fruitless."
msgstr "Un pequeño arbusto de fresas vacío."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "blackberry bush"
msgstr "arbusto de zarzamoras"

#. ~ Description of terrain "blackberry bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small bush of delicious blackberries.  Watch out for its thorns!"
msgstr ""
"Es un pequeño arbusto de deliciosas zarzamoras. Ten cuidado con las espinas."

#. ~ Description of terrain "blackberry bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small blackberry bush that's fruitless.  Watch out for its thorns!"
msgstr ""
"Es un pequeño arbusto de zarzamoras sin frutos. Ten cuidado con las espinas."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "huckleberry bush"
msgstr "arbusto de arándanos agrios"

#. ~ Description of terrain "huckleberry bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small bush of huckleberries, often mistaken as blueberries."
msgstr ""
"Un pequeño arbusto de arándanos de ciervo, a menudo confundido con los "
"arándanos.Un pequeño arbusto de arándanos de ciervo, a menudo confundido con"
" los arándanos."

#. ~ Description of terrain "huckleberry bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small huckleberry bush that's fruitless."
msgstr "Un pequeño arbusto de arándanos agrios sin frutos."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "raspberry bush"
msgstr "arbusto de frambuesas"

#. ~ Description of terrain "raspberry bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small bush of delicious raspberries.  Watch out for its thorns!"
msgstr ""
"Es un pequeño arbusto de deliciosas frambuesas. Ten cuidado con las espinas."

#. ~ Description of terrain "raspberry bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small raspberry bush that's fruitless.  Watch out for its thorns!"
msgstr ""
"Un pequeño arbusto de frambuesas sin frutos. ¡Cuidado con sus espinas!"

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "grape bush"
msgstr "arbusto de uvas"

#. ~ Description of terrain "grape bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A bush of a different species invaded by vines of grapes."
msgstr "Un arbusto de una especie diferente invadido por vides de uva."

#. ~ Description of terrain "grape bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A bush of a different species invaded by grape vines but they're fruitless."
msgstr ""
"Es un arbusto de diferente especie invadido por la vid de la uva pero sin "
"frutos."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "rose bush"
msgstr "rosal"

#. ~ Description of terrain "rose bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A fat bush of beautiful red roses, if only you could get a date!  Watch out "
"for its thorns!"
msgstr ""
"Un arbusto gordo de hermosas rosas rojas, ¡si tan sólo pudieras conseguir "
"una cita! ¡Cuidado con sus espinas!"

#. ~ Description of terrain "rose bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A fat rose bush that currently has no blooms.  Watch out for its thorns!"
msgstr ""
"Un rosal gordo que actualmente no tiene flores. ¡Cuidado con sus espinas!"

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "hydrangea bush"
msgstr "arbusto de hortensia"

#. ~ Description of terrain "hydrangea bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A dense bush of fragrant blue hydrangeas."
msgstr "Un denso arbusto de fragantes hortensias azules."

#. ~ Description of terrain "hydrangea bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A fat hydrangea bush that currently has no blooms."
msgstr "Es un arbusto gordo de hortensias pero sin flores."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "lilac bush"
msgstr "arbusto de lilas"

#. ~ Description of terrain "lilac bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A wide bush of bright pinkish purple lilacs."
msgstr "Una amplia zarza de lilas de color rosado brillante."

#. ~ Description of terrain "lilac bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A wide lilac bush that currently has no blooms."
msgstr "Es un arbusto ancho de lilas pero sin flores."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "tree trunk"
msgstr "Tronco"

#. ~ Description of terrain "tree trunk"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A section of trunk from a tree that has been cut down.  Can be sawn into "
"logs with the right tool."
msgstr ""
"Una sección del tronco de un árbol que ha sido cortado. Puede ser serrado en"
" leños con la herramienta adecuada."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "tree stump"
msgstr "tocón"

#. ~ Description of terrain "tree stump"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A tree stump, remnant of a tree that has been cut down."
msgstr "Un tocón de árbol, remanente de un árbol que ha sido cortado."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "woodchips"
msgstr "astillas de madera"

#. ~ Description of terrain "woodchips"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"Small splinters of wood laid out in a layer to prevent unwanted plants from "
"growing."
msgstr ""
"Pequeñas astillas de madera tiradas formando una capa para evitar que "
"crezcan plantas no deseadas."

#. ~ Terrain name
#. ~ Item name
#: data/json/furniture_and_terrain/terrain-flora.json
#: data/json/items/comestibles/other.json
msgid "grass"
msgid_plural "grasses"
msgstr[0] "hierba"
msgstr[1] "hierbas"
msgstr[2] "hierbas"

#. ~ Description of terrain "grass"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"An area of hardy Kentucky bluegrass about ankle high.  Cutting the grass "
"short enough would destroy the root system, causing this area to turn into a"
" patch of dirt."
msgstr ""
"Un área de resistente hierba azul de Kentucky a la altura del tobillo. "
"Cortar la hierba lo suficientemente corta destruiría el sistema de raíces, "
"causando que esta área se convierta en un parche de tierra."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "white grass"
msgstr "hierba blanca"

#. ~ Description of terrain "white grass"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A section of Kentucky bluegrass covered in white latex-based paint, with "
"neat lines designed for recreational sports."
msgstr ""
"Una sección de hierba azul de Kentucky cubierta de pintura a base de látex "
"blanco, con líneas limpias diseñadas para deportes recreativos."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "long grass"
msgstr "hierba crecida"

#. ~ Description of terrain "long grass"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "Long shaggy grass about shin high."
msgstr "Hierba larga y peluda que te llega sobre la espinilla."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "tall grass"
msgstr "hierba alta"

#. ~ Description of terrain "tall grass"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "Tall grass about head high."
msgstr "Hierba alta a la altura de la cabeza."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "dead grass"
msgstr "hierba muerta"

#. ~ Description of terrain "dead grass"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "Long shaggy grass that hasn't been cut recently."
msgstr "Larga hierba espesa que no ha sido cortada recientemente."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "golf green"
msgstr "verde golf."

#. ~ Description of terrain "golf green"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "Grass mowed very short and neat."
msgstr "Hierba cortada muy corta y cuidada."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "alien grass"
msgstr "hierba alienígena"

#. ~ Description of terrain "alien grass"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"An area of something that almost looks like grass.  The blades are serrated "
"and move on their own."
msgstr ""
"Una zona de algo que casi parece hierba. Las hojas son dentadas y se mueven "
"solas."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "golf hole"
msgstr "hoyo de golf"

#. ~ Description of terrain "golf hole"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small plastic cup embedded in the grass."
msgstr "Un pequeño vaso de plástico incrustado en la hierba."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "young bamboo shoots"
msgstr "brotes jóvenes de bambú"

#. ~ Description of terrain "young bamboo shoots"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"An area of young bamboo shoots about ankle high.  Many shoots are just "
"barely pushing above the ground."
msgstr ""
"Un área de brotes jóvenes de bambú a la altura de los tobillos. Muchos "
"brotes apenas sobresalen del suelo."

#. ~ Description of terrain "young bamboo shoots"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"An area of young bamboo shoots about ankle high.  The smallest shoots have "
"already been harvested."
msgstr ""
"Una zona de brotes jóvenes de bambú de una altura aproximada de un tobillo. "
"Los brotes más pequeños ya han sido cosechados."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "long bamboo shoots"
msgstr "brotes largos de bambú"

#. ~ Description of terrain "long bamboo shoots"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "Long bamboo shoots about shin high."
msgstr "Brotes largos de bambú de una altura aproximada de una espinilla."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "tall bamboo"
msgstr "bambú alto"

#. ~ Description of terrain "tall bamboo"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "Tall bamboo thicket about head high."
msgstr "Un matorral alto de bambú a la altura de la cabeza."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "dead bamboo"
msgstr "bambú muerto"

#. ~ Description of terrain "dead bamboo"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "Long brown dead bamboo shoots covered in white fungus."
msgstr ""
"Largos brotes de bambú muertos de color marrón cubiertos de hongos blancos."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "fern"
msgstr "helecho"

#. ~ Description of terrain "fern"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A short plant with thousands of leaves which grow in a fractal pattern from "
"the stem."
msgstr ""
"Una planta corta con miles de hojas que crecen en un patrón fractal desde el"
" tallo."

#. ~ Description of terrain "fern"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A short plant with thousands leaves which grow in a fractal pattern, without"
" any curled shoots."
msgstr ""
"Una planta corta con miles de hojas que crecen en un patrón fractal, sin "
"ningún brote enroscado."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-fungal.json
#: data/mods/No_Fungi/terrain.json
msgid "Marloss bush"
msgstr "Arbusto de Marloss"

#. ~ Description of terrain "Marloss bush"
#: data/json/furniture_and_terrain/terrain-fungal.json
msgid ""
"This alien plant superficially resembles a blueberry bush, and hangs with "
"large, juicy pink pomes that emit a heady, fruity aroma."
msgstr ""
"Esta planta alienígena se parece superficialmente a un arbusto de arándanos,"
" y cuelga con grandes y jugosas cúpulas rosadas que emiten un aroma "
"embriagador y frutal."

