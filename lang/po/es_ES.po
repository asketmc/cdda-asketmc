#: data/json/effects.json
msgid "Your artificial senses are scrambled and report false readings."
msgstr "Tus sentidos artificiales están mezclados y reportan lecturas falsas."

#. ~ Name of effect type id "dazed"
#: data/json/effects.json
msgid "Dazed"
msgstr "Aturdido"

#. ~ Description of effect type "Dazed"
#: data/json/effects.json
msgid ""
"You're visibly shaken up, and are having a hard time focusing on what's "
"going on around you."
msgstr ""
"Estás visiblemente aturdido, y te cuesta concentrarte en lo que sucede a tu "
"alrededor."

#. ~ Apply message of effect type "Dazed"
#: data/json/effects.json
msgid "The scream dazes you!"
msgstr "¡El grito te deja aturdido!"

#. ~ Name of effect type id "riding"
#: data/json/effects.json
msgid "Riding"
msgstr "Montando"

#. ~ Description of effect type "Riding"
#: data/json/effects.json
msgid "You are riding an animal."
msgstr "Tu estas montando un animal"

#. ~ Apply message of effect type "Riding"
#: data/json/effects.json
msgid "You mount your steed."
msgstr "Montas tu corcel."

#. ~ Name of effect type id "onfire"
#. ~ Buff name of martial art "Debug Mastery"
#: data/json/effects.json data/json/martialarts.json
msgid "On Fire"
msgstr "En LLamas"

#. ~ Description of effect type "On Fire"
#: data/json/effects.json
msgid ""
"Loss of health - Entire Body\n"
"Your clothing and other equipment may be consumed by the flames."
msgstr ""
"Pérdida de vida - Cuerpo Entero\n"
"Tu ropa y otro equipamiento puede ser consumido por las llamas."

#. ~ Apply message of effect type "On Fire"
#: data/json/effects.json
msgid "You're on fire!  Wait in place to attempt to put out the fire."
msgstr "¡Estás prendido fuego! Quedate quieto para intentar apagar el fuego."

#. ~ Male memorial apply log of effect type "On Fire"
#: data/json/effects.json
msgctxt "memorial_male"
msgid "Caught on fire."
msgstr "Prendido fuego."

#. ~ Female memorial apply log of effect type "On Fire"
#: data/json/effects.json
msgctxt "memorial_female"
msgid "Caught on fire."
msgstr "Prendida fuego."

#. ~ Male memorial remove log of effect type "On Fire"
#: data/json/effects.json
msgctxt "memorial_male"
msgid "Put out the fire."
msgstr "Apagar el fuego."

#. ~ Female memorial remove log of effect type "On Fire"
#: data/json/effects.json
msgctxt "memorial_female"
msgid "Put out the fire."
msgstr "Apagar el fuego."

#. ~ Name of effect type id "bouldering"
#: data/json/effects.json
msgid "Unstable Footing"
msgstr "Suelo Inestable"

#. ~ Description of effect type "Unstable Footing"
#: data/json/effects.json
msgid ""
"Your footing is unstable.  It's more difficult to fight while standing here."
msgstr ""
"Tu punto de apoyo no es estable. Es más difícil luchar mientras estás parado"
" aquí."

#. ~ Apply message of effect type "Unstable Footing"
#: data/json/effects.json
msgid "You try to keep your balance."
msgstr "Intentas mantener tu equilibrio."

#. ~ Name of effect type id "blind"
#: data/json/effects.json data/mods/desert_region/weather/fd_dust.json
msgid "Blind"
msgstr "Ciego"

