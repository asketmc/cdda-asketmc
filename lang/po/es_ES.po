#: data/json/hobbies.json
msgctxt "profession_male"
msgid "Pottery"
msgstr "Alfarero"

#. ~ Description of profession "Pottery" for male
#: data/json/hobbies.json
msgctxt "prof_desc_male"
msgid ""
"You're a master of throwing on the potter's wheel, able to shape clay into "
