#. ~ Profession name for male
#: data/json/hobbies.json
msgctxt "profession_male"
msgid "Marathon Running"
msgstr "Corredor de Maratón"

#. ~ Description of profession "Marathon Running" for male
#: data/json/hobbies.json
msgctxt "prof_desc_male"
msgid ""
"You ran the Boston Marathon every year.  That conditioning should make you "
"better equipped than most in avoiding the dead."
msgstr ""
"Corríañ la maratón de Boston cada año. Ese condicionamiento debería hacer "
"que estés mejor equipado que la mayoría para evitar a los muertos."

#. ~ Profession name for female
#: data/json/hobbies.json
