msgid_plural "noise canceling headgears"
msgstr[0] "casco anti-ruido"
msgstr[1] "cascos anti-ruido"
msgstr[2] "cascos anti-ruido"

#. ~ Description of "noise canceling headgear"
#: data/json/items/armor/hats.json
msgid ""
"Padding over your ears, kept in place by some string.  Blocks incoming "
"sounds."
msgstr ""
"Acolchado sobre las orejas, mantenido en su sitio por una cuerda. Bloquea "
"los sonidos entrantes."

#. ~ Head encumbrance stops you from wearing additional headgear.  No helmet
#. over a sombrero, sorry.  But brimmed gear gets the anti-glare flag!
#. ~ Item name
#: data/json/items/armor/hats.json
msgid "sombrero"
msgid_plural "sombreros"
msgstr[0] "sombrero mejicano"
msgstr[1] "sombreros mejicanos"
msgstr[2] "sombreros mejicanos"

#. ~ Head encumbrance stops you from wearing additional headgear.  No helmet
#. over a sombrero, sorry.  But brimmed gear gets the anti-glare flag!
#. ~ Description of "sombrero"
#: data/json/items/armor/hats.json
msgid ""
"An orange felt sombrero with traditional white and yellow hand stitching.  "
"The wide brim keeps the sun out of your eyes, and a thin strap hooks around "
"your chin."
msgstr ""
"Un sombrero de fieltro naranja con las tradicionales costuras blancas y "
"amarillas a mano. El borde ancho mantiene el sol lejos de los ojos, y una "
"fina correa se engancha alrededor de la barbilla."

#. ~ Item name
#: data/json/items/armor/hats.json
msgid "kippah"
msgid_plural "kippahs"
msgstr[0] "kipá"
msgstr[1] "kipás"
msgstr[2] "kipás"

#. ~ Description of "kippah"
#: data/json/items/armor/hats.json
msgid "A thin, rounded skullcap.  A traditional headdress in Judaism."
msgstr "Un gorro redondo y fino. Un tocado tradicional del judaismo."

#. ~ Item name
#: data/json/items/armor/hats.json
msgid "kufi cap"
msgid_plural "kufi caps"
msgstr[0] "gorra kufi"
msgstr[1] "gorras kufi"
msgstr[2] "gorras kufi"

#. ~ Description of "kufi cap"
#: data/json/items/armor/hats.json
msgid "A brimless, short and rounded cap."
msgstr "Una gorra corta y redonda, sin ala."

#. ~ Item name
#: data/json/items/armor/hats.json
msgid "French maid hat"
msgid_plural "French maid hats"
msgstr[0] "cinta de sirvienta francesa"
msgstr[1] "cintas de sirvienta francesa"
msgstr[2] "cintas de sirvienta francesa"

#. ~ Description of "French maid hat"
#: data/json/items/armor/hats.json
msgid "A frilly white headpiece."
msgstr "Un tocado blanco con volantes."

#. ~ Item name
#: data/json/items/armor/hats.json
msgid "porkpie hat"
msgid_plural "porkpie hats"
msgstr[0] "sombrero pastel de cerdo"
msgstr[1] "sombreros pasteles de cerdo"
msgstr[2] "sombreros pasteles de cerdo"

#. ~ Description of "porkpie hat"
#: data/json/items/armor/hats.json
msgid ""
"A flat-topped hat with circular indent and a narrow brim.  Most popular in "
"the 40s and 50s, still common among those in the mod scene, hipsters, and "
"people named Heisenberg."
msgstr ""
"Un sombrero plano con ala angosta y circular. Muy popular en la decada del "
"40 y del 50, todavía es usado en el ámbito de la moda, por los hipsters, y "
"por las personas apellidadas Heisenberg."

#. ~ Item name
#: data/json/items/armor/hats.json
msgid "mail carrier hat"
msgid_plural "mail carrier hats"
msgstr[0] "gorra de cartero"
msgstr[1] "gorras de cartero"
msgstr[2] "gorras de cartero"

#. ~ Description of "mail carrier hat"
#: data/json/items/armor/hats.json
msgid ""
"A traditional mail carrier's cap, with the US postal service logo "
"embroidered on the front above the plastic brim.  A symbol of a bygone "
"world."
msgstr ""
"Una gorra tradicional de cartero, con el logotipo del servicio postal de "
"EE.UU. bordado en la parte delantera por encima del borde de plástico. Un "
"símbolo de un mundo pasado."

#. ~ Item name
#: data/json/items/armor/hats.json
msgid "santa hat"
msgid_plural "santa hats"
msgstr[0] "sombrero de santa"
msgstr[1] "sombreros de santa"
msgstr[2] "sombreros de santa"

#. ~ Description of "santa hat"
#: data/json/items/armor/hats.json
msgid ""
"A red hat with white faux fur trim, commonly used by bearded men on "
"Christmas."
msgstr ""
"Un gorro rojo con adornos de piel sintética blanca, comúnmente utilizado por"
" los hombres con barba en Navidad."

#. ~ Item name
#: data/json/items/armor/hats.json
msgid "straw hat"
msgid_plural "straw hats"
msgstr[0] "sombrero de paja"
msgstr[1] "sombreros de paja"
msgstr[2] "sombreros de paja"

#. ~ Description of "straw hat"
#: data/json/items/armor/hats.json
msgid ""
"A hat woven out of straw.  Its brim helps keep the sun out of your eyes."
msgstr ""
"Un sombrero tejido de paja. Su contorno ayuda a mantener el sol alejado de "
"los ojos."

#. ~ Item name
#: data/json/items/armor/hats.json
msgid "tinfoil hat"
msgid_plural "tinfoil hats"
msgstr[0] "sombrero de papel de aluminio"
msgstr[1] "sombreros de papel de aluminio"
msgstr[2] "sombreros de papel de aluminio"

#. ~ Description of "tinfoil hat"
#: data/json/items/armor/hats.json
msgid ""
"A sheet of aluminum foil that has been molded into a form-fitting hat.  "
"Perfect for protecting yourself from the government, Illuminati, aliens, and"
" THEM."
msgstr ""
"Una hoja de papel de aluminio que ha sido moldeada para tener forma de "
"sombrero. Perfecto para protegerte del gobierno, los Illuminati, los "
"extraterrestres y de ELLOS."

#. ~ No, you're not wearing anything over your top hat.
#. ~ Item name
#: data/json/items/armor/hats.json
msgid "top hat"
msgid_plural "top hats"
msgstr[0] "sombrero de copa alta"
msgstr[1] "sombreros de copa alta"
msgstr[2] "sombreros de copa alta"

#. ~ No, you're not wearing anything over your top hat.
#. ~ Description of "top hat"
#: data/json/items/armor/hats.json
msgid ""
"The only hat for a gentleman.  Look exquisite while laughing in the face of "
"danger!"
msgstr ""
"El único sombrero para un caballero. !Exquisito mientras te ries en la cara "
"del peligro!"

#. ~ Item name
#: data/json/items/armor/hats.json
msgid "tricorne"
msgid_plural "tricornes"
msgstr[0] "tricornio"
msgstr[1] "tricornios"
msgstr[2] "tricornios"

#. ~ Description of "tricorne"
#: data/json/items/armor/hats.json
msgid ""
"A classic design, the \"tricorne\", or three-cornered hat, simply pins a "
"large and floppy brim out of the way, though this example adds well-"
"embroidered designs and is oiled against water.  Whether you're the "
"\"guvnah\" of a settlement, or the captain of a post-apocalyptic crew, this "
"is the hat for you."
msgstr ""
"Un diseño clásico, el \"tricornio\", o sombrero de tres picos, simplemente "
"sujeta un ala grande y flexible fuera del camino, aunque este ejemplo añade "
"diseños bien bordados y está aceitado contra el agua. Tanto si eres el "
"\"guvnah\" de un asentamiento, como el capitán de una tripulación "
"postapocalíptica, éste es el sombrero para ti."

#. ~ Item name
#: data/json/items/armor/hats.json
msgid "turban"
msgid_plural "turbans"
msgstr[0] "turbante"
msgstr[1] "turbantes"
msgstr[2] "turbantes"

#. ~ Description of "turban"
#: data/json/items/armor/hats.json
msgid ""
"Cloth wound around the head, worn by people of many cultures worldwide.  "
"Some historical examples could be huge and ostentatious, but this one is a "
"very simple design."
msgstr ""
"Una tela que se enrolla alrededor de la cabeza, usada por personas de muchas"
" culturas en todo el mundo. Algunos ejemplares históricos podían ser enormes"
" y ostentosos, pero este es un diseño muy sencillo."

#. ~ Head encumbrance stops you from wearing additional headgear.  No helmet
#. over a ballcap, sorry.  But brimmed gear gets the anti-glare flag!
#. ~ Item name
#: data/json/items/armor/hats.json
msgid "golf cap"
msgid_plural "golf caps"
msgstr[0] "gorra de golf"
msgstr[1] "gorras de golf"
msgstr[2] "gorras de golf"

#. ~ Head encumbrance stops you from wearing additional headgear.  No helmet
#. over a ballcap, sorry.  But brimmed gear gets the anti-glare flag!
#. ~ Description of "golf cap"
#: data/json/items/armor/hats.json
msgid ""
"You're not actually sure if this is called a golf cap, but it's the "
"stereotypical cap golfers wear."
msgstr ""
"No estás seguro de si esto se llama gorra de golf, pero es el estereotipo de"
" gorra que usan los golfistas."

#. ~ Item name
#: data/json/items/armor/hats.json data/mods/Magiclysm/items/enchanted.json
msgid "wizard hat"
msgid_plural "wizard hats"
msgstr[0] "sombrero de mago"
msgstr[1] "sombreros de mago"
msgstr[2] "sombreros de mago"

#. ~ Description of "wizard hat"
#: data/json/items/armor/hats.json
msgid ""
"A blue pointed hat with stars stitched into it.  Wearing it makes you feel "
"like a powerful wizard."
msgstr ""
"Un sombrero azul puntiagudo con estrellas cosidas. Al llevarlo te sientes "
"como un poderoso mago."

#. ~ Item name
#: data/json/items/armor/hats.json
msgid "pointed hat"
msgid_plural "pointed hats"
msgstr[0] "sombrero puntiagudo"
msgstr[1] "sombreros puntiagudos"
msgstr[2] "sombreros puntiagudos"

#. ~ Description of "pointed hat"
#: data/json/items/armor/hats.json
msgid "A black pointed hat suitable for a witch."
msgstr "Un sombrero negro puntiagudo propio de una bruja."

#. ~ Item name
#: data/json/items/armor/head_attachments.json
msgid "attachable ear muffs"
msgid_plural "attachable ear muffs"
msgstr[0] "orejera acoplable"
msgstr[1] "orejeras acoplables"
msgstr[2] "orejeras acoplables"

#. ~ Description of "attachable ear muffs"
#: data/json/items/armor/head_attachments.json
msgid ""
"A pair of ear muffs attachable to a hard hat or helmet to reduce noise "
"exposures to safe levels.  Activate to put ear muffs into a working "
"position, blocking most sounds."
msgstr ""
"Un par de orejeras que se pueden acoplar a un casco o una gorra para reducir"
" la exposición al ruido a niveles seguros. Se activan para poner las "
"orejeras en posición de trabajo, bloqueando la mayoría de los sonidos."

#. ~ "menu_text" action message of item "attachable ear muffs"
#: data/json/items/armor/head_attachments.json
msgid "Press tightly to ears"
msgstr "Apretar bien las orejeras"

#. ~ "msg" action message of item "attachable ear muffs"
#: data/json/items/armor/head_attachments.json
msgid "You put the ear muffs tightly to your ears."
msgstr "Te pones las orejeras bien pegadas a tus oídos."

#. ~ Item name
#: data/json/items/armor/head_attachments.json
msgid "attachable ear muffs (on)"
msgid_plural "attachable ear muffs (on)"
msgstr[0] "orejera acoplable (encendida)"
msgstr[1] "orejeras acoplables (encendidas)"
msgstr[2] "orejeras acoplables (encendidas)"

#. ~ Description of "attachable ear muffs (on)"
#: data/json/items/armor/head_attachments.json
msgid ""
"A pair of ear muffs attachable to a hard hat or helmet to reduce noise "
"exposures to safe levels.  Activate to put ear muffs into a standby "
"position, letting you clearly hear again."
msgstr ""
"Un par de orejeras que se pueden acoplar a un casco o una gorra para reducir"
" la exposición al ruido a niveles seguros. Se activan para poner las "
"orejeras en posición de espera, lo que permite volver a oír con claridad."

#. ~ "menu_text" action message of item "attachable ear muffs (on)"
#: data/json/items/armor/head_attachments.json
msgid "Put away from ears"
msgstr "Alejar de los oídos"

#. ~ "msg" action message of item "attachable ear muffs (on)"
#: data/json/items/armor/head_attachments.json
msgid "You put the ear muffs away from your ears."
msgstr "Pones las orejeras lejos de tus oídos."

#. ~ Item name
#: data/json/items/armor/head_attachments.json
msgid "ballistic mandible guard"
msgid_plural "ballistic mandible guard"
msgstr[0] "protector mandibular balístico"
msgstr[1] "protectores mandibulares balísticos"
msgstr[2] "protectores mandibulares balísticos"

#. ~ Description of "ballistic mandible guard"
#: data/json/items/armor/head_attachments.json
msgid ""
"A ballistic jaw guard designed to be attached on a military helmet, but "
"easily adjustable to helmets with any kind of rail system installed."
msgstr ""
"Un protector balístico de mandíbula diseñado para ser fijado en un casco "
"militar, pero fácilmente ajustable a cascos con cualquier tipo de sistema de"
" raíles instalado."

#. ~ Item name
#: data/json/items/armor/head_attachments.json
msgid "plastic mandible guard"
msgid_plural "plastic mandible guard"
msgstr[0] "protector mandibular de plástico"
msgstr[1] "protectores mandibulares de plástico"
msgstr[2] "protectores mandibulares de plástico"

#. ~ Description of "plastic mandible guard"
#: data/json/items/armor/head_attachments.json
msgid ""
"A plastic jaw guard designed to be strapped to any common hard hat or "
"helmet, it was probably part of some costume before the world ended."
msgstr ""
"Un protector mandibular de plástico diseñado para ser atado a cualquier "
"casco o casco duro común, probablemente formaba parte de algún disfraz antes"
" de que se acabara el mundo."

#. ~ Item name
#: data/json/items/armor/head_attachments.json
msgid "plastic chin guard"
msgid_plural "plastic chin guard"
msgstr[0] "mentonera de plástico"
msgstr[1] "mentoneras de plástico"
msgstr[2] "mentoneras de plástico"

#. ~ Description of "plastic chin guard"
#: data/json/items/armor/head_attachments.json
msgid ""
"A common plastic chin guard designed to be attached to the straps of any "
"common hard hat or helmet."
msgstr ""
"Un protector de barbilla plástico diseñado para fijarse a las correas de "
"cualquier casco o casco duro común."

#. ~ Item name
#: data/json/items/armor/head_attachments.json
msgid "counterweight pouch"
msgid_plural "counterweight pouch"
msgstr[0] "funda de contrapeso"
msgstr[1] "fundas de contrapeso"
msgstr[2] "fundas de contrapeso"

#. ~ Description of "counterweight pouch"
#: data/json/items/armor/head_attachments.json
msgid ""
"A counterweight pouch attachable to the back of a hard hat or helmet to "
"balance the weight on your head.  You can store batteries or some other very"
" small items in it."
msgstr ""
"Una funda de contrapeso que se puede colocar en la parte posterior del casco"
" para equilibrar el peso en la cabeza. En ella se pueden guardar baterías o "
"algunos otros objetos muy pequeños."

#. ~ Item name
#: data/json/items/armor/head_attachments.json
msgid "sun shield"
msgid_plural "sun shields"
msgstr[0] "escudo solar"
msgstr[1] "escudos solares"
msgstr[2] "escudos solares"

#. ~ Description of "sun shield"
#: data/json/items/armor/head_attachments.json
msgid ""
"A common sun shield intended to be put over a hard hat to protect the user "
"from the sun."
msgstr ""
"Un protector solar común destinado a ser colocado sobre un casco para "
"proteger al usuario del sol."

#. ~ Item name
#: data/json/items/armor/head_attachments.json
msgid "shield visor"
msgid_plural "shield visors"
msgstr[0] "visera protectora"
msgstr[1] "viseras protectoras"
msgstr[2] "viseras protectoras"

#. ~ Description of "shield visor"
#: data/json/items/armor/head_attachments.json
msgid "A common shield visor intended to be attached on a hard hat or helmet."
msgstr "Un visor común destinado a ser colocado en un casco o casco duro."

#. ~ Item name
#: data/json/items/armor/head_attachments.json
msgid "face shield"
msgid_plural "face shields"
msgstr[0] "protector facial"
msgstr[1] "protectores faciales"
msgstr[2] "protectores faciales"

#. ~ Description of "face shield"
#: data/json/items/armor/head_attachments.json
msgid ""
"A thermoplastic face shield with a mounting bracket intended to be attached "
"over a hard hat or helmet."
msgstr ""
"Una pantalla facial termoplástica con un soporte de montaje destinado a ser "
"fijado sobre un casco o casco duro."

#. ~ Item name
#: data/json/items/armor/head_attachments.json
msgid "plastic face shield"
msgid_plural "plastic face shields"
msgstr[0] "protector facial de plástico"
msgstr[1] "protectores faciales de plástico"
msgstr[2] "protectores faciales de plástico"

#. ~ Description of "plastic face shield"
#: data/json/items/armor/head_attachments.json
msgid ""
"A plastic face shield with a mounting bracket intended to be attached over a"
" hard hat or helmet.  It doesn't protects you as much as one made from "
"thermoplastic, but it's cheaper and more common."
msgstr ""
"Es un protector facial de plástico con un soporte de montaje destinado a ser"
" colocado sobre un casco o casco duro. No te protege tanto como uno hecho de"
" termoplástico, pero es más barato y más común."

#. ~ Item name
#: data/json/items/armor/head_attachments.json
msgid "nape protector"
msgid_plural "nape protectors"
msgstr[0] "protector de nuca"
msgstr[1] "protectores de nuca"
msgstr[2] "protectores de nuca"

#. ~ Description of "nape protector"
#: data/json/items/armor/head_attachments.json
msgid ""
"A common nape protector intended to be attached on a hard hat or helmet to "
"protect against the sun and dust."
msgstr ""
"Un protector de nuca común destinado a ser colocado en un casco o casco duro"
" para proteger del sol y del polvo."

#. ~ Item name
#: data/json/items/armor/head_attachments.json
msgid "mesh nape protector"
msgid_plural "mesh nape protectors"
msgstr[0] "protector de nuca de malla"
msgstr[1] "protectores de nuca de malla"
msgstr[2] "protectores de nuca de malla"

#. ~ Description of "mesh nape protector"
#: data/json/items/armor/head_attachments.json
msgid ""
"A common mesh nape protector intended to be attached on a hard hat or helmet"
" to protect against the sun while letting the cold wind refresh your nape."
msgstr ""
"Un protector de nuca de malla común destinado a ser colocado en un casco o "
"casco duro para proteger del sol mientras deja que el viento frío refresque "
"su nuca."

#. ~ Item name
#: data/json/items/armor/head_attachments.json
msgid "Kevlar nape protector"
msgid_plural "Kevlar nape protectors"
msgstr[0] "protector de nuca de Kevlar"
msgstr[1] "protectores de nuca de Kevlar"
msgstr[2] "protectores de nuca de Kevlar"

#. ~ Description of "Kevlar nape protector"
#: data/json/items/armor/head_attachments.json
msgid ""
"A custom-made Kevlar strengthened nape protector intended to be attached on "
"a hard hat or helmet to protect your nape against cuts and slashing attacks."
msgstr ""
"Un protector de nuca reforzado con Kevlar, hecho a medida, destinado a ser "
"colocado en un casco o casco duro para proteger la nuca contra cortes y "
"ataques."

#. ~ Item name
#: data/json/items/armor/helmets.json
msgid "pot helmet"
msgid_plural "pot helmets"
msgstr[0] "casco de olla"
msgstr[1] "cascos de olla"
msgstr[2] "cascos de olla"

#. ~ Description of "pot helmet"
#. ~ Description of "XS pot helmet"
#: data/json/items/armor/helmets.json
msgid ""
"A helmet made from a soup pot.  It's not very good protection, but it's "
"better than nothing."
msgstr ""
"Un casco hecho con una olla para sopa. No protege mucho que digamos, pero es"
" mejor que nada."

#. ~ Item name
#: data/json/items/armor/helmets.json
msgid "pot great helm"
msgid_plural "pot great helms"
msgstr[0] "gran yelmo"
msgstr[1] "gran yelmo"
msgstr[2] "gran yelmo"

#. ~ Description of "pot great helm"
#: data/json/items/armor/helmets.json
msgid ""
"An enclosed helmet made from a stock pot with a 'T' crudely carved into the "
"front and a blanket stuffed inside to cushion it.  There are strings tied to"
" the handles to help fasten it to your body, but it's extremely limiting and"
" smothering."
msgstr ""
"Se trata de un casco cerrado hecho de una olla con una \"T\" burdamente "
"tallada en la parte delantera y una manta rellena en su interior para "
"amortiguarlo. Hay cuerdas atadas a las asas para ayudar a sujetarlo a tu "
"cuerpo, pero es extremadamente limitante y asfixiante."

#. ~ Item name
#: data/json/items/armor/helmets.json
msgid "headgear"
msgid_plural "headgears"
msgstr[0] "casco de boxeo"
msgstr[1] "casco de boxeo"
msgstr[2] "casco de boxeo"

#. ~ Description of "headgear"
#: data/json/items/armor/helmets.json
msgid ""
"Lightweight sports headgear designed to protect the head while sparring."
msgstr ""
"Casco deportivo ligero diseñado para proteger la cabeza durante el combate."

#. ~ Item name
#: data/json/items/armor/helmets.json
msgid "army helmet"
msgid_plural "army helmets"
msgstr[0] "casco de soldado"
msgstr[1] "cascos de soldado"
msgstr[2] "cascos de soldado"

#. ~ Description of "army helmet"
#: data/json/items/armor/helmets.json
msgid ""
"A heavy helmet that provides excellent protection from all sorts of damage."
"  It is labeled as the advanced combat helmet."
msgstr ""
"Un casco pesado que proporciona una excelente protección contra todo tipo de"
" daños. Está etiquetado como el casco de combate avanzado."

#. ~ Item name
#: data/json/items/armor/helmets.json
msgid "tactical full helmet"
msgid_plural "tactical full helmets"
msgstr[0] "casco táctico completo"
msgstr[1] "cascos tácticos completos"
msgstr[2] "cascos tácticos completos"

#. ~ Description of "tactical full helmet"
#: data/json/items/armor/helmets.json
msgid ""
"An all-encompassing black helmet that covers your entire face and neck, "
"providing excellent protection from all sorts of damage."
msgstr ""
"Un casco negro completo que también cubre tu cara y tu cuello, y brinda "
"excelente protección contra toda clase de daños."

#. ~ Item name
#: data/json/items/armor/helmets.json
msgid "tactical helmet"
msgid_plural "tactical helmets"
msgstr[0] "casco táctico"
msgstr[1] "cascos tácticos"
msgstr[2] "cascos tácticos"

#. ~ Description of "tactical helmet"
#: data/json/items/armor/helmets.json
msgid ""
"A lightweight black helmet that provides excellent protection from all sorts"
" of damage.  It has a military rail system for attachments."
msgstr ""
"Un casco pesado negro que proporciona una excelente protección contra todo "
"tipo de daños. Tiene un sistema de monturas en raíl militar."

#. ~ Description of a pocket in item "tactical helmet"
#: data/json/items/armor/helmets.json
msgid "Pocket for a rail-mounted mandible guard."
msgstr "Compartimiento para un protector de mandíbula montable en ranura."

#. ~ Item name
#: data/json/items/armor/helmets.json
msgid "firefighter helmet"
msgid_plural "firefighter helmets"
msgstr[0] "casco de bombero"
msgstr[1] "cascos de bombero"
msgstr[2] "cascos de bombero"

#. ~ Description of "firefighter helmet"
#: data/json/items/armor/helmets.json
msgid ""
"A distinctive helmet worn by firefighters.  More than just a piece of "
"firefighting equipment, it serves as a badge of honor and respect."
msgstr ""
"Casco característico de los bomberos. Más que una sola pieza del equipo de "
"bomberos sirve como distintivo de honor y respeto."

#. ~ Item name
#: data/json/items/armor/helmets.json
msgid "baseball helmet"
msgid_plural "baseball helmets"
msgstr[0] "casco de béisbol"
msgstr[1] "cascos de béisbol"
