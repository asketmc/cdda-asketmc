msgstr[2] "pasteles humildes"

#. ~ Description of "humble pie"
#: data/json/items/comestibles/offal_dishes.json
msgid ""
"Also known as 'Umble' pie, made with chopped organ meats.  Not half bad, and"
" full of vitamins!"
msgstr ""
"También conocida como tarta 'Umble', está hecha de pedazos de órganos. ¡No "
"está tan mal y está llena de vitaminas!"

#. ~ Item name
#: data/json/items/comestibles/offal_dishes.json
msgid "stewed tripe"
msgid_plural "stewed tripes"
msgstr[0] "tripa guisada"
msgstr[1] "tripas guisadas"
msgstr[2] "tripas guisadas"

#. ~ Description of "stewed tripe"
#: data/json/items/comestibles/offal_dishes.json
msgid ""
"Stomach lining, cut up and stewed for an hour in broth.  Better than it "
"sounds."
msgstr ""
"El estómago se forra, se corta y se cocina durante una hora en caldo. Mejor "
"de lo que suena."

#. ~ Item name
