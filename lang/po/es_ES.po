msgid_plural "headlamps (on)"
msgstr[0] "linterna de cabeza (on)"
msgstr[1] "linternas de cabeza (on)"
msgstr[2] "linternas de cabeza (on)"

#. ~ Description of "headlamp (on)"
#: data/json/items/tool_armor.json
msgid ""
"This is an LED headlamp with an adjustable strap so as to be comfortably "
"worn on your head or attached to your helmet.  It is turned on, and "
"continually draining batteries.  Use it to turn it off."
msgstr ""
"Esto es una linterna de cabeza LED con una correa ajustable para llevarla "
"cómodamente en la cabeza o fijada al casco. Está encendida y las baterías se"
" agotan continuamente. Usar para apagar."

#. ~ Item name
#: data/json/items/tool_armor.json
msgid "survivor headlamp"
msgid_plural "survivor headlamps"
msgstr[0] "linterna de cabeza de sup."
msgstr[1] "linternas de cabeza de sup."
msgstr[2] "linternas de cabeza de sup."

#. ~ Description of "survivor headlamp"
#: data/json/items/tool_armor.json
msgid ""
"This is a custom-made LED headlamp reinforced to be more durable, brighter, "
"and with a larger and more efficient battery pack.  The adjustable strap "
"allows it to be comfortably worn on your head or attached to your helmet.  "
"Use it to turn it on."
msgstr ""
"Esta es una linterna de cabeza LED hecha a medida y reforzada para ser más "
"duradea, más brillante, con un paquete de baterías más grande y más "
"eficiente. La correa ajustable permite que se lleve cómodamente en la cabeza"
" o que se fije en el casco. Usar para encender."

#. ~ "msg" action message of item "survivor headlamp"
#: data/json/items/tool_armor.json
msgid "You turn the survivor headlamp on."
msgstr "Enciendes la linterna de cabeza de superviviente."

#. ~ "need_charges_msg" action message of item "survivor headlamp"
#: data/json/items/tool_armor.json
msgid "The survivor headlamp batteries are dead."
msgstr "La batería de la linterna de cabeza de superviviente está descargada."

#. ~ Item name
#: data/json/items/tool_armor.json
