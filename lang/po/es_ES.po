" a domestic horse."
msgstr ""
"La calavera de un caballo. Teniendo en cuenta las circunstancias puedes "
"estar seguro que es un caballo doméstico."

#. ~ Item name
#: data/json/items/generic/skulls.json
msgid "deer skull"
msgid_plural "deer skulls"
msgstr[0] "calavera de ciervo"
msgstr[1] "calaveras de ciervos"
msgstr[2] "calaveras de ciervos"

#. ~ Description of "deer skull"
#: data/json/items/generic/skulls.json
