msgid_plural "bee stings"
msgstr[0] "aguijón de abeja"
msgstr[1] "aguijones de abeja"
msgstr[2] "aguijones de abeja"

#. ~ Description of "bee sting"
#: data/json/items/resources/misc.json
msgid "A six-inch stinger from a giant bee.  Makes a mediocre melee weapon."
msgstr ""
"Un aguijón de 15 cm de una abeja gigante. Una arma mediocre para el c. a c."

#. ~ Item name
#: data/json/items/resources/misc.json
msgid "broom"
msgid_plural "brooms"
msgstr[0] "escoba"
msgstr[1] "escobas"
msgstr[2] "escobas"

#. ~ Description of "broom"
#: data/json/items/resources/misc.json
msgid ""
"A long-handled broom.  Makes a terrible weapon unless you're chasing cats."
msgstr ""
"Una escoba de mango largo. Es muy mala como arma salvo que estés "
"persiguiendo gatos."

#. ~ Item name
#: data/json/items/resources/misc.json
msgid "ceramic shard"
msgid_plural "ceramic shards"
msgstr[0] "fragmento de cerámica"
msgstr[1] "fragmentos de cerámica"
msgstr[2] "fragmentos de cerámica"

#. ~ Description of "ceramic shard"
#: data/json/items/resources/misc.json
msgid ""
"A broken ceramic shard.  It is heavy and has a somewhat sharp edge, but it's"
" too irregular to cut properly."
msgstr ""
"Es un fragmento roto de cerámica. Es pesado y tiene un poco de filo, pero es"
" demasiado irregular para usarlo para cortar."

#. ~ Item name
#: data/json/items/resources/misc.json
msgid "fungal fighter sting"
msgid_plural "fungal fighter stings"
msgstr[0] "aguijón de guerrero fúngico"
msgstr[1] "aguijones de guerrero fúngico"
msgstr[2] "aguijones de guerrero fúngico"

#. ~ Description of "fungal fighter sting"
#: data/json/items/resources/misc.json
msgid "A short dart from a fungal fighter.  Makes a poor melee weapon."
msgstr ""
"Un dardo corto de un luchador hongo. Es una arma pobre de combate c. a c."

#. ~ Item name
#: data/json/items/resources/misc.json
msgid "incendiary"
msgid_plural "incendiaries"
msgstr[0] "incendiario"
msgstr[1] "incendiarios"
msgstr[2] "incendiarios"

#. ~ Description of "incendiary"
#: data/json/items/resources/misc.json
msgid ""
"Material from an incendiary round, useful in constructing incendiary "
"ammunition."
msgstr ""
"Material de una bala incendiaria, útil para construir munición incendiaria."

#. ~ Description of "mattress"
#: data/json/items/resources/misc.json
msgid "This is a single, or twin, sized mattress."
msgstr "Este es un colchón de tamaño individual o doble."

#. ~ Description of "down mattress"
#: data/json/items/resources/misc.json
msgid "This is a single, or twin, sized down filled mattress."
msgstr "Este es un colchón relleno de tamaño individual o doble."

#. ~ Item name
#: data/json/items/resources/misc.json
msgid "fuse"
msgid_plural "fuse"
msgstr[0] "mecha"
msgstr[1] "mechas"
msgstr[2] "mechas"

#. ~ Description of "fuse"
#: data/json/items/resources/misc.json
msgid ""
"A piece of fuse, long enough to give you enough time to get away from most "
"explosions."
msgstr ""
"Una pieza de mecha, lo suficientemente larga para darte el tiempo suficiente"
" para escapar de la mayoría de las explosiones."

#. ~ Item name
#: data/json/items/resources/misc.json
msgid "sharp rock"
msgid_plural "sharp rocks"
msgstr[0] "roca afilada"
msgstr[1] "rocas afiladas"
msgstr[2] "rocas afiladas"

#. ~ Description of "sharp rock"
#: data/json/items/resources/misc.json
msgid ""
"A baseball-sized rock with a somewhat sharp edge that also chips in a semi-"
"predictable way if struck.  With the right skills, you could give it a "
"better edge."
msgstr ""
"Una piedra del tamaño de una pelota de béisbol con un canto un tanto afilado"
" que se deshace de una manera predecible si se golpea.  Con las habilidades "
"adecuadas, podrías conseguir un mejor filo."

#. ~ Item name
#: data/json/items/resources/misc.json
msgid "rubber sole"
msgid_plural "rubber soles"
msgstr[0] "suela de goma"
msgstr[1] "suelas de goma"
msgstr[2] "suelas de goma"

#. ~ Description of "rubber sole"
#: data/json/items/resources/misc.json
msgid ""
"This is a sole made from rubber, usually found on the bottoms of boots.  Can"
" be used for making actual boots."
msgstr ""
"Esta es una suela de goma, que se encuentra generalmente en la parte "
"inferior de las botas. Se puede usar para hacer botas."

#. ~ Item name
#: data/json/items/resources/misc.json
msgid "thick rubber chunk"
msgid_plural "thick rubber chunks"
msgstr[0] "pedazo de goma gruesa"
msgstr[1] "pedazos de goma gruesa"
msgstr[2] "pedazos de goma gruesa"

#. ~ Description of "thick rubber chunk"
#: data/json/items/resources/misc.json
msgid ""
"This is a chunk of thick, semi-rigid rubber, similar to what tires are made "
"from."
msgstr ""
"Un pedazo de caucho grueso y semirrígido, similar al material del que están "
"hechos las neumáticos."

#. ~ Item name
#: data/json/items/resources/misc.json
msgid "rubber tire strip"
msgid_plural "rubber tire strips"
msgstr[0] "tira de goma de neumático"
msgstr[1] "tiras de goma de neumático"
msgstr[2] "tiras de goma de neumático"

#. ~ Description of "rubber tire strip"
#: data/json/items/resources/misc.json
msgid ""
"This is a long curled strip of thick, semi-rigid rubber cut from a tire."
msgstr ""
"Esto es una larga tira curvada de goma gruesa y semirrígida cortada de un "
"neumático."

#. ~ Item name
#: data/json/items/resources/misc.json
msgid "ballistic shoulder protector"
msgid_plural "ballistic shoulder protectors"
msgstr[0] "protector balístico de hombro"
msgstr[1] "protectores balísticos de hombro"
msgstr[2] "protectores balísticos de hombro"

#. ~ Description of "ballistic shoulder protector"
#: data/json/items/resources/misc.json
msgid ""
"Nylon armor with soft armor insert protecting the deltoid and upper arm.  "
"Designed to be attached to US military body armor."
msgstr ""
"Armadura de nylon con inserto de armadura suave que protege el deltoide y la"
" parte superior del brazo. Diseñada para acoplarse a los chalecos antibalas "
"del ejército estadounidense."

#. ~ Item name
#: data/json/items/resources/misc.json
msgid "ballistic groin protector"
msgid_plural "ballistic groin protectors"
msgstr[0] "protector balístico de ingle"
msgstr[1] "protectores balísticos de ingle"
msgstr[2] "protectores balísticos de ingle"

#. ~ Description of "ballistic groin protector"
#: data/json/items/resources/misc.json
msgid ""
"Front and back nylon armor with soft armor inserts for groin and butt "
"protection.  Designed to be attached to US military body armor."
msgstr ""
"Armadura de nylon delantera y trasera con inserciones de armadura suave para"
" la protección de la ingle y el trasero. Diseñado para acoplarse a los "
"chalecos antibalas militares estadounidenses."

#. ~ Item name
#: data/json/items/resources/misc.json
msgid "grenade launcher buttstock"
msgid_plural "grenade launcher buttstocks"
msgstr[0] "culata de lanzagranadas"
msgstr[1] "culatas de lanzagranadas"
msgstr[2] "culatas de lanzagranadas"

#. ~ Description of "grenade launcher buttstock"
#: data/json/items/resources/misc.json
msgid ""
"A collapsible buttstock designed for the M320 grenade launcher.  When "
"combined with this stock, the M320 can be used as a standalone weapon"
msgstr ""
"Una culata plegable diseñada para el lanzador de granadas M320. Cuando se "
"combina con esta culata, el M320 puede ser usado como un arma independiente"

#. ~ Item name
#: data/json/items/resources/misc.json
msgid "wasp sting"
msgid_plural "wasp stings"
msgstr[0] "aguijón de avispa"
msgstr[1] "aguijones de avispa"
msgstr[2] "aguijones de avispa"

#. ~ Description of "wasp sting"
#: data/json/items/resources/misc.json
msgid "A six-inch stinger from a giant wasp.  Makes a poor melee weapon."
msgstr "Un aguijón de 15 cm de una avispa gigante. Una arma pobre c. a c."

#. ~ Item name
#: data/json/items/resources/misc.json
msgid "cannonball"
msgid_plural "cannonballs"
msgstr[0] "bala de cañón"
msgstr[1] "balas de cañón"
msgstr[2] "balas de cañón"

#. ~ Description of "cannonball"
#: data/json/items/resources/misc.json
msgid ""
"A 4 pound cannonball.  With some gunpowder, wadding, and a fuse, it could be"
" prepared to load into a cannon."
msgstr ""
"Una bala de cañón de 4 libras. Con un poco de pólvora, relleno y una mecha, "
"podría prepararse para cargarse en un cañón."

#. ~ Item name
#: data/json/items/resources/misc.json
msgid "RC car wheel set"
msgid_plural "RC car wheel sets"
msgstr[0] "juego de ruedas de coches RC"
msgstr[1] "juegos de ruedas de coches RC"
msgstr[2] "juegos de ruedas de coches RC"

#. ~ Description of "RC car wheel set"
#: data/json/items/resources/misc.json
msgid ""
"Small set of wheels for a radio controlled car.  Could be improvised with "
"caster wheels if given rubber treads for grip."
msgstr ""
"Un pequeño juego de ruedas para un coche teledirigido. Podría improvisarse "
"con ruedas pivotantes si se le dieran bandas de goma para el agarre."

#. ~ Item name
#: data/json/items/resources/plastic.json
