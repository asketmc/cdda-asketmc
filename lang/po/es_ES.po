msgid "router"
msgid_plural "routers"
msgstr[0] "fresadoras"
msgstr[1] "fresadoras"
msgstr[2] "fresadoras"

#. ~ Description of vehicle part "router"
#: data/json/furniture_and_terrain/appliances.json
msgid ""
"This table has an inset router, a rotating motor with an exchangeable blade "
"head for cutting specific profiles and grooves and stuff.  Ready to be "
"plugged in."
msgstr ""
"Esta mesa tiene una fresadora de inserción, un motor giratorio con un "
"cabezal de cuchilla intercambiable para cortar perfiles y ranuras "
"específicas y demás. Lista para ser enchufada."

#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Based off JET JWP-15BHH Woodworking Planer
#. ~ Item name
#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/appliances.json data/json/items/fake.json
msgid "planer"
msgid_plural "planers"
msgstr[0] "garlopa"
msgstr[1] "garlopas"
msgstr[2] "garlopas"

#. ~ Description of vehicle part "planer"
#: data/json/furniture_and_terrain/appliances.json
msgid ""
"A hefty tool that will take in a board and cut it smooth and flat to a "
"specific width, particularly great if working with raw lumber stock, but "
"also good just for shaving wood down to size.  Ready to be plugged in."
msgstr ""
"Una herramienta robusta que toma una tabla y la corta lisa y plana a una "
"anchura específica, particularmente grande para trabajar con madera en "
"bruto, pero también es buena para reducir el tamaño de la madera. Lista para"
" ser enchufada."

#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Based off Powermatic PJ-882 Jointer.  TODO: When support for multi-tile
#. appliances is added, this can stretch two tiles
#. ~ Item name
#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/appliances.json data/json/items/fake.json
msgid "jointer"
msgid_plural "jointers"
msgstr[0] "ensambladora"
msgstr[1] "ensambladoras"
msgstr[2] "ensambladoras"

#. ~ Description of vehicle part "jointer"
#: data/json/furniture_and_terrain/appliances.json
msgid ""
"A table-shaped tool with a rotating blade that will cut down, smooth out, "
"and square off a board to make it very smooth and nice indeed.  Ready to be "
"plugged in."
msgstr ""
"Una herramienta en forma de mesa con una cuchilla giratoria que cortará, "
"alisará y escuadrará una tabla para dejarla muy suave y bonita. Lista para "
"ser enchufada."

#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Based off Daytona DSP20T Hydraulic Shop Press
#. ~ Item name
#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/appliances.json data/json/items/fake.json
msgid "hydraulic press"
msgid_plural "hydraulic presses"
msgstr[0] "prensa hidráulica"
msgstr[1] "prensas hidráulicas"
msgstr[2] "prensas hidráulicas"

#. ~ Description of vehicle part "hydraulic press"
#: data/json/furniture_and_terrain/appliances.json
msgid ""
"If you really want to squash something a lot, this would be exactly the "
"right industrial tool for you.  Ready to be plugged in."
msgstr ""
"Si realmente quiere aplastar algo con mucha frecuencia, esta sería "
"exactamente la herramienta industrial adecuada para usted. Lista para ser "
"enchufada."

#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Based off Renegade Industrial 2.2HP 210LPM Air Compressor
#. ~ Item name
#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
