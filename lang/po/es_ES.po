msgid "shotgun slug, black powder"
msgid_plural "shotgun slugs, black powder"
msgstr[0] "bala de escopeta, pólvora negra"
msgstr[1] "balas de escopeta, pólvora negra"
msgstr[2] "balas de escopeta, pólvora negra"

#. ~ Description of "shotgun slug, black powder"
#: data/json/items/ammo/shot.json
msgid ""
