msgstr "¡En serio, dame alguna cosa!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, fine, bye."
msgstr "Vale, bien, chao."

#. ~ NPC dialogue line
