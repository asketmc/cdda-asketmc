msgid_plural "iron war darts"
msgstr[0] "dardo de hierro de guerra"
msgstr[1] "dardos de hierro de guerra"
msgstr[2] "dardos de hierro de guerra"

#. ~ Had to mess with the weight and volume to get the right range, 17-18
#. tiles. They also have wide-bladed heads, instead of points, so cut damage.
#. ~ Description of "iron war dart"
#: data/json/items/ranged/throwing.json
msgid ""
"An iron-tipped fletched throwing spear with a throwing loop for extra range."
msgstr ""
"Un dardo emplumado con la punta de hierro y un accesorio que le da mayor "
"alcance."

#. ~ Item name
#: data/json/items/ranged/throwing.json
msgid "bronze war dart"
msgid_plural "bronze war darts"
msgstr[0] "dardo de bronce de guerra"
msgstr[1] "dardos de bronce de guerra"
msgstr[2] "dardos de bronce de guerra"

#. ~ Description of "bronze war dart"
#: data/json/items/ranged/throwing.json
msgid ""
"A bronze-tipped fletched throwing spear with a throwing loop for extra "
"range."
msgstr ""
"Un dardo emplumado con la punta de hierro y un accesorio que le da mayor "
"alcance."

#. ~ Item name
#: data/json/items/relics/altered_items.json
msgid "exposed-wiring prototype"
msgid_plural "exposed-wiring prototypes"
msgstr[0] "prototipo de cableado expuesto"
msgstr[1] "prototipos de cableado expuesto"
msgstr[2] "prototipos de cableado expuesto"

#. ~ Description of "exposed-wiring prototype"
#: data/json/items/relics/altered_items.json
msgid ""
"Some kind of prototypical electronic device with exposed wiring.  Some of "
"the wires have bare ends that could be connected together."
msgstr ""
"Una especie de prototipo de dispositivo electrónico con el cableado "
"expuesto. Algunos de los cables tienen extremos desnudos que podrían "
"conectarse entre sí."

#. ~ Item name
#: data/json/items/relics/altered_items.json
msgid "bakelite phone"
msgid_plural "bakelite phones"
msgstr[0] "teléfono de baquelita"
msgstr[1] "teléfonos de baquelita"
msgstr[2] "teléfonos de baquelita"

#. ~ Description of "bakelite phone"
#: data/json/items/relics/altered_items.json
msgid ""
"A vintage, bright-red bakelite phone of famous swedish design.  It would "
"look almost normal, were it not for the fact that its rotary dial has been "
"replaced by a doorknob."
msgstr ""
"Un antiguo teléfono de baquelita de color rojo brillante de famoso diseño "
"sueco. Se vería casi normal, si no fuera por el hecho de que su dial "
"giratorio ha sido reemplazado por un pomo de puerta."

#. ~ Item name
#: data/json/items/relics/altered_items.json
msgid "golden comb"
msgid_plural "golden combs"
msgstr[0] "peine dorado"
msgstr[1] "peines dorados"
msgstr[2] "peines dorados"

#. ~ Description of "golden comb"
#: data/json/items/relics/altered_items.json
msgid ""
"A small and delicate golden comb, it was once carefully engraved, but time "
"has smoothed its designs to illegibility."
msgstr ""
"Un pequeño y delicado peine dorado, fue una vez cuidadosamente grabada, pero"
" el tiempo ha suavizado sus diseños hasta hacerlos ilegibles."

#. ~ Item name
#: data/json/items/relics/altered_items.json
msgid "shifting keyring"
msgid_plural "shifting keyrings"
msgstr[0] "anillo de llave"
msgstr[1] "anillos de llave"
msgstr[2] "anillos de llave"

#. ~ Description of "shifting keyring"
#: data/json/items/relics/altered_items.json
msgid ""
"A smooth ring of steel, heavy under the weight of numerous keys.  The "
"designs of the keys change over time, but none will fit any keyhole you have"
" ever found."
msgstr ""
"Un suave anillo de acero, pesado bajo el peso de numerosas llaves. Los "
"diseños de las llaves cambian con el tiempo, pero ninguna encajará en "
"ninguna cerradura que hayas encontrado."

#. ~ Item name
#: data/json/items/relics/altered_items.json
msgid "engraved cube"
msgid_plural "engraved cubes"
msgstr[0] "cubo gravado"
msgstr[1] "cubos gravados"
msgstr[2] "cubos gravados"

#. ~ Description of "engraved cube"
#: data/json/items/relics/altered_items.json
msgid ""
"A small cube of smooth rock.  An uniform grid of nine squares is engraved in"
" each of its faces."
msgstr ""
"Un pequeño cubo de roca lisa. Una cuadrícula uniforme de nueve cuadrados "
"está grabada en cada una de sus caras."

#. ~ Item name
#: data/json/items/relics/altered_items.json
msgid "utah teapot"
msgid_plural "utah teapots"
msgstr[0] "tetera de utah"
msgstr[1] "teteras de utah"
msgstr[2] "teteras de utah"

#. ~ Description of "utah teapot"
#: data/json/items/relics/altered_items.json
msgid ""
"A squat teapot with a minimalist design.  Its surface shines under the glow "
"of unseen light sources."
msgstr ""
"Una tetera de pie con un diseño minimalista. Su superficie brilla bajo el "
"brillo de fuentes de luz no vistas."

#. ~ Item name
#: data/json/items/relics/altered_items.json
msgid "glitching stopwatch"
msgid_plural "glitching stopwatches"
msgstr[0] "cronómetro que falla"
msgstr[1] "cronómetros que fallan"
msgstr[2] "cronómetros que fallan"

#. ~ Description of "glitching stopwatch"
#: data/json/items/relics/altered_items.json
msgid ""
"A small digital stopwatch, looking slightly old by today's standards.  Its "
"digital display prints ever-changing gibberish."
msgstr ""
"Un pequeño cronómetro digital, que parece un poco viejo para los estándares "
"de hoy en día. Su pantalla digital imprime un galimatías siempre cambiante."

#. ~ Item name
#: data/json/items/relics/monolith_items.json
msgid "inscribed disc"
msgid_plural "inscribed discs"
msgstr[0] "disco inscrito"
msgstr[1] "discos inscritos"
msgstr[2] "discos inscritos"

#. ~ Description of "inscribed disc"
#: data/json/items/relics/monolith_items.json
msgid ""
"A thin, palm-sized disc of incredibly dense stone, engraved with meaningless"
" swirls.  Its surface seems to repel grime and debris, and it refuses to "
"tarnish or scratch."
msgstr ""
"Un disco fino del tamaño de una mano hecho de una piedra increíblemente "
"densa, grabada con unos garabatos sin sentido. Su superficie parece repeler "
"mugre, escombros y se niega a mancharse o rayarse."

#. ~ Item name
#: data/json/items/relics/monolith_items.json
msgid "warped brick"
msgid_plural "warped bricks"
msgstr[0] "ladrillo retorcido"
msgstr[1] "ladrillos retorcidos"
msgstr[2] "ladrillos retorcidos"

#. ~ Description of "warped brick"
#: data/json/items/relics/monolith_items.json
msgid ""
"This brick of too-dense stone is warped in a way that just barely makes it "
"worthless as a building material.  Its smooth surface is unmarred by "
"texture, dirt, or color."
msgstr ""
"Este ladrillo es de una piedra muy densa y está retorcido de una manera que "
"apenas puede ser útil como material de construcción. Su superficie suave "
"está intacta de textura, tierra o color."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "alien resin chunk"
msgid_plural "alien resin chunks"
msgstr[0] "trozo de resina alienígena"
msgstr[1] "trozos de resina alienígena"
msgstr[2] "trozos de resina alienígena"

#. ~ Description of "alien resin chunk"
#: data/json/items/resources/alien.json
msgid ""
"This is a shattered fragment of alien resin.  It looks a bit like a large "
"piece of sea glass, frosted and gritty with the edges rounded off.  It is "
"somewhat warm to the touch."
msgstr ""
"Este es un fragmento destrozado de resina alienígena. Se parece un poco a un"
" gran trozo de cristal marino, escarchado y arenoso con los bordes "
"redondeados. Es algo cálido al tacto."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "alien resin pod"
msgid_plural "alien resin pods"
msgstr[0] "vaina de resina alienígena"
msgstr[1] "vainas de resina alienígena"
msgstr[2] "vainas de resina alienígena"

#. ~ Description of "alien resin pod"
#: data/json/items/resources/alien.json
msgid ""
"This is a large pod, the size of a keg, filled with gooey alien resin.  "
"Squeezing it firmly causes resin to squirt from the broken stalk at the end,"
" hardening within a few seconds of being exposed to the air."
msgstr ""
"Esta es una gran vaina, del tamaño de un barril, llena de resina alienígena "
"pegajosa. Al apretarla firmemente, la resina sale a chorros del tallo roto "
"del extremo, endureciéndose a los pocos segundos de ser expuesta al aire."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "alien fern branch"
msgid_plural "alien fern branches"
msgstr[0] "rama de helecho extraterrestre"
msgstr[1] "ramas de helecho extraterrestre"
msgstr[2] "ramas de helecho extraterrestre"

#. ~ Description of "alien fern branch"
#: data/json/items/resources/alien.json
msgid ""
"A branching trunk of leaves from a mega fern, about two feet long and a "
"couple of feet across in diameter measuring the leaves.  Maybe one day "
"you'll think of something to make with a giant fern."
msgstr ""
"Un tronco con ramas y hojas de un mega helecho, de unos sesenta centímetros "
"de largo y sesenta de diámetro midiendo las hojas. Tal vez algún día se te "
"ocurra qué hacer con un helecho gigante."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "Exodii chassis"
msgid_plural "Exodii chassis"
msgstr[0] "chasis Exodii"
msgstr[1] "chasis Exodii"
msgstr[2] "chasis Exodii"

#. ~ Description of "Exodii chassis"
#: data/json/items/resources/alien.json
msgid ""
"This roughly hexagonal frame and associated bodywork looks like it was "
"constructed as a single monolithic piece.  The fitting holes and attachments"
" are extremely durable, despite showing signs of heavy wear and repair.  The"
" structure is versatile, and could probably be engineered to serve a number "
"of different heavy combat roles."
msgstr ""
"Este chasis aproximadamente hexagonal y la carrocería asociada parece haber "
"sido construida como una sola pieza monolítica. Los agujeros de ajuste y los"
" accesorios son extremadamente duraderos, a pesar de mostrar signos de gran "
"desgaste y reparación. La estructura es versátil, y probablemente podría ser"
" diseñada para servir a un número de diferentes roles de combate pesado."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "Exodii drone chassis"
msgid_plural "Exodii drone chassis"
msgstr[0] "chasis de dron Exodii"
msgstr[1] "chasis de dron Exodii"
msgstr[2] "chasis de dron Exodii"

#. ~ Description of "Exodii drone chassis"
#: data/json/items/resources/alien.json
msgid ""
"This small, roughly hexagonal frame and associated bodywork looks like it "
"was constructed as a single monolithic piece.  The fitting holes and "
"attachments are extremely durable, despite showing signs of heavy wear and "
"repair.  The structure is versatile, and could probably be engineered to "
"serve a number of different heavy combat roles."
msgstr ""
"Este pequeño chasis hexagonal y su correspondiente carrocería parece haber "
"sido construida como una sola pieza monolítica. Los agujeros de ajuste y los"
" accesorios son extremadamente duraderos, a pesar de mostrar signos de gran "
"desgaste y reparación. La estructura es versátil, y probablemente podría ser"
" diseñada para servir a un número de diferentes roles de combate pesado."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "cybernetic neural matrix"
msgid_plural "cybernetic neural matrices"
msgstr[0] "matrix neuronal cibernética"
msgstr[1] "matrices neuronales cibernéticas"
msgstr[2] "matrices neuronales cibernéticas"

#. ~ Description of "cybernetic neural matrix"
#: data/json/items/resources/alien.json
msgid ""
"A series of tanks and tubes with ports for fluids, electricity, and input "
"and output, this complex arrangement is made to house a brain and spine and "
"the most difficult to replace organs for keeping them alive."
msgstr ""
"Una serie de tanques y tubos con puertos para fluidos, electricidad, y "
"entrada y salida, este complejo arreglo está hecho para albergar un cerebro "
"y una columna vertebral y los órganos más difíciles de reemplazar para "
"mantenerlos vivos."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "unfamiliar electronic thingy"
msgid_plural "unfamiliar electronic thingies"
msgstr[0] "cosita electrónica desconocida"
msgstr[1] "cositas electrónicas desconocidas"
msgstr[2] "cositas electrónicas desconocidas"

#. ~ Description of "unfamiliar electronic thingy"
#: data/json/items/resources/alien.json
msgid ""
"The wiring and general shape suggest to you that this is a computer, or at "
"least some sort of electronic device, but what it is and what role it serves"
" is lost on you.  It's heavy and sturdy in construction."
msgstr ""
"El cableado y la forma general sugieren que se trata de un ordenador, o al "
"menos de algún tipo de dispositivo electrónico, pero lo que es y el papel "
"que cumple no lo conoces. Es pesado y robusto en su construcción."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "inscribed metal plates"
msgid_plural "inscribed metal plates"
msgstr[0] "placas de metal inscritas"
msgstr[1] "placas de metal inscritas"
msgstr[2] "placas de metal inscritas"

#. ~ Description of "inscribed metal plates"
#: data/json/items/resources/alien.json
msgid ""
"This device looks electronic, but is unfamiliar.  It is a series of tightly "
"fitted coppery-looking rings, set concentrically.  Wires run from each ring "
"to an axis in the middle."
msgstr ""
"Este dispositivo parece electrónico, pero no es familiar. Es una serie de "
"anillos de aspecto cobrizo ajustados, colocados concéntricamente. Los cables"
" van de cada anillo a un eje en el centro."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "small unfamiliar electronic thingy"
msgid_plural "small unfamiliar electronic thingies"
msgstr[0] "pequeña cosa rara electrónica"
msgstr[1] "pequeñas cosas raras electrónicas"
msgstr[2] "pequeñas cosas raras electrónicas"

#. ~ Description of "small unfamiliar electronic thingy"
#: data/json/items/resources/alien.json
msgid ""
"The wiring and general shape suggest to you that this is a tiny computer, or"
" at least some sort of electronic device, but what it is and what role it "
"serves is lost on you.  It's small enough to fit into your palm."
msgstr ""
"Los cables y su forma general te sugieren que esto es un ordenador pequeño "
"o, por lo menos, alguna clase de dispositivo electrónico pero no tienes ni "
"idea qué es y qué función tiene. Es lo suficientemente pequeño para caber en"
" tu mano."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "inscribed metal rings"
msgid_plural "inscribed metal rings"
msgstr[0] "anillo metálico inscrito"
msgstr[1] "anillos metálicos inscritos"
msgstr[2] "anillos metálicos inscritos"

#. ~ Description of "inscribed metal rings"
#: data/json/items/resources/alien.json
msgid ""
"This device looks electronic, but is unfamiliar.  It is a series of tightly "
"fitted coppery-looking nuts, set concentrically.  Wires run from each ring "
"to an axis in the middle."
msgstr ""
"Este dispositivo parece electrónico pero no sabes qué es. Es una serie "
"apretada de tuercas que parecen de cobre, puestos de manera concéntrica. Hay"
" cables que salen de cada anillo y van hacia el eje del medio."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "cybernetic sensor"
msgid_plural "cybernetic sensors"
msgstr[0] "sensor cibernético"
msgstr[1] "sensores cibernéticos"
msgstr[2] "sensores cibernéticos"

#. ~ Description of "cybernetic sensor"
#: data/json/items/resources/alien.json
msgid ""
"From the large glassy eye - the size of a small dinner plate - in the front,"
" you deduce this is some sort of camera.  None of the inner workings make "
"any sense to you nor resemble any camera you've seen before."
msgstr ""
"Del gran ojo vidrioso, del tamaño de un pequeño plato de comida, en el "
"frente, se deduce que es una especie de cámara. Ninguno de los mecanismos "
"internos tiene sentido para ti ni se parece a ninguna cámara que hayas visto"
" antes."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "rotary device"
msgid_plural "rotary devices"
msgstr[0] "dispositivo rotatorio"
msgstr[1] "dispositivos rotatorios"
msgstr[2] "dispositivos rotatorios"

#. ~ Description of "rotary device"
#: data/json/items/resources/alien.json
msgid ""
"You assume from the coils of coppery wire and the protruding piston that "
"this is some sort of motor or generator, but the design doesn't look similar"
" to anything you've seen before, and you can't figure out how to get it to "
"work."
msgstr ""
"Supones por las bobinas de alambre de cobre y el pistón saliente que se "
"trata de algún tipo de motor o generador, pero el diseño no se parece a nada"
" que hayas visto antes, y no puedes averiguar cómo hacer que funcione."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "engraved parabolic dish"
msgid_plural "engraved parabolic dishes"
msgstr[0] "plato parabólico grabado"
msgstr[1] "platos parabólicos grabados"
msgstr[2] "platos parabólicos grabados"

#. ~ Description of "engraved parabolic dish"
#: data/json/items/resources/alien.json
msgid ""
"This hefty parabolic dish is engraved with an unrecognizable pattern of "
"symbols that might, at a guess, be some sort of circuitry pattern - or maybe"
" a religious incantation."
msgstr ""
"Esta pesada parábola está grabada con un patrón irreconocible de símbolos "
"que podría ser, en una suposición, una especie de patrón de circuitos - o "
"tal vez un encantamiento religioso."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "oblong device"
msgid_plural "oblong devices"
msgstr[0] "dispositivo oblongo"
msgstr[1] "dispositivos oblongos"
msgstr[2] "dispositivos oblongos"

#. ~ Description of "oblong device"
#: data/json/items/resources/alien.json
msgid ""
"Perfectly smooth, cool to the touch, and a dull blue-gray color, this looks "
"almost like a perfect riverstone at first glance.  Its artificial nature is "
"betrayed on closer inspection by a network of intricate patterns visible as "
"a slight difference in the reflection of light off its surface."
msgstr ""
"Es perfectamente suave y frío al tacto y de un color azul grisáceo, a "
"primera vista parece casi una piedra de río perfecta. Su naturaleza "
"artificial es traicionada al inspeccionarla por una red de patrones "
"intrincados visibles como una leve diferencia en el reflejo de la luz en su "
"superficie."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "enormous aluminum ingot"
msgid_plural "enormous aluminum ingots"
msgstr[0] "lingote de aluminio enorme"
msgstr[1] "lingotes de aluminio enormes"
msgstr[2] "lingotes de aluminio enormes"

#. ~ Description of "enormous aluminum ingot"
#: data/json/items/resources/alien.json
msgid "A block of pure aluminum at least as big as a dishwasher."
msgstr "Un bloque de aluminio puro al menos tan grande como un lavavajillas."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "enormous plastic block"
msgid_plural "enormous plastic blocks"
msgstr[0] "bloque de plástico enorme"
msgstr[1] "bloques de plástico enormes"
msgstr[2] "bloques de plástico enormes"

#. ~ Description of "enormous plastic block"
#: data/json/items/resources/alien.json
msgid ""
"This is a single enormous brick of plastic, big enough to curl up inside "
"were it hollow."
msgstr ""
"Esto es un solo y enorme bloque de plástico, lo suficientemente grande como "
"para poder acurrucarse en su interior si estuviera hueco."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "enormous steel ingot"
msgid_plural "enormous steel ingots"
msgstr[0] "lingote de acero enorme"
msgstr[1] "lingotes de acero enormes"
msgstr[2] "lingotes de acero enormes"

#. ~ Description of "enormous steel ingot"
#: data/json/items/resources/alien.json
msgid "A single, monolithic block of high quality steel."
msgstr "Un solo bloque monolítico de acero de alta calidad."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "enormous tin ingot"
msgid_plural "enormous tin ingots"
msgstr[0] "lingote de estaño enorme"
msgstr[1] "lingotes de estaño enormes"
msgstr[2] "lingotes de estaño enormes"

#. ~ Description of "enormous tin ingot"
#: data/json/items/resources/alien.json
msgid "An enormous ingot of pure tin."
msgstr "Un enorme lingote de puro estaño."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "enormous copper ingot"
msgid_plural "enormous copper ingots"
msgstr[0] "lingote de cobre enorme"
msgstr[1] "lingotes de cobre enormes"
msgstr[2] "lingotes de cobre enormes"

#. ~ Description of "enormous copper ingot"
#: data/json/items/resources/alien.json
msgid "A massive solid piece of copper, covered by a blue-green patina."
msgstr ""
"Una pieza masiva y sólida de cobre, cubierta por una pátina azul verdosa."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "enormous zinc ingot"
msgid_plural "enormous zinc ingots"
msgstr[0] "lingote de zinc enorme"
msgstr[1] "lingotes de zinc enormes"
msgstr[2] "lingotes de zinc enormes"

#. ~ Description of "enormous zinc ingot"
#: data/json/items/resources/alien.json
msgid ""
"An absolutely massive block of pure zinc.  Bet you didn't expect that - "
"nobody expects zinc."
msgstr ""
"Un bloque absolutamente gigante de zinc puro. Apuesto a que no te lo "
"esperabas, nadie espera a zinc."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "enormous lead ingot"
msgid_plural "enormous lead ingots"
msgstr[0] "lingote de plomo enorme"
msgstr[1] "lingotes de plomo enormes"
msgstr[2] "lingotes de plomo enormes"

#. ~ Description of "enormous lead ingot"
#: data/json/items/resources/alien.json
msgid ""
"A block of lead so huge you don't even want to think about how heavy it is."
msgstr ""
"Un bloque de plomo tan grande que no quieres ni pensar en lo que pesa."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "CBM interface wire kit"
msgid_plural "CBM interface wire kits"
msgstr[0] "equipo de cables de interfaz MBC"
msgstr[1] "equipos de cables de interfaz MBC"
msgstr[2] "equipos de cables de interfaz MBC"

#. ~ Description of "CBM interface wire kit"
#: data/json/items/resources/alien.json
msgid ""
"A collection of hand sautered wires leading to plugs and what looks like an "
"exotic micro controller.  The plugs look like they could be attached to you,"
" assuming you have an SNI (Standard Neurobionic Interface)."
msgstr ""
"Una colección de cables salteados a mano que conducen a enchufes y a lo que "
"parece un exótico microcontrolador. Los enchufes parecen que podrían estar "
"conectados a ti, suponiendo que tengas una SNI (Standard Neurobionic "
"Interface)."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "external climate control kit"
msgid_plural "external climate control kits"
msgstr[0] "equipo de control externo de temperatura"
msgstr[1] "equipos de control externo de temperatura"
msgstr[2] "equipos de control externo de temperatura"

#. ~ Description of "external climate control kit"
#: data/json/items/resources/alien.json
msgid ""
"A collection of mismatched pipes, wires, and a central device that looks "
"like an exotic micro controller.  Almost looks like it could be used for "
"some form of central cooling."
msgstr ""
"Una colección de tubos, cables incompatibles y un dispositivo central que "
"parece ser un microcontrolador exótico. Casi parece que podría usarse como "
"alguna clase de enfriamiento central."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "woven metallics"
msgid_plural "woven metallics"
msgstr[0] "tejido metálico"
msgstr[1] "tejidos metálicos"
msgstr[2] "tejidos metálicos"

#. ~ Description of "woven metallics"
#: data/json/items/resources/alien.json
msgid ""
"Thin metallic strips with an ochre sheen, interlaid together into a flexible"
" mesh.  You cant tell whether its a circuit, a heat dissipation component, "
"or a mechanical actuator."
msgstr ""
"Tiras finas metálicas con un brillo ocre entretejidas con una malla "
"flexible. No te das cuenta si es un circuito, un componente de disipación de"
" calor o un actuador mecánico."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "alien metal plating"
msgid_plural "alien metal plating"
msgstr[0] "placa metálica extraterrestre"
msgstr[1] "placas metálicas extraterrestres"
msgstr[2] "placas metálicas extraterrestres"

#. ~ Description of "alien metal plating"
#: data/json/items/resources/alien.json
msgid ""
"A slightly curved plate of white metal.  It readily collects low amounts of "
"static charge."
msgstr ""
"Una placa levemente curva de metal blanco. Fácilmente acumula pocas "
"cantidades de estática."

#. ~ Item name
#: data/json/items/resources/alien.json
#: data/mods/Dark-Skies-Above/items/alien-scrap.json
msgid "alien metal scrap"
msgid_plural "alien metal scraps"
msgstr[0] "chatarra alienígena"
msgstr[1] "chatarras alienígenas"
msgstr[2] "chatarras alienígenas"

#. ~ Description of "alien metal scrap"
#: data/json/items/resources/alien.json
msgid ""
"Tiny metal strips, spheres and other geometric primitives taken from a "
"disassembled alien machine."
msgstr ""
"Pequeñas tiras, esferas y otros primitivas formas geométricas de metal "
"sacadas de una máquina extraterrestre desensamblada."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "monolithic machine"
msgid_plural "monolithic machine"
msgstr[0] "máquina monolítica"
msgstr[1] "máquinas monolíticas"
msgstr[2] "máquinas monolíticas"

#. ~ Description of "monolithic machine"
#: data/json/items/resources/alien.json
msgid ""
"A very heavy sphere, presumably made almost entirely of gold.  A complexly "
"etched surface implies it might serve some exotic function."
msgstr ""
"Una esfera muy pesada, presuntamente hecha completamente de oro. Una "
"superficie grabada complejamente implica que puede tener alguna función "
"exótica."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "robotic innards"
msgid_plural "robotic innards"
msgstr[0] "tripa robótica"
msgstr[1] "tripas robóticas"
msgstr[2] "tripas robóticas"

