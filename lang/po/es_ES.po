msgstr[0] "médula ósea"
msgstr[1] "médulas óseas"
msgstr[2] "médulas óseas"

#. ~ Description of "bone marrow"
#: data/json/items/comestibles/carnivore.json
msgid ""
"A soft, spongy substance found in bones, rich in fat.  Chock-full of good "
"stuff and doesn't taste too bad even raw, but beware of parasites."
msgstr ""
"Una sustancia blanda y esponjosa que se encuentra en los huesos, rica en "
"grasa. Está llena de cosas buenas y no sabe demasiado mal incluso cruda, "
"pero hay que tener cuidado con los parásitos."

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "human bone marrow"
msgid_plural "human bone marrow"
msgstr[0] "médula ósea humana"
msgstr[1] "médulas óseas humanas"
msgstr[2] "médulas óseas humanas"

#. ~ Description of "human bone marrow"
#: data/json/items/comestibles/carnivore.json
msgid "Soft, spongy marrow tissue from a human bone."
msgstr "Tejido medular blando y esponjoso de un hueso humano."

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "demihuman bone marrow"
msgid_plural "demihuman bone marrow"
msgstr[0] "médula ósea demi-humanas"
msgstr[1] "médulas óseas demi-humanas"
msgstr[2] "médulas óseas demi-humanas"

#. ~ Description of "demihuman bone marrow"
#: data/json/items/comestibles/carnivore.json
msgid "Soft, spongy marrow tissue from a demihuman bone."
msgstr "Tejido blando y esponjoso de la médula de un hueso demi-humano."

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "mutant bone marrow"
msgid_plural "mutant bone marrow"
msgstr[0] "médula ósea mutante"
msgstr[1] "médulas óseas mutante"
msgstr[2] "médulas óseas mutante"

#. ~ Description of "mutant bone marrow"
#: data/json/items/comestibles/carnivore.json
msgid ""
"Soft, spongy and oddly-colored marrow tissue from the bone of a heavily "
"mutated animal."
msgstr ""
"Tejido de médula blando, esponjoso y de extraño color, procedente del hueso "
"de un animal muy mutado."

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "mutant human bone marrow"
msgid_plural "mutant human bone marrow"
msgstr[0] "médula ósea humana mutante"
msgstr[1] "médulas óseas humana mutante"
msgstr[2] "médulas óseas humana mutante"

#. ~ Description of "mutant human bone marrow"
#: data/json/items/comestibles/carnivore.json
msgid ""
"Soft, spongy and oddly-colored marrow tissue from the bone of a heavily "
"mutated creature that was unsettlingly humanoid in appearance."
msgstr ""
"Tejido de médula blando, esponjoso y de extraño color, procedente del hueso "
"de una criatura fuertemente mutada y de aspecto inquietantemente humanoide."

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "raw brains"
msgid_plural "raw brains"
msgstr[0] "cerebro crudo"
msgstr[1] "cerebros crudos"
msgstr[2] "cerebros crudos"

#. ~ Description of "raw brains"
#: data/json/items/comestibles/carnivore.json
msgid "A chunk of brain from an animal.  You wouldn't want to eat this raw…"
msgstr "Un trozo de cerebro de un animal. No querrías comértelo crudo..."

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "raw human brains"
msgid_plural "raw human brains"
msgstr[0] "cerebro humano crudo"
msgstr[1] "cerebros humanos crudos"
msgstr[2] "cerebros humanos crudos"

#. ~ Description of "raw human brains"
#: data/json/items/comestibles/carnivore.json
msgid ""
"A chunk of brain from a human.  Eating this may cause kuru, but you probably"
" won't live long enough to care about that anyway."
msgstr ""
"Un trozo de cerebro de un humano. Comer esto puede causar kuru, pero "
"probablemente no vivirás lo suficiente como para preocuparte por eso de "
"todos modos."

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "raw demihuman brains"
msgid_plural "raw demihuman brains"
msgstr[0] "cerebros demihumanos crudos"
msgstr[1] "cerebros demihumanos crudos"
msgstr[2] "cerebros demihumanos crudos"

#. ~ Description of "raw demihuman brains"
#: data/json/items/comestibles/carnivore.json
msgid ""
"A chunk of brain from a demihuman being.  Don't prion diseases cross species"
" barriers?"
msgstr ""
"Un trozo de cerebro de un ser demi-humano. ¿Las enfermedades priónicas no "
"cruzan las barreras de las especies?"

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
#: data/mods/Dark-Skies-Above/overrides/items/carnivore.json
msgid "cooked brains"
msgid_plural "cooked brains"
msgstr[0] "cerebro cocinado"
msgstr[1] "cerebros cocinados"
msgstr[2] "cerebros cocinados"

#. ~ Description of "cooked brains"
#: data/json/items/comestibles/carnivore.json
msgid ""
"Now you can emulate those zombies you love so much!  Preparing brain for "
"eating is challenging, and this doesn't seem to be the best way to do it."
msgstr ""
"¡Ahora puedes emular a esos zombis que tanto amas! Preparar el cerebro para "
"comer es un desafío, y esta no parece ser la mejor manera de hacerlo."

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
