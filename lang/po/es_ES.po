msgstr "Pista de pruebas de vehículos"

#. ~ Computer name placed on map lab_1side
#: data/mods/Aftershock/maps/lab_weapons_range.json
msgid "Weapons Testing Range"
msgstr "Campo de Armas de Prueba"

#. ~ Computer name placed on map lab_1side
#: data/mods/Aftershock/maps/lab_weapons_range.json
msgid "Armory Entrance"
msgstr "Entrada a la Armería"

#. ~ Name of starting location "sloc_escape_pod"
#: data/mods/Aftershock/maps/overmap_locations.json
msgid "Crashed escape pod"
msgstr "Cápsula de escape estrellada"

