#. ~ Profession name for male
#: data/json/professions.json
msgctxt "profession_male"
msgid "Patient"
msgstr "Paciente"

#. ~ Description of profession "Patient" for male
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"When the diagnosis came back positive, you made a vow: to fight for your "
"life, and to never give in to despair.  Now is the time to renew that vow."
msgstr ""
"Cuando el diagnóstico fue positivo, hicistes una promesa: luchar por tu vida"
" y no ceder nunca a la desesperación. Ahora es el momento de renovar ese "
"voto."

#. ~ Profession name for female
#: data/json/professions.json
