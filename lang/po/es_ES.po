#: data/mods/Magiclysm/items/ammo_types.json
#: data/mods/Magiclysm/items/fuel.json
msgid "blood"
msgid_plural "blood"
msgstr[0] "sangre"
msgstr[1] "sangre"
msgstr[2] "sangre"

#. ~ Description of "blood"
#: data/json/items/comestibles/carnivore.json
msgid "Blood, possibly that of a human.  Disgusting!"
msgstr "Sangre, probablemente de un humano. ¡Repugnante!"

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "bone"
msgid_plural "bones"
msgstr[0] "hueso"
msgstr[1] "huesos"
msgstr[2] "huesos"

#. ~ Description of "bone"
#: data/json/items/comestibles/carnivore.json
msgid ""
"A bone from some creature or other.  Could be used in cooking and crafting."
msgstr ""
"Un hueso de alguna criatura. Puede usarse en la cocina y la artesanía."

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "chunk of fat"
msgid_plural "chunks of fat"
msgstr[0] "trozo de grasa"
msgstr[1] "trozos de grasa"
msgstr[2] "trozos de grasa"

#. ~ Description of "chunk of fat"
#: data/json/items/comestibles/carnivore.json
msgid ""
"A chunk of raw fat.  You could eat it as-is, but it is better used as an "
"ingredient in other foods or projects."
msgstr ""
"Un trozo de grasa cruda. Se puede comer tal cual, pero es mejor utilizarlo "
"como ingrediente en otros alimentos o proyectos."

#. ~ *May* have been commercially traded.
#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "tallow"
msgid_plural "tallows"
msgstr[0] "sebo"
msgstr[1] "sebos"
msgstr[2] "sebos"

#. ~ *May* have been commercially traded.
#. ~ Description of "tallow"
#: data/json/items/comestibles/carnivore.json
msgid ""
"A smooth white block of cleaned and rendered animal fat.  It will remain "
"edible for a very long time, and can be used as an ingredient in many foods "
"and projects."
msgstr ""
"Un bloque blanco y liso de grasa animal procesada y limpia. Permanecerá "
"comestible durante mucho tiempo, y puede ser usada como ingrediente en "
"muchas comidas y proyectos."

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "lard"
msgid_plural "lards"
msgstr[0] "manteca"
msgstr[1] "mantecas"
msgstr[2] "mantecas"

#. ~ Description of "lard"
#: data/json/items/comestibles/carnivore.json
msgid ""
"A smooth white block of dry-rendered animal fat.  It will remain edible for "
"a very long time, and can be used as an ingredient in many foods and "
"projects."
msgstr ""
"Un bloque blanco y liso de grasa humana procesada seca. Permanecerá "
"comestible durante mucho tiempo, y puede ser usada como ingrediente en "
"muchas comidas y proyectos."

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "chunk of mutant fat"
msgid_plural "chunks of mutant fat"
msgstr[0] "trozo de grasa mutada"
msgstr[1] "trozos de grasa mutada"
msgstr[2] "trozos de grasa mutada"

#. ~ Description of "chunk of mutant fat"
#: data/json/items/comestibles/carnivore.json
msgid ""
"A chunk of raw fat butchered from a heavily-mutated animal.  It smells, if "
"anything, even more disgusting than the rest of the mutant.  There are "
"little puddles of unidentified oils dripping from it."
msgstr ""
"Un pedazo de grasa cruda carnicería de un animal fuertemente mutado. Huele, "
"en todo caso, aún más asqueroso que el resto del mutante. Hay pequeños "
"charcos de aceites no identificados que gotean de él."

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "mutant tallow"
msgid_plural "mutant tallows"
msgstr[0] "sebo mutante"
msgstr[1] "sebo mutante"
msgstr[2] "sebo mutante"

#. ~ Description of "mutant tallow"
#: data/json/items/comestibles/carnivore.json
msgid ""
"A smooth white block of cleaned and rendered fat, sourced from a mutant "
"animal.  It will remain edible for a very long time, and can be used as an "
"ingredient in many foods and projects."
msgstr ""
"Un bloque blanco y liso de grasa limpia y extraída, procedente de un animal "
"mutante. Se mantiene comestible durante mucho tiempo y puede utilizarse como"
" ingrediente en muchos alimentos y proyectos."

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "mutant lard"
msgid_plural "mutant lards"
msgstr[0] "manteca de mutante"
msgstr[1] "mantecas de mutante"
msgstr[2] "mantecas de mutante"

#. ~ Description of "mutant lard"
#: data/json/items/comestibles/carnivore.json
msgid ""
"A smooth white block of dry-rendered fat, sourced from a mutant animal.  It "
"will remain edible for a very long time, and can be used as an ingredient in"
" many foods and projects."
msgstr ""
"Un bloque blanco y liso de grasa seca, procedente de un animal mutante. Se "
"mantiene comestible durante mucho tiempo y puede utilizarse como ingrediente"
" en muchos alimentos y proyectos."

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
#: data/mods/Dark-Skies-Above/overrides/items/carnivore.json
msgid "chunk of mutant humanoid fat"
msgid_plural "chunks of mutant humanoid fat"
msgstr[0] "trozos de grasa humanoide mutante"
msgstr[1] "trozos de grasa humanoide mutante"
msgstr[2] "trozos de grasa humanoide mutante"

#. ~ Description of "chunk of mutant humanoid fat"
#: data/json/items/comestibles/carnivore.json
msgid "Raw fat butchered from a heavily-mutated humanoid."
msgstr "Grasa cruda carnicera de un humanoide fuertemente mutado."

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "mutant humanoid tallow"
msgid_plural "mutant humanoid tallows"
msgstr[0] "sebo humanoide mutante"
msgstr[1] "sebo humanoide mutante"
msgstr[2] "sebo humanoide mutante"

#. ~ Description of "mutant humanoid tallow"
#: data/json/items/comestibles/carnivore.json
msgid ""
"A smooth white block of cleaned and rendered fat, sourced from a mutant "
"humanoid.  It won't rot for a very long time, and can be used as an "
"ingredient in many foods and projects."
msgstr ""
"Un bloque blanco y liso de grasa limpiada y extraída, procedente de un "
"humanoide mutante. No se pudre durante mucho tiempo y puede utilizarse como "
"ingrediente en muchos alimentos y proyectos."

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "mutant humanoid lard"
msgid_plural "mutant humanoid lards"
msgstr[0] "manteca de humanoide mutante"
msgstr[1] "manteca de humanoide mutante"
msgstr[2] "manteca de humanoide mutante"

#. ~ Description of "mutant humanoid lard"
#: data/json/items/comestibles/carnivore.json
msgid ""
"A smooth white block of dry-rendered fat, sourced from a mutant humanoid.  "
"It won't rot for a very long time, and can be used as an ingredient in many "
"foods and projects."
msgstr ""
"Un bloque blanco y liso de grasa seca, procedente de un humanoide mutante. "
"No se pudre durante mucho tiempo y puede utilizarse como ingrediente en "
"muchos alimentos y proyectos."

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "chunk of tainted meat"
msgid_plural "chunks of tainted meat"
msgstr[0] "trozo de carne contaminada"
msgstr[1] "trozos de carne contaminada"
msgstr[2] "trozos de carne contaminada"

#. ~ Description of "chunk of tainted meat"
#: data/json/items/comestibles/carnivore.json
msgid ""
"A piece of meat that's obviously unhealthy.  You could eat it, but it will "
"poison you."
msgstr ""
"Es un pedazo de carne que, obviamente, no es saludable. Te la puedes comer "
"pero te va a intoxicar."

#. ~ Item name
#. ~ Name of an ammunition type
#: data/json/items/comestibles/carnivore.json
#: data/mods/Magiclysm/items/ammo_types.json
#: data/mods/Magiclysm/items/fuel.json data/mods/Magiclysm/items/obsolete.json
msgid "tainted blood"
msgid_plural "tainted blood"
msgstr[0] "sangre contaminada"
msgstr[1] "sangre contaminada"
msgstr[2] "sangre contaminada"

#. ~ Description of "tainted blood"
#: data/json/items/comestibles/carnivore.json
msgid ""
"Blood that's obviously unhealthy.  You could eat it, but it will poison you."
msgstr ""
"Sangre que obviamente no es saludable. Podrías comerla, pero te envenenaría."

#. ~ Not for use in edible recipes, and should require ~200% as much as normal
