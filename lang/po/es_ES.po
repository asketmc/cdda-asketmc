#. ~ Profession name for male
#: data/json/hobbies.json
msgctxt "profession_male"
msgid "Tabletop Gaming"
msgstr "Jugador de Mesa"

#. ~ Description of profession "Tabletop Gaming" for male
#: data/json/hobbies.json
msgctxt "prof_desc_male"
msgid ""
"As the Game Master, you've guided players' journeys through dungeons and "
"fortresses.  Now, you're the last member of your party."
msgstr ""
"Como Maestro del Juego, has guiado los viajes de jugadores a través de "
"mazmorras y fortalezas. Ahora, eres el último miembro de tu grupo."

