#: src/npctalk.cpp:778
msgid "Stay awake!"
msgstr "¡Mantente despierto!"

#: src/npctalk.cpp:787
msgid "Mount up!"
msgstr "¡Montar!"

#: src/npctalk.cpp:795
msgid "Dismount!"
msgstr "¡Desmontad!"

#: src/npctalk.cpp:801
msgid ""
"We're in danger.  Stay awake, stay close, don't go wandering off, and don't "
"open any doors."
msgstr ""
"Estamos en peligro. Manteneos despiertos, permaneced cerca, no os alejéis y "
"no abráis ninguna puerta."

#: src/npctalk.cpp:808
msgid "As you were."
msgstr "Descansen."

