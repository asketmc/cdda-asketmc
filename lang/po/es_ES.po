#. ~ Profession name for male
#: data/mods/package_bionic_professions/bionic_professions.json
msgctxt "profession_male"
msgid "Bionic Firefighter"
msgstr "Bombero Biónico"

#. ~ Description of profession "Bionic Firefighter" for male
#: data/mods/package_bionic_professions/bionic_professions.json
msgctxt "prof_desc_male"
msgid ""
"As a second-generation augmented firefighter, you have been cybernetically "
"enhanced to operate in the most dire of emergency situations.  You're pretty"
" sure this counts."
msgstr ""
"Como bombero aumentado de segunda generación, has sido mejorado "
"cibernéticamente para actuar en las situaciones de emergencia más graves. "
"Estás seguro de que esto cuenta."

#. ~ Profession name for female
#: data/mods/package_bionic_professions/bionic_professions.json
