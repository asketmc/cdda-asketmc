#: data/mods/Magiclysm/items/ethereal_items.json
msgid "magic lamp"
msgid_plural "magic lamps"
msgstr[0] "lámpara mágica"
msgstr[1] "lámparas mágicas"
msgstr[2] "lámparas mágicas"

#. ~ Description of "magic lamp"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "A magical light source that will light up a small area."
msgstr "Una fuente de luz mágica que iluminará una pequeña área."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "magic light"
msgid_plural "magic lights"
msgstr[0] "luz mágica"
msgstr[1] "luces mágicas"
msgstr[2] "luces mágicas"

#. ~ Description of "magic light"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "A small magical light that you can read by."
msgstr "Una pequeña luz mágica con la que puedes leer."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "large shield of magical ice"
msgid_plural "large shields of magical ice"
msgstr[0] "gran escudo de hielo mágico"
msgstr[1] "grandes escudos de hielo mágico"
msgstr[2] "grandes escudos de hielo mágico"

#. ~ Description of "large shield of magical ice"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "A lightweight but tough shield crafted entirely of magical ice."
msgstr "Un escudo ligero pero duro, fabricado enteramente de hielo mágico."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "slick icy coatings"
msgid_plural "slick icy coatings"
msgstr[0] "revestimiento de hielo resbaladizo"
msgstr[1] "revestimientos de hielo resbaladizo"
msgstr[2] "revestimientos de hielo resbaladizo"

#. ~ Description of "slick icy coatings"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A magical slick icy coating on your feet.  While quite fast on flat floors, "
"they make it difficult to move on rough terrain."
msgstr ""
"Un mágico y resbaladizo recubrimiento de hielo en tus pies. Aunque son "
"bastante rápidos en los suelos llanos, hacen difícil el movimiento en "
"terrenos escarpados."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "The Stormhammer"
msgid_plural "The Stormhammers"
msgstr[0] " El martillo de la tormenta"
msgstr[1] "Los martillos de la tormenta"
msgstr[2] "Los martillos de la tormenta"

#. ~ Description of "The Stormhammer"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A crackling magical warhammer full of lightning to smite your foes with, and"
" of course, smash things to bits!"
msgstr ""
"Un crepitante martillo mágico lleno de relámpagos para golpear a tus "
"enemigos y, por supuesto, aplastar cosas en trocitos."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "vicious tentacle whip"
msgid_plural "vicious tentacle whips"
msgstr[0] "látigo de tentáculos atroz"
msgstr[1] "látigos de tentáculos atroces"
msgstr[2] "látigos de tentáculos atroces"

#. ~ Description of "vicious tentacle whip"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A long, writhing, tentacle covered in sharp bonelike blades and spikey "
"protrusions."
msgstr ""
"Un tentáculo largo y retorcido, cubierto de hojas afiladas como huesos y "
"salientes en forma de espiga."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "flarewhip"
msgid_plural "flarewhips"
msgstr[0] "latigo de llamas"
msgstr[1] "latigos de llamas"
msgstr[2] "latigos de llamas"

#. ~ Description of "flarewhip"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A long whip made of blue-hot magical flames.  The heat is horrendous when "
"touching an enemy."
msgstr ""
"Un largo látigo hecho de llamas mágicas al rojo vivo. El calor es horrendo "
"cuando se golpea a un enemigo."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "flesh pouch"
msgid_plural "flesh pouches"
msgstr[0] "bolsa de carne"
msgstr[1] "bolsas de carne"
msgstr[2] "bolsas de carne"

#. ~ Description of "flesh pouch"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A large pouch of tough flesh on your back, filled with tiny tentacles that "
"grasp and hold anything you place inside.  It shifts and adjusts itself to "
"minimize encumbrance."
msgstr ""
"Una gran bolsa de carne dura en tu espalda, llena de pequeños tentáculos que"
" agarran y sostienen cualquier cosa que se coloque en su interior. Se "
"desplaza y se ajusta a sí misma para minimizar la incomodidad."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "Wicked Bonespear"
msgid_plural "Wicked Bonespears"
msgstr[0] "Lanza de Hueso Maldita"
msgstr[1] "Lanzas de Hueso Malditas"
msgstr[2] "Lanzas de Hueso Malditas"

#. ~ Description of "Wicked Bonespear"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "This is a wicked spear/halberd hybrid entirely created of bone."
msgstr ""
"Este es un híbrido malvado de lanza y alabarda creada enteramente de hueso."

#. ~ Name of a gun
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "Woodbow"
msgid_plural "Woodbows"
msgstr[0] "arco de madera"
msgstr[1] "Woodbows"
msgstr[2] "Woodbows"

#. ~ Description of gun "Woodbow"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A magically conjured ornate recurve bow of solid flexible wood.  A matching "
"conjured wooden arrow appears when you draw the string back for firing."
msgstr ""
"Un arco recurvo ornamentado mágicamente conjurado de madera maciza y "
"flexible. Una flecha de madera conjurada a juego aparece cuando se retira la"
" cuerda para disparar."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "seed of purification"
msgid_plural "seeds of purification"
msgstr[0] "semilla de purificación"
msgstr[1] "semillas de purificación"
msgstr[2] "semillas de purificación"

#. ~ Description of "seed of purification"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A magical seed that can be squeezed to release purifying dust, which can "
"then be used to purify up to a gallon of water."
msgstr ""
"Una semilla mágica que puede ser exprimida para liberar polvo purificador, "
"que puede ser usado para purificar hasta un 3.7 litros de agua."

#. ~ "menu_text" action message of item "seed of purification"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "Squeeze seed"
msgstr "Exprime la semilla"

#. ~ "msg" action message of item "seed of purification"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"You squeeze the seed in your palm, and it begins to turn to a fine dust."
msgstr ""
"Aprietas la semilla en la palma de tu mano, y comienza a convertirse en un "
"fino polvo."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "faintly glowing dust"
msgid_plural "faintly glowing dusts"
msgstr[0] "polvo ligeramente brillante"
msgstr[1] "polvos ligeramente brillantes"
msgstr[2] "polvos ligeramente brillantes"

#. ~ Description of "faintly glowing dust"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "This fine dust glows with a growing intensity."
msgstr "Este polvo fino brilla con una intensidad creciente."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "seed of growth"
msgid_plural "seeds of growth"
msgstr[0] "semilla de crecimiento"
msgstr[1] "semillas de crecimiento"
msgstr[2] "semillas de crecimiento"

#. ~ Description of "seed of growth"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A magical powder that can be scattered on growing crops and make them grow "
"faster."
msgstr ""
"Un polvo mágico que se puede esparcir sobre los cultivos en crecimiento para"
" hacerlos crecer más rápido."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "obfuscating aura"
msgid_plural "obfuscating auras"
msgstr[0] "aura de ofuscamiento"
msgstr[1] "auras de ofuscamiento"
msgstr[2] "auras de ofuscamiento"

#. ~ Description of "obfuscating aura"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"An all-encompassing, invisible layer of magic distorts light around your "
"body.  Allows you to dodge two extra attacks in a given turn."
msgstr ""
"Una capa de magia envolvente e invisible que distorsiona la luz alrededor de"
" tu cuerpo. Te permite esquivar dos ataques extra por turno."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "acid resistance aura"
msgid_plural "acid resistance auras"
msgstr[0] "aura de resistencia al ácido"
msgstr[1] "auras de resistencia al ácido"
msgstr[2] "auras de resistencia al ácido"

#. ~ Description of "acid resistance aura"
#. ~ Description of "greater acid resistance aura"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "An all-encompassing, invisible layer of protection against acid."
msgstr "Una capa envolvente e invisible de protección contra el ácido."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "greater acid resistance aura"
msgid_plural "greater acid resistance auras"
msgstr[0] "aura de resistencía al ácido mayor"
msgstr[1] "auras de resistencía al ácido mayor"
msgstr[2] "auras de resistencía al ácido mayor"

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "frost armor"
msgid_plural "frost armor"
msgstr[0] "armadura de escarcha"
msgstr[1] "armadura de escarcha"
msgstr[2] "armadura de escarcha"

#. ~ Description of "frost armor"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "A thin layer of magical ice, covering the entire body."
msgstr "Una fina capa de hielo mágico cubriendo el cuerpo entero."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "stoneskin coating"
msgid_plural "stoneskin coating"
msgstr[0] "revestimiento de piedra"
msgstr[1] "revestimientos de piedra"
msgstr[2] "revestimientos de piedra"

#. ~ Description of "stoneskin coating"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A thin layer of shifting, almost fluid living rock, covering the entire "
"body."
msgstr ""
"Una fina capa de roca viva cambiante, casi fluida, que cubre todo el cuerpo."

#. ~ Description of effect type "burn_scar"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "This burn really hurts!"
msgstr "¡Esta quemadura realmente duele!"

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "overcharge burn"
msgid_plural "overcharge burns"
msgstr[0] "quemadura sobrecargada"
msgstr[1] "quemaduras sobrecargadas"
msgstr[2] "quemaduras sobrecargadas"

#. ~ Description of "overcharge burn"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "Ouch, this really smarts!  It'll go away soon, maybe?"
msgstr "¡Ay, esto es muy inteligente! Pasará pronto, ¿no?"

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "aura of protection"
msgid_plural "auras of protection"
msgstr[0] "aura de protección"
msgstr[1] "auras de protección"
msgstr[2] "auras de protección"

#. ~ Description of "aura of protection"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"An all-encompassing, invisible layer of magical aura that protects you from "
"the environment."
msgstr ""
"Una capa envolvente e invisible de aura mágica te protege del ambiente."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "aura of repelling arc"
msgid_plural "auras of repelling arc"
msgstr[0] "aura de arco repelente"
msgstr[1] "auras de arco repelente"
msgstr[2] "auras de arco repelente"

#. ~ Description of "aura of repelling arc"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"An invisible aura that strikes melee attackers with arcs of electricity."
msgstr ""
"Un aura invisible que golpea a los atacantes c. a c. con arcos de "
"electricidad."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "feral aura"
msgid_plural "feral auras"
msgstr[0] "aura salvaje"
msgstr[1] "auras salvajes"
msgstr[2] "auras salvajes"

#. ~ Description of "feral aura"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"The manifestation of your rage.  It won't disappear until you calm down."
msgstr "La manifestación de tu furia. No desaparecerá hasta que te calmes."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "flaming sword"
msgid_plural "flaming swords"
msgstr[0] "espada llameante"
msgstr[1] "espadas llameantes"
msgstr[2] "espadas llameantes"

#. ~ Description of "flaming sword"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"This wooden sword is ablaze!  It seems to be safe-ish to hold, but will burn"
" up soon."
msgstr ""
"¡Esta espada de madera está en llamas! Parece que es segura de sostener, "
"pero se quemará pronto."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "decaying boneclub"
msgid_plural "decaying boneclubs"
msgstr[0] "garrote de hueso pútrido"
msgstr[1] "garrotes de hueso pútrido"
msgstr[2] "garrotes de hueso pútrido"

#. ~ Description of "decaying boneclub"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A pulsating club made of bone, stained with an ever-moving blood coating "
"eager to absorb the living."
msgstr ""
"Un garrote pulsante hecho de hueso, manchado con una capa de sangre en "
"constante movimiento, ansioso de absorber a los vivos."

#. ~ Name of a gun
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "impact sling"
msgid_plural "impact slings"
msgstr[0] "honda de impacto"
msgstr[1] "hondas de impacto"
msgstr[2] "hondas de impacto"

#. ~ Description of gun "impact sling"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A leather sling, quivering with energy when in your palm to the point of "
"almost tearing.  A pebble appears when you begin spinning it."
msgstr ""
"Una honda de cuero, que tiembla de energía cuando está en la palma de la "
"mano hasta casi desgarrarse. Cuando empiezas a hacerla girar, aparece un "
"guijarro."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "acid aura"
msgid_plural "acid auras"
msgstr[0] "aura ácida"
msgstr[1] "auras ácidas"
msgstr[2] "auras ácidas"

#. ~ Description of "acid aura"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"An aura of thin acid, swirling around your body ready to corrode when struck"
" or while striking."
msgstr ""
"Un aura de ácido fina, arremolinándose alrededor de tu cuerpo listo para "
"corroer cuando se te golpea o mientras tu golpeas."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "werewolf aura"
msgid_plural "werewolf auras"
msgstr[0] "aura hombre lobo"
msgstr[1] "auras hombre lobo"
msgstr[2] "auras hombre lobo"

#. ~ Description of "werewolf aura"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "You have become the werewolf.  Boys becoming men, men becoming wolves."
msgstr ""
"Te has convertido en el hombre lobo. Los chicos se convierten en hombres, "
"los hombres se convierten en lobos."

#. ~ Description of "Black Dragon Shell"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"An aura of black and green draconic energy, swirling around your body "
"protecting you and punishing those who strike you."
msgstr ""
"Un aura de energía draconiana negra y verde, arremolinándose alrededor de tu"
" cuerpo protegiéndote y castigando a los que te golpean."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "subzero talons"
msgid_plural "subzero talons"
msgstr[0] "garra bajo cero"
msgstr[1] "garras bajo cero"
msgstr[2] "garras bajo cero"

#. ~ Description of "subzero talons"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"Claws made from ice, able to freeze on contact while mauling foes.  You, "
"however, feel only a slight chill on your hands."
msgstr ""
"Garras hechas de hielo, capaces de congelar al contacto mientras se ataca a "
"los enemigos. Sin embargo, tu sólo sientes un ligero escalofrío en tus "
"manos."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "spiritual armor"
msgid_plural "spiritual armor"
msgstr[0] "armadura espiritual"
msgstr[1] "armaduras espirituales"
msgstr[2] "armaduras espirituales"

#. ~ Description of "spiritual armor"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "A summoned medieval armor.  It glows softly and looks sturdy."
msgstr "Una armadura medieval invocada. Brilla levemente y parece robusta."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "jar of force"
msgid_plural "jars of force"
msgstr[0] "tarro de fuerza"
msgstr[1] "tarros de fuerza"
msgstr[2] "tarros de fuerza"

#. ~ Description of "jar of force"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A three-liter container made out of transparent force.  Can be used to store"
" liquids."
msgstr ""
"Un recipiente de tres litros hecho de fuerza transparente. Puede utilizarse "
"para almacenar líquidos."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "holy sword"
msgid_plural "holy swords"
msgstr[0] "espada sagrada"
msgstr[1] "espadas sagradas"
msgstr[2] "espadas sagradas"

#. ~ Description of "holy sword"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"This is a summoned medieval sword, between the lighter arming sword and "
"later two-handed swords in size.  It glows slightly and its edge is "
"exceedingly sharp."
msgstr ""
"Esta es una espada medieval invocada, entre la espada de caballero más "
"ligera y las grandes espadas de dos manos en tamaño. Brilla ligeramente y su"
" filo es extremadamente afilado."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "auroral shell"
msgid_plural "auroral shell"
msgstr[0] "caparazón aurora"
msgstr[1] "caparazones aurora"
msgstr[2] "caparazones aurora"

#. ~ Description of "auroral shell"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "A sturdy shell that wraps your body, gaining a sturdy defense."
msgstr ""
"Un robusto caparazón que envuelve tu cuerpo, ganando una robusta defensa."

#. ~ Description of "Pocket Sun"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A small, capsule-shaped field containing a stable portal to the sun.  You "
"can feel a solar energy radiate from it, and it saturate your body."
msgstr ""

#. ~ "menu_text" action message of item "Pocket Sun"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "Cover"
msgstr "Cubrir"

#. ~ "msg" action message of item "Pocket Sun"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "You cover the pocket sun, and now the gap doesn't emit light."
msgstr "Tapas el sol de bolsillo y ahora el hueco no emite luz."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "Covered Pocket Sun"
msgid_plural "Covered Pocket Suns"
msgstr[0] "Sol de Bolsillo Cubierto"
msgstr[1] "Soles de Bolsillo Cubiertos"
msgstr[2] "Soles de Bolsillo Cubiertos"

#. ~ Description of "Covered Pocket Sun"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A small, capsule-shaped field containing a stable portal to the sun.  It is "
"currently covered."
msgstr ""
"Un pequeño campo en forma de cápsula que contiene un portal estable hacia el"
" sol. Actualmente está cubierto."

#. ~ "menu_text" action message of item "Covered Pocket Sun"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "Relieve"
msgstr "Alivio"

#. ~ "msg" action message of item "Covered Pocket Sun"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"You remove the cover on the pocket sun, and now the gap emits light again."
msgstr ""
"Quitas la tapa del sol de bolsillo y ahora el hueco vuelve a emitir luz."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "magical throwing knife"
msgid_plural "magical throwing knives"
msgstr[0] "cuchillo arrojadizo mágico"
msgstr[1] "cuchillos arrojadizos mágicos"
msgstr[2] "cuchillos arrojadizos mágicos"

#. ~ Description of "magical throwing knife"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A thin and flat knife made for throwing, wrapped in ethereal flames.  Its "
"ineffective cutting edge and odd shape makes it unsuitable for use as a "
"tool."
msgstr ""
"Un cuchillo delgado y plano hecho para lanzar, envuelto en llamas etéreas. "
"Su ineficaz filo y su extraña forma lo hacen inadecuado para su uso como "
"herramienta."

#. ~ Description of "magical throwing knife"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A thin and flat knife made for throwing, emanates cold.  Its ineffective "
"cutting edge and odd shape makes it unsuitable for use as a tool."
msgstr ""
"Un cuchillo delgado y plano hecho para lanzar, emana frío. Su ineficaz filo "
"y su extraña forma lo hacen inadecuado para su uso como herramienta."

#. ~ Description of "magical throwing knife"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A thin and flat knife with wide edge made for throwing, seems unnaturally "
"sharp.  Its ineffective cutting edge and odd shape makes it unsuitable for "
"use as a tool."
msgstr ""
"Un cuchillo delgado y plano con un ancho filo hecho para lanzar, parece "
"antinaturalmente afilado. Su ineficaz filo y su extraña forma lo hacen "
"inadecuado para su uso como herramienta."

#. ~ Description of "magical throwing knife"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A thin and flat knife made for throwing, made of porous substance and "
"covered in dark ooze.  Its ineffective cutting edge and odd shape makes it "
"unsuitable for use as a tool."
msgstr ""
"Cuchillo delgado y plano hecho para lanzar, fabricado con una sustancia "
"porosa y recubierto de un residuo oscuro. Su ineficaz filo y su extraña "
"forma lo hacen inadecuado para su uso como herramienta."

#. ~ Description of "magical throwing knife"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A transparent blade seems to radiate intent to be thrown.  Its ineffective "
"cutting edge and odd shape makes it unsuitable for use as a tool."
msgstr ""
"Una hoja transparente que parece irradiar la intención de ser lanzada. Su "
"ineficaz filo y su extraña forma la hacen inadecuada para su uso como "
"herramienta."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "earthshaper's hammer"
msgid_plural "earthshaper's hammers"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "earthshaper's hammer"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"Shaped with your own magic, this tool has the same abilities as the common "
"hammer."
msgstr ""

#. ~ "menu_text" action message of item "earthshaper's hammer"
