msgid "survivor giant firefly lamp"
msgid_plural "survivor giant firefly lamps"
msgstr[0] "lámpara de luciérnaga gigante de sup."
msgstr[1] "lámparas de luciérnaga gigante de sup."
msgstr[2] "lámparas de luciérnaga gigante de sup."

