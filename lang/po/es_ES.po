msgid_plural "shoulder straps (front)"
msgstr[0] "bandolera (frente)"
msgstr[1] "bandoleras (frente)"
msgstr[2] "bandoleras (frente)"

#. ~ Description of gun mod "shoulder strap (front)"
#: data/json/items/gunmod/sling.json
msgid ""
"A shoulder strap allows the rifle to be worn over your shoulders like a "
"piece of clothing.  Currently adjusted so the weapon hangs off your front."
msgstr ""
"Una correa para el hombro que permite colgarse un rifle en uno de los "
"hombros como si fuera ropa. En este momento, está ajustada para que el arma "
"cuelgue en tu parte delantera."

#. ~ Gun mod name
#: data/json/items/gunmod/stock.json
