msgstr ""
"Es una pipa tallada de madera. Está diseñada para facilitar el consumo de "
"hojas curadas de tabaco."

#. ~ Item name
#: data/json/items/tool/stationary.json
msgid "stapler"
msgid_plural "staplers"
msgstr[0] "grapadora"
msgstr[1] "grapadoras"
msgstr[2] "grapadoras"

#. ~ Description of "stapler"
