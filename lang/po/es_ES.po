msgid_plural "folding stocks (folded)"
msgstr[0] "culata plegable (plegada)"
msgstr[1] "culatas plegables (plegadas)"
msgstr[2] "culatas plegables (plegadas)"

#. ~ Description of gun mod "folding stock (folded)"
#: data/json/items/gunmod/stock.json
msgid ""
"A folding stock which reduces length.  Currently folded, making shooting "
"this gun difficult."
msgstr ""
"Una culata plegable que reduce la longitud del arma. Ahora está plegada lo "
"que dificulta su uso."

#. ~ Gun mod name
#: data/json/items/gunmod/stock.json
msgid "modular folding stock"
msgid_plural "modular folding stocks"
msgstr[0] "culata plegable modular"
msgstr[1] "culatas plegables modulares"
msgstr[2] "culatas plegables modulares"

#. ~ Description of gun mod "modular folding stock"
#: data/json/items/gunmod/stock.json
msgid ""
"A multi position, high-end folding stock which reduces length when folded.  "
"Currently unfolded and ready to shoot."
msgstr ""
"Una culata plegable de múltiple posición y alta gama que reduce la longitud "
"del arma cuando está plegada. Ahora está desplegada y lista para disparar."

#. ~ Gun mod name
#: data/json/items/gunmod/stock.json
msgid "modular folding stock (folded)"
msgid_plural "modular folding stocks (folded)"
msgstr[0] "culata plegable modular (plegada)"
msgstr[1] "culatas plegables modulares (plegadas)"
msgstr[2] "culatas plegables modulares (plegadas)"

#. ~ Description of gun mod "modular folding stock (folded)"
#: data/json/items/gunmod/stock.json
msgid ""
"A multi position, high-end folding stock which reduces length when folded.  "
"Currently folded, making shooting this gun hard."
msgstr ""
"Una culata plegable de múltiple posición y alta gama que reduce la longitud "
"del arma cuando está plegada. Ahora está plegada lo que dificulta su uso."

#. ~ Gun mod name
#: data/json/items/gunmod/stock.json
msgid "collapsing wire stock"
msgid_plural "collapsing wire stocks"
msgstr[0] "culata plegable de alambre"
msgstr[1] "culatas plegables de alambre"
msgstr[2] "culatas plegables de alambre"

#. ~ Description of gun mod "collapsing wire stock"
#: data/json/items/gunmod/stock.json
msgid ""
"A collapsing wire stock which folds closely against the body of the weapon, "
"reducing length and volume."
msgstr ""
"Una culata plegable de alambre que se dobla contra el cuerpo del arma para "
"reducir mucho la longitud y el volumen."

#. ~ Gun mod name
#: data/json/items/gunmod/stock.json
msgid "collapsing wire stock (collapsed)"
msgid_plural "collapsing wire stocks (collapsed)"
msgstr[0] "culata plegable de alambre (plegada)"
msgstr[1] "culatas plegables de alambre (plegadas)"
msgstr[2] "culatas plegables de alambre (plegadas)"

#. ~ Description of gun mod "collapsing wire stock (collapsed)"
#: data/json/items/gunmod/stock.json
msgid ""
"A collapsing wire stock which folds closely against the body of the weapon, "
"reducing length and volume.  Currently collapsed, making shooting difficult"
msgstr ""
"Una culata plegable de alambre que se dobla contra el cuerpo del arma para "
"reducir mucho la longitud y el volumen. En este momento está plegada lo que "
"dificulta su uso."

#. ~ Gun mod name
#: data/json/items/gunmod/stock.json
msgid "sawn-off stock"
msgid_plural "sawn-off stocks"
msgstr[0] "culata recortada"
msgstr[1] "culatas recortadas"
msgstr[2] "culatas recortadas"

#. ~ Description of gun mod "sawn-off stock"
#: data/json/items/gunmod/stock.json
msgid ""
"A quick saw cut removed the original stock from this weapon.  It is now much"
" harder to handle, but much smaller."
msgstr ""
"Un simple corte quitó la culata original de este arma. Ahora es mucho más "
"difícil de manejar pero mucho más pequeña."

#. ~ Gun mod name
#: data/json/items/gunmod/stock.json
msgid "pistol stock"
msgid_plural "pistol stocks"
msgstr[0] "culata para pistola"
msgstr[1] "culatas para pistola"
msgstr[2] "culatas para pistola"

#. ~ Description of gun mod "pistol stock"
#: data/json/items/gunmod/stock.json
msgid ""
"An add-on stock for handguns, this considerably improves control of recoil."
msgstr ""
"Una culata para pistolas que mejora considerablemente el control del "
"retroceso."

#. ~ Gun mod name
#: data/json/items/gunmod/stock.json
msgid "recoil stock"
msgid_plural "recoil stocks"
msgstr[0] "culata de retroceso"
msgstr[1] "culatas de retroceso"
msgstr[2] "culatas de retroceso"

#. ~ Description of gun mod "recoil stock"
#: data/json/items/gunmod/stock.json
msgid "A replacement stock designed to absorb perceived recoil."
msgstr "Un reemplazo diseñado para absorber el retroceso percibido."

#. ~ Gun mod name
#: data/json/items/gunmod/stock.json
msgid "cheek pad"
msgid_plural "cheek pads"
msgstr[0] "almohadilla de mejilla"
msgstr[1] "almohadillas de mejillas"
msgstr[2] "almohadillas de mejillas"

#. ~ Description of gun mod "cheek pad"
#: data/json/items/gunmod/stock.json
msgid ""
"A stock accessory for sniper rifles and DMRs, this considerably improves eye"
" relief efficiency, prevents slipping, and reduces recoil to the neck and "
"cheek."
msgstr ""
"Un accesorio de culata para rifles de francotirador e incluso DMR que mejora"
" considerablemente la eficiencia del alivio de los ojos, evita el "
"deslizamiento y reduce el retroceso al cuello y la mejilla."

#. ~ Gun mod name
#: data/json/items/gunmod/stock.json
msgid "butt hook"
msgid_plural "butt hooks"
msgstr[0] "gancho de culata"
msgstr[1] "ganchos de culata"
msgstr[2] "ganchos de culata"

#. ~ Description of gun mod "butt hook"
#: data/json/items/gunmod/stock.json
msgid ""
"An attachment to the butt of the gun that is held under the armpit, "
"improving stability."
msgstr ""
"Un accesorio para la culata del arma que se coloca bajo la axila permitiendo"
" una mayor estabilidad."

#. ~ Gun mod name
#: data/json/items/gunmod/stock.json
msgid "tail hook stock"
msgid_plural "tail hook stocks"
msgstr[0] "culata de ganchos de cola"
msgstr[1] "culata de ganchos de cola"
msgstr[2] "culata de ganchos de cola"

#. ~ Description of gun mod "tail hook stock"
#: data/json/items/gunmod/stock.json
msgid ""
"A foldable add-on stock for handguns and machine guns with a pivoting hook "
"that latches onto the forearm, allowing for greater stability."
msgstr ""
"Una culata plegable para armas de mano y ametralladoras con un gancho que "
"gira y se ajusta al antebrazo permitiendo mejor estabilidad."

#. ~ Gun mod name
#: data/json/items/gunmod/stock.json
msgid "under folding stock"
msgid_plural "under folding stocks"
msgstr[0] "culata inferior plegable"
msgstr[1] "culatas inferiores plegables"
msgstr[2] "culatas inferiores plegables"

#. ~ Description of gun mod "under folding stock"
#: data/json/items/gunmod/stock.json
msgid ""
"A light wire-framed stock with a push button release catch on the side  "
"which allows it to fold and be stored away under the weapon's receiver.  The"
" wire construction means that it’s less comfortable to shoulder than a "
"regular fixed attachment.  The stock is currently locked in the open "
"position."
msgstr ""
"Una culata liviana de alambre con un botón en el costado que te permite "
"plegarla y guardarla debajo del receptor del arma. La construcción de "
"alambre la hace más incómoda de usar que una regular. En este momento la "
"culata está abierta."

#. ~ Gun mod name
#: data/json/items/gunmod/stock.json
msgid "under-folding stock (folded)"
msgid_plural "under-folding stocks (folded)"
msgstr[0] "culata inferior plegable (plegada)"
msgstr[1] "culatas inferiores plegables (plegadas)"
msgstr[2] "culatas inferiores plegables (plegadas)"

#. ~ Description of gun mod "under-folding stock (folded)"
#: data/json/items/gunmod/stock.json
msgid ""
"A light wire-framed stock with a push button release catch on the side  "
"which allows it to fold and be stored away under the weapon's receiver.  It "
"is currently folded underneath the weapon's chassis, making it more "
"difficult to control."
msgstr ""
"Una culata ligera de alambre con un botón en el lateral que te permite "
"plegarla y guardarla debajo del receptor del arma. En este momento está "
"plegada debajo del armazón del arma lo que la hace más difícil de controlar."

#. ~ Gun mod name
#: data/json/items/gunmod/stock.json
msgid "integral folding mechanism"
msgid_plural "integral folding mechanisms"
msgstr[0] "mecanismo plegable integral"
msgstr[1] "mecanismos plegables integrales"
msgstr[2] "mecanismos plegables integrales"

#. ~ Description of gun mod "integral folding mechanism"
#: data/json/items/gunmod/stock.json
msgid ""
"The integral series of hinges and pivots which allow the SUB-2000 to fold in"
" half and be stored for transport.  The firearm is currently locked in the "
"unfolded position and is ready for use."
msgstr ""
"Un conjunto integral de bisagras y ejes que permiten que el SUB-2000 se "
"pliegue a la mitad y facilite su almacenamiento. El arma está en este "
"momento desplegada y lista para ser usada."

#. ~ Target of gun mod "integral folding mechanism"
#. ~ Target of gun mod "integral folding mechanism (folded))"
#: data/json/items/gunmod/stock.json
msgctxt "gun_type_type"
msgid "ksub2000"
msgstr "ksub2000"

#. ~ Gun mod name
#: data/json/items/gunmod/stock.json
msgid "integral folding mechanism (folded))"
msgid_plural "integral folding mechanisms (folded)"
msgstr[0] "mecanismo plegable integral (plegado)"
msgstr[1] "mecanismos plegables integrales (plegados)"
msgstr[2] "mecanismos plegables integrales (plegados)"

#. ~ Description of gun mod "integral folding mechanism (folded))"
#: data/json/items/gunmod/stock.json
msgid ""
"The integral series of hinges and pivots which allow the SUB-2000 to fold in"
" half and be stored for transport.  Shooting this firearm would be "
"particularly tricky given that the barrel assembly is folded and locked "
"backwards for storage, rendering the weapon inoperable."
msgstr ""
"Un conjunto integral de bisagras y ejes que permiten que el SUB-2000 se "
"pliegue a la mitad y facilite su almacenamiento. Disparar esta arma va a ser"
" particularmente difícil dado que el cañón está plegado y trabado hacia "
"atrás para almacenar el arma, dejándola inoperable."

#. ~ Firing mode of gun mod "integral folding mechanism (folded))"
#: data/json/items/gunmod/stock.json
msgid "disabled"
msgstr "desactivado"

#. ~ Gun mod name
#: data/json/items/gunmod/stock.json
msgid "MASS compatible stock"
msgid_plural "MASS compatible stocks"
msgstr[0] "culata compatible MASS"
msgstr[1] "culatas compatibles MASS"
msgstr[2] "culatas compatibles MASS"

#. ~ Description of gun mod "MASS compatible stock"
#: data/json/items/gunmod/stock.json
msgid ""
"A specially designed adjustable stock with an integrated grip to convert the"
" M26-MASS to a standalone configuration."
msgstr ""
"Una culata ajustable especialmente diseñada con mango integrado para "
"convertir la M26-MASS a su configuración independiente."

#. ~ Target of gun mod "MASS compatible stock"
#: data/json/items/gunmod/stock.json
msgctxt "gun_type_type"
msgid "m26_mass_standalone"
msgstr "m26_mass_standalone"

#. ~ Gun mod name
#: data/json/items/gunmod/underbarrel.json
msgid "bipod"
msgid_plural "bipods"
msgstr[0] "bípode"
msgstr[1] "bípodes"
msgstr[2] "bípodes"

#. ~ Description of gun mod "bipod"
#: data/json/items/gunmod/underbarrel.json
msgid ""
"Bipods are commonly used on rifles and machine guns to provide a forward "
"rest and reduce motion.  Although they greatly improve handling of recoil, "
"they are usable only on certain surfaces (or from the prone position), and "
"are slow to equip."
msgstr ""
"Los bípodes se utilizan habitualmente en rifles y ametralladoras para "
"proporcionar un apoyo delantero y reducir el movimiento. Aunque mejoran en "
"gran medida el manejo del retroceso, sólo son utilizables en ciertas "
"superficies (o desde la posición boca abajo), y son lentos de equipar."

#. ~ Gun mod name
#: data/json/items/gunmod/underbarrel.json
msgid "modified bipod"
msgid_plural "modified bipods"
msgstr[0] "bípode modificado"
msgstr[1] "bípodes modificados"
msgstr[2] "bípodes modificados"

#. ~ Description of gun mod "modified bipod"
#: data/json/items/gunmod/underbarrel.json
msgid ""
"Bipods are commonly used on rifles and machine guns to provide a forward "
"rest and reduce motion.  Although they greatly improve handling of recoil, "
"they are usable only on certain surfaces (or from the prone position), and "
"are slow to equip.  This one was modified and customized to mount on pretty "
"much any weapon, if you so want."
msgstr ""
"Los bípodes se utilizan comúnmente en los rifles y las ametralladoras para "
"proporcionar un descanso delantero y reducir el movimiento. Aunque mejoran "
"enormemente el manejo del retroceso, sólo son utilizables en ciertas "
"superficies y son lentos de equipar. Este fue modificado y personalizado "
"para montarlo en casi cualquier arma, si así lo deseas. Este ha sido "
"modificado y personalizado para ser montado en casi cualquier arma, si así "
"lo quieres."

#. ~ Gun mod name
#: data/json/items/gunmod/underbarrel.json
msgid "bipod hand guard"
msgid_plural "bipod hand guards"
msgstr[0] "bípode con guardamano"
msgstr[1] "bípodes con guardamano"
msgstr[2] "bípodes con guardamano"

#. ~ Description of gun mod "bipod hand guard"
#: data/json/items/gunmod/underbarrel.json
msgid ""
"Bipods are commonly used on rifles and machine guns to provide a forward "
"rest and reduce motion.  Although they greatly improve handling of recoil, "
"they are usable only on certain surfaces (or from the prone position).  This"
" one is integrated into a high end hand guard, replacing the factory hand "
"guard of your weapon, allowing for comfortable shooting with or without the "
"bipod deployed.  Currently the bipod legs are stowed."
msgstr ""
"Los bípodes son usados comúnmente en los rifles y ametralladoras, para "
"proveer de un apoyo delante y reducir el movimiento. Aunque mejoran mucho el"
" manejo del retroceso, solo pueden usarse en ciertas superficies (o tirado "
"cuerpo a tierra). Este tiene un guardamanos integrado que reemplaza el del "
"arma, lo que te permite un disparo cómodo con o sin el bípode desplegado. En"
" este momento, las patas del bípode están guardadas."

#. ~ Gun mod name
#: data/json/items/gunmod/underbarrel.json
msgid "bipod hand guard (deployed)"
msgid_plural "bipod hand guards (deployed)"
msgstr[0] "bípode con guardamano (desplegado)"
msgstr[1] "bípodes con guardamano (desplegados)"
msgstr[2] "bípodes con guardamano (desplegados)"

#. ~ Description of gun mod "bipod hand guard (deployed)"
#: data/json/items/gunmod/underbarrel.json
msgid ""
"Bipods are commonly used on rifles and machine guns to provide a forward "
"rest and reduce motion.  Although they greatly improve handling of recoil, "
"they are usable only on certain surfaces (or from the prone position).  This"
" one is integrated into a high end hand guard, replacing the factory hand "
"guard of your weapon, allowing for comfortable shooting with or without the "
"bipod deployed.  Currently the bipod legs are out and are ready for use."
msgstr ""
"Los bípodes son usados comúnmente en los rifles y ametralladoras, para "
"proveer de un apoyo delante y reducir el movimiento. Aunque mejoran mucho el"
" manejo del retroceso, solo pueden usarse en ciertas superficies (o tirado "
"cuerpo a tierra). Este tiene un guardamanos integrado que reemplaza el del "
"arma, lo que te permite un disparo cómodo con o sin el bípode desplegado. En"
" este momento, las patas del bípode están listas para ser usadas."

#. ~ Gun mod name
#: data/json/items/gunmod/underbarrel.json
msgid "high end hand guard"
msgid_plural "high end hand guards"
msgstr[0] "guardamano de gama alta"
msgstr[1] "guardamanos de gama alta"
msgstr[2] "guardamanos de gama alta"

#. ~ Description of gun mod "high end hand guard"
#: data/json/items/gunmod/underbarrel.json
msgid ""
"A comfortable, high end hand guard with a set of optional mounts for "
"accessories and equipment.  When installed, this replaces the original "
"factory hand guard for the weapon, cutting down on excessive rails and "
"weight.  This allows for comfortable, controlled firing of the weapon while "
"keeping a sleek profile and avoiding bulky foregrips."
msgstr ""
"Un cómodo guardamanos de alta gama con un conjunto de monturas opcionales "
"para accesorios y equipamiento. Cuando está instalado, este reemplaza el "
"guardamanos original del arma, reduciendo las monturas excesivas y el peso. "
"Esto permite un disparo más cómodo y controlado mientras mantiene un perfil "
"elegante y evita mangos voluminosos."

#. ~ Gun mod name
#: data/json/items/gunmod/underbarrel.json
#: data/mods/Generic_Guns/gunmods/gunmods.json
msgid "combination gun shotgun"
msgid_plural "combination gun shotguns"
msgstr[0] "escopeta combinada"
msgstr[1] "escopetas combinadas"
msgstr[2] "escopetas combinadas"

#. ~ Description of gun mod "combination gun shotgun"
#: data/json/items/gunmod/underbarrel.json
msgid ""
"The integrated underbarrel shotgun of a combination gun which holds two "
"shots.  It's irremovable."
msgstr ""
"Es una escopeta integrada bajo cañón de un arma combinada que solo tiene dos"
" disparos. No se puede quitar."

#. ~ Gun mod name
#: data/json/items/gunmod/underbarrel.json
msgid "factory handguard"
msgid_plural "factory handguards"
msgstr[0] "guardamano de fábrica"
msgstr[1] "guardamanos de fábrica"
msgstr[2] "guardamanos de fábrica"

#. ~ Description of gun mod "factory handguard"
#: data/json/items/gunmod/underbarrel.json
msgid ""
"A removable molded grip that comes standard on guns without rails.  It's not"
" as efficient as a proper forward grip or bipod at controlling recoil, but "
"it's better than nothing."
msgstr ""
"Una empuñadura moldeada extraíble que viene de serie en las armas sin "
"raíles. No es tan eficiente como una empuñadura delantera adecuada o un "
"bípode para controlar el retroceso, pero es mejor que nada."

#. ~ Target of gun mod "factory handguard"
#: data/json/items/gunmod/underbarrel.json
msgctxt "gun_type_type"
msgid "fs2000"
msgstr "fs2000"

#. ~ Gun mod name
#: data/json/items/gunmod/underbarrel.json
msgid "forward grip"
msgid_plural "forward grips"
msgstr[0] "agarre delantero"
msgstr[1] "agarres delanteros"
msgstr[2] "agarres delanteros"

#. ~ Description of gun mod "forward grip"
#: data/json/items/gunmod/underbarrel.json
msgid ""
"A grip placed forward on the barrel allows for greater control.  Not as "
"effective as a bipod but usable under all conditions."
msgstr ""
"Una empuñadura colocada hacia delante en el barril que permite un mayor "
"control. No es tan eficaz como un bípode pero utilizable en todas las "
"condiciones."

#. ~ Gun mod name
#: data/json/items/gunmod/underbarrel.json
msgid "modified forward grip"
msgid_plural "modified forward grips"
msgstr[0] "agarre delantero modificado"
msgstr[1] "agarres delanteros modificados"
msgstr[2] "agarres delanteros modificados"

#. ~ Description of gun mod "modified forward grip"
#: data/json/items/gunmod/underbarrel.json
msgid ""
"A grip placed forward on the barrel allows for greater control.  Not as "
"effective as a bipod but usable under all conditions.  This one was modified"
" and customized to mount on pretty much any weapon, if you so want."
msgstr ""
"Un agarre colocado hacia adelante en el cañón permite un mayor control. No "
"es tan efectivo como un bípode, pero se puede usar en todas las condiciones."
" Este fue modificado y personalizado para montarlo en casi cualquier arma, "
"si así lo desea."

#. ~ Gun mod name
#: data/json/items/gunmod/underbarrel.json
msgid "wood forward grip"
msgid_plural "wood forward grips"
msgstr[0] "agarre delantero de madera"
msgstr[1] "agarres delanteros de madera"
msgstr[2] "agarres delanteros de madera"

#. ~ Description of gun mod "wood forward grip"
#: data/json/items/gunmod/underbarrel.json
msgid ""
"A wooden grip placed forward on the barrel allows for greater control.  Not "
"as effective as a bipod but usable under all conditions.  This one was "
"cleverly handmade by a desperate survivor or miserly enthusiast, it cannot "
"be removed after installation."
msgstr ""
