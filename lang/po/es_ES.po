msgid_plural "bandages"
msgstr[0] "vendaje"
msgstr[1] "vendajes"
msgstr[2] "vendajes"

#. ~ Description of "bandage"
#: data/json/items/comestibles/med.json
msgid ""
"A sterile cloth bandage.  Used for stopping blood loss and protecting wounds"
" from aggravation to help them heal faster."
msgstr ""
"Una venda común de tela esterilizada.  Se usa para detener hemorragias, "
"proteger las heridas para que no empeoren y se curen más rápidamente."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "makeshift bandage"
msgid_plural "makeshift bandages"
msgstr[0] "vendaje improvisado"
msgstr[1] "vendajes improvisados"
msgstr[2] "vendajes improvisados"

#. ~ Description of "makeshift bandage"
#: data/json/items/comestibles/med.json
msgid ""
"A reasonably clean piece of cloth wrapped for use as a simple bandage.  "
"Better than nothing."
msgstr ""
"Un pedazo de tela razonablemente limpio enrollado para usar como una venda "
"común.  Mejor que nada."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "bleached makeshift bandage"
msgid_plural "bleached makeshift bandages"
