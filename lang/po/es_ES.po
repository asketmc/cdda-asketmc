#. ~ Snippet in category "lab_postit_migo"
#: data/json/snippets/lab.json
msgid "Blast with white noise as a deterrent?"
msgstr "¿Disparar con ruido blanco como elemento disuasorio?"

#. ~ Snippet in category "lab_postit_migo"
#: data/json/snippets/lab.json
msgid "Likes it warm, not bothered by cold"
msgstr "Le gusta el calor, no le molesta el frío"

#. ~ Snippet in category "lab_postit_portal"
#: data/json/snippets/lab.json
