#. ~ Description of "hi-vis vest"
#: data/mods/Aftershock/items/armor/civilian_blue_collar.json
msgid ""
"A bright orange winter vest with several front facing pockets.  Not even "
"close to warm enough."
msgstr ""

#. ~ Item name
#: data/mods/Aftershock/items/armor/civilian_blue_collar.json
msgid "company jacket"
msgid_plural "company jackets"
msgstr[0] ""
