#. ~ Profession name for male
#: data/json/professions.json
msgctxt "profession_male"
msgid "Death Row Convict"
msgstr "Condenado a muerte"

#. ~ Description of profession "Death Row Convict" for male
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You were a serial killer, ready to walk the green mile, but in a twist of "
"fate you're one of the few still alive.  True death comes only from your "
"hands, so you're in for a job."
msgstr ""
"Eras un asesino en serie, dispuesto a recorrer la milla verde, pero en un "
"giro del destino eres uno de los pocos que siguen vivos. La verdadera muerte"
" sólo viene de tus manos, así que te toca trabajar."

#. ~ Profession name for female
#: data/json/professions.json
msgctxt "profession_female"
msgid "Death Row Convict"
msgstr "Condenada a muerte"

#. ~ Description of profession "Death Row Convict" for female
#: data/json/professions.json
msgctxt "prof_desc_female"
msgid ""
"You were a serial killer, ready to walk the green mile, but in a twist of "
