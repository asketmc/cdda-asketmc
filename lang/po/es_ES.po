msgstr[1] "Vendajes improvisados blanqueados"
msgstr[2] "Vendajes improvisados blanqueados"

#. ~ Description of "bleached makeshift bandage"
#: data/json/items/comestibles/med.json
msgid ""
"A piece of cloth treated with a bleach solution to sterilize it for use as a"
" bandage."
msgstr ""
"Un pedazo de tela tratado con una solución de lejía para esterilizarlo y "
"poder usarlo como venda."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "boiled makeshift bandage"
msgid_plural "boiled makeshift bandages"
msgstr[0] "vendaje improvisado hervido"
msgstr[1] "vendajes improvisados hervidos"
msgstr[2] "vendajes improvisados hervidos"

#. ~ Description of "boiled makeshift bandage"
#: data/json/items/comestibles/med.json
msgid "A piece of cloth boiled in water to sterilize it for use as a bandage."
msgstr ""
"Un pedazo de tela hervido en agua para esterilizarlo y poder usarlo como "
"venda."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "antiseptic powder"
msgid_plural "antiseptic powder"
msgstr[0] "polvo antiséptico"
msgstr[1] "polvo antiséptico"
msgstr[2] "polvo antiseptico"

#. ~ Description of "antiseptic powder"
#: data/json/items/comestibles/med.json
msgid ""
"A powdered form of chemical antiseptic, this bismuth formic iodide cleans "
"wounds quickly and painlessly."
msgstr ""
"Una forma en polvo de antiséptico químico, este yoduro fórmico de bismuto "
"limpia las heridas rápidamente y sin dolor."

#. ~ Item name
#: data/json/items/comestibles/med.json
#: data/mods/My_Sweet_Cataclysm/sweet_comestibles.json
msgid "caffeinated chewing gum"
msgid_plural "caffeinated chewing gums"
