#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Mommy?\""
msgstr "\"¿Mami?\""

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Come on, wake up…\""
msgstr "\"Vamos, despierta...\""

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Please help me.\""
msgstr "\"Por favor, ayúdame.\""

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"It's so cold.\""
msgstr "\"Hace mucho frío.\""

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Take my hand.\""
msgstr "\"Toma mi mano.\""

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Cover your head, everyone!\""
msgstr "\"¡Cúbranse la cabeza, todos!\""

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"I love you and I'll never forget you.\""
msgstr "\"Te amo y nunca te olvidaré.\""

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Put it down!  We can talk about this…\""
msgstr "\"¡Deja eso! Podemos hablar…\""

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"It'll be over quick.  I promise.\""
msgstr "\"Va a ser rápido. Te lo prometo.\""

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "agonized screaming!"
msgstr "un grito agonizante!"

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"I DON'T WANT TO DIE!\""
msgstr "\"¡NO QUIERO MORIR!\""

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"HELP!  HEEEEELP!\""
msgstr "\"!AYUDA! !AYUDAAAA!\""

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"What IS that?\""
msgstr "\"¿Qué ES eso?\""

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Here!  Someone's here!\""
msgstr "\"!Aquí! ¡Hay alguien aquí!\""

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Come on, come on, they can help us!\""
msgstr "\"¡Vamos, vamos, ellos pueden ayudarnos!\""

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Get it OFF ME!\""
msgstr "\"¡Quítamelo de ENCIMA!\""

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Don't look at the sky!\""
msgstr "\"¡No mires el cielo!\""

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Hello?  Hello?!\""
msgstr "\"¡¿Hola? ¿Hola?!\""

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "quiet crying."
msgstr "un llanto suave."

#. ~ Speech from speaker mon_feral_big_pappy
#: data/json/speech.json
msgid "\"I'm 'bout to walk 15 miles both ways across yer ass!\""
msgstr "\"¡Estoy a punto de cruzar 15 millas de ida y vuelta por tu culo!\""

#. ~ Speech from speaker mon_feral_granny
#: data/json/speech.json
msgid "\"Do you want a cookie, honey?\""
msgstr "\"¿Quieres una galleta, cariño?\""

#. ~ Speech from speaker mon_feral_granny
#: data/json/speech.json
msgid "\"You're looking feverish.  Let grandma make you some soup.\""
msgstr "\"Pareces tener fiebre. Deja que la abuela te haga un poco de sopa\"."

#. ~ Speech from speaker mon_feral_granny
#: data/json/speech.json
msgid "\"The nice doctor told me he had invented an anti-aging powder!\""
msgstr ""
"\"¡El amable doctor me dijo que había inventado un polvo "
"antienvejecimiento!\""

#. ~ Speech from speaker mon_feral_granny
#: data/json/speech.json
msgid "\"Are you here to bring me home?\""
msgstr "\"¿Viniste para llevarme a casa?\""

#. ~ Speech from speaker mon_feral_granny
#: data/json/speech.json
msgid "\"Give gramma some sugar!\""
msgstr "\"¡Dale a la abuela un poco de azúcar!\""

#. ~ Speech from speaker mon_feral_granny
#: data/json/speech.json
msgid "\"That's my purse!  I don't know you!\""
msgstr "\"¡Ese es mi bolso! ¡No te conozco!\""

