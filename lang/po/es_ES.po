#: data/json/furniture_and_terrain/furniture-barriers.json
msgid "rrrip!"
msgstr "¡rrrip!"

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-barriers.json
msgid "gravelbag wall"
msgstr "muro de sacos de grava"

#. ~ Description of furniture "gravelbag wall"
#: data/json/furniture_and_terrain/furniture-barriers.json
msgid "A wall of stacked gravelbags, a bit taller than an average adult."
msgstr ""
"Un muro de sacos de grava apilados, un poco más alto que un adulto medio."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-barriers.json
msgid "earthbag barricade"
msgstr "Barricada de sacos de tierra"

#. ~ Description of furniture "earthbag barricade"
#: data/json/furniture_and_terrain/furniture-barriers.json
msgid ""
"A low wall made of stacked earthbags, commonly used to catch bullets and "
"block flooding."
msgstr ""
"Un muro bajo hecho de sacos de tierra apilados, comúnmente utilizado para "
"atrapar balas y bloquear inundaciones."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-barriers.json
msgid "earthbag wall"
msgstr "muro de bolsas de tierra"

#. ~ Description of furniture "earthbag wall"
#: data/json/furniture_and_terrain/furniture-barriers.json
msgid "A wall of stacked earthbags, a bit taller than an average adult."
msgstr ""
"Un muro de sacos de tierra apilados, un poco más alto que un adulto medio."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-barriers.json
msgid "lane guard"
msgstr "guardarraíl"

#. ~ Description of furniture "lane guard"
#: data/json/furniture_and_terrain/furniture-barriers.json
msgid "A simple wooden post to mark the separation between street lanes."
msgstr ""
"Un muro de sacos de tierra apilados, un poco más alto que un adulto medio."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-barriers.json
msgid "sandbag barricade"
msgstr "barricada de bolsas de arena"

#. ~ Description of furniture "sandbag barricade"
#: data/json/furniture_and_terrain/furniture-barriers.json
msgid ""
"A low wall made of canvas sacks filled with sand, commonly used to catch "
"bullets and prevent flooding."
msgstr ""
"Muro bajo hecho con sacos de lona rellenos de arena, comúnmente utilizado "
"para atrapar balas y evitar inundaciones."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-barriers.json
msgid "sandbag wall"
msgstr "muro de bolsas de arena"

#. ~ Description of furniture "sandbag wall"
#: data/json/furniture_and_terrain/furniture-barriers.json
msgid "A wall of stacked sandbags, a bit taller than an average adult."
msgstr ""
"Un muro de sacos de arena apilados, un poco más alto que un adulto medio."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-decorative.json
msgid "standing mirror"
msgstr "espejo de pie"

#. ~ Description of furniture "standing mirror"
#: data/json/furniture_and_terrain/furniture-decorative.json
msgid ""
"A full-length mirror mounted in a sleek metal frame.  You can easily see all"
" of the dirt and blood on your clothes, and the weariness in your eyes."
msgstr ""
"Un espejo de cuerpo entero montado en un elegante marco de metal. Puede ver "
"fácilmente toda la suciedad y la sangre en tu ropa, y el cansancio en tus "
"ojos."

#. ~ Bashing sound of furniture "standing mirror"
#. ~ Bashing sound of furniture "display case"
#. ~ Bashing sound of furniture "open display case"
#. ~ Bashing sound of furniture "fireman's cabinet"
#. ~ Bashing sound of furniture "unlocked fireman's cabinet"
#: data/json/furniture_and_terrain/furniture-decorative.json
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "glass breaking"
msgstr "cristal rompiéndose"

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-decorative.json
msgid "broken standing mirror"
msgstr "espejo de pie roto"

#. ~ Description of furniture "broken standing mirror"
#: data/json/furniture_and_terrain/furniture-decorative.json
msgid ""
"A metal frame for a full-length mirror, with most of the mirror missing.  "
"What remains in the frame are large dangerous-looking shards of fractured "
"glass."
msgstr ""
"Un marco metálico para un espejo de cuerpo entero, al que le falta la mayor "
"parte del espejo. Lo que queda en el marco son grandes fragmentos de cristal"
" fracturado de aspecto peligroso."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-decorative.json
msgid "bitts"
msgstr "bolardo"

#. ~ Description of furniture "bitts"
#: data/json/furniture_and_terrain/furniture-decorative.json
msgid ""
"A pair of vertical iron posts mounted on a wharf, pier, or other form of "
"dock.  They are used to secure mooring lines, ropes, and similar."
msgstr ""
"Un par de postes verticales de hierro montados en un muelle, embarcadero u "
"otra forma de muelle. Se utilizan para asegurar cabos de amarre, cuerdas y "
"similares."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-decorative.json
msgid "cleat"
msgstr "cala"

#. ~ Description of furniture "cleat"
#: data/json/furniture_and_terrain/furniture-decorative.json
msgid ""
"A small horn cleat with two “horns” extending parallel to the deck or the "
"axis of the spar, and resembling a small anvil.  They are used to secure "
"mooring lines, ropes, and similar."
msgstr ""
"Pequeña cala de cuerno con dos \"cuernos\" que se extienden paralelos a la "
"cubierta o al eje del palo, y que se asemejan a un pequeño yunque. Se "
"utilizan para asegurar cabos de amarre, cuerdas y similares."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-decorative.json
msgid "manacles"
msgstr "esposas"

#. ~ Description of furniture "manacles"
#: data/json/furniture_and_terrain/furniture-decorative.json
msgid "A pair of metal shackles with heavy chains mounted to a wall or floor."
msgstr ""
"Un par de grilletes metálicos con pesadas cadenas montados en un muro o en "
"el suelo."

