#: data/json/items/armor/suits_protection.json
msgid "Hub 01 environmental suit"
msgid_plural "Hub 01 environmental suits"
msgstr[0] "mono ambiental Hub 01"
msgstr[1] "monos ambientales Hub 01"
msgstr[2] "monos ambientales Hub 01"

#. ~ 2mm Nomex across the entire suit to provide hazmat properties. Hands and
#. feet reinforced/shaped with other materials to provide full-body hazmat
#. protection with minimal encumbrance.
#. ~ Description of "Hub 01 environmental suit"
#: data/json/items/armor/suits_protection.json
msgid ""
"A lightweight environmental suit incorporating Kevlar-lined boots and "
"gloves, worn by Hub personnel in their rare forays aboveground.  Colored "
"brown and blue, the white seal of Hub 01 is embroidered on both of its upper"
" arms.  It requires a separate gas mask for full protection."
msgstr ""
"Un traje ambiental ligero que incorpora botas y guantes forrados de Kevlar, "
"usado por el personal del Hub en sus raras incursiones en la superficie. De "
"color marrón y azul, lleva el sello blanco del Hub 01 bordado en la parte "
"superior de los brazos. Requiere una máscara de gas separada para una "
"protección completa."

#. ~ "menu_text" action message of item "Hub 01 environmental suit"
#. ~ "menu_text" action message of item "activity suit"
#: data/json/items/armor/suits_protection.json
msgid "Wear casually"
msgstr "Ponérselo informalmente"

#. ~ "msg" action message of item "Hub 01 environmental suit"
#. ~ "msg" action message of item "activity suit"
#: data/json/items/armor/suits_protection.json
msgid ""
"You slip out of the top of the suit and tie the sleeves around your waist."
msgstr ""
"Te sacas la parte de arriba del traje y te atas las mangas alrededor de la "
"cintura."

#. ~ Item name
#: data/json/items/armor/suits_protection.json
msgid "Hub 01 environmental suit (casual)"
