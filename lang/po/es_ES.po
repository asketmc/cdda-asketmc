#. ~ Profession name for male
#: data/json/professions.json
#: data/mods/Dark-Skies-Above/overrides/professions.json
msgctxt "profession_male"
msgid "Combat Mechanic"
msgstr "Mecánico de Combate"

#. ~ Description of profession "Combat Mechanic" for male
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"Early in your military career, you were hand-picked for extra training in "
"the mechanic's trade, keeping the armor running.  It's been years since you "
"last touched a rifle, and the dead men are marching again…"
msgstr ""
"Al principio de tu carrera militar, te eligieron para un entrenamiento extra"
" en el oficio de mecánico, manteniendo las armaduras en funcionamiento. Han "
"pasado años desde la última vez que tocaste un rifle, y los hombres muertos "
"están marchando de nuevo..."

#. ~ Profession name for female
#: data/json/professions.json
#: data/mods/Dark-Skies-Above/overrides/professions.json
msgctxt "profession_female"
msgid "Combat Mechanic"
msgstr "Mecánica de Combate"

#. ~ Description of profession "Combat Mechanic" for female
#: data/json/professions.json
msgctxt "prof_desc_female"
msgid ""
