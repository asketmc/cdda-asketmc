#. ~ Profession name for male
#: data/json/professions.json
msgctxt "profession_male"
msgid "Meth Cook"
msgstr "Cocinero de anfeta"

#. ~ Description of profession "Meth Cook" for male
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You clawed your way out of poverty by selling products everyone wanted, and "
"they had the nerve to put you in jail for it.  Too bad you can't sell drugs "
"to zombies."
msgstr ""
"Saliste de la pobreza vendiendo productos que todos querían, y tuvieron el "
"descaro de meterte en la cárcel por ello. Lástima que no puedas vender "
"drogas a zombis."

