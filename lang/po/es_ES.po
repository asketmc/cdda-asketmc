#: data/json/items/comestibles/raw_fruit.json
msgid ""
"A sweet, acidic fruit originating from South America.  It grows on vines and"
" is filled with seeds like a pomegranate.  Also known as the maracuya."
msgstr ""
"Una fruta dulce y agria originaria de América del Sur. Crece en forma de "
"parra y está llena de semillas como las granadas. También se la conoce como "
"maracuyá."

#. ~ Item name
#: data/json/items/comestibles/raw_fruit.json
msgid "lulo"
msgid_plural "lulos"
msgstr[0] "lulo"
msgstr[1] "lulos"
msgstr[2] "lulos"

#. ~ Description of "lulo"
#: data/json/items/comestibles/raw_fruit.json
msgid ""
"An acidic fruit found in South America and the Caribbean, it looks like a "
"hairy orange and is used mainly for juice and desserts.  Also known as the "
"naranjilla."
msgstr ""
"Una fruta agria que se encuentra en América del Sur y el Caribe. Parece una "
"naranja peluda y es utilizada principalmente para hacer zumo y postres. "
"También se la conoce como naranjilla."

#. ~ Item name
#: data/json/items/comestibles/raw_fruit.json
msgid "grapefruit"
msgid_plural "grapefruits"
msgstr[0] "pomelo"
msgstr[1] "pomelos"
msgstr[2] "pomelos"

#. ~ Description of "grapefruit"
#: data/json/items/comestibles/raw_fruit.json
msgid ""
"A hybrid citrus fruit descended from the orange, whose taste ranges from "
"sour to semi-sweet, and a little bitter."
msgstr ""
"Una fruta cítrica híbrida descendiente de la naranja, cuyo gusto va desde lo"
" agrio hasta lo semidulce, y un poco amarga."

#. ~ Item name
#: data/json/items/comestibles/raw_fruit.json
msgid "cherries"
msgid_plural "cherries"
msgstr[0] "cerezas"
msgstr[1] "cerezas"
msgstr[2] "cerezas"

#. ~ Description of "cherries"
#: data/json/items/comestibles/raw_fruit.json
msgid ""
"A sweet red fruit that grows on trees.  If you have some time on your hands,"
" maybe you could figure out how to do that trick where you tie a knot in the"
" stem with your tongue."
msgstr ""
"Una fruta roja y dulce que crece en los árboles. Si tienes algo de tiempo, "
"quizá puedas averiguar cómo hacer ese truco de hacer un nudo en el tallo con"
" la lengua."

#. ~ Item name
#: data/json/items/comestibles/raw_fruit.json
msgid "plum"
msgid_plural "plums"
msgstr[0] "ciruela"
msgstr[1] "ciruelas"
msgstr[2] "ciruelas"

#. ~ Description of "plum"
#: data/json/items/comestibles/raw_fruit.json
msgid "A large purple plum.  Tasty and good for your digestion."
msgstr "Una gran ciruela púrpura. Sabrosa y buena para la digestión."

#. ~ Item name
#: data/json/items/comestibles/raw_fruit.json
msgid "grapes"
msgid_plural "grapes"
msgstr[0] "uvas"
msgstr[1] "uvas"
msgstr[2] "uvas"

#. ~ Description of "grapes"
#: data/json/items/comestibles/raw_fruit.json
msgid ""
"A cluster of juicy grapes.  Quite calorie-dense compared to most fruit, and "
"you might be able to make them into wine if you're ambitious enough."
msgstr ""
"Un racimo de uvas jugosas. Bastante calóricas en comparación con la mayoría "
"de las frutas, y podrías convertirlas en vino si eres lo suficientemente "
"ambicioso."

#. ~ Item name
#. ~ Plant name of seed "pineapple stem"
#: data/json/items/comestibles/raw_fruit.json
#: data/mods/Aftershock/items/seed.json
msgid "pineapple"
msgid_plural "pineapples"
msgstr[0] "piña"
msgstr[1] "piñas"
msgstr[2] "piñas"

#. ~ Description of "pineapple"
#: data/json/items/comestibles/raw_fruit.json
msgid ""
"A large, spiky citrus fruit.  Delicious and a great source of Vitamin C, "
"though a bit sour."
msgstr ""
"Un cítrico grande y puntiagudo. Deliciosa y una gran fuente de vitamina C, "
"aunque un poco ácida."

#. ~ Item name
#. ~ Plant name of seed "subterraenean coconut"
#: data/json/items/comestibles/raw_fruit.json
#: data/mods/Aftershock/items/seed.json
msgid "coconut"
msgid_plural "coconuts"
msgstr[0] "coco"
msgstr[1] "cocos"
msgstr[2] "cocos"

#. ~ Description of "coconut"
#: data/json/items/comestibles/raw_fruit.json
msgid ""
"A tropical fruit with a hard, hairy shell and a hollow inside full of "
"liquid."
msgstr ""
"Una fruta tropical con una cáscara dura y peluda y un interior hueco lleno "
"de líquido."

#. ~ Item name
#: data/json/items/comestibles/raw_fruit.json
msgid "peach"
msgid_plural "peaches"
msgstr[0] "melocotón"
msgstr[1] "melocotones"
msgstr[2] "melocotones"

#. ~ Description of "peach"
#: data/json/items/comestibles/raw_fruit.json
msgid "This fruit's large pit is surrounded by its tasty flesh."
msgstr "La gran semilla de esta fruta está rodeada por una pulpa sabrosa."

#. ~ yes, it really does have that much water in it
#. ~ Item name
#. ~ Plant name of seed "watermelon seeds"
#: data/json/items/comestibles/raw_fruit.json
#: data/json/items/comestibles/seed.json
msgid "watermelon"
msgid_plural "watermelons"
msgstr[0] "sandía"
msgstr[1] "sandías"
msgstr[2] "sandías"

#. ~ yes, it really does have that much water in it
#. ~ Description of "watermelon"
#: data/json/items/comestibles/raw_fruit.json
msgid "A deep green melon, bigger than your head.  It is very juicy!"
msgstr "Un melón verde intenso, más grande que tu cabeza. Es muy jugoso."

#. ~ based on a canteloupe
#. ~ Item name
#. ~ Plant name of seed "melon seeds"
#: data/json/items/comestibles/raw_fruit.json
#: data/mods/Aftershock/items/seed.json
#: data/mods/TropiCataclysm/items/comestibles/seed.json
msgid "melon"
msgid_plural "melons"
msgstr[0] "melón"
msgstr[1] "melones"
msgstr[2] "melones"

#. ~ based on a canteloupe
#. ~ Description of "melon"
#: data/json/items/comestibles/raw_fruit.json
msgid ""
"A large and very sweet fruit.  Botanically speaking, all melons are actually"
" berries."
msgstr ""
"Una fruta grande y muy dulce. Botánicamente hablando, todos los melones son "
"en realidad bayas."

#. ~ Item name
#: data/json/items/comestibles/raw_fruit.json
msgid "blackberries"
msgid_plural "blackberries"
msgstr[0] "zarzamoras"
msgstr[1] "zarzamoras"
msgstr[2] "zarzamoras"

#. ~ Description of "blackberries"
#: data/json/items/comestibles/raw_fruit.json
msgid ""
"A darker cousin of the raspberry.  The color isn't actually what sets them "
"apart - the identifying characteristic is whether the stem stays connected "
"to the fruit when it's first picked."
msgstr ""
"Un primo más oscuro de la frambuesa. El color no es lo que las diferencia, "
"sino que la característica que las identifica es que el tallo permanece "
"unido a la fruta cuando se recoge por primera vez."

#. ~ serving size is 250 ml of edible material, extra volume is the pit.
#. ~ Item name
#: data/json/items/comestibles/raw_fruit.json
msgid "mango"
msgid_plural "mangos"
msgstr[0] "mango"
msgstr[1] "mangos"
msgstr[2] "mangos"

#. ~ serving size is 250 ml of edible material, extra volume is the pit.
#. ~ Description of "mango"
#: data/json/items/comestibles/raw_fruit.json
msgid ""
"A fleshy tropical fruit with a large pit.  Better enjoy it soon, you're "
"pretty sure more of these aren't going to be imported for a long time."
msgstr ""
"Una fruta tropical carnosa con un gran hueso. Más vale que la disfrutes "
"pronto, seguro que no se van a importar más de estas en mucho tiempo."

#. ~ Item name
#: data/json/items/comestibles/raw_fruit.json
msgid "pomegranate"
msgid_plural "pomegranates"
msgstr[0] "granada"
msgstr[1] "granadas"
msgstr[2] "granadas"

#. ~ Description of "pomegranate"
#: data/json/items/comestibles/raw_fruit.json
msgid "Under this pomegranate's spongy skin lie hundreds of fleshy seeds."
msgstr ""
"Bajo la piel esponjosa de esta granada se esconden cientos de semillas "
"jugosas."

#. ~ Item name
#: data/json/items/comestibles/raw_fruit.json
msgid "papaya"
msgid_plural "papayas"
msgstr[0] "papaya"
msgstr[1] "papayas"
msgstr[2] "papayas"

#. ~ Description of "papaya"
#: data/json/items/comestibles/raw_fruit.json
msgid "A very sweet and soft tropical fruit."
msgstr "Una fruta tropical muy dulce y suave."

#. ~ Item name
#. ~ Plant name of seed "kiwi seeds"
#: data/json/items/comestibles/raw_fruit.json
#: data/mods/TropiCataclysm/items/comestibles/seed.json
msgid "kiwi"
msgid_plural "kiwis"
msgstr[0] "kiwi"
msgstr[1] "kiwis"
msgstr[2] "kiwis"

#. ~ Description of "kiwi"
#: data/json/items/comestibles/raw_fruit.json
msgid ""
"A large, brown, and fuzzy-skinned berry.  Its delicious insides are green."
msgstr ""
"Es una baya grande, de color marrón y con exterior peludo. Su delicioso "
"interior es verde."

#. ~ a handful of apricots is about 4.6 apricots
#. ~ Item name
#: data/json/items/comestibles/raw_fruit.json
msgid "apricots"
msgid_plural "apricots"
msgstr[0] "albaricoques"
msgstr[1] "albaricoques"
msgstr[2] "albaricoques"

#. ~ a handful of apricots is about 4.6 apricots
#. ~ Description of "apricots"
#: data/json/items/comestibles/raw_fruit.json
msgid "A handful of smooth-skinned fruits related to the peach."
msgstr "Un puñado de frutas de piel suave relacionadas con el melocotón."

#. ~ Item name
#: data/json/items/comestibles/raw_fruit.json
msgid "cholla bud"
msgid_plural "cholla buds"
msgstr[0] "brote de cholla"
msgstr[1] "brotes de cholla"
msgstr[2] "brotes de cholla"

#. ~ Description of "cholla bud"
#: data/json/items/comestibles/raw_fruit.json
msgid ""
"The edible bud of a cholla cactus, with its spines removed; the candy of the"
" Mojave indigenous peoples.  Tastes similar to asparagus."
msgstr ""
"El brote comestible de un cactus cholla, sin las espinas; el dulce de los "
"pueblos indígenas de Mojave. Tiene un sabor similar al de los espárragos."

#. ~ Item name
#: data/json/items/comestibles/raw_fruit.json
msgid "cactus pad"
msgid_plural "cactus pads"
msgstr[0] "nopal de cactus"
msgstr[1] "nopales de cactus"
msgstr[2] "nopales de cactus"

#. ~ Description of "cactus pad"
#: data/json/items/comestibles/raw_fruit.json
msgid "An edible pad from a cactus."
msgstr "Una almohadilla comestible de un cactus."

#. ~ Item name
#. ~ Plant name of seed "barley seeds"
#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "barley"
msgid_plural "barley"
msgstr[0] "cebada"
msgstr[1] "cebada"
msgstr[2] "cebada"

#. ~ Item name
#. ~ Plant name of seed "bee balm seeds"
#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "bee balm"
msgid_plural "bee balm"
msgstr[0] "monarda"
msgstr[1] "monardas"
msgstr[2] "monardas"

#. ~ Description of "bee balm"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A snow-white flower also known as wild bergamot.  Smells faintly of mint."
msgstr ""
"Una flor blanca también conocida como bergamota silvestre. Tiene un leve "
"olor a menta."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "handful of ground nuts"
msgid_plural "handful of ground nuts"
msgstr[0] "puñado de frutos secos molidos"
msgstr[1] "puñado de frutos secos molidos"
msgstr[2] "puñado de frutos secos molidos"

#. ~ Description of "handful of ground nuts"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"An almost forgotten staple of the native tribes, called the indian potato by"
" some.  Very nutritious, but mildly toxic unless cooked."
msgstr ""
"Un alimento casi olvidado de las algunas tribus, llamado patata india por "
"algunos.  Muy nutritivo, pero un poco tóxico si no se cocina."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "wild sarsaparilla root"
msgid_plural "wild sarsaparilla roots"
msgstr[0] "raíz de zarzaparrilla silvestre"
msgstr[1] "raíces de zarzaparrilla silvestre"
msgstr[2] "raíces de zarzaparrilla silvestre"

#. ~ Description of "wild sarsaparilla root"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"This aromatic rhizome can be eaten as is in an emergency, but it is much "
"better used for making beverages.  Its taste is pleasant but it is also "
"tough and stringy."
msgstr ""
"Esta rizoma aromática puede comerse como está en una emergencia pero es "
"mucho mejor usarla para preparar bebidas. Tiene un sabor agradable pero "
"también es dura y fibrosa."

#. ~ Item name
#. ~ Plant name of seed "Jerusalem artichoke seeds"
#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "Jerusalem artichoke"
msgid_plural "Jerusalem artichokes"
msgstr[0] "alcachofa de Jerusalén"
msgstr[1] "alcachofas de Jerusalén"
msgstr[2] "alcachofas de Jerusalén"

#. ~ Description of "Jerusalem artichoke"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A slightly sweet tuber.  Contains much inulin which may cause some minor "
"issues with your digestive tract, so it should be cooked."
msgstr ""
"Un tubérculo ligeramente dulce. Contiene mucha inulina que puede causar "
"algunos problemas menores en el tracto digestivo, por lo que debe ser "
"cocinado."

#. ~ Item name
#. ~ Plant name of seed "wild garlic seeds"
#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "wild garlic"
msgid_plural "wild garlic"
msgstr[0] "ajo silvestre"
msgstr[1] "ajos silvestres"
msgstr[2] "ajos silvestres"

#. ~ Description of "wild garlic"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"Also called ramps, this delicate leafy vegetable is healthy and a tasty "
"ingredient for many dishes."
msgstr ""
"También llamada rampas, esta delicada verdura de hoja es saludable y un "
"sabroso ingrediente para muchos platos."

#. ~ Item name
#. ~ Plant name of seed "broccoli seeds"
#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "broccoli"
msgid_plural "broccoli"
msgstr[0] "brócoli"
msgstr[1] "brócoli"
msgstr[2] "brócoli"

#. ~ Description of "broccoli"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A big stalk of broccoli.  It's a bit tough, but rich in Vitamin C and quite "
"delicious when properly cooked."
msgstr ""
"Un gran tallo de brócoli. Es un poco duro, pero rico en vitamina C y "
"bastante delicioso cuando está bien cocinado."

#. ~ Item name
#. ~ Plant name of seed "buckwheat seeds"
#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "buckwheat"
msgid_plural "buckwheat"
msgstr[0] "trigo sarraceno"
msgstr[1] "trigo sarraceno"
msgstr[2] "trigo sarraceno"

#. ~ Description of "buckwheat"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"Seeds from a wild buckwheat plant.  Not particularly good to eat in their "
"raw state, they are commonly cooked or ground into flour."
msgstr ""
"Semillas de una planta silvestre de trigo sarraceno.  No son particularmente"
" buenas para comer en su estado crudo, por lo que suelen cocinarse o molerse"
" en forma de harina."

#. ~ Item name
#. ~ Plant name of seed "cabbage seeds"
#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "cabbage"
msgid_plural "cabbages"
msgstr[0] "repollo"
msgstr[1] "repollos"
msgstr[2] "repollos"

#. ~ Description of "cabbage"
#: data/json/items/comestibles/raw_veggy.json
msgid "A head of crisp white cabbage."
msgstr "This is the command that moves the files, by itself it should work."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "grape leaves"
msgid_plural "grape leaves"
msgstr[0] "hoja de vid"
msgstr[1] "hojas de vid"
msgstr[2] "hojas de vid"

#. ~ Description of "grape leaves"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"Edible leaves of the grape vine.  Typically used in salads or as a food "
"wrapping."
msgstr ""
"Hojas comestibles de la vid. Suelen utilizarse en ensaladas o como "
"envoltorio de alimentos."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "spinach"
msgid_plural "spinach"
msgstr[0] "espinacas"
msgstr[1] "espinacas"
msgstr[2] "espinacas"

#. ~ Description of "spinach"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A bunch of spinach leaves.  Their ability to provide one with superhuman "
"strength has been greatly exaggerated by popular media."
msgstr ""
"Un puñado de hojas de espinacas. Los medios de comunicación populares han "
"exagerado mucho su capacidad de proporcionar una fuerza sobrehumana."

#. ~ Item name
#. ~ Plant name of seed "carrot seeds"
#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "carrot"
msgid_plural "carrots"
msgstr[0] "zanahoria"
msgstr[1] "zanahorias"
msgstr[2] "zanahorias"

#. ~ Description of "carrot"
#: data/json/items/comestibles/raw_veggy.json
msgid "A healthy root vegetable.  Rich in vitamin A!"
msgstr "Una raíz vegetal saludable. ¡Rica en vitamina A!"

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "cattail rhizome"
msgid_plural "cattail rhizomes"
msgstr[0] "rizoma de totora"
msgstr[1] "rizomas de totora"
msgstr[2] "rizomas de totora"

#. ~ Description of "cattail rhizome"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A stout, branching rhizome from a cattail plant.  Its crisp white flesh is "
"very starchy and fibrous, but you really ought to cook it before you attempt"
" to eat it."
msgstr ""
"Rizoma robusto y ramificado de una planta de cola de gato. Su carne blanca y"
" crujiente es muy almidonada y fibrosa, pero hay que cocinarla antes de "
"intentar comerla."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "cattail stalk"
msgid_plural "cattail stalks"
msgstr[0] "tallo de totora"
msgstr[1] "tallos de totora"
msgstr[2] "tallos de totora"

#. ~ Description of "cattail stalk"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A stiff green stalk from a cattail plant.  It is starchy and fibrous, but it"
" would be much better if you cooked it."
msgstr ""
"Un tallo rígido y verde de una planta de totora. Es almidonado y fibroso, "
"pero sería mucho mejor si lo cocinaras."

#. ~ Item name
#. ~ Plant name of seed "celery seeds"
#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "celery"
msgid_plural "celery"
msgstr[0] "apio"
msgstr[1] "apios"
msgstr[2] "apios"

#. ~ Description of "celery"
#: data/json/items/comestibles/raw_veggy.json
msgid "Neither tasty nor very nutritious, but it goes well with salad."
msgstr "No es ni sabroso ni nutritivo, pero va bien en las ensaladas."

#. ~ Thinking this is a single ear here.
#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "corn cob"
msgid_plural "corn cobs"
msgstr[0] "mazorca de maíz"
msgstr[1] "mazorcas de maíz"
msgstr[2] "mazorcas de maíz"

#. ~ Thinking this is a single ear here.
#. ~ Description of "corn cob"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A corn cob full of delicious golden kernels.  You can eat them on the cob or"
" shell it for cooking."
msgstr ""
"Una mazorca de maíz llena de deliciosos granos dorados. Puedes comerlos en "
"la mazorca o desgranarlos para cocinarlos."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "corn kernels"
msgid_plural "corn kernels"
msgstr[0] "granos de maíz"
msgstr[1] "granos de maíz"
msgstr[2] "granos de maíz"

#. ~ Description of "corn kernels"
#: data/json/items/comestibles/raw_veggy.json
msgid "Delicious golden kernels of corn."
msgstr "Deliciosos granos de maíz dorados."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "empty corn cob"
msgid_plural "empty corn cob"
msgstr[0] "mazorca de maíz vacia"
msgstr[1] "mazorcas de maíz vacias"
msgstr[2] "mazorcas de maíz vacias"

#. ~ Description of "empty corn cob"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"An empty corn cob.  No longer contains any edible kernels, but it can be "
"used to make stock or as fuel."
msgstr ""
"Una mazorca de maíz vacía. Ya no contiene granos comestibles, pero puede "
"utilizarse para hacer caldo o como combustible."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "cotton boll"
msgid_plural "cotton bolls"
msgstr[0] "cápsula de algodón"
msgstr[1] "cápsulas de algodón"
msgstr[2] "cápsulas de algodón"

#. ~ Description of "cotton boll"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A tough protective capsule bulging with densely-packed fibers and seeds, "
"this cotton boll can be processed into usable material with the right tools."
msgstr ""
"Esta cápsula de algodón, una resistente cápsula protectora repleta de fibras"
" y semillas densamente empaquetadas, puede transformarse en material "
"utilizable con las herramientas adecuadas."

#. ~ Item name
#. ~ Plant name of seed "chili pepper seeds"
#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "chili pepper"
msgid_plural "chili peppers"
msgstr[0] "pimiento picante"
msgstr[1] "pimientos picantes"
msgstr[2] "pimientos picantes"

#. ~ Description of "chili pepper"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A spicy chili pepper.  Not the best on its own, but adds great flavor when "
"used in cooking."
msgstr ""
"Un pimiento picante. No es el mejor por sí solo, pero añade un gran sabor "
"cuando se utiliza en la cocina."

#. ~ Item name
#. ~ Plant name of seed "cucumber seeds"
#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "cucumber"
msgid_plural "cucumbers"
msgstr[0] "pepino"
msgstr[1] "pepinos"
msgstr[2] "pepinos"

#. ~ Description of "cucumber"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A vegetable from the gourd family.  Not especially flavorful, but very "
"refreshing."
msgstr ""
"Una verdura de la familia de las calabazas. No es especialmente sabrosa, "
"pero es muy refrescante."

#. ~ Dahlia roots contain an incredible amount of vitamin B6. This isn't a
#. vitamin tracked in Cataclysm, but be careful of vitamin overdose when
#. eating dahlia in real life.
#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "dahlia root"
msgid_plural "dahlia roots"
msgstr[0] "raíz de dalia"
msgstr[1] "raices de dalia"
msgstr[2] "raices de dalia"

#. ~ Dahlia roots contain an incredible amount of vitamin B6. This isn't a
#. vitamin tracked in Cataclysm, but be careful of vitamin overdose when
#. eating dahlia in real life.
#. ~ Description of "dahlia root"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"The large, tuberous root of a dahlia flower.  It smells spicy, but is too "
"starchy to eat without cooking."
msgstr ""
"La gran raíz tuberosa de una flor de dalia. Huele picante, pero tiene "
"demasido almidón para comerla sin cocinarla."

#. ~ Serving Size is 1 cup of sliced roots. Salsify grows in bountiful clumps,
#. it's a weed.
#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "salsify root"
msgid_plural "salsify roots"
msgstr[0] "raíz de salsifí"
msgstr[1] "raíces de salsifí"
msgstr[2] "raíces de salsifí"

#. ~ Serving Size is 1 cup of sliced roots. Salsify grows in bountiful clumps,
#. it's a weed.
#. ~ Description of "salsify root"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A highly nutritious root, it is tough and bland until cooked, at which point"
" it tastes strangely similar to oysters."
msgstr ""
"Es una raíz muy nutritiva, pero es dura e insípida hasta que se cocina, "
"momento en el que tiene un sabor extrañamente parecido al de las ostras."

#. ~ Description of "chicory"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A modest blue flower.  The flower's roots are very bitter and not meant to "
"be eaten raw."
msgstr ""
"Una modesta flor azul. Las raíces de la flor son muy amargas y no están "
"hechas para ser consumidas crudas."

#. ~ Also known as Queen Anne's Lace. It's that boring white flower that grows
#. wild everywhere. Water hemlock looks almost exactly like wild carrot. The
#. easiest way to tell them apart is by their scent. Please don't eat either
#. of them at home, hemlock will kill you deader than Socrates.
#. ~ Item name
#. ~ Plant name of seed "wild root seeds"
#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "wild root"
msgid_plural "wild roots"
msgstr[0] "raíz silvestre"
msgstr[1] "raíces silvestres"
msgstr[2] "raíces silvestres"

#. ~ Also known as Queen Anne's Lace. It's that boring white flower that grows
#. wild everywhere. Water hemlock looks almost exactly like wild carrot. The
#. easiest way to tell them apart is by their scent. Please don't eat either
#. of them at home, hemlock will kill you deader than Socrates.
#. ~ Description of "wild root"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"These are often wild carrots, but beware of poisonous lookalikes.  In any "
"case, the root is tough and is not as tasty as a real raw carrot."
msgstr ""
"Suelen ser zanahorias silvestres, pero hay que tener cuidado con las que "
"parecen venenosas. En cualquier caso, la raíz es dura y no es tan sabrosa "
"como una verdadera zanahoria cruda."

#. ~ Item name
#. ~ Plant name of seed "dogbane seeds"
#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "dogbane"
msgid_plural "dogbanes"
msgstr[0] "apocino"
msgstr[1] "apocinos"
msgstr[2] "apocinos"

#. ~ Description of "dogbane"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A stalk of dogbane.  It has very fibrous stems and is mildly poisonous."
msgstr "Un tallo de apocino. Es muy fibroso y levemente venenoso."

#. ~ Who in their right mind would eat an entire garlic bulb raw?
#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "garlic bulb"
msgid_plural "garlic bulbs"
msgstr[0] "cabeza de ajo"
msgstr[1] "cabezas de ajo"
msgstr[2] "cabezas de ajo"

#. ~ Who in their right mind would eat an entire garlic bulb raw?
#. ~ Description of "garlic bulb"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A pungent garlic bulb.  Popular as a seasoning for its strong flavor.  Can "
"be disassembled into cloves."
msgstr ""
"Un bulbo de ajo picante. Popular como condimento por su fuerte sabor. Puede "
"desmontarse en dientes."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "hops flower"
msgid_plural "hops flowers"
msgstr[0] "flor de lúpulo"
msgstr[1] "flores de lúpulo"
msgstr[2] "flores de lúpulo"

#. ~ Description of "hops flower"
#: data/json/items/comestibles/raw_veggy.json
msgid "A cluster of small cone-like flowers, indispensable for brewing beer."
msgstr ""
"Un racimo de pequeñas flores con forma de cono, indispensables para elaborar"
" cerveza."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "horseradish root"
msgid_plural "horseradish roots"
msgstr[0] "raiz de rábano picante"
msgstr[1] "raices de rábano picante"
msgstr[2] "raices de rábano picante"

#. ~ Description of "horseradish root"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A large white tapered root of a horseradish plant.  Way too spicy to eat in "
"this form, but can be used for making condiments."
msgstr ""
"Una gran raíz blanca y cónica de la planta de rábano picante. Demasiado "
"picante para comerla en esta forma, pero se puede utilizar para hacer "
"condimentos."

#. ~ Item name
#. ~ Plant name of seed "lettuce seeds"
#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "lettuce"
msgid_plural "lettuces"
msgstr[0] "lechuga"
msgstr[1] "lechugas"
msgstr[2] "lechugas"

#. ~ Description of "lettuce"
#: data/json/items/comestibles/raw_veggy.json
msgid "A crisp head of iceberg lettuce."
msgstr "Una planta fresca de lechuga iceberg."

#. ~ Item name
#. ~ Plant name of seed "mugwort seeds"
#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "mugwort"
msgid_plural "mugworts"
msgstr[0] "artemisa"
msgstr[1] "artemisas"
msgstr[2] "artemisas"

#. ~ Description of "mugwort"
#: data/json/items/comestibles/raw_veggy.json
msgid "A stalk of mugwort.  Smells wonderful."
msgstr "Un tallo de artemisa. Tiene un olor maravilloso."

#. ~ Raw onions probably aren't all that tasty to most people.
#. ~ Item name
#. ~ Plant name of seed "onion seeds"
#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "onion"
msgid_plural "onions"
msgstr[0] "cebolla"
msgstr[1] "cebollas"
msgstr[2] "cebollas"

#. ~ Raw onions probably aren't all that tasty to most people.
#. ~ Description of "onion"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"An aromatic onion used in cooking.  Cutting these up can make your eyes "
"sting!"
msgstr ""
"Una cebolla aromática que se usa en concinas. ¡Cortarlas puede hacer que te "
"piquen los ojos!"

#. ~ wild vegetables as a reference
#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "fungal fluid sac"
msgid_plural "fungal fluid sacs"
msgstr[0] "saco de líquido fúngico"
msgstr[1] "sacos de líquido fúngico"
msgstr[2] "sacos de líquido fúngico"

#. ~ wild vegetables as a reference
#. ~ Description of "fungal fluid sac"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A fluid bladder from a fungus-based lifeform.  Not very nutritious, but safe"
" to eat."
msgstr ""
"Una vejiga fluida de una forma de vida basada en hongos. No es muy "
"nutritivo, pero se puede comer."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "raw popcorn"
msgid_plural "raw popcorn"
msgstr[0] "palomitas de maíz cruda"
msgstr[1] "palomitas de maíz crudas"
msgstr[2] "palomitas de maíz crudas"

#. ~ Description of "raw popcorn"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A special variety of corn which could be used for making popcorn, after it's"
" dried.  Unlike normal corn, it's not sweet and is more dry."
msgstr ""
"Una variedad especial de maíz que podría usarse para hacer palomitas de "
"maíz, después de ser secadas. A diferencia del maíz normal, no es dulce y es"
" más seco."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "raw potato"
msgid_plural "raw potatoes"
msgstr[0] "patata cruda"
msgstr[1] "patatas crudas"
msgstr[2] "patatas crudas"

#. ~ Description of "raw potato"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A potato, mildly toxic and not very tasty raw.  Delicious and filling when "
"properly cooked."
msgstr ""
"Una patata, ligeramente tóxica y poco sabrosa cruda. Deliciosa y saciante "
"cuando está bien cocinada."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "cooking banana"
msgid_plural "cooking bananas"
msgstr[0] "plátano cocido"
msgstr[1] "plátanos cocidos"
msgstr[2] "plátanos cocidos"

#. ~ Description of "cooking banana"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A much less sweet and more starchy relative of the banana; unlike dessert "
"bananas, they usually are eaten cooked rather than raw, and can be processed"
" into flour.  They are a staple food in tropical regions of the world.  Also"
" known as plantains."
msgstr ""
"Un pariente del plátano mucho menos dulce y con más almidón; a diferencia de"
" los plátanos de postre, suelen comerse cocidos y no crudos, y pueden "
"transformarse en harina. Son un alimento básico en las regiones tropicales "
"del mundo. También se conoce como plátano."

#. ~ Item name
#. ~ Plant name of seed "pumpkin seeds"
#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "pumpkin"
msgid_plural "pumpkins"
msgstr[0] "calabaza"
msgstr[1] "calabazas"
msgstr[2] "calabazas"

#. ~ Description of "pumpkin"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A large gourd, about the size of your head.  Not very tasty raw, but great "
"for cooking."
msgstr ""
"Una calabaza grande, del tamaño de tu cabeza. No es muy sabrosa cruda, pero "
"es estupenda para cocinar."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "horseradish greens"
msgid_plural "horseradish greens"
msgstr[0] "hojas de rábano picante"
msgstr[1] "hojas de rábano picante"
msgstr[2] "hojas de rábano picante"

#. ~ Description of "horseradish greens"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"Leaves of a horseradish plant with a sharp, bitter and peppery taste.  "
"They're edible, but not commonly eaten."
msgstr ""
"Hojas de una planta de rábano picante con un sabor agudo, amargo y picante. "
"Son comestibles, pero no se suelen comer."

#. ~ Description of "dandelion"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A handful of freshly-picked yellow dandelions.  In their current raw state "
"they are quite bitter."
msgstr ""
"Un puñado de dientes de león amarillos recién recogidos. En su actual estado"
" crudo son bastante amargos."

#. ~ Description of "burdock"
#: data/json/items/comestibles/raw_veggy.json
msgid "Burdock, a bitter thistle-like vegetable.  Can be eaten raw or cooked."
msgstr ""
"Bardana, un vegetal amargo parecido al cardo. Puede ser comida cruda o "
"cocinada."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "bamboo shoot"
msgid_plural "bamboo shoot"
msgstr[0] "brote de bambú"
msgstr[1] "brotes de bambú"
msgstr[2] "brotes de bambú"

#. ~ Description of "bamboo shoot"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"Raw woody bamboo shoots, they require some preparation before they can be "
"eaten safely."
msgstr ""
"Los brotes de bambú leñosos y crudos requieren cierta preparación antes de "
"poder ser consumidos con seguridad."

#. ~ Item name
#. ~ Plant name of seed "rhubarb stems"
#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "rhubarb"
msgid_plural "rhubarbs"
msgstr[0] "ruibarbo"
msgstr[1] "ruibarbos"
msgstr[2] "ruibarbos"

#. ~ Description of "rhubarb"
#: data/json/items/comestibles/raw_veggy.json
msgid "Sour stems of the rhubarb plant, often used in baking pies."
msgstr ""
"Tallos amargos de la planta del ruibarbo, a menudo utilizados en la "
"elaboración de tartas."

#. ~ Item name
#. ~ Plant name of seed "sugar beet seeds"
#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "sugar beet"
msgid_plural "sugar beets"
msgstr[0] "remolacha azucarera"
msgstr[1] "remolachas azucareras"
msgstr[2] "remolachas azucareras"

#. ~ Description of "sugar beet"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"This fleshy root is ripe and flowing with sugars; it'll just take some "
"processing to extract them."
msgstr ""
"Esta raíz carnosa está madura y repleta de azúcares; sólo habrá que "
"procesarla para extraerlos."

#. ~ Tea is sold by weight not by volume. 1 kg of tea has a volume of 3,4
#. liters. We use smaller packs of at least 100 mg. Such a tea has a volume of
#. 340 ml minus package makes it around 320 ml. 3 g per serving makes 33
#. charges.
#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "black tea leaf"
msgid_plural "black tea leaves"
msgstr[0] "hoja de té negro"
msgstr[1] "hojas de té negro"
msgstr[2] "hojas de té negro"

#. ~ Tea is sold by weight not by volume. 1 kg of tea has a volume of 3,4
#. liters. We use smaller packs of at least 100 mg. Such a tea has a volume of
#. 340 ml minus package makes it around 320 ml. 3 g per serving makes 33
#. charges.
#. ~ Description of "black tea leaf"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"Dried leaves of a tropical plant.  You can boil them into tea, or you can "
"just eat them raw.  They're pretty gross and not too filling that way, "
"though."
msgstr ""
"Hojas secas de una planta tropical. Se pueden hervir para hacer un té o "
"simplemente comerlas crudas. Sin embargo, son bastante asquerosas y no "
"llenan demasiado de esa forma."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "pile of wintergreen leaves"
msgid_plural "piles of wintergreen leaves"
msgstr[0] "montón de hojas de gaulteria"
msgstr[1] "montones de hojas de gaulteria"
msgstr[2] "montones de hojas de gaulteria"

#. ~ Description of "pile of wintergreen leaves"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"These leaves smell strongly medicinal.  When chewed, they first taste sweet "
"but the aftertaste is incredibly bitter.  These leaves contain good amounts "
"of methyl salicylate and merely chewing them may have a similar effect to "
"aspirin."
msgstr ""
"Estas hojas tienen un fuerte olor medicinal. Al masticarlas, primero tienen "
"un sabor dulce, pero el regusto es increíblemente amargo. Estas hojas "
"contienen buenas cantidades de salicilato de metilo y el mero hecho de "
"masticarlas puede tener un efecto similar al de la aspirina."

#. ~ "activation_message" action message of item "pile of wintergreen leaves"
#: data/json/items/comestibles/raw_veggy.json
msgid "You chew the wintergreen leaves."
msgstr "Masticas las hojas de gaulteria."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "green tea leaf"
msgid_plural "green tea leaves"
msgstr[0] "hoja de té verde"
msgstr[1] "hojas de té verde"
msgstr[2] "hojas de té verde"

#. ~ Description of "green tea leaf"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"Dried leaves of a tropical plant.  You can boil them into green tea, or you "
"can just eat them raw.  They're pretty gross and not too filling that way, "
"though."
msgstr ""
"Hojas secas de una planta tropical. Se pueden hervir para hacer un té verde,"
" o simplemente se pueden comer crudas. Sin embargo, son bastante asquerosas "
"y no llenan demasiado de esa manera."

#. ~ Item name
#. ~ Plant name of seed "tomato seeds"
#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "tomato"
msgid_plural "tomatoes"
msgstr[0] "tomate"
msgstr[1] "tomates"
msgstr[2] "tomates"

#. ~ Description of "tomato"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A juicy red tomato.  It gained popularity in Italy after being brought back "
"from the New World."
msgstr ""
"Un jugoso tomate rojo. Ganó popularidad en Italia tras ser traído del Nuevo "
"Mundo."

#. ~ average of broccoli, cabbage, carrot, cattail_stalk, celery,
#. chili_pepper, cucumber, lettuce, onion, pumpkin, raw_dandelion, rhubarb,
#. sugar_beet, tomato, zucchini
#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "plant marrow"
msgid_plural "plant marrows"
msgstr[0] "tuétano de planta"
msgstr[1] "tuétanos de planta"
msgstr[2] "tuétanos de planta"

#. ~ average of broccoli, cabbage, carrot, cattail_stalk, celery,
#. chili_pepper, cucumber, lettuce, onion, pumpkin, raw_dandelion, rhubarb,
#. sugar_beet, tomato, zucchini
#. ~ Description of "plant marrow"
#: data/json/items/comestibles/raw_veggy.json
msgid "A nutrient-rich chunk of plant matter, could be eaten raw or cooked."
msgstr ""
"Un trozo de materia vegetal rico en nutrientes, que puede comerse crudo o "
"cocinado."

#. ~ Note: Legacy item ID, this is not actually a vegetable at all anymore.
#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "alien fungus chunk"
msgid_plural "alien fungus chunks"
msgstr[0] "trozo de hongo alienígena"
msgstr[1] "trozos de hongo alienígena"
msgstr[2] "trozos de hongo alienígena"

#. ~ Note: Legacy item ID, this is not actually a vegetable at all anymore.
#. ~ Description of "alien fungus chunk"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"This is a chunk of fungal matter from some sort of alien mushroom creature."
"  Eating unfamiliar mushrooms is a bad idea."
msgstr ""
"Este es un trozo de materia fúngica de algún tipo de criatura hongo "
"alienígena. Comer hongos desconocidos es una mala idea."

#. ~ In real life many root vegetables are mildly toxic until cooked
#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "wild vegetables"
msgid_plural "wild vegetables"
msgstr[0] "verduras silvestres"
msgstr[1] "verduras silvestres"
msgstr[2] "verduras silvestres"

#. ~ In real life many root vegetables are mildly toxic until cooked
#. ~ Description of "wild vegetables"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"An assortment of edible-looking wild plants.  Most are quite bitter-tasting."
"  Some are inedible until cooked."
msgstr ""
"Un surtido de verduras silvestres que parecen comestibles. La mayoría tiene "
"gusto amargo. Algunas no se pueden comer si no están cocinadas."

#. ~ Item name
#. ~ Plant name of seed "zucchini seeds"
#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "zucchini"
msgid_plural "zucchinis"
msgstr[0] "calabacín"
msgstr[1] "calabacines"
msgstr[2] "calabacines"

#. ~ Description of "zucchini"
#: data/json/items/comestibles/raw_veggy.json
msgid "A tasty summer squash."
msgstr "Un sabroso calabacín de verano."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "raw beans"
msgid_plural "raw beans"
msgstr[0] "alubias crudas"
msgstr[1] "alubias crudas"
msgstr[2] "alubias crudas"

#. ~ Description of "raw beans"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"Raw, uncooked beans.  They are mildly toxic in this form, but you could cook"
" them to make them tasty."
msgstr ""
"Alubias crudas, sin cocer. Son ligeramente tóxicas en esta forma, pero "
"podrías cocinarlas para hacerlas sabrosas."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "raw lentils"
msgid_plural "raw lentils"
msgstr[0] "lentejas crudas"
msgstr[1] "lentejas crudas"
msgstr[2] "lentejas crudas"

#. ~ Description of "raw lentils"
#: data/json/items/comestibles/raw_veggy.json
msgid "Raw, uncooked lentils."
msgstr "Lentejas crudas, sin cocer."

#. ~ Fiddleheads that haven't been boiled can make you sick.
#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "fiddleheads"
msgid_plural "fiddleheads"
msgstr[0] "brotes de helecho"
msgstr[1] "brotes de helecho"
msgstr[2] "brotes de helecho"

#. ~ Fiddleheads that haven't been boiled can make you sick.
#. ~ Description of "fiddleheads"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A handful of immature fern fronds, still curled up like the head of a "
"fiddle.  Delicious when cooked, but consuming them raw can cause food "
"poisoning."
msgstr ""
"Un puñado de frondas de helecho inmaduras, todavía enroscadas como la cabeza"
" de un violín. Son deliciosos cuando se cocinan, pero consumirlos crudos "
"puede provocar una intoxicación alimentaria."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "handful of young leaves"
msgid_plural "handful of young leaves"
msgstr[0] "puñado de hojas jóvenes"
msgstr[1] "puñado de hojas jóvenes"
msgstr[2] "puñado de hojas jóvenes"

#. ~ Description of "handful of young leaves"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"Some young leaves from miscellaneous plants.  They're tender enough to eat, "
"but not very tasty raw."
msgstr ""
"Algunas hojas jóvenes de plantas diversas. Son lo suficientemente tiernas "
"como para comerlas, pero no son muy sabrosas crudas."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "Japanese knotweed stems"
msgid_plural "Japanese knotweed stems"
msgstr[0] "tallo de knotweed japonés"
msgstr[1] "tallos de knotweed japonés"
msgstr[2] "tallos de knotweed japonés"

#. ~ Description of "Japanese knotweed stems"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"Some young Japanese knotweed stems.  They taste a bit like rhubarb and "
"contain good amounts of vitamin A.  Refreshing."
msgstr ""
"Algunos tallos jóvenes de knotweed japonés. Saben un poco a ruibarbo y "
"contienen buenas cantidades de vitamina A. Refrescante."

#. ~ Item name
#. ~ Plant name of seed "bell pepper seeds"
#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "bell pepper"
msgid_plural "bell peppers"
msgstr[0] "primiento de morrón"
msgstr[1] "primientos de morrón"
msgstr[2] "primientos de morrón"

#. ~ Description of "bell pepper"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A green bell pepper.  Eating it whole and raw would be kind of a hassle, "
"considering all the seeds."
