#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Hey there, <name_g>."
msgstr "Qué tal, <name_g>."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
#: data/json/npcs/refugee_center/surface_staff/NPC_free_merchant_guard1.json
msgid "Hello there."
msgstr "Hola, ¿qué tal?"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Okay, no sudden movements…"
msgstr "Vale, nada de movimientos bruscos..."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Keep your distance!"
msgstr "¡Quédate lejos!"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "This is my territory, <name_b>."
msgstr "Este es mi territorio, <name_b>."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Calm down.  I'm not going to hurt you."
msgstr "Cálmate. No voy a hacerte daño."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Screw you, no."
msgstr "Jodete, no."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Put hands up."
msgstr "Levanta las manos."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "*drops his weapon."
msgstr "*suelta su arma."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "*drops her weapon."
msgstr "*suelta su arma."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Now get out of here"
msgstr "Ahora vete de aquí"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Now get out of here, before I kill you."
msgstr "Ahora sal de aquí, antes de que te mate."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
#: data/json/npcs/holdouts/Rural-Cowboy_Hostile.json
msgid "Okay, I'm going."
msgstr "Vale, me voy."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "About one of those jobs…"
msgstr "Sobre uno de esos trabajos..."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "What's the matter?"
msgstr "¿Qué pasa?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I don't care."
msgstr "No me importa."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I don't have any jobs for you."
msgstr "No tengo ningún trabajo para ti."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I don't have any more jobs for you."
msgstr "No tengo ningún otro trabajo para ti."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I have other jobs for you.  Want to hear about them?"
msgstr "Tengo otros trabajos para ti. ¿Quieres saber de ellos?"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I have more jobs for you.  Want to hear about them?"
msgstr "Tengo más trabajos para tí. ¿Quieres saber de ellos?"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I have a job for you.  Want to hear about it?"
msgstr "Tengo un trabajo para ti. ¿Quieres oírlo?"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I just have one job for you.  Want to hear about it?"
msgstr "Tengo un trabajo para ti. ¿Quieres que te cuente?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/refugee_center/surface_staff/NPC_free_merchant_guard1.json
#: data/mods/Aftershock/npcs/milly_whately_dialogue.json
#: data/mods/Aftershock/npcs/prepnet_dialogue.json
#: data/mods/Aftershock/npcs/whately_generic_dialogue.json
msgid "Oh, okay."
msgstr "Ah, bueno."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Never mind, I'm not interested."
msgstr "No importa, no estoy interesado."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "You're not working on anything for me now."
msgstr "No estás trabajando en nada para mí ahora."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Which job?"
msgstr "¿Cuál trabajo?"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "What about it?"
msgstr "¿Qué te parece?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I'll do it!"
msgstr "¡Lo haré!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Not a problem."
msgstr "No es problema."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Got any advice?"
msgstr "¿Tienes algún consejo?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Can you share some equipment?"
msgstr "¿Me puedes prestar algo de equipo?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I'll be back soon!"
msgstr "¡Vuelvo enseguida!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/lumbermill_employees/TALK_lumbermill_logger.json
msgid "Sounds good, thanks."
msgstr "Suena bien, gracias. "

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Sounds good.  Bye!"
msgstr "Suena bien. ¡Adiós!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#: data/json/npcs/refugee_center/surface_staff/Smokes/free_merchant_shopkeep_talk_fluff.json
#: data/json/npcs/robofac/robofac_intercom/robofac_intercom_missions.json
msgid "I'm sorry."
msgstr "Lo lamento."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Whatever.  Bye."
msgstr "Como quieras. Adiós."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I'm sorry… I failed."
msgstr "Lo siento... fracasé."

#. ~ Affirmative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I killed him."
msgstr "Lo maté."

#. ~ Negative response to NPC dialogue
#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I killed it."
msgstr "Lo maté."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "No.  I'll get back to it, bye!"
msgstr "No. ¡Ahora sigo con eso, adiós!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Yup!  Here it is!"
msgstr "¡Sip! ¡Aquí está/n!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "We're here!"
msgstr "¡Llegamos!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Here I am."
msgstr "Aquí estoy."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I talked to them."
msgstr "He hablado con ellos."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Here it is!"
msgstr "¡Aquí está/n!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Justice has been served."
msgstr "Se ha hecho justicia."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I killed them.  All of them."
msgstr "Los mate. A todos los mate."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I brought 'em."
msgstr "Los he traído."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I've taken care of it"
msgstr "Ya me he ocupado de ello."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid ""
"I found it, but I'm keeping it, and I'll find you another one.  Let's talk "
"about something else."
msgstr ""
"Lo encontré, pero me lo voy a quedar, ya te encontraré otro. Hablemos de "
"otra cosa."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I found it, but I'm keeping it, and I'll find you another one.  Bye!"
msgstr "Lo encontré, pero me lo voy a quedar, ya te encontraré otro. ¡Adios!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Mission success!  I don't know what else to say."
msgstr "¡Misión cumplida! No sé qué otra cosa decir."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Glad to help.  I need no payment."
msgstr "Me alegra ayudar. No necesito que me paguen."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "How about some items as payment?"
msgstr "¿Qué tal algunos objetos como pago?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/godco/NPC_Corrie_Kaja_Dosia.json
msgid "Maybe you can teach me something as payment?"
msgstr "¿Quizás puedas enseñarme algo como pago?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Glad to help.  I need no payment.  Bye!"
msgstr "Me alegra ayudar. No necesito que me paguen. ¡Adiós!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_doctor.json
msgid "Glad to help."
msgstr "Encantado de ayudar."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Glad to help.  Bye!"
msgstr "Encantado de ayudar. Adiós."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Well, um, sorry."
msgstr "Bueno, em, perdón."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I'm sorry.  I did what I could."
msgstr "Lo lamento. Hice lo que pude."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Sure, here you go!"
msgstr "¡Claro, aquí tienes!"

#. ~ Response to NPC dialogue
#. ~ Dialogue line in mission "Retrieve the fertility supplements"
#. ~ Dialogue line in mission "Find cactus seeds"
#. ~ Dialogue line in mission "Fishy Business"
#. ~ Dialogue line in mission "Mathematical Measures"
#. ~ Dialogue line in mission "Plumbing Maintenance"
#. ~ Dialogue line in mission "Planning Planers"
#. ~ Dialogue line in mission "Purging Heresy"
#. ~ Dialogue line in mission "Find Chris Isherwood"
#. ~ Dialogue line in mission "Gather 2000 units of sand"
#. ~ Dialogue line in mission "Gather 100 units of clay"
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/godco/NPC_Helena_Misinter.json
#: data/json/npcs/godco/NPC_Maria_Serrano.json
#: data/json/npcs/godco/godco_missions.json
#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#: data/json/npcs/other/homeless/group_camp/TALK_homeless_broker.json
#: data/json/npcs/robofac/robofac_intercom/robofac_intercom.json
#: data/json/npcs/robofac/robofac_intercom/robofac_intercom_missions.json
#: data/mods/DinoMod/NPC/NC_BO_BARONYX.json
msgid "Thank you."
msgstr "Gracias. "

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Thanks, bye."
msgstr "Gracias, adiós."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/other/NPC_pizzaiolo.json
msgid "Are we there yet, <name_g>?  I can't wait to burn that building!"
msgstr "¿Ya hemos llegado, <name_g>? ¡No puedo esperar a quemar ese edificio!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/other/NPC_pizzaiolo.json
msgid "We're here.  Let's do it!"
msgstr "Estamos aquí. Vamos a hacerlo."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/other/NPC_pizzaiolo.json
msgid "Be patient, <name_g>, we're getting there soon."
msgstr "Ten paciencia,<name_g>, pronto llegaremos."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Well, I guess it's just us."
msgstr "Bueno, supongo que solo quedamos nosotros."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "At least we've got shelter."
msgstr "Por lo menos tenemos un refugio."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "What should we do now?"
msgstr "¿Qué hacemos ahora?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Any tips?"
msgstr "¿Algún consejo?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/other/meteorologist.json
msgid "Want to travel with me?"
msgstr "¿Quieres viajar conmigo?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Want to share some useful items with me?"
msgstr "¿Quieres compartir algunos objetos útiles conmigo?"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I don't know, look for supplies and other survivors I guess."
msgstr "No sé, buscar suministros o a otros supervivientes, supongo."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Maybe we should start boarding up this place."
msgstr "Tal vez deberíamos empezar por entablar este lugar."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid ""
"I suppose getting a car up and running should really be useful if we have to"
" disappear quickly from here."
msgstr ""
"Supongo que conseguir un coche que funcione va a ser útil si tenemos que "
"salir rápido de aquí."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid ""
"We could look for one of those farms out here.  They can provide plenty of "
"food and aren't close to the cities."
msgstr ""
"Podemos buscar una de esas granjas de por aquí. Nos pueden brindar mucha "
"comida y están alejadas de las ciudades."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid ""
"We should probably stay away from those cities, even if there's plenty of "
"useful stuff there."
msgstr ""
"Probablemente, deberíamos mantenernos lejos de esas ciudades, incluso aunque"
" haya un montón de cosas útiles ahí."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Hmm, okay."
msgstr "Hmm, bueno."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Thanks!"
msgstr "¡Gracias!"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Focus on the road, mate!"
msgstr "¡Concéntrate en la carretera, amigo!"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I must focus on the road!"
msgstr "¡Debo concentrarme en el carretera!"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'm too thirsty, give me something to drink."
msgstr "Tengo mucha sed, dame algo para beber."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'm too hungry, give me something to eat."
msgstr "Tengo mucha hambre, dame algo para comer."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'm too tired, let me rest first."
msgstr "Demasiado esfuerzo, dejame descansar un poco."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Nothing comes to my mind now.  Ask me later perhaps?"
msgstr "Nada me viene a la mente ahora. ¿Pregúntame más tarde quizás?"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I have some reason for not telling you."
msgstr "Tengo razones para no contártelo."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Ah, okay."
msgstr "Ah, bueno."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Not until I get some antibiotics…"
msgstr "No hasta que consiga algunos antibióticos..."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "You asked me recently; ask again later."
msgstr "Si me lo preguntastes hace nada, pregúntamelo más tarde."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Why should I travel with you?"
msgstr "¿Por qué tendría que viajar contigo?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Understood.  I'll get those antibiotics."
msgstr "Entendido. Voy a conseguir esos antibióticos."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Right, right, I'll ask later."
msgstr "Vale, vale, ya te lo pregúntare más tarde."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I can keep you safe."
msgstr "Te puedo mantener a salvo."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "You can keep me safe."
msgstr "Me puedes mantener a salvo."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'll kill you if you don't."
msgstr "Te mataré si no lo haces."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "You got it, I'm with you!"
msgstr "¡No hay problema, estoy contigo!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Awesome!"
msgstr "¡Estupendo!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, let's go!"
msgstr "¡Bueno, vamos!"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Yeah… I don't think so."
msgstr "Ya... No lo creo."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "What is it?"
msgstr "¿Qué pasa?"

#. ~ Response to NPC dialogue
#. ~ Dialogue line in mission "Return Barry to Eddie at the dairy."
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
msgid "How much further?"
msgstr "¿Cuánto más falta?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'd like to lead for a while."
msgstr "Me gustaría guiar por un rato."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Step aside.  I'm leader now."
msgstr "Hacete a un lado. Ahora yo soy el líder."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Alright.  You can lead now."
msgstr "Bueno. Ahora puedes guiarme."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Good.  Something else…"
msgstr "Bien. Algo más..."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Alright, let's go."
msgstr "Bueno, vamos."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, okay."
msgstr "Bueno, bueno."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Alright, show me how it's done."
msgstr "Muy bien, muéstrame cómo se hace."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, let's begin."
msgstr "Bien, empecemos."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay.  Lead the way."
msgstr "Bueno. Guiá el camino."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "No, we'll be okay here."
msgstr "No, vamos a estar bien aquí."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "On second thought, never mind."
msgstr "Pensandolo bien, olvidate."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Alright, who should participate?"
msgstr "Muy bien, ¿quién debería participar?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Let's see…"
msgstr "Veamos…"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Alright, let's begin."
msgstr "Bueno, comencemos."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Sounds good."
msgstr "Suena bien."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I can't train you properly while you're operating a vehicle!"
msgstr "¡No puedo entrenarte apropiadamente mientras conduces un vehículo!"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I can't train you properly while I'm operating a vehicle!"
msgstr ""
"¡No puedo entrenarte apropiadamente mientras estas manejando un vehículo!"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Give it some time, I'll show you something new later…"
msgstr "Dale un poco de tiempo, luego te mostraré algo nuevo..."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I have some reason for denying you training."
msgstr "Tengo un motivo para no entrenarte."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid ""
"We'll talk about a training seminar after you're done operating that "
"vehicle."
msgstr ""
"Hablaremos de un seminario de formación después de que hayas operado ese "
"vehículo."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I can't host a seminar while I'm operating a vehicle!"
msgstr "¡No puedo organizar un seminario mientras conduzco un vehículo!"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Give it some time, we'll talk about a training seminar later…"
msgstr ""
"Dale un poco de tiempo, luego hablaremos de un seminario de formación..."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I have some reason to refuse hosting a training seminar."
msgstr ""
"Tengo alguna razón para negarme a organizar un seminario de formación."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Not a bloody chance, I'm going to get left behind!"
msgstr "¡No hay ninguna oportunidad, me van a dejar atrás!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/holdouts/Rural-Cowboy_Nihilist.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_barber.json
msgid "Fine."
msgstr "Bien."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'm on watch."
msgstr "Estoy de guardia."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I need you to come with me."
msgstr "Necesito que vengas conmigo."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I really don't feel comfortable doing so…"
msgstr "Realmente no me siento cómodo haciéndolo..."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'll give you some space."
msgstr "Te voy a dar un poco de espacio."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'd prefer to keep that to myself."
msgstr "Prefiero quedarme con eso para mí."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I understand…"
msgstr "Entiendo..."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "You just asked me for stuff; ask later."
msgstr "Ya me pediste cosas; pregúntame en otro momento."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Why should I share my equipment with you?"
msgstr "¿Por qué tendría que compartir mi equipo contigo?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, fine."
msgstr "Bueno, está bien."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Because I'm holding a thermal detonator!"
msgstr "¡Porque tengo un detonador térmico!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Because I'm your friend!"
msgstr "¡Porque soy tu amigo!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Well, I am helping you out…"
msgstr "Bueno, te estoy ayudando..."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'll give it back!"
msgstr "¡Te lo voy a devolver!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Give it to me, or else!"
msgstr "¡Dámelo o vas a ver!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Eh, never mind."
msgstr "Eh, no importa."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Never mind, I'll do without.  Bye."
msgstr "No importa, lo voy a hacer sin eso. Chao."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, here you go."
msgstr "Bueno, aquí tienes."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Thanks!  But can I have some more?"
msgstr "¡Gracias! ¿Pero me puedes dar más?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Thanks, see you later!"
msgstr "¡Gracias, nos vemos después!"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "You picked up something that does not belong to you…"
msgstr "Has cogido algo que no te pertenece..."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, okay, this is all a misunderstanding.  Sorry, I'll drop it now."
msgstr ""
"Vale, vale, todo esto es un malentendido. Lo siento, lo soltaré ahora."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "No, I'm keeping it.  Try and take it off me, I dare you."
msgstr "No, me lo voy a quedar. Intenta quitármelo si puedes."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Look, I really need this.  Please let me have it."
msgstr "Mira, realmente necesito esto. Por favor, déjame tenerlo."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "What, this?  It's not the same one, you are mistaken."
msgstr "¿Qué, esto? No es el mismo, te equivocas."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'm sorry.  Look, I already dropped it, okay?"
msgstr "Lo siento. Mira, ya se me lo dejado, ¿vale?"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Don't try and talk yourself out of this, drop it now."
msgstr "No intentes convencerte a ti mismo de que no hacerlo, déjalo ya."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, I'm dropping it…"
msgstr "Bien, lo estoy soltando..."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Just this once, you can keep it.  Don't tell anyone else."
msgstr "Sólo por esta vez, puedes quedártelo. No se lo digas a nadie más."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/godco/NPC_Aunt_Theresa.json
#: data/json/npcs/godco/NPC_Helena_Misinter.json
