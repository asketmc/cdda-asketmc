msgstr[1] "tiendas de campaña"
msgstr[2] "tiendas de campaña"

#. ~ Description of "tent"
#: data/json/items/tool/shelters.json
msgid ""
"This is a small personal tent, it's just big enough to fit you comfortably."
msgstr ""
"Es una pequeña tienda de campaña personal, lo suficientemente grande para "
"que entres cómodo."

#. ~ Item name
#: data/json/items/tool/shelters.json
msgid "aluminum tent pole"
msgid_plural "aluminum tent poles"
msgstr[0] "pertiga de aluminio para carpa"
msgstr[1] "pertigas de aluminio para carpa"
msgstr[2] "pertigas de aluminio para carpa"

#. ~ Description of "aluminum tent pole"
