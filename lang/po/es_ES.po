#. ~ Item name
#: data/json/items/fuel.json
msgid "ethanol"
msgid_plural "ethanol"
msgstr[0] "etanol"
msgstr[1] "etanol"
msgstr[2] "etanol"

#. ~ Description of "ethanol"
#: data/json/items/fuel.json
msgid ""
"Extremely pure alcohol suitable for use as a component in chemical "
"reactions.  You could also water it down and drink it, or use it as fuel in "
"alcohol-burning stoves."
msgstr ""
"Alcohol extremadamente puro, útil para usar como componente en reacciones "
"químicas. También le puedes agregar agua para hacerlo bebible, o usarlo como"
" combustible en cocinas de alcohol."

#. ~ Item name
#: data/json/items/fuel.json
msgid "methylated spirits"
msgid_plural "methylated spirits"
msgstr[0] "espíritu de metilación"
msgstr[1] "espíritus de metilación"
msgstr[2] "espíritus de metilación"

#. ~ Description of "methylated spirits"
#: data/json/items/fuel.json
msgid ""
"A high-strength ethanol solution mixed with methanol to make it toxic to "
"drink, so as to avoid pre-apocalyptic regulations on ethanol.  Intended for "
"use in alcohol-burning stoves and as a solvent."
msgstr ""
"Una solución muy potente de etanol mezclada con metanol para convertirlo en "
"tóxico al ingerir, asi como evitar regulaciones pre-apocalípticas sobre el "
"etanol. Pensado para ser usado en cocinas de alcohol y como un solvente."

#. ~ Item name
#: data/json/items/fuel.json
msgid "denatured alcohol"
msgid_plural "denatured alcohols"
msgstr[0] "alcohol desnaturalizado"
msgstr[1] "alcohol desnaturalizado"
msgstr[2] "alcohol desnaturalizado"

#. ~ Description of "denatured alcohol"
#: data/json/items/fuel.json
msgid ""
"A high-strength ethanol solution mixed with denatonium benzoate to make it "
"impossibly bitter to drink, so as to avoid pre-apocalyptic regulations on "
"ethanol.  Intended for use in alcohol-burning stoves and as a solvent."
msgstr ""
"Una solución de etanol de alta potencia mezclada con benzoato de denatonio "
"para hacerla imposiblemente amarga de beber, a fin de evitar las "
"regulaciones pre-apocalípticas sobre el etanol. Destinado a su uso en "
"estufas de alcohol y como disolvente."

#. ~ Description of "methanol"
#: data/json/items/fuel.json
msgid ""
"High purity methanol suitable for use in chemical reactions.  Could be used "
"in alcohol-burning stoves.  Very toxic."
msgstr ""
"Metanol de alta pureza, útil para usar en reacciones químicas. Puede ser "
"utilizado como combustible en cocinas de alcohol. Muy tóxico."

#. ~ Description of "diesel"
#: data/json/items/fuel.json
msgid ""
"Petroleum-based fuel made from a byproduct of the gasoline making process."
msgstr ""
"Combustible a base de petróleo hecho de un subproducto del proceso de "
"fabricación de la gasolina."

#. ~ Item name
#: data/json/items/fuel.json
msgid "JP8 fuel"
msgid_plural "JP8 fuel"
msgstr[0] "combustible JP8"
msgstr[1] "combustible JP8"
msgstr[2] "combustible JP8"

#. ~ Description of "JP8 fuel"
#: data/json/items/fuel.json
msgid ""
"A kerosene-based fuel used mainly by US military vehicles as a replacement "
"for diesel and jet fuel, to simplify logistics."
msgstr ""
"Combustible a base de queroseno utilizado principalmente por los vehículos "
"militares de los Estados Unidos como sustituto del gasoil y el combustible "
"para aviones, para simplificar logísticas."

#. ~ Item name
#: data/json/items/fuel.json
msgid "avgas fuel"
msgid_plural "avgas fuel"
msgstr[0] "combustible avgas"
msgstr[1] "combustible avgas"
msgstr[2] "combustible avgas"

#. ~ Description of "avgas fuel"
#: data/json/items/fuel.json
msgid "A specialized type of petroleum-based fuel used to power aircraft."
msgstr ""
"Un tipo especializado de combustible basado en el petróleo que se utiliza "
"para propulsar aeronaves."

#. ~ Item name
#: data/json/items/fuel.json
