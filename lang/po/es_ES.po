msgid_plural "titanium rings"
msgstr[0] "anillo de titanio"
msgstr[1] "anillos de titanio"
msgstr[2] "anillos de titanio"

#. ~ Description of "titanium ring"
#: data/mods/Aftershock/items/items.json
msgid ""
"A thick, masculine ring made out of titanium.  Made in a variety of styles "
"and finishes, they're valued for their durability."
msgstr ""
"Un anillo masculino y grueso hecho de titanio. Hechos en una variedad de "
"estilos y acabados, son valorados por su durabilidad."

