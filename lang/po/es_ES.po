#. ~ Profession name for male
#: data/json/professions.json
msgctxt "profession_male"
msgid "Captain"
msgstr "Capitán"

#. ~ Description of profession "Captain" for male
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You were the captain of your small ship, making a living by driving divers "
"and tourists around the sea.  The last excursion went wrong after your "
"passengers tried a mutiny, but you managed to escape with your precious ship"
" intact."
msgstr ""
"Eras el capitán de tu pequeño barco y te ganabas la vida llevando a "
"buceadores y turistas por el mar. La última excursión salió mal después de "
"que tus pasajeros intentaran un motín, pero lograste escapar con tu precioso"
" barco intacto."

#. ~ Profession name for female
#: data/json/professions.json
msgctxt "profession_female"
msgid "Captain"
msgstr "Capitana"

#. ~ Description of profession "Captain" for female
#: data/json/professions.json
