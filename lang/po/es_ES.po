#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "half-built brick wall"
msgstr "muro de ladrillos a medio construir"

#. ~ Description of terrain "half-built brick wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"Half of a brick wall, looks like it still requires some more resources and "
"effort before being considered a real wall."
msgstr ""
"La mitad de un muro de ladrillos, todavía le faltan materiales y esfuerzo "
"para poder ser considerada seriamente un muro."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "brick wall"
msgstr "muro de ladrillos"

#. ~ Description of terrain "brick wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A solid brick wall, sturdy enough to support a roof with enough walls and "
"keep out any unwanted visitors."
msgstr ""
"Una sólido muro de ladrillos, lo suficientemente resistente como para "
"aguantar un techo con más muros y mantener afuera a los visitantes "
"indeseados."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "stone wall"
msgstr "muro de piedra"

#. ~ Description of terrain "stone wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "A sturdy stone wall."
msgstr "Un robusto muro de piedra."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "half-built stone wall"
msgstr "muro de piedra a medio construir"

#. ~ Description of terrain "half-built stone wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"Half of a sturdy stone wall.  Some work still needs to be done before this "
"stone wall is complete."
msgstr ""
"La mitad de un muro de piedra resistente. Todavía hay que hacer algo de "
"trabajo antes de que este muro de piedra esté completo."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "smoothed rock"
msgstr "roca suavizada"

#. ~ Description of terrain "smoothed rock"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A block of stone that's been smoothed and shaped, commonly granite or marble"
" for funerary chapels and mausoleums."
msgstr ""
"Es un bloque de piedra que ha sido alisada, usualmente de granito o mármol "
"para usar en capillas y mausoleos."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "half-built adobe wall"
msgstr "un muro de adobe a medio construir"

#. ~ Description of terrain "half-built adobe wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"Half of an adobe brick wall, looks like it still requires some more "
"resources and effort before being considered a real wall."
msgstr ""
"La mitad de un muro de ladrillo de adobe, parece que todavía requiere "
"algunos recursos y esfuerzos más, antes de ser considerado un muro real."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "adobe wall"
msgstr "muro de adobe"

#. ~ Description of terrain "adobe wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A solid adobe brick wall, sturdy enough to support a roof with enough walls "
"and keep out any unwanted visitors."
msgstr ""
"Un muro de adobe sólido, lo suficientemente robusto como para soportar un "
"techo con suficientes muros y mantener alejados a los visitantes no "
"deseados."

#. ~ Description of terrain "concrete wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"An aesthetically pleasing design with simple lines, this type of concrete "
"was used with a weaker chemical mixture in order to have faster setting "
"times.  Not ideal for multi-story buildings, but still capable of supporting"
" a roof."
msgstr ""
"Un diseño estético con líneas simples, este tipo de hormigón se utilizó con "
"una mezcla química más débil para tener tiempos de fraguado más rápidos. No "
"es ideal para edificios de varios pisos, pero aún así es capaz de soportar "
"un techo."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "concrete wall with ropes"
msgstr "muro de hormigón con sogas"

#. ~ Description of terrain "concrete wall with ropes"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A boxlike wall of concrete with ropes attached to the exterior edges.  Used "
"to train parkour."
msgstr ""
"Un muro de hormigón en forma de caja con sogas sujetas a los bordes "
"exteriores. Se utiliza para entrenar haciendo parkour."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "corrugated metal wall"
msgstr "muro de metal corrugado"

#. ~ Description of terrain "corrugated metal wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A wall made from a thin sheet of corrugated steel held in a frame, weather "
"and wind proof but not very insulating or durable."
msgstr ""
"Un muro fabricado con una fina lámina de acero corrugado sujeto a un marco, "
"resistente a la intemperie y al viento, pero no muy aislante ni duradero."

#. ~ Description of terrain "bulkhead"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"An industrially fabricated thick sheet carefully positioned, this wall is "
"capable of resisting extreme elements as well as hostile forces."
msgstr ""
"Una lámina gruesa fabricada industrialmente y cuidadosamente colocada, este "
"muro es capaz de resistir los climas extremos, así como las fuerzas "
"hostiles."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "simple concrete wall"
msgstr "muro de hormigón común"

#. ~ Description of terrain "simple concrete wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A durable and uniform concrete wall, quite drab without decoration.  More "
"than capable of supporting a roof, as well as keeping out most anything, "
"save for vehicles."
msgstr ""
"Un muro de hormigón duradero y uniforme, bastante monótono sin decoración. "
"Más que capaz de soportar un techo, así como de mantener fuera casi todo, "
"excepto los vehículos."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "half-built simple concrete wall"
msgstr "muro de hormigón común a medio construir"

#. ~ Description of terrain "half-built simple concrete wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A partially poured concrete wall that could probably keep anything behind it"
" quite safe if it were finished."
msgstr ""
"Un muro de hormigón parcialmente vertido que probablemente podría mantener "
"cualquier cosa detrás de él bastante seguro si estuviera terminado."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "reinforced concrete wall"
msgstr "muro de hormigón armado"

#. ~ Description of terrain "reinforced concrete wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"An extremely resilient wall, filled with concrete and rebar.  Best suited "
"for supporting multi-level buildings, only serious explosives and high-speed"
" impacts would be capable of damaging this wall."
msgstr ""
"Un muro extremadamente resistente, lleno de hormigón y barras corrugadas. "
"Más adecuado para soportar edificios de varios niveles, sólo los explosivos "
"graves y los impactos de alta velocidad serían capaces de dañar este muro."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "half-built reinforced concrete wall"
msgstr "muro de hormigón armado a medio construir"

#. ~ Description of terrain "half-built reinforced concrete wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"Poured concrete with methodically placed rebar sticking out, which isn't "
"practical for supporting roofs or shelter.  It appears to need more "
"resources before being considered complete."
msgstr ""
"Hormigón vertido con barras corrugadas colocadas metódicamente, lo que no es"
" práctico para soportar techos o refugios. Parece necesitar más recursos "
"antes de estar completo."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "rebar cage"
msgstr "jaula de barras corrugadas"

#. ~ Description of terrain "rebar cage"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A structural support system made of rebar that appears to be the early "
"stages of a reinforced concrete wall, just missing the poured concrete."
msgstr ""
"Un sistema de apoyo estructural hecho de barras corrugadas que parecen ser "
"las primeras etapas de un muro de hormigón armado, al que sólo le falta el "
"hormigón vertido."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "simple metal wall"
msgstr "muro simple de metal"

#. ~ Description of terrain "simple metal wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A relatively simple wall made of scraped together metal.  It's still capable"
" of blocking intruders and supporting a roof with adjacent walls."
msgstr ""
"Un muro relativamente simple hecha de metal raspado. Es capaz de bloquear a "
"los intrusos y soportar un techo con muros adyacentes."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "half-built simple metal wall"
msgstr "muro simple de metal a medio construir"

#. ~ Description of terrain "half-built simple metal wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A partially built makeshift wall of metal that could potentially support a "
"roof if it were completed."
msgstr ""
"Un muro improvisado de metal a medio construir, que podría soportar un techo"
" si estuviera terminado."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "wooden wall"
msgstr "muro de madera"

#. ~ Description of terrain "wooden wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A finished wall of planks and support beams, capable of supporting an upper "
"level or roof.  Still highly flammable."
msgstr ""
"Un muro terminado de tablones y vigas de soporte, capaz de soportar un nivel"
" superior o techo. Altamente inflamable."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "chipped wood wall"
msgstr "muro astillado de madera"

#. ~ Description of terrain "chipped wood wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A wall of aligned planks that's starting to crack and break open.  Some cut "
"wood and a number of nails could patch this up quick."
msgstr ""
"Un muro de tablones alineados que está empezando a agrietarse y romperse. Un"
" poco de madera cortada y varios clavos podrían parchear esto rápidamente."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "broken wood wall"
msgstr "muro roto de madera"

#. ~ Description of terrain "broken wood wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A number of planks are missing and the structure is beginning to sag and "
"fall apart.  It's going to need quite a bit of work to repair this wall."
msgstr ""
"Faltan varios tablones y la estructura está empezando a ceder y a "
"desmoronarse. Va a hacer falta bastante trabajo para reparar este muro."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "half-built log wall"
msgstr "muro de leños a medio construir"

#. ~ Description of terrain "half-built log wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A half-constructed wall of notched logs that interlock to provide stability."
"  Needs a few more logs to hold up a roof.  Looks flammable."
msgstr ""
"Un muro a medio construir hecha de leños dentados que se interconectan para "
"crear estabilidad. Necesita algunos leños más para poder soportar un techo. "
"Parece inflamable."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "log wall"
msgstr "muro de leños"

#. ~ Description of terrain "log wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A tall wall of timber suitable for housing and insulating from the weather."
"  Quite flammable."
msgstr ""
"Un muro alta de madera, ideal para una casa y para aislarte del clima. "
"Bastante inflamable, eso sí."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "chipped log wall"
msgstr "muro quebrado de leños"

#. ~ Description of terrain "chipped log wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A moderately damaged wall, could probably be patched up with some planks and"
" nails."
msgstr ""
"Un muro moderadamente dañado, probablemente podría ser remendado con algunos"
" tablones y clavos."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "broken log wall"
msgstr "muro roto de leños"

#. ~ Description of terrain "broken log wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A destroyed wood wall, with only a supporting log left, ready to collapse.  "
"Looks repairable if the damage was replaced and patched together with nails "
"and planks."
msgstr ""
"Un muro de madera destruido, con sólo un leño de soporte, listo para "
"colapsar. Parece reparable si el daño fuera reemplazado y remendado con "
"clavos y tablas."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "palisade wall"
msgstr "empalizada"

#. ~ Description of terrain "palisade wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"An age-old type of fortification consisting of hefty lumber staked into the "
"ground and cabled together."
msgstr ""
"Un tipo de fortificación antigua que consiste en madera pesada clavada en el"
" suelo y cableada."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "wattle-and-daub wall"
msgstr "muro de bareque"

#. ~ Description of terrain "wattle-and-daub wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A relatively primitive wall made by daubing together a lattice of wooden "
"strips using some combination of wet soil, clay, sand, animal dung and "
"straw."
msgstr ""
"Un muro relativamente primitivo hecha con una red de listones de madera "
"utilizando una combinación de tierra húmeda, arcilla, arena, estiércol y "
"paja."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "broken wattle-and-daub wall"
msgstr "muro de bareque roto"

#. ~ Description of terrain "broken wattle-and-daub wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"This wattle-and-daub wall section has been destroyed, leaving mostly just "
"frame, and is barely held together."
msgstr ""
"Esta sección de muro de bareque ha sido destruido, dejando en su mayoría "
"sólo el marco, y apenas se mantiene unido."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "half-built wattle-and-daub wall"
msgstr "muro de bareque a medio construir"

#. ~ Description of terrain "half-built wattle-and-daub wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"This wattle-and-daub wall has some of the wooden strip lattice in place, and"
" still requires the rest of the lattice and supporting wet compound to be "
"filled in."
msgstr ""
"Este muro de bareque tiene parte del enrejado de madera en su lugar, y "
"todavía requiere que se rellene el resto del enrejado y el compuesto húmedo "
"de soporte."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "junk metal wall"
msgstr "muro de chatarra"

#. ~ Description of terrain "junk metal wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A wall of rusty scrap metal bolted and wire-tied to a sturdy frame.  Very "
"fashionable in post-apocalyptic shantytowns.  Can support a roof."
msgstr ""
"Un muro de chatarra oxidado atornillado y atado con alambre a un marco "
"robusto. Muy de moda en los barrios de chabolas post-apocalípticos. Puede "
"soportar un techo."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "rammed earth wall"
msgstr "muro de tierra compactada"

#. ~ Description of terrain "rammed earth wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A solid wall of compressed dirt, sturdy enough to support a roof with enough"
" walls and keep out some unwanted visitors."
msgstr ""
"Un muro sólido de tierra comprimida, lo suficientemente robusta como para "
"soportar un techo con suficientes muros y mantener fuera a algunos "
"visitantes no deseados."

#. ~ Bashing sound of terrain "rammed earth wall"
#. ~ Bashing sound of terrain "smooth dirt wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "heavy rumbling!"
msgstr "¡Un fuerte estruendo!"

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "smooth dirt wall"
msgstr "muro de tierra lisa"

#. ~ Description of terrain "smooth dirt wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A solid wall of compressed dirt, mixed with… something to keep it stable.  "
"Its surface glistens slightly, and it smells like rotten milk."
msgstr ""
"Un sólido de tierra compactada, mezclada con... algo que la mantiene "
"estable. Su superficie brilla ligeramente y huele a leche podrida."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "warped wall"
msgstr "muro deformado"

#. ~ Description of terrain "warped wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"Almost a simple stone wall.  But the angles don't add up, the shadows are "
"wrong, whatever this is, it doesn't belong here."
msgstr ""
"Casi un simple muro de piedra. Pero los ángulos no encajan, las sombras "
"están mal, sea lo que sea esto, no pertenece a este lugar."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "junk metal barrier"
msgstr "barrera de chatarra"

#. ~ Description of terrain "junk metal barrier"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A simple wall of rusty scrap metal bolted and wire-tied to a makeshift "
"frame.  Very fashionable in post-apocalyptic shantytowns.  This one isn't "
"quite strong enough to support a roof, but could be reinforced."
msgstr ""
"Un simple muro de chatarra metálica atornillada y atada con alambre a una "
"estructura improvisada. Muy elegante para las chabolas post-apocalípticos. "
"Este no es tan fuerte como para sostener un techo, pero puede ser reforzado."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "glass wall"
msgstr "muro de cristal"

#. ~ Description of terrain "glass wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A barrier made of glass, it's nothing complicated, and looks extremely "
"fragile.  Some contain glass break sensors or window sensors that trigger if"
" the glass is tampered."
msgstr ""
"Es una barrera hecha de vidrio, nada complicado, y parece extremadamente "
"frágil. Algunos contienen sensores de rotura de vidrio o sensores de "
"ventanas que se activan si se manipula el vidrio."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "laminated glass"
msgstr "cristal laminado"

#. ~ Description of terrain "laminated glass"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"Laminated glass is composed layers of glass and plastic held together by an "
"interlayer."
msgstr ""
"El vidrio laminado está compuesto por capas de vidrio y plástico unidas por "
"una capa intermedia."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "ballistic glass"
msgstr "cristal balístico"

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "reinforced glass"
msgstr "cristal reforzado"

#. ~ Description of terrain "reinforced glass"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A thicker pane of glass with thin metal wires embedded throughout, "
"strengthening the structural properties.  Still weaker than other types of "
"walls, and not made to support a roof either."
msgstr ""
"Un panel grueso de vidrio con delgados cables metálicos entretejidos, lo que"
" hacen la estructura más fuerte. Igual es más débil que otro tipo de muro, y"
" no puede soportar un techo."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "reinforced glass with closed shutters"
msgstr "cristal reforzado con persiana cerrada"

#. ~ Description of terrain "reinforced glass with closed shutters"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A secondary layer of protection over reinforced glass, these metal shutters "
"are typically used to ward off criminals or protect against damage from "
"extreme weather.  Looks like it can only be opened from the inside.  Even "
"with the installed shutters, it isn't feasible in supporting a roof."
msgstr ""
"Una capa secundaria de protección sobre el vidrio reforzado, estas persianas"
" metálicas se utilizan típicamente para proteger a los delincuentes o para "
"protegerse de los daños causados por el clima extremo. Parece que sólo se "
"puede abrir desde el interior. Incluso con las persianas instaladas, no es "
"factible soportar un techo."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "reinforced glass with open shutters"
msgstr "cristal reforzado con persiana abierta"

#. ~ Description of terrain "reinforced glass with open shutters"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"Hanging metal shutters that haven't been deployed, exposing the reinforced "
"glass.  It appears as though the metal shutters can only be activated from "
"the inside."
msgstr ""
"Tiene unas cortinas de metal colgando que no han sido desplegadas, dejando "
"expuesto el vidrio reforzado. Parece que esas cortinas solo pueden ser "
"activadas desde el interior."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "metal bars"
msgstr "barras de metal"

#. ~ Description of terrain "metal bars"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"Thick, heavy bars from the floor to the ceiling, interlaced wall to wall.  "
"Not made to support roofs, but great for blocking paths."
msgstr ""
"Gruesas y pesadas barras del suelo al techo, entrelazadas de muro a muro. No"
" están hechas para soportar los techos, pero son ideales para bloquear los "
"caminos."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "paper wall"
msgstr "muro de papel"

#. ~ Description of terrain "paper wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A huge wall of pulpy mass, covered in sticky wasp saliva.  You could smash "
"it down effortlessly."
msgstr ""
"Una enorme muro de masa pulposa, cubierta de saliva pegajosa de avispa. "
"Podrías derribarla sin esfuerzo."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "layered paper wall"
msgstr "muro de papel estratificado"

#. ~ Description of terrain "layered paper wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A thick wall of layered tree pulp and wasp saliva, hardened to withstand the"
" elements.  You could break through this, but it won't be easy."
msgstr ""
"Un grueso muro de capas de pulpa de árbol y saliva de avispa, endurecido "
"para soportar los elementos. Podrías atravesar esto, pero no será fácil."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "root wall"
msgstr "muro de raíces"

#. ~ Description of terrain "root wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "A dirt wall covered with roots."
msgstr "Una muro de tierra cubierta de raíces."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "wax wall"
msgstr "muro de cera"

#. ~ Description of terrain "wax wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "A wall made entirely out of wax."
msgstr "Un muro hecho completamente de cera."

#. ~ Terrain name
#. ~ Overmap terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
#: data/json/obsoletion/overmap/overmap_terrain/overmap_terrain_necropolis.json
#: data/json/overmap/overmap_terrain/overmap_terrain.json
#: data/json/overmap/overmap_terrain/overmap_terrain_evac_center.json
#: data/json/overmap/overmap_terrain/overmap_terrain_lab.json
#: data/mods/Magiclysm/worldgen/overmap_terrain.json
msgid "solid earth"
msgstr "tierra sólida"

#. ~ Description of terrain "solid earth"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "A wall of solid earth."
msgstr "Un muro de tierra sólida."

#. ~ Terrain name
#. ~ Overmap terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
#: data/json/obsoletion/overmap/overmap_terrain/overmap_terrain_necropolis.json
#: data/json/overmap/overmap_terrain/overmap_terrain.json
#: data/json/overmap/overmap_terrain/overmap_terrain_evac_center.json
#: data/json/overmap/overmap_terrain/overmap_terrain_hardcoded.json
#: data/json/overmap/overmap_terrain/overmap_terrain_microlab.json
#: data/mods/Graphical_Overmap/go_overmap_terrain_evac_center.json
#: data/mods/Magiclysm/worldgen/overmap_terrain.json
#: data/mods/alt_map_key/overmap_terrain.json
#: data/mods/innawood/mining/furniture_and_terrain/terrain-walls.json
msgid "solid rock"
msgstr "piedra sólida"

#. ~ Description of terrain "solid rock"
#: data/json/furniture_and_terrain/terrain-walls.json
#: data/mods/innawood/mining/furniture_and_terrain/terrain-walls.json
msgid ""
"It's solid rock, could be full of all kinds of interesting things.  Best "
"grab your pickaxe or equivalent digging implement, and strike the earth!"
msgstr ""
"Es roca sólida, podría estar llena de todo tipo de cosas interesantes. "
"¡Mejor agarra tu pico o un instrumento de excavación equivalente y golpear "
"la tierra!"

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "red stone"
msgstr "piedra roja"

#. ~ Description of terrain "red stone"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "A red stone."
msgstr "Una piedra roja."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "green stone"
msgstr "piedra verde"

#. ~ Description of terrain "green stone"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "A green stone."
msgstr "Una piedra verde."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "blue stone"
msgstr "piedra azul"

#. ~ Description of terrain "blue stone"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "A blue stone."
msgstr "Una piedra azul."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "little column"
msgstr "columna pequeña"

#. ~ Description of terrain "little column"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "A small support column."
msgstr "Una pequeña columna de soporte."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "half-built column"
msgstr "columna a medio construir"

#. ~ Description of terrain "half-built column"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"An empty wooden frame in the shape of a column, built around a concrete and "
"rebar foundation.  It isn't capable of supporting roofs or shelter, and "
"appears to need more resources before being considered complete."
msgstr ""
"Un marco de madera vacío en forma de columna, construido alrededor de una "
"base de hormigón y barras corrugadas. No es capaz de soportar techos o "
"refugios, y parece que necesita más recursos antes de ser considerada "
"completa."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "column"
msgstr "columna"

#. ~ Description of terrain "column"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "A concrete column."
msgstr "Una columna de hormigón."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "bollard"
msgstr "bolardo"

#. ~ Description of terrain "bollard"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A set of concrete and steel bollards designed to harden areas against "
"vehicle ram attacks.  It requires a few more steps to walk in between the "
"bollards sticking up out of the ground."
msgstr ""
"Un conjunto de bolardos de hormigón y acero diseñados para endurecer las "
"zonas contra los ataques de embestidas de vehículos. Requiere más "
"movimientos para caminar entre los bolardos que sobresalen del suelo."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "large metal support"
msgstr "soporte grande de metal"

#. ~ Description of terrain "large metal support"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "A heavy-duty metal support beam."
msgstr "Una viga de soporte de metal resistente."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "small metal support"
msgstr "soporte chico de metal"

#. ~ Description of terrain "small metal support"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "A metal support beam."
msgstr "Una viga de soporte de metal."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "field stone wall"
msgstr "muro de piedra en el campo"

#. ~ Description of terrain "field stone wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "A sturdy dry stone wall.  Just rocks fitted together without mortar."
msgstr "Un robusto muro de piedra seca. Sólo rocas encajadas sin mortero."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "field stone half-wall"
msgstr "medio muro de piedra en el campo"

#. ~ Description of terrain "field stone half-wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A half height sturdy dry stone wall.  Just rocks fitted together without "
"mortar.  Complete as is or with extensive work it could be doubled in "
"height."
msgstr ""
"Un muro de media altura de piedra seca y robusta. Sólo rocas encajadas sin "
"mortero. Completo como está o con un trabajo extenso se podría duplicar su "
"altura."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "pillar"
msgstr "pilar"

#. ~ Description of terrain "pillar"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A concrete column that helps keep the mine's ceiling and walls from "
"collapsing."
msgstr ""
"Una columna de hormigón que ayuda a evitar que el techo y los muros de la "
"mina se derrumben."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "window"
msgstr "ventana"

#. ~ Description of terrain "window"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A giant sheet of glass inserted into a window, typically found on the side "
"of shops to showcase goods."
msgstr ""
"Una hoja de vidrio gigante insertada en una ventana, típicamente encontrada "
"en el costado de las tiendas para exhibir mercancías."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "taped window"
msgstr "ventana encintada"

#. ~ Description of terrain "taped window"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"Duct tape covers this window, blocking sunlight and visibility.  You could "
"remove the duct tape by cutting it off."
msgstr ""
"Esta ventana esta tapada con cinta americana, lo que bloquea la visibilidad "
"y la luz solar. Podrías sacar la cinta americana cortándola."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "window with curtains"
msgstr "ventana con cortinas"

#. ~ Description of terrain "window with curtains"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A closed window with fancy curtains on the inside that can be drawn closed "
"to block visibility and shut out any light."
msgstr ""
"Una ventana cerrada con elegantes cortinas en el interior que pueden "
"cerrarse para bloquear la visibilidad y dejar fuera la luz."

#. ~ Prying message of terrain "window with curtains"
#. ~ Prying message of terrain "window without curtains"
#. ~ Prying message of terrain "window with closed curtains"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "You pry open the window."
msgstr "Abres la ventana a la fuerza."

#. ~ Prying failure of terrain "window with curtains"
#. ~ Prying failure of terrain "window without curtains"
#. ~ Prying failure of terrain "window with closed curtains"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "You pry, but can't pry open the window."
msgstr "Haces palanca, pero no puedes abrir la ventana."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "window without curtains"
msgstr "ventana sin cortinas"

#. ~ Description of terrain "window without curtains"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A closed smaller window typically found in residential homes.  You could "
"install a curtain rod and drapes if you had the supplies and skill."
msgstr ""
"Una ventana cerrada más pequeña que suele encontrarse en las casas "
"residenciales. Podrías instalar una barra de cortina y cortinas si tuvieras "
"los suministros y la habilidad."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "open window without curtains"
msgstr "ventana abierta sin cortinas"

#. ~ Description of terrain "open window without curtains"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A smaller window typically found in residential homes.  It's open and can be"
" crawled through."
msgstr ""
"Es una ventana pequeña que comúnmente tienen las casas residenciales. Está "
"abierta y se puede pasar por ahí."

#. ~ Description of terrain "taped window"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A smaller window typically found in residential homes.  This one has been "
"blocked out with duct tape.  You could remove the duct tape by cutting it "
"off."
msgstr ""
"Una ventana más pequeña que se encuentra típicamente en las casas "
"residenciales. Esta ha sido bloqueada con cinta americana. Podrías quitar la"
" cinta americana cortándola."

#. ~ Description of terrain "taped window"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A window with fancy curtains on the inside.  This one has been blocked out "
"with duct tape.  You could remove the duct tape by cutting it off."
msgstr ""
"Una ventana con elegantes cortinas en la parte interior. Ha sido tapada con "
"cinta americana. Podrías cortar la cinta americana para sacarla."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "open window with curtains"
msgstr "ventana abierta con cortinas"

#. ~ Description of terrain "open window with curtains"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A window with fancy curtains on the inside that can be drawn closed to block"
" visibility and shut out any light.  It's open and you can crawl through."
msgstr ""
"Una ventana con cortinas de fantasía en el interior que se puede cerrar para"
" bloquear la visibilidad y apagar cualquier luz. Está abierta y puedes "
"arrastrarte a través de ella."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "window with closed curtains"
msgstr "cortinas cerradas de ventana"

#. ~ Description of terrain "window with closed curtains"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A closed window with fancy curtains that have been drawn shut, blocking "
"sunlight and visibility.  The curtains can only be opened on the inside.  If"
" you examined the curtains more closely, you could peek through the drapes "
"or tear down everything.  Or you could just smash the window open."
msgstr ""
"Una ventana cerrada con cortinas elegantes que se encuentran cerradas, "
"bloqueando la luz del sol y la visibilidad. Las cortinas sólo se pueden "
"abrir por dentro. Si examinas las cortinas más de cerca, podrías asomarte a "
"través de las cortinas o destrozar todo. O podrías abrir la ventana de un "
"golpe."

#. ~ Description of terrain "taped window"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"Duct tape covers this window, blocking out any sunlight and visibility.  You"
" could remove the duct tape by cutting it off."
msgstr ""
"La cinta americana cubre esta ventana, bloqueando la luz del sol y la "
"visibilidad. Podrías quitar la cinta americana cortándola."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "empty window"
msgstr "ventana vacía"

#. ~ Description of terrain "empty window"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"An empty window frame consisting of planks and nails.  You could install a "
"sheet of glass, or even board it up for protection.  You could also convert "
"it into a wall if you took the time to construct it."
msgstr ""
"Un marco de ventana vacío formado por tablones y clavos. Podrías instalar "
"una hoja de vidrio, o incluso tapiarla para protegerla. También podrías "
"convertirlo en un muro si te tomas el tiempo de construirlo."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "window frame"
msgstr "marco de ventana"

#. ~ Description of terrain "window frame"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A wooden window frame that has shattered glass around it.  You'll probably "
"get hurt if you crawled through the sharp and jagged shards.  You could "
"smash out the remaining pieces, or take your time and quietly clean them up."
msgstr ""
"Un marco de ventana de madera que tiene cristales rotos a su alrededor. "
"Probablemente te lastimarás si te arrastras a través de los fragmentos "
"afilados y dentados. Podrías romper los restos que quedan, o tomarte tu "
"tiempo y limpiarlos silenciosamente."

#. ~ Bashing sound of terrain "window frame"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "glass crunching!"
msgstr "¡rotura de cristales!"

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "boarded up window"
msgstr "ventana cubierta con tablas"

#. ~ Description of terrain "boarded up window"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A glass window that has been covered with nailed down planks, blocking "
"sunlight and visibility.  It's not much stronger, but it could be further "
"reinforced with strategically placed planks."
msgstr ""
"Una ventana de cristal que ha sido cubierta con tablones clavadas, "
"bloqueando la luz solar y la visibilidad. No es mucho más fuerte, pero "
"podría reforzarse aún más con tablas estratégicamente colocadas de tablones."

#. ~ Prying message of terrain "boarded up window"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "You pry the boards from the window."
msgstr "Sacas las tablas de la ventana."

#. ~ Description of terrain "boarded up window"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"An empty window frame that has been covered with nailed down planks, "
"blocking sunlight and visibility.  It's not much stronger, but it could be "
"further reinforced with strategically placed planks."
msgstr ""
"Un marco de ventana vacío que ha sido cubierto con tablones clavadas, "
"bloqueando la luz solar y la visibilidad. No es mucho más fuerte, pero "
"podría reforzarse aún más con tablas estratégicamente colocadas de tablones."

#. ~ Prying message of terrain "boarded up window"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "You pry the boards from the window frame."
msgstr "Sacas la tablas del marco de la ventana."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "reinforced boarded up window"
msgstr "ventana reforzada cubierta con tablas"

#. ~ Description of terrain "reinforced boarded up window"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A heavily fortified glass window with carefully placed planks across the "
"glass to block vision.  Adding a few spikes and metal plating would further "
"increase its durability."
msgstr ""
"Una ventana de vidrio muy fortificada, con tablones de madera colocadas "
"cuidadosamente en el cristal para bloquear la visibilidad. Si le agregás "
"unas púas y unas placas de metal, podrías incrementar su durabilidad."

#. ~ Description of terrain "reinforced boarded up window"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A heavily fortified window with carefully placed planks across the open "
"frame to block vision.  Adding a few spikes and metal plating would further "
"increase its durability."
msgstr ""
"Una ventana muy fortificada, con tablones de madera colocados cuidadosamente"
" en el marco para bloquear la visibilidad. Si le agregás unas púas y unas "
"placas de metal podrías incrementar su durabilidad."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "armored boarded up window"
msgstr "ventana blindada cubierta con tablas"

#. ~ Description of terrain "armored boarded up window"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"This once normal glass window now menaces with spikes along the edges, with "
"laboriously placed metal sheeting to further strengthen the wooden "
"reinforcements underneath."
msgstr ""
"Esta ventana de vidrio, que una vez fue normal, ahora amenaza con tener púas"
" a lo largo de los bordes, con láminas metálicas laboriosamente colocadas "
"para fortalecer aún más los refuerzos de madera debajo de ella."

#. ~ Description of terrain "armored boarded up window"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"This once normal window frame now menaces with spikes along the edges, with "
"laboriously placed metal sheeting to further strengthen the wooden "
"reinforcements underneath."
msgstr ""
"Este marco de ventana que una vez fue normal ahora amenaza con púas a lo "
"largo de los bordes, con láminas metálicas laboriosamente colocadas para "
"fortalecer aún más los refuerzos de madera debajo de ella."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "window with metal bars"
msgstr "ventana con barras de metal"

#. ~ Description of terrain "window with metal bars"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A giant sheet of glass inserted into a window with thick security grilles, "
"making it impossible to crawl through.  Typically installed for high-value "
"stores, or at least stores in bad neighborhoods."
msgstr ""
"Es una placa gigante de vidrio insertada en la ventana con una reja gruesa "
"de seguridad, lo que hace imposible pasar por ahí. Comúnmente se la "
"encuentra instalada en negocios grandes, o negocios en barrios complicados."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "window frame with metal bars"
msgstr "marco de ventana con barras de metal"

#. ~ Description of terrain "window frame with metal bars"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A window frame blocked with thick security grilles, making it impossible to "
"crawl through.  Typically installed for high-value stores, or at least "
"stores in bad neighborhoods."
msgstr ""
"Un marco de ventana bloqueado con gruesas rejillas de seguridad, lo que hace"
" imposible pasar a rastras. Suele instalarse en tiendas de gran valor o, al "
"menos, en tiendas situadas en barrios conflictivos."

#. ~ Description of terrain "window with metal bars"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A giant sheet of glass inserted into a window with thick security grilles, "
"making it impossible to crawl through.  Typically installed for high-value "
"stores, or at least stores in bad neighborhoods.  This one has a small "
"sticker in a corner stating, 'Protected by AtmoWeb, leading AI in "
"terminating crime'."
msgstr ""
"Una hoja de vidrio gigante insertada en una ventana con gruesas rejas de "
"seguridad, haciendo imposible colarse a través de ella. Típicamente "
"instalada para tiendas de alto valor, o al menos tiendas en malos "
"vecindarios. Este tiene una pequeña pegatina en una esquina que dice, "
"\"Protegido por AtmoWeb, liderando a la IA en la erradicación del crimen\"."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "window with metal bars and curtains"
msgstr "ventana con barras de metal y cortinas"

#. ~ Description of terrain "window with metal bars and curtains"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A barred window with fancy curtains that have been drawn shut, blocking "
"sunlight and visibility.  The curtains can only be opened on the inside.  If"
" you examined the curtains more closely, you could peek through the drapes "
"or tear down everything."
msgstr ""
"Una ventana enrejada con cortinas elegantes que han sido cerradas, "
"bloqueando la luz del sol y la visibilidad. Las cortinas sólo pueden abrirse"
" por dentro. Si se examinan las cortinas más de cerca, se puede mirar a "
"través de las cortinas o romperlas en trozos."

#. ~ Description of terrain "window with metal bars and curtains"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A giant sheet of glass inserted into a window with thick security grilles, "
"making it impossible to crawl through.  Typically installed for high-value "
"stores, or at least stores in bad neighborhoods.  This one has been "
"retrofitted with curtains, which are currently open."
msgstr ""
"Una hoja de vidrio gigante insertada en una ventana con gruesas rejas de "
"seguridad, haciendo imposible que colarse a través de ella. Típicamente "
"instalada para tiendas de alto valor, o al menos tiendas en malos "
"vecindarios. Esta ha sido actualizada con cortinas que se encuentran "
"abiertas."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "stone wall with high stained glass window"
msgstr "muro de piedra con vidriera alta de colores"

#. ~ Description of terrain "stone wall with high stained glass window"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A stone wall with a high window containing breathtaking craftsmanship of "
"stained glass featuring an elegant emerald landscape."
msgstr ""
"Un muro de piedra con una ventana alta que contiene una impresionante "
"vidriera artesanal con un elegante paisaje esmeralda."

#. ~ Bashing sound of terrain "stone wall with high stained glass window"
#. ~ Bashing sound of terrain "high stained glass window"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "a crash and glass breaking!"
msgstr "¡un choque y cristales rompiédose!"

#. ~ Description of terrain "stone wall with high stained glass window"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A stone wall with a high window containing breathtaking craftsmanship of "
"stained glass featuring an otherworldly radiant ruby flower blooming."
msgstr ""
"Un muro de piedra con una alta ventana que contiene una vidriera artesanal "
"impresionante con una flor de rubí radiante de otro mundo floreciendo."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "high stained glass window"
msgstr "vidriera alta"

#. ~ Description of terrain "high stained glass window"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A stone wall with a high window containing breathtaking craftsmanship of "
"stained glass featuring an alluring azure oceanic abyss."
msgstr ""
"Un muro de piedra con una alta ventana que contiene una vidriera artesanal "
"impresionante con un atractivo abismo oceánico de color azul."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "window with metal grate"
msgstr "ventana con rejilla metálica"

#. ~ Description of terrain "window with metal grate"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"Metal bars made into a grate for a window.  Highly durable and will stand "
"against any foe."
msgstr ""
"Barras de metal convertidas en rejilla para una ventana, de gran durabilidad"
" y que resistirá contra cualquier enemigo"

#. ~ Description of terrain "window with metal grate"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"Metal bars made into a grate for a window with a closed curtain.  Highly "
"durable and will stand against any foe."
msgstr ""
"Barras de metal en forma de rejilla para una ventana con una cortina "
"cerrada, de gran durabilidad y que resistirá contra cualquier enemigo"

#. ~ Description of terrain "window with metal grate"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"Metal bars made into a grate for a window with an opened curtain.  Highly "
"durable and will stand against any foe."
msgstr ""
"Barras de metal en forma de rejilla para una ventana con una cortina "
"abierta, de gran durabilidad y que resistirá contra cualquier enemigo"

#. ~ Description of terrain "window with metal grate"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"Metal bars made into a grate for a window.  Highly durable and will stand "
"against any foe"
msgstr ""
"Barras de metal convertidas en rejilla para una ventana, de gran durabilidad"
" y que resistirá contra cualquier enemigo"

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "single glazed window"
msgstr "ventana de un solo cristal"

#. ~ Description of terrain "single glazed window"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A single glazed window.  Consists of a giant sheet of glass inserted into a "
"window frame.  It's currently closed."
msgstr ""
"Una ventana de un solo cristal. Consiste en una lámina de vidrio gigante "
"insertada en un marco de ventana. Actualmente está cerrada."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "open single glazed window"
msgstr "ventana abierta de un solo cristal"

#. ~ Description of terrain "open single glazed window"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A single glazed window.  Consists of a giant sheet of glass inserted into a "
"window frame.  It's open and can be crawled through."
msgstr ""
"Una ventana de un solo cristal. Consiste en una lámina gigante de vidrio "
"insertada en un marco de ventana. Está abierta y se puede atravesar a gatas."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "single glazed window with closed curtains"
msgstr "ventana de un solo cristal con cortinas cerradas"

#. ~ Description of terrain "single glazed window with closed curtains"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A closed single glazed window with a fancy curtain on the inside that is "
"closed to block visibility and shut out any light."
msgstr ""
"Una ventana cerrada de un solo cristal con una cortina elegante en el "
"interior que se cierra para bloquear la visibilidad y dejar fuera la luz."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "single glazed window with curtains"
msgstr "ventana de cristal simple con cortinas"

#. ~ Description of terrain "single glazed window with curtains"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A closed single glazed window with a fancy curtain on the inside that can be"
" drawn closed to block visibility and shut out any light."
msgstr ""
"Una ventana cerrada de un solo cristal con una elegante cortina en el "
"interior que puede cerrarse para bloquear la visibilidad y dejar fuera la "
"luz."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "open single glazed window with curtains"
msgstr "ventana abierta de un solo cristal con cortinas"

#. ~ Description of terrain "open single glazed window with curtains"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A single glazed window with a fancy curtain on the inside that can be drawn "
"closed to block visibility and shut out any light.  It's open and can be "
"crawled through."
msgstr ""
"Una ventana de un solo cristal con una elegante cortina en el interior que "
"puede cerrarse para bloquear la visibilidad y dejar fuera la luz. Está "
"abierta y se puede atravesar a gatas."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "taped single glazed window"
msgstr "ventana de cristal simple encintada"

#. ~ Description of terrain "taped single glazed window"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A single glazed window.  Consists of a giant sheet of glass inserted into a "
"window frame.  It's currently closed.  This one has been blocked out with "
"duct tape.  You could remove the duct tape by cutting it off."
msgstr ""
"Una ventana de un solo cristal. Consiste en una lámina gigante de vidrio "
"insertada en un marco de ventana. Actualmente está cerrada. Esta ha sido "
"bloqueada con cinta adhesiva. Se puede quitar la cinta adhesiva cortándola."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "reinforced single glazed window"
msgstr "ventana reforzada de cristal simple"

#. ~ Description of terrain "reinforced single glazed window"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A reinforced single glazed window.  Consists of a giant sheet of reinforced "
"glass inserted into a window frame.  It's currently closed."
msgstr ""
"Una ventana reforzada de cristal simple. Consiste en una lámina gigante de "
"vidrio reforzado insertada en un marco de ventana. Actualmente está cerrada."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "open reinforced single glazed window"
msgstr "ventana abierta reforzada de un solo cristal"

#. ~ Description of terrain "open reinforced single glazed window"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A reinforced single glazed window.  Consists of a giant sheet of reinforced "
"glass inserted into a window frame.  It's open and can be crawled through."
msgstr ""
"Una ventana reforzada de cristal simple. Consiste en lámina gigante de "
"vidrio reforzado insertada en un marco de ventana. Está abierta y se puede "
"atravesar."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "reinforced single glazed window with closed curtains"
msgstr "ventana reforzada de un solo cristal con cortinas cerradas"

#. ~ Description of terrain "reinforced single glazed window with closed
#. curtains"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A closed reinforced single glazed window with a fancy curtain on the inside "
"that is drawn closed to block visibility and shut out any light."
msgstr ""
"Una ventana cerrada reforzada de un solo cristal con una cortina de fantasía"
" en el interior que se cierra para bloquear la visibilidad y dejar fuera la "
"luz."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "reinforced single glazed window with curtains"
msgstr "ventana reforzada de un solo cristal con cortinas"

#. ~ Description of terrain "reinforced single glazed window with curtains"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A closed reinforced window with a fancy curtain on the inside that can be "
"drawn closed to block visibility and shut out any light."
msgstr ""
"Una ventana reforzada cerrada con una elegante cortina en el interior que "
"puede cerrarse para bloquear la visibilidad y dejar fuera la luz."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "open reinforced single glazed window with curtains"
msgstr "ventana abierta reforzada de un solo cristal con cortinas"

#. ~ Description of terrain "open reinforced single glazed window with
#. curtains"
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A reinforced window with a fancy curtain on the inside that can be drawn "
"closed to block visibility and shut out any light.  It's open and can be "
"crawled through."
msgstr ""
"Una ventana reforzada con una elegante cortina en el interior que se puede "
"cerrar para bloquear la visibilidad y dejar fuera cualquier luz. Está "
"abierta y se puede atravesar a gatas."

