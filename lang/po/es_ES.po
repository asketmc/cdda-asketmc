#. ~ Item name
#: data/mods/Magiclysm/items/tools.json
msgid "orichalcum cauldron"
msgid_plural "orichalcum cauldrons"
msgstr[0] "caldera de oricalco"
msgstr[1] "calderas de oricalco"
msgstr[2] "calderas de oricalco"

#. ~ Description of "orichalcum cauldron"
#: data/mods/Magiclysm/items/tools.json
msgid ""
"This is an alchemical cauldron made of orichalcum.  The metal is especially "
"resistant to the unique types of corrosion caused by alchemy."
msgstr ""
"Este es un caldero alquímico hecho de oricalco. El metal es especialmente "
"resistente a los tipos únicos de corrosión causados por la alquimia."

#. ~ Description of "demon forge"
#: data/mods/Magiclysm/items/tools.json
msgid ""
"This is a portable version of the charcoal forge that is magically enhanced "
"and fortified with demon spider chitin in order to be able to resmelt "
"magical metals into their workable ingot form."
msgstr ""
"Esta es una versión portátil de la fragua de carbón vegetal que está "
"mejorada mágicamente y fortificada con quitina de araña demoníaca para poder"
" refundir metales mágicos en forma de lingote."

#. ~ Item name
#: data/mods/Magiclysm/items/tools.json
msgid "fireproof mortar"
msgid_plural "fireproof mortar"
msgstr[0] "mortero ignífugo"
msgstr[1] "mortero ignífugo"
msgstr[2] "mortero ignífugo"

#. ~ Description of "fireproof mortar"
#: data/mods/Magiclysm/items/tools.json
msgid ""
"Some alchemical mortar, ready to be used in building projects expecting "
"temperatures on par with dragonbreath."
msgstr ""
"Mortero alquímico, listo para ser usado en proyectos de construcción que "
"esperan temperaturas a la par con el aliento de dragón."

#. ~ Item name
#: data/mods/Magiclysm/items/tools.json
msgid "parabolan wool staple"
msgid_plural "parabolan wool staples"
msgstr[0] "fibras de lana de parabolan"
msgstr[1] "fibras de lana de parabolan"
msgstr[2] "fibras de lana de parabolan"

#. ~ Description of "parabolan wool staple"
#: data/mods/Magiclysm/items/tools.json
msgid ""
"The natural cluster of parabolan wool fibers.  Could be processed to felt "
"patches or yarns."
msgstr ""
"El racimo natural de fibras de lana parabólica. Se puede transformar en "
"parches o hilos de fieltro."

#. ~ Item name
#: data/mods/Magiclysm/items/tools.json
msgid "glassteel shard"
msgid_plural "glassteel shards"
msgstr[0] "fragmento de cristal de acero"
msgstr[1] "fragmentos de cristal de acero"
msgstr[2] "fragmentos de cristal de acero"

#. ~ Description of "glassteel shard"
#: data/mods/Magiclysm/items/tools.json
msgid ""
"A broken shard of glassteel covered in sharp edges.  You could use it as a "
"weapon, but you might want to wear gloves."
msgstr ""
"Un fragmento roto de cristal de acero cubierto de bordes afilados. Podrías "
"usarlo como arma, pero quizá quieras usar guantes."

#. ~ Vehicle part name
#: data/mods/Magiclysm/items/vehicle_parts.json
msgid "bulette plating"
msgstr "chapado de bulette"

#. ~ A heavier version of the standard shillelagh (from melee.json) with a
#. different description to match the lizardfolk lore.  Not craftable, but
#. wieldable if discovered.
#. ~ Item name
#: data/mods/Magiclysm/items/weapons.json
msgid "greatclub"
msgid_plural "greatclubs"
msgstr[0] "garrote grande"
msgstr[1] "garrotes grandes"
msgstr[2] "garrotes grandes"

#. ~ A heavier version of the standard shillelagh (from melee.json) with a
#. different description to match the lizardfolk lore.  Not craftable, but
#. wieldable if discovered.
#. ~ Description of "greatclub"
#: data/mods/Magiclysm/items/weapons.json
msgid ""
"A stout knotty club with a large knob at the top.  While it's very heavy, "
"it's a very effective weapon in the hands of a strong opponent."
msgstr ""
"Es un palo robusto y nudoso con una gran perilla en la parte superior. "
"Aunque es muy pesado, es un arma muy efectiva en las manos de un oponente "
"fuerte."

#. ~ Item name
#: data/mods/Magiclysm/items/weapons.json
msgid "wood trident"
msgid_plural "wood tridents"
msgstr[0] "tridente de madera"
msgstr[1] "tridentes de madera"
msgstr[2] "tridentes de madera"

#. ~ Description of "wood trident"
#: data/mods/Magiclysm/items/weapons.json
msgid ""
"A wooden melee weapon with a hand-forged steel forked spearhead attached to "
"the end.  It can be used for stabbing opponents either in close-range or as "
"a thrown weapon, and in the right hands can also readily disarm opponents."
msgstr ""
"Un arma de madera c. a c. con una punta de acero forjado a mano y con una "
"horquilla en el extremo. Puede ser usada para apuñalar a los oponentes, ya "
"sea a corta distancia o como arma arrojada, y en las manos correctas también"
" puede desarmar fácilmente a los oponentes."

#. ~ A barbed version of the standard javelin (from spears_and_polearms.json)
#. with a different description to match the lizardfolk lore.  Not craftable,
#. but wieldable if discovered.
#. ~ Item name
#. ~ Name of a gun
#: data/mods/Magiclysm/items/weapons.json
msgid "barbed javelin"
msgid_plural "barbed javelins"
msgstr[0] "jabalina con alambre de púas"
msgstr[1] "jabalinas con alambre de púas"
msgstr[2] "jabalinas con alambre de púas"

#. ~ A barbed version of the standard javelin (from spears_and_polearms.json)
#. with a different description to match the lizardfolk lore.  Not craftable,
#. but wieldable if discovered.
#. ~ Description of "barbed javelin"
#: data/mods/Magiclysm/items/weapons.json
msgid ""
"This weapon measures about 3 feet in length and is fletched like an arrow "
"for better accuracy.  The business end of the javelin has wicked-looking "
"barbs which could cause significant bleeding."
msgstr ""
"Esta arma mide alrededor de 3 pies de largo y se flexiona como una flecha "
"para una mejor precisión. El extremo de la jabalina tiene púas de aspecto "
"malvado que podrían causar una hemorragia significativa."

#. ~ Description of gun "barbed javelin"
#: data/mods/Magiclysm/items/weapons.json
msgid "Fake gun that fires barbed javelins."
msgstr "Pistola falsa que dispara jabalinas de púas."

#. ~ Item name
#. ~ Vehicle part name
#: data/mods/Magiclysm/items/vehicle/frames.json
#: data/mods/Magiclysm/vehicleparts/frames.json
msgid "foldable orichalcum frame"
msgid_plural "foldable orichalcum frames"
msgstr[0] "chasis plegable de oricalco"
msgstr[1] "chasis plegables de oricalco"
msgstr[2] "chasis plegables de oricalco"

#. ~ Description of "foldable orichalcum frame"
#: data/mods/Magiclysm/items/vehicle/frames.json
msgid ""
"A folding frame made of orichalcum pipes.  Not as light as aluminum, but "
"significantly sturdier."
msgstr ""
"Un chasis plegable hecho de tubos de oricalco. No tan ligero como el "
"aluminio, pero significativamente más resistente."

#. ~ Item name
#. ~ Vehicle part name
#: data/mods/Magiclysm/items/vehicle/frames.json
#: data/mods/Magiclysm/vehicleparts/frames.json
msgid "orichalcum frame"
msgid_plural "orichalcum frames"
msgstr[0] "chasis de oricalco"
msgstr[1] "chasis de oricalco"
msgstr[2] "chasis de oricalco"

#. ~ Description of "orichalcum frame"
#: data/mods/Magiclysm/items/vehicle/frames.json
msgid ""
"A frame made of orichalcum.  Significantly sturdier than steel, but also "
"much more expensive."
msgstr ""
"Un chasis hecho de oricalco. Significativamente más robusto que el acero, "
"pero también mucho más caro."

#. ~ Item name
#. ~ Vehicle part name
#: data/mods/Magiclysm/items/vehicle/frames.json
#: data/mods/Magiclysm/vehicleparts/frames.json
msgid "light orichalcum frame"
msgid_plural "light orichalcum frames"
msgstr[0] "chasis ligero de oricalco"
msgstr[1] "chasis ligeros de oricalco"
msgstr[2] "chasis ligeros de oricalco"

#. ~ Description of "light orichalcum frame"
#: data/mods/Magiclysm/items/vehicle/frames.json
msgid ""
"A frame made of orichalcum.  Partially torn down in order to reduce weight "
"at the cost of durability."
msgstr ""
"Un chasis hecho de oricalco. Parcialmente desmontado para reducir el peso a "
"costa de la durabilidad."

#. ~ Item name
#: data/mods/Magiclysm/items/vehicle/vehicle_parts.json
msgid "magic v-twin combustion engine"
msgid_plural "magic v-twin combustion engines"
msgstr[0] "motor de combustión bicilíndrico mágico"
msgstr[1] "motores de combustión bicilíndricos mágicos"
msgstr[2] "motores de combustión bicilíndricos mágicos"

#. ~ Description of "magic v-twin combustion engine"
#: data/mods/Magiclysm/items/vehicle/vehicle_parts.json
msgid ""
"A magically manifested combustion engine.  Despite operating entirely off of"
" mana rather than normal fuel, it otherwise functions exactly as a "
"conventional internal combustion engine."
msgstr ""
"Un motor de combustión manifestado mágicamente. A pesar de funcionar "
"completamente con maná en lugar de con combustible normal, su funcionamiento"
" es idéntico al de un motor de combustión interna convencional."

#. ~ Description of species "DEMON_SPIDER"
#: data/mods/Magiclysm/monsters/demon_spider.json
msgid "a huge spider"
msgstr "una enorme araña"

#. ~ Monster name
#: data/mods/Magiclysm/monsters/demon_spider.json
msgid "demon spiderling"
msgid_plural "demon spiderlings"
msgstr[0] "arañita demoníaca"
msgstr[1] "arañitas demoníacas"
msgstr[2] "arañitas demoníacas"

#. ~ Description of monster "demon spiderling"
#: data/mods/Magiclysm/monsters/demon_spider.json
msgid ""
"Despite it being the size of a small dog, you can tell this is a very young "
"spider.  Its red color is why you gave it this name; you have never seen "
"this creature before the Cataclysm.  It is quick, and its large fangs drip "
"with venom."
msgstr ""
"A pesar de que es del tamaño de un perro pequeño, se puede decir que es una "
"araña muy joven. Su color rojo es la razón por la que le dio este nombre; "
"nunca ha visto a esta criatura antes del Cataclismo. Es rápida, y sus "
"grandes colmillos gotean veneno."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/demon_spider.json
msgid "demon spider"
msgid_plural "demon spiders"
msgstr[0] "araña demoníaca"
msgstr[1] "arañas demoníacas"
msgstr[2] "arañas demoníacas"

#. ~ Description of monster "demon spider"
#: data/mods/Magiclysm/monsters/demon_spider.json
msgid ""
"This spider is the size of a car.  Its huge compound eyes seem to be "
"infinite pools of blackness that seem to suck the light out of the air.  Its"
" maroon carapace is studded with wicked-looking spikes that drip with some "
"kind of viscous black liquid that sizzles when it touches the ground."
msgstr ""
"Esta araña es del tamaño de un coche. Sus enormes ojos compuestos parecen "
"ser infinitos charcos de oscuridad que parecen absorber la luz del aire. Su "
"caparazón granate está tachonado con púas de aspecto malvado que gotean con "
"algún tipo de líquido negro viscoso que chisporrotea cuando toca el suelo."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/demon_spider.json
msgid "demon spider queen"
msgid_plural "demon spider queens"
msgstr[0] "reina araña demoníaca"
msgstr[1] "reinas arañas demoníacas"
msgstr[2] "reinas arañas demoníacas"

#. ~ Description of monster "demon spider queen"
#: data/mods/Magiclysm/monsters/demon_spider.json
msgid ""
"This gigantic spider is the size of a moving van: you have no idea how it "
"manages to stay together, much less move with that bulk.  Its abdomen is "
"huge and swollen-looking, and an evil intelligence burns in its eyes even as"
" magic crackles around its chitinous barbs."
msgstr ""
"Esta gigantesca araña es del tamaño de un camión de mudanzas: no tienes ni "
"idea de cómo se las arregla para mantenerse unida, y mucho menos para "
"moverse con ese bulto. Su abdomen es enorme y de aspecto hinchado, y una "
"inteligencia malvada arde en sus ojos incluso cuando la magia crepita "
"alrededor de sus púas quitadas."

#. ~ Field intensity level
#: data/mods/Magiclysm/monsters/dragon.json
msgid "dreadful presence"
msgstr "presencia terrible"

#. ~ Field intensity level
#: data/mods/Magiclysm/monsters/dragon.json
msgid "frightful presence"
msgstr "presencia espantosa"

#. ~ Field intensity level
#: data/mods/Magiclysm/monsters/dragon.json
msgid "terrifying presence"
msgstr "presencia aterradora"

#. ~ Monster name
#: data/mods/Magiclysm/monsters/dragon.json
msgid "black dragon wyrmling"
msgid_plural "black dragon wyrmlings"
msgstr[0] "wyrmling dragón negro "
msgstr[1] "wyrmlings dragón negro "
msgstr[2] "wyrmlings dragón negro "

#. ~ Description of monster "black dragon wyrmling"
#: data/mods/Magiclysm/monsters/dragon.json
msgid ""
"This is a small black dragon, less than five years old.  Its scales are "
"glossy, and its horns barely peek out of its head.  Even from one so young, "
"you see the glint of sadism in its eyes."
msgstr ""
"Este es un pequeño dragón negro, de menos de cinco años. Sus escamas son "
"brillantes y sus cuernos apenas se asoman por su cabeza. Incluso desde tan "
"joven, se ve el brillo del sadismo en sus ojos."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/dragon.json
msgid "young black dragon"
msgid_plural "young black dragons"
msgstr[0] " dragón negro joven"
msgstr[1] " dragones negros jóvenes"
msgstr[2] " dragones negros jóvenes"

#. ~ Description of monster "young black dragon"
#: data/mods/Magiclysm/monsters/dragon.json
msgid ""
"This black dragon appears to still be in the early stages of life.  Its eyes"
" have just started to sink in its sockets, and its curved, segmented horns "
"have just begun to darken at the tips.  You can tell just by looking at it, "
"this creature is evil to its very core.  Even though this dragon is not "
"fully grown, it is the size of a full-grown bull."
msgstr ""
"Este dragón negro parece estar todavía en las primeras etapas de la vida. "
"Sus ojos acaban de empezar a hundirse en sus órbitas, y sus cuernos curvos y"
" segmentados acaban de empezar a oscurecerse en las puntas. Se puede decir "
"con sólo mirarlo, que esta criatura es malvada hasta la médula. Aunque este "
"dragón no ha crecido completamente, es del tamaño de un toro adulto."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/dragon.json
msgid "adult black dragon"
msgid_plural "adult black dragons"
msgstr[0] "dragón negro adulto"
msgstr[1] "dragones negros adultos"
msgstr[2] "dragones negros adultos"

#. ~ Description of monster "adult black dragon"
#: data/mods/Magiclysm/monsters/dragon.json
msgid ""
"A black-scaled monstrosity with deep-set eye sockets glowing green with "
"evil.  Its face and skull appear skeletal, and acid drips from its dagger-"
"like jaws."
msgstr ""
"Una monstruosidad de escala negra con cuencas oculares profundas que brillan"
" en verde con el mal. Su cara y su cráneo parecen esqueléticos, y el ácido "
"gotea de sus mandíbulas en forma de daga."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/forgedwellers.json
msgid "forge born"
msgid_plural "forge borns"
msgstr[0] "forja nacida"
msgstr[1] "forjas nacidas"
msgstr[2] "forjas nacidas"

#. ~ Description of monster "forge born"
#: data/mods/Magiclysm/monsters/forgedwellers.json
msgid ""
"The most elaborate, gaudy and overwrought clockwork creature that you've "
"ever seen.  Each one has its face designed in a mask displaying a single "
"emotion.  Blades extend from the wrists in combat."
msgstr ""
"La criatura de relojería más elaborada, llamativa y recargada que jamás haya"
" visto. Cada uno tiene su cara diseñada en una máscara que muestra una sola "
"emoción. Las cuchillas se extienden desde las muñecas en el combate."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/forgedwellers.json
msgid "goblin forgemaster"
msgid_plural "goblin forgemasters"
msgstr[0] "maestro de forja goblin"
msgstr[1] "maestros de forja goblin"
msgstr[2] "maestros de forja goblin"

#. ~ Description of monster "goblin forgemaster"
#: data/mods/Magiclysm/monsters/forgedwellers.json
msgid ""
"A goblin like none you've ever seen before.  He directs workers and "
"automatons with confidence and style."
msgstr ""
"Un goblin como ninguno que hayas visto antes. Dirige a trabajadores y "
"autómatas con seguridad y estilo."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/forgedwellers.json
msgid "lizardfolk forgemaster"
msgid_plural "lizardfolk forgemasters"
msgstr[0] "maestro de forja lagarto"
msgstr[1] "maestros de forja lagarto"
msgstr[2] "maestros de forja lagarto"

#. ~ Description of monster "lizardfolk forgemaster"
#: data/mods/Magiclysm/monsters/forgedwellers.json
msgid ""
"Lizardfolk rarely live outside of their tribes.  This one has found freedom "
"and purpose beyond serving their draconic masters."
msgstr ""
"La raza lagarto rara vez vive fuera de sus tribus. Este ha encontrado la "
"libertad y el propósito más allá de servir a sus amos dracónicos."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/forgedwellers.json
msgid "gracken forgemaster"
msgid_plural "gracken forgemasters"
msgstr[0] "maestro de forja gracken"
msgstr[1] "maestros de forja gracken"
msgstr[2] "maestros de forja gracken"

#. ~ Description of monster "gracken forgemaster"
#: data/mods/Magiclysm/monsters/forgedwellers.json
msgid ""
"This is some form of eldritch monstrosity; an uncouth black being with "
"smooth, oily, skin and unpleasant horns that curve inward toward each other."
"  Tall and thin, the shadows cling unnaturally to its vaguely defined "
"humanoid form as it shuffles along, its hands twitching and spasming so "
"rapidly as to appear a little more than a black blur of claws.  This one "
"politely asks you to mind your step as this is a working environment."
msgstr ""
"Esto es de alguna forma de monstruosidad de otro mundo; un ser negro y tosco"
" con una piel suave y aceitosa y unos desagradables cuernos que se curvan "
"hacia dentro. Alto y delgado, las sombras se adhieren de forma antinatural a"
" su forma humanoide vagamente definida mientras arrastra los pies, sus manos"
" se mueven y hacen espasmos tan rápidamente que parecen poco más que un "
"borrón negro de garras. Éste le pide amablemente que tenga cuidado con sus "
"pasos, ya que se trata de un entorno de trabajo."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/forgedwellers.json
msgid "forge demon"
msgid_plural "forge demons"
msgstr[0] "demonio de forja"
msgstr[1] "demonios de forja"
msgstr[2] "demonios de forja"

#. ~ Description of monster "forge demon"
#: data/mods/Magiclysm/monsters/forgedwellers.json
msgid ""
"The first thing you notice is that this creature has five arms.  The next is"
" that it walks on three legs.  It walks amongst the vault until it notices "
"you then throws itself at the walls screaming bloody murder.  Its mere "
"presence fills you with an unfathomable dread."
msgstr ""
"Lo primero que se observa es que esta criatura tiene cinco brazos. Lo "
"siguiente es que camina sobre tres patas. Camina entre la bóveda hasta que "
"se percata de tu presencia y luego se lanza contra los muros gritando una "
"barbaridad. Su mera presencia te llena de un miedo insondable."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/forgedwellers.json
msgid "vengeance spirit"
msgid_plural "vengeance spirits"
msgstr[0] "espíritu vengador"
msgstr[1] "espíritus vengadores"
msgstr[2] "espíritus vengadores"

#. ~ Description of monster "vengeance spirit"
#: data/mods/Magiclysm/monsters/forgedwellers.json
msgid ""
"It looks like a will-o-the-wisp, darting back and forth, until it catches "
"sight of its prey.  When the sickly green balefires light up inside the "
"eyeholes of a skull, the mouth opens and a deep moan vibrates up through the"
" legs of those standing nearby."
msgstr ""
"Parece un fuego fátuo, moviéndose adelante y atrás, hasta que adquiere la "
"vista de su presa. Cuando el fuego de color verde enfermizo se ilumina, "
"dentro de él aparecen los agujeros de los ojos de un cráneo, la boca se abre"
" y un profundo gemido vibra a través de las piernas de los que están cerca."

#. ~ Monster message of special attack of monster "vengeance spirit"
#: data/mods/Magiclysm/monsters/forgedwellers.json
msgid "The spirit flickers and reappears!"
msgstr "¡El espíritu parpadea y reaparece.!"

#. ~ Monster name
#: data/mods/Magiclysm/monsters/forgedwellers.json
msgid "forge worker"
msgid_plural "forge workers"
msgstr[0] "trabajador de forja"
msgstr[1] "trabajadores de forja"
msgstr[2] "trabajadores de forja"

#. ~ Description of monster "forge worker"
#: data/mods/Magiclysm/monsters/forgedwellers.json
msgid ""
"A squat humanoid that looks quite sturdily built.  They style their hair in "
"mohawks and other strange fashions that seem to be dictated by what parts of"
" their skin aren't scarred from burns.  Their clothes are designed to "
"protect them from the intense environment they work in."
msgstr ""
"Un humanoide achaparrado que parece bastante robusto. Se peinan con mohawks "
"y otras modas extrañas que parecen estar dictadas por las partes de su piel "
"que no están marcadas por las quemaduras. Sus ropas están diseñadas para "
"protegerlos del intenso ambiente en el que trabajan."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/forgedwellers.json
msgid "forge hounds"
msgid_plural "forge hounds"
msgstr[0] "perro forja"
msgstr[1] "perros forja"
msgstr[2] "perros forja"

#. ~ Description of monster "forge hounds"
#: data/mods/Magiclysm/monsters/forgedwellers.json
msgid ""
"A metallic hound steps out of a nearby angle and growls at you.  Run!!!"
msgstr "Un perro metálico sale de un ángulo cercano y te gruñe. ¡¡Corre!!"

#. ~ Monster name
#: data/mods/Magiclysm/monsters/goblin.json
msgid "goblin warrior"
msgid_plural "goblin warriors"
msgstr[0] "guerrero goblin"
msgstr[1] "guerreros goblin"
msgstr[2] "guerreros goblin"

#. ~ Description of monster "goblin warrior"
#: data/mods/Magiclysm/monsters/goblin.json
msgid ""
"This short humanoid is covered in filth and shouts slurs at you as it "
"brandishes a cudgel."
msgstr ""
"Este humanoide de baja estatura está cubierto de suciedad y te grita "
"insultos mientras blande una porra."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/goblin.json
msgid "goblin slinger"
msgid_plural "goblin slingers"
msgstr[0] "lanzador de honda goblin"
msgstr[1] "lanzadores de honda goblin"
msgstr[2] "lanzadores de honda goblin"

#. ~ Description of monster "goblin slinger"
#: data/mods/Magiclysm/monsters/goblin.json
msgid ""
"An ugly creature that slings rocks almost as well as it slings insults."
msgstr "Una criatura fea que lanza rocas casi tan bien como insulta."

#. ~ Description of special attack of monster "goblin slinger"
#: data/mods/Magiclysm/monsters/goblin.json
msgid "The goblin slings a rock at you!"
msgstr "¡El duende te lanza una piedra!"

#. ~ No ammo sound of special attack of monster "goblin slinger"
#. ~ No ammo sound of special attack of monster "orc archer"
#: data/mods/Magiclysm/monsters/goblin.json
#: data/mods/Magiclysm/monsters/orcs.json
msgid "grunting"
msgstr "gruñendo"

#. ~ Monster name
#: data/mods/Magiclysm/monsters/goblin.json
msgid "goblin chieftain"
msgid_plural "goblin chieftains"
msgstr[0] "jefe goblin"
msgstr[1] "jefes goblin"
msgstr[2] "jefes goblin"

#. ~ Description of monster "goblin chieftain"
#: data/mods/Magiclysm/monsters/goblin.json
msgid ""
"An ugly creature that was promoted to chieftain because it figured out which"
" end of the weapon is pointy."
msgstr ""
"Una criatura fea que fue ascendida a jefe porque descubrió qué extremo del "
"arma es puntiagudo."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/golems.json
msgid "clay golem"
msgid_plural "clay golems"
msgstr[0] "golem de arcilla"
msgstr[1] "golems de arcilla"
msgstr[2] "golems de arcilla"

#. ~ Description of monster "clay golem"
#: data/mods/Magiclysm/monsters/golems.json
msgid ""
"A large, humanoid golem made from clay.  Its proportions are off and it "
"seems fragile."
msgstr ""
"Un gran golem humanoide hecho de arcilla. Sus proporciones no son las "
"adecuadas y parece frágil."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/golems.json
msgid "plastic golem"
msgid_plural "plastic golems"
msgstr[0] "golem de plástico"
msgstr[1] "golems de plástico"
msgstr[2] "golems de plástico"

#. ~ Description of monster "plastic golem"
#: data/mods/Magiclysm/monsters/golems.json
msgid ""
"Traditionally, making a golem is a months-long process involving hand tools "
"and precision craftsmanship.  A stone golem is as much a work of art as it "
"is a magical device.  The advent of 3D printing made it easy to get into the"
" golem-making hobby, and plastic golems have soared in popularity."
msgstr ""
"Tradicionalmente, hacer un gólem es un proceso de meses que involucra "
"herramientas de mano y artesanía de precisión. Un golem de piedra es tanto "
"una obra de arte como un dispositivo mágico. El advenimiento de la impresión"
" 3D facilitó la afición de hacer golem, y los golem de plástico se han "
"disparado en popularidad."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/golems.json
msgid "stone golem"
msgid_plural "stone golems"
msgstr[0] "golem de piedra"
msgstr[1] "golems de piedra"
msgstr[2] "golems de piedra"

#. ~ Description of monster "stone golem"
#: data/mods/Magiclysm/monsters/golems.json
msgid ""
"A large, humanoid golem made from stone.  Its fists look similar to rockets."
msgstr ""
"Un gran golem humanoide hecho de piedra. Sus puños se parecen a los de los "
"cohetes."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/golems.json
msgid "iron golem"
msgid_plural "iron golems"
msgstr[0] "golem de hierro"
msgstr[1] "golems de hierro"
msgstr[2] "golems de hierro"

#. ~ Description of monster "iron golem"
#: data/mods/Magiclysm/monsters/golems.json
msgid ""
"A large, humanoid golem made from iron.  Some sort of noxious gas seems to "
"be seeping from its mouth."
msgstr ""
"Un gran golem humanoide hecho de hierro. Parece que algún tipo de gas nocivo"
" se está filtrando de su boca."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/golems.json
msgid "earthshaper's golem"
msgid_plural "earthshaper's golems"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "earthshaper's golem"
#: data/mods/Magiclysm/monsters/golems.json
msgid ""
"This golem is easy to separate from other golems - the metallic "
"earthshaper's emblem shines on its smooth body, and it's eyes and hands are "
"made out of amethyst."
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/holiday_magiclysm.json
msgid "Yule Cat"
msgid_plural "Yule Cats"
msgstr[0] "Gato Yule"
msgstr[1] "Gatos Yule"
msgstr[2] "Gatos Yule"

#. ~ Description of monster "Yule Cat"
#: data/mods/Magiclysm/monsters/holiday_magiclysm.json
msgid ""
"Magical beast from Icelandic folklore, known for their catlike appearance "
"and their hobby of eating Workshop Elves."
msgstr ""
"Bestia mágica del folclore islandés, conocida por su aspecto felino y su "
"afición a comer a los elfos del taller."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/holiday_magiclysm.json
msgid "Yulecat Cub"
msgid_plural "Yulecat Cubs"
msgstr[0] "Cachorros Yule"
msgstr[1] "Cachorros Yule"
msgstr[2] "Cachorros Yule"

#. ~ Description of monster "Yulecat Cub"
#: data/mods/Magiclysm/monsters/holiday_magiclysm.json
msgid ""
"The child of a yulecat, this catlike creature looks as if it poses no threat"
" to you, but looks can be deceiving."
msgstr ""
"Hijo de un gato Yule, esta criatura felina parece no suponer ninguna amenaza"
" para ti, pero las apariencias engañan."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/holiday_magiclysm.json
msgid "Workshop Elf"
msgid_plural "Workshop Elves"
msgstr[0] "Elfo de Taller"
msgstr[1] "Elfos de Taller"
msgstr[2] "Elfos de Taller"

#. ~ Description of monster "Workshop Elf"
#: data/mods/Magiclysm/monsters/holiday_magiclysm.json
msgid ""
"Magical humanoids who are known for working in workshops, wearing green, and"
" being proficient at making toys."
msgstr ""
"Humanoides mágicos conocidos por trabajar en talleres, vestir de verde y ser"
" expertos en la fabricación de juguetes."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/holiday_magiclysm.json
msgid "Leprechaun"
msgid_plural "Leprechauns"
msgstr[0] "Duende"
msgstr[1] "Duendes"
msgstr[2] "Duendes"

#. ~ Description of monster "Leprechaun"
#: data/mods/Magiclysm/monsters/holiday_magiclysm.json
msgid ""
"Mischievous shoemakers who wear green and love pulling pranks on mortals."
msgstr ""
"Zapateros traviesos que visten de verde y les encanta gastar bromas a los "
"mortales."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/lizardfolk.json
msgid "lizardfolk warrior"
msgid_plural "lizardfolk warriors"
msgstr[0] "guerrero lagarto"
msgstr[1] "guerreros lagarto"
msgstr[2] "guerreros lagarto"

#. ~ Description of monster "lizardfolk warrior"
#: data/mods/Magiclysm/monsters/lizardfolk.json
msgid ""
"A tall, powerful, reptilian humanoid with a muscular tail whose skin is "
"covered in dark gray-green scales.  They are tribal and tend to be found in "
"caves and near water, especially in areas inhabited by dragons and wyrms.  "
"They aren't particularly hostile, though they don't care for outsiders and "
"are highly dangerous when provoked.  While they usually prefer to fight with"
" their greatclubs, they are equally ferocious with their sharp teeth and "
"claws."
msgstr ""
"Un humanoide reptil alto y poderoso con una cola musculosa cuya piel está "
"cubierta de escamas de color gris verdoso oscuro. Son tribales y tienden a "
"encontrarse en cuevas y cerca del agua, especialmente en áreas habitadas por"
" dragones y gusanos. No son particularmente hostiles, aunque no se preocupan"
" por los forasteros y son muy peligrosos cuando son provocados. Aunque "
"normalmente prefieren pelear con sus grandes palos, son igualmente feroces "
"con sus afilados dientes y garras."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/lizardfolk.json
msgid "lizardfolk hunter"
msgid_plural "lizardfolk hunters"
msgstr[0] "cazador lagarto"
msgstr[1] "cazadores lagarto"
msgstr[2] "cazadores lagarto"

#. ~ Description of monster "lizardfolk hunter"
#: data/mods/Magiclysm/monsters/lizardfolk.json
msgid ""
"The hunter is a smaller lizardfolk than a warrior, but equally as deadly, "
"with their lithe figures and accurate javelin throws."
msgstr ""
"El cazador es un lagarto más pequeño que un guerrero, pero igual de "
"mortífero, con sus figuras ágiles y sus precisos lanzamientos de jabalina."

#. ~ Description of special attack of monster "lizardfolk hunter"
#: data/mods/Magiclysm/monsters/lizardfolk.json
msgid "The hunter hurls a barbed javelin at you!"
msgstr "¡El cazador te lanza una jabalina de púas!"

#. ~ Monster name
#: data/mods/Magiclysm/monsters/lizardfolk.json
msgid "lizardfolk shaman"
msgid_plural "lizardfolk shamans"
msgstr[0] "chamán lagarto"
msgstr[1] "chamanes lagarto"
msgstr[2] "chamanes lagarto"

#. ~ Description of monster "lizardfolk shaman"
#: data/mods/Magiclysm/monsters/lizardfolk.json
msgid ""
"Lizardfolk are very intelligent and cunning, but magical ability is a rare "
"quality.  Shamans are chosen from the tribe during childhood, when magical "
"abilities mark the fate of the young tribesman.  Not much is known about the"
" initiation ritual they must undergo, but few survive the experience.  "
"Shamans are druidic spellcasters that can use the forces of nature to battle"
" enemies, as well as summoning assistance when needed."
msgstr ""
"Los lagartos son muy inteligentes y astutos, pero la habilidad mágica es una"
" cualidad rara. Los chamanes son elegidos de la tribu durante la infancia, "
"cuando las habilidades mágicas marcan el destino del joven de la tribu. No "
"se sabe mucho sobre el ritual de iniciación al que deben someterse, pero "
"pocos sobreviven a la experiencia. Los chamanes son hechiceros druídicos que"
" pueden usar las fuerzas de la naturaleza para luchar contra los enemigos, "
"así como para invocar ayuda cuando sea necesario."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/lizardfolk.json
msgid "lizardfolk chieftan"
msgid_plural "lizardfolk chieftans"
msgstr[0] "jefe lagarto"
msgstr[1] "jefes lagarto"
msgstr[2] "jefes lagarto"

#. ~ Description of monster "lizardfolk chieftan"
#: data/mods/Magiclysm/monsters/lizardfolk.json
msgid ""
"Among the lizardfolk, ambition is a rare quality.  Chieftans earn their "
"place by exhibiting unusually high levels of ambition, often mistaken by "
"outsiders as excessive, brutal violence.  This chief is the largest and "
"strongest member of its tribe and carries a fierce trident to compliment its"
" teeth and claws."
msgstr ""
"Entre los lagartos, la ambición es una cualidad rara. Los lideres se ganan "
"su lugar exhibiendo niveles inusualmente altos de ambición, a menudo "
"confundidos por los forasteros como violencia excesiva y brutal. Este jefe "
"es el miembro más grande y fuerte de su tribu y lleva un feroz tridente para"
" complementar sus dientes y garras."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/lizardfolk.json
#: data/mods/TropiCataclysm/monsters/tropical_reptile_amphibian.json
msgid "crocodile"
msgid_plural "crocodiles"
msgstr[0] "cocodrilo"
msgstr[1] "cocodrilos"
msgstr[2] "cocodrilos"

#. ~ Description of monster "crocodile"
#: data/mods/Magiclysm/monsters/lizardfolk.json
msgid ""
"A once-and-future lizardfolk shaman, this large crocodile no longer has any "
"hint of any humanoid characteristics and looks very, very dangerous."
msgstr ""
"Este gran cocodrilo ya no tiene ningún indicio de características humanoides"
" y parece muy, muy peligroso."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/mics.json
msgid "animated blade"
msgid_plural "animated blades"
msgstr[0] "hoja animada"
msgstr[1] "hojas animadas"
msgstr[2] "hojas animadas"

#. ~ Description of monster "animated blade"
#: data/mods/Magiclysm/monsters/mics.json
msgid ""
"A conjured glowing longsword that darts and dodges around, slicing and "
"cutting your foes into small pieces."
msgstr ""
"Una espada larga y brillante que se lanza y esquiva, rebanando y cortando a "
"tus enemigos en pequeños trozos."

#. ~ Description of monster "hologram"
#: data/mods/Magiclysm/monsters/mics.json
msgid "Hologram copy of you."
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/monsters.json
msgid "owlbear"
msgid_plural "owlbears"
msgstr[0] "buhoso"
msgstr[1] "buhosos"
msgstr[2] "buhosos"

#. ~ Description of monster "owlbear"
#: data/mods/Magiclysm/monsters/monsters.json
msgid ""
"The horrible owlbear is probably the result of genetic experimentation by "
"some insane wizard.  These creatures inhabit the tangled forest regions of "
"every temperate clime, as well as subterranean labyrinths.  They are "
"ravenous eaters, aggressive hunters, and evil tempered at all times.  They "
"attack prey on sight and will fight to the death."
msgstr ""
"El horrible buhoso es probablemente el resultado de la experimentación "
"genética de algún mago loco. Estas criaturas habitan en las enredadas "
"regiones forestales de todos los climas templados, así como en los "
"laberintos subterráneos. Son comedores hambrientos, cazadores agresivos y "
"malvados temperamentales en todo momento. Atacan a las presas en cuanto las "
"ven y luchan hasta la muerte."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/monsters.json
msgid "black pudding"
msgid_plural "black puddings"
msgstr[0] "pudding negro"
msgstr[1] "pudding negro"
msgstr[2] "pudding negro"

#. ~ Description of monster "black pudding"
#: data/mods/Magiclysm/monsters/monsters.json
msgid ""
"Writhing, sticky, black sludge undulates across the ground.  A faint "
"sizzling sound comes from the ground beneath it as it lurches toward you."
msgstr ""
"El cieno negro, pegajoso y retorcido se ondula en el suelo. Un débil "
"chisporroteo viene del suelo debajo de él mientras se tambalea hacia ti."

#. ~ Monster message of special attack of monster "black pudding"
#: data/mods/Magiclysm/monsters/monsters.json
#, c-format
msgid "The black pudding burns %3$s with acid!"
msgstr "¡El lodo negro quema %3$s con el ácido!"

#. ~ Monster name
#: data/mods/Magiclysm/monsters/monsters.json
msgid "krabgek"
msgid_plural "krabgeks"
msgstr[0] "Krabgek"
msgstr[1] "Krabgeks"
msgstr[2] "Krabgeks"

#. ~ Description of monster "krabgek"
#: data/mods/Magiclysm/monsters/monsters.json
msgid ""
"A large baleful eye peers out from the darkness, its gleam hinting at a "
"weird intelligence and unnerving malevolence.  The eye oozes some pinkish "
"liquid, and the weirdly humanoid figure is covered in sharp blue-black "
"triangular plates."
msgstr ""
"Un gran ojo malvado se asoma desde la oscuridad, su brillo insinúa una "
"inteligencia extraña y una malevolencia desconcertante. El ojo rezuma un "
"líquido rosado, y la extraña figura humanoide está cubierta de afiladas "
"placas triangulares azul-negras."

#. ~ Monster message of special attack of monster "krabgek"
#: data/mods/Magiclysm/monsters/monsters.json
#, c-format
msgid "The krabgek gazes at %3$s!"
msgstr "¡El krabgek mira a%3$s !"

#. ~ Monster name
#: data/mods/Magiclysm/monsters/monsters.json
msgid "hunllef lamb"
msgid_plural "hunllef lambs"
msgstr[0] "cordero hunllef"
msgstr[1] "corderos hunllef"
msgstr[2] "corderos hunllef"

#. ~ Description of monster "hunllef lamb"
#: data/mods/Magiclysm/monsters/monsters.json
msgid ""
"The offspring of the Hunllef rams are much more docile but still have wicked"
" looking horns like their parents."
msgstr ""
"Las crías de los carneros de Hunllef son mucho más dóciles, pero siguen "
"teniendo cuernos de aspecto perverso como sus padres."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/monsters.json
msgid "hunllef rams"
msgid_plural "hunllef rams"
msgstr[0] "carnero hunllef"
msgstr[1] "carneros hunllef"
msgstr[2] "carneros hunllef"

#. ~ Description of monster "hunllef rams"
#: data/mods/Magiclysm/monsters/monsters.json
msgid ""
"Hunllef rams, also known as Nightmare Sheep, are a particularly vicious "
"breed of sheep suspected to be from another plane of existence.  Both males "
"and females display deadly horns and a willingness to use them on most other"
" creatures that come near them.  They are the most biddable source of "
"parabolan wool and often take a protective stance towards other sheep, so "
"some farmers will risk life and limb to keep them."
msgstr ""
"Los carneros Hunllef, también conocidos como Ovejas de Pesadilla, son una "
"raza de ovejas especialmente feroces que se sospecha provienen de otro plano"
" de existencia. Tanto los machos como las hembras exhiben unos cuernos "
"mortíferos y están dispuestos a utilizarlos con la mayoría de las criaturas "
"que se les acercan. Son la fuente de lana parabolan más licita y suelen "
"adoptar una postura protectora hacia otras ovejas, por lo que algunos "
"ganaderos arriesgan su vida para mantenerlas."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/monsters.json
msgid "owlbear cub"
msgid_plural "owlbear cubs"
msgstr[0] "cachorro de búhoso"
msgstr[1] "cachorros de búhoso"
msgstr[2] "cachorros de búhoso"

#. ~ Monster name
#: data/mods/Magiclysm/monsters/monsters.json
msgid "bulette"
msgid_plural "bulettes"
msgstr[0] "bulette"
msgstr[1] "bulettes"
msgstr[2] "bulettes"

#. ~ Description of monster "bulette"
#: data/mods/Magiclysm/monsters/monsters.json
msgid ""
"The bulette (or landshark) was the result of a mad wizard's experimental "
"cross breeding of a snapping turtle and armadillo with infusions of demons' "
"ichor.  They range temperate climates feeding on horses, men, and most other"
" flesh.  The stupid bulette is irascible and always hungry, and they fear "
"nothing."
msgstr ""
"La bulette (o tiburón) fue el resultado del cruce experimental de un mago "
"loco con una tortuga y un armadillo con infusiones de ichor de demonios. Se "
"extienden por climas templados alimentándose de caballos, hombres y la "
"mayoría de la carne. La estúpida bulette es irascible y siempre está "
"hambrienta, y no le temen a nada."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/monsters.json
msgid "will-o-wisp"
msgid_plural "will-o-wisps"
msgstr[0] "fuego fatuo"
msgstr[1] "fuegos fatuos"
msgstr[2] "fuegos fatuos"

#. ~ Description of monster "will-o-wisp"
#: data/mods/Magiclysm/monsters/monsters.json
msgid ""
"Will-o’-wisps can be yellow, white, green, or blue.  They are easily "
"mistaken for lanterns, especially in the foggy marshes and swamps where they"
" reside."
msgstr ""
"Fuegos fatuos pueden ser amarillos, blancos, verdes o azules. Se confunden "
"fácilmente con las linternas, especialmente en los pantanos y ciénagas de "
"niebla donde residen."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/monsters.json
msgid "troll"
msgid_plural "trolls"
msgstr[0] "trol"
msgstr[1] "troles"
msgstr[2] "troles"

#. ~ Description of monster "troll"
#: data/mods/Magiclysm/monsters/monsters.json
msgid ""
"Monstrous, green-skinned humanoid.  Trolls are renowned for their thick "
"hides and natural regenerative ability."
msgstr ""
"Monstruoso humanoide de piel verde. Los trolls son famosos por sus gruesos "
"pellejos y su capacidad de regeneración natural."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/monsters.json
msgid "stirge"
msgid_plural "stirges"
msgstr[0] "murciequito"
msgstr[1] "murciequitos"
msgstr[2] "murciequitos"

#. ~ Description of monster "stirge"
#: data/mods/Magiclysm/monsters/monsters.json
msgid ""
"This horrid flying creature looks like a cross between a large bat and "
"oversized mosquito."
msgstr ""
"Esta horrible criatura voladora parece un cruce entre un gran murciélago y "
"un mosquito de gran tamaño."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/monsters.json
msgid "shrieker"
msgid_plural "shriekers"
msgstr[0] "aullador"
msgstr[1] "aulladores"
msgstr[2] "aulladores"

#. ~ Description of monster "shrieker"
#: data/mods/Magiclysm/monsters/monsters.json
msgid ""
"A shrieker is a human-sized mushroom that emits a piercing screech to drive "
"off creatures that disturb it."
msgstr ""
"Un aullador es un hongo de tamaño humano que emite un chillido penetrante "
"para ahuyentar a las criaturas que lo molestan."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/monsters.json
msgid "frog"
msgid_plural "frogs"
msgstr[0] "rana"
msgstr[1] "ranas"
msgstr[2] "ranas"

#. ~ Description of monster "frog"
#: data/mods/Magiclysm/monsters/monsters.json
msgid ""
"A conspicuously average American bullfrog.  You better keep prince charming "
"away from it."
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/monsters.json
msgid "lemure"
msgid_plural "lemures"
msgstr[0] "lemur"
msgstr[1] "lemures"
msgstr[2] "lemures"

#. ~ Description of monster "lemure"
#: data/mods/Magiclysm/monsters/monsters.json
msgid ""
"A lemure resembles a molten mass of flesh with a vaguely humanoid head and "
"torso."
msgstr ""
"Un lemur se asemeja a una masa fundida de carne con una cabeza y un torso "
"vagamente humanoide."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/monsters.json
msgid "winter wolf"
msgid_plural "winter wolves"
msgstr[0] "lobo de invierno"
msgstr[1] "lobos de invierno"
msgstr[2] "lobos de invierno"

#. ~ Description of monster "winter wolf"
#: data/mods/Magiclysm/monsters/monsters.json
msgid ""
"A pure white dire wolf.  If you squint, you can see a faint mist surrounding"
" its coat, and ice shards slowly descend from its breath."
msgstr ""
"Un lobo huargo de color blanco puro. Si entrecierras los ojos, puedes ver "
"una tenue niebla que rodea su pelaje, y fragmentos de hielo que descienden "
"lentamente de su aliento."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/monsters.json
msgid "loup garou"
msgid_plural "loup garous"
msgstr[0] "loup garou"
msgstr[1] "loup garous"
msgstr[2] "loup garous"

#. ~ Description of monster "loup garou"
#: data/mods/Magiclysm/monsters/monsters.json
msgid ""
"Previously thought extinct outside of rural Quebec and Louisiana this cursed"
" creature has been known to breed with true wolves when it isn't madly "
"destroying any signs of humanity in its territory."
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/monsters.json
msgid "fiery nightmare"
msgid_plural "fiery nightmares"
msgstr[0] "pesadilla ardiente"
msgstr[1] "pesadillas ardientes"
msgstr[2] "pesadillas ardientes"

#. ~ Description of monster "fiery nightmare"
#: data/mods/Magiclysm/monsters/monsters.json
msgid ""
"A colossal figure which seems to consist entirely of shadows engulfed in "
"flames.  Its immense dark wings extend from wall to wall.  Two eyes that "
"resemble burning coals are gazing down on you with hatred.  In one hand it "
"holds a huge sword, in the other it has a many thonged whip, both glowing "
"with red-hot flames."
msgstr ""
"Una figura colosal que parece estar formada enteramente por sombras "
"envueltas en llamas. Sus inmensas alas oscuras se extienden de muro a muro. "
"Dos ojos que parecen carbones ardientes te miran con odio. En una mano "
"sostiene una enorme espada, en la otra tiene un látigo de muchos filamentos,"
" ambos brillando con llamas al rojo vivo."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/monsters.json
msgid "teravolt"
msgid_plural "teravolts"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "teravolt"
#: data/mods/Magiclysm/monsters/monsters.json
msgid "Small energy sphere, that slowly float into the target."
msgstr ""

#. ~ Death message of monster "teravolt"
#: data/mods/Magiclysm/monsters/monsters.json
#, c-format
msgid "The %s explode, creating a giant cloud of sparks."
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/monsters.json
msgid "razor butterfly"
msgid_plural "razor butterflies"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "razor butterfly"
#: data/mods/Magiclysm/monsters/monsters.json
msgid ""
"A large, brightly colored butterfly with crystalline wings, fluttering "
"incongruously through the air.  This one seems to be patterned with orange "
"runes, and its wings look razor-sharp."
msgstr ""

#. ~ Death message of monster "razor butterfly"
#. ~ Death message of monster "shambling mound"
#. ~ Death message of monster "thunder pillar"
#: data/mods/Magiclysm/monsters/monsters.json
#, c-format
msgid "A %s dissolves."
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/monsters.json
msgid "shambling mound"
msgid_plural "shambling mounds"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "shambling mound"
#: data/mods/Magiclysm/monsters/monsters.json
msgid ""
"This giant plant mess is one of the oldest magic species in the world.  They"
" were very rare before the Cataclysm, but their population has since "
"increased by a lot."
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/monsters.json
msgid "electric demon"
msgid_plural "electric demons"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "electric demon"
#: data/mods/Magiclysm/monsters/monsters.json
msgid ""
"Small, pure electric elemental, it jumps from target to target, and attack "
"anything on his sight.  Except of caster."
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/monsters.json
msgid "thunder pillar"
msgid_plural "thunder pillars"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "thunder pillar"
#: data/mods/Magiclysm/monsters/monsters.json
msgid ""
"It looks like a giant floating stone shard, but it's an intelligent "
"creature, that can use electric branches as their own bodies."
msgstr ""

#. ~ Monster message of special attack of monster "thunder pillar"
#: data/mods/Magiclysm/monsters/monsters.json
msgid "The pillar weaves electricity around itself!"
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/ogre.json
msgid "Ogre"
msgid_plural "Ogres"
msgstr[0] "Ogro"
msgstr[1] "Ogros"
msgstr[2] "Ogros"

#. ~ Description of monster "Ogre"
#: data/mods/Magiclysm/monsters/ogre.json
msgid ""
"A green beast known for living in swamps and eating humans; it will kill "
"anything it gets its hands on."
msgstr ""
"Una bestia verde conocida por vivir en los pantanos y comer humanos; matará "
"cualquier cosa que tenga en sus manos."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/orcs.json
msgid "orc warrior"
msgid_plural "orc warriors"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "orc warrior"
#: data/mods/Magiclysm/monsters/orcs.json
msgid ""
"This green brute is an orc warrior.  It stares at you menacingly, sword in "
"hand."
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/orcs.json
msgid "orc archer"
msgid_plural "orc archers"
msgstr[0] "arquero orco"
msgstr[1] "arqueros orcos"
msgstr[2] "arqueros orcos"

#. ~ Description of monster "orc archer"
#: data/mods/Magiclysm/monsters/orcs.json
msgid ""
"This green brute is an orc archer.  It looks at you with a bow in hand and "
"smiles silently as it aims at you."
msgstr ""

#. ~ Description of special attack of monster "orc archer"
#: data/mods/Magiclysm/monsters/orcs.json
msgid "The orc shoots you with laser accuracy"
msgstr "El orco te dispara con precisión láser"

#. ~ Monster name
#: data/mods/Magiclysm/monsters/orcs.json
msgid "blood orc"
msgid_plural "blood orcs"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "blood orc"
#: data/mods/Magiclysm/monsters/orcs.json
msgid ""
"This bloody red brute is an orc warrior.  He stares at you menacingly, "
"weapon in hand; this one seems to have bathed himself in the blood of his "
"enemies."
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/zombified_monsters.json
msgid "rotting wolf man"
msgid_plural "rotting wolf mans"
msgstr[0] "hombre lobo podrido"
msgstr[1] "hombres lobo podridos"
msgstr[2] "hombres lobo podridos"

#. ~ Description of monster "rotting wolf man"
#: data/mods/Magiclysm/monsters/zombified_monsters.json
msgid ""
"The classic half man half wolf of the movies, but with a new twist: UNDEATH!"
"  This monster lopes along alternating between two and four legged gaits.  "
"It's jet black eyes seething with insatiable hunger.  Now you will know why "
"you fear the night."
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/zombified_monsters.json
msgid "Zorc"
msgid_plural "Zorcs"
msgstr[0] "Zorco"
msgstr[1] "Zorcos"
msgstr[2] "Zorcos"

#. ~ Description of monster "Zorc"
#: data/mods/Magiclysm/monsters/zombified_monsters.json
msgid ""
"This unholy beast looks at you with a piercing stare so strong it might "
"scare your soul away."
msgstr ""
"Esta bestia impía te mira con una mirada penetrante tan fuerte que podría "
"asustar tu alma."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/zombified_monsters.json
msgid "Zowlbear"
msgid_plural "Zowlbears"
msgstr[0] "Zombuhoso"
msgstr[1] "Zombuhosos"
msgstr[2] "Zombuhosos"

#. ~ Description of monster "Zowlbear"
#: data/mods/Magiclysm/monsters/zombified_monsters.json
msgid ""
"This horrible mutant monster has been zombified.  Though it looks weaker "
"than its living counterpart, you feel much more hostility from its black "
"oily eyes."
msgstr ""
"Este horrible monstruo mutante ha sido zombificado. Aunque parece más débil "
"que su homólogo vivo, sientes mucha más hostilidad por sus ojos negros y "
"aceitosos."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/zombified_monsters.json
msgid "Zowlbear Predator"
msgid_plural "Zowlbear Predators"
msgstr[0] "Depredador Zombuhoso"
msgstr[1] "Depredadores Zombuhosos"
msgstr[2] "Depredadores Zombuhosos"

#. ~ Description of monster "Zowlbear Predator"
#: data/mods/Magiclysm/monsters/zombified_monsters.json
msgid ""
"An once zombified owlbear, now faster and much bigger in size.  Its thick "
"skin protects the monster from harm, a sharp beak capable of rending through"
" metal and a fury in its eyes warns you to stay away."
msgstr ""
"Un buhoso antes zombificado, ahora más rápido y de mayor tamaño. Su gruesa "
"piel protege al monstruo de cualquier daño, su afilado pico es capaz de "
"atravesar el metal y la furia de sus ojos te advierte de que te mantengas "
"alejado."

#. ~ Monster name
#: data/mods/Magiclysm/monsters/zombified_monsters.json
msgid "Undying"
msgid_plural "Undyings"
msgstr[0] "Inmortal"
msgstr[1] "Inmortales"
msgstr[2] "Inmortales"

#. ~ Description of monster "Undying"
#: data/mods/Magiclysm/monsters/zombified_monsters.json
msgid ""
"An enormous humanoid monster with a yellowish-green skin.  Trolls are "
"renowned for their thick hides and natural regenerative ability.  After "
"death, its pus filled body seems to have much grown stronger, it looks at "
"you ferociously with hunger in its eyes."
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/zombified_monsters.json
msgid "Zombified Yule Cat"
msgid_plural "Zombified Yule Cats"
msgstr[0] "Gato Yule Zombificado"
msgstr[1] "Gatos Yule Zombificados"
msgstr[2] "Gatos Yule Zombificados"

#. ~ Description of monster "Zombified Yule Cat"
#: data/mods/Magiclysm/monsters/zombified_monsters.json
msgid ""
"A magical beast from Icelandic folklore, known for their catlike appearance "
"and their hobby of eating Workshop Elves.  It creepily stumbles on its 4 "
"legs with its squirming uneven body after meeting demise and being reborn "
"just to eat you."
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/zombified_monsters.json
msgid "Tod Cat"
msgid_plural "Tod Cats"
msgstr[0] "Gato Tod"
msgstr[1] "Gatos Tod"
msgstr[2] "Gatos Tod"

#. ~ Description of monster "Tod Cat"
#: data/mods/Magiclysm/monsters/zombified_monsters.json
msgid ""
"Once used to its decomposed body, this nightmarish cat with thick teeth and "
"razorshap claws seems to be looking around for things to \"play\" with.  "
"Though its head is of a feline, it grins at you sadistically with a glint in"
" its cold demonic eyes."
msgstr ""

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/debug_mutations.json
msgid "Vault Defender"
msgstr ""

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/debug_mutations.json
msgid "library defender"
msgstr ""

#. ~ Mutation class name
#. ~ Mutation name
#: data/mods/Magiclysm/mutations/dragon_mutation_category.json
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Black Dragon"
msgstr "Dragón Negro"

#. ~ "mutagen_message" of mutation class "Black Dragon"
#: data/mods/Magiclysm/mutations/dragon_mutation_category.json
msgid ""
"Acid boils through your veins.  You feel ancient power swell within you."
msgstr ""
"El ácido hierve por tus venas. Sientes que el poder ancestral se inflama "
"dentro de ti."

#. ~ Memorial message of mutation class "Black Dragon" for male
#: data/mods/Magiclysm/mutations/dragon_mutation_category.json
msgctxt "memorial_male"
msgid "Settled to slumber with their hoard."
msgstr "Se instaló a dormir con su tesoro."

#. ~ Memorial message of mutation class "Black Dragon" for female
#: data/mods/Magiclysm/mutations/dragon_mutation_category.json
msgctxt "memorial_female"
msgid "Settled to slumber with their hoard."
msgstr "Se instaló a dormir con su tesoro."

#. ~ Dream of mutation category "DRAGON_BLACK"
#: data/mods/Magiclysm/mutations/dreams.json
msgid "You have a strange dream about dragons."
msgstr ""

#. ~ Dream of mutation category "DRAGON_BLACK"
#: data/mods/Magiclysm/mutations/dreams.json
msgid "You have a disturbing dream of rampaging in a village."
msgstr ""

#. ~ Dream of mutation category "DRAGON_BLACK"
#: data/mods/Magiclysm/mutations/dreams.json
msgid ""
"While dreaming, you see a distinctively dragon-like reflection of yourself."
msgstr ""

#. ~ Dream of mutation category "DRAGON_BLACK"
#: data/mods/Magiclysm/mutations/dreams.json
msgid ""
"You blissfully dream of soaring over a human village.  The thought of "
"destroying it and abducting the chiefs daughter is somewhat disturbing."
msgstr ""

#. ~ Dream of mutation category "DRAGON_BLACK"
#: data/mods/Magiclysm/mutations/dreams.json
msgid "You have a disturbingly lifelike dream of living as a dragon."
msgstr ""

#. ~ Dream of mutation category "DRAGON_BLACK"
#: data/mods/Magiclysm/mutations/dreams.json
msgid "In your dream you are the nightmare of a human."
msgstr ""

#. ~ Dream of mutation category "DRAGON_BLACK"
#: data/mods/Magiclysm/mutations/dreams.json
msgid "You have a disturbingly satisfying dream of ravaging a human village."
msgstr ""

#. ~ Dream of mutation category "DRAGON_BLACK"
#: data/mods/Magiclysm/mutations/dreams.json
msgid "You dream of raiding a castle and abducting the princess."
msgstr ""

#. ~ Description of effect type "Dragon Terror"
#: data/mods/Magiclysm/mutations/mutation_effects.json
msgid "You are uneasy and fearful from a Dragon's mighty presence"
msgstr "Estás inquieto y temeroso por la poderosa presencia de un Dragón"

#. ~ Description of effect type "Dragon Boost"
#: data/mods/Magiclysm/mutations/mutation_effects.json
msgid "You are filled with the power of Dragons."
msgstr "Estás lleno del poder de los Dragones."

#. ~ Apply message of effect type "Dragon Boost"
#: data/mods/Magiclysm/mutations/mutation_effects.json
msgid "You let out a mighty roar as you are filled with the power of Dragons!"
msgstr ""
"Dejas escapar un poderoso rugido mientras te llenas del poder de los "
"dragones."

#. ~ Remove message of effect type "Dragon Boost"
#: data/mods/Magiclysm/mutations/mutation_effects.json
msgid "The Draconic energy fades from within you."
msgstr "La energía Dracónica se desvanece en tu interior."

#. ~ Name of effect type id "dragon_acidburn"
#: data/mods/Magiclysm/mutations/mutation_effects.json
msgid "Dragon Acid burn"
msgstr "Quemadura Ácida de Dragón"

#. ~ Description of effect type "Dragon Acid burn"
#: data/mods/Magiclysm/mutations/mutation_effects.json
msgid "Burned with a black dragon's acid"
msgstr "Quemado con el ácido de un dragón negro"

#. ~ Name of effect type id "lesser_dragon_acidburn"
#: data/mods/Magiclysm/mutations/mutation_effects.json
msgid "Lesser Dragon Acid burn"
msgstr "Quemadura Ácida de Dragón Menor"

#. ~ Description of effect type "Lesser Dragon Acid burn"
#: data/mods/Magiclysm/mutations/mutation_effects.json
msgid "Burned with a less potent version of a black dragon's acid"
msgstr "Quemado con una menos potente versión del ácido de un dragón negro"

#. ~ Description of mutation "Black Dragon"
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"You sometimes think back about the world you left behind.  You're glad you "
"burned it in your wake."
msgstr ""
" A veces piensas en el mundo que dejaste atrás. Te alegras de haberlo "
"quemado a tu paso."

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Black Dragon Scales"
msgstr "Escamas de Dragón Negro"

#. ~ Description of mutation "Black Dragon Scales"
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"A set of heavy black scales has grown to cover your body, acting as natural "
"armor.  While difficult to penetrate, it also greatly limits your "
"flexibility, resulting in a -4 penalty to Dexterity.  Greatly reduces wet "
"effects."
msgstr ""
"Un conjunto de pesadas escamas negras ha crecido hasta cubrir tu cuerpo, "
"actuando como armadura natural. Aunque es difícil de penetrar, también "
"limita en gran medida tu flexibilidad, lo que supone una penalización de -4 "
"a la Destreza. Reduce en gran medida los efectos por estar mojado."

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Reptilian Legs"
msgstr ""

#. ~ Description of mutation "Reptilian Legs"
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"Your legs and feet have become reptile-like and your toenails have grown "
"into short claws.  Fortunately they don't impede your movement."
msgstr ""

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Dragon Legs"
msgstr ""

#. ~ Description of mutation "Dragon Legs"
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"Your legs and feet have become dragon-like and the claws on your toes have "
"developed into incredibly tough talons.  These are fearsome and powerful, "
"but prevent you from wearing shoes and slightly impede your movement."
msgstr ""

#. ~ Message when player with mutation "Dragon Legs" attacks
#: data/mods/Magiclysm/mutations/mutations.json
#, c-format
msgid "You slash %s with your clawed feet"
msgstr "Cortas a %s con tus pies de garra"

#. ~ Message when NPC with mutation "Dragon Legs" attacks
#: data/mods/Magiclysm/mutations/mutations.json
#, c-format
msgid "%1$s slashes %2$s with their clawed feet"
msgstr "%1$s corta a %2$s con sus pies de garra"

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Inconvenient Draconic Growth"
msgstr "Crecimiento Dracónico Inconveniente"

#. ~ Description of mutation "Inconvenient Draconic Growth"
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"You have grown noticeably taller, broader, and menacing.  Much of it is "
"useful muscle mass (Strength +2), but you find it throws off your balance "
"and you get in your own way (+10 torso and arm encumbrance), and you notice "
"people are starting to treat you differently."
msgstr ""
"Has crecido notablemente, eres más ancho y amenazante. Gran parte de ello es"
" masa muscular útil (Fuerza +2), pero te das cuenta de que te hace perder el"
" equilibrio y te incomoda (+10 de incomodidad en el torso y los brazos), y "
"notas que la gente empieza a tratarte de forma diferente."

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Draconic Growth"
msgstr "Crecimiento Dracónico"

#. ~ Description of mutation "Draconic Growth"
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"You carry your rugged body with the dignity you deserve, but are all the "
"more menacing for it.  Strength +2."
msgstr ""
"Llevas tu cuerpo robusto con la dignidad que mereces, pero eres aún más "
"amenazante por ello. Fuerza +2."

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Freakish Draconic Maturity"
msgstr "Madurez Draconica Peculiar "

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Wyrmling Strength"
msgstr "Fuerza De Nacimiento de Dragón"

#. ~ Description of mutation "Wyrmling Strength"
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"Your muscles are enhanced by some growing innate magic.  You are slightly "
"stronger.  Strength + 1"
msgstr ""
"Tus músculos están mejorados por una magia innata creciente. Eres "
"ligeramente más fuerte. Fuerza + 1"

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Young Dragon Strength"
msgstr "Fuerza de Dragón Joven"

#. ~ Description of mutation "Young Dragon Strength"
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"The connection to your inner magic is growing and your muscles are stronger,"
" but you're a little more clumsy.  Strength + 3, Dexterity - 1"
msgstr ""
"La conexión con tu magia interior crece y tus músculos son más fuertes, pero"
" eres un poco más torpe. Fuerza + 3, Destreza - 1"

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Draconic Strength"
msgstr "Fuerza Dracónica"

#. ~ Description of mutation "Draconic Strength"
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"The magic within you courses through your muscles, greatly empowering them."
"  This costs you valuable flexibility and coordination, however.  Strength +"
" 5, Dexterity - 2"
msgstr ""
"La magia que hay en tu interior fluye a través de tus músculos, "
"potenciándolos en gran medida. Sin embargo, esto te cuesta una valiosa "
"flexibilidad y coordinación. Fuerza + 5, Destreza - 2"

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Ancient Draconic Strength"
msgstr "Fuerza Dracónica Antigua"

#. ~ Description of mutation "Ancient Draconic Strength"
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"Your internal magic has filled you with unimaginable strength, but you can't"
" move as freely as your form once could.  This is no problem.  Strength + 8,"
" Dexterity - 3"
msgstr ""
"Tu magia interna te ha llenado de una fuerza inimaginable, pero no puedes "
"moverte con la misma libertad que antes. Esto no es un problema. Fuerza + 8,"
" Destreza - 3"

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Draconic Maturity"
msgstr "Madurez Dracónica"

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Dragon Horns"
msgstr ""

#. ~ Description of mutation "Dragon Horns"
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"You have a pair of long, curved back, dragon-like horns.  They allow you to "
"make a strong bashing headbutt attack, but prevent wearing headwear that is "
"not made of fabric."
msgstr ""

#. ~ Message when player with mutation "Dragon Horns" attacks
#: data/mods/Magiclysm/mutations/mutations.json
#, c-format
msgid "You headbutt %s with your draconic horns"
msgstr ""

#. ~ Message when NPC with mutation "Dragon Horns" attacks
#: data/mods/Magiclysm/mutations/mutations.json
#, c-format
msgid "%1$s headbutts %2$s with their draconic horns"
msgstr ""

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Black Dragon Wings"
msgstr "Alas de Dragón Negro"

#. ~ Description of mutation "Black Dragon Wings"
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"You have a pair of large, black scaled dragon wings.  While you have control"
" of them and can make attacks with them, they are not large enough nor "
"strong enough to allow you to fly and they throw you off balance, greatly "
"reducing your ability to dodge.  They can be used to cast a protective spell"
" on yourself however."
msgstr ""

#. ~ Message when player with mutation "Black Dragon Wings" attacks
#: data/mods/Magiclysm/mutations/mutations.json
#, c-format
msgid "You bash %s with your powerful wings"
msgstr "Golpeas a %s con tus alas poderosas"

#. ~ Message when NPC with mutation "Black Dragon Wings" attacks
#: data/mods/Magiclysm/mutations/mutations.json
#, c-format
msgid "%1$s bashes %2$s with their powerful wings"
msgstr "%1$s golpea a %2$s con sus poderosas alas"

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Overly Acidic Digestion"
msgstr "Digestión Super Ácida"

#. ~ Description of mutation "Overly Acidic Digestion"
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"Your digestive issues have developed to become overly acidic which greatly "
"impacts your ability to normally digest food, resulting in getting far less "
"nutrition from the food you eat and making your need to eat more often."
msgstr ""
"Tus órganos digestivos se han desarrollado hasta volverse excesivamente "
"ácidos, lo que afecta en gran medida a tu capacidad para digerir normalmente"
" los alimentos, lo que hace que obtengas mucha menos nutrición de los "
"alimentos que ingiere y que necesites comer más frecuentemente."

#. ~ Description of mutation "Black Dragon Breath"
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"Your digestive issues may not have settled entirely, but you can somewhat "
"control them and now you have the ability to spit acid!"
msgstr ""
"¡Tus órganos digestivos no se han resuelto del todo, pero puedes "
"controlarlos un poco y ahora tienes la capacidad de escupir ácido!."

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Draconic Heat Dependence"
msgstr "Dependencia de Calor Dracónico"

#. ~ Description of mutation "Draconic Heat Dependence"
#: data/mods/Magiclysm/mutations/mutations.json
#, no-c-format
msgid ""
"Your muscle response is dependent on ambient temperatures.  You lose 1% of "
"your speed for every 5 (2.8) degrees below 65 F (18.3 C).  Unfortunately, "
"this doesn't seem to help you conserve any energy."
msgstr ""
"La respuesta de tus músculos depende de la temperatura ambiente. Pierdes un "
"1% de tu velocidad por cada 5 (2,8) grados por debajo de 18,3 C (65 F). Por "
"desgracia, esto no parece ayudarte a conservar la energía."

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
msgid "High Draconic Heat Dependence"
msgstr "Dependencia de Calor Dracónico Alta"

#. ~ Description of mutation "High Draconic Heat Dependence"
#: data/mods/Magiclysm/mutations/mutations.json
#, no-c-format
msgid ""
"Your muscle response is highly dependent on ambient temperatures.  You lose "
"1% of your speed for every 3 (1.7) degrees below 65 F (18.3 C).  "
"Unfortunately, it seems you have to exert more energy to keep moving."
msgstr ""
"La respuesta de tus músculos depende en gran medida de la temperatura "
"ambiente. Pierdes un 1% de tu velocidad por cada 3 (1,7) grados por debajo "
"de 18,3 C (65 F). Desgraciadamente, parece que tienes que esforzarte más "
"para seguir moviéndote."

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Draconic Ectothermia"
msgstr "Sangre Fría Dracónica"

#. ~ Description of mutation "Draconic Ectothermia"
#: data/mods/Magiclysm/mutations/mutations.json
#, no-c-format
msgid ""
"Your body has become permanently cold-blooded.  Your speed lowers or raises "
"1% for every 2 (1.1) degrees below or above 65 F (18.3 C).  All this and you"
" need even more food to maintain your energy."
msgstr ""
"Tu cuerpo se ha vuelto permanentemente de sangre fría. Tu velocidad baja o "
"sube un 1% por cada 2 (1,1) grados por debajo o por encima de 18,3 C (65 F)."
" Todo esto y necesitas aún más comida para mantener tu energía."

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Draconic Magic"
msgstr "Magia Dracónica"

#. ~ Description of mutation "Draconic Magic"
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"You are imbued with the ancient magic powers of black dragons, improving "
"your mana reserves and opening your mind to amazing feats of magic."
msgstr ""

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Draconic Spellcasting"
msgstr "Lanzamiento de Hechizos Dracónicos"

#. ~ Description of mutation "Draconic Spellcasting"
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"Your mind has fully opened to the power and ancient heritage of dragons.  "
"You can access even greater quantities of mana and you have access to more "
"dragon spells."
msgstr ""
"Tu mente se ha abierto completamente al poder y a la antigua herencia de los"
" dragones. Puedes acceder a cantidades aún mayores de maná y tienes acceso a"
" más hechizos de dragón."

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Scaled Mouth"
msgstr "Boca Escamada"

#. ~ Description of mutation "Scaled Mouth"
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"Your scales have grown up and around your mouth, digging into your gums and "
"retracting your lips.  On the down side, it makes speaking difficult.  On "
"the positive side, it makes it very easy to bite things, though what's "
"driving you to do that?"
msgstr ""
"Las escamas han crecido alrededor de tu boca, hundiéndose en tus encías y "
"retrayendo tus labios. En el lado negativo, hace que sea difícil hablar. En "
"el lado positivo, hace que sea muy fácil morder cosas, aunque ¿qué te "
"impulsa a hacer eso?"

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Black Dragon Maw"
msgstr "Fauces de Dragón Negro"

#. ~ Description of mutation "Black Dragon Maw"
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"Your face and jaws have extended to a long, toothy dragon maw.  It's "
"fearsome and causes grievous wounds, but prevents wearing mouth gear."
msgstr ""
"Tu cara y tus mandíbulas se han extendido hasta convertirse en unas largas y"
" dentadas fauces de dragón. Es temible y causa graves heridas, pero impide "
"llevar equipo bucal."

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Stubby Dragon Tail"
msgstr ""

#. ~ Description of mutation "Stubby Dragon Tail"
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"You have a short, stubby tail that has strange bumps and ridges.  You can "
"wiggle it, but it serves no purpose."
msgstr ""
"Tienes una cola corta y rechoncha con extrañas protuberancias y crestas. "
"Puedes moverla, pero no sirve para nada."

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Short Dragon Tail"
msgstr ""

#. ~ Description of mutation "Short Dragon Tail"
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"You have a short, dragonlike tail.  You can use it decently as a club of "
"sorts, but it's not doing anything to help you balance.  Prevents wearing "
"non-fabric pants."
msgstr ""

#. ~ Description of mutation "Dragon Tail"
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"You have a long, thick, dragonlike tail.  It doesn't help you balance or "
"dodge any better, but it is a powerful bashing weapon.  Prevents wearing "
"non-fabric pants."
msgstr ""
"Tienes una cola larga y gruesa como la de un dragón. No te ayuda a mantener "
"el equilibrio ni a esquivar mejor, pero es un arma contundente poderosa. "
"Impide llevar pantalones que no sean de tejido."

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Scaled Hands"
msgstr "Manos Escamosas"

#. ~ Description of mutation "Scaled Hands"
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"Your scales have grown to cover your hands and elongate the tips in to "
"jagged claws that can be serviceable as cutting and piercing weapons in "
"unarmed combat.  You can still use them normally, but you can't wear gloves."
msgstr ""
"Tus escamas han crecido hasta cubrir tus manos y alargar las puntas en forma"
" de garras dentadas que pueden servir como armas cortantes y perforantes en "
"el combate sin armas. Puedes seguir usándolas normalmente, pero no puedes "
"usar guantes."

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Black Dragon Talons"
msgstr "Talones de Dragón Negro"

#. ~ Description of mutation "Black Dragon Talons"
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"All of your fingers have developed into huge scaled talons.  They prevent "
"wearing gloves, but you can use them to powerful effect in melee combat and "
"you appear to have uncovered some secrets about black dragons."
msgstr ""
"Todos tus dedos se han convertido en enormes garras con escamas. Impiden el "
"uso de guantes, pero puedes utilizarlas con gran efecto en el combate c. a "
"c. y parece que has descubierto algunos secretos sobre los dragones negros."

#. ~ Description of mutation "Soul Pressure"
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"Your presence is so dangerous you can burn living creatures around you.  You"
" suppress it now."
msgstr ""

#. ~ Message when transforming from mutation  "Soul Pressure" to
#. "SOUL_PRESSURE_ON"
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Living creatures around you start to burn!"
msgstr ""

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Soul Pressure (on)"
msgstr ""

#. ~ Description of mutation "Soul Pressure (on)"
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"Your presence is so dangerous you can burn living creatures around you."
msgstr ""

#. ~ Message when transforming from mutation  "Soul Pressure (on)" to
#. "SOUL_PRESSURE_OFF"
#: data/mods/Magiclysm/mutations/mutations.json
msgid "You suppress your soul pressure."
msgstr ""

#. ~ Unique name of a female NPC
#. ~ The Librarian of the Forge of Wonders.
#: data/mods/Magiclysm/npc/TALK_FORGE_ARDELIA.json
msgid "Librarian, A"
msgstr "Bibliotecario, A"

#. ~ Name suffix of a female NPC
#. ~ The Librarian of the Forge of Wonders.
#. ~ The Pirate of the Forge of Wonders.
#. ~ Name suffix of a male NPC
#. ~ The Lord of the Forge of Wonders.
#: data/mods/Magiclysm/npc/TALK_FORGE_ARDELIA.json
#: data/mods/Magiclysm/npc/TALK_FORGE_HELEN_TAVREL.json
#: data/mods/Magiclysm/npc/TALK_FORGE_MERCHANT.json
msgid "Forge Lord"
msgstr "Señor de la Forja"

#. ~ Name of an NPC class
#. ~ This is a unique NPC who doesn't get randomly selected background traits
#: data/mods/Magiclysm/npc/TALK_FORGE_ARDELIA.json
msgid "Forge Librarian"
msgstr "Bibliotecario de la Fragua"

#. ~ Job description of "Forge Librarian" NPC class
#. ~ This is a unique NPC who doesn't get randomly selected background traits
#: data/mods/Magiclysm/npc/TALK_FORGE_ARDELIA.json
msgid "I take care of the books and scrolls."
msgstr "Me ocupo de los libros y los pergaminos."

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_FORGE_ARDELIA.json
msgid ""
"I keep Valzain's books.  There are many floors of bookshelves in his pocket "
"dimension.  These happen to be the ones I think it most likely he'll read "
"soon.  I can sell some that we have copies of."
msgstr ""
" Guardo los libros de Valzain. Hay muchos pisos de estanterías en su "
"dimensión de bolsillo. Resulta que estos son los que creo más probable que "
"lea pronto. Puedo vender algunos de los que tenemos repetidos."

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_FORGE_ARDELIA.json
msgid ""
"I organize the books, I sell extra books, once when we still lent books I "
"would hunt down those with late books to return."
msgstr ""
"Organizo los libros, vendo los que sobran, una vez, cuando todavía "
"prestábamos libros, cazaba a los que tenían libros atrasados para "
"devolverlos."

#. ~ Response to NPC dialogue
#: data/mods/Magiclysm/npc/TALK_FORGE_ARDELIA.json
msgid "Let's talk business then."
msgstr "Hablemos de negocios, entonces."

#. ~ Unique name of a female NPC
#. ~ The Pirate of the Forge of Wonders.
#: data/mods/Magiclysm/npc/TALK_FORGE_HELEN_TAVREL.json
msgid "Helen Tavrel, Former Pirate"
msgstr "Ex Pirata, Helen Tavrel"

#. ~ Name of an NPC class
#. ~ This is a unique NPC who doesn't get randomly selected background traits
#: data/mods/Magiclysm/npc/TALK_FORGE_HELEN_TAVREL.json
msgid "Pirate Queen"
msgstr "Reina Pirata"

#. ~ Job description of "Pirate Queen" NPC class
#. ~ This is a unique NPC who doesn't get randomly selected background traits
#. ~ Job description of "Pirate" NPC class
#: data/mods/Magiclysm/npc/TALK_FORGE_HELEN_TAVREL.json
#: data/mods/Magiclysm/npc/TALK_FORGE_PIRATE.json
msgid "My adventures would curdle your blood."
msgstr "Mis aventuras te harían hervir la sangre."

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_FORGE_HELEN_TAVREL.json
msgid "Would you try to capture me?"
msgstr "¿Intentarías capturarme?"

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_FORGE_HELEN_TAVREL.json
msgid "I've killed many a government-sanctioned hunter in my life."
msgstr "He matado a muchos cazadores sancionados por el gobierno en mi vida."

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_FORGE_HELEN_TAVREL.json
msgid ""
"Aren't we all lucky that you are probably the last lawman alive in miles?"
msgstr ""
"¿No somos todos afortunados de que seañ probablemente el último agente de la"
" ley con vida en kilómetros?"

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_FORGE_HELEN_TAVREL.json
#: data/mods/Magiclysm/npc/TALK_FORGE_MERCHANT.json
msgid "Welcome to the Forge of Wonders."
msgstr "Bienvenido a la Forja de las Maravillas."

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_FORGE_HELEN_TAVREL.json
msgid "Reagents and blackpowders!"
msgstr "¡Reactivos y pólvoras!"

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_FORGE_HELEN_TAVREL.json
#: data/mods/Magiclysm/npc/TALK_FORGE_PIRATE.json
msgid "Ahoy and other nautical terms!"
msgstr "¡A la vista y otros términos náuticos!"

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_FORGE_HELEN_TAVREL.json
msgid ""
"I hope you're willing to overlook my past because otherwise you're not "
"buying anything from me."
msgstr ""
"Espero que estés dispuesto a pasar por alto mi pasado porque, de lo "
"contrario, no me comprarás nada."

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_FORGE_HELEN_TAVREL.json
msgid ""
"A lifetime of plunder has brought me many a strange item - that you can have"
" for unbeatable prices!"
msgstr ""
"Toda una vida de saqueos me ha traído muchos objetos extraños, - ¡que puedes"
" conseguir a precios insuperables!"

#. ~ Response to NPC dialogue
#: data/mods/Magiclysm/npc/TALK_FORGE_HELEN_TAVREL.json
msgid "Well, shiver me timbers then."
msgstr "Bueno, que me parta un rayo entonces."

#. ~ Unique name of a male NPC
#. ~ The Lord of the Forge of Wonders.
#: data/mods/Magiclysm/npc/TALK_FORGE_MERCHANT.json
msgid "Valzain of Psiom"
msgstr "Valzain of Psiom"

#. ~ Name of an NPC class
#. ~ This is a unique NPC who doesn't get randomly selected background traits
#: data/mods/Magiclysm/npc/TALK_FORGE_MERCHANT.json
msgid "Wondrous Dreamer"
msgstr "Soñador Maravilloso"

#. ~ Job description of "Wondrous Dreamer" NPC class
#. ~ This is a unique NPC who doesn't get randomly selected background traits
#: data/mods/Magiclysm/npc/TALK_FORGE_MERCHANT.json
msgid "I created this place from dreams and magic."
msgstr "He creado este lugar a partir de sueños y magia."

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_FORGE_MERCHANT.json
msgid "The government doesn't subsidize your purchases here anymore."
msgstr "El gobierno ya no subvenciona tus compras aquí más."

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_FORGE_MERCHANT.json
msgid "Do you have any tales of adventure I could write down?"
msgstr "¿Tienes alguna historia de aventuras que pueda escribir?"

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_FORGE_MERCHANT.json
msgid ""
"In case you were wondering, we no longer respect any pre-existing weapon "
"laws."
msgstr ""
"Por si te lo preguntas, ya no respetamos ninguna ley de armas preexistentes."

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_FORGE_MERCHANT.json
msgid "Bring me tales and we can trade."
msgstr "Tráeme historias y podemos comerciar."

#. ~ Response to NPC dialogue
#: data/mods/Magiclysm/npc/TALK_FORGE_MERCHANT.json
msgid "Do you have any stories for me?"
msgstr "¿Tienes alguna historia para mí?"

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_FORGE_MERCHANT.json
msgid "Excellent.  What new stories have you brought me?"
msgstr "Excelente. ¿Qué nuevas historias me has traído?"

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_FORGE_MERCHANT.json
msgid ""
"Once I was lost in the throes of love, now I've built an empire of material "
"goods."
msgstr ""
"Antes me perdía en la agonía del amor, ahora he construido un imperio de "
"bienes materiales."

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_FORGE_MERCHANT.json
msgid ""
"Well here and now I am the law, and the law here is that people purchase my "
"goods, they take them out into the world and they die; or they return to buy"
" more of my goods.  Either way, I write poetry about them."
msgstr ""
"Bueno, aquí y ahora yo soy la ley, y la ley aquí es que la gente compra mis "
"bienes, los llevan al mundo y mueren; o vuelven para comprar más de mis "
"bienes. En cualquier caso, escribo poesía sobre ellos."

#. ~ Response to NPC dialogue
#: data/mods/Magiclysm/npc/TALK_FORGE_MERCHANT.json
msgid "Good day, sir."
msgstr "Buen día, señor."

#. ~ Name suffix of an NPC
#: data/mods/Magiclysm/npc/TALK_FORGE_PIRATE.json
msgid "Former Pirate"
msgstr "Ex Pirata"

#. ~ Name of an NPC class
#. ~ This is a unique NPC who doesn't get randomly selected background traits
#: data/mods/Magiclysm/npc/TALK_FORGE_PIRATE.json
msgid "Pirate"
msgstr "Pirata"

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_FORGE_PIRATE.json
msgid "Walk away afore I kill ya where you stand."
msgstr "Aléjate antes de que te mate donde estás."

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_FORGE_PIRATE.json
msgid "You've got a lot of nerve wearing that badge these days."
msgstr "Tienes mucho valor para llevar esa insignia en estos días."

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_FORGE_PIRATE.json
msgid "Boys, I think we should drown this fool."
msgstr "Chicos, creo que tenemos que ahogar a este memo."

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_FORGE_PIRATE.json
msgid "Watch your step."
msgstr "Cuidado dónde pisas."

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_FORGE_PIRATE.json
msgid "Talk to Captain Tavrel."
msgstr "Habla con el Capitán Tavrel."

#. ~ Response to NPC dialogue
#: data/mods/Magiclysm/npc/TALK_FORGE_PIRATE.json
msgid "Obviously I should speak to someone else."
msgstr "Obviamente debería hablar con otra persona."

#. ~ Response to NPC dialogue
#: data/mods/Magiclysm/npc/TALK_FORGE_PIRATE.json
msgid "Pirates should be hung until dead."
msgstr "Los piratas deberían ser colgados hasta la muerte."

#. ~ NPC dialogue line
#. ~ Dialogue line in mission "Kill 50 Zombies"
#. ~ Dialogue line in mission "Kill 150 Zombies"
#: data/mods/Magiclysm/npc/TALK_HEALER_GREY.json
#: data/mods/Magiclysm/npc/missiondef.json
msgid "Blessed be."
msgstr "Bendito seas."

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_HEALER_GREY.json
msgid ""
"I must purge this land of its curse.  Will you help or hinder our mission?"
msgstr ""
"Debo purgar esta tierra de su maldición. ¿Ayudarás o dificultarás nuestra "
"misión?"

#. ~ Response to NPC dialogue
#: data/mods/Magiclysm/npc/TALK_HEALER_GREY.json
#: data/mods/Magiclysm/npc/TALK_OLD_MAGUS.json
msgid "Hello <name_g>."
msgstr "Hola <name_g>."

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_HEALER_GREY.json
msgid "Blessed be.  May you purge that which opposes the calm."
msgstr "Bendito sea. Que purgues lo que se opone a la calma."

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_HEALER_GREY.json
msgid "I must purge this place before I can move on."
msgstr "Debo purgar este lugar antes de poder seguir adelante."

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_OLD_MAGUS.json
msgid "Oh, you again."
msgstr "Oh, tú otra vez."

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_OLD_MAGUS.json
msgid "Huh?  *mumble mumble* …Who are you?"
msgstr "¿Eh? *murmura, murmura* ... ¿Quién eres?"

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_OLD_MAGUS.json
msgid "I'm busy, what is it?"
msgstr "Estoy ocupado, ¿qué pasa?"

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_OLD_MAGUS.json
msgid "And leave my tower and all my research?  I think not."
msgstr "¿Y dejar mi torre y toda mi investigación? Creo que no."

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_TECHNO_KID.json
msgid "Ah, hello again."
msgstr "Ah, hola de nuevo."

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_TECHNO_KID.json
msgid "Do you seek power as well?"
msgstr "¿También buscas poder?"

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_TECHNO_KID.json
msgid "Yes, yes… *electrical crackling* Isn't it beautiful?"
msgstr "Sí, sí... * chispas eléctricas * ¿No es hermoso?"

#. ~ NPC dialogue line
#: data/mods/Magiclysm/npc/TALK_TECHNO_KID.json
msgid "I must find more power before I can leave."
msgstr "Debo encontrar más poder antes de poder irme."

#. ~ Name of an NPC class
#: data/mods/Magiclysm/npc/classes.json
msgid "Mage Test"
msgstr "Prueba de Mago"

#. ~ Job description of "Mage Test" NPC class
#: data/mods/Magiclysm/npc/classes.json
msgid "I'm a wandering debug tester for the arcane arts."
msgstr "Soy un testeador de depuración andante para las artes arcanas."

#. ~ Name of an NPC class
#: data/mods/Magiclysm/npc/classes.json
msgid "Master Magus"
msgstr "Maestro Magus"

#. ~ Job description of "Master Magus" NPC class
#: data/mods/Magiclysm/npc/classes.json
msgid "I'm an old Magus.  Get off my lawn!"
msgstr "Soy un viejo Magus. ¡Fuera de mi césped!"

#. ~ Name of an NPC class
#: data/mods/Magiclysm/npc/classes.json
msgid "Techno-student"
msgstr "Tecno-estudiante"

#. ~ Job description of "Techno-student" NPC class
#: data/mods/Magiclysm/npc/classes.json
msgid "I'm searching for more power."
msgstr "Estoy buscando más poder."

#. ~ Name of an NPC class
#: data/mods/Magiclysm/npc/classes.json
msgid "Healer"
msgstr "Sanador"

#. ~ Job description of "Healer" NPC class
#: data/mods/Magiclysm/npc/classes.json
msgid "I will purge this land of its curse."
msgstr "Purgaré esta tierra de su maldición."

#. ~ Name of an NPC class
#: data/mods/Magiclysm/npc/classes.json
msgid "Manatouched Mutant"
msgstr "Mutante Tocado por Maná"

#. ~ Job description of "Manatouched Mutant" NPC class
#: data/mods/Magiclysm/npc/classes.json
msgid ""
"I'm becoming something more than mortal.  I need to find a way off this "
"plane."
msgstr ""
"Me estoy convirtiendo en algo más que mortal. Necesito encontrar una forma "
"de salir de este plano."

#. ~ Name of an NPC class
#: data/mods/Magiclysm/npc/classes.json
msgid "Black Dragon Mutant"
msgstr "Mutante de Dragón Negro"

#. ~ Job description of "Black Dragon Mutant" NPC class
#: data/mods/Magiclysm/npc/classes.json
msgid "I've got the blood of dragons in my veins.  I need more."
msgstr "Tengo la sangre de los dragones en mis venas. Necesito más."

#. ~ NPC faction name
#: data/mods/Magiclysm/npc/factions.json
msgid "The Ancient Ones"
msgstr "Los Antiguos"

#. ~ Description of NPC faction "The Ancient Ones"
#: data/mods/Magiclysm/npc/factions.json
msgid ""
"The spellcrafters of old.  Hidden from the world until the cataclysm, they "
"have their own agenda and care little for you or yours."
msgstr ""
"Los hechiceros de antaño. Escondidos del mundo hasta el cataclismo, tienen "
"su propia agenda y se preocupan poco por ti o por los tuyos."

#. ~ NPC faction name
#: data/mods/Magiclysm/npc/factions.json
msgid "The Grey Flame"
msgstr "La Llama Gris"

#. ~ Description of NPC faction "The Grey Flame"
#: data/mods/Magiclysm/npc/factions.json
msgid ""
"A collection of those cursed by the cataclysm.  They have sworn to rid this "
"world of its curse and will stop at nothing to accomplish their task."
msgstr ""
"Una colección de los malditos por el cataclismo. Han jurado librar a este "
"mundo de su maldición y no se detendrán ante nada para cumplir su tarea."

#. ~ NPC faction name
#: data/mods/Magiclysm/npc/factions.json
msgid "The Forge Lords"
msgstr "Los Señores de la Forja"

#. ~ Description of NPC faction "The Forge Lords"
#: data/mods/Magiclysm/npc/factions.json
msgid ""
"Builders and merchants of magical wonders.  They expect to weather this "
"Cataclysm through trade and innovation.  They will take any coin from any "
"land."
msgstr ""
"Constructores y comerciantes de maravillas mágicas. Esperan capear este "
"Cataclismo mediante el comercio y la innovación. Aceptarán cualquier moneda "
"de cualquier tierra."

#. ~ Mission name
#: data/mods/Magiclysm/npc/missiondef.json
msgid "Retrieve The Tome of The Battle Mage"
msgstr "Recupera el Tomo del Mago de Batalla"

#. ~ Dialogue line in mission "Retrieve The Tome of The Battle Mage"
#: data/mods/Magiclysm/npc/missiondef.json
msgid "Where did I put that blasted…"
msgstr "¿Dónde puse esa maldita..."

#. ~ Dialogue line in mission "Retrieve The Tome of The Battle Mage"
#: data/mods/Magiclysm/npc/missiondef.json
msgid ""
"I seem to have misplaced my book, The Tome of The Battle Mage.  That "
"worthless apprentice probably stole it.  Bring it to me."
msgstr ""
"Parece que he perdido mi libro, El Tomo del Mago de la Batalla. Ese inútil "
"aprendiz probablemente lo robó. Tráemelo."

#. ~ Dialogue line in mission "Retrieve The Tome of The Battle Mage"
#: data/mods/Magiclysm/npc/missiondef.json
msgid "…What?  Oh you're still here.  Go find my book."
msgstr "...¿Qué? Oh, todavía estás aquí. Ve a buscar mi libro."

#. ~ Dialogue line in mission "Retrieve The Tome of The Battle Mage"
#: data/mods/Magiclysm/npc/missiondef.json
msgid "Just as useless as that apprentice…"
msgstr "Tan inútil como ese aprendiz..."

#. ~ Dialogue line in mission "Retrieve The Tome of The Battle Mage"
#: data/mods/Magiclysm/npc/missiondef.json
msgid ""
"You want me to do your job for you?  Bah.  That apprentice said something "
"about wanting to look around town, you might start there.  Oh, and it's "
"called The Tome of The Battle Mage, you can read at least the title, can't "
"you?"
msgstr ""
"¿Quieres que haga tu trabajo por ti? Bah. Ese aprendiz dijo algo sobre "
"querer echar un vistazo a la ciudad, podrías empezar por ahí. Oh, y se llama"
" El Tomo del Mago de la Batalla, puedes leer al menos el título, ¿no?"

#. ~ Dialogue line in mission "Retrieve The Tome of The Battle Mage"
#: data/mods/Magiclysm/npc/missiondef.json
msgid "Where's my book?"
msgstr "¿Dónde está mi libro?"

#. ~ Dialogue line in mission "Retrieve The Tome of The Battle Mage"
#: data/mods/Magiclysm/npc/missiondef.json
msgid "Finally.  Took you long enough."
msgstr "Finalmente. Te tomó bastante tiempo."

#. ~ Dialogue line in mission "Retrieve The Tome of The Battle Mage"
#: data/mods/Magiclysm/npc/missiondef.json
msgid "Nonsense!  Useless!  Waste of my time!"
msgstr "¡Tonterías! ¡Inútil! ¡Una pérdida de tiempo!"

#. ~ Dialogue line in mission "Retrieve The Tome of The Battle Mage"
#: data/mods/Magiclysm/npc/missiondef.json
msgid "Ugh, why am I cursed with useless people?"
msgstr "Ugh, ¿por qué estoy maldito con gente inútil?"

#. ~ Mission name
#: data/mods/Magiclysm/npc/missiondef.json
msgid "Find Power Storage CBM"
msgstr "Encuentra el MBC de Almacenamiento de Energía"

#. ~ Dialogue line in mission "Find Power Storage CBM"
#: data/mods/Magiclysm/npc/missiondef.json
msgid "More power… moar power… MOAR POWAA!"
msgstr "Más poder... más poder... ¡MORE POWER!"

#. ~ Dialogue line in mission "Find Power Storage CBM"
#: data/mods/Magiclysm/npc/missiondef.json
msgid ""
"I need more power.  Find me more power storage and I'll give you this book."
msgstr ""
"Necesito más energía. Encuéntrame más almacenamiento de energía y te daré "
"este libro."

#. ~ Dialogue line in mission "Find Power Storage CBM"
#: data/mods/Magiclysm/npc/missiondef.json
msgid "I don't care where it comes from so long as it's clean."
msgstr "No me importa de dónde venga siempre y cuando esté limpio."

#. ~ Dialogue line in mission "Find Power Storage CBM"
#: data/mods/Magiclysm/npc/missiondef.json
msgid "You want more power too, don't you?"
msgstr "Tú también quieres más poder, ¿no?"

#. ~ Dialogue line in mission "Find Power Storage CBM"
#: data/mods/Magiclysm/npc/missiondef.json
msgid ""
"Electronic Stores might have what I need.  Or you could just cut it out of "
"something."
msgstr ""
"Las tiendas de electrónica podrían tener lo que necesito. O podrías "
"simplemente cortarlo de algo."

#. ~ Dialogue line in mission "Find Power Storage CBM"
#: data/mods/Magiclysm/npc/missiondef.json
msgid "Find anything?"
msgstr "¿Encontraste algo?"

#. ~ Dialogue line in mission "Find Power Storage CBM"
#: data/mods/Magiclysm/npc/missiondef.json
msgid "Perfect.  More power… power…"
msgstr "Perfecto. Más poder... poder..."

#. ~ Dialogue line in mission "Find Power Storage CBM"
#: data/mods/Magiclysm/npc/missiondef.json
msgid "I must find more power, this setback is inconvenient."
msgstr "Debo encontrar más energía, este contratiempo es inconveniente."

#. ~ Mission name
#: data/mods/Magiclysm/npc/missiondef.json
msgid "Kill 50 Zombies"
msgstr "Matar 50 zombis"

#. ~ Dialogue line in mission "Kill 50 Zombies"
#: data/mods/Magiclysm/npc/missiondef.json
msgid "Will you answer the call?"
msgstr "¿Responderás a la llamada?"

#. ~ Dialogue line in mission "Kill 50 Zombies"
#: data/mods/Magiclysm/npc/missiondef.json
msgid ""
"This world has fallen to chaos and death.  Remove 50 of the cursed from this"
" world; assist me in purging this curse and you shall be rewarded."
msgstr ""
"Este mundo ha caído en el caos y la muerte. Quita 50 de los malditos de este"
" mundo; ayúdame a purgar esta maldición y serás recompensado."

#. ~ Dialogue line in mission "Kill 50 Zombies"
#: data/mods/Magiclysm/npc/missiondef.json
msgid ""
"Blessed be.  I shall observe your efforts and judge you as one of the many "
"or one of the few."
msgstr ""
"Bendito seaS. Observaré tus esfuerzos y te juzgaré como uno de los muchos o "
"uno de los pocos."

#. ~ Dialogue line in mission "Kill 50 Zombies"
#: data/mods/Magiclysm/npc/missiondef.json
msgid ""
"You will not help purge this curse?  Perhaps you are a part of the curse…"
msgstr ""
"¿No ayudarás a purgar esta maldición? Tal vez seas parte de la maldición..."

#. ~ Dialogue line in mission "Kill 50 Zombies"
#: data/mods/Magiclysm/npc/missiondef.json
msgid ""
"The awakened congregate in towns and cities, the closer to the center the "
"more you will find."
msgstr ""
"Los despertados se congregan en pueblos y ciudades, cuanto más cerca del "
"centro más se encuentran."

#. ~ Dialogue line in mission "Kill 50 Zombies"
#: data/mods/Magiclysm/npc/missiondef.json
msgid ""
"Blessed be.  You are one of the few.  We shall do great works together."
msgstr ""
"Bendito sea. Eres uno de los pocos. Nosotros haremos grandes obras juntos."

#. ~ Dialogue line in mission "Kill 50 Zombies"
#: data/mods/Magiclysm/npc/missiondef.json
msgid "Deception is the realm of the cursed.  You disappoint me."
msgstr "El engaño es el reino de los malditos. Me decepcionas."

#. ~ Dialogue line in mission "Kill 50 Zombies"
#: data/mods/Magiclysm/npc/missiondef.json
msgid "Was the curse too strong for you?"
msgstr "¿La maldición era demasiado fuerte para ti?"

#. ~ Mission name
#: data/mods/Magiclysm/npc/missiondef.json
msgid "Kill 150 Zombies"
msgstr "Mata 150 Zombis"

#. ~ Dialogue line in mission "Kill 150 Zombies"
#: data/mods/Magiclysm/npc/missiondef.json
msgid ""
"You have proven you are one of the few, will you stand with the few again?"
msgstr ""
"Has demostrado que eres uno de los pocos, ¿volverás a estar con los pocos?"

#. ~ Dialogue line in mission "Kill 150 Zombies"
#: data/mods/Magiclysm/npc/missiondef.json
msgid ""
"We must continue the purge.  Remove 150 more of the cursed from this land "
"and you shall be blessed with greatness."
msgstr ""
"Debemos continuar la purga. Retira a 150 más de los malditos de esta tierra "
"y serás bendecido con la grandeza."

#. ~ Dialogue line in mission "Kill 150 Zombies"
#: data/mods/Magiclysm/npc/missiondef.json
msgid "Blessed be. You are a true testament to the few."
msgstr "Bendito sea. Eres un verdadero testamento para unos pocos."

#. ~ Dialogue line in mission "Kill 150 Zombies"
#: data/mods/Magiclysm/npc/missiondef.json
msgid "I see.  Perhaps you will find your way back to us one day."
msgstr "Ya veo. Tal vez algún día encuentres el camino de regreso a nosotros."

#. ~ Dialogue line in mission "Kill 150 Zombies"
#: data/mods/Magiclysm/npc/missiondef.json
msgid ""
"The awakened stir in even the darkest of corners.  Seek them out and destroy"
" them."
msgstr ""
"El despertar se agita incluso en los rincones más oscuros. Búscalos y "
"destrúyelos."

#. ~ Dialogue line in mission "Kill 150 Zombies"
#: data/mods/Magiclysm/npc/missiondef.json
msgid ""
"Blessed be.  You are a valuable asset to our cause.  Perhaps you may even be"
" our salvation."
msgstr ""
"Bendito seas. Eres un valioso activo para nuestra causa. Tal vez incluso "
"puedas ser nuestra salvación."

#. ~ Dialogue line in mission "Kill 150 Zombies"
#: data/mods/Magiclysm/npc/missiondef.json
msgid "You have come so far.  Only to fall."
msgstr "Has llegado muy lejos. Sólo para caer."

#. ~ Dialogue line in mission "Kill 150 Zombies"
#: data/mods/Magiclysm/npc/missiondef.json
msgid "The curse of this land infects that which does not seek to purge."
msgstr "La maldición de esta tierra infecta lo que no busca purgar."

