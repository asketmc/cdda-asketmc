#: data/json/npcs/other/TALK_NPC_CAMPER.json
#: data/json/npcs/other/TALK_NPC_PREPPER_SURVIVOR.json
#: data/json/npcs/other/TALK_shelter_survivors.json
#: data/json/npcs/other/homeless/TALK_homeless_survivor.json
#: data/json/npcs/other/homeless/group_camp/TALK_homeless_broker.json
#: data/json/npcs/other/homeless/group_camp/TALK_homeless_group_survivors.json
#: data/json/npcs/scrap_trader/scrap_trader.json
#: data/json/npcs/valhalla_cult/TALK_valhallist_gode.json
#: data/json/npcs/valhalla_cult/TALK_valhallist_leader.json
#: data/json/npcs/valhalla_cult/TALK_valhallist_mechanic.json
msgid "Any jobs you need done?"
msgstr "¿Algún trabajo que necesites hacer?"

#. ~ NPC dialogue line
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid ""
"I used to be a chemist.  Well, I am a chemist.  I've been living out here in"
" the wilderness for a little while now since <the_cataclysm>.  Even brought "
"some of my equipment, though unfortunately missing some of the more "
"sensitive and expensive stuff.  I found a couple useful things here in the "
"cupboards, but other than that, entirely empty.  So, I moved in."
msgstr ""
"Yo era químico. Bueno, soy químico. Estuve viviendo en el campo por un "
"tiempo desde  <the_cataclysm>. Incluso me traje parte de mi equipamiento, "
"aunque lamentablemente perdí algunas de las cosas más caras y notables. "
"Encontré un par que me sirven en las alacenas pero más allá de eso, todo "
"vacío. Así que, me mudé aquí."

#. ~ Response to NPC dialogue
#: data/json/npcs/cabin_chemist/chemist_npc.json
#: data/json/npcs/other/homeless/group_camp/TALK_homeless_group_survivors.json
#: data/json/npcs/scrap_trader/scrap_trader.json
msgid "Hmm."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid ""
"Not my place, just somewhere I ended up.  Some old shack, maybe a hunting "
"cabin or something more… criminal, at least judging by some of what I found "
"on the shelves.  You certainly wouldn't attract much attention synthesizing "
"illegal substances all the way out here, that's all I'm saying.  I found it "
"while I was trying to escape all the <zombies> in the city, and I decided to"
" stay."
msgstr ""
"No es mi lugar, solo el sitio en el que terminé. Una choza vieja, tal vez "
"una cabaña de caza o algo más… criminal, por lo menos juzgando por algunas "
"de las cosas que encontré en los estantes. Por supuesto que no atraerías "
"mucha atención sintetizando sustancias ilegales aquí en medio de la nada, a "
"eso me refiero. Lo encontré mientras estaba intentando escapar de los "
"<zombies> de la ciudad, y decidí quedarme."

#. ~ NPC dialogue line
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid ""
"I'm out of some things, <name_g>.  It takes a while to source the good stuff"
" - days usually - but I'm working hard to replace it.  What can I get you in"
" the meantime?"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid ""
"I'll see what I've got around here for you.  I've gotta warn you: it's gonna"
" be expensive.  Hard to stay supplied in the apocalypse, you know.  What do "
"you need?"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid "[10$]  I'll buy some bandages."
msgstr "[10$] Comprare unas vendas."

#. ~ Response to NPC dialogue
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid "[40$]  I'll buy some aspirin."
msgstr "[40$] Comprare unas aspirinas."

#. ~ Response to NPC dialogue
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid "[50$]  I'll buy some sprayable fungicide."
msgstr "[50$] Comprare un poco de fungicida en aerosol."

#. ~ Response to NPC dialogue
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid "[50$]  I'll buy some powder fungicide."
msgstr "[50$] Comprare un poco de fungicida en polvo."

#. ~ Response to NPC dialogue
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid "[50$]  I'll buy some disinfectant."
msgstr "[50$] Comprare un poco de desinfectante."

#. ~ Response to NPC dialogue
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid "[120$]  I'll buy some antibiotics."
msgstr "[120$]  Comprare algunos antibióticos."

#. ~ Response to NPC dialogue
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid "[140$]  I'll buy some antifungal drugs."
msgstr "[140$] Comprare unas drogas antifúngicas."

#. ~ Response to NPC dialogue
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid "[200$]  I'll buy some black gunpowder."
msgstr "[200$] Comprare un poco de pólvora negra."

#. ~ Response to NPC dialogue
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid "[300$]  I'll buy some napalm."
msgstr "[300$] Comprare un poco de napalm."

#. ~ NPC dialogue line
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid "Is there anything else you need?"
msgstr "¿Necesitas algo más?"

#. ~ Response to NPC dialogue
#: data/json/npcs/cabin_chemist/chemist_npc.json
#: data/json/npcs/lumbermill_employees/TALK_lumbermill_fabricate.json
#: data/json/npcs/scrap_trader/scrap_trader.json
msgid "No, that's all."
msgstr "No, nada más."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "No, just <swear> no…"
msgstr "No,  un<swear> no"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Just let me sleep, <name_b>!"
msgstr "¡Déjame dormir, <name_b>!"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Make it quick, I want to go back to sleep."
msgstr "Hazlo rápido, quiero irme a dormir."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Just few minutes more…"
msgstr "Sólo unos minutos más..."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Anything to do before I go to sleep?"
msgstr "¿Algo para hacer antes de que me vaya a dormir?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Wake up!"
msgstr "¡Despierta!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Go back to sleep."
msgstr "Vuelve a dormir."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid ""
"This character was previously put into a suspension state due to an AI bug."
"  If you have reason to believe the problem was fixed, you can wake them up."
"  Do you want to do that now?"
msgstr ""
"Este personaje fue puesto previamente en estado de suspensión debido a un "
"fallo de la IA. Si tienes razones para creer que el problema se arregló, "
"puedes despertarlos. ¿Quieres hacerlo ahora?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "yes, wake up!"
msgstr "Sí, ¡despiertalo!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "no, go back to sleep."
msgstr "No, vuelve a dormirte."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid " *pshhhttt* I'm reading you boss, over."
msgstr "*pshhhttt* Te estoy oyendo jefe, cambio."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "What is it, friend?"
msgstr "¿Qué pasa, amigo?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "I want to give you some commands for combat."
msgstr "Quiero darte algunas órdenes para el combate."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "I want to set some miscellaneous rules."
msgstr "Quiero establecer algunas reglas complementarias."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "I'd like to know a bit more about your abilities."
msgstr "Me gustaría saber un poco más sobre tus habilidades."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "There's something I want you to do."
msgstr "Hay algo que quiero que hagas."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "I just wanted to talk for a bit."
msgstr "Sólo quería hablar un poco."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Can you help me understand something?  (HELP/TUTORIAL)"
msgstr "¿Puedes ayudarme a entender algo? (AYUDA/TUTORIAL)"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "I'm going to go my own way for a while."
msgstr "Voy a seguir mi propio camino por un tiempo."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid ""
" *tshk* Are you serious?  This isn't a cell phone.  Can it wait until we're "
"in the same place?"
msgstr ""
" *tshk* ¿Hablas en serio? Esto no es un teléfono móvil. ¿Puede esperar hasta"
" que estemos en el mismo lugar?"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Sure, what did you want to say?"
msgstr "Claro, ¿qué querías decir?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Mind if we just chat for a bit about your history?"
msgstr "¿Te importa si charlamos un poco sobre tu historia?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Let's just chitchat for a while, I could use some relaxation."
msgstr "Vamos a charlar un rato, me vendría bien un poco de relajación."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "I changed my mind, wanted to ask you something else."
msgstr "He cambiado de opinión, quería preguntarte algo más."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "I'm all ears, my friend."
msgstr "Soy todo oídos, amigo."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "You gonna give me orders?"
msgstr "¿Me vas a dar órdenes?"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "What would you like?"
msgstr "¿Qué te gustaría?"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Just say the word."
msgstr "Sólo tienes que decir la palabra."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
#: data/json/npcs/godco/NPC_Olwen_Powell.json
msgid "Can you teach me anything?"
msgstr "¿Me puedes enseñar algo?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Can you host a training seminar?"
msgstr "¿Puedes organizar un seminario de formación?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "I have something to teach you."
msgstr "Tengo algo que enseñarte."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Let's trade items"
msgstr "Intercambiemos artículos"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Hold on to this item."
msgstr "Guarda este objeto."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Guard this position."
msgstr "Protege esta posición."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Find a horse and mount up!"
msgstr "¡Busca un caballo y montalo!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Drop off any items you're not using."
msgstr "Soltar cualquier objeto que no estes usando."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Get off your mount, please."
msgstr "Bájate de su montura, por favor."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Let's talk about your current activity."
msgstr "Hablemos de tu actividad actual."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Let's talk about the camp."
msgstr "Hablemos del campamento."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "*will not engage enemies."
msgstr "* no se enfrentará a los enemigos."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "*will engage nearby enemies."
msgstr "* se enfrentará a los enemigos cercanos."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "*will engage weak enemies."
msgstr "* se enfrentará a enemigos débiles."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "*will engage enemies you attack."
msgstr "* se enfrentará a los enemigos que ataque."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "*will engage distant enemies without moving."
msgstr "* se enfrentará a enemigos distantes sin moverse."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "*will engage enemies close enough to attack without moving."
msgstr ""
"* se enfrentará a los enemigos que esten lo suficientement cerca como para "
"atacar sin moverse."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "*will engage all enemies."
msgstr "* se enfrentará a todos los enemigos."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "  OVERRIDE: "
msgstr "ANULAR: "

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
#: data/mods/Aftershock/npcs/Backgrounds/BGBR_Sadie.json
msgid "  "
msgstr " "

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "  What should <mypronoun> do?"
msgstr "¿Qué debería <mypronoun> hacer?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Change your engagement rules…"
msgstr "Cambia sus reglas de combate..."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Change your aiming rules…"
msgstr "Cambie tus reglas de puntería..."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Change your bionic power reserve rules…"
msgstr "Cambia tus reglas de reserva de energía biónica..."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Change your bionic power recharge rules…"
