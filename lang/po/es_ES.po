#. ~ Item name
#: data/json/items/tool/tailoring.json
msgid "bone sewing awl"
msgid_plural "bone sewing awls"
msgstr[0] "punzón para coser huesos"
msgstr[1] "punzones para coser huesos"
msgstr[2] "punzones para coser huesos"

#. ~ Description of "bone sewing awl"
#: data/json/items/tool/tailoring.json
msgid ""
"This is a crude sharpened bone awl; those were used for leatherworking "
"before metal was discovered.  It can also serve as an improvised stabbing "
"weapon, but will break quickly."
msgstr ""
"Este es un punzón de hueso crudo y afilado; esos se usaban para la peletería"
" antes de que se descubriera el metal. También puede servir como un arma "
"improvisada para apuñalar, pero se romperá rápidamente."

#. ~ Item name
#: data/json/items/tool/tailoring.json
msgid "steel sewing awl"
msgid_plural "steel sewing awls"
msgstr[0] "punzón de acero para coser"
msgstr[1] "punzones de acero para coser"
msgstr[2] "punzones de acero para coser"

#. ~ Description of "steel sewing awl"
#: data/json/items/tool/tailoring.json
msgid ""
"This is a steel awl with a wooden grip, usually used for leatherworking.  It"
" can also serve as an improvised stabbing weapon, but will break quickly."
msgstr ""
"Este es un punzón de acero con un mango de madera, generalmente usado en la "
"peletería. También puede servir como un arma improvisada para apuñalar, pero"
" se romperá rápidamente."

#. ~ Item name
#: data/json/items/tool/tailoring.json
msgid "knitting needles"
msgid_plural "pairs of knitting needles"
msgstr[0] "agujas de tejer"
msgstr[1] "pares de agujas de tejer"
msgstr[2] "pares de agujas de tejer"

#. ~ Description of "knitting needles"
#: data/json/items/tool/tailoring.json
msgid ""
"A pair of stout wooden needles with round ends used to turn thread and yarn "
"into cloth."
msgstr ""
"Es un par de agujas fuertes de madera con punta redonda, usadas para "
"convertir el hilo en tela."

#. ~ Item name
#: data/json/items/tool/tailoring.json
msgid "frame loom"
msgid_plural "frame looms"
msgstr[0] "telar de bastidor"
msgstr[1] "telares de bastidor"
msgstr[2] "telares de bastidor"

#. ~ Description of "frame loom"
#: data/json/items/tool/tailoring.json
msgid ""
"This is a rather bulky and primitive wooden frame which can be used to weave"
" cloth sheets.  It is very slow, though."
msgstr ""
"Esta es una estructura de madera bastante voluminoso y primitivo que puede "
"ser utilizado para tejer hojas de tela. Sin embargo, es muy lento."

#. ~ Item name
#: data/json/items/tool/tailoring.json
msgid "bone needle"
msgid_plural "bone needles"
msgstr[0] "aguja de hueso"
msgstr[1] "agujas de hueso"
msgstr[2] "agujas de hueso"

#. ~ Description of "bone needle"
#: data/json/items/tool/tailoring.json
msgid ""
"This is a sharp needle made from a bone.  It would be useful for making "
"rough clothing and items.  Its low quality makes it rather unsuitable for "
"anything requiring speed or precision."
msgstr ""
"Esto es una aguja afilada hecha de hueso. Es útil para confeccionar ropa y "
"otros objetos simples. Pero su baja calidad la hace poco adecuada para "
"trabajos que requieran velocidad o precisión."

#. ~ Description of "curved needle"
#: data/json/items/tool/tailoring.json
msgid ""
"A curved sharp needle made of steel.  Its rounded shape allows it to make "
"stitches that only pierce one side of the material.  While unsuitable for "
"most tailoring projects, it's a necessity for stitching neoprene."
msgstr ""
"Una aguja curva y afilada hecha de acero. Su forma redondeada permite hacer "
"puntos que solo perforan un lado del material. Aunque no es adecuada para "
"muchas tareas de sastrería, es necesaria para coser neopreno."

#. ~ Item name
#: data/json/items/tool/tailoring.json
msgid "wooden needle"
msgid_plural "wooden needles"
msgstr[0] "aguja de madera"
msgstr[1] "agujas de madera"
msgstr[2] "agujas de madera"

#. ~ Description of "wooden needle"
#: data/json/items/tool/tailoring.json
msgid ""
"This is a wooden needle whittled down to a sharp point.  It has a narrow "
"hole carved into the head for threading.  Its low quality makes it rather "
"unsuitable for anything requiring speed or precision, or involving tougher "
"materials like Kevlar."
msgstr ""
"Esta es una aguja de madera tallada en una punta afilada. Tiene un estrecho "
"agujero tallado en la cabeza para enhebrar. Su baja calidad la hace bastante"
" inadecuada para cualquier cosa que requiera velocidad o precisión, o que "
"implique materiales más duros como el Kevlar."

#. ~ Item name
#: data/json/items/tool/tailoring.json
msgid "needle"
msgid_plural "needles"
msgstr[0] "aguja"
msgstr[1] "agujas"
msgstr[2] "agujas"

#. ~ Description of "needle"
#: data/json/items/tool/tailoring.json
msgid ""
"This is a stainless steel needle.  It would be useful for making clothing "
"and items."
msgstr ""
"Una aguja afilada hecha de acero. Seria útil para confeccionar ropa y otros "
"objetos."

#. ~ Item name
#: data/json/items/tool/tailoring.json data/mods/Magiclysm/items/tools.json
#: data/mods/innawood/items/tool_tailoring.json
msgid "sewing kit"
msgid_plural "sewing kits"
msgstr[0] "costurero"
msgstr[1] "costureros"
msgstr[2] "costureros"

#. ~ Description of "sewing kit"
#: data/json/items/tool/tailoring.json
msgid ""
"This is a plastic kit with a variety of needles, some plastic spools for "
"thread, small scissors, and a few other useful textile tools.  Use a sewing "
"kit on an article of clothing to attempt to repair or reinforce that "
"clothing.  This uses your tailoring skill."
msgstr ""
"Este es un kit de plástico con diversas agujas, algunas bobinas de plástico "
"para el hilo, pequeñas tijeras y algunas otras herramientas textiles útiles."
" Utiliza un costurero en una prenda de vestir para intentar reparar o "
"reforzar dicha prenda. Y al hacerlo estarás usando tu habilidad Sastrería."

#. ~ Item name
#: data/json/items/tool/tailoring.json
msgid "wooden shed stick"
msgid_plural "wooden shed sticks"
msgstr[0] "palos de madera de tejer"
msgstr[1] "palos de madera de tejer"
msgstr[2] "palos de madera de tejer"

#. ~ Description of "wooden shed stick"
#: data/json/items/tool/tailoring.json
msgid ""
"This is a short thin flat wooden stick, used as a tool while weaving cloth "
"with a frame loom."
msgstr ""
"Este es un palo corto y plano de madera, usado como herramienta mientras se "
"teje la tela con un telar de bastidor."

#. ~ Item name
#: data/json/items/tool/tailoring.json
msgid "tanning leather hide"
msgid_plural "tanning leather hides"
msgstr[0] "pellejo de cuero curtiéndose"
msgstr[1] "pellejos de cuero curtiéndose"
msgstr[2] "pellejos de cuero curtiéndose"

#. ~ Description of "tanning leather hide"
#: data/json/items/tool/tailoring.json
msgid ""
"A treated animal hide which is undergoing the chemical processes required to"
" become leather.  You will be able to activate it to unroll and make use of "
"it when it is done."
msgstr ""
"El pellejo tratado de un animal que está en pleno proceso químico requerido "
"para convertirse en cuero. Podrás activarlo para desenrollarlo y usarlo "
"cuando termine el proceso."

#. ~ "msg" action message of item "tanning leather hide"
#: data/json/items/tool/tailoring.json
msgid "You carefully unfold the tanning leather hide and shake it clean."
msgstr ""
"Cuidadosamente, desdoblas el pellejo que está curtiéndose y lo sacudes para "
"limpiarlo."

#. ~ "not_ready_msg" action message of item "tanning leather hide"
#: data/json/items/tool/tailoring.json
msgid "The tanning leather hide isn't done yet."
msgstr "El pellejo todavía no terminó el proceso de curtido."

#. ~ Item name
#: data/json/items/tool/tailoring.json
msgid "tanning fur pelt"
msgid_plural "tanning fur pelts"
msgstr[0] "pelaje curándose"
msgstr[1] "pelajes curándose"
msgstr[2] "pelajes curándose"

#. ~ Description of "tanning fur pelt"
#: data/json/items/tool/tailoring.json
msgid ""
"A treated animal pelt which is undergoing the chemical processes required to"
" become fur.  You will be able to activate it to unroll and make use of it "
"when it is done."
msgstr ""
"El pelaje tratado de un animal que está en pleno proceso químico que "
"necesita para convertirse en piel. Vas a poder activarlo para desenrollarlo "
"y usarlo cuando termine el proceso."

#. ~ "msg" action message of item "tanning fur pelt"
#: data/json/items/tool/tailoring.json
msgid "You carefully unfold the tanning fur pelt and shake it clean."
msgstr ""
"Cuidadosamente, desdoblas el pelaje que está curándose y lo sacudes para "
"limpiarlo."

#. ~ "not_ready_msg" action message of item "tanning fur pelt"
#: data/json/items/tool/tailoring.json
msgid "The tanning fur pelt isn't done yet."
msgstr "El pelaje todavía no terminó el proceso de curado."

#. ~ Item name
#: data/json/items/tool/tailoring.json
msgid "tailoring pattern set"
msgid_plural "tailoring pattern sets"
msgstr[0] "conjunto de patrones de tejidos"
msgstr[1] "conjuntoñ de patrones de tejidos"
msgstr[2] "conjuntoñ de patrones de tejidos"

#. ~ Description of "tailoring pattern set"
#: data/json/items/tool/tailoring.json
msgid ""
"This is a large set of tailoring patterns made from paper.  They're useful "
"for making any kind of cloth or leather items from scratch, but are "
"necessary for more advanced projects."
msgstr ""
"Este es un gran conjunto de patrones de confección hechos de papel. Son "
"útiles para hacer cualquier tipo de tela o artículos de cuero desde cero, "
"pero son necesarios para proyectos más avanzados."

#. ~ Item name
#: data/json/items/tool/tailoring.json
#: data/mods/innawood/items/tool_tailoring.json
msgid "pair of Kevlar shears"
msgid_plural "pairs of Kevlar shears"
msgstr[0] "par de tijeras para Kevlar"
msgstr[1] "pares de tijeras para Kevlar"
msgstr[2] "pares de tijeras para Kevlar"

#. ~ Description of "pair of Kevlar shears"
#: data/json/items/tool/tailoring.json
#: data/mods/innawood/items/tool_tailoring.json
msgid ""
"These are a pair of heavy-duty shears with a blade suitable for cutting "
"particularly tough materials, from polyaramid fabrics to tough plastics and "
"thin metals.  The blades feature a flat shearing edge and a fine serration."
msgstr ""
"Estas son un par de cizallas para trabajos pesados con una hoja adecuada "
"para cortar materiales especialmente resistentes, desde tejidos de "
"poliacrilamida hasta plásticos resistentes y metales finos. Las hojas tienen"
" un filo de corte plano y un fino dentado."

#. ~ Based roughly off an Ashford E-Spinner 3 because that was the first thing
#. I looked at.
#. ~ Item name
#: data/json/items/tool/tailoring.json
msgid "electric spinwheel"
msgid_plural "electric spinwheels"
msgstr[0] "hiladora eléctrica"
msgstr[1] "hiladoras eléctricas"
msgstr[2] "hiladoras eléctricas"

#. ~ Based roughly off an Ashford E-Spinner 3 because that was the first thing
#. I looked at.
#. ~ Description of "electric spinwheel"
#: data/json/items/tool/tailoring.json
msgid ""
"A spinning wheel is a device for spinning thread or yarn from fibres.  This "
"particular model is electrically-powered and easily portable."
msgstr ""
"Una madeja giratoria es un dispositivo capaz de deshilachar fibras para "
"producir hilo o lana.  Este modelo en particular es eléctrico y fácil de "
"transportar."

#. ~ Item name
#: data/json/items/tool/tailoring.json data/mods/Magiclysm/items/tools.json
#: data/mods/innawood/items/tool_tailoring.json
msgid "tailor's kit"
msgid_plural "tailor's kits"
msgstr[0] "equipo de sastre"
msgstr[1] "equipos de sastre"
msgstr[2] "equipos de sastre"

#. ~ Description of "tailor's kit"
#: data/json/items/tool/tailoring.json
msgid ""
"This is a high quality kit consisting of a variety of needles, some plastic "
"spools for thread, scissors and shears, and an awl.  Use a tailor's kit to "
"customize your clothing and armor.  This uses your tailoring skill."
msgstr ""
"Un equipo de muy buena calidad con una variedad de agujas, algunos carretes "
"plásticos de hilo, tijeras normales, tijeras para esquilar y un punzón.  "
"Puedes usar el equipo de sastre para personalizar tu ropa y armadura.  Esto "
"utiliza tu habilidad de sastrería."

#. ~ Item name
#: data/json/items/tool/toiletries.json
msgid "bathroom scale"
msgid_plural "bathroom scales"
msgstr[0] "báscula de baño"
msgstr[1] "básculas de baño"
msgstr[2] "básculas de baño"

#. ~ Description of "bathroom scale"
#: data/json/items/tool/toiletries.json
msgid "This is a small bathroom scale, meant to weigh a person while naked."
msgstr ""
"Esta es una pequeña báscula de baño, destinada a pesar a una persona "
"mientras está desnuda."

#. ~ Item name
#: data/json/items/tool/toiletries.json
msgid "scrub brush"
msgid_plural "scrub brushes"
msgstr[0] "cepillo de fregar"
msgstr[1] "cepillos de fregar"
msgstr[2] "cepillos de fregar"

#. ~ Description of "scrub brush"
#: data/json/items/tool/toiletries.json
msgid "This is a simple scrub brush."
msgstr "Es un simple cepillo de fregar."

#. ~ Item name
#: data/json/items/tool/toiletries.json
msgid "dish towel"
msgid_plural "dish towels"
msgstr[0] "paño de cocina"
msgstr[1] "paños de cocina"
msgstr[2] "paños de cocina"

#. ~ Description of "dish towel"
#: data/json/items/tool/toiletries.json
msgid "This is a dish towel, useful for cleaning hard surfaces."
msgstr "Se trata de un paño de cocina, útil para limpiar superficies duras."

#. ~ Snippet of item "dish towel"
#: data/json/items/tool/toiletries.json
msgid ""
"An elegant, monogrammed dish towel.  Unfortunately, they aren't your "
"initials."
msgstr ""
"Un elegante paño de cocina con monograma. Desgraciadamente, no son tus "
"iniciales."

#. ~ Snippet of item "dish towel"
#: data/json/items/tool/toiletries.json
msgid "An elegant, monogrammed dish towel.  It even has your initials!"
msgstr ""
"Un elegante paño de cocina con monograma. Incluso tiene tus iniciales."

#. ~ Snippet of item "dish towel"
#: data/json/items/tool/toiletries.json
msgid "A well used dish towel, judging by the stains."
msgstr "Un paño de cocina bien usado, a juzgar por las manchas."

#. ~ Snippet of item "dish towel"
#: data/json/items/tool/toiletries.json
msgid ""
"A novelty dish towel, featuring a popular children's cartoon character."
msgstr ""
"Un novedoso paño de cocina con un popular personaje de dibujos animados para"
" niños."

#. ~ Snippet of item "dish towel"
#: data/json/items/tool/toiletries.json
msgid "A novelty dish towel which reads \"IT'S WINE O CLOCK\"."
msgstr "Un novedoso paño de cocina que dice \"SON LAS VINO EN PUNTO\"."

#. ~ Snippet of item "dish towel"
#: data/json/items/tool/toiletries.json
msgid "A dish towel with a floral pattern."
msgstr "Un paño de cocina con motivos florales."

#. ~ Snippet of item "dish towel"
#: data/json/items/tool/toiletries.json
msgid "A dish towel with a gingham pattern."
msgstr "Un paño de cocina con estampado gingham."

#. ~ Snippet of item "dish towel"
#: data/json/items/tool/toiletries.json
msgid "A dish towel with a cat pattern."
msgstr "Un paño de cocina con un patrón de gatos."

#. ~ Item name
#: data/json/items/tool/toiletries.json
msgid "electric hair trimmer"
msgid_plural "electric hair trimmers"
msgstr[0] "cortadora eléctrica de pelo"
msgstr[1] "cortadoras eléctricas de pelo"
msgstr[2] "cortadoras eléctricas de pelo"

#. ~ Description of "electric hair trimmer"
#: data/json/items/tool/toiletries.json
msgid ""
"This is a pocket-sized electric trimmer made for cutting hair.  You can use "
"it to cut your hair if it's supplied with batteries.  It requires 10 units "
"of charge per use."
msgstr ""
"Se trata de una maquinilla eléctrica de bolsillo para cortar el pelo. Puedes"
" utilizarla para cortar el pelo si tiene batería. Requiere 10 unidades de "
"carga por uso."

#. ~ Item name
#: data/json/items/tool/toiletries.json
msgid "mop"
msgid_plural "mops"
msgstr[0] "fregona"
msgstr[1] "fregonas"
msgstr[2] "fregonas"

#. ~ Description of "mop"
#: data/json/items/tool/toiletries.json
msgid ""
"This is an unwieldy mop.  Good for cleaning up spills.  Use to mop up any "
"'mess' you may have made."
msgstr ""
"Esta una fregona difícil de manejar. Útil para limpiar derrames líquidos. "
"Úsala para limpiar cualquier charco que hayas hecho."

#. ~ Item name
#: data/json/items/tool/toiletries.json
msgid "collapsible mop"
msgid_plural "collapsible mops"
msgstr[0] "fregona plegable"
msgstr[1] "fregonas plegables"
msgstr[2] "fregonas plegables"

#. ~ Description of "collapsible mop"
#: data/json/items/tool/toiletries.json
msgid ""
"A long unwieldy mop with a collapsible handle for convenient transportation."
"  You may use it to clean up any 'mess' you have made."
msgstr ""
"Una fregona pesada con un mango plegable para facilitar el transporte. "
"Puedes usarla para limpiar cualquier 'lio' que hayas cometido."

#. ~ This is much, much bigger than it should be.
#. ~ Item name
#: data/json/items/tool/toiletries.json
msgid "rag"
msgid_plural "rags"
msgstr[0] "trapo"
msgstr[1] "trapos"
msgstr[2] "trapos"

#. ~ This is much, much bigger than it should be.
#. ~ Description of "rag"
#: data/json/items/tool/toiletries.json
msgid ""
"This is a largish piece of cloth, useful in crafting and possibly for "
"staunching bleeding."
msgstr ""
"Esto es una larga pieza de tela, útil para la fabricación y posiblemente "
"para detener sangrados."

#. ~ This is calculated from medium weight cotton at 203 GSM, with a size of 6
#. inches square
#. ~ Item name
#: data/json/items/tool/toiletries.json
msgid "cotton patch"
msgid_plural "cotton patches"
msgstr[0] "parche de algodón"
msgstr[1] "parches de algodón"
msgstr[2] "parches de algodón"

#. ~ This is calculated from medium weight cotton at 203 GSM, with a size of 6
#. inches square
#. ~ Description of "cotton patch"
#: data/json/items/tool/toiletries.json
msgid ""
"A 6 inch square cotton patch, suitable for use in repairing and tailoring of"
" clothing."
msgstr ""
"Un parche de algodón cuadrado, perfecto para reparar ropa y sastrería."

#. ~ Item name
#: data/json/items/tool/toiletries.json
msgid "razor blade"
msgid_plural "razor blades"
msgstr[0] "hojita de afeitar"
msgstr[1] "hojitas de afeitar"
msgstr[2] "hojitas de afeitar"

#. ~ Description of "razor blade"
#: data/json/items/tool/toiletries.json
msgid "A double-edged razor blade."
msgstr "Una cuchilla de doble filo."

#. ~ Item name
#: data/json/items/tool/toiletries.json
msgid "shaving kit"
msgid_plural "shaving kits"
msgstr[0] "equipo de afeitar"
msgstr[1] "equipos de afeitar"
msgstr[2] "equipos de afeitar"

#. ~ Description of "shaving kit"
#: data/json/items/tool/toiletries.json
msgid ""
"This is a compact and lightweight shaving kit made for travelers.  You can "
"use it to shave if it's supplied with soap.  It requires 1 unit of soap per "
"use."
msgstr ""
"Es un equipo de afeitar compacto y liviano hecho para los que viajan. Lo "
"puedes usar para afeitarte si se le agrega jabón. Necesita 1 unidad de jabón"
" por uso."

#. ~ Item name
#: data/json/items/tool/toiletries.json
msgid "sponge"
msgid_plural "sponges"
msgstr[0] "esponja"
msgstr[1] "esponjas"
msgstr[2] "esponjas"

#. ~ Description of "sponge"
#: data/json/items/tool/toiletries.json
msgid ""
"A sponge is a tool or cleaning aid made of soft, porous material.  Typically"
" used for cleaning impervious surfaces."
msgstr ""
"Una esponja es una herramienta o ayuda de limpieza hecha de material suave y"
" poroso. Típicamente utilizada para limpiar superficies impermeables."

#. ~ Snippet of item "sponge"
#: data/json/items/tool/toiletries.json
msgid "A round smiley face sponge."
msgstr "Una esponja redonda con cara sonriente."

#. ~ Snippet of item "sponge"
#: data/json/items/tool/toiletries.json
msgid "A rectangular sponge with a green abrasive back."
msgstr "Es una esponja rectangular con el reverso verde y abrasivo."

#. ~ Snippet of item "sponge"
#: data/json/items/tool/toiletries.json
msgid "A natural sea sponge.  It looks kind of lumpy."
msgstr "Una esponja marina natural. Parece un poco abultada."

#. ~ Snippet of item "sponge"
#: data/json/items/tool/toiletries.json
msgid "A dolphin shaped sponge.  It looks at home in the water."
msgstr "Una esponja con forma de delfín. Parece estar en casa en el agua."

#. ~ Snippet of item "sponge"
#: data/json/items/tool/toiletries.json
msgid "A rectangular sponge."
msgstr "Una esponja rectangular."

#. ~ Snippet of item "sponge"
#: data/json/items/tool/toiletries.json
msgid "A sponge cake shaped sponge, the abrasive pad looks like frosting."
msgstr ""
"Una esponja con forma de bizcocho, la almohadilla abrasiva parece un "
"glaseado."

#. ~ Snippet of item "sponge"
#: data/json/items/tool/toiletries.json
msgid ""
"A sponge in the shape of a beloved character from a children's cartoon."
msgstr ""
"Una esponja con la forma de un entrañable personaje de dibujos animados para"
" niños."

#. ~ Snippet of item "sponge"
#: data/json/items/tool/toiletries.json
msgid "A cat shaped sponge."
msgstr "Una esponja con forma de gato."

#. ~ Item name
#: data/json/items/tool/toiletries.json
msgid "makeshift haircut kit"
msgid_plural "makeshift haircut kits"
msgstr[0] "equipo improvisado cortapelo"
msgstr[1] "equipos improvisados cortapelo"
msgstr[2] "equipos improvisados cortapelo"

#. ~ Description of "makeshift haircut kit"
#: data/json/items/tool/toiletries.json
msgid "This is a kit with tools for cutting hair."
msgstr "Es un equipo con herramientas para cortar el pelo."

#. ~ Item name
#: data/json/items/tool/toiletries.json
msgid "makeshift shaving kit"
msgid_plural "makeshift shaving kits"
msgstr[0] "equipo improvisado de afeitar"
msgstr[1] "equipos improvisados de afeitar"
msgstr[2] "equipos improvisados de afeitar"

#. ~ Description of "makeshift shaving kit"
#: data/json/items/tool/toiletries.json
msgid ""
"This is a makeshift shaving kit.  You can use it to shave if it's supplied "
"with soap.  It requires 1 unit of soap per use."
msgstr ""
"Es un equipo de afeitar improvisado. Lo puedes usar para afeitarte si se le "
"agrega jabón. Necesita 1 unidad de jabón por uso."

#. ~ Item name
#: data/json/items/tool/toiletries.json
msgid "washboard"
msgid_plural "washboards"
msgstr[0] "tabla de lavar"
msgstr[1] "tablas de lavar"
msgstr[2] "tablas de lavar"

#. ~ Description of "washboard"
#: data/json/items/tool/toiletries.json
msgid ""
"This is a wooden washboard.  You can use it to wash filthy clothing if it's "
"supplied with cleansing agent."
msgstr ""
"Esta es una tabla de madera para lavar. La puedes usar para lavar la ropa "
"sucia si tienes algún tipo de producto de limpieza"

#. ~ Item name
#: data/json/items/tool/toiletries.json
msgid "washing kit"
msgid_plural "washing kits"
msgstr[0] "kit de lavado"
msgstr[1] "kits de lavado"
msgstr[2] "kits de lavado"

#. ~ Description of "washing kit"
#: data/json/items/tool/toiletries.json
msgid ""
"A combination kit of a washboard and a scrubbing tool.  Everything you need "
"to clean items after the apocalypse."
msgstr ""
"Un kit de combinación de una tabla de lavar y una herramienta de fregar. "
"Todo lo que necesitas para limpiar los artículos después del apocalipsis."

#. ~ Description of "bear trap"
#: data/json/items/tool/traps.json
msgid ""
"This is a spring-loaded pair of steel jaws connected to a sensitive pressure"
" plate.  Use it to set it on the ground, creating a trap that will ensnare "
"and damage anything that steps on it.  If you are carrying a shovel, you "
"will have the option of burying it."
msgstr ""
"Es como una mandíbula de acero conectada a una placa de presión sensitiva. "
"Usala para ponerla en el suelo, creando una trampa que va a capturar y dañar"
" cualquier cosa que la pise. Si tienes una pala, vas a tener la opción de "
"enterrarla."

#. ~ "bury_question" action message of item "bear trap"
#: data/json/items/tool/traps.json
msgid "Bury the beartrap?"
msgstr "¿Quieres enterrar la trampa para oso?"

#. ~ "done_message" action message of item "bear trap"
#: data/json/items/tool/traps.json
msgid "You set the beartrap."
msgstr "Pones la trampa para osos."

#. ~ "done_message" action message of item "bear trap"
#: data/json/items/tool/traps.json
msgid "You bury the beartrap."
msgstr "Entierras la trampa para osos."

#. ~ Item name
#: data/json/items/tool/traps.json
msgid "blade trap"
msgid_plural "blade traps"
msgstr[0] "trampa de cuchilla"
msgstr[1] "trampas de cuchilla"
msgstr[2] "trampas de cuchilla"

#. ~ Description of "blade trap"
#: data/json/items/tool/traps.json
msgid ""
"This is a machete attached laterally to a motor, with a tripwire controlling"
" its throttle.  When the tripwire is pulled, the blade is swung around with "
"great force.  The trap forms a 3x3 area of effect."
msgstr ""
"Es un machete agregado al costado de un motor, con una cuerda controlando su"
" acelerador. Cuando se tira de la cuerda, la cuchilla se mueve con mucha "
"fuerza. La trampa tiene un área de efecto de 3x3."

#. ~ "done_message" action message of item "blade trap"
#: data/json/items/tool/traps.json
msgid "You set the blade trap 2 squares away."
msgstr "Colocas la trampa de cuchillas a 2 espacios de distancia."

#. ~ Item name
#: data/json/items/tool/traps.json
msgid "nailboard trap"
msgid_plural "nailboard traps"
msgstr[0] "trampa de tabla con clavos"
msgstr[1] "trampas de tabla con clavos"
msgstr[2] "trampas de tabla con clavos"

#. ~ Description of "nailboard trap"
#: data/json/items/tool/traps.json
msgid ""
"These are several pieces of wood nailed together, with some nails sticking "
"straight up.  If an unsuspecting victim steps on it, they'll get nails "
"through the foot."
msgstr ""
"Estas son varias piezas de madera clavadas juntos, con algunos clavos que "
"sobresalen por arriba. Si una víctima desprevenida la pisa, se va a ensartar"
" los clavos en el pie."

#. ~ "done_message" action message of item "nailboard trap"
#: data/json/items/tool/traps.json
#, c-format
msgid "You set the board trap on the %s, nails facing up."
msgstr "Pones la trampa de tablas en el %s, clavos hacia arriba."

#. ~ Description of "booby trap"
#: data/json/items/tool/traps.json
msgid ""
"This is a crude explosive device triggered by a piece of string.  Use it to "
"set up and watch some poor bastard trigger it."
msgstr ""
"Este es un crudo dispositivo explosivo disparado por un trozo de cuerda. "
"Úsalo para montarlo y ver cómo lo activa algún pobre bastardo."

#. ~ "done_message" action message of item "booby trap"
#: data/json/items/tool/traps.json
msgid "You set the booby trap up and activate the grenade."
msgstr "Pones la trampa bomba y activas la granada."

#. ~ Description of "bubble wrap"
#: data/json/items/tool/traps.json
msgid ""
"This is a sheet of plastic covered with air-filled bubbles.  Use it to set "
"it on the ground, creating a trap that will warn you with noise when "
"something steps on it."
msgstr ""
"Es una lámina de plástico cubierta con burbujas de aire. Úsala para ponerlo "
"en el suelo, creando una trampa que te advertirá con el ruido si alguien la "
"pisa."

#. ~ "done_message" action message of item "bubble wrap"
#: data/json/items/tool/traps.json
msgid "You set the bubble wrap on the ground, ready to be popped."
msgstr ""
"Pones el plástico de burbuja en el suelo, listo para que alguien lo pise."

#. ~ Item name
#: data/json/items/tool/traps.json
msgid "loose caltrops"
msgid_plural "loose caltrops"
msgstr[0] "abrojo metálico sueltos"
msgstr[1] "abrojos metálicos sueltos"
msgstr[2] "abrojos metálicos sueltos"

#. ~ Description of "loose caltrops"
#: data/json/items/tool/traps.json
msgid ""
"These are small metal objects covered with many sharp points.  If an "
"unsuspecting victim steps on one, they'll get a spine through the foot."
msgstr ""
"Son unos pequeños objetos de metal cubiertos con muchas puntas afiladas. Si "
"una víctima desprevenida los pisa, se van a llevar una púa atravesándole el "
"pie."

#. ~ "done_message" action message of item "loose caltrops"
#: data/json/items/tool/traps.json
#, c-format
msgid "You scatter the caltrops on the %s."
msgstr "Desparramas los abrojos metálicos en el %s."

#. ~ Item name
#: data/json/items/tool/traps.json
msgid "loose glass caltrops"
msgid_plural "loose glass caltrops"
msgstr[0] "abrojos de vidrio suelto"
msgstr[1] "abrojos de vidrio suelto"
msgstr[2] "abrojos de vidrio suelto"

#. ~ Description of "loose glass caltrops"
#: data/json/items/tool/traps.json
msgid ""
"These are glass shards glued together to expose their sharp edges.  If an "
"unsuspecting victim steps on one, they'll get cut."
msgstr ""
"Estos son fragmentos de vidrio pegados para exponer sus bordes afilados. Si "
"una víctima desprevenida pisa uno, se cortará."

#. ~ "done_message" action message of item "loose glass caltrops"
#: data/json/items/tool/traps.json
#, c-format
msgid "You scatter the glass caltrops on the %s."
msgstr "Dispersas los abrojos de vidrio en el %s."

#. ~ Description of "crossbow trap"
#: data/json/items/tool/traps.json
msgid ""
"This is a simple tripwire, which is attached to the trigger of a loaded "
"crossbow.  When pulled, the crossbow fires.  Only a single round can be "
"used, after which the trap is disabled."
msgstr ""
"Esta es una trampa de cuerda, que tiene la punta atada al gatillo de una "
"ballesta cargada. Cuando se tira de la cuerda, la ballesta se dispara. Solo "
"se puede usar un perno, y la trampa queda deshabilitada."

#. ~ "done_message" action message of item "crossbow trap"
#: data/json/items/tool/traps.json
msgid "You set the crossbow trap."
msgstr "Pones la trampa de ballesta."

#. ~ Description of "land mine"
#: data/json/items/tool/traps.json
msgid ""
"This is a military anti-personnel mine that is triggered when stepped upon."
msgstr "Esta es una mina militar antipersonal que se activa al ser pisada."

#. ~ "bury_question" action message of item "land mine"
#: data/json/items/tool/traps.json
msgid "Bury the land mine?"
msgstr "¿Quieres enterrar la mina?"

#. ~ "done_message" action message of item "land mine"
#: data/json/items/tool/traps.json
msgid "You set the land mine."
msgstr "Pones la mina."

#. ~ "done_message" action message of item "land mine"
#: data/json/items/tool/traps.json
msgid "You bury the land mine."
msgstr "Entierras la mina."

#. ~ Description of "shotgun trap"
#: data/json/items/tool/traps.json
msgid ""
"This is a simple tripwire is attached to the trigger of a loaded double "
"slamfire shotgun.  When pulled, the shotgun fires.  Two shells are loaded; "
"the first time the trigger is pulled, one or both shells may be discharged."
msgstr ""
"Este es un cable trampa que se conecta al gatillo de una escopeta de doble "
"cañón cargada. Cuando se tira de ella, la escopeta se dispara. Tiene dos "
"cartuchos cargados; la primera vez que se aprieta el gatillo, se puede "
"descargar uno o ambos cartuchos."

#. ~ "done_message" action message of item "shotgun trap"
#: data/json/items/tool/traps.json
msgid "You set the shotgun trap."
msgstr "Pones la trampa de escopeta."

#. ~ Item name
#: data/json/items/tool/traps.json
msgid "tripwire trap"
msgid_plural "tripwire traps"
msgstr[0] "trampa de cuerda"
msgstr[1] "trampas de cuerda"
msgstr[2] "trampas de cuerda"

#. ~ Description of "tripwire trap"
#: data/json/items/tool/traps.json
msgid ""
"This is some thin string with some affixing tools on either end.  A tripwire"
" trap must be placed across a doorway or other thin passage.  Its purpose is"
" to trip up trespassers, causing them to stumble and possibly hurt "
"themselves slightly."
msgstr ""
"Se trata de una cuerda fina y resistente con algunas herramientas de "
"fijación en ambos extremos. Una trampa con cable trampa debe colocarse a "
"través de una puerta u otro pasaje delgado. Su objetivo es hacer tropezar a "
"los intrusos, haciéndoles tambalearse y posiblemente herirse ligeramente."

#. ~ "done_message" action message of item "tripwire trap"
#: data/json/items/tool/traps.json
msgid "You string up the tripwire."
msgstr "Le colocas las sogas a la trampa de cuerdas."

#. ~ Item name
#: data/json/items/tool/unfoldable.json
msgid "folded Bicycle"
msgid_plural "folded Bicycles"
msgstr[0] "Bicicleta plegada"
msgstr[1] "Bicicletas plegadas"
msgstr[2] "Bicicletas plegadas"

#. ~ Description of "folded Bicycle"
#: data/json/items/tool/unfoldable.json
msgid "A folded Bicycle."
msgstr "Una Bicicleta plegada."

#. ~ Description of "folded wheelchair"
#: data/json/items/tool/unfoldable.json
msgid "A folded Wheelchair."
msgstr "Una Silla de ruedas plegada."

#. ~ Description of "inflatable boat"
#: data/json/items/tool/unfoldable.json
msgid ""
"This rubber rowboat (oars included) is deflated for storage.  Activate it, "
"having an air pump in inventory, to inflate and launch."
msgstr ""
"Este bote de goma de remos (incluidos) está desinflado para ser más fácil de"
" guardar. Actívalo para inflarlo, si tienes una bomba de aire o inflador en "
"el inventario, y lanzarlo."

#. ~ Item name
#: data/json/items/tool/woodworking.json
msgid "wood axe"
msgid_plural "wood axes"
msgstr[0] "hacha de madera"
msgstr[1] "hachas de madera"
msgstr[2] "hachas de madera"

#. ~ Description of "wood axe"
#: data/json/items/tool/woodworking.json
msgid ""
"This is a large, two-handed wood axe.  It makes a good melee weapon, but is "
"a bit slow to recover between swings."
msgstr ""
"Esta es una gran hacha de dos manos de leñador. Sirve bastante bien como "
"arma c. a c., pero es un poco lenta entre hachazo y hachazo."

#. ~ Item name
#: data/json/items/tool/woodworking.json
msgid "bow saw"
msgid_plural "bow saws"
msgstr[0] "sierra de arco"
msgstr[1] "sierras de arco"
msgstr[2] "sierras de arco"

#. ~ Description of "bow saw"
#: data/json/items/tool/woodworking.json
msgid ""
"The bow saw is more at home outdoors than inside.  Bow saws are used for "
"trimming trees, pruning, and cutting firewood, but may be used for other "
"rough cuts as well."
msgstr ""
"La sierra de arco se encuentra más a gusto en el exterior que en el "
"interior. Las sierras de arco se utilizan para recortar árboles, podar y "
"cortar leña, pero también pueden utilizarse para otros cortes toscos."

#. ~ Item name
#: data/json/items/tool/woodworking.json
msgid "chainsaw (off)"
msgid_plural "chainsaws (off)"
msgstr[0] "motosierra (off)"
msgstr[1] "motosierras (off)"
msgstr[2] "motosierras (off)"

#. ~ Description of "chainsaw (off)"
#: data/json/items/tool/woodworking.json
msgid ""
"This is a lumbering tool moonlighting as weapon of opportunity.  If loaded "
"with gas, using this item will cause it to turn on, turning it into a very "
"powerful but unwieldy melee weapon."
msgstr ""
"Es una herramienta para cortar árboles pero también con la posibilidad de "
"usarse como arma. Si tiene combustible, al usar este objeto se enciende, lo "
"que la convierte en una arma c. a c. muy poderosa pero incómoda."

#. ~ Item name
#: data/json/items/tool/woodworking.json
msgid "chainsaw (on)"
msgid_plural "chainsaws (on)"
msgstr[0] "motosierra (on)"
msgstr[1] "motosierras (on)"
msgstr[2] "motosierras (on)"

#. ~ Description of "chainsaw (on)"
#: data/json/items/tool/woodworking.json
msgid "This chainsaw is on and making a lot of noise.  Use it to turn it off."
msgstr "La motosierra está encendida y hace mucho ruido. Usar para apagar."

#. ~ Item name
#: data/json/items/tool/woodworking.json
#: data/mods/Dark-Skies-Above/overrides/items/tools.json
msgid "circular saw (off)"
msgid_plural "circular saws (off)"
msgstr[0] "sierra circular (off)"
msgstr[1] "sierras circulares (off)"
msgstr[2] "sierras circulares (off)"

#. ~ Description of "circular saw (off)"
#: data/json/items/tool/woodworking.json
msgid ""
"A lightweight handheld cordless circular saw.  Spins a circular blade fast "
"enough to cut wood, zombies, or in an emergency, pizza.  The blade, while "
"effective in combat, is hard to hit with due to its small size."
msgstr ""
"Una ligera sierra circular sin cable de mano. Gira una hoja circular lo "
"suficientemente rápido como para cortar madera, zombis, o en una emergencia,"
" pizza. La hoja, aunque es efectiva en el combate, es difícil que impacte "
"por su pequeño tamaño."

#. ~ "msg" action message of item "circular saw (off)"
#: data/json/items/tool/woodworking.json
msgid "You turn on the circular saw."
msgstr "Enciendes la sierra circular."

#. ~ Circular saw would be very fast but imprecise butchering tool - alas the
#. qualities are not separate and so speed is sacrificed.
#. ~ Item name
#: data/json/items/tool/woodworking.json
msgid "circular saw (on)"
msgid_plural "circular saws (on)"
msgstr[0] "sierra circular (on)"
msgstr[1] "sierras circulares (on)"
msgstr[2] "sierras circulares (on)"

#. ~ Circular saw would be very fast but imprecise butchering tool - alas the
#. qualities are not separate and so speed is sacrificed.
#. ~ Description of "circular saw (on)"
#: data/json/items/tool/woodworking.json
msgid ""
"A lightweight handheld cordless circular saw.  It is currently on and the "
"blade is spinning; use this item to turn it off."
msgstr ""
"Una sierra circular liviana de mano, sin cable. Está encendida y la cuchilla"
" está girando. Usar para apagar."

#. ~ Item name
#: data/json/items/tool/woodworking.json
msgid "copper axe"
msgid_plural "copper axes"
msgstr[0] "hacha de cobre"
msgstr[1] "hachas de cobre"
msgstr[2] "hachas de cobre"

#. ~ Description of "copper axe"
#: data/json/items/tool/woodworking.json
msgid ""
"This is a decent-sized chunk of worked copper affixed to a wooden shaft, to "
"make a crude yet effective axe."
msgstr ""
"Este es un trozo decente de cobre trabajado, unido a un mango de madera para"
" hacer un hacha simple pero efectiva."

#. ~ Item name
#: data/json/items/tool/woodworking.json
msgid "bronze axe"
msgid_plural "bronze axes"
msgstr[0] "hacha de bronce"
msgstr[1] "hachas de bronce"
msgstr[2] "hachas de bronce"

#. ~ Description of "bronze axe"
#: data/json/items/tool/woodworking.json
msgid ""
"This is a socketed bronze axe with a work-hardened edge, tightly bound to "
"the shaft with cords as your ancestors did."
msgstr ""
"Un hacha de bronce encastrada con el filo muy trabajado y firmemente atado a"
" la empuñadura con cuerdas como hacían tus ancestros."

#. ~ Item name
#: data/json/items/tool/woodworking.json
msgid "hatchet"
msgid_plural "hatchets"
msgstr[0] "hachuela"
msgstr[1] "hachuelas"
msgstr[2] "hachuelas"

#. ~ Description of "hatchet"
#: data/json/items/tool/woodworking.json
msgid ""
"A one-handed hatchet.  Makes a great melee weapon and is useful both for "
"chopping things and for use as a hammer."
msgstr ""
"Un hacha de una sola mano. Es útil como arma de c. a c. y se puede usar para"
" cortar cosas y como martillo."

#. ~ Item name
#: data/json/items/tool/woodworking.json
msgid "electric chainsaw (off)"
msgid_plural "electric chainsaws (off)"
msgstr[0] "motosierra eléctrica (off)"
msgstr[1] "motosierras eléctricas (off)"
msgstr[2] "motosierras eléctricas (off)"

#. ~ Description of "electric chainsaw (off)"
#: data/json/items/tool/woodworking.json
msgid ""
"This is a lumbering tool moonlighting as weapon of opportunity.  If loaded "
"with batteries, using this item will cause it to turn on, turning it into a "
"very powerful but unwieldy melee weapon."
msgstr ""
"Esta es una herramienta para cortar árboles pero también con la posibilidad "
"de usarse como arma. Si tiene batería, al usar este objeto se enciende, lo "
"que la convierte en una arma de c. a c. muy poderosa pero incómoda."

#. ~ Item name
#: data/json/items/tool/woodworking.json
msgid "electric chainsaw (on)"
msgid_plural "electric chainsaws (on)"
msgstr[0] "motosierra eléctrica (on)"
msgstr[1] "motosierras eléctricas (on)"
msgstr[2] "motosierras eléctricas (on)"

#. ~ Description of "electric chainsaw (on)"
#: data/json/items/tool/woodworking.json
msgid ""
"This electric chainsaw is on and making a lot of noise.  Use it to turn it "
"off."
msgstr ""
"Esta motosierra eléctrica está encendida y hace mucho ruido. Usar para "
"apagar."

#. ~ Item name
#: data/json/items/tool/woodworking.json
msgid "stone axe head"
msgid_plural "stone axe heads"
msgstr[0] "cabeza de hacha de piedra"
msgstr[1] "cabezas de hacha de piedra"
msgstr[2] "cabezas de hacha de piedra"

#. ~ Description of "stone axe head"
#: data/json/items/tool/woodworking.json
msgid ""
"This is a broad piece of stone with an edge narrow enough to roughly chop "
"wood."
msgstr ""
"Se trata de una pieza ancha de piedra con un borde lo suficientemente "
"estrecho como para cortar madera."

#. ~ Item name
#: data/json/items/tool/woodworking.json
msgid "metal axe head"
msgid_plural "metal axe heads"
msgstr[0] "cabeza de hacha de metal"
msgstr[1] "cabezas de hacha de metal"
msgstr[2] "cabezas de hacha de metal"

#. ~ Description of "metal axe head"
#: data/json/items/tool/woodworking.json
msgid ""
"This is a chunk of steel with one edge hammered down to something resembling"
" a cutting edge.  It works passably well as an axe but really can't compare "
"to a proper axe."
msgstr ""
"Este es un trozo de acero con un borde martillado hasta algo parecido a un "
"borde de corte. Funciona bien como un hacha, pero no se puede comparar con "
"un hacha de verdad."

#. ~ Item name
#: data/json/items/tool/woodworking.json
msgid "stone adze"
msgid_plural "stone adzes"
msgstr[0] "azuela de piedra"
msgstr[1] "azuelas de piedra"
msgstr[2] "azuelas de piedra"

#. ~ Description of "stone adze"
#: data/json/items/tool/woodworking.json
msgid "This is a stone adze, somewhat useful for smoothing wood objects."
msgstr "Esto es una azuela de piedra, útil para alisar objetos de madera."

#. ~ Item name
#: data/json/items/tool/woodworking.json
msgid "stone axe"
msgid_plural "stone axes"
msgstr[0] "hacha de piedra"
msgstr[1] "hachas de piedra"
msgstr[2] "hachas de piedra"

#. ~ Description of "stone axe"
#: data/json/items/tool/woodworking.json
msgid ""
"This is a stone with a narrow edge affixed to a stick.  It can chop wood, "
"but requires much more effort than a modern axe."
msgstr ""
"Eso es una piedra con un borde estrecho fijada a un palo. Puede cortar "
"madera, pero requiere mucho más esfuerzo que un hacha moderna."

#. ~ Item name
#: data/json/items/tool/woodworking.json
msgid "wood saw"
msgid_plural "wood saws"
msgstr[0] "sierra para madera"
msgstr[1] "sierras para madera"
msgstr[2] "sierras para madera"

#. ~ Description of "wood saw"
#: data/json/items/tool/woodworking.json
msgid ""
"This is a thin saw, useful for cutting through wood objects.  Can turn pre-"
"cut logs into planks by activation."
msgstr ""
"Esta es una sierra fina, útil para cortar objetos de madera. Puede convertir"
" troncos precortados en tablones al activarse."

#. ~ Item name
#: data/json/items/tool/woodworking.json
msgid "stone chisel"
msgid_plural "stone chisels"
msgstr[0] "cincel de piedra"
msgstr[1] "cinceles de piedra"
msgstr[2] "cinceles de piedra"

#. ~ Description of "stone chisel"
#: data/json/items/tool/woodworking.json
msgid ""
"This is a primitive short chisel made from hard stone, usually used for "
"primitive woodworking."
msgstr ""
"Se trata de un cincel corto primitivo de piedra dura, que suele utilizarse "
"para el trabajo primitivo de la madera."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "pallet of wet adobe bricks"
msgid_plural "pallets of wet adobe bricks"
msgstr[0] "palet de ladrillos de adobe húmedos"
msgstr[1] "palets de ladrillos de adobe húmedos"
msgstr[2] "palets de ladrillos de adobe húmedos"

#. ~ Description of "pallet of wet adobe bricks"
#: data/json/items/tool/workshop.json
msgid ""
"A pallet full of heavy mud bricks which need to dry slowly to be usable."
msgstr ""
"Una palet lleno de pesados ladrillos de barro que necesitan secarse "
"lentamente para ser utilizables."

#. ~ "msg" action message of item "pallet of wet adobe bricks"
#: data/json/items/tool/workshop.json
msgid "You test the bricks, and they're solid enough to use."
msgstr "Pruebe los ladrillos, y son lo suficientemente sólidos para usarlos."

#. ~ "not_ready_msg" action message of item "pallet of wet adobe bricks"
#: data/json/items/tool/workshop.json
msgid "The bricks are still too damp to bear weight."
msgstr "Los ladrillos están todavía demasiado húmedos para soportar el peso."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "pallet of dry adobe bricks"
msgid_plural "pallets of dry adobe bricks"
msgstr[0] "palet de ladrillos de adobe seco"
msgstr[1] "palets de ladrillos de adobe seco"
msgstr[2] "palets de ladrillos de adobe seco"

#. ~ Description of "pallet of dry adobe bricks"
#: data/json/items/tool/workshop.json
msgid ""
"A pallet of humble mud bricks that have dried for a week, while you were out"
" risking your life.  Disassemble it to retrieve your frame and building "
"supplies."
msgstr ""
"Un palet de humildes ladrillos de barro que se han secado durante una "
"semana, mientras usted estaba fuera arriesgando su vida. Desmóntalo para "
"recuperar su estructura y los suministros de construcción."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "acetylene-gas machine"
msgid_plural "acetylene-gas machines"
msgstr[0] "máquina de gas de acetileno"
msgstr[1] "máquinas de gas de acetileno"
msgstr[2] "máquinas de gas de acetileno"

#. ~ Description of "acetylene-gas machine"
#: data/json/items/tool/workshop.json
msgid ""
"This bulky device takes water and calcium carbide and yields unpressurised "
"acetylene."
msgstr ""
"Este voluminoso dispositivo toma agua y carburo de calcio y produce "
"acetileno sin presión."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "angle grinder"
msgid_plural "angle grinders"
msgstr[0] "amoladora angular"
msgstr[1] "amoladoras angulares"
msgstr[2] "amoladoras angulares"

#. ~ Description of "angle grinder"
#: data/json/items/tool/workshop.json
msgid ""
"This widespread powertool is often used for removing excess material or "
"polishing surfaces."
msgstr ""
"Esta herramienta de potencia muy extendida se utiliza a menudo para eliminar"
" el exceso de material o pulir las superficies."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "cutoff disc"
msgid_plural "cutoff discs"
msgstr[0] "disco de corte"
msgstr[1] "discos de corte"
msgstr[2] "discos de corte"

#. ~ Description of "cutoff disc"
#: data/json/items/tool/workshop.json
msgid ""
"This is a manufactured disc for an angle grinder, with a thin abrasive edge "
"designed for cutting metal."
msgstr ""
"Este es un disco fabricado para una amoladora angular, con un borde abrasivo"
" fino diseñado para cortar metal."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "metal grinding disc"
msgid_plural "metal grinding discs"
msgstr[0] "disco de lijado de metal"
msgstr[1] "discos de lijado de metal"
msgstr[2] "discos de lijado de metal"

#. ~ Description of "metal grinding disc"
#: data/json/items/tool/workshop.json
msgid ""
"This is a manufactured disc for an angle grinder, with a thick abrasive "
"surface designed for grinding and shaping metal."
msgstr ""
"Este es un disco fabricado para una amoladora angular, con una superficie "
"abrasiva gruesa diseñada para esmerilar y dar forma al metal."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "brick kiln"
msgid_plural "brick kilns"
msgstr[0] "horno de ladrillos"
msgstr[1] "hornos de ladrillos"
msgstr[2] "hornos de ladrillos"

#. ~ Description of "brick kiln"
#: data/json/items/tool/workshop.json
msgid ""
"This is a portable charcoal-fired kiln.  It is designed for firing bricks, "
"but you could use it to fire anything made of clay."
msgstr ""
"Este es un horno de ladrillos portátil que funciona con carbón vegetal. Está"
" diseñado para cocinar ladrillos, pero la puedes usar para cocinar cualquier"
" cosa hecha de arcilla."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "carding paddles"
msgid_plural "pairs of carding paddles"
msgstr[0] "cardadoras de mano"
msgstr[1] "pares de cardadoras de mano"
msgstr[2] "pares de cardadoras de mano"

#. ~ Description of "carding paddles"
#: data/json/items/tool/workshop.json
msgid ""
"A pair of toothy wooden paddles used to clean fibers for use in textile "
"production."
msgstr ""
"Un par de paletas de madera dentadas que se usan para limpiar las fibras "
"para poder usarlas en la producción textil."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "makeshift vacuum mold"
msgid_plural "makeshift vacuum molds"
msgstr[0] "molde de vacio improvisado"
msgstr[1] "moldes de vacio improvisados"
msgstr[2] "moldes de vacio improvisados"

#. ~ Description of "makeshift vacuum mold"
#: data/json/items/tool/workshop.json
msgid ""
"This is a homemade vacuum forming machine with an air pump.  It's used for "
"creating plastic molds."
msgstr ""
"Esta es una máquina casera de formación de vacío con una bomba de aire. Se "
"utiliza para crear moldes de plástico."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "vacuum molder"
msgid_plural "vacuum molders"
msgstr[0] "moldeador de vacio"
msgstr[1] "moldeadores de vacio"
msgstr[2] "moldeadores de vacio"

#. ~ Description of "vacuum molder"
#: data/json/items/tool/workshop.json
msgid ""
"This is a portable vacuum forming machine with an air pump.  It's used for "
"creating plastic molds."
msgstr ""
"Esto es una máquina portátil de formación de vacío con una bomba de aire. Se"
" utiliza para crear moldes de plástico."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "paint chipper"
msgid_plural "paint chippers"
msgstr[0] "espátula"
msgstr[1] "espátulas"
msgstr[2] "espátulas"

#. ~ Description of "paint chipper"
#: data/json/items/tool/workshop.json
msgid "A tool similar to a chisel, designed to remove paint."
msgstr "Una herramienta similar a un cincel, diseñado para sacar la pintura."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "clamp"
msgid_plural "clamps"
msgstr[0] "abrazadera"
msgstr[1] "abrazaderas"
msgstr[2] "abrazaderas"

#. ~ Description of "clamp"
#: data/json/items/tool/workshop.json
msgid ""
"This clamp is useful for keeping things still, especially if you have "
"several of them."
msgstr ""
"Esta abrazadera es útil para mantener las cosas quietas, especialmente si "
"tienes varias."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "claw bar"
msgid_plural "claw bars"
msgstr[0] "pata de cabra"
msgstr[1] "patas de cabra"
msgstr[2] "patas de cabra"

#. ~ Description of "claw bar"
#: data/json/items/tool/workshop.json
msgid ""
"This is a small prying tool with a clawed bend at one end for pulling "
"spikes.  Use it to open locked doors without destroying them or to lift "
"manhole covers.  You could also wield it to bash some heads in."
msgstr ""
"Esta es una pequeña herramienta con una curva de garra en un extremo para "
"tirar de los picos. Se usa para abrir puertas cerradas sin destruirlas o "
"para levantar tapas de alcantarilla. También puedes usarla para golpear "
"algunas cabezas."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "concrete mixer"
msgid_plural "concrete mixers"
msgstr[0] "hormigonera"
msgstr[1] "hormigoneras"
msgstr[2] "hormigoneras"

#. ~ Description of "concrete mixer"
#: data/json/items/tool/workshop.json
msgid ""
"A portable concrete mixer.  It is still large and heavy, but it can be "
"operated solo, and runs on batteries.  It also has a heater built in."
msgstr ""
"Una mezcladora portátil de hormigón. Igual, es grande y pesada, pero puede "
"ser operada por una sola persona, y anda con baterías. También tiene un "
"calentador incorporado."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "cordless drill"
msgid_plural "cordless drills"
msgstr[0] "taladro inalámbrico"
msgstr[1] "taladros inalámbricos"
msgstr[2] "taladros inalámbricos"

#. ~ Description of "cordless drill"
#: data/json/items/tool/workshop.json
msgid ""
"This is a cordless battery-powered drill with a selection of drill bits."
msgstr ""
"Esto es un taladro sin cable, alimentado con baterías, con una variedad de "
"puntas para el taladro."

#. ~ Loosely based on DeWalt DCF899B 20V 1/2-inch cordless impact wrench, $220
#. on Amazon, 6.4 pounds.
#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "cordless impact wrench"
msgid_plural "cordless impact wrenches"
msgstr[0] "llave de impacto sin cables"
msgstr[1] "llaves de impacto sin cables"
msgstr[2] "llaves de impacto sin cables"

#. ~ Loosely based on DeWalt DCF899B 20V 1/2-inch cordless impact wrench, $220
#. on Amazon, 6.4 pounds.
#. ~ Description of "cordless impact wrench"
#: data/json/items/tool/workshop.json
msgid ""
"This is a cordless battery-powered impact wrench, designed to deliver high "
"torque via an internal rotating hammer.  It comes with a standard set of "
"sockets, and makes a loud ratcheting sound when it operates.  You could use "
"it to turn large bolts, or even change a vehicle wheel."
msgstr ""
"Esto es una llave de impacto con batería inalámbrica, diseñada para "
"proporcionar un alto par de torsión a través de un martillo giratorio "
"interno. Viene con un juego de llaves estándar y emite un fuerte sonido de "
"trinquete cuando funciona. Puedes utilizarla para girar tornillos grandes, o"
" incluso para cambiar una rueda de un vehículo."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "distaff and spindle"
msgid_plural "distaves and spindles"
msgstr[0] "huso y aspa"
msgstr[1] "husos y aspas"
msgstr[2] "husos y aspas"

#. ~ Description of "distaff and spindle"
#: data/json/items/tool/workshop.json
msgid ""
"A pair of specialized wooden rods used to spin fibers into thread and yarn."
msgstr ""
"Es un par de palos de madera especializados para hacer hilos y ovillos "
"hilando fibra."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "electric jackhammer"
msgid_plural "electric jackhammers"
msgstr[0] "martillo neumático eléctrico"
msgstr[1] "martillos neumáticos eléctricos"
msgstr[2] "martillos neumáticos eléctricos"

#. ~ Description of "electric jackhammer"
#: data/json/items/tool/workshop.json
msgid ""
"This is a construction tool for drilling through hard rock or other "
"surfaces.  It runs on a cell compatible with UPS.  Use it to blast a hole in"
" adjacent solid terrain."
msgstr ""
"Esta es una herramienta de construcción para perforar a través de roca dura "
"u otras superficies. Funciona con una célula compatible con UPS. Se usa para"
" hacer un agujero en un terreno sólido adyacente."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "hacksaw"
msgid_plural "hacksaws"
msgstr[0] "sierra para metales"
msgstr[1] "sierras para metales"
msgstr[2] "sierras para metales"

#. ~ Description of "hacksaw"
#: data/json/items/tool/workshop.json
msgid "This is a sturdy saw, useful for cutting through metal objects."
msgstr "Es una sierra resistente, útil para cortar objetos de metal."

#. ~ Loosely based on Stanley FATMAX straight cut 9-7/8-inch aviation snip
#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "tin snips"
msgid_plural "tin snips"
msgstr[0] "tijera de hojalata"
msgstr[1] "tijeras de hojalata"
msgstr[2] "tijeras de hojalata"

#. ~ Loosely based on Stanley FATMAX straight cut 9-7/8-inch aviation snip
#. ~ Description of "tin snips"
#: data/json/items/tool/workshop.json
msgid ""
"This is a pair of tin snips, resembling a sturdy pair of scissors with beefy"
" blades designed to cut through thin sheets of soft metal.  These cannot cut"
" through thick metals like a hacksaw can, but are better suited to precision"
" work and leave a cleaner edge."
msgstr ""
"Este es un par de tijeras de hojalatero que se asemejan a un par de tijeras "
"robustas con hojas robustas diseñadas para cortar láminas finas de metal "
"blando. No pueden cortar metales gruesos como una sierra para metales, pero "
"son más adecuadas para trabajos de precisión y dejan un borde más limpio."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "hammer"
msgid_plural "hammers"
msgstr[0] "martillo"
msgstr[1] "martillos"
msgstr[2] "martillos"

#. ~ Description of "hammer"
#: data/json/items/tool/workshop.json
msgid ""
"This is a demagnetized steel claw hammer with a wooden grip.  With a hammer,"
" nails, and planks in your inventory, you could board up adjacent doors and "
"windows.  It has myriad other uses as well."
msgstr ""
"Este es un martillo de garra de acero desmagnetizado con empuñadura de "
"madera. Con un martillo, clavos y tablones en tu inventario, podrías tapiar "
"puertas y ventanas adyacentes. También tiene muchos otros usos."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "hand drill"
msgid_plural "hand drills"
msgstr[0] "taladro manual"
msgstr[1] "taladros manuales"
msgstr[2] "taladros manuales"

#. ~ Description of "hand drill"
#: data/json/items/tool/workshop.json
msgid ""
"A primitive manual drill with a single drill bit.  It is slow and it will "
"exhaust you quickly."
msgstr ""
"Es una primitiva agujereadora manual con una sola mecha. Es lenta y "
"agotadora de utilizar."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "rubber hose"
msgid_plural "rubber hoses"
msgstr[0] "manguera de goma"
msgstr[1] "mangueras de goma"
msgstr[2] "mangueras de goma"

#. ~ Description of "rubber hose"
#: data/json/items/tool/workshop.json
msgid ""
"This is a flexible rubber hose.  It could be used for crafting, or siphoning"
" fuel from a vehicle."
msgstr ""
"Esta es una manguera de goma flexible. Puede ser usada para fabricar alguna "
"cosa, o para transvasar la gasolina a un vehículo."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "bottle jack"
msgid_plural "bottle jacks"
msgstr[0] "gato hidráulico de botella"
msgstr[1] "gatos hidráulicos de botella"
msgstr[2] "gatos hidráulicos de botella"

#. ~ Description of "bottle jack"
#: data/json/items/tool/workshop.json
msgid "A portable hydraulic bottle jack used for lifting vehicles."
msgstr ""
"Es un gato hidráulico portátil de tipo botella usado para levantar "
"vehículos."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "makeshift jack"
msgid_plural "makeshift jacks"
msgstr[0] "gato hidráulico improvisado"
msgstr[1] "gatos hidráulicos improvisados"
msgstr[2] "gatos hidráulicos improvisados"

#. ~ Description of "makeshift jack"
#: data/json/items/tool/workshop.json
msgid ""
"A poorly constructed improvised scissor jack used for lifting vehicles if "
"you're brave enough to use it."
msgstr ""
"Es un gato hidráulico improvisado de tipo tijera, bastante mal construido, "
"capaz de levantar vehículos si eres tan valiente como para usarlo."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "scissor jack"
msgid_plural "scissor jacks"
msgstr[0] "gato hidráulico de tipo tijera"
msgstr[1] "gatos hidráulicos de tipo tijera"
msgstr[2] "gatos hidráulicos de tipo tijera"

#. ~ Description of "scissor jack"
#: data/json/items/tool/workshop.json
msgid "A compact scissor jack used for lifting vehicles."
msgstr ""
"Es un gato hidráulico compacto de tipo tijera, usado para levantar "
"vehículos."

#. ~ Consumes 0.6 L/h
#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "jackhammer"
msgid_plural "jackhammers"
msgstr[0] "martillo neumático"
msgstr[1] "martillos neumáticos"
msgstr[2] "martillos neumáticos"

#. ~ Consumes 0.6 L/h
#. ~ Description of "jackhammer"
#: data/json/items/tool/workshop.json
msgid ""
"This is a construction tool for drilling through hard rock or other "
"surfaces.  It runs on gasoline.  Use it (if loaded) to blast a hole in "
"adjacent solid terrain."
msgstr ""
"Es una herramienta de construcción que se usa para agujerear roca sólida u "
"otras superficies. Utiliza gasolina. Usalo para hacer un agujero en terreno "
"adyacente (si tiene gasolina)."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "electric kiln"
msgid_plural "electric kilns"
msgstr[0] "horno eléctrico"
msgstr[1] "hornos eléctricos"
msgstr[2] "hornos eléctricos"

#. ~ Description of "electric kiln"
#: data/json/items/tool/workshop.json
msgid ""
"This is a portable electric kiln, powered by batteries.  It is designed for "
"firing bricks, but you could use it to fire anything made of clay.  With a "
"little mechanical know-how, you could probably even convert it to run "
"directly off a vehicle's power system."
msgstr ""
"Este es un horno eléctrico portátil, alimentado por baterías. Está diseñado "
"para cocer ladrillos, pero se puede usar para cocer cualquier cosa hecha de "
"arcilla. Con un poco de conocimiento mecánico, probablemente podrías incluso"
" convertirlo para que funcione directamente con el sistema de energía de un "
"vehículo."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "gunsmith repair kit"
msgid_plural "gunsmith repair kits"
msgstr[0] "equipo armero de reparación"
msgstr[1] "equipos armeros de reparación"
msgstr[2] "equipos armeros de reparación"

#. ~ Description of "gunsmith repair kit"
#: data/json/items/tool/workshop.json
msgid ""
"This is a complete toolkit made to repair damaged firearms.  Powered by "
"standard batteries, it is a vital tool for long-term firearms maintenance.  "
"It requires 25 charges of battery power per use."
msgstr ""
"Es un equipo completo de herramientas hecho para reparar armas de fuego "
"dañadas. Alimentado con baterías normales, es una herramienta vital para el "
"mantenimiento a largo plazo de las armas de fuego. Necesita 25 cargas de "
"batería para cada vez que se usa."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "makeshift hammer"
msgid_plural "makeshift hammers"
msgstr[0] "martillo improvisado"
msgstr[1] "martillos improvisados"
msgstr[2] "martillos improvisados"

#. ~ Description of "makeshift hammer"
#: data/json/items/tool/workshop.json
msgid ""
"This is a crude hammer made from a piece of metal affixed to a stick.  It "
"functions adequately as a hammer, but really can't compare to a proper one."
msgstr ""
"Este es un martillo crudo hecho de una pieza de metal pegado a un palo. "
"Funciona adecuadamente como un martillo, pero realmente no se puede comparar"
" con uno apropiado."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "metal fileset"
msgid_plural "metal filesets"
msgstr[0] "lima metálica"
msgstr[1] "limas metálicas"
msgstr[2] "limas metálicas"

#. ~ Description of "metal fileset"
#: data/json/items/tool/workshop.json
msgid ""
"These tools are commonly used to remove small amounts of materials from the "
"surface of metal objects."
msgstr ""
"Estas herramientas se usan comúnmente para remover pequeñas cantidades de "
"materiales de la superficie de objetos metálicos."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "metallic smoother"
msgid_plural "metallic smoothers"
msgstr[0] "llana de metal"
msgstr[1] "llanas de metal"
msgstr[2] "llanas de metal"

#. ~ Description of "metallic smoother"
#: data/json/items/tool/workshop.json
msgid ""
"This metallic tool is most often used to smooth concrete, or mortar, in "
"construction projects."
msgstr ""
"Esta herramienta metálica es utilizada comúnmente para alisar el hormigón, o"
" la mezcla, en las obras."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "misc repair kit"
msgid_plural "misc repair kits"
msgstr[0] "kit de reparación misceláneo"
msgstr[1] "kits de reparación misceláneos"
msgstr[2] "kits de reparación misceláneos"

#. ~ Description of "misc repair kit"
#: data/json/items/tool/workshop.json
msgid ""
"This is a portable toolkit, consisting of a small carving knife for precise "
"carving of replacement parts from raw materials, a wood saw for more heavy-"
"duty wood cutting, and a patch of soft material for cleaning surfaces.  If "
"supplied with duct tape, it can be used to repair certain items."
msgstr ""
"Este es un juego de herramientas portátil, que consiste en un pequeño "
"cuchillo de trinchar para tallar con precisión las piezas de recambio de las"
" materias primas, una sierra para madera para cortar madera más resistente y"
" un parche de material blando para limpiar las superficies. Si se suministra"
" con cinta americana, se puede usar para reparar ciertos artículos."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "plastic mold"
msgid_plural "plastic molds"
msgstr[0] "molde de plástico"
msgstr[1] "moldes de plástico"
msgstr[2] "moldes de plástico"

#. ~ Description of "plastic mold"
#: data/json/items/tool/workshop.json
msgid "This is a plastic mold.  It can be used to form plastic chunks."
msgstr ""
"Esto es un molde de plástico. Se puede utilizar para dar forma a trozos de "
"plástico."

#. ~ The multitool is a bit more of a toolkit than a knife.
#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "multitool"
msgid_plural "multitools"
msgstr[0] "multiherramienta"
msgstr[1] "multiherramientas"
msgstr[2] "multiherramientas"

#. ~ The multitool is a bit more of a toolkit than a knife.
#. ~ Description of "multitool"
#: data/json/items/tool/workshop.json
msgid ""
"A cleverly designed all-in-one tool which combines several smaller tools "
"into the handles of a pair of pliers."
msgstr ""
"Una herramienta multifunción ingeniosamente diseñada, que combina varias "
"herramientas pequeñas en los mangos del par de pinzas."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "acetylene torch"
msgid_plural "acetylene torches"
msgstr[0] "soplete de acetileno"
msgstr[1] "sopletes de acetileno"
msgstr[2] "sopletes de acetileno"

#. ~ Description of "acetylene torch"
#: data/json/items/tool/workshop.json
msgid ""
"A compact tool kit intended for welding and cutting metal, this portable "
"oxyacetylene torch includes a torch handle and cutting attachment in an "
"easy-to-carry tote.  It requires connecting to pressurized cylinders of an "
"appropriate welding gas before use.  In addition to its metalworking uses, "
"you can activate it in order to destroy metal barriers."
msgstr ""
"Un kit de herramientas compacto diseñado para la soldadura y corte de metal,"
" este soplete acetileno portátil incluye un mango del soplete y el accesorio"
" de corte en una bolsa fácil de llevar.  Requiere conexión a cilindros a "
"presión de un gas de soldadura apropiado antes del uso.  Además de sus usos "
"de metales, se puede activar para destruir las barreras metálicas."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "paint brush"
msgid_plural "paint brushes"
msgstr[0] "brocha"
msgstr[1] "brochas"
msgstr[2] "brochas"

#. ~ Description of "paint brush"
#: data/json/items/tool/workshop.json
msgid "A wide brush, suitable for painting walls."
msgstr "Un pincel ancho, adecuado para pintar muros."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "pickaxe"
msgid_plural "pickaxes"
msgstr[0] "pico"
msgstr[1] "picos"
msgstr[2] "picos"

#. ~ Description of "pickaxe"
#: data/json/items/tool/workshop.json
msgid ""
"This is a large steel pickaxe, suitable for breaking up hard things or (with"
" enough skill) hard targets.  Strike the earth!"
msgstr ""
"Es un pico grande de acero, útil para rompar cosas duras o (con suficiente "
"habilidad) enemigos duros. ¡Picá la tierra!"

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "bronze pickaxe"
msgid_plural "bronze pickaxes"
msgstr[0] "pico de bronce"
msgstr[1] "picos de bronce"
msgstr[2] "picos de bronce"

#. ~ Description of "bronze pickaxe"
#: data/json/items/tool/workshop.json
msgid ""
"A heavy-headed cast and worked tool with a pointed wedge on one side for "
"breaking stone and flat wedge on the other for prying it out.  You could "
"mine with this."
msgstr ""
"Una herramienta resistente con cabeza de fundición, con una punta en un lado"
" para romper piedra y un borde plano en el otro lado para hacer palanca.  "
"Con esta herramienta puedes hacer minería."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "pin reamer"
msgid_plural "pin reamers"
msgstr[0] "escariador de pin"
msgstr[1] "escariadores de pin"
msgstr[2] "escariadores de pin"

#. ~ Description of "pin reamer"
#: data/json/items/tool/workshop.json
msgid ""
"Handheld pin reamers of this kind are used to enlarge existing holes, or "
"remove any burs and such from them."
msgstr ""
"Los escariadores manuales de este tipo se utilizan para agrandar los "
"agujeros existentes, o para quitar cualquier broca y tal de ellos."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "pliers"
msgid_plural "pliers"
msgstr[0] "tenaza"
msgstr[1] "tenazas"
msgstr[2] "tenazas"

#. ~ Description of "pliers"
#: data/json/items/tool/workshop.json
msgid ""
"This is a basic pair of slip-joint pliers, able to handle basic mechanical "
"work.  Anything too complex will require a wrench."
msgstr ""
"Es una tenaza común con junta deslizante, útil para usar en trabajos "
"mecánicos básicos. Para otras cosas más complejas vas a necesitar una llave "
"francesa. "

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "tongue-and-groove pliers"
msgid_plural "tongue-and-groove pliers"
msgstr[0] "alicates pico de loro"
msgstr[1] "alicates pico de loro"
msgstr[2] "alicates pico de loro"

#. ~ Description of "tongue-and-groove pliers"
#: data/json/items/tool/workshop.json
msgid ""
"This is a large pair of slip-joint pliers bent at the elbow, able to handle "
"basic mechanical work.  Anything too complex will require a wrench."
msgstr ""
"Esto es un gran par de alicates con junta deslizante doblados en el codo, "
"capaces de realizar trabajos mecánicos básicos. Cualquier cosa demasiado "
"compleja requerirá una llave inglesa."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "locking pliers"
msgid_plural "locking pliers"
msgstr[0] "pinza de presión"
msgstr[1] "pinzas de presión"
msgstr[2] "pinzas de presión"

#. ~ Description of "locking pliers"
#: data/json/items/tool/workshop.json
msgid ""
"These pliers have extra-hefty jaws, and an adjustable mechanism to clamp "
"them in a locked grip on whatever unfortunate object is trapped between "
"them.  They could grip and turn a fairly large bolt head, or clamp two parts"
" together temporarily."
msgstr ""
"Estos alicates tienen mandíbulas extra fuertes y un mecanismo ajustable para"
" sujetar cualquier objeto desafortunado que quede atrapado entre ellas. "
"Pueden agarrar y girar la cabeza de un tornillo bastante grande, o sujetar "
"dos piezas juntas temporalmente."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "electric polisher"
msgid_plural "electric polishers"
msgstr[0] "pulidor eléctrico"
msgstr[1] "pulidores eléctricos"
msgstr[2] "pulidores eléctricos"

#. ~ Description of "electric polisher"
#: data/json/items/tool/workshop.json
msgid ""
"An electric polisher which can be used to buff metal surfaces until they are"
" reflective like a mirror."
msgstr ""
"Es un pulidor eléctrico que se utiliza para pulir superficies de metal y "
"hacerlas tan reflectantes como un espejo."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "stone hammer"
msgid_plural "stone hammers"
msgstr[0] "martillo de piedra"
msgstr[1] "martillos de piedra"
msgstr[2] "martillos de piedra"

#. ~ Description of "stone hammer"
#: data/json/items/tool/workshop.json
msgid ""
"This is a rock affixed to a stick, in the crude facsimile of a hammer.  It "
"functions adequately as a hammer, but really can't compare to a proper one, "
"and can't pull out nails either."
msgstr ""
"Se trata de una piedra fijada a un palo, en el burdo facsímil de un "
"martillo. Funciona adecuadamente como un martillo, pero realmente no se "
"puede comparar con uno adecuado, y tampoco puede sacar clavos."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "reciprocating saw"
msgid_plural "reciprocating saws"
msgstr[0] "sierra reciprocante"
msgstr[1] "sierras reciprocantes"
msgstr[2] "sierras reciprocantes"

#. ~ Description of "reciprocating saw"
#: data/json/items/tool/workshop.json
msgid ""
"This battery-powered tool, commonly known by the generic trademark Sawzall, "
"uses an electric motor to push a straight sawblade back and forth to rapidly"
" cut wood or metal.  It is useful for heavy demolition and construction "
"work, but is poorly suited to precision tasks."
msgstr ""
"Esta herramienta con batería, conocida comúnmente por la marca genérica "
"Sawzall, utiliza un motor eléctrico para empujar una hoja de sierra recta "
"hacia adelante y hacia atrás para cortar rápidamente madera o metal. Es útil"
" para trabajos pesados de demolición y construcción, pero es poco adecuada "
"para tareas de precisión."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "Hub 01 HWP maintenance kit"
msgid_plural "Hub 01 HWP maintenance kits"
msgstr[0] "equipo de mantenimiento Hub 01 HWP"
msgstr[1] "equipos de mantenimiento Hub 01 HWP"
msgstr[2] "equipos de mantenimiento Hub 01 HWP"

#. ~ Description of "Hub 01 HWP maintenance kit"
#: data/json/items/tool/workshop.json
msgid ""
"This is a heavy-duty bag marked with the Hub 01 logo.  It contains space for"
" barrels, adapters, and proprietary tools.  Embossed on the inside is a "
"sketch of the Hybrid Weapons Platform."
msgstr ""
"Una bolsa reforzada marcada con el logo del Hub 01.  Tiene sitio para "
"tanques, adaptadores y herramientas exclusivas.  Dentro tiene grabado el "
"boceto de la Plataforma de Armas Híbridas."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "screwdriver"
msgid_plural "screwdrivers"
msgstr[0] "destornillador"
msgstr[1] "destornilladores"
msgstr[2] "destornilladores"

#. ~ Description of "screwdriver"
#: data/json/items/tool/workshop.json
msgid ""
"This is a Philips-head screwdriver.  It is important for almost all "
"electronics crafting, most mechanics crafting, and has many more uses."
msgstr ""
"Es un destornillador de broca cruciforme... o sea, punta phillips. Es una "
"herramienta importante para casi todas las fabricaciones electrónicas, la "
"mayoría de las mecánicas, y tiene muchos otros usos."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "screwdriver set"
msgid_plural "screwdriver sets"
msgstr[0] "juego de destornilladores"
msgstr[1] "juegos de destornilladores"
msgstr[2] "juegos de destornilladores"

#. ~ Description of "screwdriver set"
#: data/json/items/tool/workshop.json
msgid ""
"This is a set of screwdrivers in several sizes and blade types.  Guaranteed "
"to have the right tools for more precise work."
msgstr ""
"Es un juego de destornilladores de varios tamaños y tipos de punta. Te "
"garantiza tener la herramienta adecuada para un trabajo preciso."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "socket screwdriver set"
msgid_plural "socket screwdriver sets"
msgstr[0] "juego de destornilladores de vaso"
msgstr[1] "juegos de destornilladores de vaso"
msgstr[2] "juegos de destornilladores de vaso"

#. ~ Description of "socket screwdriver set"
#: data/json/items/tool/workshop.json
msgid ""
"This is a ratcheting screwdriver with a collection of hex sockets for "
"turning small bolts or nuts, including a couple standard screwdriver bits."
msgstr ""
"Este es un destornillador de carraca con una colección de casquillos "
"hexagonales para girar pequeños tornillos o tuercas, incluyendo un par de "
"puntas de destornillador estándar."

#. ~ Modeled after 40-piece Walmart set, 2.85 lb, case 9.75 x 1.5 x 5 inches
#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "socket wrench set"
msgid_plural "socket wrench sets"
msgstr[0] "juego de llaves de vaso"
msgstr[1] "juegos de llaves de vaso"
msgstr[2] "juegos de llaves de vaso"

#. ~ Modeled after 40-piece Walmart set, 2.85 lb, case 9.75 x 1.5 x 5 inches
#. ~ Description of "socket wrench set"
#: data/json/items/tool/workshop.json
msgid ""
"This is a thick-handled ratchet wrench with an assortment of interchangeable"
" sockets in common hex bolt sizes.  You could loosen or tighten fairly large"
" bolts with this, and the ratchet makes a satisfying clicking sound."
msgstr ""
"Esto es una llave de carraca de mango grueso con un surtido de casquillos "
"intercambiables en tamaños de pernos hexagonales comunes. Puedes aflojar o "
"apretar pernos bastante grandes con esto, y el trinquete hace un sonido de "
"clic satisfactorio."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "firearm repair kit"
msgid_plural "firearm repair kits"
msgstr[0] "equipo de reparación de armas"
msgstr[1] "equipos de reparación de armas"
msgstr[2] "equipos de reparación de armas"

#. ~ Description of "firearm repair kit"
#: data/json/items/tool/workshop.json
msgid ""
"This is a portable toolkit made to repair damaged firearms.  Powered by "
"standard batteries, it is a vital tool for long-term firearms maintenance.  "
"It requires 100 charges of battery power per use."
msgstr ""
"Es un equipo portátil de herramientas hecho para reparar armas de fuego "
"dañadas. Alimentado con baterías normales, es una herramienta vital para el "
"mantenimiento a largo plazo de las armas de fuego. Necesita 100 cargas de "
"batería para cada vez que se usa."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "soldering iron"
msgid_plural "soldering irons"
msgstr[0] "soldadora de mano"
msgstr[1] "soldadoras de mano"
msgstr[2] "soldadoras de mano"

#. ~ Description of "soldering iron"
#: data/json/items/tool/workshop.json
msgid ""
"This is a device with a metal tip that can get very hot.  It is necessary "
"for advanced electronics crafting."
msgstr ""
"Un aparato con una punta de metal que se puede poner muy caliente. Es "
"necesario para crear dispositivos electrónicos avanzados."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "lug wrench"
msgid_plural "lug wrenches"
msgstr[0] "llave de tuerca"
msgstr[1] "llaves de tuerca"
msgstr[2] "llaves de tuerca"

#. ~ Description of "lug wrench"
#: data/json/items/tool/workshop.json
msgid ""
"A steel rod bent 90 degrees with a socket on the shorter end, made to hold "
"the lug nuts of a car's wheels to either fasten or loosen for convenient "
"removal and replacement.  Makes for a decent melee weapon in a pinch."
msgstr ""
"Una varilla de acero doblada a 90 grados con un casquillo en el extremo más "
"corto, hecha para sujetar las tuercas de las ruedas de un coche para "
"sujetarlas o aflojarlas para su conveniente retirada y sustitución. Es un "
"arma de combate c. a c. decente en caso de necesidad."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "toolbox"
msgid_plural "toolboxes"
msgstr[0] "caja de herramientas"
msgstr[1] "cajas de herramientas"
msgstr[2] "cajas de herramientas"

#. ~ Description of "toolbox"
#: data/json/items/tool/workshop.json
msgid ""
"This is a stout metal box for containing tools.  It has a handle on the top "
"and a latch on the front."
msgstr ""
"Se trata de una robusta caja metálica para contener herramientas. Tiene un "
"asa en la parte superior y un pestillo en la parte delantera."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "workshop toolbox"
msgid_plural "workshop toolboxes"
msgstr[0] "caja de herramientas para el taller"
msgstr[1] "cajas de herramientas para el taller"
msgstr[2] "cajas de herramientas para el taller"

#. ~ Description of "workshop toolbox"
#: data/json/items/tool/workshop.json
msgid ""
"This is a stout metal box for containing tools.  It is much bigger than a "
"regular tool box and could be used to store more tools than usual."
msgstr ""
"Se trata de una robusta caja metálica para contener herramientas. Es mucho "
"más grande que una caja de herramientas normal y podría utilizarse para "
"guardar más herramientas de lo habitual."

#. ~ Charges will exceed max charges since they're always equal to the
#. player's bionic power, but this has no adverse effects.
#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "extended multitool"
msgid_plural "extended multitools"
msgstr[0] "multiherramienta extendida"
msgstr[1] "multiherramientas extendidas"
msgstr[2] "multiherramientas extendidas"

#. ~ Charges will exceed max charges since they're always equal to the
#. player's bionic power, but this has no adverse effects.
#. ~ Description of "extended multitool"
#: data/json/items/tool/workshop.json
msgid "Your multitool, extended.  Ready to do repair work."
msgstr "Tu multiherramienta, extendida. Preparado para reparar cosas."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "arc welder"
msgid_plural "arc welders"
msgstr[0] "soldador de arco"
msgstr[1] "soldadores de arco"
msgstr[2] "soldadores de arco"

#. ~ Description of "arc welder"
#: data/json/items/tool/workshop.json
msgid ""
"This is a battery powered tool for welding metal pieces together using an "
"electric arc.  It is an indispensable tool for construction or repair."
msgstr ""
"Esta es una herramienta a batería para soldar piezas de metal mediante un "
"arco eléctrico. Es una herramienta indispensable para la construcción o la "
"reparación."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "makeshift arc welder"
msgid_plural "makeshift arc welders"
msgstr[0] "soldador de arco improvisado"
msgstr[1] "soldadores de arco improvisados"
msgstr[2] "soldadores de arco improvisados"

#. ~ Description of "makeshift arc welder"
#: data/json/items/tool/workshop.json
msgid ""
"This crude arc welder has been fashioned from a few small transformers, some"
" wire, improvised electrode holder and complete disregard for personal "
"safety.  While it's not as efficient as a factory welder, it will serve in a"
" pinch."
msgstr ""
"Este soldador de arco crudo ha sido diseñado a partir de unos pocos "
"transformadores pequeños, algunos cables, un portaelectrodos improvisado y "
"un total desprecio por la seguridad personal. Si bien no es tan eficiente "
"como un soldador de fábrica, servirá en caso de necesidad."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "welding kit"
msgid_plural "welding kits"
msgstr[0] "kit de soldadura"
msgstr[1] "kits de soldadura"
msgstr[2] "kits de soldadura"

#. ~ Description of "welding kit"
#: data/json/items/tool/workshop.json
msgid ""
"A welder combined with a fireproof insulating blanket allows for advanced "
"welds and repairs to tempered steels."
msgstr ""
"Un soldador combinado con una manta aislante ignífuga que permite hacer "
"soldaduras avanzadas y reparaciones en aceros templados."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "wooden smoother"
msgid_plural "wooden smoothers"
msgstr[0] "llana de madera"
msgstr[1] "llanas de madera"
msgstr[2] "llanas de madera"

#. ~ Description of "wooden smoother"
#: data/json/items/tool/workshop.json
msgid ""
"This large makeshift tool is used in smoothing concrete or mortar in "
"construction projects.  You could also use it as an improvised head-basher."
msgstr ""
"Esta herramienta improvisada es usada para alisar el hormigón o la mezcla en"
" las obras. También lo puedes usar para reventar algunas cabezas."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "wool staple"
msgid_plural "wool staples"
msgstr[0] "fibra de lana"
msgstr[1] "fibras de lana"
msgstr[2] "fibras de lana"

#. ~ Description of "wool staple"
#: data/json/items/tool/workshop.json
msgid ""
"The natural cluster of wool fibers.  Could be processed to the felt patches "
"or yarns."
msgstr ""
"Es un conjunto natural de fibras de lana. Puede ser procesado para hacer "
"trozos de fieltro o hilos."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "X-Acto knife"
msgid_plural "X-Acto knives"
msgstr[0] "navaja de precisión"
msgstr[1] "navajas de precisión"
msgstr[2] "navajas de precisión"

#. ~ Description of "X-Acto knife"
#: data/json/items/tool/workshop.json
msgid ""
"This is a small, sharp knife, designed for making precise cuts for textiles "
"or crafts.  It could cause decent damage, but is difficult to hit things "
"with it.  Its small, sharp blade allows for precision strikes in the hands "
"of the skilled.  It is too small to butcher corpses with."
msgstr ""
"Este es un cuchillo pequeño y afilado, diseñado para hacer cortes precisos "
"trabajando con telas o en alguna fabricación. Puede causar un daño decente, "
"pero es difícil acertarle a las cosas con esto. Su pequeña hoja afilada "
"permite golpes precisos en las manos de alguien hábil. Es demasiado pequeño "
"para poder descuartizar cadáveres."

#. ~ Measured weight of 6-inch Craftsman wrench with 150mm jaws, assume 8g/ml
#. steel density plus some margin for mechanism and empty space.
#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "small adjustable wrench"
msgid_plural "small adjustable wrenches"
msgstr[0] "llave inglesa pequeña"
msgstr[1] "llaves inglesas pequeñas"
msgstr[2] "llaves inglesas pequeñas"

#. ~ Measured weight of 6-inch Craftsman wrench with 150mm jaws, assume 8g/ml
#. steel density plus some margin for mechanism and empty space.
#. ~ Description of "small adjustable wrench"
#: data/json/items/tool/workshop.json
msgid ""
"This adjustable crescent wrench is compact, with a short handle that fits in"
" the palm of the hand.  It could be used for turning small hex-head nuts or "
"bolts."
msgstr ""
"Esta llave inglesa ajustable es compacta, con un mango corto que cabe en la "
"palma de la mano. Puede utilizarse para girar tuercas o tornillos pequeños "
"de cabeza hexagonal."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "adjustable wrench"
msgid_plural "adjustable wrenches"
msgstr[0] "llaves inglesa"
msgstr[1] "llaves inglesas"
msgstr[2] "llaves inglesas"

#. ~ Description of "adjustable wrench"
#: data/json/items/tool/workshop.json
msgid ""
"This is an adjustable crescent wrench.  It could be a decent melee weapon, "
"and is used in many mechanics crafting recipes."
msgstr ""
"Esta es una llave inglesa ajustable. Puede funcionar como una decente arma "
"de c. a c. y es utilizada en muchas tareas mecánicas."

#. ~ WESTWARD 31D018 from Walmart, 18-inch length, 2-3/8-inch jaws, 4.23 lb,
#. assume 8g/ml steel density with some margin for mechanism and other empty
#. space.
#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "large adjustable wrench"
msgid_plural "large adjustable wrenches"
msgstr[0] "llave inglesa grande"
msgstr[1] "llaves inglesas grandes"
msgstr[2] "llaves inglesas grandes"

#. ~ WESTWARD 31D018 from Walmart, 18-inch length, 2-3/8-inch jaws, 4.23 lb,
#. assume 8g/ml steel density with some margin for mechanism and other empty
#. space.
#. ~ Description of "large adjustable wrench"
#: data/json/items/tool/workshop.json
msgid ""
"This adjustable crescent wrench is unusually large, with a long handle and "
"jaws that widen over two inches.  This could easily turn most bolts, and "
"should even work on wheel lug nuts."
msgstr ""
"Esta llave inglesa de media luna ajustable es inusualmente grande, con un "
"mango largo y mandíbulas que se ensanchan más de dos pulgadas. Esto podría "
"girar fácilmente la mayoría de los tornillos, e incluso debería funcionar en"
" las tuercas de las ruedas."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "leather hose"
msgid_plural "leather hoses"
msgstr[0] "manguera de cuero"
msgstr[1] "mangueras de cuero"
msgstr[2] "mangueras de cuero"

#. ~ Description of "leather hose"
#: data/json/items/tool/workshop.json
msgid ""
"This is a hose made out of leather.  Watertight and flexible, it can be used"
" to siphon fuel from a vehicle tank.  However, it's not as elastic as a "
"rubber hose."
msgstr ""
"Esta es una manguera hecha de cuero. Hermética y flexible, puede utilizarse "
"para transvasar el combustible del depósito de un vehículo. Sin embargo, no "
"es tan elástica como una manguera de goma."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "makeshift hand drill"
msgid_plural "makeshift hand drills"
msgstr[0] "taladro manual improvisado"
msgstr[1] "taladros manuales improvisados"
msgstr[2] "taladros manuales improvisados"

#. ~ Description of "makeshift hand drill"
#: data/json/items/tool/workshop.json
msgid ""
"This is a makeshift manual drill made out of pipe and improvised drill bit."
"  It is very slow and it will exhaust you quickly."
msgstr ""
"Este es un taladro manual improvisado con un tubo y una broca improvisada. "
"Es muy lento y te agotará rápidamente."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "wire draw machine"
msgid_plural "wire draw machines"
msgstr[0] "máquina de trefilado"
msgstr[1] "máquinas de trefilado"
msgstr[2] "máquinas de trefilado"

#. ~ Description of "wire draw machine"
#: data/json/items/tool/workshop.json
msgid "A machine designed specifically for turning metal rods into wire."
msgstr ""
"Una máquina diseñada específicamente para convertir varillas de metal en "
"cables."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "propane torch"
msgid_plural "propane torches"
msgstr[0] "soldador de propano"
msgstr[1] "soldadores de propano"
msgstr[2] "soldadores de propano"

#. ~ Description of "propane torch"
#: data/json/items/tool/workshop.json
msgid ""
"A compact tool kit intended for cutting metal, this portable propane torch "
"includes a torch handle and cutting attachment in an easy-to-carry tote.  It"
" requires connecting to pressurized propane cylinders before use.  While not"
" appropriate for welding, you can activate it in order to destroy metal "
"barriers."
msgstr ""
"Un kit compacto de herramientas destinadas a cortar metal, este soldador de "
"propano portátil incluye un mango de soplete y un accesorio de corte en una "
"bolsa fácil de transportar. Requiere la conexión a bombonas de propano "
"presurizadas antes de su uso. Aunque no es apropiado para soldar, se puede "
"usar para destruir barreras metálicas."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "block and tackle"
msgid_plural "blocks and tackles"
msgstr[0] "aparejo"
msgstr[1] "aparejos"
msgstr[2] "aparejos"

#. ~ Description of "block and tackle"
#: data/json/items/tool/workshop.json
msgid ""
"A sturdy housing with a number of pulleys that can be used with a thick rope"
" or a chain to gain mechanical advantage on a lift."
msgstr ""
"Una estructura resistente con un número de poleas que pueden usarse con una "
"soga o cadena gruesa para ganar ventaja mecánica al levantar cosas."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "wooden block and tackle"
msgid_plural "wooden blocks and tackles"
msgstr[0] "aparejo de madera"
msgstr[1] "aparejos de madera"
msgstr[2] "aparejos de madera"

#. ~ Description of "wooden block and tackle"
#: data/json/items/tool/workshop.json
msgid ""
"An wooden housing with a pair of pulleys that can be used with a thick rope "
"or a chain to gain mechanical advantage on a lift.  Not as durable as a "
"metal set."
msgstr ""
"Una estructura de madera con un par de poleas que pueden usarse con una soga"
" o cadena gruesa para ganar ventaja mecánica al levantar cosas. No es tan "
"resistente como el aparejo de metal."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "welding blanket"
msgid_plural "welding blankets"
msgstr[0] "manta de soldadura"
msgstr[1] "mantas de soldadura"
msgstr[2] "mantas de soldadura"

#. ~ Description of "welding blanket"
#: data/json/items/tool/workshop.json
msgid ""
"A non-flammable mat used to protect surfaces from welding splatter or to "
"insulate a weld when repairing tempered metal.  This one is made with "
"asbestos."
msgstr ""
"Una esterilla no inflamable utilizada para proteger superficies de las "
"salpicaduras de soldadura o para aislar una soldadura cuando se repara metal"
" templado. Esta está hecha de asbesto."

#. ~ Item name
#: data/json/items/vehicle/alternator.json
msgid "vehicle alternator"
msgid_plural "vehicle alternators"
msgstr[0] "alternador de vehículo"
msgstr[1] "alternadores de vehículo"
msgstr[2] "alternadores de vehículo"

#. ~ Item name
#. ~ Vehicle part name
#: data/json/items/vehicle/alternator.json
#: data/json/vehicleparts/alternator.json
msgid "car alternator"
msgid_plural "car alternators"
msgstr[0] "alternador de coche"
msgstr[1] "alternadores de coche"
msgstr[2] "alternadores de coche"

#. ~ Description of "car alternator"
#: data/json/items/vehicle/alternator.json
msgid "A standard alternator used to power vehicle electrical systems."
msgstr ""
