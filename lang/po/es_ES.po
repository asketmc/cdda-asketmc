#. ~ Name of a gun
#: data/json/items/ranged/slings.json
msgid "slingshot"
msgid_plural "slingshots"
msgstr[0] "tirachinas"
msgstr[1] "tirachinas"
msgstr[2] "tirachinas"

#. ~ Description of gun "slingshot"
#: data/json/items/ranged/slings.json
msgid ""
"A forked piece of wood with an elastic band stretched between two of its "
"tips.  Can launch tiny pebbles and similar things at high speeds."
msgstr ""
"Un trozo de madera bifurcado con una banda elástica estirada entre dos de "
"sus puntas. Puede lanzar piedrecitas y cosas similares a gran velocidad."

#. ~ Name of a gun
#: data/json/items/ranged/slings.json
msgid "staff sling"
msgid_plural "staff slings"
msgstr[0] "honda de bastón"
msgstr[1] "hondas de bastón"
msgstr[2] "hondas de bastón"

#. ~ Description of gun "staff sling"
#: data/json/items/ranged/slings.json
msgid ""
"This staff can launch rocks with a whipping motion that sends them flying "
"much further and faster than throwing them."
msgstr ""
"Este bastón puede lanzar rocas con un movimiento de látigo que las hace "
"volar mucho más lejos y más rápido que al lanzarlas."

#. ~ Name of a gun
#: data/json/items/ranged/slings.json
msgid "brace slingshot"
msgid_plural "brace slingshots"
msgstr[0] "refuerzo de tirachinas"
msgstr[1] "refuerzos de tirachinas"
msgstr[2] "refuerzos de tirachinas"

#. ~ Description of gun "brace slingshot"
#: data/json/items/ranged/slings.json
msgid ""
"A modern slingshot with a wrist brace, allowing it to fire tiny objects "
"slightly more forcefully than a simple wooden slingshot."
msgstr ""
"Un moderno tirachinas con una muñequera que permite disparar pequeños "
"objetos con algo más de fuerza que un simple tirachinas de madera."

#. ~ Item name
#: data/json/items/ranged/spearguns.json
msgid "wooden fishing spear"
msgid_plural "wooden fishing spears"
msgstr[0] "lanza de pesca de madera"
msgstr[1] "lanzas de pesca de madera"
msgstr[2] "lanzas de pesca de madera"

#. ~ Description of "wooden fishing spear"
#: data/json/items/ranged/spearguns.json
msgid ""
"An underwater fishing spear made from wood tipped with steel.  It's very "
"light, but doesn't have much range."
msgstr ""
"Un lanza para pescar submarina hecha de madera con punta de acero. Es muy "
"ligera pero no tiene mucho alcance."

#. ~ Item name
#: data/json/items/ranged/spearguns.json
msgid "carbon fiber fishing spear"
msgid_plural "carbon fiber fishing spears"
msgstr[0] "lanza de pesca de carbono"
msgstr[1] "lanzas de pesca de carbono"
msgstr[2] "lanzas de pesca de carbono"

#. ~ Description of "carbon fiber fishing spear"
#: data/json/items/ranged/spearguns.json
msgid ""
"An underwater fishing spear made from carbon fiber.  It's very light, but "
"doesn't have much range."
msgstr ""
"Un lanza para pescar submarina hecha de fibra de carbono. Es muy ligera pero"
" no tiene mucho alcance."

#. ~ Item name
#: data/json/items/ranged/spearguns.json
msgid "metal fishing spear"
msgid_plural "metal fishing spears"
msgstr[0] "lanza de pesca de metal"
msgstr[1] "lanzas de pesca de metal"
msgstr[2] "lanzas de pesca de metal"

#. ~ Description of "metal fishing spear"
#: data/json/items/ranged/spearguns.json
msgid ""
"An underwater fishing spear made from metal.  It's light, but doesn't have "
"much range."
msgstr ""
"Un lanza para pescar submarina hecha de metal. Es ligera pero no tiene mucho"
" alcance."

#. ~ Name of a gun
#: data/json/items/ranged/spearguns.json
msgid "pneumatic speargun"
msgid_plural "pneumatic spearguns"
msgstr[0] "arpón neumático"
msgstr[1] "arpones neumáticos"
msgstr[2] "arpones neumáticos"

#. ~ Description of gun "pneumatic speargun"
#: data/json/items/ranged/spearguns.json
msgid ""
"A sophisticated underwater fishing implement designed to fire a specialized "
"type of spear using a hand-pump pressure system.  While highly effective "
"when used underwater, it is nearly useless on dry land."
msgstr ""
"Una herramienta sofisticada de pesca submarina, diseñada para disparar un "
"tipo especial de lanza usando un sistema de presión bombeada a mano. Aunque "
"es muy efectiva debajo del agua, es casi inútil usarla en tierra."

#. ~ Name of a gun
#: data/json/items/ranged/spearguns.json
msgid "double speargun"
msgid_plural "double spearguns"
msgstr[0] "arpón doble"
msgstr[1] "arpones dobles"
msgstr[2] "arpones dobles"

#. ~ Description of gun "double speargun"
#: data/json/items/ranged/spearguns.json
msgid ""
"A double-loading underwater fishing implement designed to fire a specialized"
" type of spear using tension in a rubber band.  While highly effective when "
"used underwater, it is nearly useless on dry land."
msgstr ""
"Una herramienta de pesca submarina de doble carga, diseñada para disparar un"
" tipo especial de lanza usando tensión con una cinta elástica. Aunque es muy"
" efectiva debajo del agua, es casi inútil usarla en tierra."

#. ~ Name of a gun
#: data/json/items/ranged/spearguns.json
msgid "mini speargun"
msgid_plural "mini spearguns"
msgstr[0] "miniarpón"
msgstr[1] "miniarpones"
msgstr[2] "miniarpones"

#. ~ Description of gun "mini speargun"
#: data/json/items/ranged/spearguns.json
msgid ""
"A small underwater fishing implement designed to fire a specialized type of "
"spear using tension in a rubber band.  While highly effective when used "
"underwater, it is nearly useless on dry land."
msgstr ""
"Es una pequeña herramienta de pesca submarina, diseñada para disparar un "
"tipo especial de lanza usando tensión con una cinta elástica. Aunque es muy "
"efectiva debajo del agua, es casi inútil usarla en tierra."

#. ~ Name of a gun
#: data/json/items/ranged/spearguns.json
msgid "speargun"
msgid_plural "spearguns"
msgstr[0] "arpón"
msgstr[1] "arpones"
msgstr[2] "arpones"

#. ~ Description of gun "speargun"
#: data/json/items/ranged/spearguns.json
msgid ""
"An underwater fishing implement designed to fire a specialized type of spear"
" using tension in a rubber band.  While highly effective when used "
"underwater, it is nearly useless on dry land."
msgstr ""
"Una herramienta de pesca submarina, diseñada para disparar un tipo especial "
"de lanza usando tensión con una cinta elástica. Aunque es muy efectiva "
"debajo del agua, es casi inútil usarla en tierra."

#. ~ Item name
#: data/json/items/ranged/throwing.json
msgid "bolas"
msgid_plural "bolases"
msgstr[0] "boleadora"
msgstr[1] "boleadoras"
msgstr[2] "boleadoras"

#. ~ Description of "bolas"
#: data/json/items/ranged/throwing.json
msgid ""
"Some ropes with weights, designed to tangle the legs of a target when "
"thrown, usually at an animal.  Used by the Gauchos of Argentina."
msgstr ""
"Cuerdas con pesos, diseñadas para enredarse en las patas de un objetivo "
"cuando se lanzan, generalmente un animal. Utilizadas por los Gauchos de "
"Argentina."

#. ~ Item name
#: data/json/items/ranged/throwing.json
msgid "disc"
msgid_plural "discs"
msgstr[0] "disco"
msgstr[1] "discos"
msgstr[2] "discos"

#. ~ Description of "disc"
#: data/json/items/ranged/throwing.json
msgid ""
"A plastic disc made for playing disc golf.  It is smaller and denser than a "
"normal frisbee."
msgstr ""
"Un disco de plástico para jugar al golf disco. Es más pequeño y más denso "
"que un frisbi normal."

#. ~ Item name
#: data/json/items/ranged/throwing.json
msgid "frisbee"
msgid_plural "frisbees"
msgstr[0] "frisbee"
msgstr[1] "frisbees"
msgstr[2] "frisbees"

#. ~ Description of "frisbee"
#: data/json/items/ranged/throwing.json
msgid "A plastic frisbee made for outdoor games."
msgstr "Un frisbee de plástico hecho para juegos al aire libre."

#. ~ Item name
#: data/json/items/ranged/throwing.json
msgid "net"
msgid_plural "nets"
msgstr[0] "red"
msgstr[1] "redes"
msgstr[2] "redes"

#. ~ Description of "net"
#: data/json/items/ranged/throwing.json
msgid ""
"A mesh of string and weights, traditionally used to catch fish, and to "
"entangle opponents in combat."
msgstr ""
"Malla de cuerdas y pesos, tradicionalmente utilizadas para pescar y para "
"atrapar oponentes en combate."

#. ~ Item name
#: data/json/items/ranged/throwing.json
msgid "lawn dart"
msgid_plural "lawn darts"
msgstr[0] "dardo de plástico"
msgstr[1] "dardos de plástico"
msgstr[2] "dardos de plástico"

#. ~ Description of "lawn dart"
#: data/json/items/ranged/throwing.json
msgid "A large plastic dart made for outdoor games."
msgstr "Un dardo largo de plástico para deportes al aire libre."

#. ~ These are plumbatae, but that's probably not a well known word.
#. ~ Item name
#: data/json/items/ranged/throwing.json
msgid "weighted dart"
msgid_plural "weighted darts"
msgstr[0] "dardo pesado"
msgstr[1] "dardos pesados"
msgstr[2] "dardos pesados"

#. ~ These are plumbatae, but that's probably not a well known word.
#. ~ Description of "weighted dart"
#: data/json/items/ranged/throwing.json
msgid "A lead weighted dart for throwing at enemies, like the Romans used."
msgstr ""
"Un dardo pesado de plomo para tirarle a los enemigos, como los usaban los "
"romanos."

#. ~ Item name
#: data/json/items/ranged/throwing.json
msgid "throwing axe"
msgid_plural "throwing axes"
msgstr[0] "hacha arrojadiza"
msgstr[1] "hachas arrojadizas"
msgstr[2] "hachas arrojadizas"

#. ~ Description of "throwing axe"
#: data/json/items/ranged/throwing.json
msgid ""
"A lightweight hatchet made for throwing.  Its ineffective cutting edge and "
"light weight makes it unsuitable for use as a tool."
msgstr ""
"Una hacha de poco peso para ser tirada. No tiene buen filo y su poco peso la"
" hace inservible como herramienta."

#. ~ Item name
#. ~ Make silver-steel or some kind of changeling metal.
#: data/json/items/ranged/throwing.json
#: data/mods/Xedra_Evolved/items/ammo.json
msgid "throwing knife"
msgid_plural "throwing knives"
msgstr[0] "cuchillo arrojadizo"
msgstr[1] "cuchillos arrojadizos"
msgstr[2] "cuchillos arrojadizos"

#. ~ Description of "throwing knife"
#. ~ Description of "magical throwing knife"
#. ~ Make silver-steel or some kind of changeling metal.
#: data/json/items/ranged/throwing.json
#: data/mods/Magiclysm/items/ethereal_items.json
#: data/mods/Xedra_Evolved/items/ammo.json
msgid ""
"A thin and flat knife made for throwing.  Its ineffective cutting edge and "
"odd shape makes it unsuitable for use as a tool."
msgstr ""
"Un cuchillo delgado y plano hecho para ser tirado. No tiene buen filo y su "
"extraña forma lo hace inservible como herramienta."

#. ~ Item name
#: data/json/items/ranged/throwing.json
msgid "throwing stick"
msgid_plural "throwing sticks"
msgstr[0] "palo arrojadizo"
msgstr[1] "palos arrojadizos"
msgstr[2] "palos arrojadizos"

#. ~ Description of "throwing stick"
#: data/json/items/ranged/throwing.json
msgid ""
"A stick carved into a shape suitable for throwing at a target.  Not a "
"boomerang, so don't expect it to return to your hand."
msgstr ""
"Palo tallado con una forma adecuada para ser lanzada. No es un búmeran, así "
"que no esperes que vuelva a tus manos."

#. ~ Had to mess with the weight and volume to get the right range, 17-18
