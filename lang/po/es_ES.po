#: data/json/monster_weakpoints/humanoid_weakpoints.json
msgid "the weak armor on the side"
msgstr "la protección débil en el lado"

#. ~ Sentence fragment describing the "stomach_armour" weakpoint
#: data/json/monster_weakpoints/humanoid_weakpoints.json
msgid "a gap in the stomach armor"
msgstr "un hueco en la armadura del estómago"

#. ~ Sentence fragment describing the "leg" weakpoint
#: data/json/monster_weakpoints/humanoid_weakpoints.json
msgid "an unarmored part of the leg"
msgstr "una parte de la pierna desprotegida"

#. ~ Sentence fragment describing the "helmet" weakpoint
#: data/json/monster_weakpoints/humanoid_weakpoints.json
#: data/mods/classic_zombies/monsters/weakpoints.json
msgid "the helmet"
msgstr "el casco"

#. ~ Sentence fragment describing the "head" weakpoint
#. ~ Sentence fragment describing a weakpoint for monster "phase skulker"
#. ~ Sentence fragment describing a weakpoint for monster "phase shrike"
#. ~ Sentence fragment describing a weakpoint for monster "zombie technician"
#. ~ Sentence fragment describing a weakpoint for monster "zombie miner"
#: data/json/monster_weakpoints/humanoid_weakpoints.json
#: data/json/monsters/zed_lab.json data/json/monsters/zed_misc.json
#: data/mods/classic_zombies/monsters/weakpoints.json
msgid "the face"
msgstr "la cara"

#. ~ Sentence fragment describing the "neck" weakpoint
#: data/json/monster_weakpoints/humanoid_weakpoints.json
#: data/mods/classic_zombies/monsters/weakpoints.json
msgid "the neck"
msgstr "el cuello"

#. ~ Sentence fragment describing the "head" weakpoint
#: data/json/monster_weakpoints/humanoid_weakpoints.json
#: data/mods/classic_zombies/monsters/weakpoints.json
msgid "the face shield"
msgstr "el escudo facial"

#. ~ Sentence fragment describing the "eye" weakpoint
#: data/json/monster_weakpoints/humanoid_weakpoints.json
#: data/mods/classic_zombies/monsters/weakpoints.json
msgid "the goggles"
msgstr "las gafas"

#. ~ Message describing the effect of hitting the "eye" weakpoint
#: data/json/monster_weakpoints/humanoid_weakpoints.json
#: data/mods/classic_zombies/monsters/weakpoints.json
#, c-format
msgid "The %s is blinded!  The goggles, they did nothing!"
msgstr "¡%s esta cegado! ¡Las gafas, no hicieron nada!"

#. ~ Monster name
#: data/json/monsters/bird.json
msgid "chicken"
msgid_plural "chickens"
msgstr[0] "pollo"
msgstr[1] "pollos"
msgstr[2] "pollos"

#. ~ Description of monster "chicken"
#: data/json/monsters/bird.json
msgid ""
"A domesticated descendant of junglefowl, it may still be the most numerous "
"bird in the world.  Before the Cataclysm, it was raised by humans as a "
"source of meat, eggs, and early morning wakeup calls."
msgstr ""
"Un descendiente domesticado de los gallus, y puede que sea el pájaro más "
"numeroso en el mundo. Antes del Cataclismo, era criado por los humanos como "
"una fuente de carne, huevos y despertadores."

#. ~ Monster name
#: data/json/monsters/bird.json
msgid "grouse"
msgid_plural "grouses"
msgstr[0] "urogallo"
msgstr[1] "urogallos"
msgstr[2] "urogallos"

#. ~ Description of monster "grouse"
#: data/json/monsters/bird.json
msgid ""
"A very common game bird, these creatures remind you of what a wild chicken "
"must have been like."
msgstr ""
"Un ave de caza muy común, estas criaturas te recuerdan cómo debe haber sido "
"un pollo salvaje."

#. ~ Monster name
#: data/json/monsters/bird.json data/mods/Tamable_Wildlife/bird.json
msgid "crow"
msgid_plural "crows"
msgstr[0] "cuervo"
msgstr[1] "cuervos"
msgstr[2] "cuervos"

#. ~ Description of monster "crow"
#: data/json/monsters/bird.json
msgid ""
"A small, elegant black bird, famous for its distinctive call.  An "
"intelligent bird, there is a glitter of mischief behind its eyes."
msgstr ""
"Un pequeño pájaro elegante, famoso por su canto distintivo. Es un pájaro "
"inteligente, tiene un brillo travieso en sus ojos."

#. ~ Monster name
#: data/json/monsters/bird.json data/mods/Tamable_Wildlife/bird.json
msgid "raven"
msgid_plural "ravens"
msgstr[0] "cuervo"
msgstr[1] "cuervos"
msgstr[2] "cuervos"

#. ~ Description of monster "raven"
#: data/json/monsters/bird.json
msgid ""
"A small, elegant black bird, famous for its distinctive call.  A clever "
"bird, there is a glitter of mischief behind its eyes."
msgstr ""
"Un pequeño y elegante pájaro negro, famoso por su característico reclamo. Un"
" pájaro inteligente, hay un brillo de picardía detrás de sus ojos."

#. ~ Monster name
#: data/json/monsters/bird.json data/mods/Tamable_Wildlife/bird.json
msgid "blue jay"
msgid_plural "blue jays"
msgstr[0] "arrendajo azul"
msgstr[1] "arrendajos azules"
msgstr[2] "arrendajos azules"

#. ~ Description of monster "blue jay"
#: data/json/monsters/bird.json
msgid "A small, noisy bird with distinctive blue feathers."
msgstr "Un pájaro pequeño y ruidoso con un característico plumaje azul."

#. ~ Monster name
#: data/json/monsters/bird.json data/mods/Tamable_Wildlife/bird.json
msgid "cardinal"
msgid_plural "cardinals"
msgstr[0] "cardenal"
msgstr[1] "cardenales"
msgstr[2] "cardenales"

#. ~ Description of monster "cardinal"
#: data/json/monsters/bird.json
msgid ""
"A small songbird, famous for its distinctive crest and facial markings.  A "
"well-known example of sexual dimorphism, the males are colored much more "
"vibrantly than the females."
msgstr ""
"Un pequeño pájaro cantor, famoso por su cresta y sus marcas faciales "
"distintivas. Un ejemplo bien conocido de dimorfismo sexual, los machos "
"tienen un color mucho más vibrante que las hembras."

#. ~ Monster name
#: data/json/monsters/bird.json data/mods/Tamable_Wildlife/bird.json
msgid "robin"
msgid_plural "robins"
msgstr[0] "petirrojo"
msgstr[1] "petirrojos"
msgstr[2] "petirrojos"

#. ~ Description of monster "robin"
#: data/json/monsters/bird.json
msgid ""
"A brown songbird with a reddish-orange breast.  Their eggs are a distinctive"
" shade of blue."
msgstr ""
"Un pájaro cantor de color marrón con el pecho de color naranja rojizo. Sus "
"huevos son de un tono azul característico."

#. ~ Monster name
#: data/json/monsters/bird.json data/mods/Tamable_Wildlife/bird.json
msgid "sparrow"
msgid_plural "sparrows"
msgstr[0] "gorrión"
msgstr[1] "gorriones"
msgstr[2] "gorriones"

#. ~ Description of monster "sparrow"
#: data/json/monsters/bird.json
msgid ""
"A small bird with brown and gray feathers.  Introduced to North America in "
"the 1850s, it is now one of the most abundant birds in the continent."
msgstr ""
"Un pájaro pequeño con plumas marrones y grises. Llevado a América del norte "
"en la década de 1850, ahora es uno de los pájaros más abundantes en el "
"continente."

#. ~ Monster name
#: data/json/monsters/bird.json data/mods/Tamable_Wildlife/bird.json
msgid "duck"
msgid_plural "ducks"
msgstr[0] "pato"
msgstr[1] "patos"
msgstr[2] "patos"

#. ~ Description of monster "duck"
#: data/json/monsters/bird.json
msgid ""
"A mallard duck, often seen around rivers and other bodies of water.  It "
"feeds primarily on insects, seeds, roots, and, pre-Cataclysm, bread scraps."
msgstr ""
"Un pato real, a menudo visto alrededor de ríos y otras masas de agua. Se "
"alimenta principalmente de insectos, semillas, raíces y, antes del "
"Cataclismo, restos de pan."

#. ~ Monster name
#: data/json/monsters/bird.json data/mods/Tamable_Wildlife/bird.json
msgid "goose"
msgid_plural "geese"
msgstr[0] "ganso"
msgstr[1] "gansos"
msgstr[2] "gansos"

#. ~ Description of monster "goose"
#: data/json/monsters/bird.json
msgid "A Canadian goose, a common waterfowl that regrets leaving Canada."
msgstr ""
"Es un ganso canadiense, un ave acuática común que se arrepiente de haberse "
"ido de Canadá."

#. ~ Monster name
#: data/json/monsters/bird.json data/mods/Tamable_Wildlife/bird.json
msgid "turkey"
msgid_plural "turkeys"
msgstr[0] "pavo"
msgstr[1] "pavos"
msgstr[2] "pavos"

#. ~ Description of monster "turkey"
#: data/json/monsters/bird.json
msgid ""
"A large and colorful game bird native to the forests of North America.  Its "
"head and beak are covered in fleshy protuberances."
msgstr ""
"Un pájaro grande y colorido, nativo de los bosques de América del Norte. Su "
"cabeza y pico están cubiertos con protuberancias carnosas."

#. ~ Monster name
#: data/json/monsters/bird.json data/mods/Tamable_Wildlife/bird.json
msgid "pheasant"
msgid_plural "pheasants"
msgstr[0] "faisan"
msgstr[1] "faisanes"
msgstr[2] "faisanes"

#. ~ Description of monster "pheasant"
#: data/json/monsters/bird.json
msgid ""
"A medium-sized game bird that can have bright feathers depending on the sex "
"and species."
msgstr ""
"Un ave de caza de tamaño medio que puede tener plumas brillantes según el "
"sexo y la especie."

#. ~ Monster name
#: data/json/monsters/bird.json
#: data/mods/Dark-Skies-Above/overrides/monsters.json
#: data/mods/Tamable_Wildlife/bird.json
msgid "cockatrice"
msgid_plural "cockatrices"
msgstr[0] "Cocatriz"
msgstr[1] "cocatrices"
msgstr[2] "cocatrices"

#. ~ Description of monster "cockatrice"
#: data/json/monsters/bird.json
msgid ""
"This strange mutant bird gains its name from its odd appearance.  Although "
"its features seem to be becoming more reptilian, it doesn't appear "
"dangerous."
msgstr ""
"Este extraño ave mutante recibe su nombre de su extravagante apariencia. "
"Aunque pareciera que sus características se vuelven más reptilianas, no "
"parece ser peligroso."

#. ~ Monster name
#: data/json/monsters/bird.json
msgid "yellow chick"
msgid_plural "yellow chicks"
msgstr[0] "pollo amarillo"
msgstr[1] "pollos amarillos"
msgstr[2] "pollos amarillos"

#. ~ Description of monster "yellow chick"
#: data/json/monsters/bird.json
msgid ""
"A tiny yellow and brown chick, it could be from a number of different "
"species."
msgstr ""
"Es un pequeño pollito amarillo y marrón, puede ser de cualquiera de las "
"especies que hay."

#. ~ Monster name
#: data/json/monsters/bird.json
#: data/mods/TropiCataclysm/monsters/tropical_bird.json
msgid "brown chick"
msgid_plural "brown chicks"
msgstr[0] "pollo marrón"
msgstr[1] "pollos marrones"
msgstr[2] "pollos marrones"

#. ~ Description of monster "brown chick"
#: data/json/monsters/bird.json
msgid ""
"A tiny darkly-colored chick, it could be from a number of different species."
msgstr ""
"Un pequeño polluelo de color oscuro, podría ser de varias especies "
"diferentes."

#. ~ Monster name
#: data/json/monsters/bird.json
msgid "strange chick"
msgid_plural "strange chicks"
msgstr[0] "pollo extraño"
msgstr[1] "pollos extraños"
msgstr[2] "pollos extraños"

#. ~ Description of monster "strange chick"
#: data/json/monsters/bird.json
msgid "A strange tiny chick, it could be from a number of different species."
msgstr ""
"Es un pequeño pollito raro, puede ser de cualquiera de las especies que hay."

#. ~ Monster name
#: data/json/monsters/bird.json
msgid "waterfowl chick"
msgid_plural "waterfowl chicks"
msgstr[0] "pollo de aves acuáticas"
msgstr[1] "pollos de aves acuáticas"
msgstr[2] "pollos de aves acuáticas"

#. ~ Description of monster "waterfowl chick"
#: data/json/monsters/bird.json
msgid ""
"A tiny yellow and brown waterfowl chick, it could be from a number of "
"different species."
msgstr ""
"Es un pequeño pollito acuático amarillo y marrón, puede ser de cualquiera de"
" las especies que hay."

#. ~ Monster name
#: data/json/monsters/bird.json
#: data/mods/Dark-Skies-Above/overrides/monsters.json
msgid "oversized crow"
msgid_plural "oversized crows"
msgstr[0] "cuervo de gran tamaño"
msgstr[1] "cuervos de gran tamaño"
msgstr[2] "cuervos de gran tamaño"

#. ~ Description of monster "oversized crow"
#: data/json/monsters/bird.json
msgid ""
"A horrible bird grown three or four times bigger than ought to be possible "
"and sporting a swollen gut that might look comical if it weren't for the "
"razor sharp beak and the madness in its beady eyes."
msgstr ""
"Un horrible pájaro tres o cuatro veces más grande de lo que debería ser "
"posible y con una tripa hinchada que podría parecer cómica si no fuera por "
"el pico afilado y la locura en sus ojos brillantes."

#. ~ Monster name
#: data/json/monsters/bird.json
msgid "bloated corvid"
msgid_plural "bloated corvids"
msgstr[0] "córvido hinchado"
msgstr[1] "córvidos hinchados"
msgstr[2] "córvidos hinchados"

#. ~ Description of monster "bloated corvid"
#: data/json/monsters/bird.json
msgid ""
"This may have once been a crow or a raven, but now it's a deformed "
"monstrosity nearly the size of a man.  It heaves its sable bulk awkwardly "
"along the ground, too overfed on carrion to fly."
msgstr ""
"Esto puede haber sido una vez un tipo de cuervo, pero ahora es una "
"monstruosidad deforme del tamaño de un hombre. Lleva su cuerpo en el suelo, "
"demasiado alimentado con carroña para volar."

#. ~ Monster name
#: data/json/monsters/bird.json
msgid "pigeon"
msgid_plural "pigeons"
msgstr[0] "paloma"
msgstr[1] "palomas"
msgstr[2] "palomas"

#. ~ Description of monster "pigeon"
#: data/json/monsters/bird.json
msgid ""
"A gentle, plump, small-billed bird with a skin saddle, or cere, between its "
"bill and forehead.  On the ground, it struts about with a characteristic "
"bobbing of the head.  It is a strong, swift flier thanks to its long wings "
"and powerful flight muscles."
msgstr ""
"Un pájaro suave, regordete y de pico pequeño con un saliente de piel, o "
"cera, entre el pico y la frente. En el suelo, se pavonea con un "
"característico balanceo de la cabeza. Es un ave fuerte y veloz gracias a sus"
" largas alas y a sus potentes músculos de vuelo."

#. ~ Description of monster "goose"
#: data/json/monsters/bird.json
msgid ""
"The domestic goose.  A waterfowl well known for its loud honking and "
"aggressive behavior."
msgstr ""
"El ganso doméstico. Un ave acuática muy conocida por sus fuertes graznidos y"
" su comportamiento agresivo."

#. ~ Monster name
#: data/json/monsters/bird.json
msgid "royal honker"
msgid_plural "royal honkers"
msgstr[0] "ganso real"
msgstr[1] "gansos reales"
msgstr[2] "gansos reales"

#. ~ Description of monster "royal honker"
#: data/json/monsters/bird.json
msgid ""
"This strange colored goose seems larger than the rest.  Even more strange is"
" its docile, almost regal demeanor."
msgstr ""
"Este ganso de colores extraños parece más grande que el resto. Incluso más "
"extraño es su comportamiento dócil, casi real."

#. ~ Monster name
#: data/json/monsters/bird.json
msgid "hummingbird"
msgid_plural "hummingbirds"
msgstr[0] "colibrí"
msgstr[1] "colibrís"
msgstr[2] "colibrís"

#. ~ Description of monster "hummingbird"
#: data/json/monsters/bird.json
msgid ""
"A very small bird of varied colored feathers depending on species.  It flies"
" at incredible speeds while seeking nectar among flowers."
msgstr ""
"Un pájaro muy pequeño de plumas cuyos colores dependen de la especie. Vuela "
"a una velocidad increíble buscando néctar entre las flores."

#. ~ Monster name
#: data/json/monsters/bird.json
msgid "woodpecker"
msgid_plural "woodpeckers"
msgstr[0] "pájaro carpintero"
msgstr[1] "pájaros carpinteros"
msgstr[2] "pájaros carpinteros"

#. ~ Description of monster "woodpecker"
#: data/json/monsters/bird.json
msgid ""
"A small bird with woody colors and a colored crest on its head.  These birds"
" are well known for their ability to poke holes on trees while looking for "
"grubs."
msgstr ""
"Un pájaro pequeño con colores similares a la madera y cresta colorida en la "
"cabeza. Estos pájaros son conocidos por su habilidad para hacer agujeros en "
"los árboles cuando buscan larvas."

#. ~ Monster name
#: data/json/monsters/bird.json
msgid "coot"
msgid_plural "coots"
msgstr[0] "focha"
msgstr[1] "fochas"
msgstr[2] "fochas"

#. ~ Description of monster "coot"
#: data/json/monsters/bird.json
msgid ""
"A bird belonging to the Rallidae family.  They can be found worldwide on "
"freshwater habitats, including many islands in the not so distant past."
msgstr ""
"Un pájaro que pertenece a la familia Rallidae. Se pueden encontrar por todo "
"el mundo en hábitats de agua dulce, incluyendo muchas islas en un pasado no "
"tan distante."

#. ~ Monster name
#: data/json/monsters/bird.json
msgid "cormorant"
msgid_plural "cormorants"
msgstr[0] "cormoran"
msgstr[1] "cormoranes"
msgstr[2] "cormoranes"

#. ~ Description of monster "cormorant"
#: data/json/monsters/bird.json
msgid ""
"An aquatic bird with a long snake-like neck.  They are considered coastal "
"birds but many species can also be found on freshwater habitats."
msgstr ""
"Un ave acuática con el cuello largo como una serpiente. Son considerados "
"pájaros costeros pero muchas especies también pueden encontrarse en hábitats"
" de agua dulce."

#. ~ Monster name
#: data/json/monsters/bird.json
msgid "moorhen"
msgid_plural "moorhens"
msgstr[0] "gallineta"
msgstr[1] "gallinetas"
msgstr[2] "gallinetas"

#. ~ Description of monster "moorhen"
#: data/json/monsters/bird.json
msgid ""
"A bird belonging to the Rallidae family.  They are relatives of the coots "
"but have a distinctive red coloration on their heads and brownish plumage."
msgstr ""
"Un pájaro que pertenece a la familia Rallidae. Son parientes de las "
"gallaretas pero tienen una coloración roja distintiva en sus cabezas y el "
"plumaje marrón."

#. ~ Monster name
#: data/json/monsters/bird.json
msgid "grebe"
msgid_plural "grebes"
msgstr[0] "zambullidor"
msgstr[1] "zambullidores"
msgstr[2] "zambullidores"

#. ~ Description of monster "grebe"
#: data/json/monsters/bird.json
msgid ""
"A medium sized aquatic bird with a long neck.  These birds can be "
"distinguished by their strange leg placement which makes them great at "
"diving."
msgstr ""
"Un ave acuática de tamaño medio con el cuello largo. Estos pájaros pueden "
"ser distinguidos por la extraña ubicación de sus patas que las hace muy "
"buenas para bucear."

#. ~ Monster name
#: data/json/monsters/cyborgs.json
msgid "broken cyborg"
msgid_plural "broken cyborgs"
msgstr[0] "cyborg roto"
msgstr[1] "cyborgs rotos"
msgstr[2] "cyborgs rotos"

#. ~ Description of monster "broken cyborg"
#: data/json/monsters/cyborgs.json
msgid ""
"A robot body with the head of a human.  All kinds of electronic wires and "
"devices are implanted in its head.  The remaining patches of skin look "
"diseased or rotting.  This cyborg moves erratically and has a confused and "
"deranged look in its eyes.  Any personality or humanity it once had is "
"clearly gone for good."
msgstr ""
"Un cuerpo de robot con la cabeza de un humano. En su cabeza hay implantados "
"todo tipo de cables y dispositivos electrónicos. El resto de la piel parece "
"enferma o podrida. Este cíborg se mueve de forma errática y tiene una mirada"
" confusa y trastornada. Cualquier personalidad o humanidad que tuviera antes"
" ha desaparecido para siempre."

#. ~ Monster name
#: data/json/monsters/cyborgs.json
msgid "prototype cyborg"
msgid_plural "prototype cyborgs"
msgstr[0] "prototipo de ciborg"
msgstr[1] "prototipos de ciborg"
msgstr[2] "prototipos de ciborg"

#. ~ Description of monster "prototype cyborg"
#: data/json/monsters/cyborgs.json
msgid ""
"A human fused with a mess of metal parts and wires.  While their eyes are "
"empty, the flashes of pain that occasionally cross their face remind you "
"that, deep down, there is a person just like you trapped in this grotesque "
"body.  Someone with enough surgical skills might be able to restore some of "
"their humanity.  If only anyone cared…"
msgstr ""
"Un humano fusionado con un amasijo de piezas metálicas y cables. Aunque sus "
"ojos están vacíos, los destellos de dolor que de vez en cuando cruzan su "
"rostro te recuerdan que, en el fondo, hay una persona como tú atrapada en "
"este cuerpo grotesco. Alguien con la suficiente habilidad quirúrgica podría "
"devolverle algo de su humanidad. Si a alguien le importara..."

#. ~ Monster name
#: data/json/monsters/cyborgs.json
msgid "Exodii worker"
msgid_plural "Exodii workers"
msgstr[0] "trabajador Exodii"
msgstr[1] "trabajadores Exodii"
msgstr[2] "trabajadores Exodii"

#. ~ Description of monster "Exodii worker"
#: data/json/monsters/cyborgs.json
msgid "A mostly humanoid robot equipped with various construction tools."
msgstr ""
"Un robot principalmente humanoide equipado con varias herramientas de "
"construcción."

#. ~ Monster name
#: data/json/monsters/cyborgs.json
msgid "Exodii quadruped"
msgid_plural "Exodii quadrupeds"
msgstr[0] "cuadrupedo exodii"
msgstr[1] "cuadrupedos exodii"
msgstr[2] "cuadrupedos exodii"

#. ~ Description of monster "Exodii quadruped"
#: data/json/monsters/cyborgs.json
msgid ""
"This enormous quadrupedal robot seems to be cobbled together from parts, "
"most of them unfamiliar to you.  It moves with a heavy, oddly graceful gait,"
" its footsteps leaving shallow craters behind.  It bristles with an arsenal "
"of weaponry, and while it doesn't seem to be in a rush to target you, you "
"feel that you should keep your distance anyway."
msgstr ""
"Este enorme robot cuadrúpedo parece estar formado por piezas, la mayoría de "
"ellas desconocidas para ti. Se mueve con un paso pesado y extrañamente "
"elegante, y sus pisadas dejan cráteres poco profundos tras de sí. Está "
"provisto de un arsenal de armas y, aunque no parece tener prisa por "
"atacarte, crees que deberías mantener la distancia."

#. ~ Monster message of special attack of monster "Exodii quadruped"
#: data/json/monsters/cyborgs.json
msgid "The Exodii quadruped fires its weapon pod!"
msgstr "¡El cuadrúpedo Exodii dispara su arma vaina!"

