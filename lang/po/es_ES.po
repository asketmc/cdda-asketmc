#. ~ Profession name for male
#: data/json/professions.json
msgctxt "profession_male"
msgid "Police Interceptor"
msgstr "Interceptor de la Policia"

#. ~ Description of profession "Police Interceptor" for male
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"An on-duty officer, you received the call and were ready to respond to the "
"robbery.  It all went to shit, your backup got eaten, and you were lucky to "
"escape with your life and patrol car."
msgstr ""
"Como agente de policía de servicio, recibiste la llamada y estabas preparado"
" para responder al robo. Todo se fue a la mierda, te comieron los refuerzos "
"y tuviste suerte de escapar con vida y con el coche patrulla."

#. ~ Profession name for female
#: data/json/professions.json
msgctxt "profession_female"
msgid "Police Interceptor"
msgstr "Interceptora de la Policia"

#. ~ Description of profession "Police Interceptor" for female
#: data/json/professions.json
msgctxt "prof_desc_female"
