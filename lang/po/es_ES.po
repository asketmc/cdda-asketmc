msgstr[0] "par de brazaletes de acero"
msgstr[1] "pares de brazaletes de acero"
msgstr[2] "pares de brazaletes de acero"

#. ~ Description of "pair of steel bracers"
#: data/mods/Magiclysm/items/enchanted_bracers.json
msgid "A full assembly of medieval arm protection."
msgstr "Un conjunto completo de protección medieval para brazos."

#. ~ Item name
