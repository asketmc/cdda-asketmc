msgstr ""

#. ~ Sound description of spell "Mana explosion"
#. ~ Sound description of spell "Flarewhip"
#: data/mods/Magiclysm/Spells/attunements/Fire_Elemental.json
#: data/mods/Magiclysm/Spells/item_only.json
msgid "whoosh"
msgstr "whoosh"

#. ~ Spell name
#: data/mods/Magiclysm/Spells/item_only.json
msgid "Mana explosion damage"
msgstr ""

#. ~ Description of spell "Mana explosion damage"
#: data/mods/Magiclysm/Spells/item_only.json
msgid "Deal some damage to creatures, except the Alchemist."
msgstr ""

#. ~ Spell name
#: data/mods/Magiclysm/Spells/kelvinist.json
msgid "Point Flare"
msgstr "Punto de Inflamación"

#. ~ Description of spell "Point Flare"
#. ~ Kelvinist spell
#. ~ Description of "Scroll of Point Flare"
#: data/mods/Magiclysm/Spells/kelvinist.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid "Causes an intense heat at the location, damaging the target."
msgstr "Causa un intenso calor en el lugar, dañando al objetivo."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/kelvinist.json
msgid "Nova Flare"
msgstr "Nova de Llamas"

#. ~ Description of spell "Nova Flare"
#. ~ Kelvinist spell
#. ~ Description of "Scroll of Nova Flare"
#: data/mods/Magiclysm/Spells/kelvinist.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid "Causes an intense heat at the location, greatly damaging the target."
msgstr ""
"Provoca un intenso calor en el lugar, dañando enormemente al objetivo."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/kelvinist.json
msgid "Finger Firelighter"
msgstr "Dedo Encendedor de Fuegos"

#. ~ Description of spell "Finger Firelighter"
#. ~ Kelvinist spell
#. ~ Description of "Scroll of Finger Firelighter"
#: data/mods/Magiclysm/Spells/kelvinist.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid ""
"Summons a small flame that does not burn you, but you can use it to light "
"things on fire.  It seems to need you to have some intent to light things on"
" fire, because you are able to put it in your pocket with no issue."
msgstr ""
"Invoca una pequeña llama que no te quema, pero puedes usarla para prender "
"cosas. Parece que necesita que tengas alguna intención de encender cosas con"
" fuego, porque eres capaz de ponerlo en tu bolsillo sin problemas."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/kelvinist.json
msgid "Ice Spike"
msgstr "Espina de Hielo"

#. ~ Description of spell "Ice Spike"
#. ~ Kelvinist spell
#. ~ Description of "Scroll of Ice Spike"
#: data/mods/Magiclysm/Spells/kelvinist.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid ""
"Causes jagged icicles to form in the air above the target, falling and "
"damaging it."
msgstr ""
"Causa que se formen carámbanos puntiguados en el aire por encima del "
"objetivo, cayendo y dañándolo."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/kelvinist.json
msgid "Fireball"
msgstr "Bola de Fuego"

#. ~ Description of spell "Fireball"
#. ~ Kelvinist spell
#. ~ Description of "Scroll of Fireball"
#: data/mods/Magiclysm/Spells/kelvinist.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid ""
"You hurl a pea-sized glowing orb that when reaches its target or an obstacle"
" produces a pressure-less blast of searing heat."
msgstr ""
"Lanzas un orbe brillante del tamaño de un guisante que al llegar a su "
"objetivo o a un obstáculo produce una ráfaga sin presión de calor abrasador."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/kelvinist.json
msgid "Cone of Cold"
msgstr "Cono de Hielo"

#. ~ Spell name
#: data/mods/Magiclysm/Spells/kelvinist.json
msgid "Burning Hands"
msgstr "Manos Ardientes"

#. ~ Description of spell "Burning Hands"
#. ~ Kelvinist spell
#. ~ Description of "Scroll of Burning Hands"
#: data/mods/Magiclysm/Spells/kelvinist.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid ""
"You're pretty sure you saw this in a game somewhere.  You fire a short-range"
" cone of fire."
msgstr ""
"Estás bastante seguro de que viste esto en un juego en alguna parte. "
"Disparas un cono de fuego de corto alcance."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/kelvinist.json
msgid "Frost Spray"
msgstr "Rociado de Escarcha"

#. ~ Description of spell "Frost Spray"
#. ~ Kelvinist spell
#. ~ Description of "Scroll of Frost Spray"
#: data/mods/Magiclysm/Spells/kelvinist.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid ""
"You're pretty sure you saw this in a game somewhere.  You fire a short-range"
" cone of ice and cold."
msgstr ""
"Estás bastante seguro de que viste esto en un juego en alguna parte. "
"Disparas un cono de corto alcance de hielo y frío."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/kelvinist.json
msgid "Chilling Touch"
msgstr "Toque Escalofriante"

#. ~ Description of spell "Chilling Touch"
#. ~ Kelvinist spell
#. ~ Description of "Scroll of Chilling Touch"
#: data/mods/Magiclysm/Spells/kelvinist.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid "Freezes the touched target with intense cold."
msgstr "Congela el objetivo tocado con un frío intenso."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/kelvinist.json
msgid "Glide on Ice"
msgstr "Deslizado de Hielo"

#. ~ Description of spell "Glide on Ice"
#. ~ Description of spell "Enhanced Glide on Ice"
#. ~ Kelvinist spell
#. ~ Description of "Scroll of Glide on Ice"
#: data/mods/Magiclysm/Spells/kelvinist.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid ""
"Encases your feet in a magical coating of ice, allowing you to glide along "
"smooth surfaces faster."
msgstr ""
"Encierra los pies en una mágica capa de hielo, permitiéndote deslizarte por "
"superficies lisas más rápido."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/kelvinist.json
msgid "Enhanced Glide on Ice"
msgstr ""

#. ~ Spell name
#: data/mods/Magiclysm/Spells/kelvinist.json
#: data/mods/Xedra_Evolved/monsters/monster_spells.json
msgid "Hoary Blast"
msgstr "Explosión de Escarcha"

#. ~ Description of spell "Hoary Blast"
#. ~ Kelvinist spell
#. ~ Description of "Scroll of Hoary Blast"
#: data/mods/Magiclysm/Spells/kelvinist.json
#: data/mods/Magiclysm/items/spell_scrolls.json
#: data/mods/Xedra_Evolved/monsters/monster_spells.json
msgid ""
"You project a glowing white crystal of ice and it explodes on impact into a "
"blossom of shattering cold."
msgstr ""
"Proyectas un brillante cristal blanco de hielo y explota al impactar en un "
"brote de frío desgarrador."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/kelvinist.json
msgid "Ice Shield"
msgstr "Escudo de Hielo"

#. ~ Description of spell "Ice Shield"
#. ~ Kelvinist spell
#. ~ Description of "Scroll of Ice Shield"
#: data/mods/Magiclysm/Spells/kelvinist.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid ""
"Creates a magical shield of ice on your arm, you can defend yourself with it"
" in melee combat and use it to bash."
msgstr ""
"Crea un escudo mágico de hielo en tu brazo, puedes defenderte con él en el "
"combate c. a c. y usarlo para golpear."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/kelvinist.json
msgid "Enhanced Ice Shield"
msgstr ""

#. ~ Description of spell "Enhanced Ice Shield"
#: data/mods/Magiclysm/Spells/kelvinist.json
msgid ""
"Creates a magical shield of ice on your arm, you can defend yourself with it"
" in melee combat and use it to bash.  Now you know this spell like the back "
"of your hand, and start to design your own version."
msgstr ""

#. ~ Spell name
#: data/mods/Magiclysm/Spells/kelvinist.json
msgid "Frost Armor"
msgstr "Armadura de Escarcha"

#. ~ Description of spell "Frost Armor"
#. ~ Description of spell "Enhanced Frost Armor"
#. ~ Kelvinist spell
#. ~ Description of "Scroll of Frost Armor"
#: data/mods/Magiclysm/Spells/kelvinist.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid "Covers you in a thin layer of magical ice to protect you from harm."
msgstr "Te cubre con una fina capa de hielo mágico que te protege del daño."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/kelvinist.json
msgid "Enhanced Frost Armor"
msgstr ""

#. ~ Spell name
#: data/mods/Magiclysm/Spells/kelvinist.json
msgid "Kelvinist Rune"
msgstr "Runa Kelvinista"

#. ~ Description of spell "Kelvinist Rune"
#: data/mods/Magiclysm/Spells/kelvinist.json
msgid ""
"This ritual creates a small pebble attuned to Kelvinists.  You can use the "
"rune as a catalyst for recipes."
msgstr ""
"Este ritual crea un pequeño guijarro en sintonía con los kelvinistas. Puedes"
" usar la runa como catalizador para las recetas."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/kelvinist.json
msgid "Flamesword"
msgstr "Espada Flamígera"

#. ~ Description of spell "Flamesword"
#: data/mods/Magiclysm/Spells/kelvinist.json
msgid ""
"This spell ignites a wooden sword, creating a flaming blade able to burn, "
"bruise, and chop."
msgstr ""
"Este hechizo enciende una espada de madera, creando una hoja en llamas capaz"
" de quemar, magullar y cortar."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/kelvinist.json
msgid "Enhanced Flamesword"
msgstr ""

#. ~ Description of spell "Enhanced Flamesword"
#: data/mods/Magiclysm/Spells/kelvinist.json
msgid ""
"This spell ignites a wooden sword, creating a flaming blade able to burn, "
"bruise, and chop.  Now you know this spell like the back of your hand, and "
"start to design your own version."
msgstr ""

#. ~ Spell name
#: data/mods/Magiclysm/Spells/kelvinist.json
msgid "Flamebreath"
msgstr "Aliento de Llama"

#. ~ Description of spell "Flamebreath"
#: data/mods/Magiclysm/Spells/kelvinist.json
msgid ""
"This spell ignites dust scattered in the air, creating a cone of flame.  The"
" hot ashes can cling to targets, causing additional burns over time."
msgstr ""
"Este hechizo enciende el polvo disperso en el aire, creando un cono de "
"llamas. Las cenizas calientes pueden adherirse a los objetivos, causando "
"quemaduras adicionales con el tiempo."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/kelvinist.json
msgid "Freezing Touch"
msgstr "Toque Congelante"

#. ~ Description of spell "Freezing Touch"
#. ~ Kelvinist spell
#. ~ Description of "Scroll of freezing touch"
#: data/mods/Magiclysm/Spells/kelvinist.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid ""
"Your hands freeze anything they touch at temperatures so cold it slows down "
"your foes."
msgstr ""
"Tus manos congelan todo lo que tocan a temperaturas tan frías que ralentiza "
"a tus enemigos."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/lizardfolk_shaman.json
msgid "Summon Crocodile"
msgstr "Invocar Cocodrilo"

#. ~ Description of spell "Summon Crocodile"
#: data/mods/Magiclysm/Spells/lizardfolk_shaman.json
msgid "Summons a permanent crocodile."
msgstr "Invoca un cocodrilo permanente"

#. ~ Message of spell "Summon Crocodile"
#: data/mods/Magiclysm/Spells/lizardfolk_shaman.json
msgid "The shaman summons a crocodile!"
msgstr "¡El chamán invoca un cocodrilo!"

#. ~ Spell name
#: data/mods/Magiclysm/Spells/lizardfolk_shaman.json
msgid "An Ancient Reptilian Spell"
msgstr ""

#. ~ Description of spell "An Ancient Reptilian Spell"
#: data/mods/Magiclysm/Spells/lizardfolk_shaman.json
msgid "Causes one of the shaman spells to be cast."
msgstr "Hace que uno de los hechizos de chamán sea lanzado."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/magus.json
msgid "Shadow Field"
msgstr "Campo de Sombras"

#. ~ Description of spell "Shadow Field"
#: data/mods/Magiclysm/Spells/magus.json
msgid "Cast a field of intense shadows."
msgstr "Lanza un campo de sombras."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/magus.json
msgid "Magic Missile"
msgstr "Misil Mágico"

#. ~ Description of spell "Magic Missile"
#. ~ Magus spell
#. ~ Description of "Scroll of Magic Missile"
#: data/mods/Magiclysm/Spells/magus.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid "I cast Magic Missile at the darkness!"
msgstr "Lanza un misil mágico a un objetivo que es capaz de atravesar muros. "

#. ~ Spell name
#: data/mods/Magiclysm/Spells/magus.json
msgid "Phase Door"
msgstr "Puerta de fase"

#. ~ Description of spell "Phase Door"
#. ~ Magus spell
#. ~ Description of "Scroll of Phase Door"
#: data/mods/Magiclysm/Spells/magus.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid "Teleports you in a random direction a short distance."
msgstr "Te teletransporta en una dirección aleatoria a una distancia corta."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/magus.json
msgid "Dimension Door"
msgstr "Puerta Dimensional"

#. ~ Description of spell "Dimension Door"
#: data/mods/Magiclysm/Spells/magus.json
msgid "Teleports you randomly near a target location."
msgstr "Te teletransporta aleatoriamente cerca de un lugar objetivo."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/magus.json
msgid "Gravity Well"
msgstr "Pozo de Gravedad"

#. ~ Description of spell "Gravity Well"
#. ~ Magus spell
#. ~ Description of "Scroll of Gravity Well"
#: data/mods/Magiclysm/Spells/magus.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid ""
"Summons a well of gravity with the epicenter at the location.  Deals bashing"
" damage to all creatures in the affected area."
msgstr ""
"Conjura un pozo de gravedad con el epicentro en el lugar que elijas. Causa "
"daño contundente a todas las criaturas afectadas en el área."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/magus.json
msgid "Mana Blast"
msgstr "Explosión de Maná"

#. ~ Description of spell "Mana Blast"
#. ~ Magus spell
#. ~ Description of "Scroll of Mana Blast"
#: data/mods/Magiclysm/Spells/magus.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid "A blast of concentrated magical power that obliterates a large area."
msgstr "Una explosión de poder mágico concentrado que destruye una gran área."

#. ~ Description of spell "Mana Bolt"
#. ~ Magus spell
#. ~ Description of "Scroll of Mana Bolt"
#: data/mods/Magiclysm/Spells/magus.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid "A bolt of magical power that only damages your foes."
msgstr "Un rayo de poder mágico que sólo daña a tus enemigos."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/magus.json
#: data/mods/Xedra_Evolved/spells/vampire_spells.json
msgid "Haste"
msgstr "Apresurarse"

#. ~ Description of spell "Haste"
#. ~ Magus spell
#. ~ Description of "Scroll of Haste"
#: data/mods/Magiclysm/Spells/magus.json
#: data/mods/Magiclysm/items/spell_scrolls.json
#: data/mods/Xedra_Evolved/spells/vampire_spells.json
msgid ""
"This spell gives you an enormous boost of speed lasting a short period of "
"time."
msgstr ""
"Este hechizo te da un enorme impulso de velocidad que dura un corto período "
"de tiempo."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/magus.json
msgid "Baleful Polymorph"
msgstr "Polimorfia Maligna"

#. ~ Description of spell "Baleful Polymorph"
#. ~ Technomancer spell
#. ~ Description of "Scroll of Baleful Polymorph"
#: data/mods/Magiclysm/Spells/magus.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid "Transform your enemies into frogs."
msgstr "Transformas a tus enemigos en ranas."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/magus.json
msgid "Mana Beam"
msgstr "Rayo de Maná"

#. ~ Description of spell "Mana Beam"
#. ~ Magus spell
#. ~ Description of "Scroll of Mana Beam"
#: data/mods/Magiclysm/Spells/magus.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid "A beam of focused magical power that damages any foes in its path."
msgstr ""
"Un rayo de poder mágico enfocado que daña a cualquier enemigo en su camino."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/magus.json
msgid "Escape"
msgstr "Escapar"

#. ~ Description of spell "Escape"
#. ~ Magus spell
#. ~ Description of "Scroll of Escape"
#: data/mods/Magiclysm/Spells/magus.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid ""
"Teleports you in a random direction a medium distance, to help escape your "
"foes in dangerous situations."
msgstr ""
"Te teletransporta en una dirección aleatoria a media distancia, para "
"ayudarte a escapar de tus enemigos en situaciones peligrosas."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/magus.json
msgid "Magus Rune"
msgstr "Runa Magus"

#. ~ Description of spell "Magus Rune"
#: data/mods/Magiclysm/Spells/magus.json
msgid ""
"This ritual creates a small pebble attuned to Magi.  You can use the rune as"
" a catalyst for recipes."
msgstr ""
"Este ritual crea un pequeño guijarro en sintonía con los Magi. Puedes usar "
"la runa como catalizador para las recetas."

#. ~ Spell name
#. ~ Name of effect type id "cats_grace"
#: data/mods/Magiclysm/Spells/magus.json
#: data/mods/Magiclysm/effects/effects.json
msgid "Cat's Grace"
msgstr "Gracia de Gato"

#. ~ Description of spell "Cat's Grace"
#. ~ Magus spell
#. ~ Description of "Scroll of Cat's Grace"
#: data/mods/Magiclysm/Spells/magus.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid "You become more graceful, agile, and coordinated."
msgstr "Te vuelves más grácil, ágil y coordinado."

#. ~ Spell name
#. ~ Name of effect type id "eagles_sight"
#: data/mods/Magiclysm/Spells/magus.json
#: data/mods/Magiclysm/effects/effects.json
msgid "Eagle's Sight"
msgstr "Vista de Aguila"

#. ~ Description of spell "Eagle's Sight"
#. ~ Magus spell
#. ~ Description of "Scroll of Eagle's Sight"
#: data/mods/Magiclysm/Spells/magus.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid "You gain the perception of an eagle."
msgstr "Obtienes la percepción de un águila."

#. ~ Spell name
#. ~ Name of effect type id "ogres_strength"
#: data/mods/Magiclysm/Spells/magus.json
#: data/mods/Magiclysm/effects/effects.json
msgid "Ogre's Strength"
msgstr "Fuerza de Ogro"

#. ~ Description of spell "Ogre's Strength"
#. ~ Magus spell
#. ~ Description of "Scroll of Ogre's Strength"
#: data/mods/Magiclysm/Spells/magus.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid "You gain the strength of an ogre."
msgstr "Obtienes la fuerza de un ogro."

#. ~ Spell name
#. ~ Name of effect type id "foxs_cunning"
#: data/mods/Magiclysm/Spells/magus.json
#: data/mods/Magiclysm/effects/effects.json
msgid "Fox's Cunning"
msgstr "Astucia de Zorro"

#. ~ Description of spell "Fox's Cunning"
#. ~ Magus spell
#. ~ Description of "Scroll of Fox's Cunning"
#: data/mods/Magiclysm/Spells/magus.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid "You become wily like a fox."
msgstr "Te vuelves astuto como un zorro."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/magus.json
msgid "Jar of Force"
msgstr "Tarro de Fuerza"

#. ~ Description of spell "Jar of Force"
#: data/mods/Magiclysm/Spells/magus.json
msgid "Summon a jar of force in which you can store liquids."
msgstr "Invoca un tarro de fuerza en el cual puedes almacenar líquidos."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/magus.json
msgid "Impact Sling"
msgstr "Honda de Impacto"

#. ~ Description of spell "Impact Sling"
#: data/mods/Magiclysm/Spells/magus.json
msgid ""
"This spell infuses a sling with tremendous force, delivering devastating "
"pebble shots until the energy tears it apart."
msgstr ""
"Este hechizo infunde a una honda con una fuerza tremenda, lanzando "
"devastadores disparos de guijarros hasta que la energía se deshace."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/magus.json
msgid "Enhanced Impact Sling"
msgstr ""

#. ~ Description of spell "Enhanced Impact Sling"
#: data/mods/Magiclysm/Spells/magus.json
msgid ""
"This spell infuses a sling with tremendous force, delivering devastating "
"pebble shots until the energy tears it apart.  Now you know this spell like "
"the back of your hand, and start to design your own version."
msgstr ""

#. ~ Spell name
#: data/mods/Magiclysm/Spells/magus.json
msgid "Focused Bolt"
msgstr "Saeta Enfocada"

#. ~ Description of spell "Focused Bolt"
#: data/mods/Magiclysm/Spells/magus.json
msgid ""
"You focus your mana into a microscopically thin pulsed beam of pure energy, "
"capable of extreme range and precision; as well as unparalleled penetration,"
" provided proper skill.  Once the invention of a notorious assassin, this "
"spell has slain many a king and noble.  Passed on only through direct "
"descendants over the ages, though occasionally shared by them to others."
msgstr ""
"Concentras tu maná en un rayo microscópico de energía pura, capaz de un "
"alcance y una precisión extremos, así como de una penetración sin parangón, "
"siempre que tengas la habilidad adecuada. Este hechizo, que en su día fue la"
" invención de un famoso asesino, ha matado a muchos reyes y nobles. Sólo "
"transmitido a través de los descendientes directos a lo largo de los años, "
"si bien en ocasiones compartido por ellos con otros."

#. ~ Description of spell "Crystallize Mana"
#: data/mods/Magiclysm/Spells/manatouched.json
msgid ""
"Crystallizes mana into solid form.  Your physiological changes have made "
"this spell much more efficient and easier to cast."
msgstr ""
"Cristaliza maná en forma sólida. Sus cambios fisiológicos han hecho que este"
" hechizo sea mucho más eficiente y fácil de lanzar."

#. ~ Spell name
#. ~ Mutation name
#: data/mods/Magiclysm/Spells/manatouched.json
#: data/mods/Magiclysm/traits/manatouched.json
msgid "Seeker Bolts"
msgstr "Saetas Buscadoras"

#. ~ Description of spell "Seeker Bolts"
#: data/mods/Magiclysm/Spells/manatouched.json
msgid ""
"Fires bolts of mana from your fingertips that home in on randomly selected "
"targets in range."
msgstr ""
"Dispara saetas de maná desde la punta de tus dedos que se dirigen a "
"objetivos seleccionados al azar dentro del alcance."

#. ~ Sound description of spell "Seeker Bolts"
#: data/mods/Magiclysm/Spells/manatouched.json
msgid "a zing"
msgstr "una chispa"

#. ~ Spell name
#: data/mods/Magiclysm/Spells/monsterspells.json
msgid "Blood Suck"
msgstr "Chupa la Sangre"

#. ~ Description of spell "Blood Suck"
#. ~ Description of spell "Sucking bite"
#: data/mods/Magiclysm/Spells/monsterspells.json
#: data/mods/Xedra_Evolved/monster_special_attacks/monster_special_attacks.json
msgid "Sucks blood from one foe."
msgstr "Chupa la sangre de un enemigo."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/monsterspells.json
msgid "Bear Trap"
msgstr "Trampa de Oso"

#. ~ Description of spell "Bear Trap"
#: data/mods/Magiclysm/Spells/monsterspells.json
msgid "A trap that summons bears!  Not what you were expecting, is it?"
msgstr "¡Una trampa que invoca osos! No es lo que esperabas, ¿verdad?"

#. ~ Sound description of spell "Bear Trap"
#. ~ Sound description of spell "Forge Trap"
#: data/mods/Magiclysm/Spells/monsterspells.json
