msgid_plural "resonating gorgets"
msgstr[0] "gorjal resonante"
msgstr[1] "gorjales resonantes"
msgstr[2] "gorjales resonantes"

#. ~ Description of "resonating gorget"
#: data/json/items/armor/exotic.json
