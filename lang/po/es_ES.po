#. ~ Variant name of item "gift card"
#: data/json/items/generic/mail.json
msgid "$10 gift card"
msgid_plural "$10 gift cards"
msgstr[0] "tarjeta de regalo de $10"
msgstr[1] "tarjetas de regalo de $10"
msgstr[2] "tarjetas de regalo de $10"

#. ~ Description of variant "$10 gift card" of item "gift card"
#: data/json/items/generic/mail.json
msgid ""
"A $10 gift card, redeemable for purchases at your local hardware store."
msgstr ""
"Una tarjeta de regalo de $10 que se puede canjear por compras en una "
"ferretería local."

#. ~ Item name
#. ~ Variant name of item "greeting card"
#: data/json/items/generic/mail.json
msgid "greeting card"
msgid_plural "greeting cards"
msgstr[0] "tarjeta de felicitación"
msgstr[1] "tarjetas de felicitación"
msgstr[2] "tarjetas de felicitación"

#. ~ Description of "greeting card"
#: data/json/items/generic/mail.json
msgid "A piece of card stock meant to convey an expression of sentiment."
msgstr "Es una tarjeta de cartulina diseñada para expresar un sentimiento."

#. ~ Description of variant "greeting card" of item "greeting card"
#: data/json/items/generic/mail.json
msgid ""
"A greeting card for expressing best wishes.  Its corners are decorated with "
"paintings of flowers and leaves."
msgstr ""
"Una tarjeta de felicitación para expresar tus mejores deseos. Sus esquinas "
"están decoradas con dibujos de flores y hojas."

#. ~ Variant name of item "greeting card"
#: data/json/items/generic/mail.json
msgid "baby shower card"
msgid_plural "baby shower cards"
msgstr[0] "tarjeta de baby shower"
msgstr[1] "tarjetas de baby shower"
msgstr[2] "tarjetas de baby shower"

#. ~ Description of variant "baby shower card" of item "greeting card"
#: data/json/items/generic/mail.json
msgid ""
"A baby blue greeting card with a drawing of a teddy bear holding an "
"umbrella.  Words printed on it read: \"It's getting closer by the hour, so "
"let's have a baby shower!\""
msgstr ""
"Es una tarjeta celeste de saludo con el dibujo de un osito de peluche con un"
" paraguas. Las palabras impresas dicen: \"Ya se está acercando así que "
"¡hagamos un baby shower!\""

#. ~ Variant name of item "greeting card"
#: data/json/items/generic/mail.json
msgid "birthday card"
msgid_plural "birthday cards"
msgstr[0] "tarjeta de cumpleaño"
msgstr[1] "tarjetas de cumpleaños"
msgstr[2] "tarjetas de cumpleaños"

#. ~ Description of variant "birthday card" of item "greeting card"
#: data/json/items/generic/mail.json
msgid ""
"A greeting card given to a person to celebrate their birthday.  This one has"
" a floral design."
msgstr ""
"Una tarjeta de felicitación que se da a una persona en su cumpleaños. Esta "
"tiene un diseño floral."

#. ~ Variant name of item "greeting card"
#: data/json/items/generic/mail.json
msgid "congratulations card"
msgid_plural "congratulations cards"
msgstr[0] "tarjeta de felicitaciones"
msgstr[1] "tarjetas de felicitaciones"
msgstr[2] "tarjetas de felicitaciones"

#. ~ Description of variant "congratulations card" of item "greeting card"
#: data/json/items/generic/mail.json
msgid ""
"This greeting card displays a picture of a graduate tossing their graduation"
" cap.  Above the cap is the word 'CONGRATULATIONS'."
msgstr ""
"Esta tarjeta de felicitación muestra la imagen de un graduado lanzando su "
"birrete de graduación. Encima del birrete aparece la palabra "
"\"FELICIDADES\"."

#. ~ Variant name of item "greeting card"
#: data/json/items/generic/mail.json
msgid "farewell card"
msgid_plural "farewell cards"
msgstr[0] "tarjeta de despedida"
msgstr[1] "tarjetas de despedida"
msgstr[2] "tarjetas de despedida"

#. ~ Description of variant "farewell card" of item "greeting card"
#: data/json/items/generic/mail.json
msgid ""
"This is a white greeting card with a stylized drawing of an empty road.  "
"Words printed on it read: \"You're going places (literally).  Wishing you "
"the best!\""
msgstr ""
"Se trata de una tarjeta de despedida blanca con un dibujo estilizado de una "
"carretera vacía. Las palabras impresas en ella dicen: \"Vas a llegar lejos "
"(literalmente). Te deseo lo mejor\"."

#. ~ Variant name of item "greeting card"
#: data/json/items/generic/mail.json
msgid "friendship card"
msgid_plural "friendship cards"
msgstr[0] "tarjeta de amistad"
msgstr[1] "tarjetas de amistad"
msgstr[2] "tarjetas de amistad"

#. ~ Description of variant "friendship card" of item "greeting card"
#: data/json/items/generic/mail.json
msgid ""
"A greeting card with a stylized picture of a donut and a coffee cup.  Above "
"the picture, it says 'I am thankful for our friendship' and below are the "
"words 'we are better together'."
msgstr ""
"Tarjeta de saludo con una imagen estilizada de un donut y una taza de café. "
"Encima de la imagen, dice \"Estoy agradecido por nuestra amistad\" y debajo "
"las palabras \"somos mejores juntos\"."

#. ~ Variant name of item "greeting card"
#: data/json/items/generic/mail.json
msgid "get well card"
msgid_plural "get well cards"
msgstr[0] "tarjeta de ponte bien"
msgstr[1] "tarjetas de ponte bien"
msgstr[2] "tarjetas de ponte bien"

#. ~ Description of variant "get well card" of item "greeting card"
#: data/json/items/generic/mail.json
msgid ""
"This greeting card displays a cartoon turtle in a cozy blanket sipping hot "
"tea.  Above the turtle, it says 'Wishing you a SPEEDY recovery!'"
msgstr ""
"Esta tarjeta de felicitación enseña un dibujo de una tortuga en una manta "
"cuca sorbiendo te caliente. Encima de la tortuga dice, 'Espero que te "
"recuperes pronto!'"

#. ~ Variant name of item "greeting card"
#: data/json/items/generic/mail.json
msgid "retirement card"
msgid_plural "retirement cards"
msgstr[0] "tarjeta de jubilación"
msgstr[1] "tarjetas de jubilación"
msgstr[2] "tarjetas de jubilación"

#. ~ Description of variant "retirement card" of item "greeting card"
#: data/json/items/generic/mail.json
msgid ""
"A greeting card wishing the recipient a long and happy retirement.  This one"
" displays a drawing of a rocking chair surrounded with white roses."
msgstr ""
"Una tarjeta de saludo deseándole al receptor una jubilación larga y feliz. "
"Tiene la imagen de una silla mecedora rodeada de rosas blancas."

#. ~ Variant name of item "greeting card"
#: data/json/items/generic/mail.json
msgid "sympathy card"
msgid_plural "sympathy cards"
msgstr[0] "tarjeta de simpatía"
msgstr[1] "tarjetas de simpatía"
msgstr[2] "tarjetas de simpatía"

#. ~ Description of variant "sympathy card" of item "greeting card"
#: data/json/items/generic/mail.json
msgid ""
"A black greeting card with a picture of a dimly lit candle.  Words printed "
"on it read: \"Please accept our deepest and most heartfelt condolences at "
"this challenging time.\""
msgstr ""
"Una tarjeta negra de saludo con una imagen de una vela encendida. Las "
"palabras impresas dicen: \"Por favor, acepta nuestras más sinceras "
"condolencias en estos tiempos difíciles.\""

#. ~ Variant name of item "greeting card"
#: data/json/items/generic/mail.json
msgid "thank you card"
msgid_plural "thank you cards"
msgstr[0] "tarjeta de agradecimiento"
msgstr[1] "tarjetas de agradecimiento"
msgstr[2] "tarjetas de agradecimiento"

#. ~ Description of variant "thank you card" of item "greeting card"
#: data/json/items/generic/mail.json
msgid ""
"A plain white greeting card featuring an expression of gratitude to the "
"recipient."
msgstr ""
"Una simple tarjeta blanca de saludo con una expresión de gratitud para el "
"receptor."

#. ~ Item name
#: data/json/items/generic/music.json
msgid "XLR cable"
msgid_plural "XLR cables"
msgstr[0] "cable XLR"
msgstr[1] "cables XLR"
msgstr[2] "cables XLR"

#. ~ Description of "XLR cable"
#: data/json/items/generic/music.json
msgid ""
"A balanced cable used for sending audio signal.  The connectors have three "
"prongs."
msgstr ""
"Un cable balanceado usado para enviar la señal de audio. Los conectores "
"tienen tres puntas."

#. ~ Item name
#: data/json/items/generic/music.json
msgid "speaker cable"
msgid_plural "speaker cables"
msgstr[0] "cable de altavoz"
msgstr[1] "cables de altavoz"
msgstr[2] "cables de altavoz"

#. ~ Description of "speaker cable"
#: data/json/items/generic/music.json
msgid ""
"This audio cable connects one speaker to a powered head, or one speaker to "
"another."
msgstr ""
"Este cable de audio conecta un altavoz a un cabezal motorizado, o un altavoz"
" a otro."

#. ~ Item name
#: data/json/items/generic/music.json
msgid "instrument cable"
msgid_plural "instrument cables"
msgstr[0] "cable de instrumento"
msgstr[1] "cables de instrumentos"
msgstr[2] "cables de instrumentos"

#. ~ Description of "instrument cable"
#: data/json/items/generic/music.json
msgid ""
"Known as an instrument cable because it is usually used to connect a guitar "
"to a powered amp, it is an unbalanced cable with 1/4\" male connectors on "
"each side."
msgstr ""
"Conocido como un cable para instrumentos porque se usa normalmente para "
"conectar una guitarra a un amplificador alimentado, es un cable "
"desbalanceado con conectores macho de 1/4 de pulgada a cada lado."

#. ~ Item name
#: data/json/items/generic/music.json
msgid "headphones"
msgid_plural "headphones"
msgstr[0] "auricular"
msgstr[1] "auriculares"
msgstr[2] "auriculares"

#. ~ Description of "headphones"
#: data/json/items/generic/music.json
msgid ""
"A pair of headphones that cover your ears for improved sound quality and "
"private listening.  This pair is from a well-known brand that is very high "
"quality, with a detachable 1/8\" cable.  Comes with a 1/8\" to 1/4\" "
"adaptor."
msgstr ""
"Un par de auriculares que cubren tus orejas para mejorar la calidad de "
"sonido y poder escuchar en privado. Este par es de una marca muy conocida "
"por su gran calidad, con cable desmontable de 1/8\". Viene con un adaptador "
"de 1/8\" a 1/4\"."

#. ~ Item name
#: data/json/items/generic/music.json
msgid "XLR microphone"
msgid_plural "XLR microphones"
msgstr[0] "micrófono XLR"
msgstr[1] "micrófonos XLR"
msgstr[2] "micrófonos XLR"

#. ~ Description of "XLR microphone"
#: data/json/items/generic/music.json
msgid ""
"A microphone used to record or amplify sound.  Comes with a clip.  Has a "
"3-pin XLR connector on the bottom in order to connect to an amp."
msgstr ""
"Un micrófono utilizado para grabar o amplificar sonidos. Viene con un clip. "
"Tiene un conector XLR de 3 pines en la parte de abajo para poder conectarlo "
"a un amplificador."

#. ~ Item name
#: data/json/items/generic/music.json
msgid "microphone stand"
msgid_plural "microphone stands"
msgstr[0] "soporte de micrófono"
msgstr[1] "soportes de micrófono"
msgstr[2] "soportes de micrófono"

#. ~ Description of "microphone stand"
#: data/json/items/generic/music.json
msgid ""
"A lightweight telescoping boom stand made of aluminum and painted black.  "
"About 6' tall when full extended, or 3' when closed fully.  Has threads for "
"a mic clip on one end."
msgstr ""
"Un soporte telescópico ligero de aluminio pintado de negro. Alrededor de 6 "
"pies de altura cuando está completamente extendido, o 3 pies cuando está "
"completamente cerrado. Tiene hilos para un clip de micrófono en un extremo."

#. ~ Item name
#: data/json/items/generic/music.json
msgid "guitar stand"
msgid_plural "guitar stands"
msgstr[0] "soporte de guitarra"
msgstr[1] "soportes de guitarra"
msgstr[2] "soportes de guitarra"

#. ~ Description of "guitar stand"
#: data/json/items/generic/music.json
msgid ""
"A small, oddly-shaped piece of aluminum hardware with three legs.  When "
"placed on the ground, this can support one guitar in an upright position."
msgstr ""
"Una pequeña y extraña pieza de aluminio con tres patas. Cuando se coloca en "
"el suelo, puede soportar una guitarra en posición vertical."

#. ~ Item name
#: data/json/items/generic/music.json
msgid "plectrum"
msgid_plural "plectra"
msgstr[0] "plectro"
msgstr[1] "plectros"
msgstr[2] "plectros"

#. ~ Description of "plectrum"
#: data/json/items/generic/music.json
msgid ""
"A flat piece of plastic with a pointed tip, designed for plucking the "
"strings of an instrument."
msgstr ""
"Un pedazo plano de plástico con terminación en punta, diseñado para tocar "
"las cuerdas de un instrumento."

#. ~ Item name
#: data/json/items/generic/music.json
msgid "mixer"
msgid_plural "mixers"
msgstr[0] "mezcladora"
msgstr[1] "mezcladoras"
msgstr[2] "mezcladoras"

#. ~ Description of "mixer"
#: data/json/items/generic/music.json
msgid ""
"A device with faders, switches, and knobs that mixes input signal and sends "
"it to two output XLR cables, a left one and a right one."
msgstr ""
"Un dispositivo con reguladores, interruptores y ruedas que mezcla la señal "
"entrante y la envía a dos cables XLR de salida, el izquierdo y el derecho."

#. ~ Item name
#: data/json/items/generic/skulls.json
msgid "human skull"
msgid_plural "human skulls"
msgstr[0] "cráneo humano"
msgstr[1] "cráneos humanos"
msgstr[2] "cráneos humanos"

#. ~ Description of "human skull"
#: data/json/items/generic/skulls.json
msgid ""
"The skull of a human being.  Carrying this around probably isn't going to "
"win you any friends."
msgstr ""
"El cráneo de un ser humano. Probablemente, llevar esto encima no te va a "
"hacer ganar amigos."

#. ~ Item name
#: data/json/items/generic/skulls.json
msgid "large canine skull"
msgid_plural "large canine skulls"
msgstr[0] "calavera grande de lobo"
msgstr[1] "calaveras grandes de lobo"
msgstr[2] "calaveras grandes de lobo"

#. ~ Description of "large canine skull"
#: data/json/items/generic/skulls.json
msgid ""
"The skull of a wolf or a dog.  Essential material for building an "
"articulated wolf skeleton."
msgstr ""
"La calavera de un lobo o un perro. El material esencial para fabricar un "
"esqueleto articulado de lobo."

#. ~ Item name
#: data/json/items/generic/skulls.json
msgid "small canine skull"
msgid_plural "small canine skulls"
msgstr[0] "calavera pequeña canina"
msgstr[1] "calaveras pequeñas caninas"
msgstr[2] "calaveras pequeñas caninas"

#. ~ Description of "small canine skull"
#: data/json/items/generic/skulls.json
msgid "The skull of a small canine, likely a small dog breed."
msgstr ""
"La calavera de un canino pequeño, seguramente de una raza de perro pequeño."

#. ~ Item name
#: data/json/items/generic/skulls.json
msgid "tiny canine skull"
msgid_plural "tiny canine skulls"
msgstr[0] "calavera diminuta canina"
msgstr[1] "calaveras diminutas caninas"
msgstr[2] "calaveras diminutas caninas"

#. ~ Description of "tiny canine skull"
#: data/json/items/generic/skulls.json
msgid ""
"The skull of a tiny canine, likely a Chihuahua or another similarly sized "
"dog breed."
msgstr ""
"La calavera de un diminuto canino, seguramente de un Chihuahua u otra raza "
"canina de similar tamaño."

#. ~ Item name
#: data/json/items/generic/skulls.json
msgid "small feline skull"
msgid_plural "small feline skulls"
msgstr[0] "calavera pequeña de gato"
msgstr[1] "calaveras pequeñas de gato"
msgstr[2] "calaveras pequeñas de gato"

#. ~ Description of "small feline skull"
#: data/json/items/generic/skulls.json
msgid "The skull of a small feline, likely a house cat."
msgstr "La calavera de un gato pequeño, seguramente de un gato doméstico."

#. ~ Item name
#: data/json/items/generic/skulls.json
msgid "rodent skull"
msgid_plural "rodent skulls"
msgstr[0] "calavera de roedor"
msgstr[1] "calaveras de roedores"
msgstr[2] "calaveras de roedores"

#. ~ Description of "rodent skull"
#: data/json/items/generic/skulls.json
msgid "The skull of a small rodent, most likely a rat."
msgstr "La calavera de un roedor pequeño, seguramente de una rata."

#. ~ Item name
#: data/json/items/generic/skulls.json
msgid "pig skull"
msgid_plural "pig skulls"
msgstr[0] "calavera de cerdo"
msgstr[1] "calaveras de cerdo"
msgstr[2] "calaveras de cerdo"

#. ~ Description of "pig skull"
#: data/json/items/generic/skulls.json
msgid "The skull of a pig, either a domestic or a wild one."
msgstr "La calavera de un cerdo, puede que doméstico o salvaje."

#. ~ Item name
#: data/json/items/generic/skulls.json
msgid "sheep skull"
msgid_plural "sheep skulls"
msgstr[0] "calavera de oveja"
msgstr[1] "calaveras de ovejas"
msgstr[2] "calaveras de ovejas"

#. ~ Description of "sheep skull"
#: data/json/items/generic/skulls.json
msgid "The skull of a domestic sheep."
msgstr "La calavera de una oveja doméstica."

#. ~ Item name
#: data/json/items/generic/skulls.json
msgid "goat skull"
msgid_plural "goat skulls"
msgstr[0] "calavera de cabra"
msgstr[1] "calaveras de cabra"
msgstr[2] "calaveras de cabra"

#. ~ Description of "goat skull"
#: data/json/items/generic/skulls.json
msgid "The skull of a goat with the horns still attached."
msgstr "La calavera de una cabra con los cuernos todavía unidos a ella."

#. ~ Item name
#: data/json/items/generic/skulls.json
msgid "cow skull"
msgid_plural "cow skulls"
msgstr[0] "calavera de vaca"
msgstr[1] "calaveras de vaca"
msgstr[2] "calaveras de vaca"

#. ~ Description of "cow skull"
#: data/json/items/generic/skulls.json
msgid ""
"The skull of a bovine, likely a domestic cow, with the horns still attached."
msgstr ""
