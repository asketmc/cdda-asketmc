#: data/json/items/tool/metalworking.json
msgid ""
"A piece of metal with holes of varying size drilled into it.  Used as part "
"of wire drawing."
msgstr ""
"Pieza de metal con agujeros de distinto tamaño perforados. Se utiliza como "
"parte del trefilado."

#. ~ Item name
#: data/json/items/tool/metalworking.json
msgid "sand casting mold"
msgid_plural "sand casting molds"
msgstr[0] "molde de arena de fundición"
