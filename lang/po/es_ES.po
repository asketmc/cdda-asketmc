" hace tres años."

#. ~ Snippet in category "non_kitten_items"
#. ~ Other miscellaneous items
#: data/json/snippets/robot_finds_kitten.json
msgid "A kitten!  No… wait, it's a turkey."
msgstr "¡Un gatito! No... espera, es un pavo."

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "Hey, can you hear me?"
msgstr "Oye. ¿Me puedes oír?"

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "Don't touch me."
msgstr "No me toques."

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "What's your name?"
msgstr "¿Cómo te llamas?"

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "I thought you were my friend."
msgstr "Pensaba que eras mi amigo."

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "Shut up!  Don't lie to me."
msgstr "¡Cállate! No me mientas."

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "Why would you do that?"
msgstr "¿Para qué harías eso?"

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "Please, don't go."
msgstr "Por favor, no te vayas."

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "Don't leave me alone!"
msgstr "¡No me dejes aquí!"

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "No way, man."
msgstr "De ninguna manera, tio."

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "Do you really think so?"
msgstr "¿De verdad lo crees?"

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "Is it really time for that?"
msgstr "¿Es realmente el momento para eso?"

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "Sorry, I can't hear you."
msgstr "Perdón, no te escucho."

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "You've told me already."
msgstr "Ya me lo dijiste."

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "I know!"
msgstr "¡Lo se!"

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "Why are you following me?"
msgstr "¿Por qué me estás siguiendo?"

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "This place is dangerous, you shouldn't be here."
msgstr "Este lugar es peligroso, no deberías estar aquí."

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "That's not true, is it?"
msgstr "Eso no es verdad, ¿o sí?"

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "Are you hurt?"
msgstr "¿Estas herido?"

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "Hey, let's go kill that %1$s!"
msgstr "¡Eh, vamos a matar ese %1$s!"

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "Did you see that %1$s!?"
msgstr "¿¡Viste %1$s!?"

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "I want to kill that %1$s!"
msgstr "¡Quiero matar %1$s!"

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "Let me kill that %1$s!"
msgstr "¡Dejame matar %1$s!"

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "Hey, I need to kill that %1$s!"
msgstr "¡Oye, necesito matar ese %1$s!"

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "I want to watch that %1$s bleed!"
msgstr "¡Quiero ver sangrando a %1$s!"

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "Wait, that %1$s needs to die!"
msgstr "¡Esperá, %1$s tiene que morir!"

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "Go kill that %1$s!"
msgstr "¡Ve a matar eso %1$s!"

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "Look at that %1$s!"
msgstr "¡Mirá %1$s!"

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "That %1$s doesn't deserve to live!"
msgstr "¡%1$s no se merece vivir!"

#. ~ Snippet in category "schizo_weapon_talk_bleeding"
#: data/json/snippets/schizophrenia.json
msgid "Hey, you're bleeding."
msgstr "Eh, estás sangrando."

#. ~ Snippet in category "schizo_weapon_talk_bleeding"
#: data/json/snippets/schizophrenia.json
msgid "Your wound looks pretty bad."
msgstr "Tus heridas tienen muy mala pinta."

#. ~ Snippet in category "schizo_weapon_talk_bleeding"
#: data/json/snippets/schizophrenia.json
msgid "Shouldn't you put a bandage on that?"
msgstr "¿No tendrías que ponerle una venda a eso?"

#. ~ Snippet in category "schizo_weapon_talk_bleeding"
#: data/json/snippets/schizophrenia.json
msgid "Please don't die!  No one else lets me kill things!"
msgstr "¡Por favor no te mueras! ¡Nadie más me deja matar cosas!"

#. ~ Snippet in category "schizo_weapon_talk_bleeding"
#: data/json/snippets/schizophrenia.json
msgid "You look hurt; did I do that?"
msgstr "Pareces herido, ¿Te lo hice yo?"

#. ~ Snippet in category "schizo_weapon_talk_bleeding"
#: data/json/snippets/schizophrenia.json
msgid "Are you supposed to be bleeding?"
msgstr "¿Se supone que debes sangrar?"

#. ~ Snippet in category "schizo_weapon_talk_bleeding"
#: data/json/snippets/schizophrenia.json
msgid "You're not going to die, are you?"
msgstr "No vas a morir, ¿verdad?"

#. ~ Snippet in category "schizo_weapon_talk_bleeding"
#: data/json/snippets/schizophrenia.json
msgid "You're bleeding, you know."
msgstr "Estás sangrando, lo sabes."

#. ~ Snippet in category "schizo_weapon_talk_bleeding"
#: data/json/snippets/schizophrenia.json
msgid "Kill a few more before you bleed out!"
msgstr "¡Matá algunos más antes de que te desangres!"

#. ~ Snippet in category "schizo_weapon_talk_damaged"
#: data/json/snippets/schizophrenia.json
msgid "Hey fix me up."
msgstr "Oye, arréglame."

#. ~ Snippet in category "schizo_weapon_talk_damaged"
#: data/json/snippets/schizophrenia.json
msgid "I need healing!"
msgstr "¡Necesito curación!¡Necesito curación!"

#. ~ Snippet in category "schizo_weapon_talk_damaged"
#: data/json/snippets/schizophrenia.json
msgid "I hurt all over…"
msgstr "Me duele todo..."

#. ~ Snippet in category "schizo_weapon_talk_damaged"
#: data/json/snippets/schizophrenia.json
msgid "You can put me back together, right?"
msgstr "Puedes recomponerme, ¿verdad?"

#. ~ Snippet in category "schizo_weapon_talk_damaged"
#: data/json/snippets/schizophrenia.json
msgid "I… I can't move my legs!"
msgstr "Yo... ¡no puedo mover las piernas!"

#. ~ Snippet in category "schizo_weapon_talk_damaged"
#: data/json/snippets/schizophrenia.json
msgid "Medic!"
msgstr "¡Médico!"

#. ~ Snippet in category "schizo_weapon_talk_damaged"
#: data/json/snippets/schizophrenia.json
msgid "I can still fight, don't replace me!"
msgstr "¡Todavía puedo pelear, no me reemplaces!"

#. ~ Snippet in category "schizo_weapon_talk_damaged"
#: data/json/snippets/schizophrenia.json
msgid "They got me!"
msgstr "¡Me la dieron!"

#. ~ Snippet in category "schizo_weapon_talk_damaged"
#: data/json/snippets/schizophrenia.json
msgid "*cough cough* Go on without me…"
msgstr "*tos tos* Continúa sin mí..."

#. ~ Snippet in category "schizo_weapon_talk_damaged"
#: data/json/snippets/schizophrenia.json
msgid "Am I gonna die?"
msgstr "¿Voy a morir?"

#. ~ Snippet in category "schizo_weapon_talk_misc"
#: data/json/snippets/schizophrenia.json
msgid "Let me kill something already!"
msgstr "¡Déjame matar algo ya!"

#. ~ Snippet in category "schizo_weapon_talk_misc"
#: data/json/snippets/schizophrenia.json
msgid "I'm your best friend, right?"
msgstr "Soy tu mejor amigo, ¿no?"

#. ~ Snippet in category "schizo_weapon_talk_misc"
#: data/json/snippets/schizophrenia.json
msgid "I love you!"
msgstr "¡Te quiero!"

#. ~ Snippet in category "schizo_weapon_talk_misc"
#: data/json/snippets/schizophrenia.json
msgid "Do you think it will rain today?"
msgstr "¿Te parece que va a llover hoy?"

#. ~ Snippet in category "schizo_weapon_talk_misc"
#: data/json/snippets/schizophrenia.json
msgid "Try not to drop me."
msgstr "Tratá de no abandonarme."

#. ~ Snippet in category "schizo_weapon_talk_misc"
#: data/json/snippets/schizophrenia.json
msgid "How many do you think we've killed?"
msgstr "¿Cuántos te parece que matamos?"

#. ~ Snippet in category "schizo_weapon_talk_misc"
#: data/json/snippets/schizophrenia.json
msgid "I'll keep you safe!"
msgstr "¡Yo te voy a mantener a salvo!"

#. ~ Snippet in category "schizo_delusion_paranoid"
#: data/json/snippets/schizophrenia.json
msgid "You feel like the world is out to get you."
msgstr "Sientes que el mundo te está buscando."

#. ~ Snippet in category "schizo_delusion_paranoid"
#: data/json/snippets/schizophrenia.json
msgid "You feel a mounting sense of impending doom."
msgstr "Sientes una creciente sensación de fatalidad inminente."

#. ~ Snippet in category "schizo_delusion_paranoid"
#. ~ Snippet in category "schizo_delusion_grandiose"
#: data/json/snippets/schizophrenia.json
msgid ""
"You gain the sudden realization that you must have been responsible for the "
"Cataclysm."
msgstr "Te das cuenta de que debes ser el responsable del Cataclismo."

#. ~ Snippet in category "schizo_delusion_paranoid"
#: data/json/snippets/schizophrenia.json
msgid "You get the odd feeling that your thoughts are not your own."
msgstr "Tienes la extraña sensación de que tus pensamientos no son tuyos."

#. ~ Snippet in category "schizo_delusion_paranoid"
#: data/json/snippets/schizophrenia.json
msgid ""
"You feel as if everyone in the world must be playing a sick prank on you."
msgstr "Sientes como si todo el mundo te estuviera gastando una broma pesada."

#. ~ Snippet in category "schizo_delusion_paranoid"
#: data/json/snippets/schizophrenia.json
msgid "You are being watched… by THEM."
msgstr "Estás siendo observado… por ELLOS."

#. ~ Snippet in category "schizo_delusion_grandiose"
#: data/json/snippets/schizophrenia.json
msgid ""
"You gain the sudden realization that you are the creator of the universe."
msgstr "Te das cuenta de repente de que eres el creador del universo."

#. ~ Snippet in category "schizo_delusion_grandiose"
#: data/json/snippets/schizophrenia.json
msgid "You increase all your skills to level 10."
msgstr "Aumenta todas tus habilidades hasta el nivel 10."

#. ~ Snippet in category "schizo_delusion_grandiose"
#: data/json/snippets/schizophrenia.json
msgid ""
"You feel that this must be a global reality show, in which you are the star."
msgstr ""
"Sientes que esto debe ser un reality show global, en el que tú eres la "
"estrella."

#. ~ Snippet in category "schizo_delusion_grandiose"
#: data/json/snippets/schizophrenia.json
msgid ""
"You now know that you are a secret agent, kept alive to continue serving the"
" government."
msgstr ""
"Ahora sabe que es un agente secreto, mantenido con vida para seguir "
"sirviendo al gobierno."

#. ~ Snippet in category "schizo_delusion_grandiose"
#: data/json/snippets/schizophrenia.json
msgid "You feel in full control of the situation."
msgstr "Te sientes en pleno control de la situación."

#. ~ Snippet in category "schizo_formication"
#: data/json/snippets/schizophrenia.json
msgid "Your skin feels itchy."
msgstr "Tu piel siente picor."

#. ~ Snippet in category "schizo_formication"
#: data/json/snippets/schizophrenia.json
msgid "You can feel something wriggling underneath your skin."
msgstr "Puedes sentir algo retorciéndose bajo tu piel."

#. ~ Snippet in category "schizo_formication"
#: data/json/snippets/schizophrenia.json
msgid "You can feel insects crawling all over you."
msgstr "Puedes sentir insectos reptando sobre ti."

#. ~ Snippet in category "schizo_formication"
#: data/json/snippets/schizophrenia.json
msgid "You feel larvae wriggling beneath the skin."
msgstr "Sientes las larvas retorciéndose bajo tu piel."

#. ~ Snippet in category "schizo_formication"
#: data/json/snippets/schizophrenia.json
msgid "You feel itchy all over."
msgstr "Te pica todo el cuerpo."

#. ~ Snippet in category "schizo_formication"
#: data/json/snippets/schizophrenia.json
msgid "You feel like you're covered in bugs."
msgstr "Sientes que estas cubierto de bichos."

#. ~ Snippet in category "schizo_formication"
#: data/json/snippets/schizophrenia.json
msgid "You feel bugs crawling on you."
msgstr "Sientes que los bichos se mueven sobre ti."

#. ~ Snippet in category "schizo_self_shout"
#: data/json/snippets/schizophrenia.json
msgid "\"Get away from there!\""
msgstr "\"¡Aléjate de ahí!\""

#. ~ Snippet in category "schizo_self_shout"
#: data/json/snippets/schizophrenia.json
msgid "\"What do you think you're doing?\""
msgstr "\"¿Qué crees que estás haciendo?\""

#. ~ Snippet in category "schizo_self_shout"
#: data/json/snippets/schizophrenia.json
msgid "\"Stop laughing at me!\""
msgstr "\"¡Dejá de reirte de mí!\""

#. ~ Snippet in category "schizo_self_shout"
#: data/json/snippets/schizophrenia.json
msgid "\"Don't point that thing at me!\""
msgstr "\"¡No me apuntes con esa cosa!\""

#. ~ Snippet in category "schizo_self_shout"
#: data/json/snippets/schizophrenia.json
msgid "\"Stay away from me!\""
msgstr "\"¡Ni te me acerques!\""

#. ~ Snippet in category "schizo_self_shout"
#: data/json/snippets/schizophrenia.json
msgid "\"No!  Stop!\""
msgstr "\"¡No! ¡Detente!\""

#. ~ Snippet in category "schizo_self_shout"
#: data/json/snippets/schizophrenia.json
msgid "\"Get the fuck away from me!\""
msgstr "\"¡Aléjate de mí!\""

#. ~ Snippet in category "schizo_self_shout"
#: data/json/snippets/schizophrenia.json
msgid "\"That's not true!\""
msgstr "\"¡Eso no es verdad!\""

#. ~ Snippet in category "schizo_self_shout"
#: data/json/snippets/schizophrenia.json
msgid "\"What do you want from me?\""
msgstr "\"¿Qué quieres de mí?\""

#. ~ Snippet in category "schizo_self_shout"
#: data/json/snippets/schizophrenia.json
msgid "\"I didn't mean to do it!\""
msgstr "\"¡No fue mi intención!\""

#. ~ Snippet in category "schizo_self_shout"
#: data/json/snippets/schizophrenia.json
msgid "\"It wasn't my fault!\""
msgstr "\"¡No fue mi culpa!\""

#. ~ Snippet in category "schizo_self_shout"
#: data/json/snippets/schizophrenia.json
msgid "\"I had to do it!\""
msgstr "\"¡Tuve que hacerlo!\""

#. ~ Snippet in category "schizo_self_shout"
#: data/json/snippets/schizophrenia.json
msgid "\"They made me do it!\""
msgstr "\"¡Me obligaron a hacerlo!\""

#. ~ Snippet in category "schizo_self_shout"
#: data/json/snippets/schizophrenia.json
msgid "\"What are you!?\""
msgstr "\"¿¡Qué eres!?\""

#. ~ Snippet in category "schizo_self_shout"
#: data/json/snippets/schizophrenia.json
msgid "\"I should never have trusted you!\""
msgstr "\"¡Nunca debí confiar en ti!\""

