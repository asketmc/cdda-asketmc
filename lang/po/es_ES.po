msgstr[1] "limonada"
msgstr[2] "limonada"

#. ~ Description of "lemonade"
#: data/json/items/comestibles/drink.json
msgid ""
"Lemon juice mixed with water and sugar to dull the sourness.  Delicious and "
"refreshing."
msgstr ""
"Zumo de limón mezclado con agua y azúcar para suavizar la acidez. Delicioso "
"y refrescante."

#. ~ Item name
#: data/json/items/comestibles/drink.json
