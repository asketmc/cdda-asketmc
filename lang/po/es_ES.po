#: data/json/items/comestibles/drink.json
msgid "chocolate drink"
msgid_plural "chocolate drinks"
msgstr[0] "batido de chocolate"
msgstr[1] "batidos de chocolate"
msgstr[2] "batidos de chocolate"

#. ~ Description of "chocolate drink"
#: data/json/items/comestibles/drink.json
msgid ""
"A chocolate-flavored beverage made of artificial flavoring and milk "
"byproducts.  Shelf stable and vaguely appetizing even when lukewarm."
msgstr ""
"Una bebida con gusto a chocolate hecha con sabores artificiales y derivados "
"de la leche. No necesita refrigeración, y es ligeramente apetitosa incluso "
"tibia."

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "black coffee"
msgid_plural "black coffee"
msgstr[0] "café negro"
msgstr[1] "café negro"
msgstr[2] "café negro"

#. ~ Description of "black coffee"
#: data/json/items/comestibles/drink.json
msgid ""
"The morning ritual of the pre-apocalyptic world, created from coffee "
"cherries through a complex process of seed removal, roasting, grinding, and "
"brewing.  Coffee is substantially richer in caffeine than its rival tea."
msgstr ""
"El ritual matutino del mundo pre-apocalíptico, creado a partir de las granos"
" de café a través de un complejo proceso de eliminación de semillas, "
"tostado, molido y elaboración de la cerveza. El café es sustancialmente más "
"rico en cafeína que su té rival."

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "coffee substitute"
msgid_plural "coffee substitute"
msgstr[0] "sustituto del café"
msgstr[1] "sustituto del café"
msgstr[2] "sustituto del café"

#. ~ Description of "coffee substitute"
#: data/json/items/comestibles/drink.json
msgid ""
"Homemade not-coffee created from the Kentucky coffeetree, just like the "
"Meskwaki tribe!  Doesn't actually have any caffeine, and is very bitter, but"
" it'll pass in a pinch."
msgstr ""
"Un no-café casero creado a partir del árbol de café de Kentucky, ¡como la "
"tribu Meskwaki! En realidad no tiene cafeína, y es muy amargo, pero te "
"servirá en caso de necesidad."

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "coffee substitute with milk"
msgid_plural "coffee substitute with milk"
msgstr[0] "sustituto del café con leche"
msgstr[1] "sustituto del café con leche"
msgstr[2] "sustituto del café con leche"

#. ~ Description of "coffee substitute with milk"
#: data/json/items/comestibles/drink.json
msgid ""
"Imitation coffee brewed from Kentucky coffeetree, this drink has no "
"caffeine, no sweetener, and is still unpleasantly bitter even with the added"
" milk."
msgstr ""
"Imitación de café elaborada a partir del cafeto de Kentucky, esta bebida no "
"tiene cafeína, ni edulcorante, y sigue siendo desagradablemente amarga "
"incluso con la leche añadida."

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "sweetened coffee substitute with milk"
msgid_plural "sweetened coffee substitute with milk"
msgstr[0] "sustituto del café azucarado con leche"
msgstr[1] "sustituto del café azucarado con leche"
msgstr[2] "sustituto del café azucarado con leche"

#. ~ Description of "sweetened coffee substitute with milk"
#: data/json/items/comestibles/drink.json
msgid ""
"The morning ritual of the post-apocalyptic world.  Brewed from the Kentucky "
"coffeetree, this drink has no actual caffeine, but serves as a replacement "
"for those who dearly miss the aroma of real coffee."
msgstr ""
"El ritual mañanero del mundo postapocalíptico. Hecho con el árbol cafetero "
"de Kentucky, esta bebida no tiene cafeína real pero funciona como reemplazo "
"para aquellos que extrañan sinceramente el aroma del verdadero café."

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "sweetened milk"
msgid_plural "sweetened milks"
msgstr[0] "leche azucarada"
msgstr[1] "leches azucaradas"
msgstr[2] "leches azucaradas"

#. ~ Description of "sweetened milk"
#: data/json/items/comestibles/drink.json
msgid "Some milk with sugar added.  Tastes slightly better."
msgstr "Un poco de leche con azúcar añadida. Sabe un poco mejor."

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "sweetened fortified milk"
msgid_plural "sweetened fortified milks"
msgstr[0] "leche fortificada azucarada"
msgstr[1] "leches fortificadas azucaradas"
msgstr[2] "leches fortificadas azucaradas"

#. ~ Description of "sweetened fortified milk"
#: data/json/items/comestibles/drink.json
msgid ""
"Milk enriched with protein powder, it's extra healthy and doesn't taste too "
"bad.  It has sugar added, for those who like it sweeter."
msgstr ""
"Leche enriquecida con proteína en polvo, es extra saludable y no tiene mal "
"sabor. Tiene azúcar añadido, para los que les gusta más dulce."

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "chicory brew"
msgid_plural "chicory brew"
msgstr[0] "brebaje de achicoria"
msgstr[1] "brebaje de achicoria"
msgstr[2] "brebaje de achicoria"

#. ~ Description of "chicory brew"
#: data/json/items/comestibles/drink.json
msgid ""
"Toasted, ground chicory root steeped in boiling water.  This bitter brew is "
"used as a coffee substitute, though it tastes nothing like coffee."
msgstr ""
"Raíces tostadas y molidas de achicoria, sumergidas en agua hirviendo. Esta "
"infusión amarga se utiliza como sustituto del café, aunque no tiene un gusto"
" ni parecido."

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "dark cola"
msgid_plural "dark colas"
msgstr[0] "cola oscura"
msgstr[1] "cola oscura"
msgstr[2] "cola oscura"

#. ~ Description of "dark cola"
#: data/json/items/comestibles/drink.json
msgid "Things go better with cola.  Sugar water with caffeine added."
msgstr "Las cosas están mejores con cola. Agua azucarada con cafeína añadida."

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "energy cola"
msgid_plural "energy colas"
msgstr[0] "cola energética"
msgstr[1] "cola energética"
msgstr[2] "cola energética"

#. ~ Description of "energy cola"
#: data/json/items/comestibles/drink.json
msgid ""
"It tastes and looks like windshield wiper fluid, but it's loaded to the brim"
" with sugar and caffeine."
msgstr ""
"Sabe y se parece al líquido limpiaparabrisas, pero está cargado hasta los "
"topes de azúcar y cafeína."

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "cream soda"
msgid_plural "cream sodas"
msgstr[0] "refresco de vainilla"
msgstr[1] "refresco de vainilla"
msgstr[2] "refresco de vainilla"

#. ~ Description of "cream soda"
#: data/json/items/comestibles/drink.json
msgid "A caffeinated, carbonated drink, flavored with vanilla."
msgstr "Una bebida carbonatada con cafeína, con gusto a vainilla."

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "cranberry juice"
msgid_plural "cranberry juices"
msgstr[0] "zumo de arándano rojo"
msgstr[1] "zumos de arándano rojo"
msgstr[2] "zumos de arándano rojo"

#. ~ Description of "cranberry juice"
#: data/json/items/comestibles/drink.json
msgid "Made from real Massachusetts cranberries.  Quite sour, but nutritious."
msgstr ""
"Hecho de verdaderos arándanos de Massachusetts. Bastante agrios, pero "
"nutritivos."

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "crispy cranberry"
msgid_plural "crispy cranberries"
msgstr[0] "zumo de arándanos rojo y limón"
msgstr[1] "zumos de arándanos rojo y limón"
msgstr[2] "zumos de arándanos rojo y limón"

#. ~ Description of "crispy cranberry"
#: data/json/items/comestibles/drink.json
msgid "Mixing cranberry juice and lemon-lime soda works out quite well."
msgstr ""
"Esta mezcla de zumo de arándano rojo y refresco de lima-limón queda bastante"
" bien."

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "dandelion tea"
msgid_plural "dandelion tea"
msgstr[0] "té de dientes de león"
msgstr[1] "té de dientes de león"
msgstr[2] "té de dientes de león"

#. ~ Description of "dandelion tea"
#: data/json/items/comestibles/drink.json
msgid "A healthy beverage made from dandelion roots steeped in boiling water."
msgstr ""
"Una bebida saludable hecha con las raíces de diente de león, pisadas y "
"hervidas en agua."

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "dandelion and burdock tea"
msgid_plural "dandelion and burdock tea"
msgstr[0] "té de diente de león y bardana"
msgstr[1] "té de diente de león y bardana"
msgstr[2] "té de diente de león y bardana"

#. ~ Description of "dandelion and burdock tea"
#: data/json/items/comestibles/drink.json
msgid ""
"A healthy beverage made from dandelion and burdock roots steeped in boiling "
"water.  The addition of burdock makes it more nourishing and slightly "
"tastier."
msgstr ""
"Una bebida saludable elaborada con raíces de diente de león y bardana "
"remojadas en agua hirviendo. La adición de bardana la hace más nutritiva y "
"ligeramente más sabrosa."

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "eggnog"
msgid_plural "eggnogs"
msgstr[0] "licor de huevo"
msgstr[1] "licores de huevo"
msgstr[2] "licores de huevo"

#. ~ Description of "eggnog"
#: data/json/items/comestibles/drink.json
msgid ""
"Smooth and rich, this spoon-coating mixture of milk, eggs, and cinnamon "
"sugar is a popular traditional holiday drink.  This type isn't spiked with "
"alcohol, but it is still delicious.  Meant to be stored cold, it will spoil "
"rapidly."
msgstr ""
"Suave y rica, esta mezcla de leche, crema y huevos es una bebida tradicional"
" en fiestas.  Aunque a menudo se le agrega alcohol, es igualmente deliciosa "
"por si misma.  Debe ser almacenada en frío o se pudrirá rápidamente."

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "energy drink"
msgid_plural "energy drinks"
msgstr[0] "bebida energética"
msgstr[1] "bebidas energéticas"
msgstr[2] "bebidas energéticas"

#. ~ Description of "energy drink"
#: data/json/items/comestibles/drink.json
msgid ""
"A heavily-caffeinated soft drink.  Popular among those who need to stay up "
"late working."
msgstr ""
"Un refresco con mucha cafeína. Muy popular entre los que tienen que trabajar"
" hasta tarde."

#. ~ Check whether Rivtech-Expensive applies to their energy drinks
#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "atomic energy drink"
msgid_plural "atomic energy drinks"
msgstr[0] "bebida de energía atómica"
msgstr[1] "bebidas de energía atómica"
msgstr[2] "bebidas de energía atómica"

#. ~ Check whether Rivtech-Expensive applies to their energy drinks
#. ~ Description of "atomic energy drink"
#: data/json/items/comestibles/drink.json
msgid ""
"According to the label, this loathsome-tasting beverage is called ATOMIC "
"POWER THIRST.  Alongside the lengthy health warning, it promises to make the"
" consumer UNCOMFORTABLY ENERGETIC using ELECTROLYTES and THE POWER OF THE "
"ATOM."
msgstr ""
"Según la etiqueta, esta repugnante bebida se llama SED DE PODER ATÓMICO. Al "
"lado de la larga advertencia sobre la salud, promete hacer al consumidor "
"INCÓMODAMENTE ENERGÉTICO usando ELECTROLITOS y EL PODER DEL ÁTOMO."

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "herbal tea"
msgid_plural "herbal tea"
msgstr[0] "té de hierbas"
msgstr[1] "té de hierbas"
msgstr[2] "té de hierbas"

#. ~ Description of "herbal tea"
#: data/json/items/comestibles/drink.json
msgid "A healthy beverage made from herbs steeped in boiling water."
msgstr "Una bebida saludable hecha con hierbas sumergidas en agua hirviendo."

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "hot chocolate"
msgid_plural "hot chocolate"
msgstr[0] "chocolate caliente"
msgstr[1] "chocolate caliente"
msgstr[2] "chocolate caliente"

#. ~ Description of "hot chocolate"
#: data/json/items/comestibles/drink.json
msgid ""
"Also known as hot cocoa, this heated chocolate beverage is perfect for a "
"cold winter day."
msgstr ""
"También conocido como chocolate caliente, esta bebida de chocolate caliente "
"es perfecta para un frío día de invierno."

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "pasteurized fruit juice"
msgid_plural "pasteurized fruit juices"
msgstr[0] "zumo de fruta pasteurizada"
msgstr[1] "zumos de fruta pasteurizada"
msgstr[2] "zumos de fruta pasteurizada"

#. ~ Description of "pasteurized fruit juice"
#: data/json/items/comestibles/drink.json
msgid ""
"A sweet liquid with a vaguely fruity taste.  Having been pasteurized, it "
"will last for a long time."
msgstr ""
"Un líquido dulce con un sabor vagamente afrutado. Habiendo sido "
"pasteurizado, durará mucho tiempo."

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "fruit juice"
msgid_plural "fruit juices"
msgstr[0] "zumo de fruta"
msgstr[1] "zumos de fruta"
msgstr[2] "zumos de fruta"

#. ~ Description of "fruit juice"
#: data/json/items/comestibles/drink.json
msgid "Freshly-squeezed from real fruit!  Tasty and nutritious."
msgstr "¡Recién exprimido de verdadera fruta! Sabroso y nutritivo."

