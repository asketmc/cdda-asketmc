#. ~ Profession name for male
#: data/json/professions.json
msgctxt "profession_male"
msgid "Rancher"
msgstr "Ranchero"

#. ~ Description of profession "Rancher" for male
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"Taking care of cows, horses, and other animals is your passion, but the ways"
" things are going, this isn't going to be just another day at the ranch."
msgstr ""
"Cuidar de las vacas, los caballos y otros animales es tu pasión, pero tal y "
"como van las cosas, esto no va a ser un día más en el rancho."

#. ~ Profession name for female
#: data/json/professions.json
