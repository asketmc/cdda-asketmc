msgstr[0] "bolsa táctica de descarga"
msgstr[1] "bolsas tácticas de descarga"
msgstr[2] "bolsas tácticas de descarga"

#. ~ Description of "tactical dump pouch"
#: data/json/items/armor/storage.json
