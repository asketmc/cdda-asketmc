msgstr[1] "copias de Cocinar Con Veneno"
msgstr[2] "copias de Cocinar Con Veneno"

#. ~ Description of "Cooking with Poison"
#: data/mods/Magiclysm/items/recipe_books.json
msgid ""
"A leatherbound book with an embossed cauldron on the cover.  Inside it "
"describes ways to purify food magically."
msgstr ""
"Un libro encuadernado en cuero con un caldero en relieve en la portada. En "
"su interior describe formas de purificar la comida de forma mágica."

#. ~ Item name
#: data/mods/Magiclysm/items/recipe_books.json
