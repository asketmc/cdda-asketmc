#. ~ Profession name for male
#: data/json/professions.json
msgctxt "profession_male"
msgid "Football Player"
msgstr "Jug. Fútbol Americano"

#. ~ Description of profession "Football Player" for male
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"Your epic touchdown was ruined when your coach's guts were torn out by "
"undead fans.  Now you're first pick in the apocalypse draft."
msgstr ""
"Tu épico ensayo se arruinó cuando las tripas de tu entrenador fueron "
"arrancadas por fanáticos no muertos. Ahora eres la primera elección en el "
"draft del apocalipsis."

#. ~ Profession name for female
#: data/json/professions.json
