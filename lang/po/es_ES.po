msgstr "$No puedes hablar sin tu cara."

#: src/npctalk.cpp:1027
msgid "&You are deaf and can't talk."
msgstr "&Estas sordo y no puedes hablar."

#: src/npctalk.cpp:1031
#, c-format
msgid ""
"&You are deaf and can't talk.  When you don't respond, %s becomes angry!"
msgstr "&Estas sordo y no puedes hablar. ¡Como no respondes, %s se enfada!"

