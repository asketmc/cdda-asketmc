#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"That was nobody's fault.\""
msgstr "\"No fue culpa de nadie.\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"She was provoking you.\""
msgstr "\"Te estaba provocando.\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Oh dear.\""
msgstr "\"Oh, querido\"."

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Oh my!\""
msgstr "\"¡Ay, dios!\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"I blame myself.\""
msgstr "\"Me culpo a mí mismo\"."

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"He probably deserved it.\""
msgstr "\"El probablemente se lo merecía\"."

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"I saw it.  It was an accident.\""
msgstr "\"Lo vi. Fue un accidente.\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"She's probably okay.\""
msgstr "\"Probablemente, ella esté bien.\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Noted.\""
msgstr "\"Tomo nota\"."

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"But I need to protect the humans!\""
msgstr "\"¡Pero necesito proteger a los humanos!\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"We're back!\""
msgstr "\"¡Estamos de vuelta!\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Hi there!\""
msgstr "\"¿Hola, qué tal?\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Back again!\""
msgstr "\"¡De vuelta otra vez!\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Well, hello, stranger!\""
msgstr "\"¡Bueno, hola, desconocido!\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"This time is OUR time.\""
msgstr "\"Esta vez es NUESTRO tiempo\"."

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Second time's a charm…\""
msgstr "\"La segunda vez es un encanto...\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Howdy, stranger!\""
msgstr "\"¡Buenas, desconocido!\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Thought you'd seen the last of us, didn't ya?\""
msgstr "\"¿Pensaste que no nos ibas a ver más, eh?\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Dang!\""
msgstr "\"¡Caramba!\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"I thought we fixed that.\""
msgstr "\"Creí que lo habíamos arreglado\"."

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"What's a guy gotta got to do to get some bullets around here?\""
msgstr "\"¿Qué tiene que hacer un tipo para conseguir balas por aquí?\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Nope.  Still can't see.\""
msgstr "\"Nop. Todavía no puedo ver.\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Yep.  Still blind.\""
msgstr "\"Sí. Todavía estoy ciego.\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Click click click!  Still defective!\""
msgstr "\"¡Click, click, click, click! ¡Siguen defectuosas!\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Yeah, that's right!  Still defective!\""
msgstr "\"¡Sí, eso es! ¡Sigue sin andar!\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Yeah!  Still not working.\""
msgstr "\"¡Sí! Todavía no funciona.\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Yeah!  Non-lethal as ever.\""
msgstr "\"¡Sí! No letal como siempre\"."

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Can't.  See.  A.  Thing.\""
msgstr "\"No. Puedo. Ver. Nada.\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Absolutely no improvement.\""
msgstr "\"Sin mejora alguna.\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Not getting better with age!\""
msgstr "\"¡No se está solucionando con el tiempo!\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"This is just getting embarrassing.\""
msgstr "\"Esto se está volviendo vergonzoso\"."

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Alright, you can go.\""
msgstr "\"Bueno, puedes ir.\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"[sigh] Don't tell anyone about this.\""
msgstr "\"[suspiro] No le digas a nadie acerca de esto.\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Well, I tried.  Best of luck!\""
msgstr "\"Bueno, lo intenté. ¡La mejor de las suertes!\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Hey, safe travels, there.\""
msgstr "\"Eh, que tengas un buen viaje\"."

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Hey, thanks so much!\""
msgstr "\"¡Oye, muchas gracias!\" "

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Don't be a stranger!\""
msgstr "\"¡No seas un extraño!\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"It's been a pleasure!\""
msgstr "\"¡Ha sido un placer!\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"That was fun, wasn't it?\""
msgstr "\"Es divertido, ¿O no?\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid ""
"\"I can't see a thing.  What just happened?  Better open fire!  [click click"
" click click]  Dang!\""
msgstr ""
"\"No puedo ver nada. ¿Qué pasó? ¡Mejor disparo!  [click click click click] "
"¡Mierda!\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"*clicking noises*\""
msgstr "\"*ruido de chasquidos*\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"No, wait, wait!\""
msgstr "\"'¡No, espera, espera!\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Hey, hold on now WHOA WHOA WHOA!\""
msgstr "\"¡Ey, esperá un poco WO WO WO!\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Oh, this is ridiculous!\""
msgstr "\"¡Oh, es ridículo!\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Give me another channnnce!\""
msgstr "\"¡Dame otra oportunidaaaaad!\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Hey!  Squeaky-voice!  Gimme some of your bullets!\""
msgstr "\"¡Eh! ¡Voz chillona! ¡Dame algunas de tus balas!\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Can I get some bullets here?  Anybody got bullets?\""
msgstr "\"¿Puedo tener algunas balas aquí? ¿Alguien tiene balas?\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Uhhh, no bullets.  Sorry.\""
msgstr "\"Uhhh, sin balas. Perdona.\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Shootin' blanks every time, ALL the time.\""
msgstr "\"Disparando balas de fogueo todo el tiempo, TODO el tiempo.\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Standing down.\""
msgstr "\"Retirada\"."

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Watch and learn, everybody.  Watch and learn.\""
msgstr "\"Miren y aprendan, todos. Miran y aprendan.\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"So what am I, uh, supposed to do here?\""
msgstr "\"Entonces, ¿qué se supone que debo hacer aquí?\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Identify yourself or I will shoot.\""
msgstr "\"Identifíquese o dispararé\"."

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Pleased to meetcha.\""
msgstr "\"Encantado de conocerte\"."

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"I'm gonna make you proud!\""
msgstr "\"¡Te voy a hacer sentir orgulloso!\""

