#. ~ Spell name
#: data/json/artifact/legacy_artifact_active.json
msgid "Artifact Adrenaline"
msgstr "Artefacto Adrenalina"

#. ~ Description of spell "Artifact Adrenaline"
#: data/json/artifact/legacy_artifact_active.json
msgid "Causes a surge of adrenaline to flow throughout your body."
msgstr "Causa que una oleada de adrenalina fluya por todo tu cuerpo."

#. ~ Message of spell "Artifact Adrenaline"
#: data/json/artifact/legacy_artifact_active.json
msgid "You're filled with a roaring energy!"
msgstr "¡Estás lleno de energía rugiente!"

#. ~ Spell name
#: data/json/artifact/legacy_artifact_active.json
msgid "Artifact Blood"
msgstr "Artefacto Sangre"

#. ~ Description of spell "Artifact Blood"
#: data/json/artifact/legacy_artifact_active.json
msgid "Causes blood to leak from nearby terrain."
msgstr "Hace que la sangre se filtre desde el terreno cercano."

#. ~ Message of spell "Artifact Blood"
#: data/json/artifact/legacy_artifact_active.json
msgid "Blood soaks out of the ground and walls."
msgstr "Hay sangre saliendo del suelo y de los muros."

#. ~ Spell name
#: data/json/artifact/legacy_artifact_active.json
msgid "Artifact Heal"
msgstr "Artefacto Curación"

#. ~ Description of spell "Artifact Heal"
#: data/json/artifact/legacy_artifact_active.json
msgid "Will heal injuries all over your body."
msgstr "Curará las heridas de todo el cuerpo."

#. ~ Message of spell "Artifact Heal"
#: data/json/artifact/legacy_artifact_active.json
msgid "You feel healed."
msgstr "Te sientes curado."

#. ~ Spell name
#: data/json/artifact/legacy_artifact_active.json
msgid "Artifact Confused"
msgstr "Artefacto Confusión"

#. ~ Description of spell "Artifact Confused"
#: data/json/artifact/legacy_artifact_active.json
msgid "Causes nearby enemies to become confused."
msgstr "Hace que los enemigos cercanos se confundan."

#. ~ Spell name
#: data/json/artifact/legacy_artifact_active.json
msgid "Artifact Pain"
msgstr "Artefacto Dolor"

#. ~ Description of spell "Artifact Pain"
#: data/json/artifact/legacy_artifact_active.json
msgid "Owchie, that hurts."
msgstr "Auch, eso duele."

#. ~ Message of spell "Artifact Pain"
#: data/json/artifact/legacy_artifact_active.json
msgid "You're wracked with pain!"
msgstr "¡Te está destrozando el dolor!"

#. ~ Spell name
#: data/json/artifact/legacy_artifact_active.json
msgid "Artifact Teleport"
msgstr "Artefacto Teletransporte"

#. ~ Description of spell "Artifact Teleport"
#: data/json/artifact/legacy_artifact_active.json
msgid "Randomly teleports you a short distance."
msgstr "Te teletransporta aleatoriamente a una distancia corta."

#. ~ Message of spell "Artifact Teleport"
#: data/json/artifact/legacy_artifact_active.json
msgid "You teleport!"
msgstr "¡Te teletransportás!"

#. ~ Spell name
#: data/json/artifact/legacy_artifact_active.json
msgid "Artifact Attention"
msgstr "Artefacto Atención"

#. ~ Description of spell "Artifact Attention"
#: data/json/artifact/legacy_artifact_active.json
msgid ""
"You're not quite sure what you did, but something is watching you for it."
msgstr ""
"No estás muy seguro de lo que hiciste, pero algo te está observando por "
"ello."

#. ~ Message of spell "Artifact Attention"
#: data/json/artifact/legacy_artifact_active.json
msgid "You feel like your action has attracted attention."
msgstr "Sientes como si tu acción haya atraído atención."

#. ~ Spell name
#: data/json/artifact/legacy_artifact_active.json
msgid "Artifact Teleglow"
msgstr "Artefacto Telebrillo"

#. ~ Description of spell "Artifact Teleglow"
#: data/json/artifact/legacy_artifact_active.json
msgid "DO YOU HEAR THE VOICES TOO?"
msgstr "¿TAMBIÉN OYES LAS VOCES?"

#. ~ Message of spell "Artifact Teleglow"
#: data/json/artifact/legacy_artifact_active.json
msgid "You feel unhinged."
msgstr "Te sientes trastornado."

#. ~ Spell name
#: data/json/artifact/legacy_artifact_active.json
msgid "Artifact Vomit"
msgstr "Artefacto Vómito"

#. ~ Description of spell "Artifact Vomit"
#: data/json/artifact/legacy_artifact_active.json
msgid "Causes the caster to vomit."
msgstr "Causa que el lanzador vomite."

#. ~ Message of spell "Artifact Vomit"
#: data/json/artifact/legacy_artifact_active.json
msgid "A wave of nausea passes through you!"
msgstr "¡Una ola de náusea pasa a través tuyo!"

#. ~ Spell name
#: data/json/artifact/legacy_artifact_active.json
msgid "Artifact Shadows"
msgstr "Artefacto Sombras"

#. ~ Description of spell "Artifact Shadows"
#: data/json/artifact/legacy_artifact_active.json
msgid "Summons shadows."
msgstr "Invoca sombras."

#. ~ Message of spell "Artifact Shadows"
#: data/json/artifact/legacy_artifact_active.json
msgid "Shadows form around you."
msgstr "Se forman sombras a tu alrededor."

#. ~ Spell name
#: data/json/artifact/legacy_artifact_active.json
msgid "Artifact Stamina Empty"
msgstr "Artefacto Vigor Agotado"

#. ~ Description of spell "Artifact Stamina Empty"
#: data/json/artifact/legacy_artifact_active.json
msgid "Does a variable amount of stamina damage."
msgstr "Hace una cantidad variable de daño al vigor."

#. ~ Message of spell "Artifact Stamina Empty"
#: data/json/artifact/legacy_artifact_active.json
msgid "Your body feels like jelly."
msgstr "Tu cuerpo se siente como gelatina."

#. ~ Spell name
#: data/json/artifact/legacy_artifact_active.json
msgid "Artifact Radiation"
msgstr "Artefacto Radiación"

#. ~ Description of spell "Artifact Radiation"
#: data/json/artifact/legacy_artifact_active.json
msgid "Causes radiation."
msgstr "Causa radiación."

#. ~ Message of spell "Artifact Radiation"
#: data/json/artifact/legacy_artifact_active.json
msgid "Horrible gases are emitted!"
msgstr "¡Se emiten gases horribles!"

#. ~ Description of spell "Artifact Hurtall"
#: data/json/artifact/legacy_artifact_active.json
msgid "Hurts all monsters within your view distance."
msgstr "Hiere a todos los monstruos dentro de su distancia de visión."

#. ~ Spell name
#: data/json/artifact/legacy_artifact_active.json
msgid "Artifact Acidball"
msgstr "Artefacto Bola Acida"

#. ~ Description of spell "Artifact Acidball"
#: data/json/artifact/legacy_artifact_active.json
msgid "Fires an acidball."
msgstr "Dispara una bola de ácido."

#. ~ Description of spell "Pet"
#: data/json/artifact/legacy_artifact_active.json
msgid "Makes the target a pet."
msgstr "Hace del objetivo una mascota."

#. ~ Spell name
#: data/json/artifact/legacy_artifact_active.json
msgid "Artifact Flies Buzz"
msgstr "Artefacto Zumbido Moscas"

#. ~ Description of spell "Artifact Flies Buzz"
