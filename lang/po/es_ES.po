msgstr "Te inyectas un poco de hierro."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "marijuana"
msgid_plural "marijuana"
msgstr[0] "marihuana"
msgstr[1] "marihuana"
msgstr[2] "marihuana"

#. ~ Description of "marijuana"
#: data/json/items/comestibles/med.json
msgid ""
"The dried flower buds and leaves harvested from a psychoactive variety of "
"hemp plant.  Used to reduce nausea, stimulate appetite and elevate mood.  It"
" can be habit-forming, and adverse reactions are possible."
msgstr ""
"Hojas y capullos secos de flores, de una variedad de la planta de cáñamo. "
"Utilizado para reducir las náuseas, estimular el apetito y mejorar el ánimo."
" Puede crear hábito y causar algunas reacciones adversas."

#. ~ "activation_message" action message of item "marijuana"
#: data/json/items/comestibles/med.json
msgid "You smoke some weed.  Good stuff, man!"
msgstr "Fumas un poco de marihuana. ¡Tío, buena cosa!"

