#. ~ Name of martial art
#: data/mods/MMA/martialarts.json
msgid "Desert Wind"
msgstr "Viento del Desierto"

#. ~ Description of martial art "Desert Wind"
#: data/mods/MMA/martialarts.json
msgid ""
"Followers of the Desert Wind discipline learn to channel their inner "
"strength into powerful spirals of fire.  Always on the move, Desert Wind "
"students use their weapons as a conduit to burn their opponents with searing"
" flames.  Furthermore, these flames expand outward with explosive force, "
"damaging anyone nearby."
msgstr ""
"Seguidores de la disciplina Viento del Desierto aprenden a canalizar su "
"fuerza interior en poderosas espirales de fuego. Siempre en movimiento, los "
"estudiantes de Viento del Desierto utilizan sus armas como conducto para "
"quemar a sus oponentes con llamas abrasadoras. Además, estas llamas se "
"expanden hacia fuera con una fuerza explosiva, dañando a cualquiera que esté"
" cerca."

#. ~ Initiate message of martial art "Desert Wind"
#: data/mods/MMA/martialarts.json
msgid ""
"You feel a wave of heat wash over you as you assume a running combat stance."
msgstr ""
"Sientes una oleada de calor que te invade mientras adoptas una postura de "
"combate corriendo."

#. ~ Initiate message of martial art "Desert Wind"
#: data/mods/MMA/martialarts.json
#, c-format
msgid "%s assumes into a running combat stance."
msgstr "%s adopta una postura de combate en carrera."

#. ~ Buff name of martial art "Desert Wind"
#: data/mods/MMA/martialarts.json
msgid "Wind Stride"
msgstr "Zancada de Viento"

#. ~ Description of buff "Desert Wind" in martial art "Wind Stride"
#: data/mods/MMA/martialarts.json
msgid ""
"Your movement is hastened as if a strong wind is always at your back.\n"
"\n"
"+1.0 Dodging skill.\n"
"Lasts 1 turn.  Stacks 2 times."
msgstr ""

#. ~ Buff name of martial art "Desert Wind"
#: data/mods/MMA/martialarts.json
msgid "Zephyr Dance"
msgstr "Danza del Céfiro"

#. ~ Description of buff "Desert Wind" in martial art "Zephyr Dance"
#: data/mods/MMA/martialarts.json
msgid ""
"Your graceful and fluid movements allow you to avoid attacks with ease.\n"
"\n"
"+1.0 Dodging skill, +1 dodge attempt.\n"
"Lasts 2 turns."
msgstr ""

#. ~ Name of martial art
#: data/mods/MMA/martialarts.json
msgid "Diamond Mind"
msgstr "Mente Diamante"

#. ~ Description of martial art "Diamond Mind"
#: data/mods/MMA/martialarts.json
msgid ""
"A student of the Diamond Mind discipline has honed their mind to defeat any "
"opponent.  With quick reflexes and surgical precision, they are able to move"
" so fast that their opponents are unable react.  Marked by unparalleled "
"confidence, those that hesitate for even a moment will fall before them in "
"the blink of an eye."
msgstr ""
"Un estudiante de la disciplina Mente de Diamante ha perfeccionado su mente "
"para derrotar a cualquier oponente. Con rápidos reflejos y una precisión "
"quirúrgica, son capaces de moverse tan rápido que sus oponentes son "
"incapaces de reaccionar. Marcados por una confianza sin parangón, los que "
"dudan aunque sea un momento caerán ante ellos en un abrir y cerrar de ojos."

#. ~ Initiate message of martial art "Diamond Mind"
#: data/mods/MMA/martialarts.json
msgid "You concentrate and become very still for a moment."
msgstr "Te concentras y te quedas muy quieto por un momento."

#. ~ Initiate message of martial art "Diamond Mind"
#: data/mods/MMA/martialarts.json
#, c-format
msgid "%s becomes very still for a moment."
msgstr "%s se queda muy quieto por un momento."

#. ~ Buff name of martial art "Diamond Mind"
#: data/mods/MMA/martialarts.json
msgid "Stance of Alacrity"
msgstr "Postura de Presteza"

#. ~ Description of buff "Diamond Mind" in martial art "Stance of Alacrity"
#: data/mods/MMA/martialarts.json
#, no-c-format
msgid ""
"Your mind is clearer than normal.  This clarity allows you to move slightly faster in combat.\n"
"\n"
"-15% move cost."
msgstr ""

#. ~ Buff name of martial art "Diamond Mind"
#: data/mods/MMA/martialarts.json
msgid "Pearl of Black Doubt"
msgstr "Perla de Duda Negra"

#. ~ Description of buff "Diamond Mind" in martial art "Pearl of Black Doubt"
#: data/mods/MMA/martialarts.json
msgid ""
"Each attack that misses you casts doubt on your opponents' skill.  It becomes more obvious with each failed attack how untouchable you are.\n"
"\n"
"+1 dodge attempt.\n"
"Lasts 1 turn.  Stacks 2 times."
msgstr ""

#. ~ Buff name of martial art "Diamond Mind"
#: data/mods/MMA/martialarts.json
msgid "Quicksilver Motion"
msgstr "Movimiento PlataRápida"

#. ~ Description of buff "Diamond Mind" in martial art "Quicksilver Motion"
#: data/mods/MMA/martialarts.json
msgid ""
"Taking a moment to concentrate, you surge forward with incredible speed and act in the blink of an eye.\n"
"\n"
"+50 speed.\n"
"Lasts 1 turn."
msgstr ""

#. ~ Buff name of martial art "Diamond Mind"
#: data/mods/MMA/martialarts.json
msgid "Mind over Body"
msgstr "Mente sobre Cuerpo"

#. ~ Description of buff "Diamond Mind" in martial art "Mind over Body"
#: data/mods/MMA/martialarts.json
msgid ""
"Your well trained mind allows you to briefly shrug off the effects of pain while in combat.\n"
"\n"
"+1 accuracy.\n"
"Lasts 1 turn.  Stacks 2 times."
msgstr ""

#. ~ Name of martial art
#: data/mods/MMA/martialarts.json
msgid "Hylian Swordsmanship"
msgstr "Manejo de Espada Hylian"

#. ~ Description of martial art "Hylian Swordsmanship"
#: data/mods/MMA/martialarts.json
msgid ""
"This rare form of combat has been practiced by many legendary heroes "
"throughout the ages.  Hylian Swordsmanship favors mobility for offense and "
"defense by using spins, jumps, and flips to confuse enemies and strike from "
"unexpected angles."
msgstr ""
"Esta rara forma de combate ha sido practicada por muchos héroes legendarios "
"a lo largo de los tiempos. El Manejo de Espada Hylian favorece la movilidad "
"en la ofensiva y la defensa mediante el uso de giros, saltos y volteretas "
"para confundir a los enemigos y golpear desde ángulos inesperados."

#. ~ Initiate message of martial art "Hylian Swordsmanship"
#: data/mods/MMA/martialarts.json
msgid "You begin to step lightly from side to side."
msgstr "Comienza a dar pasos ligeros de un lado a otro."

#. ~ Initiate message of martial art "Hylian Swordsmanship"
#: data/mods/MMA/martialarts.json
#, c-format
msgid "%s begins to step lightly from side to side."
msgstr "%s comienza a dar pasos ligeros de un lado a otro."

#. ~ Buff name of martial art "Hylian Swordsmanship"
#: data/mods/MMA/martialarts.json
msgid "Combat Acrobat"
msgstr "Acróbata de Combate"

#. ~ Description of buff "Hylian Swordsmanship" in martial art "Combat
#. Acrobat"
#: data/mods/MMA/martialarts.json
msgid ""
"Always stay light on your feet.  It is better to evade than be hit.\n"
"\n"
"+1 accuracy."
msgstr ""

#. ~ Buff name of martial art "Hylian Swordsmanship"
#: data/mods/MMA/martialarts.json
msgid "Intermediate Combat Acrobat"
msgstr "Acróbata de Combate Intermedio"

#. ~ Description of buff "Hylian Swordsmanship" in martial art "Intermediate
#. Combat Acrobat"
#: data/mods/MMA/martialarts.json
msgid ""
"After a great deal of practice, you have become even more nimble in a battle.\n"
"\n"
"+1.0 Dodging skill."
msgstr ""
"Después de mucha práctica, te has vuelto aún más ágil en una batalla.\n"
"\n"
"+1,0 Habilidad de Esquivar"

#. ~ Buff name of martial art "Hylian Swordsmanship"
#: data/mods/MMA/martialarts.json
msgid "Master Combat Acrobat"
msgstr "Acróbata de Combate Maestro"

#. ~ Description of buff "Hylian Swordsmanship" in martial art "Master Combat
#. Acrobat"
#: data/mods/MMA/martialarts.json
msgid ""
"You have seen so much combat that your dodging skills have become top notch!\n"
"\n"
"+1.0 Dodging skill."
msgstr ""
"Has visto tantos combates que tu habilidad para esquivar se ha convertido en la más avanzada.\n"
"\n"
"+1.0 Habilidad para Esquivar."

#. ~ Buff name of martial art "Hylian Swordsmanship"
#: data/mods/MMA/martialarts.json
msgid "Dash Attack"
msgstr "Ataque de Lanzamiento"

#. ~ Description of buff "Hylian Swordsmanship" in martial art "Dash Attack"
#: data/mods/MMA/martialarts.json
#, no-c-format
msgid ""
"Taking advantage of momentum, you rush towards foes to deliver a powerful strike.\n"
"\n"
"+10% damage.\n"
"Lasts 1 turn.  Stacks 3 times."
msgstr ""
"Aprovechando el impulso, te precipitas hacia los enemigos para asestar un poderoso golpe.\n"
"\n"
"+10% de daño.\n"
"Dura 1 turno. Se acumula hasta 3 veces."

#. ~ Buff name of martial art "Hylian Swordsmanship"
#: data/mods/MMA/martialarts.json
msgid "Flurry Rush"
msgstr "Ráfaga Apresurada"

#. ~ Description of buff "Hylian Swordsmanship" in martial art "Flurry Rush"
#: data/mods/MMA/martialarts.json
#, no-c-format
msgid ""
"When you perfectly dodge an attack, you can attack rapidly for a short time.\n"
"\n"
"-25% move cost.\n"
"Lasts 1 turn."
msgstr ""
"Cuando esquivas perfectamente un ataque, puedes atacar rápidamente durante un breve periodo de tiempo.\n"
"\n"
"-25% de coste de movimiento.\n"
"Dura 1 turno."

#. ~ Description of buff "Hylian Swordsmanship" in martial art "Spinning"
#: data/mods/MMA/martialarts.json
#, no-c-format
msgid ""
"You keep on spinning!  You can still move while spinning but it slows you down quite a bit.\n"
"\n"
"+25% move cost.\n"
"Enables \"Spin Attack\" technique.\n"
"Lasts 5 turns after your last spin."
msgstr ""

#. ~ Buff name of martial art "Hylian Swordsmanship"
#: data/mods/MMA/martialarts.json
msgid "Charge Up"
msgstr "Cargar"

#. ~ Description of buff "Hylian Swordsmanship" in martial art "Charge Up"
#: data/mods/MMA/martialarts.json
#, no-c-format
msgid ""
"By taking a moment to prepare, you can unleash a strong, spinning slash!\n"
"\n"
"+20% damage.\n"
"Enables \"Spin Attack\" technique.\n"
"Lasts 1 turn."
msgstr ""

#. ~ Buff name of martial art "Hylian Swordsmanship"
#: data/mods/MMA/martialarts.json
msgid "Greater Charge Up"
msgstr ""

#. ~ Description of buff "Hylian Swordsmanship" in martial art "Greater Charge
#. Up"
#: data/mods/MMA/martialarts.json
msgid ""
"By charging a second time, you are able to keep on spinning with slightly less destructive force after the first spin.\n"
"\n"
"Lasts 1 turn."
msgstr ""

#. ~ Name of martial art
#: data/mods/MMA/martialarts.json
msgid "Iron Heart"
msgstr "Corazón de Hierro"

#. ~ Description of martial art "Iron Heart"
#: data/mods/MMA/martialarts.json
msgid ""
"The Iron Heart discipline is the study of combat.  Nothing more but also "
"nothing less.  Iron Heart students practice endlessly to achieve a complete "
"and absolute mastery of their weapon.  Users of Iron Heart are easily able "
"to disable and dispatch opponents with superior skill and technique.  Only "
"the fool would attempt to fight an Iron Heart student head-on."
msgstr ""
"La disciplina Corazón de Hierro es el estudio del combate. Nada más pero "
"también nada menos. Los estudiantes de Corazón de Hierro practican sin cesar"
" para lograr un dominio completo y absoluto de su arma. Los usuarios de "
"Corazón de Hierro son capaces de inutilizar y despachar fácilmente a sus "
"oponentes con una habilidad y una técnica superiores. Sólo los tontos "
"intentarían luchar contra un estudiante de Corazón de Hierro de frente."

#. ~ Initiate message of martial art "Iron Heart"
#: data/mods/MMA/martialarts.json
msgid "You push away your fear and stand tall."
msgstr "Alejas el miedo y mantente firme."

#. ~ Initiate message of martial art "Iron Heart"
#: data/mods/MMA/martialarts.json
#, c-format
msgid "%s takes a bold and fearless stance."
msgstr "%s adopta una postura audaz y sin miedo."

#. ~ Name of martial art
#: data/mods/MMA/martialarts.json
msgid "Panzer Kunst"
msgstr "Panzer Kunst"

#. ~ Description of martial art "Panzer Kunst"
#: data/mods/MMA/martialarts.json
msgid ""
"Panzer Kunst or \"Armor Art\" is a futuristic martial art devised for "
"cyborgs fighting in zero-gravity environments."
msgstr ""
"Panzer Kunst  o 'Arte de armadura' es un arte marcial futurista diseñado "
"para los cyborgs que luchan en entornos de gravedad cero."

#. ~ Initiate message of martial art "Panzer Kunst"
#: data/mods/MMA/martialarts.json
msgid "You adopt a panzer kunst stance."
msgstr "Adopta una postura panzer kunst."

#. ~ Initiate message of martial art "Panzer Kunst"
#: data/mods/MMA/martialarts.json
#, c-format
msgid "%s adopts a panzer kunst stance."
msgstr "%s adopta una postura panzer kunst."

#. ~ Buff name of martial art "Panzer Kunst"
#: data/mods/MMA/martialarts.json
msgid "Schatten Folgen"
msgstr "Rastreo de la Sombra"

#. ~ Description of buff "Panzer Kunst" in martial art "Schatten Folgen"
#: data/mods/MMA/martialarts.json
#, no-c-format
msgid ""
"\"Shadow Tracking\"\n"
"As a künstler, you are trained to stay in your target's blind spot.\n"
"\n"
"+1 dodge attempt, Dodging skill increased by 15% of Perception."
msgstr ""

#. ~ Buff name of martial art "Panzer Kunst"
#: data/mods/MMA/martialarts.json
msgid "Seinerweisen"
msgstr "Seinerweisen"

#. ~ Description of buff "Panzer Kunst" in martial art "Seinerweisen"
#: data/mods/MMA/martialarts.json
#, no-c-format
msgid ""
"\"Personal Wisdom\"\n"
"Through your mastery of Panzer Kunst, you have earned the ability to manipulate deadly plasma into all of your attacks!\n"
"\n"
"Electric damage equal to 50% of Perception."
msgstr ""

#. ~ Buff name of martial art "Panzer Kunst"
#: data/mods/MMA/martialarts.json
msgid "Einzug Rüstungen"
msgstr "Einzug Rüstungen"

#. ~ Description of buff "Panzer Kunst" in martial art "Einzug Rüstungen"
#: data/mods/MMA/martialarts.json
#, no-c-format
msgid ""
"\"Armor Penetration\"\n"
"By attuning to the rhythm of your opponent, you can strike where their guard is the weakest.\n"
"\n"
"+1 accuracy, armor penetration increased by 50% of Perception.\n"
"Lasts 3 turns."
msgstr ""

#. ~ Name of martial art
#: data/mods/MMA/martialarts.json
msgid "Pokken"
msgstr "Pokken"

#. ~ Description of martial art "Pokken"
#: data/mods/MMA/martialarts.json
msgid ""
"Pokken or \"Pocket Fist\" is a strange martial art developed from the famous"
" Pokémon video game series.  Somehow, a group of dedicated fans managed to "
"combine the moves used by various Pokémon with multiple existing martial "
"arts such as boxing and karate.  Amazingly, it actually works.  Some might "
"even say it's a super effective way to fight."
msgstr ""

#. ~ Initiate message of martial art "Pokken"
#: data/mods/MMA/martialarts.json
msgid "You get ready to battle."
msgstr "Te preparas para la batalla."

#. ~ Initiate message of martial art "Pokken"
#: data/mods/MMA/martialarts.json
#, c-format
msgid "%s is about to challenge someone to a battle."
msgstr "%s está a punto de desafiar a alguien a una batalla."

#. ~ Description of buff "Pokken" in martial art "Stamina"
#: data/mods/MMA/martialarts.json
#, no-c-format
msgid ""
"Boosts your defense after you get hit.\n"
"\n"
"Bash, cut, and stab armor increased by 50% of Strength.\n"
"Lasts 3 turns."
msgstr ""

#. ~ Buff name of martial art "Pokken"
#: data/mods/MMA/martialarts.json
msgid "Sniper"
msgstr "Francotirador"

#. ~ Description of buff "Pokken" in martial art "Sniper"
#: data/mods/MMA/martialarts.json
#, no-c-format
msgid ""
"Powers up your techniques after you score a critical hit.\n"
"\n"
"+50% damage.\n"
"Lasts 1 turn."
msgstr ""
"Potencia tus técnicas después de conseguir un golpe crítico.\n"
"\n"
"+50% de daño.\n"
"Dura 1 turno."

#. ~ Buff name of martial art "Pokken"
#: data/mods/MMA/martialarts.json
msgid "Moxie"
msgstr "Moxie"

#. ~ Description of buff "Pokken" in martial art "Moxie"
#: data/mods/MMA/martialarts.json
#, no-c-format
msgid ""
"Boosts your damage after defeating an opponent.\n"
"\n"
"+50% damage.\n"
"Lasts 3 turns."
msgstr ""
"Aumenta tu daño tras derrotar a un oponente.\n"
"\n"
"+50% de daño.\n"
"Dura 3 turnos."

#. ~ Name of martial art
#: data/mods/MMA/martialarts.json
msgid "Setting Sun"
msgstr "Sol Poniente"

#. ~ Description of martial art "Setting Sun"
#: data/mods/MMA/martialarts.json
msgid ""
"The Setting Sun discipline teaches its initiates to turn their opponents' "
"advantages into disadvantages.  Students of this discipline are able to able"
" to fool their opponents and then turn their strength against them with a "
"powerful throw."
msgstr ""
"La disciplina Sol Poniente enseña a sus iniciados a convertir las ventajas "
"de tus oponentes en desventajas. Los estudiantes de esta disciplina son "
"capaces de engañar a tus oponentes y luego volver su fuerza contra ellos con"
" un poderoso lanzamiento."

#. ~ Initiate message of martial art "Setting Sun"
#: data/mods/MMA/martialarts.json
msgid "You shift your weight and prepare to defend yourself."
msgstr "Cambias tu peso y te preparas para defenderte."

#. ~ Initiate message of martial art "Setting Sun"
#: data/mods/MMA/martialarts.json
#, c-format
msgid "%s shifts their weight and assumes a new stance."
msgstr "%s cambia su peso y asume una nueva postura."

#. ~ Buff name of martial art "Setting Sun"
#: data/mods/MMA/martialarts.json
msgid "Feigned Opening"
msgstr "Apertura Simulada"

#. ~ Description of buff "Setting Sun" in martial art "Feigned Opening"
#: data/mods/MMA/martialarts.json
msgid ""
"By faking an opening, you able to throw your opponent off balance and act quicker for a short time.\n"
"\n"
"+20 speed.\n"
"Lasts 1 turn."
msgstr ""

#. ~ Buff name of martial art "Setting Sun"
#: data/mods/MMA/martialarts.json
msgid "Baffling Defense"
msgstr "Defensa Desconcertante"

#. ~ Description of buff "Setting Sun" in martial art "Baffling Defense"
#: data/mods/MMA/martialarts.json
#, no-c-format
msgid ""
"You ready yourself for your opponent attack while preparing to send them flying!\n"
"\n"
"Dodging skill increased by 20% of Intelligence.\n"
"Enables \"Mighty Throw\" and \"Ballista Throw\" techniques.\n"
"Lasts 2 turns."
msgstr ""

#. ~ Buff name of martial art "Setting Sun"
#: data/mods/MMA/martialarts.json
msgid "Fool's Strike"
msgstr "Golpe del Idiota"

#. ~ Description of buff "Setting Sun" in martial art "Fool's Strike"
#: data/mods/MMA/martialarts.json
#, no-c-format
msgid ""
"You moved in such a deceptived that you have turned your opponent's attack against them.\n"
"\n"
"+20% damage.\n"
"Lasts 2 turns."
msgstr ""
"Te mueves de una manera tan engañosa que has desviado el ataque de tu oponente hacia él mismo.\n"
"\n"
"+20% daño.\n"
"Dura 2 turnos."

#. ~ Name of martial art
#: data/mods/MMA/martialarts.json
msgid "Shii-Cho"
msgstr "Shii-Cho"

#. ~ Description of martial art "Shii-Cho"
#: data/mods/MMA/martialarts.json
msgid ""
"Shii-Cho, \"The way of the Sarlacc\" was the first form lightsaber combat "
"developed by the Jedi during their transition from metal weaponry to "
"lightsabers.  Shii-Cho is regarded as a training form that all Jedi learn to"
" understand the basics of armed combat.  Shii-Cho excels at fighting against"
" groups but lacks the offensive power of the other lightsaber forms."
msgstr ""
"El Shii-Cho, \"El camino del Sarlacc\", fue la primera forma de combate con "
"sable láser desarrollada por los Jedi durante su transición del armamento "
"metálico al sable láser. El Shii-Cho se considera una forma de entrenamiento"
" que todos los Jedi aprenden para comprender los fundamentos del combate "
"armado. El Shii-Cho destaca en la lucha contra grupos, pero carece del poder"
" ofensivo de las otras formas de sable láser."

#. ~ Initiate message of martial art "Shii-Cho"
#: data/mods/MMA/martialarts.json
msgid ""
"You place one foot back and hold your weapon vertically on your dominant "
"side."
msgstr ""
"Colocas un pie atrás y sostienes tu arma verticalmente en tu lado dominante."

#. ~ Initiate message of martial art "Shii-Cho"
#: data/mods/MMA/martialarts.json
#, c-format
msgid "%s places one foot back and hold their weapon vertically."
msgstr "%s coloca un pie atrás y sostiene su arma verticalmente."

#. ~ Description of buff "Shii-Cho" in martial art "Determination"
#: data/mods/MMA/martialarts.json
#, no-c-format
msgid ""
"You are a determined warrior.  Your inner calm aids you in landing your strikes and protecting yourself.\n"
"\n"
"Blocked damage reduced by 100% of Strength, +1 accuracy."
msgstr ""

#. ~ Buff name of martial art "Shii-Cho"
#: data/mods/MMA/martialarts.json
msgid "Apprentice Training"
msgstr "Entrenamiento de Aprendiz"

#. ~ Description of buff "Shii-Cho" in martial art "Apprentice Training"
#: data/mods/MMA/martialarts.json
msgid ""
"Your training in Shii-Cho teaches you how to combat multiple opponents.\n"
"\n"
"+1 block attempt, +1 blocking effectiveness."
msgstr ""

#. ~ Buff name of martial art "Shii-Cho"
#: data/mods/MMA/martialarts.json
msgid "Knight Training"
msgstr "Entrenamiento de Caballero"

#. ~ Description of buff "Shii-Cho" in martial art "Knight Training"
#: data/mods/MMA/martialarts.json
msgid ""
"Further training in Shii-Cho improves your ability to combat multiple opponents.\n"
"\n"
"+1 block attempt, +1 blocking effectiveness."
msgstr ""

#. ~ Buff name of martial art "Shii-Cho"
#: data/mods/MMA/martialarts.json
msgid "Master Training"
msgstr "Entrenamiento Maestro"

#. ~ Description of buff "Shii-Cho" in martial art "Master Training"
#: data/mods/MMA/martialarts.json
msgid ""
"As a master of Shii-Cho, your ability to fight against groups is second to none.\n"
"\n"
"+1 block attempt, +1 blocking effectiveness."
msgstr ""

#. ~ Buff name of martial art "Shii-Cho"
#: data/mods/MMA/martialarts.json
msgid "Flowing Water"
msgstr "Corrientes de Agua"

#. ~ Description of buff "Shii-Cho" in martial art "Flowing Water"
#: data/mods/MMA/martialarts.json
#, no-c-format
msgid ""
"You are able to deflect an attack and counter in the same motion.\n"
"\n"
"-25% move cost.\n"
"Lasts 1 turn."
msgstr ""
"Eres capaz de desviar un ataque y contratacar en el mismo movimiento.\n"
"\n"
"-25% al costo de movimiento.\n"
"Dura 1 turno."

#. ~ Name of martial art
#: data/mods/MMA/martialarts.json
msgid "Stone Dragon"
msgstr "Dragón de Piedra"

#. ~ Description of martial art "Stone Dragon"
#: data/mods/MMA/martialarts.json
msgid ""
"Strength, endurance, and patience are the cornerstones of the Stone Dragon "
"discipline.  Stone Dragon students are taught to end battles with a single, "
"powerful blow.  By standing still for a moment, the user can fortify "
"themselves with the power of stone."
msgstr ""
"Fuerza, resistencia y paciencia son las piedras angulares de la disciplina "
"del Dragón de Piedra. A los estudiantes del Dragón de Piedra se les enseña a"
" terminar las batallas con un único y poderoso golpe. Al quedarse quieto un "
"momento, el usuario puede fortalecerse con el poder de la piedra."

#. ~ Initiate message of martial art "Stone Dragon"
#: data/mods/MMA/martialarts.json
msgid "You dig your heels into the ground and steady yourself."
msgstr "Clavas los talones en el suelo y te estabilizas."

#. ~ Initiate message of martial art "Stone Dragon"
#: data/mods/MMA/martialarts.json
#, c-format
msgid "%s digs their heels into the ground."
msgstr "%s clava sus talones en el suelo."

#. ~ Buff name of martial art "Stone Dragon"
#: data/mods/MMA/martialarts.json
msgid "Stone Bones"
msgstr "Huesos de Piedra"

#. ~ Description of buff "Stone Dragon" in martial art "Stone Bones"
#: data/mods/MMA/martialarts.json
msgid ""
"Each attack against your opponents slowly steels your defenses.\n"
"\n"
"+1 bash, cut, and stab armor.\n"
"Lasts 3 turns.  Stacks 5 times."
msgstr ""

#. ~ Buff name of martial art "Stone Dragon"
#: data/mods/MMA/martialarts.json
msgid "Stonefoot Stance"
msgstr "Postura de Pie de Piedra"

#. ~ Description of buff "Stone Dragon" in martial art "Stonefoot Stance"
#: data/mods/MMA/martialarts.json
#, no-c-format
msgid ""
"You maintain a steady stance that improves your combat prowess.  However, moving too much will break your stance.\n"
"\n"
"+10% damage, +2 bash, cut, and stab armor."
msgstr ""
"Mantienes una postura firme que mejora tu destreza en el combate. Sin embargo, si te mueves demasiado, romperás tu postura.\n"
"\n"
"+10% de daño, +2 de armadura contundente, cortante y perforante."

#. ~ Buff name of martial art "Stone Dragon"
#: data/mods/MMA/martialarts.json
msgid "Cracked Stone"
msgstr "Piedra Agrietada"

#. ~ Description of buff "Stone Dragon" in martial art "Cracked Stone"
#: data/mods/MMA/martialarts.json
msgid ""
"Moving too much will negate the effects of Surefoot Stance.  Stay still to avoid shattering your stance!\n"
"\n"
"Enables \"Shattered Stone\" buff.\n"
"Lasts 1 turn."
msgstr ""
"Moverse demasiado anulará los efectos de la Postura Pie Seguro. Quédate quieto para evitar que se rompa tu postura.\n"
"\n"
"Activa el potenciador \"Piedra Destrozada\".\n"
"Dura 1 turno."

#. ~ Buff name of martial art "Stone Dragon"
#: data/mods/MMA/martialarts.json
msgid "Shattered Stone"
msgstr ""

#. ~ Description of buff "Stone Dragon" in martial art "Shattered Stone"
#: data/mods/MMA/martialarts.json
#, no-c-format
msgid ""
"You are unable to maintain your Surefoot Stance and must stop moving for a short time to regain its benefits.\n"
"\n"
"-10% damage, -2 bash, cut, and stab armor.\n"
"Lasts 1 turn."
msgstr ""

#. ~ Buff name of martial art "Stone Dragon"
#: data/mods/MMA/martialarts.json
msgid "Iron Bones"
msgstr "Huesos de Hierro"

#. ~ Description of buff "Stone Dragon" in martial art "Iron Bones"
#: data/mods/MMA/martialarts.json
msgid ""
"With a powerful strike, you further fortify yourself again counterattacks!\n"
"\n"
"+5 bash, cut, and stab armor.\n"
"Lasts 1 turn."
msgstr ""
"Con un poderoso golpe, te fortaleces aún más en los contraataques.\n"
"\n"
"+5 armadura contundente, cortante y perforante.\n"
"Dura 1 turno."

#. ~ Description of martial art "Tiger Claw"
#: data/mods/MMA/martialarts.json
msgid ""
"The Tiger Claw discipline embraces the fury and power of a wild beast.  "
"Attacks from a Tiger Claw student are vicious and very few can stand against"
" the might of a frenzied animal."
msgstr ""
"La disciplina Garra de Tigre abarca la furia y el poder de una bestia "
"salvaje. Los ataques de un estudiante de Garra de Tigre son feroces y muy "
"pocos pueden resistir el poder de un animal frenético."

#. ~ Initiate message of martial art "Tiger Claw"
#: data/mods/MMA/martialarts.json
msgid "You emit a low growl as you prepare for battle."
msgstr "Emites un gruñido bajo mientras te preparas para la batalla."

#. ~ Initiate message of martial art "Tiger Claw"
#: data/mods/MMA/martialarts.json
#, c-format
msgid "%s hunkers down like a wild animal."
msgstr "%s se agacha como un animal salvaje."

#. ~ Buff name of martial art "Tiger Claw"
#: data/mods/MMA/martialarts.json
msgid "Improved Critical"
msgstr "Crítico Mejorado"

#. ~ Description of buff "Tiger Claw" in martial art "Improved Critical"
#: data/mods/MMA/martialarts.json
#, no-c-format
msgid ""
"Always strike with full force.  Never hold back anything unless you want to die.\n"
"\n"
"+5% critical hit chance."
msgstr ""
"Golpea siempre con la fuerza máxima. Nunca retengas nada a menos que quieras morir.\n"
"\n"
"+5% prob. golpe crítico."

#. ~ Buff name of martial art "Tiger Claw"
#: data/mods/MMA/martialarts.json
msgid "Pounching Charge"
msgstr "Carga de Golpes"

#. ~ Description of buff "Tiger Claw" in martial art "Pounching Charge"
#: data/mods/MMA/martialarts.json
#, no-c-format
msgid ""
"You recklessly throw yourself into battle to overpower your prey.  Strike first and strike hard.\n"
"\n"
"+2 accuracy, +10% damage.\n"
"Lasts 1 turn."
msgstr ""

#. ~ Buff name of martial art "Tiger Claw"
#: data/mods/MMA/martialarts.json
msgid "Cornered Predator"
msgstr "Depredador Acorralado"

#. ~ Description of buff "Tiger Claw" in martial art "Cornered Predator"
#: data/mods/MMA/martialarts.json
#, no-c-format
msgid ""
"A cornered animal is a terrifying and dangerous creature.  You are no different.\n"
"\n"
"-20% move cost.\n"
"Lasts 1 turn."
msgstr ""
"Un animal acorralado es una criatura aterradora y peligrosa. Tú no eres diferente.\n"
"\n"
"-20% de coste de movimiento.\n"
"Dura 1 turno."

#. ~ Buff name of martial art "Tiger Claw"
#: data/mods/MMA/martialarts.json
msgid "Blood In The Water"
msgstr "Sangre En El Agua"

#. ~ Description of buff "Tiger Claw" in martial art "Blood In The Water"
#: data/mods/MMA/martialarts.json
#, no-c-format
msgid ""
"The scent of blood is near.  You want more.  NOW!\n"
"\n"
"+1 accuracy, +15% damage.\n"
"Lasts 1 turn.  Stacks 2 times."
msgstr ""

#. ~ Buff name of martial art "Tiger Claw"
#: data/mods/MMA/martialarts.json
msgid "Prey on the Weak"
msgstr "Presa de los Débiles"

#. ~ Description of buff "Tiger Claw" in martial art "Prey on the Weak"
#: data/mods/MMA/martialarts.json
msgid ""
"You have started culling the herd.  It should be easier remove the rest now.\n"
"\n"
"+30 speed.\n"
"Lasts 2 turns.  Stacks 2 times."
msgstr ""

#. ~ MOD name
#: data/mods/MMA/modinfo.json
msgid "Mythical Martial Arts"
msgstr "Artes Marciales Míticas"

#. ~ Description of MOD "Mythical Martial Arts"
#: data/mods/MMA/modinfo.json
msgid ""
"A collection of fictional, mythologically inspired or otherwise unrealistic "
"martial arts."
msgstr ""
"Una colección de artes marciales ficticias, inspiradas en la mitología poco "
"realistas."

#. ~ Mutation name
#: data/mods/MMA/mutations.json
msgid "Künstler"
msgstr "Artista"

#. ~ Description of mutation "Künstler"
#: data/mods/MMA/mutations.json
msgid ""
"You have lingering memories of training to fight cyborgs and war machines in"
" zero gravity using the obscure Panzer Kunst."
msgstr ""
"Tienes recuerdos persistentes de entrenamiento para luchar contra cyborgs y "
"máquinas de guerra en gravedad cero usando el oscuro Panzer Kunst."

#. ~ Mutation name
#: data/mods/MMA/mutations.json
msgid "Drunken Master"
msgstr "Maestro Borracho"

#. ~ Description of mutation "Drunken Master"
#: data/mods/MMA/mutations.json
msgid ""
"The ancient arts of drunken brawling come naturally to you!  While under the"
" influence of alcohol, your melee skill will rise considerably, especially "
"unarmed combat."
msgstr ""
"¡El antiguo arte de las peleas de borrachos es natural para ti! Mientras "
"estás bajo la influencia del alcohol, tu habilidad de c. a c. se incrementa "
"considerablemente, especialmente en el combate sin armas."

#. ~ Mutation name
#: data/mods/MMA/mutations.json
msgid "Hero's Spirit"
msgstr "Espiritú de Heroe"

#. ~ Description of mutation "Hero's Spirit"
#: data/mods/MMA/mutations.json
msgid ""
"You have studied the deeds and legends of ancient heroes.  From your "
"research, you have learned an ancient form of combat called Hylian "
"Swordsmanship."
msgstr ""
"Has estudiado las hazañas y leyendas de antiguos héroes. De tu "
"investigación, has aprendido una antigua forma de combate llamada Manejo de "
"Espada Hylian."

#. ~ Mutation name
#: data/mods/MMA/mutations.json
msgid "Ki Strike"
msgstr "Golpe Ki"

#. ~ Description of mutation "Ki Strike"
#: data/mods/MMA/mutations.json
msgid ""
"Who needs weapons?  You deal more melee damage while unarmed.  This damage "
"improves as your unarmed skill increases."
msgstr ""
"¿Quién necesita armas? Causas más daño c. a c. cuando estás desarmado. Este "
"daño aumenta a medida que lo hace tu habilidad desarmado."

#. ~ Mutation name
#: data/mods/MMA/mutations.json
msgid "Jedi Training"
msgstr "Entrenamiento Jedi"

#. ~ Description of mutation "Jedi Training"
#: data/mods/MMA/mutations.json
msgid ""
"You are trained in the ways of the Jedi.  Your knowledge allows you to "
"utilize a form of lightsaber combat."
msgstr ""
"Estás entrenado en los caminos de los Jedi. Tus conocimientos te permiten "
"utilizar una forma de combate con sable láser."

#. ~ Mutation name
#: data/mods/MMA/mutations.json
msgid "Pokken Master"
msgstr "Maestro Pokken"

#. ~ Description of mutation "Pokken Master"
#: data/mods/MMA/mutations.json
msgid ""
"You are well versed in the monstrous Pocket Fist martial art.  Train well, "
"because it is your destiny to be a master."
msgstr ""

#. ~ Mutation name
#: data/mods/MMA/mutations.json
msgid "Martial Adept"
msgstr "Adepto Marcial"

#. ~ Description of mutation "Martial Adept"
#: data/mods/MMA/mutations.json
msgid ""
"You are a martial adept and learned one of the martial disciplines of the "
"Sublime Way.  You start with your choice of Desert Wind, Diamond Mind, Iron "
"Heart, Setting Sun, Stone Dragon, or Tiger Claw."
msgstr ""
"Eres un adepto marcial y has aprendido una de las disciplinas marciales del "
"Camino Sublime. Empiezas con tu elección de Viento del Desierto, Mente de "
"Diamante, Corazón de Hierro, Sol Poniente, Dragón de Piedra o Garra de "
"Tigre."

#. ~ Profession name for male
#: data/mods/MMA/professions.json
msgctxt "profession_male"
msgid "Battle Angel"
msgstr "Ángel de batalla"

#. ~ Description of profession "Battle Angel" for male
#: data/mods/MMA/professions.json
msgctxt "prof_desc_male"
msgid "A combat-ready cyborg once salvaged from an obscure junkyard…"
msgstr ""
"Un cyborg listo para el combate rescatado de un oscuro depósito de "
"chatarra..."

#. ~ Profession name for female
#: data/mods/MMA/professions.json
msgctxt "profession_female"
msgid "Battle Angel"
msgstr "Ángel de batalla"

#. ~ Description of profession "Battle Angel" for female
#: data/mods/MMA/professions.json
msgctxt "prof_desc_female"
msgid "A combat-ready cyborg once salvaged from an obscure junkyard…"
msgstr ""
"Una cyborg lista para el combate rescatada de un oscuro depósito de "
"chatarra..."

#. ~ Profession name for male
#: data/mods/MMA/professions.json
msgctxt "profession_male"
msgid "Hylian Adventurer"
msgstr "Aventurero de Hylian"

#. ~ Description of profession "Hylian Adventurer" for male
#: data/mods/MMA/professions.json
msgctxt "prof_desc_male"
msgid ""
"Sucked through a vortex into what appears to be a shadow realm, you will "
"continue to fight for justice."
msgstr ""
"Succionado a través de un vórtice en lo que parece ser un reino sombrio, "
"seguirás luchando por la justicia."

#. ~ Profession name for female
#: data/mods/MMA/professions.json
msgctxt "profession_female"
msgid "Hylian Adventurer"
msgstr "Aventurera de Hylian"

#. ~ Description of profession "Hylian Adventurer" for female
#: data/mods/MMA/professions.json
msgctxt "prof_desc_female"
msgid ""
"Sucked through a vortex into what appears to be a shadow realm, you will "
"continue to fight for justice."
msgstr ""
"Succionada a través de un vórtice en lo que parece ser un reino sombrio, "
"seguirás luchando por la justicia."

#. ~ Spell name
#: data/mods/MMA/spells.json
msgid "Ki Strike Meditations"
msgstr "Meditaciones de Golpe Ki"

#. ~ Description of spell "Ki Strike Meditations"
#: data/mods/MMA/spells.json
msgid "This grants a specific mutation."
msgstr "Esto concede una mutación específica."

#. ~ Message of spell "Ki Strike Meditations"
#: data/mods/MMA/spells.json
msgid "You study the meditations until you could do them in your sleep…"
msgstr ""
"Estudias las meditaciones hasta que las puedes hacer mientras duermes..."

#. ~ Martial technique name
#: data/mods/MMA/techniques.json
msgid "Burning Blade"
msgstr "Cuchilla en Llamas"

#. ~ Message of martial technique "Burning Blade"
#: data/mods/MMA/techniques.json
#, c-format
msgid "You unleash a fiery attack against %s"
msgstr "Desatas un ataque ardiente contra %s"

#. ~ Message of martial technique "Burning Blade"
#: data/mods/MMA/techniques.json
#, c-format
msgid "<npcname> unleash a fiery attack against %s"
msgstr "<npcname> desatas un ataque ardiente contra %s"

#. ~ Martial technique name
#: data/mods/MMA/techniques.json
msgid "Inferno Blade"
msgstr "Espada Infernal"

#. ~ Message of martial technique "Inferno Blade"
#: data/mods/MMA/techniques.json
#, c-format
msgid "You strike %s with powerful inferno"
msgstr "Golpeas a %s con el poderoso infierno"

#. ~ Message of martial technique "Inferno Blade"
#: data/mods/MMA/techniques.json
#, c-format
msgid "<npcname> strikes %s with powerful inferno"
msgstr "<npcname> golpea a %s con un poderoso infierno"

#. ~ Martial technique name
#: data/mods/MMA/techniques.json
msgid "Firesnake"
msgstr "Serpiente de Fuego"

#. ~ Message of martial technique "Firesnake"
#: data/mods/MMA/techniques.json
#, c-format
msgid "You strike through %s with a snaking flame"
msgstr "Golpeas a través de %s con una llama serpenteante"

#. ~ Message of martial technique "Firesnake"
#: data/mods/MMA/techniques.json
#, c-format
msgid "<npcname> strikes through %s with a snaking flame"
msgstr "<npcname> golpea a través de %s con una llama serpenteante"

#. ~ Martial technique name
#: data/mods/MMA/techniques.json
msgid "Ring of Fire"
msgstr "Anillo de Fuego"

#. ~ Message of martial technique "Ring of Fire"
#: data/mods/MMA/techniques.json
#, c-format
msgid "You become a flaming blur as you strike %s and those around you"
msgstr ""
"Te conviertes en una llama borrosa que golpea a %s y a aquellos cerca de ti"

#. ~ Message of martial technique "Ring of Fire"
#: data/mods/MMA/techniques.json
#, c-format
msgid ""
"<npcname> becomes a flaming blur as they strike %s and those around them"
msgstr ""
"<npcname> se convierte en una llama borrosa y golpea a %s y a aquellos "
"alrededor"

#. ~ Martial technique name
#: data/mods/MMA/techniques.json
msgid "Flashing Sun"
msgstr "Sol Cegador"

#. ~ Message of martial technique "Flashing Sun"
#: data/mods/MMA/techniques.json
#, c-format
msgid "You carve an arc through %s and those nearby"
msgstr "Tallas un arco a través de %s y aquellos cercanos"

#. ~ Message of martial technique "Flashing Sun"
#: data/mods/MMA/techniques.json
#, c-format
msgid "<npcname> carve an arc through %s and those nearby"
msgstr "<npcname> talla un arco a través de %s y a los que están cerca"

#. ~ Martial technique name
#: data/mods/MMA/techniques.json
msgid "Insightful Strike"
msgstr "Golpe Perspicaz"

#. ~ Message of martial technique "Insightful Strike"
