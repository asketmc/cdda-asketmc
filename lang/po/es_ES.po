msgstr[1] "cenizas de maderas"
msgstr[2] "cenizas de maderas"

#. ~ Description of "wood ash"
#: data/json/items/chemicals_and_resources.json
msgid ""
"This is almost-weightless residue left after the burning of some substance."
msgstr ""
"Esto es un residuo casi sin peso dejado después de que quemar alguna "
"sustancia."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
