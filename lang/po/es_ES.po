#. ~ Item name
#: data/json/items/comestibles/bread.json
msgid "hardtack"
msgid_plural "hardtack"
msgstr[0] "pan de pirata"
msgstr[1] "panes de pirata"
msgstr[2] "panes de pirata"

#. ~ Description of "hardtack"
#: data/json/items/comestibles/bread.json
msgid ""
"A dry, virtually tasteless bread product capable of remaining edible without"
" spoilage for vast lengths of time.  So dry it is almost inedible by itself."
msgstr ""
"Un producto de pan seco, prácticamente insípido, capaz de permanecer "
"comestible sin estropearse durante mucho tiempo. Tan seco que casi no es "
"comestible por sí mismo."

#. ~ Item name
#: data/json/items/comestibles/bread.json
msgid "soggy hardtack"
msgid_plural "soggy hardtack"
msgstr[0] "panecillos empapados"
msgstr[1] "panecillos empapados"
msgstr[2] "panecillos empapados"

#. ~ Description of "soggy hardtack"
#: data/json/items/comestibles/bread.json
msgid ""
"A soggy, virtually tasteless bread product that has soaked up enough water "
"that it won't hurt your teeth when you chew it."
msgstr ""
"Un producto de pan empapado y prácticamente insípido que ha absorbido "
"suficiente agua como para no dañar tus dientes al masticarlo."

#. ~ Item name
#: data/json/items/comestibles/bread.json
msgid "biscuit"
msgid_plural "biscuits"
msgstr[0] "galleta"
msgstr[1] "galletas"
msgstr[2] "galletas"

#. ~ Description of "biscuit"
#: data/json/items/comestibles/bread.json
msgid ""
"Hardtack's much more palatable descendant, thanks in large part to the "
"addition of milk in the recipe.  Crumbly on the outside, soft on the inside,"
" and delicious all the way through."
msgstr ""
"El descendiente del Hardtack es mucho más sabroso, gracias en gran parte a "
"la adición de leche en la receta. Desmenuzable por fuera, suave por dentro y"
" delicioso hasta el final."

#. ~ this item will generally inherit its values, so it is essentially a copy
