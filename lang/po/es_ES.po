#, c-format
msgid "Your %s misfires with a muffled click!"
msgstr "¡Tu %s falla con un chasquido amortiguado!"

#: src/ranged.cpp:607 src/ranged.cpp:645
#, c-format
msgid "<npcname>'s %s misfires with a muffled click!"
msgstr "¡%s de <npcname> falla con un chasquido amortiguado!"

