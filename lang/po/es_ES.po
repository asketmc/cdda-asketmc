msgid_plural "foot locker recharging stations"
msgstr[0] "estaciones de recarga tipo casillero"
msgstr[1] "estaciones de recarga tipo casillero"
msgstr[2] "estación de recarga tipo taquilla"

#. ~ Description of vehicle part "foot locker recharging station"
#: data/json/furniture_and_terrain/appliances.json
msgid ""
"An appliance for recharging batteries.  When turned on, it steadily charges "
"any rechargeable batteries (battery cells, lead-acid batteries, etc) placed "
"directly in the attached storage space."
msgstr ""
"Aparato para recargar baterías. Cuando se enciende, carga de forma constante"
" cualquier batería recargable (pilas, baterías de plomo, etc.) colocada "
"directamente en el espacio de almacenamiento acoplado."

#. ~ Vehicle part name
#. ~ Item name
#: data/json/furniture_and_terrain/appliances.json
#: data/json/items/appliances.json
msgid "box battery charger"
msgid_plural "box battery chargers"
msgstr[0] "cargadores de baterías tipo caja"
msgstr[1] "cargadores de baterías tcaja"
msgstr[2] "cargadores de baterías tipo caja"

#. ~ Description of vehicle part "box battery charger"
#: data/json/furniture_and_terrain/appliances.json
msgid ""
"An appliance for recharging batteries.  When turned on, it slowly charges "
"any rechargeable batteries (battery cells, lead-acid batteries, etc) placed "
"directly in the attached storage space."
msgstr ""
"Aparato para recargar baterías. Cuando se enciende, carga lentamente las "
"baterías recargables (pilas, baterías de plomo, etc.) colocadas directamente"
" en el espacio de almacenamiento acoplado."

#. ~ Description of vehicle part "Compact Advanced Sterling Radioisotope
#. Generator"
#: data/json/furniture_and_terrain/appliances.json
msgid ""
"A military-grade ASRG covered in heavy plating.  Provides constant power "
"when plugged in to your power grid."
msgstr ""
"Un ASRG de grado militar recubierto de un pesado chapado. Proporciona "
"energía constante cuando se conecta a la red eléctrica."

#. ~ Furniture name
