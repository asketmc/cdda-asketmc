msgstr "Cansancio de Maná"

#. ~ Description of spell "Mana Fatigue"
#: data/mods/Magiclysm/Spells/classless.json
msgid "Secondary effect of Crystallize Mana."
msgstr ""

#. ~ Spell name
#. ~ Name of effect type id "dark_sight"
#: data/mods/Magiclysm/Spells/classless.json
#: data/mods/Magiclysm/effects/effects.json
msgid "Dark Sight"
msgstr "Visión Oscura"

#. ~ Description of spell "Dark Sight"
#. ~ Description of spell "Night Sight"
#. ~ Description of spell "Eye gleam"
#: data/mods/Magiclysm/Spells/classless.json
#: data/mods/Xedra_Evolved/spells/classless_spells.json
#: data/mods/Xedra_Evolved/spells/vampire_spells.json
msgid "Gives you the power to see in the dark."
msgstr ""

#. ~ Message of spell "Dark Sight"
#: data/mods/Magiclysm/Spells/classless.json
msgid ""
"Your eyes glow green for a moment.  Now your sight can pierce the darkest "
"shadows."
msgstr ""
"Tus ojos brillan en verde por un momento. Ahora tu vista puede atravesar las"
" sombras más oscuras."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/classless.json
msgid "Megablast"
msgstr "MegaImpacto"

#. ~ Description of spell "Megablast"
#. ~ Classless spell
#. ~ Description of "Scroll of Megablast"
#: data/mods/Magiclysm/Spells/classless.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid ""
"You always wanted to fire energy beams like in the animes you watched as a "
"kid.  Now you can!"
msgstr ""
"Siempre quisiste disparar rayos de energía como en los animes que veías de "
"niño. ¡Ahora puedes!"

#. ~ Spell name
#: data/mods/Magiclysm/Spells/classless.json
msgid "Magical Light"
msgstr "Luz Mágica"

#. ~ Description of spell "Magical Light"
#. ~ Classless spell1
#. ~ Description of "Scroll of Magical Light"
#: data/mods/Magiclysm/Spells/classless.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid "Creates a magical light."
msgstr "Crea una luz mágica."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/classless.json
msgid "Blinding Flash"
msgstr "Flash Cegador"

#. ~ Description of spell "Blinding Flash"
#. ~ Classless spell
#. ~ Description of "Scroll of Blinding Flash"
#: data/mods/Magiclysm/Spells/classless.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid ""
"Blind enemies for a short time with a sudden, dazzling light.  Higher levels"
" deal slightly higher damage."
msgstr ""
"Ciega a los enemigos por un corto tiempo con una repentina y deslumbrante "
"luz. Los niveles más altos causan un daño ligeramente mayor."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/classless.json
msgid "Ethereal Grasp"
msgstr "Agarre Etéreo"

#. ~ Description of spell "Ethereal Grasp"
#. ~ Classless spell
#. ~ Description of "Scroll of Ethereal Grasp"
#: data/mods/Magiclysm/Spells/classless.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid ""
"A mass of spectral hands emerge from the ground, slowing everything in "
"range.  Higher levels allow a bigger AoE, and longer effect."
msgstr ""
"Una masa de manos espectrales emergen del suelo, frenando todo lo que está a"
" su alcance. Los niveles más altos permiten un mayor área de efecto, y un "
"efecto más prolongado."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/classless.json
msgid "Obfuscated Body"
msgstr "Cuerpo Ofuscado"

#. ~ Description of spell "Obfuscated Body"
#. ~ Description of spell "Improved Obfuscated Body"
#: data/mods/Magiclysm/Spells/classless.json
msgid ""
"A magical aura distorts light around your body, increasing the amount of "
"attacks you might dodge in a given turn."
msgstr ""
"Un aura mágica distorsiona la luz alrededor de tu cuerpo, aumentando la "
"cantidad de ataques que puedes esquivar en un turno determinado."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/classless.json
msgid "Improved Obfuscated Body"
msgstr ""

#. ~ Spell name
#: data/mods/Magiclysm/Spells/classless.json
msgid "Aura of Protection"
msgstr "Aura de Protección"

#. ~ Description of spell "Aura of Protection"
#. ~ Classless spell
#. ~ Description of "Scroll of Aura of Protection"
#: data/mods/Magiclysm/Spells/classless.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid ""
"Encases your whole body in a magical aura that protects you from the "
"environment."
msgstr "Envuelve todo tu cuerpo en un aura mágica que te protege del entorno."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/classless.json
msgid "Improved Aura of Protection"
msgstr ""

#. ~ Description of spell "Improved Aura of Protection"
#: data/mods/Magiclysm/Spells/classless.json
msgid ""
"Encases your whole body in a magical aura that protects you from the "
"environment.  Now you know this spell like the back of your hand, and start "
"to design your own version."
msgstr ""

#. ~ Spell name
#: data/mods/Magiclysm/Spells/classless.json
msgid "Translocate Self"
msgstr "Teletransportarse"

#. ~ Description of spell "Translocate Self"
#: data/mods/Magiclysm/Spells/classless.json
