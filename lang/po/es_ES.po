#: data/json/effects.json
msgid "You can't deal with this charge."
msgstr "No puedes hacer frente a esta carga."

#. ~ Name of effect type id "maimed_tail"
#: data/json/effects.json
msgid "Maimed Tail"
msgstr "Cola Mutilada"

#. ~ Description of effect type "Maimed Tail"
#: data/json/effects.json
msgid ""
"Your tail is broken.  You're not sure what to do with this information."
msgstr "Tu cola está rota. No estás seguro de qué hacer con esta información."

#. ~ Name of effect type id "maimed_claws"
#: data/json/effects.json
msgid "Maimed Claws"
msgstr "Garras Mutiladas"

#. ~ Description of effect type "Maimed Claws"
#: data/json/effects.json
msgid "Your claws broke.  Like a broken nail, but somehow worse."
msgstr ""
"Tus garras se rompieron. Como una uña rota, pero de alguna manera peor."

#. ~ Name of effect type id "maimed_armor"
#: data/json/effects.json
msgid "Cracked Shell"
msgstr "Cáscara agrietada"

