msgstr "Calibrar en 013TQ para las transferencias tripuladas"

#. ~ Snippet in category "lab_postit_portal"
#: data/json/snippets/lab.json
msgid "No touching returning probes, even if they beg you to"
msgstr "No tocar las sondas de retorno, aunque te lo rueguen"

#. ~ Snippet in category "lab_postit_portal"
#: data/json/snippets/lab.json
