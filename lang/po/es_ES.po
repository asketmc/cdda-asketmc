msgstr[2] "gambesones"

#. ~ Description of "gambeson"
#: data/json/items/armor/suits_protection.json
msgid ""
"A thick jacket of quilted fabric, designed to be worn underneath mail or "
"other armor.  Or worn on its own, if you can't afford proper armor.  Use it "
"to loosen it if you want to wear it over your clothes."
msgstr ""
"Una gruesa chaqueta de tela acolchada, diseñada para llevarla debajo de la "
"cota de malla u otra armadura. O para llevarla sola, si no puedes permitirte"
" una armadura adecuada. Utilízala para aflojarla si quieres llevarla por "
"encima de la ropa."

#. ~ Item name
#: data/json/items/armor/suits_protection.json
msgid "gambeson vest"
msgid_plural "gambeson vests"
msgstr[0] "chaleco de gambesón"
msgstr[1] "chalecos de gambesón"
msgstr[2] "chalecos de gambesón"

#. ~ Description of "gambeson vest"
#: data/json/items/armor/suits_protection.json
msgid ""
"A thick vest of quilted fabric, designed to be worn underneath mail or other"
" armor.  This one has had its sleeves removed.  Use it to loosen it if you "
"want to wear it over your clothes."
msgstr ""
"Una gruesa chaqueta de tela acolchada, diseñada para llevarla debajo de la "
"cota de malla u otra armadura. Ésta tiene las mangas quitadas. Utilízala "
"para aflojarla si quieres llevarla por encima de la ropa."

#. ~ Item name
#: data/json/items/armor/suits_protection.json
msgid "gambeson (loose)"
msgid_plural "gambesons (loose)"
msgstr[0] "gambeson (suelto)"
