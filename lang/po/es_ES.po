msgid "band saw"
msgid_plural "band saws"
msgstr[0] "sierra de cinta"
msgstr[1] "sierras de cinta"
msgstr[2] "sierras de cinta"

#. ~ Vehicle part name
#. ~ Based off Powermatic TS29 Shaper.  TODO: When support for multi-tile
#. appliances is added, this can stretch two tiles
#. ~ Item name
#: data/json/furniture_and_terrain/appliances.json
