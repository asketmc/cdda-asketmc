msgstr[1] "celulas alienígenas"
msgstr[2] "celulas alienígenas"

#. ~ Description of magazine "alien cell"
#: data/mods/Aftershock/items/magazine/alien.json
msgid ""
"A conical device salvaged from an alien artifact.  Grooves etched on its "
"circular face slowly pulse with purple light."
msgstr ""
"Un dispositivo cónico rescatado de un artefacto alienígena. Los surcos "
"grabados en su cara circular pulsan lentamente con luz púrpura."

#. ~ Magazine name
#: data/mods/Aftershock/items/magazine/energy_cell.json
msgid "power cartridge"
msgid_plural "power cartridges"
msgstr[0] "cartucho de energia"
msgstr[1] "cartuchos de energia"
msgstr[2] "cartuchos de energia"

#. ~ Description of magazine "power cartridge"
#: data/mods/Aftershock/items/magazine/energy_cell.json
msgid ""
"A standard-design power cell compatible with most common energy weapons.  "
"Can be recharged by connecting to a power source."
msgstr ""
"Una célula de energía de diseño estándar compatible con las armas de energía"
" más comunes. Se puede recargar conectándola a una fuente de energía."

#. ~ Magazine name
#: data/mods/Aftershock/items/magazine/energy_cell.json
msgid "compact power cartridge"
msgid_plural "compact power cartridges"
msgstr[0] "cartucho de energia compacto"
msgstr[1] "cartuchos de energia compacto"
msgstr[2] "cartuchos de energia compacto"

#. ~ Description of magazine "compact power cartridge"
#: data/mods/Aftershock/items/magazine/energy_cell.json
msgid ""
"A compact power cell compatible with most common energy weapons.  Can be "
"recharged by connecting to a power source."
msgstr ""
"Una célula de energía compacta compatible con las armas de energía más "
"comunes. Se puede recargar conectándola a una fuente de energía."

#. ~ Magazine name
#: data/mods/Aftershock/items/magazine/energy_cell.json
msgid "bootleg power cartridge"
msgid_plural "bootleg power cartridges"
msgstr[0] "réplica de cartucho de energia"
msgstr[1] "réplicas de cartuchos de energia"
msgstr[2] "réplicas de cartuchos de energia"

#. ~ Description of magazine "bootleg power cartridge"
#: data/mods/Aftershock/items/magazine/energy_cell.json
msgid ""
"A functional but poorly-built power cell compatible with most common energy "
"weapons.  It cannot be recharged."
msgstr ""
"Una célula de energía funcional pero mal construida, compatible con las "
"armas de energía más comunes. No se puede recargar."

#. ~ Magazine name
#: data/mods/Aftershock/items/magazine/energy_cell.json
msgid "chromoelectric cartridge"
msgid_plural "chromoelectric cartridges"
msgstr[0] "cartucho cromoeléctrico"
msgstr[1] "cartuchos cromoeléctricos"
msgstr[2] "cartuchos cromoeléctricos"

#. ~ Description of magazine "chromoelectric cartridge"
#: data/mods/Aftershock/items/magazine/energy_cell.json
msgid ""
"A thin strip of transuranic metal, glowing a somber blue from within its "
"shielded glass prison.  A rare and sought-after relic, it could be used to "
"momentarily power all sorts of technology from the late Hyperspace Era."
msgstr ""
"Una fina tira de metal transuránico, brillando con un apagado azul desde su "
"prisión de vidrio protector. Una reliquia rara y buscada, puede ser usada "
"para alimentar momentáneamente toda clase de tecnología de finales de la Era"
" Hiperespacial."

#. ~ Magazine name
#: data/mods/Aftershock/items/magazine/foam.json
msgid "pressurized foam tank"
msgid_plural "pressurized foam tanks"
msgstr[0] "tanque de espuma presurizada"
msgstr[1] "tanques de espuma presurizada"
msgstr[2] "tanques de espuma presurizada"

#. ~ Description of magazine "pressurized foam tank"
#: data/mods/Aftershock/items/magazine/foam.json
msgid "A pressurized 5L canister designed to feed an industrial foam gun."
msgstr ""
"Un bidón presurizado de 5L diseñado para alimentar una pistola de espuma "
"industrial."

#. ~ Magazine name
#: data/mods/Aftershock/items/magazine/plasma.json
msgid "4g plasma cell"
msgid_plural "4g plasma cells"
msgstr[0] "célula de plasma 4g"
msgstr[1] "células de plasma 4g"
msgstr[2] "células de plasma 4g"

#. ~ Description of magazine "4g plasma cell"
#: data/mods/Aftershock/items/magazine/plasma.json
msgid ""
"A tiny canister that can safely store up to 4 grams of solid hydrogen in a "
"cryo-pressurized state."
msgstr ""
"Un minúsculo bote que puede almacenar de forma segura hasta 4 gramos de "
"hidrógeno sólido en estado de criopresión."

#. ~ Magazine name
#: data/mods/Aftershock/items/magazine/plasma.json
msgid "40g plasma cell (civilian)"
msgid_plural "40g plasma cells (civilian)"
msgstr[0] "celda de plasma 40g (civil)"
msgstr[1] "celdas de plasma 40g (civil)"
msgstr[2] "celdas de plasma 40g (civil)"

#. ~ Description of magazine "40g plasma cell (civilian)"
#: data/mods/Aftershock/items/magazine/plasma.json
msgid ""
"A yellow and red canister that can safely store up to 40 grams of solid "
"hydrogen in a cryo-pressurized state.  A complex nozzle with integrated "
"digital failsafes make it incompatible with military railguns."
msgstr ""

#. ~ Magazine name
#: data/mods/Aftershock/items/magazine/voltaic.json
msgid "voltaic cell"
msgid_plural "voltaic cells"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of magazine "voltaic cell"
