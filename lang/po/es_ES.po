#. ~ Snippet in category "pyromania_withdrawal"
#: data/json/snippets/snippets.json
msgid "You feel cold.  You need the warmth of a fire."
msgstr "Sientes frío. Necesitas el calor de un fuego."

#. ~ Snippet in category "pyromania_withdrawal"
#: data/json/snippets/snippets.json
msgid "Maybe a fire could calm your nerves?"
msgstr "¿Tal vez un fuego pueda calmar tus nervios?"

#. ~ Snippet in category "pyromania_withdrawal"
#: data/json/snippets/snippets.json
msgid "You need to ignite something."
msgstr "Necesitas encender algo."

#. ~ Snippet in category "pyromania_withdrawal"
#: data/json/snippets/snippets.json
msgid "You daydream of crackling fire…"
msgstr "Necesitas encender algo."

#. ~ Snippet in category "pyromania_withdrawal"
#: data/json/snippets/snippets.json
msgid "You shiver.  A fire would be great right now."
msgstr "Tiemblas. Un fuego sería genial ahora mismo."

#. ~ Snippet in category "pyromania_withdrawal"
#: data/json/snippets/snippets.json
msgid "You think about how nice fires are."
msgstr "Piensa en lo bonitos que son los incendios."

#. ~ Snippet in category "pyromania_withdrawal"
#: data/json/snippets/snippets.json
msgid "You think of randomly lighting a fire, but decide against it."
msgstr "Piensas en encender un fuego al azar, pero decides no hacerlo."

#. ~ Snippet in category "killer_withdrawal"
#: data/json/snippets/snippets.json
msgid "You think of steel blades and warm, dripping blood."
msgstr "Piensas en cuchillas de acero y calor, goteando sangre."

#. ~ Snippet in category "killer_withdrawal"
#: data/json/snippets/snippets.json
msgid "You'd like to hear the last breath of something living."
msgstr "Te gustaría escuchar el último aliento de algo vivo."

#. ~ Snippet in category "killer_withdrawal"
#: data/json/snippets/snippets.json
msgid "So much death around.  Why not add some more?"
msgstr "Tanta muerte alrededor. ¿Por qué no añadir un poco más?"

#. ~ Snippet in category "killer_withdrawal"
#: data/json/snippets/snippets.json
msgid "You lick your lips, in anticipation for dead trophies."
msgstr "Te lames los labios, en anticipación a los trofeos muertos."

#. ~ Snippet in category "killer_withdrawal"
#: data/json/snippets/snippets.json
msgid "By the blade or by the gun?  How will you kill this time?"
msgstr "¿Por la hoja o por el arma? ¿Cómo matarás esta vez?"

#. ~ Snippet in category "killer_withdrawal"
#: data/json/snippets/snippets.json
msgid "Ahh, how delightful it would be to kill something."
msgstr "Ahh, que encantador sería matar algo."

#. ~ Snippet in category "killer_withdrawal"
#: data/json/snippets/snippets.json
msgid "You are death, and you are coming for them.  Soon."
msgstr "Eres la muerte, y vienes por ellos. Pronto."

#. ~ Snippet in category "killer_withdrawal"
#: data/json/snippets/snippets.json
msgid "You feel restless.  It's been too long since your last kill."
msgstr ""
"Te sientes inquieto. Ha pasado demasiado tiempo desde tu última muerte."

#. ~ Snippet in category "killer_withdrawal"
#: data/json/snippets/snippets.json
msgid "Killing something would be nice right now."
msgstr "Matar algo estaría bien ahora mismo."

#. ~ Snippet in category "killer_withdrawal"
#: data/json/snippets/snippets.json
msgid "Just one more death, one more kill and then you'd be right."
msgstr "Sólo una muerte más, una muerte más y entonces tendrás razón."

#. ~ Snippet in category "killer_on_kill"
#: data/json/snippets/snippets.json
msgid "You feel the rush of the kill."
msgstr "Sientes el impulso de matar."

#. ~ Snippet in category "killer_on_kill"
#: data/json/snippets/snippets.json
msgid "Your urge to kill is sated, for now."
msgstr "Tu impulso de matar está saciado, por ahora."

#. ~ Snippet in category "killer_on_kill"
#: data/json/snippets/snippets.json
msgid "You have the power of life and death; it feels good to be in control."
msgstr ""
"Tienes el poder de la vida y la muerte; se siente bien tener el control."

#. ~ Snippet in category "killer_on_kill"
#: data/json/snippets/snippets.json
msgid "You exhale in bliss."
msgstr "Exhalas con felicidad."

#. ~ Snippet in category "killer_on_kill"
#: data/json/snippets/snippets.json
msgid "A calm feeling washes over."
msgstr "Una sensación de calma se impone."

#. ~ Snippet in category "killer_on_kill"
#: data/json/snippets/snippets.json
msgid "This feels right."
msgstr "Esto se siente bien."

#. ~ Snippet in category "killer_on_kill"
#: data/json/snippets/snippets.json
msgid "You kill, and your world is in order again."
msgstr "Matas y tu mundo vuelve a estar en orden."

#. ~ Snippet in category "killer_on_kill"
#: data/json/snippets/snippets.json
msgid "Your worries evaporate as the creature dies by your hand."
msgstr "Tus preocupaciones se evaporan cuando la criatura muere por tu mano."

#. ~ Snippet in category "killer_on_kill"
#: data/json/snippets/snippets.json
msgid "That was nice!  Maybe one more?"
msgstr "¡Eso estuvo bien! ¿Tal vez uno más?"

#. ~ Snippet in category "killer_on_kill"
#: data/json/snippets/snippets.json
msgid "This feels so good!  You could do this all day."
msgstr "¡Esto se siente tan bien! Podrías hacer esto todo el día."

#. ~ Snippet in category "killer_on_kill"
#: data/json/snippets/snippets.json
msgid "This brings a smile to your face."
msgstr "Esto te provoca una sonrisa en la cara."

#. ~ Snippet in category "killer_on_kill"
#: data/json/snippets/snippets.json
msgid "You feel tension leave your body as your need to kill is satisfied."
msgstr ""
"Sientes que la tensión abandona tu cuerpo al satisfacer tu necesidad de "
"matar."

#. ~ Snippet in category "killer_on_kill"
#: data/json/snippets/snippets.json
msgid "You feel much better now."
msgstr "Te sientes mucho mejor ahora."

