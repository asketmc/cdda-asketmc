"estando sumergida en el agua."

#. ~ Gun mod name
#: data/json/items/gunmod/mechanism.json
msgid "M249 semi-auto trigger"
msgid_plural "M249 semi-auto triggers"
msgstr[0] "gatillo semiautomático M249"
msgstr[1] "gatillos semiautomáticos M249"
msgstr[2] "gatillos semiautomáticos M249"

