msgstr[2] "lavadoras"

#. ~ Description of vehicle part "washing machine"
#: data/json/furniture_and_terrain/appliances.json
msgid ""
"An appliance used to do laundry, plugged into a power supply and using "
"internal tanks."
msgstr ""
"Aparato utilizado para lavar la ropa, enchufado a una fuente de alimentación"
" y que utiliza tanques internos."

#. ~ Vehicle part name
#. ~ Furniture name
#: data/json/furniture_and_terrain/appliances.json
