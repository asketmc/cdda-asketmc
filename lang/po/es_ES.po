#: data/json/items/comestibles/carnivore.json
msgid "tainted bone"
msgid_plural "tainted bones"
msgstr[0] "hueso infectado"
msgstr[1] "huesos infectados"
msgstr[2] "huesos infectados"

#. ~ Not for use in edible recipes, and should require ~200% as much as normal
#. for applicable inedible recipes except for charcoal.
#. ~ Description of "tainted bone"
#: data/json/items/comestibles/carnivore.json
msgid ""
"A rotten, brittle bone from some unnatural creature or other.  Could be used"
" to make some stuff, like charcoal or glue.  You could eat it, but it will "
"poison you."
msgstr ""
"Un hueso podrido y quebradizo de alguna criatura innatural. Podría usarse "
"para hacer algunas cosas, como carbón o pegamento. Puedes comerlo, pero te "
"intoxicará."

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "tainted bone marrow"
msgid_plural "tainted bone marrow"
msgstr[0] "médula ósea contaminada"
msgstr[1] "médula ósea contaminada"
msgstr[2] "médula ósea contaminada"

#. ~ Description of "tainted bone marrow"
#: data/json/items/comestibles/carnivore.json
msgid ""
"A wet, green chunk of spongy goop extracted from a rotten bone.  You could "
"eat it, but it will poison you."
msgstr ""
"Un trozo verde y húmedo de una sustancia esponjosa extraída de un hueso "
"podrido. Puedes comerlo, pero te intoxicará."

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "human bone"
msgid_plural "human bones"
msgstr[0] "hueso humano"
msgstr[1] "huesos humanos"
msgstr[2] "huesos humanos"

#. ~ Description of "human bone"
#: data/json/items/comestibles/carnivore.json
msgid ""
"A bone from a human being.  Could be used to make some stuff, if you're "
"feeling sufficiently ghoulish."
msgstr ""
"Es un hueso de un ser humano. Puede ser usado para hacer cosas, si te "
"sientes lo suficientemente morboso."

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "demihuman bone"
msgid_plural "demihuman bones"
msgstr[0] "hueso demihumano"
msgstr[1] "huesos demihumanos"
msgstr[2] "huesos demihumanos"

#. ~ Description of "demihuman bone"
#: data/json/items/comestibles/carnivore.json
msgid ""
"A bone from a demihuman being.  Could be used to make some stuff, if you're "
"feeling sufficiently ghoulish."
msgstr ""
"Un hueso de un ser demihumano. Puede ser usado para hacer algunas cosas, si "
"te sientes lo suficientemente macabro."

#. ~ Not for use in edible recipes, and should require ~200% as much as normal
#. for applicable inedible recipes.
#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "tainted fat"
msgid_plural "tainted fats"
msgstr[0] "grasa infectada"
msgstr[1] "grasas infectadas"
msgstr[2] "grasas infectadas"

#. ~ Not for use in edible recipes, and should require ~200% as much as normal
#. for applicable inedible recipes.
#. ~ Description of "tainted fat"
#: data/json/items/comestibles/carnivore.json
msgid ""
"A watery yellow glob of fat from some unnatural creature or other.  You "
"could eat it, but it will poison you."
msgstr ""
"Un glóbulo de grasa acuosa, amarillenta, de alguna criatura no natural o de "
"otra cosa. Te la puedes comer, pero te va a envenenaría."

#. ~ Not for use in edible/foodsafe recipes.  Inefficiency is handled by
#. tainted tallow recipe requiring 200% as much materials input as regular
#. tallow recipe.
#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "tainted tallow"
msgid_plural "tainted tallows"
msgstr[0] "sebo infectado"
msgstr[1] "sebos infectados"
msgstr[2] "sebos infectados"

#. ~ Not for use in edible/foodsafe recipes.  Inefficiency is handled by
#. tainted tallow recipe requiring 200% as much materials input as regular
#. tallow recipe.
#. ~ Description of "tainted tallow"
#: data/json/items/comestibles/carnivore.json
msgid ""
"A smooth grayish block of cleaned and rendered monster fat.  It will remain "
"'fresh' for a very long time, and can be used as an ingredient in many "
"projects.  You could eat it, but it will poison you."
msgstr ""
"Un bloque liso y grisáceo de grasa de monstruo limpiada y procesada. Se "
"mantendrá \"fresco\" durante mucho tiempo, y puede utilizarse como "
"ingrediente en muchos proyectos. Puedes comerlo, pero te envenenaría."

#. ~ Item name
