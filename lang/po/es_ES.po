#. ~ Profession name for male
#: data/json/professions.json
msgctxt "profession_male"
msgid "Urban Explorer"
msgstr "Explorador Urbano"

#. ~ Description of profession "Urban Explorer" for male
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You've always admired the beauty of urban desolation, and were ready for "
"your next trip into town when the end of the world made your hobby much more"
" relevant."
msgstr ""
"Siempre admiraste la belleza de la desolación urbana, y estabas preparado "
"para tu próximo viaje a la ciudad cuando el fin del mundo hizo que tu "
"afición fuera mucho más relevante."

#. ~ Profession name for female
#: data/json/professions.json
