msgstr "Tono de piel: rosado"

#. ~ Description of mutation "Skin tone: rose"
#: data/json/mutations/mutation_appearance.json
msgid "You have a rosy pink skin tone."
msgstr "Tienes un tono de piel rosado."

#. ~ Mutation name
#: data/json/mutations/mutation_appearance.json
msgid "Skin tone: bronze"
msgstr "Tono de piel: bronce"

#. ~ Description of mutation "Skin tone: bronze"
#: data/json/mutations/mutation_appearance.json
msgid "You have a bronze or tan skin tone."
msgstr "Tienes un tono de piel bronceado o moreno."

#. ~ Mutation name
#: data/json/mutations/mutation_appearance.json
msgid "Facial hair: none"
msgstr "Bello facial: ninguno"

#. ~ Description of mutation "Facial hair: none"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have no hair on your face, it is shaven or simply untouched by the "
"presence of hair."
msgstr ""
"No tienes pelo en la cara, por estar afeitado o por nunca haberte crecido."

#. ~ Mutation name
#: data/json/mutations/mutation_appearance.json
msgid "Facial hair: goatee"
msgstr "Vello facial: perilla"

#. ~ Description of mutation "Facial hair: goatee"
#: data/json/mutations/mutation_appearance.json
msgid "You have a short beard at the tip of your chin."
msgstr "Tienes una barba corta en la punta de tu barbilla."

#. ~ Mutation name
#: data/json/mutations/mutation_appearance.json
msgid "Facial hair: circle beard"
msgstr "Vello facial: barba circular"

#. ~ Description of mutation "Facial hair: circle beard"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have a moustache and a short beard, that both form a circle around your "
"lips."
msgstr ""
"Tienes un bigote y una barba corta, que forman un círculo alrededor de tus "
"labios."

#. ~ Mutation name
#: data/json/mutations/mutation_appearance.json
msgid "Facial hair: royale beard"
msgstr "Vello facial: barba regia"

#. ~ Description of mutation "Facial hair: royale beard"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have a moustache and a short beard forming a patch under your lips."
msgstr ""
"Tienes un bigote y una barba corta que forma un parche bajo tus labios."

#. ~ Mutation name
#: data/json/mutations/mutation_appearance.json
msgid "Facial hair: anchor beard"
msgstr "Vello facial: barba ancla"

#. ~ Description of mutation "Facial hair: anchor beard"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have a moustache and a beard starting with a strip going down from the "
"bottom lip, then tracing the jaw lines.  It looks a bit like an anchor, thus"
" the name."
msgstr ""
"Tienes un bigote y una barba que empieza con una tira que baja desde el "
"labio inferior, y luego traza las líneas de la mandíbula. Se parece un poco "
"a un ancla, de ahí el nombre."

#. ~ Mutation name
#: data/json/mutations/mutation_appearance.json
msgid "Facial hair: short boxed beard"
msgstr "Vello facial: barba caja corta"

#. ~ Description of mutation "Facial hair: short boxed beard"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have a moustache and a short beard with trimmed sides.  Thin patches "
"connect them both, forming a 'box' around the lips, thus the name."
msgstr ""
"Tienes un bigote y una barba corta con los lados recortados. Unos bordes "
"finos los conectan, formando unos espacios vacios bajo los labios, de ahí el"
" nombre."

#. ~ Mutation name
#: data/json/mutations/mutation_appearance.json
msgid "Facial hair: chevron moustache"
msgstr "Vello facial: bigote chevrón"

#. ~ Description of mutation "Facial hair: chevron moustache"
#: data/json/mutations/mutation_appearance.json
msgid "You have a moustache that covers your entire top lip."
msgstr "Tienes un bigote que cubre todo tu labio superior."

#. ~ Mutation name
#: data/json/mutations/mutation_appearance.json
msgid "Facial hair: 3-day stubble"
msgstr "Vello facial: barba de 3 dias"

#. ~ Description of mutation "Facial hair: 3-day stubble"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have a short trimmed moustache and beard imitating a 3-day stubble."
msgstr "Tienes un bigote recortado y una barba que imita a la de 3 días."

#. ~ Mutation name
#: data/json/mutations/mutation_appearance.json
msgid "Facial hair: horseshoe"
msgstr "Vello facial: herradura"

#. ~ Description of mutation "Facial hair: horseshoe"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have a moustache with patches going down the chin from both ends, thus "
"the name."
msgstr ""
"Tienes un bigote con bordes que bajan a la barbilla por los extremos, de ahí"
" el nombre."

#. ~ Mutation name
#: data/json/mutations/mutation_appearance.json
msgid "Facial hair: original moustache"
msgstr "Vello facial: bigote original"

#. ~ Description of mutation "Facial hair: original moustache"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have a moustache with shortened ends, that covers only the skin above "
"your upper lip."
msgstr ""
"Tienes un bigote con los extremos cortados, que sólo cubren la piel por "
"encima del labio superior."

#. ~ Mutation name
#: data/json/mutations/mutation_appearance.json
msgid "Facial hair: mutton chops beard"
msgstr "Vello facial: barba mutton chops"

#. ~ Description of mutation "Facial hair: mutton chops beard"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have long sideburns that connect to your moustache, with the tip of the "
"chin shaven clean."
msgstr ""
"Tienes largas patillas que conectan con tu bigote, con la punta de la "
"barbilla afeitada."

#. ~ Mutation name
#: data/json/mutations/mutation_appearance.json
msgid "Facial hair: gunslinger beard"
msgstr "Vello facial: barba de pistolero"

#. ~ Description of mutation "Facial hair: gunslinger beard"
#: data/json/mutations/mutation_appearance.json
msgid "You have a horseshoe moustache and disconnected sideburns."
msgstr "Tienes un bigote de herradura y patillas desconectadas."

#. ~ Mutation name
#: data/json/mutations/mutation_appearance.json
msgid "Facial hair: chin strip"
msgstr "Vello facial: tira de barbilla"

#. ~ Description of mutation "Facial hair: chin strip"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have a short beard in a form of a vertical patch under your bottom lip."
msgstr ""
"Tienes una barba corta en forma de parche vertical bajo el labio inferior."

#. ~ Mutation name
#: data/json/mutations/mutation_appearance.json
msgid "Facial hair: chin curtain"
msgstr "Vello facial: cortina barbilla"

#. ~ Description of mutation "Facial hair: chin curtain"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have a full beard without a moustache, restricted to the chin, sometimes"
" called a 'lion's mane'. Much like Abraham Lincoln's beard."
msgstr ""
"Tienes una barba completa sin bigote, limitada a la barbilla, a veces "
"llamada \"melena de león\". Como la barba de Abraham Lincoln."

#. ~ Mutation name
#: data/json/mutations/mutation_appearance.json
msgid "Facial hair: chin strap"
msgstr "Vello facial: correa de barbilla"

#. ~ Description of mutation "Facial hair: chin strap"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have a beard along the jaw lines, circling the chin, and no moustache."
msgstr ""
"Tienes barba por la línea de la mandíbula, alrededor de la perilla y sin "
"mostacho."

#. ~ Mutation name
#: data/json/mutations/mutation_appearance.json
msgid "Facial hair: beard"
msgstr "Vello facial: barba"

#. ~ Description of mutation "Facial hair: beard"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have a moustache and a long beard, both formed by allowing free growth "
"of hair, with no particular styling."
msgstr ""
"Tienes un bigote y una larga barba, ambos formados por permitir el libre "
"crecimiento del cabello, sin un estilo particular."

#. ~ Mutation name
#: data/json/mutations/mutation_appearance.json
msgid "Facial hair: handlebar moustache"
msgstr "Vello facial: bigote de manillar"

#. ~ Description of mutation "Facial hair: handlebar moustache"
#: data/json/mutations/mutation_appearance.json
msgid "You have a moustache with long flared out ends."
msgstr "Tienes un bigote con extremos largos y acampanados."

#. ~ Mutation name
#: data/json/mutations/mutation_appearance.json
msgid "Facial hair: neckbeard"
msgstr "Vello facial: barba de cuello"

#. ~ Description of mutation "Facial hair: neckbeard"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have a beard formed from hair grown on neck below the chin line.  No "
"moustache included."
msgstr ""
"Tienes una barba formada por el pelo que crece en el cuello por debajo de la"
" línea de la barbilla. Sin bigote incluido."

#. ~ Mutation name
#: data/json/mutations/mutation_appearance.json
msgid "Facial hair: pencil moustache"
msgstr "Vello facial: bigote de lápiz"

#. ~ Description of mutation "Facial hair: pencil moustache"
#: data/json/mutations/mutation_appearance.json
msgid "You have a very thin moustache just above the line of the upper lip."
msgstr ""
"Tienes un bigote muy fino justo encima de la línea del labio superior."

#. ~ Mutation name
#: data/json/mutations/mutation_appearance.json
msgid "Facial hair: shenandoah"
msgstr "Vello facial: shenandoah"

#. ~ Description of mutation "Facial hair: shenandoah"
#: data/json/mutations/mutation_appearance.json
msgid ""
"Long full beard with no moustache, popular among Amish community, often with"
" two pointed ends."
msgstr ""
"Barba larga y completa sin bigote, popular entre la comunidad Amish, a "
"menudo con dos extremos puntiagudos."

#. ~ Mutation name
#: data/json/mutations/mutation_appearance.json
msgid "Facial hair: sideburns"
msgstr "Vello facial: patillas"

#. ~ Description of mutation "Facial hair: sideburns"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have patches of hair in front of your ears, that normally would connect "
"your hair with the beard, but they are here by themselves."
msgstr ""
"Tienes parches de pelo delante de las orejas, que normalmente conectarían tu"
" pelo con la barba, pero están aquí por sí mismos."

#. ~ Mutation name
#: data/json/mutations/mutation_appearance.json
msgid "Facial hair: soul patch"
msgstr "Vello facial: parche del alma"

#. ~ Description of mutation "Facial hair: soul patch"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have a little bit of hair in the dip under your lower lip, and no other "
"facial hair whatsoever."
msgstr ""
"Tienes un poco de pelo en la depresión bajo el labio inferior, y ningún otro"
" pelo facial en absoluto."

#. ~ Mutation name
#: data/json/mutations/mutation_appearance.json
msgid "Facial hair: toothbrush moustache"
msgstr "Vello facial: bigote cepillo"

#. ~ Description of mutation "Facial hair: toothbrush moustache"
#: data/json/mutations/mutation_appearance.json
msgid ""
"Charlie Chaplin used to have this short patch of hair just under the nose, "
"but then that other guy used it as a characteristic, and it became "
"unwelcomed."
msgstr ""
"Charlie Chaplin solía tener este corto parche de pelo justo debajo de la "
"nariz, pero luego ese otro tipo lo usó como una característica, y se volvió "
"inoportuno."

#. ~ Mutation name
#: data/json/mutations/mutation_appearance.json
msgid "Facial hair: Van Dyke"
msgstr "Vello facial: Van Dyke"

#. ~ Description of mutation "Facial hair: Van Dyke"
#: data/json/mutations/mutation_appearance.json
msgid "You have a handlebar moustache with a chin strip or a small goatee."
msgstr ""
"Tienes bigote manubrio con una línea en el mentón o un pequeño candado."

#. ~ Mutation name
#: data/json/mutations/mutation_appearance.json
msgid "Facial hair: walrus"
msgstr "Vello facial: morsa"

#. ~ Description of mutation "Facial hair: walrus"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have a long thick moustache, overshadowing your lips, that somewhat "
"resembles the facial hair of a walrus."
msgstr ""
"Tienes bigote largo y grueso, que sobrepasa los labios y que de alguna "
"manera parece el pelo facial de una morsa."

#. ~ Mutation name
#: data/json/mutations/mutation_appearance.json
msgid "Facial hair: The Zappa"
msgstr "Vello facial: El Zappa"

#. ~ Description of mutation "Facial hair: The Zappa"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have a wide soul patch and a full moustache that extends a bit downwards"
" at the corners of your lips."
msgstr ""
"Tienes una amplia soul patch y un bigote completo que se extiende un poco "
"hacia abajo en la comisura de los labios."

#. ~ Mutation class name
#: data/json/mutations/mutation_category.json
msgid "Any"
msgstr "Cualquiera"

#. ~ "mutagen_message" of mutation class "Any"
#: data/json/mutations/mutation_category.json
msgid "You feel strange."
msgstr "Te sientes extraño."

#. ~ Mutation class name
#: data/json/mutations/mutation_category.json
msgid "Human"
msgstr "Humano"

#. ~ "mutagen_message" of mutation class "Human"
#: data/json/mutations/mutation_category.json
msgid "You feel the aberrance fade."
msgstr "Sientes que la anormalidad se desvanece."

#. ~ Mutation class name
#. ~ Mutation name
#: data/json/mutations/mutation_category.json
#: data/json/mutations/mutations.json
msgid "Plant"
msgstr "Planta"

#. ~ "mutagen_message" of mutation class "Plant"
#: data/json/mutations/mutation_category.json
msgid "You feel much closer to nature.  Your breath and thoughts slow."
msgstr ""
"Te sientes mucho más cerca de la naturaleza. Tu respiración y tus "
"pensamientos se hacen más lentos."

#. ~ Memorial message of mutation class "Plant" for male
#: data/json/mutations/mutation_category.json
msgctxt "memorial_male"
msgid "Bloomed forth."
msgstr "Florecido."

#. ~ Memorial message of mutation class "Plant" for female
#: data/json/mutations/mutation_category.json
msgctxt "memorial_female"
msgid "Bloomed forth."
msgstr "Florecido."

#. ~ Mutation class name
#. ~ Mutation name
#: data/json/mutations/mutation_category.json
#: data/json/mutations/mutations.json
msgid "Insect"
msgstr "Insecto"

#. ~ "mutagen_message" of mutation class "Insect"
#: data/json/mutations/mutation_category.json
msgid "You hear buzzing, and feel your body harden."
msgstr "Escuchas un zumbido, y sientes que tu cuerpo se endurece."

#. ~ Memorial message of mutation class "Insect" for male
#: data/json/mutations/mutation_category.json
msgctxt "memorial_male"
msgid "Metamorphosed."
msgstr "Metamorfoseado."

#. ~ Memorial message of mutation class "Insect" for female
#: data/json/mutations/mutation_category.json
msgctxt "memorial_female"
msgid "Metamorphosed."
msgstr "Metamorfoseado."

#. ~ Mutation class name
#: data/json/mutations/mutation_category.json
msgid "Spider"
msgstr "Araña"

#. ~ "mutagen_message" of mutation class "Spider"
#: data/json/mutations/mutation_category.json
msgid "You feel insidious, and your vision fragments for a moment."
msgstr "Te sientes insidioso y tu visión se fragmenta por un instante."

#. ~ Memorial message of mutation class "Spider" for male
#: data/json/mutations/mutation_category.json
msgctxt "memorial_male"
msgid "Found a place in the web of life."
msgstr "Encontró su lugar en la tela de la vida."

#. ~ Memorial message of mutation class "Spider" for female
#: data/json/mutations/mutation_category.json
msgctxt "memorial_female"
msgid "Found a place in the web of life."
msgstr "Encontró un lugar en la tela de la vida."

#. ~ "mutagen_message" of mutation class "Slime"
#: data/json/mutations/mutation_category.json
msgid "Your body loses all rigidity for a moment."
msgstr "Tu cuerpo pierde toda su rigidez por un momento."

#. ~ Memorial message of mutation class "Slime" for male
#: data/json/mutations/mutation_category.json
msgctxt "memorial_male"
msgid "Gave up on rigid human norms."
msgstr "Dejaste las rígidas normas humanas."

#. ~ Memorial message of mutation class "Slime" for female
#: data/json/mutations/mutation_category.json
msgctxt "memorial_female"
msgid "Gave up on rigid human norms."
msgstr "Dejaste las rígidas normas humanas."

#. ~ Mutation class name
#: data/json/mutations/mutation_category.json
msgid "Fish"
msgstr "Pez"

#. ~ "mutagen_message" of mutation class "Fish"
#: data/json/mutations/mutation_category.json
msgid "You are overcome by an overwhelming longing for the ocean."
msgstr "Te sientes agobiado por un incontenible anhelo por ir al océano."

#. ~ Memorial message of mutation class "Fish" for male
#: data/json/mutations/mutation_category.json
msgctxt "memorial_male"
msgid "Went deep."
msgstr "Fuiste a lo profundo."

#. ~ Memorial message of mutation class "Fish" for female
#: data/json/mutations/mutation_category.json
msgctxt "memorial_female"
msgid "Went deep."
msgstr "Fuiste a lo profundo."

#. ~ Mutation class name
#. ~ Mutation name
#: data/json/mutations/mutation_category.json
#: data/json/mutations/mutations.json
