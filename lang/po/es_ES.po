#. ~ Name of effect type id "vampire_virus_ascendant"
#: data/mods/Xedra_Evolved/effects/effects.json
msgid "Terminal Porphyria"
msgstr "Porfiria Terminal"

#. ~ Description of effect type "Terminal Porphyria"
#: data/mods/Xedra_Evolved/effects/effects.json
msgid ""
"Your skin is deathly white and will redden and burn when exposed to the sun."
msgstr ""
"Tu piel es mortalmente blanca y se enrojece y se quema cuando se expone al "
"sol."

#. ~ Apply message of effect type "Terminal Porphyria"
#: data/mods/Xedra_Evolved/effects/effects.json
msgid "You've chosen to embrace this illness and enhance your curse."
msgstr ""
"Tu piel es mortalmente blanca y se enrojece y se quema cuando se expone al "
"sol."

#. ~ Male memorial apply log of effect type "Terminal Porphyria"
#: data/mods/Xedra_Evolved/effects/effects.json
msgctxt "memorial_male"
msgid "Willingly left their humanity behind."
msgstr "Dejaron voluntariamente su humanidad."

#. ~ Female memorial apply log of effect type "Terminal Porphyria"
#: data/mods/Xedra_Evolved/effects/effects.json
msgctxt "memorial_female"
msgid "Willingly left their humanity behind."
msgstr "Dejaron voluntariamente su humanidad."

#. ~ Name of effect type id "vampire_virus_post_mortal"
#: data/mods/Xedra_Evolved/effects/effects.json
msgid "Homo sapiens homovorus"
msgstr "Homo sapiens homovorus"

#. ~ Description of effect type "Homo sapiens homovorus"
#: data/mods/Xedra_Evolved/effects/effects.json
msgid ""
"Your skin is deathly white, your eyes are solid red except for a huge pupil,"
" the only food you can consume is human blood, and if sunlight hits you that"
" part of your body instantly burns."
msgstr ""
"Tu piel está mortalmente blanca, tus ojos son de color rojo excepto por la "
"enorme pupila, el único alimento que puedes consumir es la sangre humana, y "
"si la luz del sol te da, esa parte de tu cuerpo se quema instantáneamente."

#. ~ Apply message of effect type "Homo sapiens homovorus"
#: data/mods/Xedra_Evolved/effects/effects.json
msgid ""
"Becoming a monster is a matter of degrees until one day it isn't and you can"
" no longer remember why morality seemed important."
msgstr ""
"Ser un monstruo es una cuestión de matices hasta que un día deja de serlo y "
"ya no recuerdas por qué la moral parecía importante."

#. ~ Male memorial apply log of effect type "Homo sapiens homovorus"
#: data/mods/Xedra_Evolved/effects/effects.json
msgctxt "memorial_male"
msgid "Terrorized the remnants of humanity til there were none left."
msgstr "Aterrorizó a los restos de la humanidad hasta que no quedó ninguno."

#. ~ Female memorial apply log of effect type "Homo sapiens homovorus"
#: data/mods/Xedra_Evolved/effects/effects.json
msgctxt "memorial_female"
msgid "Terrorized the remnants of humanity til there were none left."
msgstr "Aterrorizó a los restos de la humanidad hasta que no quedó ninguno."

#. ~ Male memorial remove log of effect type "Homo sapiens homovorus"
#: data/mods/Xedra_Evolved/effects/effects.json
msgctxt "memorial_male"
msgid "Found a miracle in a world full of the dead."
msgstr "Encontró un milagro en un mundo lleno de muertos."

#. ~ Female memorial remove log of effect type "Homo sapiens homovorus"
#: data/mods/Xedra_Evolved/effects/effects.json
msgctxt "memorial_female"
msgid "Found a miracle in a world full of the dead."
msgstr "Encontró un milagro en un mundo lleno de muertos."

