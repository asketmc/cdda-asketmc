msgstr[0] "multicocina malévola"
msgstr[1] "multicocinas malévolas"
msgstr[2] "multicocinas malévolas"

#. ~ Description of monster "evil multi-cooker"
#: data/json/monsters/misc.json
msgid "The multi-cooker's got a mind of its own!  Look out!"
msgstr "¡La multicocina tiene una mente propia! ¡Cuidado!"

#. ~ Description of monster "mannequin"
#: data/json/monsters/misc.json
msgid "Is this mannequin moving?"
msgstr "¿Se esta moviendo este maniquí?"

#. ~ Monster name
#: data/json/monsters/misc.json data/mods/Magiclysm/monsters/mics.json
msgid "hologram"
msgid_plural "holograms"
msgstr[0] "holograma"
msgstr[1] "hologramas"
msgstr[2] "hologramas"

#. ~ Description of monster "hologram"
#: data/json/monsters/misc.json data/mods/Magiclysm/monsters/mics.json
msgid "An image made from light, nearly identical to the real deal."
msgstr "Es una imagen hecha de luz, casi parece real."

#. ~ Description of monster "inflatable dragon"
#: data/json/monsters/misc.json
msgid "A giant inflatable dragon for Halloween decorations."
msgstr "Un dragón inflable gigante para las decoraciones de Halloween."

#. ~ Description of monster "inflatable ghost"
#: data/json/monsters/misc.json
msgid "A human-sized inflatable ghost for Halloween decorations."
msgstr ""
"Un inflable fantasma de tamaño humano para las decoraciones de Halloween."

#. ~ Description of monster "mannequin decoy"
#: data/json/monsters/misc.json
msgid "A human-sized mannequin, speaking pre-recorded phrases."
msgstr "Un maniquí de tamaño humano, diciendo frases pregrabadas."

#. ~ Death message of monster "mannequin decoy"
#: data/json/monsters/misc.json
#, c-format
msgid "The %s falls over!"
msgstr "¡El %s cae!"

#. ~ Monster name
#: data/json/monsters/misc.json
msgid "dummy"
msgid_plural "dummies"
msgstr[0] "pelele"
msgstr[1] "peleles"
msgstr[2] "peleles"

#. ~ Description of monster "dummy"
#: data/json/monsters/misc.json
msgid ""
"This dummy serves for only one purpose - to teach players how to hit "
"monsters."
msgstr ""
"Este pelele sólo sirve para un propósito: enseñar a los jugadores a golpear"
"  monstruos."

#. ~ Death message of monster "dummy"
#: data/json/monsters/misc.json
#, c-format
msgid "The %s is destroyed."
msgstr "%s es destruido."

#. ~ Monster name
#: data/json/monsters/mollusk.json
msgid "freshwater snail"
msgid_plural "freshwater snails"
msgstr[0] "caracol de agua dulce"
msgstr[1] "caracoles de agua dulce"
msgstr[2] "caracoles de agua dulce"

#. ~ Description of monster "freshwater snail"
#: data/json/monsters/mollusk.json
msgid ""
"A tiny and shelled aquatic gastropod of either native or introduced stock.  "
"Dangerous to eat raw but properly cooked and cleaned it may serve as a fine "
"dish."
msgstr ""
"Un pequeño gasterópodo acuático con caparazón, puede ser de una especie "
"nativa o introducida. Es peligroso comerlo crudo pero si se lo limpia y "
"cocina adecuadamente puede ser un buen plato."

#. ~ Monster name
#: data/json/monsters/mollusk.json
msgid "freshwater mussel"
msgid_plural "freshwater mussels"
msgstr[0] "mejillón de agua dulce"
msgstr[1] "mejillones de agua dulce"
msgstr[2] "mejillones de agua dulce"

#. ~ Description of monster "freshwater mussel"
#: data/json/monsters/mollusk.json
msgid ""
"A tiny bivalve that inhabits rivers and lakes.  Dangerous to eat raw but "
"properly cooked and cleaned it may serve as a fine dish."
msgstr ""
"Un pequeño bivalvo que habita en ríos y lagos. Es peligroso comerlo crudo "
"pero si se limpia y cocina adecuadamente puede ser un buen plato."

#. ~ Monster name
#: data/json/monsters/mollusk.json
msgid "big snail"
msgid_plural "big snails"
msgstr[0] "caracol grande"
msgstr[1] "caracoles grandes"
msgstr[2] "caracoles grandes"

#. ~ Description of monster "big snail"
#: data/json/monsters/mollusk.json
msgid ""
"A shelled gastropod either of native or introduced stock.  This one looks "
"larger than usual."
msgstr ""
"Un gasterópodo con caparazón que puede ser de una especie nativa o "
"introducida. Este parece un poco más grande de lo normal."

#. ~ Monster name
#: data/json/monsters/mollusk.json
msgid "giant snail"
msgid_plural "giant snails"
msgstr[0] "caracol gigante"
msgstr[1] "caracoles gigantes"
msgstr[2] "caracoles gigantes"

#. ~ Description of monster "giant snail"
#: data/json/monsters/mollusk.json
msgid "A snail grown to human size.  Its mouth and underside dripping acid."
msgstr ""
"Un caracol del tamaño de un humano. Su boca y parte inferior están "
"chorreando ácido."

#. ~ Monster name
#: data/json/monsters/mollusk.json
msgid "colossal snail"
msgid_plural "colossal snails"
msgstr[0] "caracol colosal"
msgstr[1] "caracoles colosales"
msgstr[2] "caracoles colosales"

#. ~ Description of monster "colossal snail"
#: data/json/monsters/mollusk.json
msgid ""
"An enormous gastropod with a massive shell on its back.  It slowly crawls "
"over the ground while leaving acid in its path."
msgstr ""
"Un enorme gasterópodo con un caparazón gigante en su espalda. Se arrastra "
"lentamente por el suelo mientras va dejando ácido por el camino."

#. ~ Monster name
#: data/json/monsters/mollusk.json
msgid "big slug"
msgid_plural "big slugs"
msgstr[0] "babosa grande"
msgstr[1] "babosas grandes"
msgstr[2] "babosas grandes"

#. ~ Description of monster "big slug"
#: data/json/monsters/mollusk.json
msgid ""
"A gastropod either of native or introduced stock.  This one looks larger "
"than usual."
msgstr ""
"Un gasterópodo que puede ser de una especie nativa o introducida. Este "
"parece un poco más grande de lo normal."

#. ~ Monster name
#: data/json/monsters/mollusk.json
msgid "giant slug"
msgid_plural "giant slugs"
msgstr[0] "babosa gigante"
msgstr[1] "babosas gigantes"
msgstr[2] "babosas gigantes"

#. ~ Description of monster "giant slug"
#: data/json/monsters/mollusk.json
msgid ""
"A disturbingly large mutated slug as large as a human.  Venom drips from "
"what must be its mouth, and it is covered with sticky mucus."
msgstr ""
"Una perturbadora babosa mutada tan grande como un humano. El veneno gotea de"
" algo como una boca y está cubierto de moco pegajoso."

#. ~ Monster name
#: data/json/monsters/mollusk.json
msgid "colossal slug"
msgid_plural "colossal slugs"
msgstr[0] "babosa colosal"
msgstr[1] "babosas colosales"
msgstr[2] "babosas colosales"

#. ~ Description of monster "colossal slug"
#: data/json/monsters/mollusk.json
msgid ""
"A mutated leopard slug, as wide as a golf cart.  Venom dripping from its "
"fanged maw as it slithers around slowly, leaving a trail of glistening "
"slime."
msgstr ""
"Una babosa leopardo mutada, tan ancha como un carro de golf. El veneno gotea"
" de sus fauces con colmillos mientras se desliza lentamente, dejando un "
"rastro de baba brillante."

#. ~ Monster name
#: data/json/monsters/mollusk.json
msgid "sludge crawler"
msgid_plural "sludge crawlers"
msgstr[0] "reptador de cieno"
msgstr[1] "reptadores de cieno"
msgstr[2] "reptadores de cieno"

#. ~ Description of monster "sludge crawler"
#: data/json/monsters/mollusk.json
msgid ""
"A sluglike creature, eight feet long and the width of a refrigerator.  Its "
"black body glistens as it oozes its way along the ground.  Eyestalks "
"occasionally push their way out of the oily mass and look around."
msgstr ""
"Una criatura similar a una babosa, de dos metros y medio de largo y ancha "
"como una heladera. Su cuerpo negro brilla mientras va rezumando por el "
"suelo. Sus ojos pedunculados salen ocasionalmente de la masa aceitosa y "
"miran a su alrededor."

#. ~ Monster name
#: data/json/monsters/mutant.json
msgid "experimental mutant"
msgid_plural "experimental mutants"
msgstr[0] "mutante experimental"
msgstr[1] "mutantes experimentales"
msgstr[2] "mutantes experimentales"

#. ~ Description of monster "experimental mutant"
#: data/json/monsters/mutant.json
msgid ""
"A deformed mutant in a torn jumpsuit, looking at you with insane hatred.  "
"Their skin is a chaotic mix of scales, fur and chitin, and their fingers end"
" in long talons."
msgstr ""
"Un mutante deforme con un mono roto, mirándote con un odio demente. Su piel "
"es una mezcla caótica de escamas, pellejo y quitina, y sus dedos terminan en"
" largas garras."

#. ~ Monster name
#: data/json/monsters/mutant.json
msgid "bestial mutant"
msgid_plural "bestial mutants"
msgstr[0] "mutante bestial"
msgstr[1] "mutantes bestiales"
msgstr[2] "mutantes bestiales"

#. ~ Description of monster "bestial mutant"
#. ~ Description of monster "abominable renfield"
#: data/json/monsters/mutant.json
#: data/mods/Xedra_Evolved/monsters/bloodsuckers.json
msgid ""
"A towering mutated test subject, covered in thick fur and the torn bottom "
"part of a jumpsuit.  Their legs end in large padded feet not unlike a dog's,"
" but they still manage to stand upright, freeing up their clawed hands to "
"tear you apart."
msgstr ""
"Un sujeto de pruebas mutado e imponente, recubierto de un pellejo grueso y "
"la parte inferior de un mono roto. Sus piernas terminan en pies anchos "
"similares a los de un perro, pero puede pararse erguido y mantener libres "
"sus manos con garras para poder destrozarte."

#. ~ Monster name
#: data/json/monsters/mutant.json
msgid "ungulate mutant"
msgid_plural "ungulate mutants"
msgstr[0] "mutante ungulado"
msgstr[1] "mutantes ungulados"
msgstr[2] "mutantes ungulados"

#. ~ Description of monster "ungulate mutant"
#: data/json/monsters/mutant.json
msgid ""
"A gigantic mutated test subject, still wearing the tattered remains of an "
"orange jumpsuit.  They walk on four warped legs ending in hooves, and their "
"head is dominated by a glistening, tangled crown of antlers that scratch the"
" ceiling."
msgstr ""
"Un sujeto de pruebas mutado y gigantesco, todavía tiene puesto los restos de"
" un mono naranja. Camina en cuatro patas retorcidas que terminan en pezuñas "
"y su cabeza está dominada por una corona brillante y enredada de cuernos que"
" rasguñan el techo."

#. ~ Monster name
#: data/json/monsters/mutant.json
msgid "arthropod mutant"
msgid_plural "arthropod mutants"
msgstr[0] "mutante artrópodo"
msgstr[1] "mutantes artrópodos"
msgstr[2] "mutantes artrópodos"

#. ~ Description of monster "arthropod mutant"
#: data/json/monsters/mutant.json
msgid ""
"A horribly mutated experimental subject.  Their original body - still "
"wearing an orange jumpsuit - flops around lifelessly, carried by twelve "
"segmented legs covered in hairy chitin erupting from their back.  At the "
"base of the front pair of legs, an almost-human scalp gives way to a dozen "
"irregularly-sized eyes and a set of mandibles, and from their hind end a "
"stinger not unlike a scorpion's emerges."
msgstr ""
"Un horrible sujeto experimental mutado. Su cuerpo original - todavía tiene "
"puesto un mono naranja - va desplomándose como muerto llevado por doce patas"
" segmentadas cubiertas de quitina peluda que salen de su espalda. En la base"
" de sus pares frontales de patas, un cuero cabelludo casi humano cede ante "
"una docena de ojos de tamaños irregulares y un conjunto de mandíbulas, y "
"desde su parte trasera sale un aguijón similar al de un escorpión."

#. ~ Monster name
#: data/json/monsters/mutant.json
msgid "camouflaged mutant"
msgid_plural "camouflaged mutants"
msgstr[0] "mutante camuflado"
msgstr[1] "mutantes camuflados"
msgstr[2] "mutantes camuflados"

#. ~ Description of monster "camouflaged mutant"
#: data/json/monsters/mutant.json
msgid ""
"A mutated test subject, running on all fours at alarming speed.  Their short"
" fur changes color to match the background in an instant, making you "
"struggle to keep the thing in focus.  Their thin limbs end in long talons, "
"and their mouth is held perpetually open by a set of knife-sized fangs."
msgstr ""
"Un sujeto de pruebas mutado, corriendo en cuatro patas a una velocidad "
"alarmante. Su pellejo corto cambia de color en un instante, haciéndote "
"difícil centrarte en el mismo. Sus miembros delgados terminan en garras "
"largas y su boca se mantiene abierta permanentemente debido a sus colmillos "
"del tamaño de cuchillos."

#. ~ Monster name
#: data/json/monsters/mutant.json
msgid "transcendent mutant"
msgid_plural "transcendent mutants"
msgstr[0] "mutante trascendente"
msgstr[1] "mutantes trascendentes"
msgstr[2] "mutantes trascendentes"

#. ~ Description of monster "transcendent mutant"
#: data/json/monsters/mutant.json
msgid ""
"An experimental subject wearing a surprisingly clean orange jumpsuit.  They "
"look unchanged at a distance, but as you approach their head spins towards "
"you with unnatural speed.  Their face is disconcertingly beautiful, but "
"their eyes shine with an intelligence far beyond human - and a deep disgust "
"directed at you."
msgstr ""
"Un sujeto experimental vistiendo un mono naranja sorprendentemente limpio. A"
" distancia, pareciera no haber sufrido cambio alguno pero cuando te acercás,"
" su cabeza gira hacia tí a una velocidad sobrenatural. Su cara es "
"desconcertantemente hermosa pero los ojos brillan con una inteligencia más "
"allá de la humana - transmitiendo un profundo asco dirigido hacia tí."

#. ~ Monster message of special attack of monster "transcendent mutant"
#: data/json/monsters/mutant.json
msgid ""
"The mutant gestures at you and barks a few orders, sending its pack of "
"mutants into a frenzy."
msgstr ""
"El mutante hace un gesto hacia tí y ladra unas pocas órdenes, generando en "
"la manada de mutantes frenesí."

#. ~ Monster name
#: data/json/monsters/mutant.json
msgid "mutant child"
msgid_plural "mutant childs"
msgstr[0] "hijo mutante"
msgstr[1] "hijos mutantes"
msgstr[2] "hijos mutantes"

#. ~ Description of monster "mutant child"
#: data/json/monsters/mutant.json
msgid ""
"A thin child with a shaved head, wearing a too-large white lab coat over a "
"baggy orange jumpsuit.  They turn their head towards you with uncanny speed,"
" and you're takеn aback by the inhuman curiosity burning in their eyes.  "
"Their angelic smile does very little to reassure you of their intentions."
msgstr ""
"Un niño delgado con la cabeza rapada, tiene puesto una bata de laboratorio "
"que le queda muy grande encima de un mameluco naranja holgado. Gira su "
"cabeza para mirarte a una velocidad asombrosa y te sorprende la curiosidad "
"sobrehumana que arde en sus ojos. Su sonrisa angelical hace muy poco para "
"calmarte."

#. ~ Death message of monster "mutant child"
#: data/json/monsters/mutant.json
msgid ""
"The child's eyes widen, and they try to say something before falling to the "
"ground."
msgstr ""
"Los ojos del niño están muy abiertos y trata de decir algo antes de caer al "
"suelo."

#. ~ Monster name
#: data/json/monsters/mutant.json
msgid "shelled mutant"
msgid_plural "shelled mutants"
msgstr[0] "mutante caparazón"
msgstr[1] "mutantes caparazón"
msgstr[2] "mutantes caparazón"

#. ~ Description of monster "shelled mutant"
#: data/json/monsters/mutant.json
msgid ""
"An enormous mutant hidden beneath a gray segmented shell, crawling on a "
"carpet of innumerable tentacles covered with suckers.  They hold three "
"thicker, branching limbs high on their front end, each dotted with dozens of"
" unblinking eyeballs."
msgstr ""
"Un enorme mutante oculto detrás de un caparazón gris segmentado, que se "
"arrastra sobre una alfombra de innumerables tentáculos llenos de ventosas. "
"Mantiene tres de sus miembros más gruesos levantados en su parte delantera, "
"cada uno lleno de docenas de ojos que no pestañean."

#. ~ Monster name
#: data/json/monsters/mutant.json
msgid "cyclopean"
msgid_plural "cyclopeans"
msgstr[0] "ciclópeo"
msgstr[1] "ciclópeos"
msgstr[2] "ciclópeos"

#. ~ Description of monster "cyclopean"
#: data/json/monsters/mutant.json
msgid ""
"A relatively humanoid mutant with purple hair and a grapefruit-sized "
"bloodshot eye."
msgstr ""
"Un mutante relativamente humanoide con el pelo púrpura y un ojo inyectado en"
" sangre del tamaño de un pomelo."

#. ~ Monster name
#: data/json/monsters/mutant_mammal.json
#: data/mods/Dark-Skies-Above/overrides/monsters.json
msgid "Cerbearus"
msgid_plural "Cerbearuses"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "Cerbearus"
#: data/json/monsters/mutant_mammal.json
msgid ""
"Sometime between the Cataclysm and now, this black bear has gained two extra"
" heads.  This doesn't seem to have improved its disposition."
msgstr ""
"En algún momento entre el cataclismo y ahora, este oso negro ha ganado dos "
"cabezas extra. Esto no parece haber mejorado su disposición."

#. ~ Monster name
#: data/json/monsters/mutant_mammal.json
#: data/mods/Dark-Skies-Above/overrides/monsters.json
msgid "dambreaker"
msgid_plural "dambreakers"
msgstr[0] "rompedor de presa"
msgstr[1] "rompedores de presa"
msgstr[2] "rompedores de presa"

#. ~ Description of monster "dambreaker"
#: data/json/monsters/mutant_mammal.json
msgid ""
"This mutated beaver is almost double its normal size, and its back is "
"covered with tough-looking bristles."
msgstr ""
"El tamaño de este castor mutado es casi el doble de lo que debería ser, y su"
" espalda está cubierta de cerdas de aspecto duro."

#. ~ Monster name
#: data/json/monsters/mutant_mammal.json
#: data/mods/Dark-Skies-Above/overrides/monsters.json
msgid "feaver"
msgid_plural "feavers"
msgstr[0] "caspluma"
msgstr[1] "casplumas"
msgstr[2] "casplumas"

#. ~ Description of monster "feaver"
#: data/json/monsters/mutant_mammal.json
msgid ""
"This mutant beaver's body is covered with brightly-colored feathers in a "
"particularly eyecatching pattern.  It must have been very lucky not to have "
"been caught by a predator before now."
msgstr ""
"El cuerpo de este castor mutante está cubierto de plumas de colores "
"brillantes en un patrón particularmente llamativo. Debe haber sido muy "
"afortunado de no haber sido capturado por un depredador antes de ahora."

#. ~ Monster name
#: data/json/monsters/mutant_mammal.json
#: data/mods/Dark-Skies-Above/overrides/monsters.json
msgid "iridescent cat"
msgid_plural "iridescent cats"
msgstr[0] "gato iridiscente"
msgstr[1] "gatos iridiscentes"
msgstr[2] "gatos iridiscentes"

#. ~ Description of monster "iridescent cat"
#: data/json/monsters/mutant_mammal.json
msgid ""
"As it moves, this cat's colors shift unnaturally in the light.  You can't "
"make out the breed, but its fur pattern seems to change with every step."
msgstr ""
"A medida que se mueve, los colores de este gato cambian de forma poco "
"natural con la luz. No se puede distinguir la raza, pero su patrón de pelo "
"parece cambiar con cada paso."

#. ~ Monster name
#: data/json/monsters/mutant_mammal.json
#: data/mods/Dark-Skies-Above/overrides/monsters.json
msgid "iridescent kitten"
msgid_plural "iridescent kittens"
msgstr[0] "gatito iridiscente"
msgstr[1] "gatitos iridiscentes"
msgstr[2] "gatitos iridiscentes"

#. ~ Description of monster "iridescent kitten"
#: data/json/monsters/mutant_mammal.json
msgid ""
"In the light, this adorably tiny bundle of unkempt fluff is an ever-changing"
" flurry of brilliant colors."
msgstr ""
"A la luz, este adorable y diminuto bulto de pelusa descuidada es una ráfaga "
"siempre cambiante de colores brillantes."

#. ~ Monster name
#: data/json/monsters/mutant_mammal.json
msgid "viscous kitten"
msgid_plural "viscous kittens"
msgstr[0] "gatito viscoso"
msgstr[1] "gatitos viscosos"
msgstr[2] "gatitos viscosos"

#. ~ Description of monster "viscous kitten"
#: data/json/monsters/mutant_mammal.json
msgid ""
"It is a universally accepted fact that cats are liquid, but this kitten's "
"body seems to quiver ever so slightly while stumbling around and mewing."
msgstr ""
"Es universalmente aceptado el hecho de que los gatos son líquidos pero el "
"cuerpo de este gatito parece temblar levemente mientras avanza tropezándose "
"y maullando."

#. ~ Monster name
#: data/json/monsters/mutant_mammal.json
msgid "liquid cat"
msgid_plural "liquid cats"
msgstr[0] "gato líquido"
msgstr[1] "gatos líquidos"
msgstr[2] "gatos líquidos"

#. ~ Description of monster "liquid cat"
#: data/json/monsters/mutant_mammal.json
msgid ""
"It is universally known that cats are liquid, but this cat's body is "
"actually quivering while it walks around.  It also enjoys resting while "
"twisting its body in ways that would break a normal cat's bones."
msgstr ""
"Es universalmente sabido el hecho de que los gatos son líquidos pero el "
"cuerpo de este gato tiembla mientras camina. También disfruta al descansar "
"con su cuerpo retorcido de formas que romperían los huesos de un gato "
"normal."

#. ~ Monster name
#: data/json/monsters/mutant_mammal.json
msgid "void kitten"
msgid_plural "void kittens"
msgstr[0] "gatito del vacío"
msgstr[1] "gatitos del vacío"
msgstr[2] "gatitos del vacío"

#. ~ Description of monster "void kitten"
#: data/json/monsters/mutant_mammal.json
msgid ""
"This black ball of fur seems to absorb the light from its surroundings while"
" looking criminally cute."
msgstr ""
"Esta pelota negra de pelo parece absorber la luz de sus alrededores a la vez"
" que tiene un aspecto criminalmente adorable."

#. ~ Monster name
#: data/json/monsters/mutant_mammal.json
msgid "void cat"
msgid_plural "void cats"
msgstr[0] "gato del vacío"
msgstr[1] "gatos del vacío"
msgstr[2] "gatos del vacío"

#. ~ Description of monster "void cat"
#: data/json/monsters/mutant_mammal.json
msgid ""
"Seeing how unnaturally dark this black cat's fur is, you are certain this is"
" no ordinary cat.  Its fur seems to absorb light from the surroundings."
msgstr ""
"Al ver lo sobrenatural que es el pelaje negro de este gato, estás seguro que"
" no es normal. Su pelo parece absorber la luz a su alrededor."

#. ~ Monster name
#: data/json/monsters/mutant_mammal.json
#: data/mods/Dark-Skies-Above/overrides/monsters.json
msgid "grinning coyote"
msgid_plural "grinning coyotes"
msgstr[0] "coyote sonriente"
msgstr[1] "coyotes sonrientes"
msgstr[2] "coyotes sonrientes"

#. ~ Description of monster "grinning coyote"
#: data/json/monsters/mutant_mammal.json
msgid ""
"Were it not for the misshapen snout and visible teeth, this would look like "
"an ordinary Northeastern coyote.  Closer inspection of its mouth reveals row"
" after row of serrated, shark-like teeth."
msgstr ""
"Si no fuera por el hocico deforme y los dientes visibles, esto se vería como"
" un coyote común del noreste. Una inspección más cercana de su boca revela "
"fila tras fila de dientes dentados, como los de un tiburón."

#. ~ Monster name
#: data/json/monsters/mutant_mammal.json
#: data/mods/Dark-Skies-Above/overrides/monsters.json
msgid "slavering coyote"
msgid_plural "slavering coyotes"
msgstr[0] "coyote esclavo"
msgstr[1] "coyotes esclavos"
msgstr[2] "coyotes esclavos"

#. ~ Description of monster "slavering coyote"
#: data/json/monsters/mutant_mammal.json
msgid ""
"Unnatural bulges line the neck of this obviously-mutated coyote; green-"
"tinted foam flecks from its lips, and there's a crazed look in its eyes."
msgstr ""
"Bultos antinaturales cubren el cuello de este coyote obviamente mutado; "
"manchas de espuma de color verde en sus labios, y hay una mirada loca en sus"
" ojos."

#. ~ Monster name
#: data/json/monsters/mutant_mammal.json
#: data/mods/Dark-Skies-Above/overrides/monsters.json
#: data/mods/Megafauna/monsters/mf_predators.json
msgid "dire wolf"
msgid_plural "dire wolves"
msgstr[0] "lobo feroz"
msgstr[1] "lobos feroces"
msgstr[2] "lobos feroces"

#. ~ Description of monster "dire wolf"
#: data/json/monsters/mutant_mammal.json
msgid ""
"This wolf has grown to terrifying proportions, rivalling a small car.  Its "
"teeth give steak knives a run for their money, and it definitely doesn't "
"look friendly."
msgstr ""
"Este lobo ha crecido a proporciones aterradoras, rivalizando con un pequeño "
"coche. Sus dientes hacen que los cuchillos para carne den verguenza, y "
"definitivamente no se ve amigable."

#. ~ Monster name
#: data/json/monsters/mutant_mammal.json
#: data/mods/Dark-Skies-Above/overrides/monsters.json
msgid "spideer"
msgid_plural "spideers"
msgstr[0] "ciervaña"
msgstr[1] "ciervañas"
msgstr[2] "ciervañas"

#. ~ Description of monster "spideer"
#: data/json/monsters/mutant_mammal.json
msgid ""
"This once-ordinary deer has grown a disturbingly agile array of extra limbs,"
" plus three extra eyes.  Its antlers wriggle subtly in the wind."
msgstr ""
"Este extraordinario ciervo ha desarrollado un inquietante y ágil conjunto de"
" extremidades adicionales, además de tres ojos adicionales. Su cornamenta se"
" retuerce sutilmente con el viento."

#. ~ Monster name
#: data/json/monsters/mutant_mammal.json
#: data/mods/Dark-Skies-Above/overrides/monsters.json
msgid "spideer fawn"
msgid_plural "spideer fawns"
msgstr[0] "cervatillo de ciervaña"
msgstr[1] "cervatillos de ciervaña"
msgstr[2] "cervatillos de ciervaña"

#. ~ Description of monster "spideer fawn"
#: data/json/monsters/mutant_mammal.json
msgid ""
"This obviously mutated adolescent deer moves unsteadily on its eight legs, "
"nervously scanning the area with all five eyes."
msgstr ""
"Este ciervo adolescente obviamente mutado se mueve inestablemente en sus "
"ocho patas, escudriñando nerviosamente el área con sus cinco ojos."

#. ~ Monster name
#: data/json/monsters/mutant_mammal.json
#: data/mods/Dark-Skies-Above/overrides/monsters.json
msgid "mongrel"
msgid_plural "mongrels"
msgstr[0] "mestizo"
msgstr[1] "mestizos"
msgstr[2] "mestizos"

#. ~ Description of monster "mongrel"
#: data/json/monsters/mutant_mammal.json
msgid ""
"This dog of unidentifiable breed looks like it has seen better days.  Its "
"wiry hair is patchy, revealing scales underneath, but it still happily wags "
"its tails anyways."
msgstr ""
"Este perro de raza no identificable parece haber visto mejores días. Su pelo"
" enjuto es irregular, revelando escamas debajo, pero aún así mueve "
"felizmente la cola."

#. ~ Monster name
#: data/json/monsters/mutant_mammal.json
msgid "translucent dog"
msgid_plural "translucent dogs"
msgstr[0] "perro translúcido"
msgstr[1] "perros translúcidos"
msgstr[2] "perros translúcidos"

#. ~ Description of monster "translucent dog"
#: data/json/monsters/mutant_mammal.json
msgid ""
"This dog doesn't cast a shadow, and if you squint hard enough you can see "
"right through it.  Its condition doesn't appear to do any harm to it, though"
" it seems to cause trouble when it tries to groom itself."
msgstr ""
"Este perro no tiene sombra y si fuerzas la vista puedes ver a través de él. "
"Su condición no parece causarle ningún daño aunque parece causarle problemas"
" cuando intenta acicalarse."

#. ~ Monster name
#: data/json/monsters/mutant_mammal.json
msgid "translucent puppy"
msgid_plural "translucent puppies"
msgstr[0] "cachorro translúcido"
msgstr[1] "cachorros translúcidos"
msgstr[2] "cachorros translúcidos"

#. ~ Description of monster "translucent puppy"
#: data/json/monsters/mutant_mammal.json
msgid ""
"This little rascal doesn't cast a shadow, and is near see-through in the "
"right light.  Its condition doesn't appear to cause it any harm, but it does"
" have a hard time chasing its own tail."
msgstr ""
"Este pequeño perro no tiene sombra y casi se puede ver a través de él con la"
" luz justa. Su condición no parece causarle ningún daño pero tiene algunos "
"problemas para perseguirse su propia cola."

#. ~ Monster name
#: data/json/monsters/mutant_mammal.json
msgid "triclopean dog"
msgid_plural "triclopean dogs"
msgstr[0] "perro tricíclope"
msgstr[1] "perros tricíclopes"
msgstr[2] "perros tricíclopes"

#. ~ Description of monster "triclopean dog"
#: data/json/monsters/mutant_mammal.json
msgid ""
"A rather average looking dog until you notice the third eye, right on its "
"forehead, covered by a thick eyelid.  Whenever its open, small particles of "
"dust from the ground rise and swirl around it."
msgstr ""
"Un perro bastante normal hasta que le ves el tercer ojo, justo en la frente,"
" cubierto con un párpado grueso. Cuando lo abre, se levantan del suelo unas "
"pequeñas partículas de polvo y giran a su alrededor."

#. ~ Monster name
#: data/json/monsters/mutant_mammal.json
msgid "triclopean puppy"
msgid_plural "triclopean puppies"
msgstr[0] "cachorro tricíclope"
msgstr[1] "cachorros tricíclopes"
msgstr[2] "cachorros tricíclopes"

#. ~ Description of monster "triclopean puppy"
#: data/json/monsters/mutant_mammal.json
msgid ""
"A rather cuddly looking pup despite the third eye on its forehead, which has"
" yet to actually open.  Particles of dust from the floor occasionally shift "
"towards it when its excited."
msgstr ""
"Un cachorro bastante adorable a pesar de su tercer ojo que tiene en la "
"frente, el cual todavía no abrió. Unas partículas de polvo del suelo se "
"levantan hacia él cada vez que se emociona."

#. ~ Monster name
#: data/json/monsters/mutant_mammal.json
msgid "unknowable dog"
msgid_plural "unknowable dogs"
msgstr[0] "perro inescrutable"
msgstr[1] "perros inescrutables"
msgstr[2] "perros inescrutables"

#. ~ Description of monster "unknowable dog"
#: data/json/monsters/mutant_mammal.json
msgid ""
"You are completely unable to recall anything about what this dog looks like."
"  You know it's a dog, you know it's there, you know you can see it, but any"
" further information about it isn't retained in your mind."
msgstr ""
"Eres totalmente incapaz de recordar algo que se parezca a este perro. Sabes "
"que es un perro, sabes que está ahí, que lo puedes ver, pero cualquier otra "
"información acerca de él no queda retenida en tu mente."

#. ~ Monster name
#: data/json/monsters/mutant_mammal.json
msgid "unknowable puppy"
msgid_plural "unknowable puppies"
msgstr[0] "cachorro inescrutable"
msgstr[1] "cachorros inescrutables"
msgstr[2] "cachorros inescrutables"

#. ~ Description of monster "unknowable puppy"
#: data/json/monsters/mutant_mammal.json
msgid ""
"Try as you might, your brain is unable to recall any details on what this "
"puppy looks like.  All you can remember is that it is a puppy, that it "
"exists, and that it is cute."
msgstr ""
"Por mucho que lo intentas, tu cerebro no puede recordar ningún detalle de "
"este cachorro. Lo único que recuerdas es que es un cachorro, que existe y "
"que es adorable."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "albino penguin"
msgid_plural "albino penguins"
msgstr[0] "pingüino albino"
msgstr[1] "pingüinos albino"
msgstr[2] "pingüinos albino"

#. ~ Description of monster "albino penguin"
#: data/json/monsters/nether.json
msgid ""
"An eight-foot-tall, ghastly white penguin.  Its muscular body suggests "
"immense strength, but it seems placid unless otherwise provoked."
msgstr ""
"Un pingüino de dos metros de altura, de color blanco espantoso. Su cuerpo "
"musculoso sugiere una fuerza inmensa, pero parece plácido a menos que se le "
"provoque."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "amigara horror"
msgid_plural "amigara horrors"
msgstr[0] "horror amigara"
msgstr[1] "horrores amigara"
msgstr[2] "horrores amigara"

#. ~ Description of monster "amigara horror"
#: data/json/monsters/nether.json
msgid ""
"A hellish, vaguely humanoid horror, two stories tall.  Its face is "
"grotesquely stretched out, its limbs deformed to unrecognizable outgrowths."
msgstr ""
"Un horror infernal, vagamente humanoide, alto como un edificio de dos pisos."
" Su cara está grotescamente estirada hacia afuera, y sus labios deformados "
"de manera irreconocible."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "blank body"
msgid_plural "blank bodies"
msgstr[0] "cadáver vacío"
msgstr[1] "cadáveres vacíos"
msgstr[2] "cadáveres vacíos"

#. ~ Description of monster "blank body"
#: data/json/monsters/nether.json
msgid ""
"This is some form of unnatural changeling creature; its appearance is a "
"bland mockery of the human form.  Featureless and pale, its repugnant "
"countenance is all the more unsettling due to its lack of eyes and "
"distinguishing features except for a perfectly round mouth.  Naked and "
"trembling, it almost seems pitiful but for the way that its unearthly "
"presence makes the hair on the back of your neck stand up in nameless "
"horror."
msgstr ""
"Es alguna clase de criatura sobrenatural, su apariencia parece una burla de "
"la forma humana. Sin gesto, pálido, su expresión repugnante es todavía más "
"perturbadora debido a su carencia de ojos y características distinguibles, "
"excepto una boca perfectamente redonda. Desnudo y temblando casi que te da "
"lástima, pero su presencia hace que se te paren los pelitos de la nuca de "
"horror."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "blood sacrifice"
msgid_plural "blood sacrifices"
msgstr[0] "sacrificio sangriento"
msgstr[1] "sacrificios sangrientos"
msgstr[2] "sacrificios sangrientos"

#. ~ Description of monster "blood sacrifice"
#: data/json/monsters/nether.json
msgid ""
"A defiled human body, once living.  Tortured to death long ago, it remains "
"chained to the altar, the putrescent flays of its peeled skin quivering like"
" so much flotsam upon a murky pond."
msgstr ""
"Es un cuerpo humano profanado, que alguna vez estuvo vivo. Torturado hasta "
"morir hace mucho tiempo, todavía se encuentra encadenado al altar. Los "
"flecos putrefactos de su piel arrancada se agitan como restos de un "
"naufragio en un estanque turbio."

#. ~ Monster name
#. ~ Furniture name
#: data/json/monsters/nether.json
#: data/mods/Aftershock/maps/furniture_and_terrain/terrain_floraxeno.json
msgid "breather"
msgid_plural "breathers"
msgstr[0] "respirador"
msgstr[1] "respiradores"
msgstr[2] "respiradores"

#. ~ Description of monster "breather"
#: data/json/monsters/nether.json
msgid ""
"This is some sort of unearthly pink flesh sac; moist and ridged with veins, "
"it is otherwise without discernible exterior features.  Seemingly immobile "
"and defenseless, it sits in place, swelling and collapsing upon itself as it"
" breathes."
msgstr ""
"Este es una especie de saco de carne rosado, húmedo y con venas, sin rasgos "
"exteriores perceptibles. Aparentemente inmóvil e indefenso, se sienta en su "
"lugar, hinchándose y colapsando sobre sí mismo mientras respira."

#. ~ Description of monster "breather"
#: data/json/monsters/nether.json
msgid ""
"A weird mass of immobile, breathing pink goo.  The other breathers seem to "
"originate from this one."
msgstr ""
"Una extraña masa de sustancia viscosa rosa inmóvil que respira. Los otros "
"respiradores parecen provenir de éste."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "shrapnel swarm"
msgid_plural "shrapnel swarms"
msgstr[0] "enjambre de metralla"
msgstr[1] "enjambres de metralla"
msgstr[2] "enjambres de metralla"

#. ~ Description of monster "shrapnel swarm"
#: data/json/monsters/nether.json
msgid ""
"Uncountable jagged spikes, cleaving reality as they fly through its "
"invisible seams."
msgstr ""
"Incontables puntas dentadas hendiendo la realidad mientras vuelan a través "
"de sus costuras invisibles."

#. ~ Death message of monster "shrapnel swarm"
#: data/json/monsters/nether.json
#, c-format
msgid "The %s grows inert."
msgstr "%s se vuelve inerte."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "structural spur"
msgid_plural "structural spurs"
msgstr[0] "espolón estructural"
msgstr[1] "espolones estructurales"
msgstr[2] "espolones estructurales"

#. ~ Description of monster "structural spur"
#: data/json/monsters/nether.json
msgid ""
"Misshapen spikes of concrete and rebar crumble upwards from the floor, held "
"aloft by strands of visual distortion.  Sound around it is drowned and "
"distorted into an incessant drone."
msgstr ""
"Picos deformes de hormigón y barras corrugadas se desmoronan hacia arriba "
"desde el suelo, sostenidos por hilos de distorsión visual. El sonido que lo "
"rodea se ahoga y distorsiona en un zumbido incesante."

#. ~ Death message of monster "structural spur"
#: data/json/monsters/nether.json
#, c-format
msgid "The distortion fades as the %s crumbles."
msgstr "La distorsión se desvanece mientras que %s se desmigaja."

#. ~ Monster message of special attack of monster "structural spur"
#: data/json/monsters/nether.json
msgid "Scraps of metal fly off the spur and into the nearby swarms!"
msgstr ""
"Los trozos de metal salen volando del espolón y caen en los enjambres "
"cercanos."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "wraith"
msgid_plural "wraiths"
msgstr[0] "espectro"
msgstr[1] "espectros"
msgstr[2] "espectros"

#. ~ Description of monster "wraith"
#: data/json/monsters/nether.json
msgid ""
"A gigantic shadow, chaotically changing in shape and volume.  Two piercing "
"orbs of light dominate what can only be described as its head."
msgstr ""
"Una sombra gigantesca, cambiando caóticamente de forma y volumen. Dos "
"penetrantes orbes de luz dominan lo que sólo puede describirse como su "
"cabeza."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "dementia"
msgid_plural "dementias"
msgstr[0] "dementia"
msgstr[1] "dementias"
msgstr[2] "dementias"

#. ~ Description of monster "dementia"
#: data/json/monsters/nether.json
msgid ""
"A crazed individual, the bloody scars on the side of its shaved head suggest"
" some sort of partial lobotomy."
msgstr ""
"Un individuo enloquecido, las cicatrices sangrientas en el lado de su cabeza"
" afeitada sugieren algún tipo de lobotomía parcial."

#. ~ Monster name
#. ~ Snippet in category "<name_b>"
#. ~ generic negative/hostile pronouns
#: data/json/monsters/nether.json data/json/npcs/talk_tags.json
msgid "dog"
msgid_plural "dogs"
msgstr[0] "perro"
msgstr[1] "perros"
msgstr[2] "perros"

#. ~ Description of monster "dog"
#: data/json/monsters/nether.json
msgid ""
"A domesticated mongrel of the canine persuasion.  In the absence of human "
"society, it has turned feral."
msgstr ""
"Un mestizo domesticado de la persuasión canina. En ausencia de la sociedad "
"humana, se ha vuelto salvaje."

#. ~ Death message of monster "dog"
#. ~ Death message of monster "tentacle dog"
#: data/json/monsters/nether.json
#, c-format
msgid "The %s emerges!"
msgstr "¡Emerge  %s!"

#. ~ Monster name
#: data/json/monsters/nether.json data/mods/No_Hope/monsters.json
msgid "flaming eye"
msgid_plural "flaming eyes"
msgstr[0] "ojo llameante"
msgstr[1] "ojos llameantes"
msgstr[2] "ojos llameantes"

#. ~ Description of monster "flaming eye"
#: data/json/monsters/nether.json
msgid ""
"An enormous disembodied eyeball the size of a person, flying through the air"
" through some unknown agency.  Wreathed in unnatural flickering blue flame, "
"it possesses a blazing yellow iris with a slitted pupil like that of a cat, "
"and trails a set of flailing black tendrils as it slowly drifts about.  Its "
"unearthly presence fills you with dread at the prospect of falling under its"
" baleful gaze."
msgstr ""
"Un enorme globo ocular incorpóreo del tamaño de una persona, volando por el "
"aire a través de alguna agencia desconocida. Envuelto en una llama azul "
"parpadeante y antinatural, posee un iris amarillo ardiente con una pupila "
"rajada como la de un gato y sigue un conjunto de zarcillos negros ondulantes"
" mientras se desplaza lentamente; su presencia sobrenatural te llena de "
"temor ante la perspectiva de caer bajo su mirada maligna."

#. ~ Monster name
#: data/json/monsters/nether.json data/mods/Mythos/monsters/mythos.json
msgid "flying polyp"
msgid_plural "flying polyps"
msgstr[0] "pólipo volador"
msgstr[1] "pólipos voladores"
msgstr[2] "pólipos voladores"

#. ~ Description of monster "flying polyp"
#: data/json/monsters/nether.json
msgid ""
"A half-polypous, utterly alien creature.  It's only partly material and has "
"the ability to fly, despite the absence of wings.  It produces strange "
"whistling noises which send cold shivers of primal terror down your spine."
msgstr ""
"Una criatura medio polipo, totalmente alienígena. Es sólo parcialmente "
"material y tiene la capacidad de volar, a pesar de la ausencia de alas. "
"Produce extraños silbidos que envían escalofríos de terror primitivo por su "
"columna vertebral."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "unseen hunter"
msgid_plural "unseen hunters"
msgstr[0] "cazador invisible"
msgstr[1] "cazadores invisibles"
msgstr[2] "cazadores invisibles"

#. ~ Description of monster "unseen hunter"
#: data/json/monsters/nether.json
msgid ""
"There was nothing here a moment ago, but now you see the faintest outline of"
" an otherworldly creature approaching you with jittery leaps.  Trying to "
"focus on it reveals a pointed beak dripping translucent fluid and rows upon "
"rows of bladed legs grasping the floor, before your eyes begin to burn and "
"your head starts to spin."
msgstr ""
"Hace un momento no había nada aquí, pero ahora ves la tenue silueta de una "
"criatura de otro mundo que se acerca a ti con saltos nerviosos. Al intentar "
"enfocarla, ves un pico puntiagudo que gotea un líquido translúcido y filas y"
" filas de patas con cuchillas que se agarran al suelo, antes de que tus ojos"
" empiecen a arder y tu cabeza a dar vueltas."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "gozu"
msgid_plural "gozus"
msgstr[0] "gozu"
msgstr[1] "gozus"
msgstr[2] "gozus"

#. ~ Description of monster "gozu"
#: data/json/monsters/nether.json
msgid ""
"This is some sort of unnatural cross between a bull and a man.  Quite "
"different from the minotaur of legend, it possesses a shaggy white bull’s "
"head on an otherwise unremarkable human body.  Clad in sagging socks and "
"stained jockey shorts, it grunts and snuffles, drooling ropey strands of "
"white slobber down its chest.  Its mere presence fills you with an "
"unfathomable dread."
msgstr ""
"Esto es una especie de cruce antinatural entre un toro y un hombre. Muy "
"diferente del minotauro de la leyenda, posee una peluda cabeza de toro "
"blanca en un cuerpo humano poco llamativo. Vestido con calcetines caídos y "
"calzoncillos manchados, gruñe y resopla, babeando hilos de baba blanca en su"
" pecho. Su mera presencia te llena de un temor insondable."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "gracken"
msgid_plural "grackens"
msgstr[0] "gracken"
msgstr[1] "grackens"
msgstr[2] "grackens"

#. ~ Description of monster "gracken"
#: data/json/monsters/nether.json
msgid ""
"This is some form of eldritch monstrosity; an uncouth black being with "
"smooth, oily skin and unpleasant horns that curve inward toward each other."
"  Tall and thin, the shadows cling unnaturally to its vaguely defined "
"humanoid form as it shuffles along, its hands twitching and spasming so "
"rapidly as to appear a little more than a black blur of claws.  While it "
"doesn't seem aggressive, gazing upon its disturbing form fills you with an "
"unspeakable terror regardless."
msgstr ""
"Esto es alguna clase de monstruosidad de otro planeta; un ser oscuro y "
"ordinario con piel suave y aceitosa, y unos cuernos desagradables que se "
"curva hacia adentro. Alto y delgado, las sombras se aferran de manera "
"sobrenatural a su vagamente definida forma humanoide mientras se mueve, sus "
"manos se retuercen tan rápidamente que parecen una mancha de garras negras. "
"Viendo su inquietante forma sientes un terror inenarrable."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "tentacle dog"
msgid_plural "tentacle dogs"
msgstr[0] "perro tentáculo"
msgstr[1] "perros tentáculo"
msgstr[2] "perros tentáculo"

#. ~ Description of monster "tentacle dog"
#: data/json/monsters/nether.json
msgid ""
"A dog's body with a mass of ropey, black tentacles reaching out from its "
"head."
msgstr ""
"El cuerpo de un perro con una masa de tentáculos filamentosos negros que "
"salen de su cabeza."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "hound of Tindalos"
msgid_plural "hounds of Tindalos"
msgstr[0] "sabueso de Tindalos"
msgstr[1] "sabuesos de Tindalos"
msgstr[2] "sabuesos de Tindalos"

#. ~ Description of monster "hound of Tindalos"
#: data/json/monsters/nether.json
msgid ""
"A grotesque dog-like beast, its frame is angular and emaciated and its head "
"is like that of an abyssal fish.  When it moves, its twisted limbs "
"duplicate, merge, disappear, and reform in dissonance, as if a hundred "
"copies of itself were somehow forced to inhabit the same space.  Extraneous "
"to our reality, it moves between the corners of the world, hunting those "
"that would dare step beyond time and space."
msgstr ""
"Una grotesca bestia parecida a un perro, su estructura es angular y "
"demacrada y su cabeza es como la de un pez abisal. Cuando se mueve, sus "
"miembros retorcidos se duplican, se fusionan, desaparecen y se reforman en "
"disonancia, como si un centenar de copias de sí misma se vieran obligadas de"
" alguna manera a habitar el mismo espacio. Extras de nuestra realidad, se "
"mueve entre los rincones del mundo, cazando a aquellos que se atreven a ir "
"más allá del tiempo y el espacio."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "human snail"
msgid_plural "human snails"
msgstr[0] "caracol humano"
msgstr[1] "caracoles humanos"
msgstr[2] "caracoles humanos"

#. ~ Description of monster "human snail"
#: data/json/monsters/nether.json
msgid ""
"An enormous fleshy snail, with an oddly human face.  Eyestalks protrude from"
" where the eyes should be."
msgstr ""
"Un enorme caracol carnoso, con una extraña cara humana. Ojos pedunculados "
"salen de donde deberían estar los ojos."

#. ~ Monster name
#: data/json/monsters/nether.json data/mods/Mythos/monsters/mythos.json
msgid "hunting horror"
msgid_plural "hunting horrors"
msgstr[0] "horror cazador"
msgstr[1] "horrores cazador"
msgstr[2] "horrores cazador"

#. ~ Description of monster "hunting horror"
#: data/json/monsters/nether.json
msgid ""
"This is some sort of great viperine creature, possessed of a curiously "
"distorted head and massive clawed appendages.  It partially supports itself "
"with the aid of black, rubbery wings of monstrous dimensions.  Its form "
"writhes and changes before your eyes, filling you with unnameable horror."
msgstr ""
"Esta es una especie de gran criatura viperina, poseedora de una cabeza "
"curiosamente distorsionada y enormes apéndices con garras. Se sostiene "
"parcialmente con la ayuda de unas gomosas alas negras de dimensiones "
"monstruosas. Su forma se retuerce y cambia ante tus ojos, llenándote de un "
"horror innombrable."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "kreck"
msgid_plural "krecks"
msgstr[0] "kreck"
msgstr[1] "krecks"
msgstr[2] "krecks"

#. ~ Description of monster "kreck"
#: data/json/monsters/nether.json
msgid ""
"This is some form of otherworldly hound.  Lean and hungry-looking, its "
"twisted red flesh is stretched tightly across its misshapen, angular frame."
"  Loping grotesquely along, its unusually long neck stretches forward, its "
"skull-like head near the ground as it sniffs out its prey.  Its foulness "
"partially veiled by some arcane force, it seems to almost flicker in and out"
" of your perceptions in a fashion that awakens ancient nameless terrors in "
"the back of your mind."
msgstr ""
"Esta es una forma de sabueso de otro mundo. De aspecto delgado y hambriento,"
" su retorcida carne roja se extiende con fuerza a través de su deforme y "
"anguloso armazón. Se inclina grotescamente, su cuello inusualmente largo se "
"extiende hacia adelante, su cabeza parecida al cráneo cerca del suelo "
"mientras huele a su presa. Su asquerosidad parcialmente velada por alguna "
"fuerza arcana, parece casi parpadear dentro y fuera de sus percepciones de "
"una manera que despierta antiguos terrores sin nombre en el fondo de tu "
"mente."

#. ~ Description of monster "shadow"
#: data/json/monsters/nether.json data/mods/Magiclysm/monsters/shadows.json
msgid ""
"This is an animate shadow.  Looking like nothing more than an errant patch "
"of normal shadow, it draws your attention by the way it moves subtly and "
"whispers softly in the back of your mind.  Strange intrusive thoughts "
"accompany the quiet murmur, awakening your most horrific memories and fears."
msgstr ""
"Esta es una sombra animada. Pareciendo nada más que un trozo errante de "
"sombra normal, atrae tu atención por la forma en que se mueve sutilmente y "
"susurra suavemente en el fondo de tu mente. Extraños pensamientos intrusivos"
" acompañan el tranquilo murmullo, despertando tus más horribles recuerdos y "
"miedos."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "shadow snake"
msgid_plural "shadow snakes"
msgstr[0] "serpiente de sombra"
msgstr[1] "serpientes de sombra"
msgstr[2] "serpientes de sombra"

#. ~ Description of monster "shadow snake"
#: data/json/monsters/nether.json
msgid ""
"This is an animate shadow in the form of a long and sinuous snake.  "
"Translucent and dark, it glides silently across the floor, wriggling and "
"flexing as it moves."
msgstr ""
"Esta es una sombra animada en forma de una serpiente sinuosa y larga. "
"Traslúcida y oscura, se desliza silenciosamente por el suelo, retorciéndose."

#. ~ Monster name
#: data/json/monsters/nether.json data/mods/Mythos/monsters/mythos.json
msgid "shoggoth"
msgid_plural "shoggoths"
msgstr[0] "shoggoth"
msgstr[1] "shoggoths"
msgstr[2] "shoggoths"

#. ~ Description of monster "shoggoth"
#: data/json/monsters/nether.json data/mods/Mythos/monsters/mythos.json
msgid ""
"A gargantuan protoplasmic blob, constantly reshaping, forming new pseudopods"
" seemingly at will.  All over its body are eyes that form and disappear.  It"
" looks at you with malice."
msgstr ""
"Un pantagruélico blobo protoplasmáco, cambiando de forma constantemente, "
"generando nuevos pseudópodos a voluntad. Por todo su cuerpo hay ojos que se "
"forman y desaparecen. Te mira con malicia."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "thing"
msgid_plural "things"
msgstr[0] "cosa"
msgstr[1] "cosas"
msgstr[2] "cosas"

#. ~ Description of monster "thing"
#: data/json/monsters/nether.json
msgid ""
"An amorphous black creature, detaching and sprouting tentacles without any "
"apparent pause."
msgstr ""
"Un criatura amorfa negra, a la que le crecen tentáculos a medida que se le "
"van desprendiendo, sin pausa aparente."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "twisted body"
msgid_plural "twisted bodies"
msgstr[0] "cuerpo retorcido"
msgstr[1] "cuerpos retorcidos"
msgstr[2] "cuerpos retorcidos"

#. ~ Description of monster "twisted body"
#: data/json/monsters/nether.json
msgid ""
"A human body, but with its limbs, neck, and hair impossibly twisted.  It "
"clambers around swiftly, making awful screeching sounds."
msgstr ""
"Un cuerpo humano pero con sus miembros, cuello y pelo retorcidos de una "
"manera imposible. Va trepando velozmente, haciendo unos horribles sonidos "
"como chirridos."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "yugg"
msgid_plural "yuggs"
msgstr[0] "yugg"
msgstr[1] "yuggs"
msgstr[2] "yuggs"

#. ~ Description of monster "yugg"
#: data/json/monsters/nether.json
msgid ""
"This is a huge, slimy worm-like creature.  Its pale, flattened head drips an"
" oily mucus as it breaches the ground, searching for prey.  Its pinkish "
"mouth opens and closes, revealing long fangs glistening with ropey strands "
"of saliva, which leave smoldering stains wherever they drip.  The mere sight"
" of its putrid whitish visage is enough to loose prehistoric terrors within "
"the darkest recesses of your mind."
msgstr ""
"Este es un gigante gusano baboso. Su cabeza chata y pálida chorrea una "
"mucosa aceitosa mientras atraviesa el suelo, buscando a su presa. Su boca "
"rosada se abre y se cierra, revelando largos colmillos con brillantes hilos "
"de saliva, que dejan manchas ardientes donde caen. La mera vista de su "
"pútrido rostro blancuzco es suficiente para liberar horrores prehistóricos "
"en los recovecos más oscuros de tu mente."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "vortex"
msgid_plural "vortexes"
msgstr[0] "vórtice"
msgstr[1] "vórtices"
msgstr[2] "vórtices"

#. ~ Description of monster "vortex"
#: data/json/monsters/nether.json
msgid ""
"A twisting spot in the air, with some kind of morphing mass at its center."
msgstr ""
"Un punto como un torbellino en el aire, con alguna clase de masa que se va "
"transformando en su centro."

#. ~ Monster name
#: data/json/monsters/nether.json data/mods/innawood/monsters/nether.json
msgid "shifting mass"
msgid_plural "shifting masses"
msgstr[0] "masa cambiante"
msgstr[1] "masas cambiantes"
msgstr[2] "masas cambiantes"

#. ~ Description of monster "shifting mass"
#: data/json/monsters/nether.json
msgid ""
"An animate blotch of conflicting symmetries, erratically hovering through "
"the air.  It's not even real enough to hold a stable shape, and its entire "
"form is constantly in flux.  You can see through it - not as if it were "
"transparent, but as if it isn't quite fully here."
msgstr ""
"Una mancha animada de simetrías en conflicto que flota de manera errática "
"por el aire. No es lo suficientemente real como para mantener una forma "
"estable y su cuerpo entero está en un flujo constante. Puedes ver a través "
"de esto - no es transparente pero tampoco tiene una presencia completa."

#. ~ Death message of monster "shifting mass"
#. ~ Death message of monster "impossible shape"
#. ~ Death message of monster "guilt"
#. ~ Death message of monster "sloth"
#. ~ Death message of monster "Impossible shape"
#: data/json/monsters/nether.json data/mods/innawood/monsters/nether.json
#, c-format
msgid "The %s fades away."
msgstr "%s se desvanece."

#. ~ Monster message of special attack of monster "shifting mass"
#: data/json/monsters/nether.json
msgid ""
"The shifting mass passes through you as if you were an illusion, and a "
"slight wave of fatigue washes over you."
msgstr ""
"La masa cambiante te atraviesa como si fueras una ilusión, y una pequeña ola"
" de cansancio te inunda."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "impossible shape"
msgid_plural "impossible shapes"
msgstr[0] "forma imposible"
msgstr[1] "formas imposibles"
msgstr[2] "formas imposibles"

#. ~ Description of monster "impossible shape"
#: data/json/monsters/nether.json
msgid ""
"A twisted shape floating in midair; its angles don't seem to quite add up - "
"it hurts to look at.  Is it inanimate?  Alive?  Something else?  You can't "
"make heads or tails of it at all, but you can see through it - not as if it "
"were transparent, but as if it isn't quite fully here."
msgstr ""
"Una figura retorcida que flota en el aire, sus ángulos no parecen tener "
"sentido - te duele verlo. ¿Es un objeto inanimado? ¿Está vivo? ¿Es otra "
"cosa? No puedes decidir la respuesta pero puedes ver a través de esto - no "
"es transparente pero tampoco tiene una presencia completa."

#. ~ Monster message of special attack of monster "impossible shape"
#. ~ Monster message of special attack of monster "Impossible shape"
#: data/json/monsters/nether.json data/mods/innawood/monsters/nether.json
msgid "You get a very clear view of the impossible shape."
msgstr "Obtienes una visión muy clara de la forma imposible."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "absence"
msgid_plural "absences"
msgstr[0] "ausencia"
msgstr[1] "ausencias"
msgstr[2] "ausencias"

#. ~ Description of monster "absence"
#. ~ Description of monster "Absence"
#: data/json/monsters/nether.json data/mods/innawood/monsters/nether.json
msgid ""
"Every sense you have claims this space to be empty, but your mind is not "
"fooled.  There is an emptiness here that is far from natural or safe."
msgstr ""
"Todos tus sentidos afirman que este espacio está vacío, pero tu mente no se "
"deja engañar. Hay un vacío aquí que está lejos de ser natural o seguro."

#. ~ Death message of monster "absence"
#. ~ Death message of monster "Absence"
#: data/json/monsters/nether.json data/mods/innawood/monsters/nether.json
#, c-format
msgid "The %s returns to normal levels of empty."
msgstr "%s vuelve a los niveles normales de vacío."

#. ~ Monster message of special attack of monster "absence"
#. ~ Monster message of special attack of monster "Absence"
#: data/json/monsters/nether.json data/mods/innawood/monsters/nether.json
msgid "The absence intensifies."
msgstr "La ausencia se intensifica."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "giant appendage"
msgid_plural "giant appendages"
msgstr[0] "apéndice gigante"
msgstr[1] "apéndices gigantes"
msgstr[2] "apéndices gigantes"

#. ~ Description of monster "giant appendage"
#: data/json/monsters/nether.json
msgid ""
"A gigantic, probing appendage blindly feeling the area around it.  All of "
"your senses scream at you that it's the size of a truck, and yet it only "
"takes up about as much space in the world as you do.  It seems to be jutting"
" through a portal, suggesting that it's merely a smaller extension of "
"something much larger."
msgstr ""
"Un apéndice gigantesco que tantea ciegamente el área a su alrededor. Todos "
"tus sentidos te gritan que es del tamaño de un camión y sin embargo solo "
"parece ocupar el mismo espacio que tu en el mundo. Parece sobresalir de un "
"portal, lo que sugiere que es meramente una extensión menor de algo mucho "
"más grande."

#. ~ Death message of monster "giant appendage"
#. ~ Death message of monster "Giant appendage"
#: data/json/monsters/nether.json data/mods/innawood/monsters/nether.json
#, c-format
msgid "The %s is pulled back through the closing portal."
msgstr "%s  es arrastrado a través del portal que se cierra."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "memory"
msgid_plural "memories"
msgstr[0] "recuerdo"
msgstr[1] "recuerdos"
msgstr[2] "recuerdos"

#. ~ Description of monster "memory"
#: data/json/monsters/nether.json
msgid ""
"The silhouette of a human body, reaching towards you like it needs help.  It"
" has no eyes, but you can still feel it staring through you."
msgstr ""
"La silueta de un cuerpo humano tratándote de alcanzar como si te pidiera "
"ayuda. No tiene ojos pero puedes sentir que te está mirando."

#. ~ Death message of monster "memory"
#. ~ Death message of monster "Memory"
#: data/json/monsters/nether.json data/mods/innawood/monsters/nether.json
#, c-format
msgid "The %s begins to cry as it disappears."
msgstr "%s empieza a llorar hasta que desaparece."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "swarm structure"
msgid_plural "swarm structures"
msgstr[0] "estructura enjambre"
msgstr[1] "estructuras enjambre"
msgstr[2] "estructuras enjambre"

#. ~ Description of monster "swarm structure"
#: data/json/monsters/nether.json
msgid ""
"Your mind can't decide if this is a vast structure, or an endless swarm of "
"tiny flying sharp things.  The only thing you know for sure is that it is "
"far too large to fit in the space it occupies."
msgstr ""
"Tu mente no puede decidir si lo que estás viendo es una estructura grande o "
"un enjambre interminable de pequeñas cosas filosas voladoras. De lo único "
"que estás seguro es que es demasiado grande para entrar en el espacio que "
"ocupa."

#. ~ Death message of monster "swarm structure"
#. ~ Death message of monster "twisting blade"
#: data/json/monsters/nether.json
#, c-format
msgid ""
"Your memory can't decide whether the %s was even there in the first place."
msgstr ""
"Tu memoria no puede decidir si la %s estuvo aquí realmente en algún momento."

#. ~ Monster message of special attack of monster "swarm structure"
#: data/json/monsters/nether.json
msgid "The integrity of spacetime is violated."
msgstr "La integridad del espacio tiempo ha sido violada."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "twisting blade"
msgid_plural "twisting blades"
msgstr[0] "cuchilla retorcida"
msgstr[1] "cuchillas retorcidas"
msgstr[2] "cuchillas retorcidas"

#. ~ Description of monster "twisting blade"
#: data/json/monsters/nether.json
msgid ""
"You are uncertain whether this dwarfs you or you dwarf it.  Its exact shape "
"and number of dimensions is constantly changing, but it is always sharp "
"enough to cut a moment in half."
msgstr ""
"No estás seguro si esto te hace sentir más pequeño o si tu haces sentir más "
"pequeño a eso. Su forma y número de dimensiones exactos está en constante "
"cambio pero siempre es filosa como para cortar un momento en dos."

#. ~ Monster message of special attack of monster "twisting blade"
#: data/json/monsters/nether.json
msgid "You are cut in ways worse than physical."
msgstr "Eres cortado de maneras peores que la física."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "chunk of unknown material"
msgid_plural "chunks of unknown material"
msgstr[0] "pedazo de material desconocido"
msgstr[1] "pedazos de material desconocido"
msgstr[2] "pedazos de material desconocido"

#. ~ Description of monster "chunk of unknown material"
#: data/json/monsters/nether.json
msgid ""
"This formless, pitch-black mass wriggles on the ground as it reshapes itself"
" before your eyes.  It slowly drags itself towards you with many tendrils of"
" varied sizes.  As it gets closer to you, its wriggling intensifies as if it"
" reacted to you."
msgstr ""
"Esta masa sin forma y negra azabache se retuerce en el suelo como si "
"estuviera tomando otra forma delante de tus ojos. Lentamente se arrastra "
"hacia ti con muchos zarcillos de diferentes tamaños. Mientras se va "
"acercando, sus torceduras se intensifican como si estuviera reaccionando a "
"tu presencia."

#. ~ Death message of monster "chunk of unknown material"
#: data/json/monsters/nether.json
msgid ""
"The material stabilizes and reforms itself into a small chunk of unknown "
"composition."
msgstr ""
"El material se estabiliza y se reforma en un pequeño pedazo de composición "
"desconocida."

#. ~ Monster message of special attack of monster "chunk of unknown material"
#: data/json/monsters/nether.json
msgid "The chunk twists and tears itself as it reacts to your presence!"
msgstr "¡El pedazo se retuerce y se rompe cuando reacciona a tu presencia!"

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "pulsating chunk of unknown material"
msgid_plural "pulsating chunks of unknown material"
msgstr[0] "pedazo palpitante de material desconocido"
msgstr[1] "pedazos palpitantes de material desconocido"
msgstr[2] "pedazos palpitantes de material desconocido"

#. ~ Description of monster "pulsating chunk of unknown material"
#: data/json/monsters/nether.json
msgid ""
"This formless, pitch-black mass wriggles and pulses on the ground as it "
"reshapes itself before your eyes.  It slowly drags itself towards you with "
"many tendrils of varied sizes.  As it gets closer to you, its pulsing "
"intensifies as if it reacted to you."
msgstr ""
"Esta masa negra azabache sin forma se retuerce y palpita en el suelo como si"
"  estuviera tomando otra forma delante de tus ojos. Lentamente se arrastra "
"hacia ti con muchos zarcillos de diferentes tamaños. Mientras se va "
"acercando, sus movimientos se intensifican como si estuviera reaccionando a "
"tu presencia."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "resonating chunk of unknown material"
msgid_plural "resonating chunks of unknown material"
msgstr[0] "pedazo resonante de material desconocido"
msgstr[1] "pedazos resonantes de material desconocido"
msgstr[2] "pedazos resonantes de material desconocido"

#. ~ Description of monster "resonating chunk of unknown material"
#: data/json/monsters/nether.json
msgid ""
"This formless, pitch-black mass wriggles violently and noisily on the ground"
" as it reshapes itself before your eyes.  It slowly drags itself towards you"
" with many tendrils of varied sizes sparkling with electricity.  As it gets "
"closer to you, its wriggling intensifies and its sparks grow brighter as if "
"it reacted to you."
msgstr ""
"Esta masa sin forma negra azabache se retuerce violentamente y hace mucho "
"ruido en el suelo, como si se estuviera tomando otra forma delante de tus "
"ojos. Lentamente se arrastra hacia ti con muchos zarcillos de diferentes "
"tamaños. Mientras se va acercando, sus movimientos se intensifican y sus "
"chispas se hacen más brillantes como si estuviera reaccionando a tu "
"presencia."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "pale reflection"
msgid_plural "pale reflections"
msgstr[0] "reflejo pálido"
msgstr[1] "reflejos pálidos"
msgstr[2] "reflejos pálidos"

#. ~ Description of monster "pale reflection"
#: data/json/monsters/nether.json
msgid ""
"This looks nothing like you.  It's barely real.  So why does your mind keep "
"mistaking it for you?"
msgstr ""
"Esto no se parece para nada a ti. Apenas si es real. Así que ¿por qué tu "
"mente lo sigue confundiendo contigo mismo?"

#. ~ Death message of monster "pale reflection"
#: data/json/monsters/nether.json
#, c-format
msgid "The %s vanishes but you can still feel it."
msgstr "El %s desaparece pero todavía puedes sentirlo."

#. ~ Monster message of special attack of monster "pale reflection"
#: data/json/monsters/nether.json
#, c-format
msgid "You can feel the %s."
msgstr "Puedes sentir el %s."

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "twisted reflection"
msgid_plural "twisted reflections"
msgstr[0] "reflejo retorcido"
msgstr[1] "reflejos retorcidos"
msgstr[2] "reflejos retorcidos"

#. ~ Description of monster "twisted reflection"
#: data/json/monsters/nether.json
msgid ""
"This looks almost nothing like you.  It's form isn't even stable.  So why "
"does your mind keep mistaking it for you?"
msgstr ""
"Esto no se parece casi en nada a ti. Su forma ni siquiera es estable. Así "
"que ¿por qué tu mente lo sigue confundiendo contigo mismo?"

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "dark reflection"
msgid_plural "dark reflections"
msgstr[0] "reflejo oscuro"
msgstr[1] "reflejos oscuros"
msgstr[2] "reflejos oscuros"

#. ~ Description of monster "dark reflection"
#: data/json/monsters/nether.json
msgid ""
"This only looks a little like you.  It's obviously not you.  So why does "
"your mind keep mistaking it for you?"
msgstr ""
"Esto se parece muy poco a ti. Pero obviamente, no eres tu. Así que ¿por qué "
"tu mente se sigue confundiendo contigo mismo?"

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "better half"
msgid_plural "better halves"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "better half"
#: data/json/monsters/nether.json
msgid ""
"This doesn't look like you.  It looks like what you've dreamed you could be."
"  Why does your mind keep mistaking you for a bad copy of it?"
msgstr ""

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "tainted shadow"
msgid_plural "tainted shadows"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "tainted shadow"
#: data/json/monsters/nether.json
msgid "Your shadow is host to something alien."
msgstr ""

#. ~ Death message of monster "tainted shadow"
#: data/json/monsters/nether.json
msgid "Your shadow seemingly becomes normal again."
msgstr ""

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "person"
msgid_plural "persons"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "person"
#: data/json/monsters/nether.json
msgid ""
"A common human, that looks exactly like human do.  You can see it.  It can "
"see you.  You know it knows you can see it.  It knows you know you can see "
"him.  It moves towards you."
msgstr ""

#. ~ Death message of monster "person"
#: data/json/monsters/nether.json
msgid "it just disappeared."
msgstr ""

#. ~ Monster message of special attack of monster "person"
#: data/json/monsters/nether.json
msgid "You feel something was destroyed inside you."
msgstr ""

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "guilt"
msgid_plural "guilts"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "guilt"
#: data/json/monsters/nether.json
msgid ""
"An animate blotch of conflicting shapes, when you look at or think of this, "
"memories of your wrongdoings rise to the surface."
msgstr ""

#. ~ Monster message of special attack of monster "guilt"
#: data/json/monsters/nether.json
msgid ""
"The guilt makes no physical movement and yet you feel the force of its "
"assault.  Everything feels heavier."
msgstr ""

#. ~ Monster name
#: data/json/monsters/nether.json
msgid "sloth"
msgid_plural "sloths"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "sloth"
#: data/json/monsters/nether.json
msgid ""
"An animate blotch of conflicting shapes, when you look at or think of this, "
"a desire to stop moving rises."
msgstr ""

#. ~ Monster message of special attack of monster "sloth"
#: data/json/monsters/nether.json
msgid ""
"The sloth does nothing, and you feel time itself aiding your desire to do "
"nothing."
msgstr ""

#. ~ Monster name
#: data/json/monsters/obsolete.json
msgid "caterpillar"
msgid_plural "caterpillars"
msgstr[0] "oruga"
msgstr[1] "orugas"
msgstr[2] "orugas"

#. ~ Description of monster "caterpillar"
#: data/json/monsters/obsolete.json
msgid ""
"Caterpillars are the larval stage of butterflies and moths.  This one seems "
"newly hatched from an egg but even now it is large as a cat."
msgstr ""

#. ~ Description of monster "giant caterpillar"
#: data/json/monsters/obsolete.json
msgid ""
"This caterpillar has reached the size of a person and it looks close to make"
" a cocoon.  You can only imagine the size of the insect that will emerge."
msgstr ""

#. ~ Monster name
#: data/json/monsters/obsolete.json
msgid "trout"
msgid_plural "trouts"
msgstr[0] "trucha"
msgstr[1] "truchas"
msgstr[2] "truchas"

#. ~ Description of monster "trout"
#: data/json/monsters/obsolete.json
msgid ""
"A trout.  A fish made popular by father-son fishing trips, except for the "
"part where you have to gut it."
msgstr ""
"Una trucha.  Un pez que se hizo popular en los viajes de pesca padre-hijo, "
"excepto por la parte en la que hay que destriparlo."

#. ~ Monster name
#: data/json/monsters/obsolete.json
msgid "steelhead trout"
msgid_plural "steelhead trouts"
msgstr[0] "trucha cabeza de acero"
msgstr[1] "truchas cabeza de acero"
msgstr[2] "truchas cabeza de acero"

#. ~ Description of monster "steelhead trout"
#: data/json/monsters/obsolete.json
msgid ""
"A steelhead trout.  A fish made popular by father-son fishing trips, except "
"for the part where you have to gut it."
msgstr ""
"Una trucha de cabeza de acero. Un pez que se hizo popular en las excursiones"
" de pesca padre-hijo, excepto en la parte en la que hay que destriparlo."

#. ~ Monster name
#: data/json/monsters/obsolete.json
msgid "chinook salmon"
msgid_plural "chinook salmons"
msgstr[0] "salmón chinook"
msgstr[1] "salmones chinook"
msgstr[2] "salmones chinook"

#. ~ Description of monster "chinook salmon"
#: data/json/monsters/obsolete.json
msgid ""
"A Chinook salmon.  A very fatty, nutritious fish.  Tastes great smoked."
msgstr ""
"Un salmón Chinook. Un pescado muy graso y nutritivo. Sabe muy bien ahumado."

#. ~ Monster name
#: data/json/monsters/obsolete.json
msgid "coho salmon"
msgid_plural "coho salmons"
msgstr[0] "salmón coho"
msgstr[1] "salmones coho"
msgstr[2] "salmones coho"

#. ~ Description of monster "coho salmon"
#: data/json/monsters/obsolete.json
msgid "A Coho salmon.  A very fatty, nutritious fish.  Tastes great smoked."
msgstr ""
"Un salmón Coho. Un pescado muy graso y nutritivo. Sabe muy bien ahumado."

#. ~ Monster name
#: data/json/monsters/obsolete.json
msgid "white bass"
msgid_plural "white bass"
msgstr[0] "lubina blanca"
msgstr[1] "lubinas blancas"
msgstr[2] "lubinas blancas"

#. ~ Description of monster "white bass"
#: data/json/monsters/obsolete.json
msgid ""
"A white bass.  Common to this region, it is a slab-sided and spiny-rayed "
"little fish."
msgstr ""
"Una lubina blanca. Común en esta región, es un pececito de lados cortados y "
"con rayas espinosas."

#. ~ Monster name
#: data/json/monsters/obsolete.json
msgid "longear sunfish"
msgid_plural "longear sunfish"
msgstr[0] "pez luna de oreja larga"
msgstr[1] "peces luna de oreja larga"
msgstr[2] "peces luna de oreja larga"

#. ~ Description of monster "longear sunfish"
#: data/json/monsters/obsolete.json
msgid "A longear sunfish.  A small fish related to bass and bluegill."
msgstr ""
"Un pez luna orejón. Es un pequeño pez relacionado con el róbalo y el perca "
"sol."

#. ~ Monster name
#: data/json/monsters/obsolete.json
msgid "redear sunfish"
msgid_plural "redear sunfish"
msgstr[0] "pez luna de oreja roja"
msgstr[1] "peces luna de oreja roja"
msgstr[2] "peces luna de oreja roja"

#. ~ Description of monster "redear sunfish"
#: data/json/monsters/obsolete.json
msgid "A redear sunfish.  A small fish related to bass and bluegill."
msgstr ""
"Un pez luna oreja roja. Es un pequeño pez relacionado con el róbalo y el "
"perca sol."

#. ~ Monster name
#: data/json/monsters/obsolete.json
msgid "endless hunger"
msgid_plural "endless hungers"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "endless hunger"
#: data/json/monsters/obsolete.json
msgid ""
"Your mind fills in large shifting images of predators to save you from its "
"actual appearance.  You can feel it despite the distance as if it were "
"connected to you."
msgstr ""

#. ~ Monster name
#: data/json/monsters/obsolete.json data/mods/No_Hope/monsters.json
msgid "zombie burner"
msgid_plural "zombie burners"
msgstr[0] "quemador zombi"
msgstr[1] "quemadores zombi"
msgstr[2] "quemadores zombi"

#. ~ Description of monster "zombie burner"
#: data/json/monsters/obsolete.json data/mods/No_Hope/monsters.json
msgid ""
"When bullets weren't enough to stop the end of the world, the military tried"
" fire instead.  Their failure is made manifest in this gas-masked husk, its "
"black suit torn and ripped.  Its flamethrower, dangling limply at its side, "
"is attached to a tank of napalm strapped onto its back, which trickles its "
"contents onto the ground."
msgstr ""
"Cuando las balas no fueron suficientes para detener el fin del mundo, los "
"militares probaron con el fuego. Su fracaso se manifiesta en esta cáscara "
"vacía y enmascarada, con su traje negro desgarrado. Su lanzallamas, que "
"cuelga sin fuerzas a su lado, está unido a un tanque de napalm atado a su "
"espalda, que deja caer su contenido al suelo."

#. ~ Monster name
#: data/json/monsters/obsolete.json
msgid "Big Pappy"
msgid_plural "Big Pappys"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "Big Pappy"
#: data/json/monsters/obsolete.json
msgid ""
"A gigantic, monstrous old man with a crazed, anguished face.  He carries a "
"large cane, and seems intent to discipline you with it."
msgstr ""

#. ~ Monster name
#: data/json/monsters/obsolete.json
msgid "feral granny"
msgid_plural "feral grannies"
msgstr[0] "abuela salvaje"
msgstr[1] "abuelas salvajes"
msgstr[2] "abuelas salvajes"

#. ~ Description of monster "feral granny"
#: data/json/monsters/obsolete.json
msgid ""
"A sweet old lady in a wheelchair.  As you move closer, she offers you some "
"cookies.  Do you want a cookie?"
msgstr ""

#. ~ Monster name
#: data/json/monsters/obsolete.json
msgid "zeriatric"
msgid_plural "zeriatrics"
msgstr[0] "zeriátrico"
msgstr[1] "zeriátricos"
msgstr[2] "zeriátricos"

#. ~ Description of monster "zeriatric"
#: data/json/monsters/obsolete.json
msgid ""
"A hunched, decrepit, geriatric zombie.  Its dentures seem to be falling out."
msgstr ""
"Un zombi geriátrico, encorvado y decrépito. Parece que está perdiendo los "
"dientes."

#. ~ Monster name
#: data/json/monsters/power_leech.json
msgid "leech blossom"
msgid_plural "leech blossoms"
msgstr[0] "flor sanguijuela"
msgstr[1] "flores sanguijuela"
msgstr[2] "flores sanguijuela"

#. ~ Description of monster "leech blossom"
#: data/json/monsters/power_leech.json
msgid ""
"A resplendent alien fern, crowned with flowers colored deep indigo.  It "
"appears to be the centerpiece of this otherworldly bloom."
msgstr ""
"Un resplandeciente helecho alienígena, coronado con flores de color índigo "
"profundo. Parece ser la pieza central de este florecimiento de otro mundo."

#. ~ Description of special attack of monster "leech blossom"
#: data/json/monsters/power_leech.json
msgid "Lightning arcs from the leech blossom!"
msgstr "¡Arcos de rayos de la flor de sanguijuela!"

#. ~ Targeting sound of special attack of monster "leech blossom"
#. ~ Targeting sound of special attack of monster "leech stalk"
#. ~ Targeting sound of special attack of monster "leech pod cluster"
#. ~ Targeting sound of special attack of monster "root runner"
#. ~ Targeting sound of special attack of monster "root drone"
#: data/json/monsters/power_leech.json
msgid "a faint buzz"
msgstr "un débil zumbido"

#. ~ Monster name
#: data/json/monsters/power_leech.json
msgid "leech stalk"
msgid_plural "leech stalks"
msgstr[0] "tallo de sanguijuela"
msgstr[1] "tallos de sanguijuela"
msgstr[2] "tallos de sanguijuela"

#. ~ Description of monster "leech stalk"
#: data/json/monsters/power_leech.json
msgid ""
"A resplendent and voluminous alien fern.  A faint buzzing sound emanates "
"from it, and the shadow cast by its canopy continuously glows with electric "
"charge."
msgstr ""
"Un resplandeciente y voluminoso helecho alienígena. Un débil zumbido emana "
"de él, y la sombra que proyecta su dosel brilla continuamente con carga "
"eléctrica."

#. ~ Description of special attack of monster "leech stalk"
#: data/json/monsters/power_leech.json
msgid "Lightning arcs from the leech stalk!"
msgstr "¡Arcos de rayos del tallo de la sanguijuela!"

#. ~ Monster name
#: data/json/monsters/power_leech.json
msgid "signal tree"
msgid_plural "signal trees"
msgstr[0] "árbol señal"
msgstr[1] "arboles señales"
msgstr[2] "arboles señales"

#. ~ Description of monster "signal tree"
#: data/json/monsters/power_leech.json
msgid ""
"A trunk reaches tall into the sky, its topmost branches glowing with yellow "
"light.  A low drum periodically shakes its vicinities."
msgstr ""
"Un tronco llega alto en el cielo, sus ramas superiores brillan con luz "
"amarilla. Un bajo tambor sacude periódicamente sus alrededores."

#. ~ Monster name
#: data/json/monsters/power_leech.json
msgid "leech pod cluster"
msgid_plural "leech pod clusters"
msgstr[0] "grupo de vainas de sanguijuelas"
msgstr[1] "grupos de vainas de sanguijuelas"
msgstr[2] "grupos de vainas de sanguijuelas"

#. ~ Description of monster "leech pod cluster"
#: data/json/monsters/power_leech.json
msgid ""
"The translucent egg pods of an alien plant, firmly attached by luminous "
"rhizomes.  You can barely distinguish a root drone floating within a cloudy "
"substance."
msgstr ""
"Las vainas de huevo translúcidas de una planta alienígena, firmemente "
"adheridas por rizomas luminosos. Apenas se puede distinguir un zángano de "
"raíz flotando dentro de una sustancia nublada."

#. ~ Description of special attack of monster "leech pod cluster"
#: data/json/monsters/power_leech.json
msgid "Lightning arcs from the pod cluster!"
msgstr "¡Arcos de rayos del grupo de vainas!"

#. ~ Monster name
#: data/json/monsters/power_leech.json
msgid "root runner"
msgid_plural "root runners"
msgstr[0] "corredor de raíz"
msgstr[1] "corredores de raíz"
msgstr[2] "corredores de raíz"

#. ~ Description of monster "root runner"
#: data/json/monsters/power_leech.json
msgid ""
"This clump of woody vegetation hastily clambers around in a lizard-like "
"fashion.  Three translucent scale-leaves stand tall on the backside of the "
"creature, and the thin ridges within them periodically glow through some "
"unknown means.  It's seemingly a symbiote of the nearby alien ferns, and "
"looks ready to defend them with its life."
msgstr ""
"Este grupo de vegetación leñosa se agrupa apresuradamente alrededor de una "
"forma similar a un lagarto. Tres hojas de escamas translúcidas se erigen en "
"la parte trasera de la criatura, y las delgadas crestas dentro de ellas "
"brillan periódicamente a través de algún medio desconocido. Parece ser un "
"simbionte de los helechos alienígenas cercanos, y parece estar listo para "
"defenderlos con su vida."

#. ~ Description of special attack of monster "root runner"
#: data/json/monsters/power_leech.json
msgid "Sparks fly from the root runner!"
msgstr "¡Las chispas vuelan desde el corredor de la raíz!"

#. ~ Monster name
#: data/json/monsters/power_leech.json
msgid "root drone"
msgid_plural "root drones"
msgstr[0] "dron de raiz"
msgstr[1] "drones de raiz"
msgstr[2] "drones de raiz"

#. ~ Description of monster "root drone"
#: data/json/monsters/power_leech.json
msgid ""
"A small bulb with a beak-like protuberance, skittishly roaming about under "
"three tendril rhizomes.  Dripping and glistening, it resembles a newborn "
"animal rather than a sapling grown from seeds."
msgstr ""
"Un pequeño bulbo con una protuberancia en forma de pico, vagando asustado "
"bajo tres rizomas de zarcillos. Goteando y brillando, se asemeja a una "
"criatura recién nacida en lugar de un árbol joven crecido a partir de "
"semillas."

#. ~ Description of special attack of monster "root drone"
#: data/json/monsters/power_leech.json
msgid "Lightning arcs from the root pod!"
msgstr "¡Se ven rayos que salen de las raíces!"

#. ~ Monster name
#: data/json/monsters/reptile_amphibian.json
#: data/mods/Tamable_Wildlife/reptile_amphibian.json
msgid "bullfrog"
msgid_plural "bullfrogs"
msgstr[0] "rana toro"
msgstr[1] "ranas toro"
msgstr[2] "ranas toro"

#. ~ Description of monster "bullfrog"
#: data/json/monsters/reptile_amphibian.json
msgid ""
"The American bullfrog, in its natural habitat.  It feeds on insects, mice, "
"lizards and any other living thing it can stuff down its gullet."
msgstr ""
"La rana toro americana, en su hábitat natural. Se alimenta de insectos, "
"ratones, lagartijas y otros seres vivos que puede meterse en la garganta."

#. ~ Monster name
#: data/json/monsters/reptile_amphibian.json
msgid "tadpole"
msgid_plural "tadpole"
msgstr[0] "renacuajo"
msgstr[1] "renacuajos"
msgstr[2] "renacuajos"

#. ~ Description of monster "tadpole"
#: data/json/monsters/reptile_amphibian.json
msgid ""
"An American bullfrog in its larval stage.  It will eventually grow legs and "
"start breathing air."
msgstr ""
"Un anfibio en estado larvario. Con el tiempo le saldrán patas y empezará a "
"respirar aire."

#. ~ Monster name
#: data/json/monsters/reptile_amphibian.json
#: data/mods/Tamable_Wildlife/reptile_amphibian.json
msgid "mutant bullfrog"
msgid_plural "mutant bullfrogs"
msgstr[0] "rana toro mutante"
msgstr[1] "ranas toro mutantes"
msgstr[2] "ranas toro mutantes"

#. ~ Description of monster "mutant bullfrog"
#: data/json/monsters/reptile_amphibian.json
msgid "A mutant bullfrog the size of a person.  It looks unwell."
msgstr "Una rana toro mutante del tamaño de una persona. No se ve bien."

#. ~ Monster name
#: data/json/monsters/reptile_amphibian.json
#: data/mods/Tamable_Wildlife/reptile_amphibian.json
msgid "giant bullfrog"
msgid_plural "giant bullfrogs"
msgstr[0] "rana toro gigante"
msgstr[1] "ranas toro gigantes"
msgstr[2] "ranas toro gigantes"

#. ~ Description of monster "giant bullfrog"
#: data/json/monsters/reptile_amphibian.json
msgid ""
"A mutated bullfrog taller than you are.  It stares with amber eyes as it "
"considers the easiest way to swallow you whole."
msgstr ""
"Una rana toro mutada, más alta que tú. Tiene los ojos ámbar y te mira "
"mientras considera la manera más fácil de tragarte entero."

#. ~ Monster name
#: data/json/monsters/reptile_amphibian.json
#: data/mods/Tamable_Wildlife/reptile_amphibian.json
msgid "colossal croaker"
msgid_plural "colossal croakers"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "colossal croaker"
#: data/json/monsters/reptile_amphibian.json
msgid ""
"Bloated to titanic size, rivaling a moose, this mutated bullfrog takes "
"several seconds just to blink each vacant eye.  In place of the cognition it"
" has lost, the beast has gained an even more voracious appetite and the "
"might to sustain it."
msgstr ""

#. ~ Monster name
#: data/json/monsters/reptile_amphibian.json
msgid "sewer gator"
msgid_plural "sewer gators"
msgstr[0] "caimán de alcantarilla"
msgstr[1] "caimanes de alcantarilla"
msgstr[2] "caimanes de alcantarilla"

#. ~ Description of monster "sewer gator"
#: data/json/monsters/reptile_amphibian.json
msgid ""
"In the late 20th century, there was an urban legend about pet alligators "
"getting flushed down the toilet and growing to adulthood in the sewers.  If "
"this large specimen was ever someone's pet, it doesn't look like it sees "
"humans as anything other than a meal now."
msgstr ""
"A fines del siglo XX había una leyenda urbana acerca de unos pequeños "
"cocodrilos que eran tirados por el inodoro y se hacían adultos en las "
"cloacas. Este gran espécimen parece ver a los humanos solo como comida."

#. ~ Monster name
#: data/json/monsters/reptile_amphibian.json
msgid "rattlesnake"
msgid_plural "rattlesnakes"
msgstr[0] "serpiente de cascabel"
msgstr[1] "serpientes de cascabel"
msgstr[2] "serpientes de cascabel"

#. ~ Description of monster "rattlesnake"
#: data/json/monsters/reptile_amphibian.json
msgid ""
"The timber rattlesnake, the most venomous viper native to New England.  "
"Climatic changes have extended its range far into the north."
msgstr ""
"La serpiente de cascabel de la madera es la víbora más venenosa nativa de "
"Nueva Inglaterra. Los cambios climáticos la han llevado hacia el norte."

#. ~ Monster name
#: data/json/monsters/reptile_amphibian.json
#: data/mods/Dark-Skies-Above/overrides/monsters.json
msgid "giant rattlesnake"
msgid_plural "giant rattlesnakes"
msgstr[0] "serpiente de cascabel gigante"
msgstr[1] "serpientes de cascabel gigantes"
msgstr[2] "serpientes de cascabel gigantes"

#. ~ Description of monster "giant rattlesnake"
#: data/json/monsters/reptile_amphibian.json
msgid ""
"A mutated timber rattlesnake, about three times as large as the norm.  While"
" it isn't big enough to regard humans as potential prey, it is more "
"aggressive and dangerous compared to a normal rattler."
msgstr ""
"Es una serpiente de cascabel de la madera mutada, de unas tres veces más "
"grande que la común. Aunque no es lo suficientemente grande como para "
"considerar a los humanos su presa, es más agresiva y peligrosa comparada a "
"la cascabel normal."

#. ~ Monster name
#: data/json/monsters/reptile_amphibian.json
msgid "deathrattle serpent"
msgid_plural "deathrattle serpents"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "deathrattle serpent"
#: data/json/monsters/reptile_amphibian.json
msgid ""
"A primal fear strikes when the club-like tail of this massively warped snake"
" shifts, an assortment of bones rattling softly.  Multiple sets of hollow "
"fangs have erupted in its maw, which itself is flanked by skinless ropes of "
"powerful muscle."
msgstr ""

#. ~ Monster name
#: data/json/monsters/reptile_amphibian.json
msgid "sewer snake"
msgid_plural "sewer snakes"
msgstr[0] "serpiente de cloaca"
msgstr[1] "serpientes de cloaca"
msgstr[2] "serpientes de cloaca"

#. ~ Description of monster "sewer snake"
#: data/json/monsters/reptile_amphibian.json
msgid ""
"An aggressive mutant variety of the worm snake, turned pale yellow from lack"
" of sunlight.  It swarms beneath the ground, and is named for its habit of "
"infesting sewer lines."
msgstr ""
"Una agresiva variedad mutante de la serpiente gusano, de color amarillo "
"pálido por la falta de luz solar. Pulula bajo el suelo y recibe su nombre "
"por su costumbre de infestar las alcantarillas."

#. ~ Monster name
#: data/json/monsters/reptile_amphibian.json
#: data/mods/Tamable_Wildlife/reptile_amphibian.json
msgid "toad"
msgid_plural "toads"
msgstr[0] "sapo"
msgstr[1] "sapos"
msgstr[2] "sapos"

#. ~ Description of monster "toad"
#: data/json/monsters/reptile_amphibian.json
msgid ""
"Toads are a diverse and varied family of amphibians sister to frogs.  Very "
"distinguishable for their warty and dry skin."
msgstr ""
"Los sapos son una familia de anfibios diversa y variada, hermanas de las "
"ranas. Se distinguen por su piel verrugosa y seca."

#. ~ Monster name
#: data/json/monsters/reptile_amphibian.json
msgid "toad tadpole"
msgid_plural "toad tadpoles"
msgstr[0] "renacuajo de sapo"
msgstr[1] "renacuajos de sapo"
msgstr[2] "renacuajos de sapo"

#. ~ Description of monster "toad tadpole"
#: data/json/monsters/reptile_amphibian.json
msgid ""
"Toad tadpoles looks exactly like a frog tadpoles at birth.  The main "
"difference is that they keep this color during their whole larval stage."
msgstr ""

#. ~ Monster name
#: data/json/monsters/reptile_amphibian.json
#: data/mods/Tamable_Wildlife/reptile_amphibian.json
msgid "huge toad"
msgid_plural "huge toads"
msgstr[0] "sapo enorme"
msgstr[1] "sapos enormes"
msgstr[2] "sapos enormes"

#. ~ Description of monster "huge toad"
#: data/json/monsters/reptile_amphibian.json
msgid "This toad seems to have been mutated to absurd size by the Cataclysm."
msgstr ""

#. ~ Monster name
#: data/json/monsters/reptile_amphibian.json
#: data/mods/Tamable_Wildlife/reptile_amphibian.json
msgid "giant toad"
msgid_plural "giant toads"
msgstr[0] "sapo gigante"
msgstr[1] "sapos gigantes"
msgstr[2] "sapos gigantes"

#. ~ Description of monster "giant toad"
#: data/json/monsters/reptile_amphibian.json
msgid ""
"This toad has grown bigger than a human.  It looks uninterested in eating "
"you but you better not give it a chance."
msgstr ""

#. ~ Monster name
#: data/json/monsters/robofac_robots.json
msgid "prototype laser turret"
msgid_plural "prototype laser turrets"
msgstr[0] "prototipo de torreta laser"
msgstr[1] "prototipos de torreta laser"
msgstr[2] "prototipos de torreta laser"

#. ~ Description of monster "prototype laser turret"
#: data/json/monsters/robofac_robots.json
msgid ""
"This appears to be a very experimental automated tower.  Lacking armor "
"plating and seemingly half-built, it's little more than an oversized laser "
"emitter and a camera, both welded to a swiveling platform."
msgstr ""
"Esta parece ser una torre automatizada muy experimental. Sin placas y "
"aparentemente a medio construir, es poco más que un emisor láser de gran "
"tamaño y una cámara, ambos soldados a una plataforma giratoria."

#. ~ Monster name
#: data/json/monsters/robofac_robots.json
msgid "Hub 01 camspy"
msgid_plural "Hub 01 camspies"
msgstr[0] "cámara espía Hub 01"
msgstr[1] "cámaras espías Hub 01"
msgstr[2] "cámaras espías Hub 01"

#. ~ Description of monster "Hub 01 camspy"
#: data/json/monsters/robofac_robots.json
msgid ""
"A white and brown quadcopter drone mounting what looks to be a camera dome "
"and a large antenna array.  It calmly hovers a comfortable distance above "
"the ground, surveilling its surroundings with cold indifference."
msgstr ""
"Un dron cuadricóptero de color blanco y marrón que monta lo que parece ser "
"una cúpula con cámara y un gran conjunto de antenas. Se sitúa tranquilamente"
" a una cómoda distancia del suelo, vigilando su entorno con fría "
"indiferencia."

#. ~ Monster name
#: data/json/monsters/rodentkin.json
msgid "big rat"
msgid_plural "big rats"
msgstr[0] "gran rata"
msgstr[1] "grandes ratas"
msgstr[2] "grandes ratas"

#. ~ Description of monster "big rat"
#: data/json/monsters/rodentkin.json
msgid ""
"This cat-sized rat snuffles along the ground looking for things to eat.  It "
"hisses at anything that comes near it, baring sizable teeth."
msgstr ""
"Esta rata del tamaño de un gato se pasea por el suelo en busca de objetos "
"para comer.  Sisea a todo lo que se le acerca mostrando sus grandes dientes."

#. ~ Monster name
#: data/json/monsters/rodentkin.json
msgid "zap rattigan"
msgid_plural "zap rattigans"
msgstr[0] "rata descarga"
msgstr[1] "ratas descarga"
msgstr[2] "ratas descarga"

#. ~ Description of monster "zap rattigan"
#: data/json/monsters/rodentkin.json
msgid ""
"This cat sized albino mouse sparks randomly, whenever anything approaches "
"it."
msgstr ""
"Este ratón albino del tamaño de un gato lanza chispas al azar, cada vez que "
"algo se le acerca."

#. ~ Monster name
#: data/json/monsters/rodentkin.json
msgid "tunnel runner"
msgid_plural "tunnel runners"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "tunnel runner"
#: data/json/monsters/rodentkin.json
msgid ""
"Prior to the Cataclysm someone might have referred to this dog-sized rat as "
"a 'mass of claws and teeth,' but that could describe nearly everything you "
"meet these days.  In any case, this particular mass of claws and teeth is "
"eyeing its surroundings hungrily."
msgstr ""

#. ~ Monster name
#: data/json/monsters/rodentkin.json
msgid "pack rat"
msgid_plural "pack rats"
msgstr[0] "rata paquete"
msgstr[1] "ratas paquete"
msgstr[2] "ratas paquete"

#. ~ Description of monster "pack rat"
#: data/json/monsters/rodentkin.json
msgid ""
"This humanoid rodent stands over five feet tall, it pokes and bites at "
"anything shiny, hastily shoving anything of interest into its mouth."
msgstr ""

#. ~ Monster name
#: data/json/monsters/rodentkin.json
msgid "Mouse of NEMA"
msgid_plural "Mice of NEMA"
msgstr[0] "Ratón de NEMA"
msgstr[1] "Ratones de NEMA"
msgstr[2] "Ratones de NEMA"

#. ~ Description of monster "Mouse of NEMA"
#: data/json/monsters/rodentkin.json
msgid ""
"This albino, humanoid mouse walks on its hind legs.  You can see eddies of "
"wind swirl unnaturally around it as it moves, debris caught in its wake."
msgstr ""

#. ~ Monster name
#: data/json/monsters/rodentkin.json
msgid "mausketeer"
msgid_plural "mausketeers"
msgstr[0] "mosquerata"
msgstr[1] "mosqueratas"
msgstr[2] "mosqueratas"

#. ~ Description of monster "mausketeer"
#: data/json/monsters/rodentkin.json
msgid ""
"This humanoid rat seems to be inexplicably dressed for a renfaire in an "
"imitation of Ancien Régime light cavalry, complete with a sword."
msgstr ""

#. ~ Description of monster "slime"
#: data/json/monsters/slimes.json
msgid ""
"A black blob of viscous goo, oozing across the ground like a glob of living "
"oil."
msgstr ""
"Es un monstruo masa amorfa gelatinosa negro y viscoso, que se desliza por el"
" suelo chorreando como si fuera una gota de aceite viviente."

#. ~ Monster name
#: data/json/monsters/slimes.json
msgid "brain slime"
msgid_plural "brain slimes"
msgstr[0] "légamo cerebral"
msgstr[1] "légamos cerebrales"
msgstr[2] "légamos cerebrales"

#. ~ Description of monster "brain slime"
#: data/json/monsters/slimes.json
msgid ""
"A gigantic black blob of viscous goo, oozing across the ground like a glob "
"of living oil.  Other slimes seem to swarm around it."
msgstr ""
"Un gigantesco glóbulo negro de sustancia viscosa, rezumando a través del "
"suelo como un globo de aceite vivo. Otros légamos parecen pulular a su "
"alrededor."

#. ~ Monster name
#: data/json/monsters/slimes.json
msgid "big slime"
msgid_plural "big slimes"
msgstr[0] "légamo grande"
msgstr[1] "légamos grandes"
msgstr[2] "légamos grandes"

#. ~ Description of monster "big slime"
#: data/json/monsters/slimes.json
msgid ""
"A large black blob of viscous goo, oozing across the ground like a glob of "
"living oil."
msgstr ""
"Es un gran monstruo masa amorfa gelatinosa negro y viscoso, que se desliza "
"por el suelo chorreando como si fuera una gota de aceite viviente."

#. ~ Monster name
#: data/json/monsters/slimes.json
msgid "small slime"
msgid_plural "small slimes"
msgstr[0] "légamo pequeño"
msgstr[1] "légamos pequeños"
msgstr[2] "légamos pequeños"

#. ~ Description of monster "small slime"
#: data/json/monsters/slimes.json
msgid ""
"A small black blob of viscous goo, oozing across the ground like a glob of "
"living oil."
msgstr ""
"Es un pequeño monstruo masa amorfa gelatinosa negro y viscoso, que se "
"desliza por el suelo chorreando como si fuera una gota de aceite viviente."

#. ~ Death message of monster "small slime"
#. ~ Death message of monster "tadpole constrictor"
#: data/json/monsters/slimes.json data/json/monsters/zed_misc.json
#, c-format
msgid "The %s's body melts away."
msgstr "El cuerpo de %s se derrite."

#. ~ Monster name
#: data/json/monsters/slimes.json
msgid "amoebic mold"
msgid_plural "amoebic molds"
msgstr[0] "moho amebiano"
msgstr[1] "mohos amebianos"
msgstr[2] "mohos amebianos"

#. ~ Description of monster "amoebic mold"
#: data/json/monsters/slimes.json
msgid ""
"A formless slime mold the size of a cow.  Crusty bits of cytoplasm fall away"
" as it oozes across the ground."
msgstr ""
"Un légamo mucilaginoso sin forma, del tamaño de una vaca. Le caen pedacitos "
"crujientes de citoplasma mientras va goteando por el suelo."

#. ~ Monster name
#: data/json/monsters/slimes.json
msgid "slime microbian"
msgid_plural "slime microbians"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "slime microbian"
#: data/json/monsters/slimes.json
msgid "A small wriggling slime, a first line of defense for the colony."
msgstr ""

#. ~ Death message of monster "slime microbian"
#. ~ Death message of monster "slime ocularium"
#. ~ Death message of monster "bilious soldier zombie"
#. ~ Death message of monster "caustic soldier zombie"
#: data/json/monsters/slimes.json data/json/monsters/zed_soldiers.json
#, c-format
msgid "The %s's body dissolves into acid."
msgstr "El cuerpo del %s se disuelve en el ácido."

#. ~ Monster name
#: data/json/monsters/slimes.json
msgid "slime ocularium"
msgid_plural "slime oculariums"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "slime ocularium"
#: data/json/monsters/slimes.json
msgid ""
"A spire of hardened slime, coated in rotating eyespots and glistening ocular"
" nerves."
msgstr ""

#. ~ Monster name
#: data/json/monsters/starers.json
msgid "starer"
msgid_plural "starers"
msgstr[0] "mirador fijo"
msgstr[1] "miradores fijos"
msgstr[2] "miradores fijos"

#. ~ Description of monster "starer"
#. ~ Description of monster "mon_starer_crowbar"
#. ~ Description of monster "mon_starer_axe"
#: data/json/monsters/starers.json
msgid ""
"A horribly burned human, reeking of charred meat.  Their flesh has mended "
"into a leathery shell, and the pupils of their wide-open eyes are dilated "
"and the iris and sclera are bloodshot.  Somehow they still breathe, in deep,"
" ragged gulps."
msgstr ""
"Un humano horriblemente quemado, que apesta a carne carbonizada. Su carne se"
" ha convertido en una cáscara correosa, las pupilas de sus ojos bien "
"abiertos están dilatadas y el iris y la esclerótica están inyectados en "
"sangre. De alguna manera, todavía respira, en profundos jadeos."

#. ~ Description of special attack of monster "starer"
#: data/json/monsters/starers.json
msgid "The starer throws a rock!"
msgstr "¡El mirador fijo lanza una piedra!"

#. ~ Monster name
#: data/json/monsters/triffid.json
msgid "biollante sprig"
msgid_plural "biollante sprigs"
msgstr[0] "ramita biollante"
msgstr[1] "ramitas biollante"
msgstr[2] "ramitas biollante"

#. ~ Description of monster "biollante sprig"
#: data/json/monsters/triffid.json
msgid "A short, fat stalk with broad leaves and tiny flower buds."
msgstr ""
"Un tallo corto y gordo con hojas anchas y pequeños capullos de flores."

#. ~ Monster name
#: data/json/monsters/triffid.json
msgid "biollante sprout"
msgid_plural "biollante sprouts"
msgstr[0] "brote biollante"
msgstr[1] "brotes biollante"
msgstr[2] "brotes biollante"

#. ~ Description of monster "biollante sprout"
#: data/json/monsters/triffid.json
msgid ""
"A thick stalk that rises five feet from the ground, with heavy, broad leaves"
" at its base.  Purple flower buds adorn the top."
msgstr ""
"Un grueso tallo que se eleva a metro y medio del suelo con hojas anchas y "
"pesadas en su base. Los capullos de flores púrpuras adornan su parte "
"superior."

#. ~ Monster name
#: data/json/monsters/triffid.json
msgid "biollante"
msgid_plural "biollantes"
msgstr[0] "biollante"
msgstr[1] "biollantes"
msgstr[2] "biollantes"

#. ~ Description of monster "biollante"
#: data/json/monsters/triffid.json
msgid ""
"A drooped, quivering plant with a thick stalk adorned by a purple flower.  "
"Its petals are closed, and pulsate ominously."
msgstr ""
"Una planta de ramas colgantes con un tallo grueso adornado con una flor "
"púrpura. Sus pétalos están cerrados, y palpitan ominosamente."

#. ~ Monster name
#: data/json/monsters/triffid.json
msgid "creeper hub"
msgid_plural "creeper hubs"
msgstr[0] "enredadera central"
msgstr[1] "enredaderas centrales"
msgstr[2] "enredaderas centrales"

#. ~ Description of monster "creeper hub"
#: data/json/monsters/triffid.json
msgid ""
"A thick stalk, rooted to the ground.  It rapidly sprouts thorny vines in all"
" directions."
msgstr ""
"Un tallo grueso enraizado al suelo. Rápidamente, puede hacer brotar "
"enredaderas espinosas en todas las direcciones."

#. ~ Monster name
#: data/json/monsters/triffid.json
msgid "creeper vine"
msgid_plural "creeper vines"
msgstr[0] "enredadera brotada"
msgstr[1] "enredaderas brotadas"
msgstr[2] "enredaderas brotadas"

#. ~ Description of monster "creeper vine"
#: data/json/monsters/triffid.json
msgid "A thorny vine, twisting wildly as it grows with incredible speed."
msgstr ""
"Una enredadera espinosa, que se retuerce salvajemente mientras crece a una "
"velocidad increíble."

#. ~ Monster name
#: data/json/monsters/triffid.json
msgid "triffid sprig"
msgid_plural "triffid sprigs"
msgstr[0] "ramita de trífido"
msgstr[1] "ramitas de trífido"
msgstr[2] "ramitas de trífido"

#. ~ Description of monster "triffid sprig"
#: data/json/monsters/triffid.json
msgid ""
"A teeny-tiny triffid that has recently germinated.  Like a house cat, you "
"know it wants to eat you but it just can't figure out how."
msgstr ""
"Un trífido diminuto que ha germinado recientemente. Como un gato doméstico, "
"sabes que quiere comerte, pero no sabe cómo hacerlo."

#. ~ Monster name
#: data/json/monsters/triffid.json
msgid "triffid sprout"
msgid_plural "triffid sprouts"
msgstr[0] "brote de trífido"
msgstr[1] "brotes de trífido"
msgstr[2] "brotes de trífido"

#. ~ Description of monster "triffid sprout"
#: data/json/monsters/triffid.json
msgid ""
"A small triffid, only a few feet tall.  It has not yet developed bark, but "
"its sting is still sharp and deadly."
msgstr ""
"Un pequeño trífido de menos de un metro de alto. Todavía no ha desarrollado "
"una corteza, pero su aguijón es afilado y mortal."

#. ~ Monster name
#: data/json/monsters/triffid.json
msgid "triffid"
msgid_plural "triffids"
msgstr[0] "trífido"
msgstr[1] "trífidos"
msgstr[2] "trífidos"

#. ~ Description of monster "triffid"
#: data/json/monsters/triffid.json
msgid ""
"A creeping mobile plant, as tall as a moose.  It has a single bark-covered "
"stalk supporting a flowery head with a paralyzing sting concealed within.  "
"Nature is healing."
msgstr ""

#. ~ Monster name
#: data/json/monsters/triffid.json
msgid "triffid queen"
msgid_plural "triffid queens"
msgstr[0] "trífido reina"
msgstr[1] "trífidos reina"
msgstr[2] "trífidos reina"

#. ~ Description of monster "triffid queen"
#: data/json/monsters/triffid.json
msgid ""
"A ponderous and particularly arborescent triffid.  It has enormous red "
"petals surrounded by a haze of spores, and two thick barbed vines stick out "
"from the stems like wary harpoons."
msgstr ""
"Un trífido muy pesado y particularmente arborescente. Tiene unos enormes "
"pétalos rojos y una nube de esporas lo rodea. Dos ramas enredaderas con púas"
" le salen del tallo como si fueran arpones."

#. ~ Monster name
#: data/json/monsters/triffid.json
msgid "vine beast"
msgid_plural "vine beasts"
msgstr[0] "bestia enredadera"
msgstr[1] "bestias enredaderas"
msgstr[2] "bestias enredaderas"

#. ~ Description of monster "vine beast"
#: data/json/monsters/triffid.json
msgid ""
"An animated mass of roots and vines, creeping along the ground with alarming"
" speed.  The tangle is thick enough that the center from which they grow is "
"concealed."
msgstr ""
"Una masa animada de enredaderas y raíces, que se arrastra por el suelo con "
"una velocidad alarmante. La maraña es tan gruesa que el centro del cual está"
" creciendo, queda oculto."

#. ~ Monster name
#: data/json/monsters/triffid.json
msgid "fungal fighter"
msgid_plural "fungal fighters"
msgstr[0] "guerrero fúngico"
msgstr[1] "guerreros fúngicos"
msgstr[2] "guerreros fúngicos"

#. ~ Description of monster "fungal fighter"
#: data/json/monsters/triffid.json
msgid ""
"A stout, woody plant that can dig through the ground and flick spines from "
"its branches.  The thorns carry a fungicidal compound with paralytic "
"effects."
msgstr ""
"Una planta robusta y leñosa que puede excavar en el suelo y sacar espinas de"
" sus ramas. Las espinas llevan un compuesto fungicida con efectos "
"paralizantes."

#. ~ Monster name
#: data/json/monsters/triffid.json
msgid "triffid flower"
msgid_plural "triffid flowers"
msgstr[0] "trífido flor"
msgstr[1] "trífidos flor"
msgstr[2] "trífidos flor"

#. ~ Description of monster "triffid flower"
#: data/json/monsters/triffid.json
msgid ""
"A giant plant with a thick stalk adorned by a purple flower.  Its petals are"
" open with an ominous shine in the center."
msgstr ""
"Una planta gigante con un grueso tallo adornado por una flor púrpura. Sus "
"pétalos están abiertos con un brillo ominoso en el centro."

#. ~ Monster name
#. ~ Overmap terrain name
#: data/json/monsters/triffid.json
#: data/json/overmap/overmap_terrain/overmap_terrain_triffid.json
#: data/mods/alt_map_key/overmap_terrain.json
msgid "triffid heart"
msgid_plural "triffid hearts"
msgstr[0] "trífido corazón"
msgstr[1] "trífidos corazón"
msgstr[2] "trífidos corazón"

#. ~ Description of monster "triffid heart"
#: data/json/monsters/triffid.json
msgid ""
"A knot of tubular roots, flowing with sap and beating like a heart.  Strands"
" of vascular tissue reach out to the surrounding root walls."
msgstr ""
"Un nudo de raíces tubulares, con savia fluyendo y latiendo como un corazón. "
"Las hebras de tejido vascular se estiran hacia las raíces amuralladas de "
"alrededor."

#. ~ Monster name
#: data/json/monsters/turrets.json
msgid "improvised MP5 turret"
msgid_plural "improvised MP5 turrets"
msgstr[0] "torreta MP5 improvisada"
msgstr[1] "torretas MP5 improvisadas"
msgstr[2] "torretas MP5 improvisadas"

#. ~ Description of monster "improvised MP5 turret"
#: data/json/monsters/turrets.json
msgid ""
"A 9mm MP5 attached to a motorized chassis with basic autonomous software "
"control.  There is no mechanism to reload the weapon when its magazine is "
"empty, and the fire control system is only designed for semi-automatic fire."
msgstr ""
"Un MP5 de 9mm, acoplado a un chasis motorizado con un control de software "
"autónomo básico. No hay ningún mecanismo para recargar el arma cuando su "
"cargador está vacío y el sistema de control de fuego sólo está diseñado para"
" el fuego semiautomático."

#. ~ Monster name
#: data/json/monsters/turrets.json
msgid "milspec searchlight"
msgid_plural "milspec searchlights"
msgstr[0] "foco reflector milspec"
msgstr[1] "focos reflectores milspec"
msgstr[2] "focos reflectores milspec"

#. ~ Description of monster "milspec searchlight"
#: data/json/monsters/turrets.json
msgid ""
"A pylon boasting three high-powered searchlights with automated search AI, "
"continually seeking targets."
msgstr ""
"Un pilón con tres reflectores de alta potencia con IA de búsqueda "
"automatizada, que persigue continuamente objetivos."

#. ~ Death message of monster "milspec searchlight"
#: data/json/monsters/turrets.json
msgid "As the final light is destroyed, it erupts in a blinding flare!"
msgstr ""
"¡Cuando la última luz es destruida, hace erupción un resplandor "
"enceguecedor!"

#. ~ Monster name
#: data/json/monsters/turrets.json
msgid "M2HB autonomous CROWS II"
msgid_plural "M2HB autonomous CROWS IIs"
msgstr[0] "CROWS II autónoma M2HB"
msgstr[1] "CROWS II autónomas M2HB"
msgstr[2] "CROWS II autónomas M2HB"

#. ~ Description of monster "M2HB autonomous CROWS II"
#: data/json/monsters/turrets.json
msgid ""
"A remote weapon system derived from the M153 CROWS II and enhanced with "
"autonomous operation software.  This one is fitted with a .50 caliber M2HB "
"machine gun."
msgstr ""
"Un sistema de armas a distancia derivado del M153 CROWS II y mejorado con un"
" programa de funcionamiento autónomo. Este está equipado con una "
"ametralladora M2HB calibre .50."

#. ~ Monster name
#: data/json/monsters/turrets.json
msgid "M249 autonomous CROWS II"
msgid_plural "M249 autonomous CROWS IIs"
msgstr[0] " CROWS II autónoma M249"
msgstr[1] " CROWS II autónomas M249 "
msgstr[2] " CROWS II autónomas M249 "

#. ~ Description of monster "M249 autonomous CROWS II"
#: data/json/monsters/turrets.json
msgid ""
"A remote weapon system derived from the M153 CROWS II and enhanced with "
"autonomous operation software.  This one is fitted with a 5.56 caliber M249 "
"machine gun."
msgstr ""
"Es un sistema remoto de armas derivado del M153 CROWS II y mejorado con un "
"programa de operación autónoma. Este tiene una ametralladora M249 calibre "
"5.56."

#. ~ Monster name
#: data/json/monsters/turrets.json data/mods/No_Hope/monsters.json
msgid "M240 autonomous CROWS II"
msgid_plural "M240 autonomous CROWS IIs"
msgstr[0] "CROWS II autónoma M240"
msgstr[1] "CROWS II autónomas M240"
msgstr[2] "CROWS II autónomas M240"

#. ~ Description of monster "M240 autonomous CROWS II"
#: data/json/monsters/turrets.json
msgid ""
"A remote weapon system derived from the M153 CROWS II and enhanced with "
"autonomous operation software.  This one is fitted with a 7.62 caliber M240 "
"machine gun."
msgstr ""
"Es un sistema remoto de armas derivado del M153 CROWS II y mejorado con un "
"programa de operación autónoma. Este tiene una ametralladora M240 calibre "
"7.62."

#. ~ Monster name
#: data/json/monsters/turrets.json
#: data/mods/Generic_Guns/robots/active_bots.json
msgid "riot control platform"
msgid_plural "riot control platforms"
msgstr[0] "plataforma antidisturbios"
msgstr[1] "plataformas antidisturbios"
msgstr[2] "plataformas antidisturbios"

#. ~ Description of monster "riot control platform"
#: data/json/monsters/turrets.json
msgid ""
"These TALON-derived riot control platforms were widely publicized a few "
"years before the Cataclysm as a new semi-autonomous device that could fire "
"less-lethal rounds with far more accuracy than a human, ensuring safer hits "
"against a target's limbs.  They were quickly adopted by prisons and inner-"
"city police forces, where they demonstrated that 'less lethal' does not mean"
" 'non-lethal'.  In the days before the Cataclysm, massive stockrooms of "
"these things were put into circulation.  On the bright side, although it "
"shoots autonomously, it requires a human operator to relocate, so it's not "
"mobile anymore."
msgstr ""
"Estas plataformas de control de disturbios derivadas del TALÓN fueron "
"ampliamente publicitadas unos años antes del Cataclismo como un nuevo "
"dispositivo semiautónomo que podía disparar balas menos letales con mucha "
"más precisión que un humano, asegurando impactos más seguros contra las "
"extremidades de un objetivo. Fueron rápidamente adoptados por las prisiones "
"y las fuerzas policiales del centro de la ciudad, donde demostraron que "
"\"menos letal\" no es lo mismo que \"no letal\". En los días anteriores al "
"Cataclismo, se pusieron en circulación enormes reservas de estas cosas. Por "
"el lado positivo, aunque dispara de forma autónoma, requiere de un operador "
"humano para reubicarse, por lo que ya no es tan móvil."

#. ~ Targeting sound of special attack of monster "riot control platform"
#: data/json/monsters/turrets.json
#: data/mods/Generic_Guns/robots/active_bots.json
msgid ""
"\"Universal curfew is in effect.  Please return to your home.  This unit is "
"authorized to open fire.\""
msgstr ""
"\"El toque de queda universal está en vigor. Por favor, vuelvan a sus casas."
" Esta unidad está autorizada a abrir fuego\"."

#. ~ Monster name
#: data/json/monsters/turrets.json
msgid "loudspeaker"
msgid_plural "loudspeakers"
msgstr[0] "altavoz"
msgstr[1] "altavoces"
msgstr[2] "altavoces"

#. ~ Description of monster "loudspeaker"
#: data/json/monsters/turrets.json
msgid "A high-powered loudspeaker set to loudly repeat messages on a loop."
msgstr ""
"Un altavoz de gran potencia configurado para repetir en voz alta los "
"mensajes en bucle."

#. ~ Monster name
#: data/json/monsters/turrets.json
msgid "upcycled turret"
msgid_plural "upcycled turrets"
msgstr[0] "torreta sobreciclada"
msgstr[1] "torretas sobrecicladas"
msgstr[2] "torretas sobrecicladas"

#. ~ Description of monster "upcycled turret"
#: data/json/monsters/turrets.json
msgid ""
"This hefty turret appears to be bolted together out of various scraps of "
"technology, many of them extremely foreign-looking.  It is equipped with a "
"hefty-looking machine gun."
msgstr ""
"Esta pesada torreta parece estar atornillada con varios retazos de "
"tecnología, muchos de ellos de aspecto extremadamente extraño. Está equipada"
" con una ametralladora de aspecto robusto."

#. ~ Targeting sound of special attack of monster "upcycled turret"
#: data/json/monsters/turrets.json
msgid "\"Beep.\""
msgstr "\"Bip.\""

#. ~ Monster name
#: data/json/monsters/turrets.json
msgid "custom plated turret"
msgid_plural "custom plated turrets"
msgstr[0] "torreta blindada personalizada"
msgstr[1] "torretas blindada personalizadas"
msgstr[2] "torretas blindada personalizadas"

#. ~ Description of monster "custom plated turret"
#: data/json/monsters/turrets.json
msgid ""
"A remote weapon system derived from the M153 CROWS II and enhanced with "
"autonomous operation software.  This one is fitted with a M249 and "
"reinforced with heavy plating."
msgstr ""
"Un sistema de armas a distancia derivado del M153 CROWS II y mejorado con un"
" software de funcionamiento autónomo. Este está equipado con un M249 y "
"reforzado con chapas pesadas."

#. ~ Monster name
#: data/json/monsters/utility_bot.json
msgid "eyebot"
msgid_plural "eyebots"
msgstr[0] "ojobot"
msgstr[1] "ojobots"
msgstr[2] "ojobots"

#. ~ Description of monster "eyebot"
#: data/json/monsters/utility_bot.json
msgid ""
"A quadcopter drone largely comprised of a high-resolution camera lens and a "
"speaker, this robot hovers above the ground, documenting the carnage and "
"mayhem around it.  While it is no longer able to report to a central "
"authority, it's likely that some of its automated alert systems are still "
"functional, given that the thing seems to have an operational charging "
"station somewhere."
msgstr ""
"Un dron cuatricóptero compuesto en gran parte por una lente de cámara de "
"alta resolución y un altavoz, este robot se eleva sobre el suelo, "
"documentando la carnicería y el caos a su alrededor. Aunque ya no puede "
"informar a una autoridad central, es probable que algunos de sus sistemas de"
" alerta automatizados sigan funcionando, dado que la cosa parece tener una "
"estación de carga operativa en algún lugar."

#. ~ Monster name
#: data/json/monsters/utility_bot.json
msgid "grocery bot"
msgid_plural "grocery bots"
msgstr[0] "robot de compras"
msgstr[1] "robots de compras"
msgstr[2] "robots de compras"

#. ~ Description of monster "grocery bot"
#: data/json/monsters/utility_bot.json
msgid ""
"A popular product from Uncanny, this friendly android can carry your bag or "
"push your grocery cart for you.  You know it's friendly because its human-"
"esque face is constantly smiling at you.  According to the ads, it uses a "
"state-machine of a complexity never seen before.  Uncanny even hired "
"professional actors to record its lines.  Examine to befriend."
msgstr ""

#. ~ Monster name
#: data/json/monsters/utility_bot.json
msgid "busted grocery bot"
msgid_plural "busted grocery bots"
msgstr[0] "robot de compras averiado"
msgstr[1] "robots de compras averiados"
msgstr[2] "robots de compras averiados"

#. ~ Description of monster "busted grocery bot"
#: data/json/monsters/utility_bot.json
msgid ""
"A busted grocery bot, it can still carry your bag but its arms are too "
"damaged to push a grocery cart.  Despite its current state, it's still "
"smiling at you.  Examine to befriend."
msgstr ""
"Un robot de supermercado roto, todavía puede llevar tu bolsa pero sus brazos"
" están demasiado dañados para empujar un carrito de supermercado. A pesar de"
" su estado actual, todavía te sonríe. Examina para ser su amigo."

#. ~ Monster name
#: data/json/monsters/utility_bot.json
msgid "cleaner bot"
msgid_plural "cleaner bots"
msgstr[0] "robot de limpieza"
msgstr[1] "robots de limpieza"
msgstr[2] "robots de limpieza"

#. ~ Description of monster "cleaner bot"
#: data/json/monsters/utility_bot.json
msgid ""
"The Ford Sanitron, a utility robot designed for cleaning up waste material "
"in hazardous conditions."
msgstr ""
"El Ford Sanitron, un robot utilitario diseñado para limpiar el material de "
"desperdicio en condiciones peligrosas."

#. ~ Monster name
#: data/json/monsters/utility_bot.json
msgid "miner bot"
msgid_plural "miner bots"
msgstr[0] "robot anti-minas"
msgstr[1] "robots anti-minas"
msgstr[2] "robots anti-minas"

#. ~ Description of monster "miner bot"
#: data/json/monsters/utility_bot.json
msgid ""
"A snake-like, segmented robot built to tunnel into the ground and detonate "
"landmines."
msgstr ""
"Similar a una serpiente, este robot segmentado fue construido para cavar "
"túneles en el suelo y detonar minas terrestres."

#. ~ Monster name
#: data/json/monsters/utility_bot.json
msgid "nurse bot"
msgid_plural "nurse bots"
msgstr[0] "robot de enfermería"
msgstr[1] "robots de enfermería"
msgstr[2] "robots de enfermería"

#. ~ Description of monster "nurse bot"
#: data/json/monsters/utility_bot.json
msgid ""
"The first product from Uncanny, a towering four-armed humanoid with a gentle"
" face.  The details of its visage are striking, but the stiffness of it "
"makes you really uncomfortable.  The end of the world did not stop it from "
"looking for patients to assist."
msgstr ""
"El primer producto de Asombroso, un humanoide de cuatro brazos con una cara "
"amable. Los detalles de su rostro son sorprendentes, pero la rigidez del "
"mismo lo hace realmente incómodo. El fin del mundo no le impidió buscar "
"pacientes a los que asistir."

#. ~ Monster name
#: data/json/monsters/yrax.json
msgid "Yrax trifacet"
msgid_plural "Yrax trifacets"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "Yrax trifacet"
#: data/json/monsters/yrax.json
msgid ""
"Three dual leg modules join with each lower vertex of a pyramidal body, in a"
" abstract configuration that vaguely recalls an alien arthropod.  Devoid of "
"any exterior signs that betray its artificial origin, it looks like it could"
" fold itself into a perfectly featureless quartz pyramid.  It crawls with a "
"gait like none you've seen before, its minute movements too fast for your "
"eyes to track."
msgstr ""
"Tres módulos de doble pata se unen con cada vértice inferior de un cuerpo "
"piramidal, en una configuración abstracta que recuerda vagamente a un "
"artrópodo alienígena. Desprovisto de cualquier signo exterior que delate su "
"origen artificial, parece que podría plegarse en una pirámide de cuarzo sin "
"rasgos. Se arrastra con una marcha como ninguna que hayas visto antes, sus "
"diminutos movimientos son demasiado rápidos para que tus ojos puedan "
"seguirlos."

#. ~ Targeting sound of special attack of monster "Yrax trifacet"
#: data/json/monsters/yrax.json
msgid "a fast sequence of clicking tones."
msgstr "una rápida secuencia de clicks tonales."

#. ~ Monster name
#: data/json/monsters/yrax.json
msgid "Yrax apeirohedra"
msgid_plural "Yrax apeirohedras"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "Yrax apeirohedra"
#: data/json/monsters/yrax.json
msgid ""
"Its uncountable surfaces flow against each other in a dazzling sea of gold."
msgstr ""

#. ~ Death message of monster "Yrax apeirohedra"
#: data/json/monsters/yrax.json
#, c-format
msgid "The %s folds away."
msgstr ""

#. ~ Monster name
#: data/json/monsters/zanimal_upgrade.json
msgid "skeletal dog"
msgid_plural "skeletal dogs"
msgstr[0] "perro esquelético"
msgstr[1] "perros esqueléticos"
msgstr[2] "perros esqueléticos"

#. ~ Description of monster "skeletal dog"
#: data/json/monsters/zanimal_upgrade.json
msgid ""
"This undead canine has shed all of its skin, revealing a carapace of fused "
"bones and ribs.  This walking suit of bone seems to be controlled by a net "
"of veins and sinews which pulse with glistening black goo."
msgstr ""
"Este canino no muerto ha perdido toda su piel, revelando un caparazón de "
"huesos y costillas fusionados. Este traje de huesos que camina parece estar "
"controlado por una red de venas y tendones que palpitan con una brillante "
"sustancia viscosa negra."

#. ~ Monster name
#: data/json/monsters/zanimal_upgrade.json
msgid "barghest"
msgid_plural "barghests"
msgstr[0] "barghest"
msgstr[1] "barghests"
msgstr[2] "barghests"

#. ~ Description of monster "barghest"
#: data/json/monsters/zanimal_upgrade.json
msgid ""
"A huge swollen zombie dog, smeared black with slime.  Its teeth have grown "
"longer, and its broad back ripples with muscles and oozing wounds."
msgstr ""
"Un enorme perro zombi hinchado, cubierto de baba negra. Sus dientes son más "
"largos y su amplio lomo está ondulado con músculos y heridas supurantes."

#. ~ Monster name
#: data/json/monsters/zanimal_upgrade.json
msgid "hulking horror"
msgid_plural "hulking horrors"
msgstr[0] "horror mole"
msgstr[1] "horrores mole"
msgstr[2] "horrores mole"

#. ~ Description of monster "hulking horror"
#: data/json/monsters/zanimal_upgrade.json
msgid ""
"What may once have been a dog is now a grotesquely swollen monstrosity, "
"standing on four limbs as wide as trash cans and showing massive, jagged "
"teeth."
msgstr ""
"Lo que antes podía ser un perro es ahora una monstruosidad grotescamente "
"hinchada, que se sostiene sobre cuatro extremidades tan anchas como cubos de"
" basura y muestra unos dientes enormes y dentados."

#. ~ Monster name
#: data/json/monsters/zanimal_upgrade.json
msgid "boneplate wolf"
msgid_plural "boneplate wolves"
msgstr[0] "lobo de placas de hueso"
msgstr[1] "lobos de placas de hueso"
msgstr[2] "lobos de placas de hueso"

#. ~ Description of monster "boneplate wolf"
#: data/json/monsters/zanimal_upgrade.json
msgid ""
"A four-legged creature covered in fused bony plates, shaped somewhat like a "
"dog or wolf.  Joints and cracks across its body ooze with black goo."
msgstr ""
"Una criatura de cuatro patas cubierta de placas óseas fusionadas, con forma "
"de perro o lobo. Las articulaciones y grietas de su cuerpo rezuman una "
"sustancia viscosa negra."

#. ~ Monster name
#: data/json/monsters/zanimal_upgrade.json
msgid "skull pig"
msgid_plural "skull pigs"
msgstr[0] "cerdo calavera"
msgstr[1] "cerdos calavera"
msgstr[2] "cerdos calavera"

#. ~ Description of monster "skull pig"
#: data/json/monsters/zanimal_upgrade.json
msgid ""
"This undead boar appears to have been a truly massive specimen in life.  "
"Stretching eight to nine feet in length, the most arresting feature of this "
"animal is that the enamel of its tusks has spread across its face, leaving a"
" skull-like appearance with deep-set eye holes."
msgstr ""
"Este jabalí no muerto parece haber sido un espécimen realmente enorme en "
"vida. Con una longitud de entre dos y tres metros, el rasgo más llamativo de"
" este animal es que el esmalte de sus colmillos se ha extendido por su cara,"
" dejando un aspecto similar al de un cráneo con profundos agujeros para los "
"ojos."

#. ~ Monster name
#: data/json/monsters/zanimal_upgrade.json
msgid "trench pig"
msgid_plural "trench pigs"
msgstr[0] "cerdo de trinchera"
msgstr[1] "cerdos de trinchera"
msgstr[2] "cerdos de trinchera"

#. ~ Description of monster "trench pig"
#: data/json/monsters/zanimal_upgrade.json
msgid ""
"Billowing clouds of yellowish gas precede a boar-shaped shadow.  Glimpses of"
" a zombified boar are quickly obscured by the gases spewing forth from the "
"open wounds on its body."
msgstr ""
"Nubes de gas amarillento preceden a una sombra con forma de jabalí. Los "
"gases que brotan de las heridas abiertas en su cuerpo ocultan rápidamente la"
" imagen de un jabalí zombificado."

#. ~ Death message of monster "trench pig"
#. ~ Death message of monster "smoldering stallion"
#. ~ Death message of monster "snotgobbler"
#. ~ Death message of monster "smoker zombie"
#. ~ Death message of monster "ashen brawler"
#. ~ Death message of monster "Smoky bear"
#. ~ Death message of monster "stray rockfeeder"
#. ~ Death message of monster "stray crystaltender"
#. ~ Death message of monster "crystal mass hive"
#. ~ Death message of monster "electric demon"
#: data/json/monsters/zanimal_upgrade.json
#: data/json/monsters/zed_children.json data/json/monsters/zed_misc.json
#: data/mods/CrazyCataclysm/crazy_monsters.json
#: data/mods/Dark-Skies-Above/monsters/strays.json
#: data/mods/Magiclysm/monsters/monsters.json
#, c-format
msgid "A %s explode!"
msgstr "¡%s explota!"

#. ~ Monster name
#: data/json/monsters/zanimal_upgrade.json
msgid "skeletal wolf"
msgid_plural "skeletal wolves"
msgstr[0] "lobo esqueleto"
msgstr[1] "lobos esqueletos"
msgstr[2] "lobos esqueletos"

#. ~ Description of monster "skeletal wolf"
#: data/json/monsters/zanimal_upgrade.json
msgid ""
"This undead canine has shed all of its skin, revealing a carapace of fused "
"bones and ribs.  Devoid entirely of flesh, this walking suit of bone seems "
"to be controlled by a net of veins and sinews which pulse with glistening "
"black goo."
msgstr ""
"Este canino no muerto se ha despojado de toda su piel, revelando un "
"caparazón de huesos y costillas fusionados. Desprovisto por completo de "
"carne, este traje de huesos parece estar controlado por una red de venas y "
"tendones que laten con una brillante sustancia viscosa negra."

#. ~ Monster name
#: data/json/monsters/zanimal_upgrade.json
msgid "spearcat hunter"
msgid_plural "spearcat hunters"
msgstr[0] "cazador de lanzagato"
msgstr[1] "cazadores de lanzagato"
msgstr[2] "cazadores de lanzagato"

#. ~ Description of monster "spearcat hunter"
#: data/json/monsters/zanimal_upgrade.json
msgid ""
"This undead cougar's eyes ooze with dark, oily fluid, and its fur is torn, "
"revealing deep, festering wounds.  Its claws and teeth are unnaturally long,"
" and sharpened into dangerous looking spikes"
msgstr ""
"Los ojos de este puma no muerto rezuman un líquido oscuro y aceitoso, y su "
"pelaje está desgarrado, revelando profundas heridas purulentas. Sus garras y"
" dientes son anormalmente largos y están afilados en forma de peligrosos "
"pinchos."

#. ~ Monster name
#: data/json/monsters/zanimal_upgrade.json
msgid "skeletal zombear"
msgid_plural "skeletal zombears"
msgstr[0] "zomboso esqueletico"
msgstr[1] "zombosos esqueleticos"
msgstr[2] "zombosos esqueleticos"

#. ~ Description of monster "skeletal zombear"
#: data/json/monsters/zanimal_upgrade.json
msgid ""
"A monstrous overgrowth of ossified tissue has replaced this zombear's "
"rotting skin with an organic armor of dense bone.  Large clumps of black goo"
" seep from its joints as it shambles aimlessly, with sickening crackling "
"sounds filling the surrounding air."
msgstr ""
"Un monstruoso crecimiento excesivo de tejido osificado ha sustituido la piel"
" podrida de este zomboso por una armadura orgánica de hueso denso. De sus "
"articulaciones se desprenden grandes masas de sustancia viscosa negra "
"mientras se tambalea sin rumbo fijo, con sonidos crepitantes que llenan el "
"aire circundante."

#. ~ Monster name
#: data/json/monsters/zanimal_upgrade.json
msgid "shadowcat"
msgid_plural "shadowcats"
msgstr[0] "sombragato"
msgstr[1] "sombragatos"
msgstr[2] "sombragatos"

#. ~ Description of monster "shadowcat"
#: data/json/monsters/zanimal_upgrade.json
msgid ""
"An uncanny shadow envelops this creature, as if light itself were too "
"repulsed to touch it.  All you can make out is the outline of a large, "
"shambling cat."
msgstr ""
"Una extraña sombra envuelve a esta criatura, como si la propia luz le "
"repugnara tocarla. Lo único que se puede distinguir es la silueta de un gran"
" gato que se tambalea."

#. ~ Monster name
#: data/json/monsters/zanimal_upgrade.json
msgid "acidic zombear"
msgid_plural "acidic zombears"
msgstr[0] "zomboso acido"
msgstr[1] "zombosos acidos"
msgstr[2] "zombosos acidos"

#. ~ Description of monster "acidic zombear"
#: data/json/monsters/zanimal_upgrade.json
msgid ""
"A sickly-looking zombear with patchy fur.  Its skin looks especially thin, "
"with a sticky, yellow fluid flowing through the clearly visible veins."
msgstr ""
"Un zomboso de aspecto enfermizo y con el pelaje parcheado. Su piel parece "
"especialmente fina, con un fluido amarillo y pegajoso que fluye por las "
"venas claramente visibles."

#. ~ Monster name
#: data/json/monsters/zanimal_upgrade.json
msgid "pestilent prancer"
msgid_plural "pestilent prancers"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "pestilent prancer"
#: data/json/monsters/zanimal_upgrade.json
msgid ""
"The abdomen of this once majestic horse has grown rotund to the point you "
"can see through the skin, at the reservoir of caustic bile inside.  Its neck"
" is equally enlarged as well as slightly longer than normal."
msgstr ""

#. ~ Monster name
#: data/json/monsters/zanimal_upgrade.json
msgid "sinewy warhorse"
msgid_plural "sinewy warhorses"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "sinewy warhorse"
#: data/json/monsters/zanimal_upgrade.json
msgid ""
"A zombified horse without skin, its overgrown, bloody musculature clear for "
"all to see.  Some muscles occasionally tear from their tendons as it barrels"
" towards its target, flailing around like a loose hose before weaving back "
"into place."
msgstr ""

#. ~ Monster name
#: data/json/monsters/zanimal_upgrade.json
msgid "smoldering stallion"
msgid_plural "smoldering stallions"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "smoldering stallion"
#: data/json/monsters/zanimal_upgrade.json
msgid ""
"This undead horse has a charred hide as black as soot, the underside of "
"which is littered with gashes and holes.  Pillars of choking black smoke "
"pour from the wounds, smothering everything that draws near."
msgstr ""

#. ~ Monster name
#: data/json/monsters/zanimal_upgrade.json
msgid "pale charger"
msgid_plural "pale chargers"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "pale charger"
#: data/json/monsters/zanimal_upgrade.json
msgid ""
"with plates of asymmetrical bone tissue overlapping its body, this ignoble "
"steed needs no rider for you to fear its approach.  Completing its ghoulish "
"look is an overgrown skull which, judging by the flattened and battered "
"forehead, has become its main weapon."
msgstr ""

#. ~ Monster name
#: data/json/monsters/zanimal_upgrade.json
msgid "antlered hammer"
msgid_plural "antlered hammers"
msgstr[0] "martillo astado"
msgstr[1] "martillos astados"
msgstr[2] "martillos astados"

#. ~ Description of monster "antlered hammer"
#: data/json/monsters/zanimal_upgrade.json
msgid ""
"This once-great moose's eyes ooze with dark, oily fluid, and its flesh is "
"torn and scarred.  Its entire body bulges with distended muscles and "
"swollen, festering wounds."
msgstr ""
"Los ojos de este antiguo alce rezuman un líquido oscuro y aceitoso, y su "
"carne está desgarrada y llena de cicatrices. Todo su cuerpo abulta con "
"músculos distendidos y heridas hinchadas y supurantes."

#. ~ Monster name
#: data/json/monsters/zanimal_upgrade.json
msgid "thorny moose shambler"
msgid_plural "thorny moose shamblers"
msgstr[0] "alce desastre espinoso"
msgstr[1] "alces desastre espinosos"
msgstr[2] "alces desastre espinosos"

#. ~ Description of monster "thorny moose shambler"
#: data/json/monsters/zanimal_upgrade.json
msgid ""
"This once-great moose is covered with long, matted hair twisted with thorny "
"vines that wrap together and then twist back into its body.  Long, "
"interlocking thorns wrap its antlers, dripping with a silvery liquid."
msgstr ""
"Lo que una vez fue un gran alce está ahora cubierto de un pelo largo y "
"enmarañado, retorcido por vides espinosas que se enrollan y luego se "
"retuercen en el cuerpo. Largas espinas entrelazadas envuelven la cornamenta,"
" que gotea un misterioso líquido plateado."

#. ~ Monster name
#: data/json/monsters/zed-animal.json
msgid "jawed terror"
msgid_plural "jawed terrors"
msgstr[0] "terror dentado"
msgstr[1] "terrores dentados"
msgstr[2] "terrores dentados"

#. ~ Description of monster "jawed terror"
#: data/json/monsters/zed-animal.json
msgid ""
"Once a normally-aggressive, normally-hungry bull shark, this undead terror "
"is now even more aggressive and more hungry, possibly thanks to its lack of "
"a functioning brain."
msgstr ""
"Este terror no muerto, que antes era un tiburón toro normalmente agresivo y "
"hambriento, es ahora aún más agresivo y hambriento, posiblemente gracias a "
"su falta de cerebro funcional."

#. ~ Monster name
#: data/json/monsters/zed-animal.json
msgid "zombie dog"
msgid_plural "zombie dogs"
msgstr[0] "perro zombi"
msgstr[1] "perros zombis"
msgstr[2] "perros zombis"

#. ~ Description of monster "zombie dog"
#: data/json/monsters/zed-animal.json
msgid ""
"The deformed, animated corpse of a canine; a sinewy beast which can easily "
"outpace its two-legged friends."
msgstr ""
"El cadáver deformado y animado de un canino; una bestia sinuosa que puede "
"superar fácilmente a sus amigos de dos patas."

#. ~ Monster name
#: data/json/monsters/zed-animal.json
msgid "Z-9"
msgid_plural "Z-9s"
msgstr[0] "Z-9"
msgstr[1] "Z-9s"
msgstr[2] "Z-9s"

#. ~ Description of monster "Z-9"
#: data/json/monsters/zed-animal.json
msgid ""
"A zombified version of one of the German Shepherd dogs used in law "
"enforcement.  Its deformed body is encased in a protective Kevlar harness."
msgstr ""
"Una versión zombificada de uno de los perros pastor alemán utilizados por "
"las fuerzas del orden. Su cuerpo deformado está envuelto en un arnés "
"protector de Kevlar."

#. ~ Monster name
#: data/json/monsters/zed-animal.json
msgid "rot-weiler"
msgid_plural "rot-weilers"
msgstr[0] "rot-weiler"
msgstr[1] "rot-weilers"
msgstr[2] "rot-weilers"

#. ~ Description of monster "rot-weiler"
#: data/json/monsters/zed-animal.json
msgid ""
"An acrid smell accompanies this animated canine corpse.  Its whole body is "
"covered in chains of pulsing cysts and slime-dribbling ulcers."
msgstr ""
"Un olor acre acompaña a este cadáver canino animado. Todo su cuerpo está "
"cubierto de cadenas de quistes pulsantes y úlceras que gotean baba."

#. ~ Monster name
#: data/json/monsters/zed-animal.json
msgid "grim howler"
msgid_plural "grim howlers"
msgstr[0] "aullador sombrío"
msgstr[1] "aulladores sombríos"
msgstr[2] "aulladores sombríos"

#. ~ Description of monster "grim howler"
#: data/json/monsters/zed-animal.json
msgid ""
"A zombified wolf.  Its mouth oozes with a black substance, coating its "
"vicious-looking white fangs."
msgstr ""
"Un lobo zombificado. Su boca rezuma una sustancia negra que recubre sus "
"colmillos blancos de aspecto feroz."

#. ~ Monster name
#: data/json/monsters/zed-animal.json
msgid "zombear"
msgid_plural "zombears"
msgstr[0] "oso zombi"
msgstr[1] "osos zombis"
msgstr[2] "osos zombis"

#. ~ Description of monster "zombear"
#: data/json/monsters/zed-animal.json
msgid ""
"This black bear's eyes ooze with dark, oily fluid, and its flesh is torn and"
" scarred.  It shuffles as it walks."
msgstr ""
"Los ojos de este oso negro rezuman un líquido oscuro y aceitoso, y su carne "
"está desgarrada y cicatrizada. Se arrastra mientras camina."

#. ~ Monster name
#: data/json/monsters/zed-animal.json
msgid "festering boar"
msgid_plural "festering boars"
msgstr[0] "jabalí podrido"
msgstr[1] "jabalís podridos"
msgstr[2] "jabalís podridos"

#. ~ Description of monster "festering boar"
#: data/json/monsters/zed-animal.json
msgid ""
"A zombified omnivore descended from the wild boar.  Now it's got black goo "
"all over it, instead of mud."
msgstr ""
"Un omnívoro zombificado descendiente del jabalí salvaje. Ahora tiene una "
"viscosidad negra que lo cubre completamente, en lugar de barro."

#. ~ Monster name
#: data/json/monsters/zed-animal.json
msgid "zombeaver"
msgid_plural "zombeavers"
msgstr[0] "castorombi"
msgstr[1] "castorombis"
msgstr[2] "castorombis"

#. ~ Description of monster "zombeaver"
#: data/json/monsters/zed-animal.json
msgid ""
"This wall-eyed beast has a large wound on its side, its gore-stained ribs "
"clearly visible.  Its most prominent features are the fearsome incisors "
"dribbling thick, black goo from inside its mouth.  It doesn't look "
"interested in chewing on trees anymore."
msgstr ""
"Esta bestia con ojos de pared tiene una gran herida en el costado, con las "
"costillas manchadas de sangre claramente visibles. Sus rasgos más "
"prominentes son los temibles incisivos de los que gotea una gruesa y negra "
"sustancia viscosa desde el interior de su boca. Ya no parece interesado en "
"masticar árboles."

#. ~ Monster name
#: data/json/monsters/zed-animal.json
msgid "antlered horror"
msgid_plural "antlered horrors"
msgstr[0] "horror con cuernos"
msgstr[1] "horrores con cuernos"
msgstr[2] "horrores con cuernos"

#. ~ Description of monster "antlered horror"
#: data/json/monsters/zed-animal.json
msgid ""
"This formerly-majestic moose has succumbed to the infection that is killing "
"the world.  Shiny green blowflies swarm the vast, suppurated patches of "
"purulent flesh where its skin has sloughed away, and its remaining fur is "
"black and matted with necrotic discharge."
msgstr ""
"Este alce, antes majestuoso, ha sucumbido a la infección que está matando al"
" mundo. Brillantes moscardones verdes pululan por las vastas manchas "
"supurantes de carne purulenta en las que se ha desprendido la piel, y el "
"pelaje que le queda está negro y enmarañado con secreciones necróticas."

#. ~ Monster name
#: data/json/monsters/zed-animal.json
msgid "decayed pouncer"
msgid_plural "decayed pouncers"
msgstr[0] "saltador putrefacto"
msgstr[1] "saltadores putrefactos"
msgstr[2] "saltadores putrefactos"

#. ~ Description of monster "decayed pouncer"
#: data/json/monsters/zed-animal.json
msgid ""
"A normal-looking cougar, except that its hind legs are swollen, and its eyes"
" bulge with black goo."
msgstr ""
"Podría parecer un puma normal si no fuera que sus patas traseras están "
"agrandadas, y sus ojos resaltan con una viscosidad negra."

#. ~ Monster name
#: data/json/monsters/zed-animal.json
msgid "zombie horse"
msgid_plural "zombie horses"
msgstr[0] "caballo zombi"
msgstr[1] "caballos zombi"
msgstr[2] "caballos zombi"

#. ~ Description of monster "zombie horse"
#: data/json/monsters/zed-animal.json
msgid ""
"From the deteriorated state of this undead horse's ghastly features--"
"protruding ribs, off-white skull, and decayed, tattered muscles--it doesn't "
"seem like it should put up much of a fight, but something deep inside gives "
"it power.  Black, reeking ichor drips from its wounds."
msgstr ""
"A juzgar por el estado de deterioro de los rasgos espantosos de este caballo"
" no muerto -costillas sobresalientes, cráneo blanquecino y músculos "
"carcomidos y destrozados-, no parece que vaya a oponer mucha resistencia, "
"pero algo en su interior le da poder. De sus heridas gotea un icor negro y "
"apestoso."

#. ~ Monster name
#: data/json/monsters/zed-animal.json
msgid "tiger wight"
msgid_plural "tiger wights"
msgstr[0] "tigrombi"
msgstr[1] "tigrombis"
msgstr[2] "tigrombis"

#. ~ Description of monster "tiger wight"
#: data/json/monsters/zed-animal.json
msgid ""
"This tiger stumbles and sways, its jaws slack, its eyes wide open and "
"shining black."
msgstr ""
"Este tigre se tambalea y se tropieza, con su mandíbula floja y los ojos muy "
"abiertos de un negro brillante."

#. ~ Monster name
#: data/json/monsters/zed-animal.json
msgid "zombie cow"
msgid_plural "zombie cows"
msgstr[0] "vaca zombi"
msgstr[1] "vacas zombi"
msgstr[2] "vacas zombi"

#. ~ Description of monster "zombie cow"
#: data/json/monsters/zed-animal.json
msgid ""
"Once a placid cow, this leathery horror stumbles and shudders, its pulsing "
"black eyes scanning for prey.  Dairy cows have no natural weapons, but a "
"zombie as big, heavy, and murderous as this is still extremely dangerous."
msgstr ""
"Este horror curtido, que antes era una plácida vaca, se tambalea y se "
"estremece, sus ojos negros pulsantes escudriñan en busca de una presa. Las "
"vacas lecheras no tienen armas naturales, pero un zombi tan grande, pesado y"
" asesino como éste sigue siendo extremadamente peligroso."

#. ~ Monster name
#: data/json/monsters/zed-animal.json
msgid "zombull"
msgid_plural "zombulls"
msgstr[0] "zomtoro"
msgstr[1] "zomtoros"
msgstr[2] "zomtoros"

#. ~ Description of monster "zombull"
#: data/json/monsters/zed-animal.json
msgid ""
"This enormous, terrifyingly fast creature with oily black eyes and dreadful "
"horns was once a domestic bull.  While live bulls can be temperamental, "
"unbridled rage is now this one's only emotion."
msgstr ""
"Esta enorme y aterradora criatura de ojos negros y aceitosos cuernos fue una"
" vez un toro doméstico. Aunque los toros vivos pueden ser temperamentales, "
"la rabia desenfrenada es ahora su única emoción."

#. ~ Monster name
#: data/json/monsters/zed-animal.json
msgid "vicious vicuña"
msgid_plural "vicious vicuña"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "vicious vicuña"
#: data/json/monsters/zed-animal.json
msgid ""
"This llama oozes a dark oil from a multitude of lesions and cuts.  Its wool "
"has sloughed off with parts of its skin, revealing pulsating muscles and "
"flesh.  Its mouth drips with a sickly green substance which it seems to be "
"chewing on."
msgstr ""

#. ~ Description of special attack of monster "vicious vicuña"
#: data/json/monsters/zed-animal.json
msgid "The vicious vicuña spits a glob of acid!"
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed-animal.json
msgid "woodland wight"
msgid_plural "woodland wights"
msgstr[0] "criatura del bosque"
msgstr[1] "criaturas del bosque"
msgstr[2] "criaturas del bosque"

#. ~ Description of monster "woodland wight"
#: data/json/monsters/zed-animal.json
msgid ""
"A pale, stumbling, white-tailed deer, rivulets of slime running down its "
"neck.  Its limbs twist and bend in unnatural, haphazard directions, and yet "
"it moves with uncanny strength and speed.  Thanks to the Cataclysm, it has "
"now turned the tables; what was once prey, now itself preys on coyotes, "
"wolves, and giant spider mutants."
msgstr ""
"Un ciervo de cola blanca, pálido y tambaleante, con riachuelos de baba "
"corriendo por su cuello. Sus miembros se retuercen y doblan en direcciones "
"antinaturales y desordenadas, pero se mueve con una fuerza y una velocidad "
"asombrosas. Gracias al Cataclismo, ahora ha cambiado las tornas; lo que "
"antes era una presa, ahora depreda coyotes, lobos y arañas gigantes "
"mutantes."

#. ~ Monster name
#: data/json/monsters/zed-animal.json
msgid "mass of zombie spiders"
msgid_plural "masses of zombie spiders"
msgstr[0] "masa de arañas zombi"
msgstr[1] "masas de arañas zombi"
msgstr[2] "masas de arañas zombi"

#. ~ Description of monster "mass of zombie spiders"
#: data/json/monsters/zed-animal.json
msgid ""
"Thousands, maybe millions of spiders piled up high, each slowly oozing "
"sticky green pus, struggling to keep the fetid mass together and moving."
msgstr ""
"Miles, tal vez millones de arañas amontonadas en lo alto, cada una rezumando"
" lentamente pus verde y pegajoso, luchando por mantener la masa fétida unida"
" y en movimiento."

#. ~ Monster name
#: data/json/monsters/zed-animal.json
msgid "zeindeer"
msgid_plural "zeindeers"
msgstr[0] "zreno"
msgstr[1] "zrenos"
msgstr[2] "zrenos"

#. ~ Description of monster "zeindeer"
#: data/json/monsters/zed-animal.json
msgid ""
"Once a majestic caribou, this undead creature barely resembles Santa's "
"helpful reindeer and seems to only be interested in human flesh."
msgstr ""
"Esta criatura no muerta, que en su día fue un majestuoso caribú, apenas se "
"parece al útil reno de Santa Claus y parece que sólo le interesa la carne "
"humana."

#. ~ Monster name
#: data/json/monsters/zed-animal.json
msgid "gastro bufo"
msgid_plural "gastro bufos"
msgstr[0] "gastro bufo"
msgstr[1] "gastro bufos"
msgstr[2] "gastro bufos"

#. ~ Description of monster "gastro bufo"
#: data/json/monsters/zed-animal.json
msgid ""
"A massive toad stumbling around while leaking acid from its skin.  Doesn't "
"look friendly at all."
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed-classic.json
msgid "scarred zombie"
msgid_plural "scarred zombies"
msgstr[0] "zombi cicatrizado"
msgstr[1] "zombis cicatrizados"
msgstr[2] "zombis cicatrizados"

#. ~ Description of monster "scarred zombie"
#: data/json/monsters/zed-classic.json
msgid ""
"A deformed human body, its skin transformed into one thick, calloused "
"envelope of scar tissue."
msgstr ""
"Un cuerpo humano deformado, su piel transformada en una gruesa y callosa "
"envoltura de tejido cicatrizante."

#. ~ Monster name
#. ~ Snippet in category "<zombie>"
#: data/json/monsters/zed-classic.json data/json/npcs/talk_tags.json
msgid "zombie"
msgid_plural "zombies"
msgstr[0] "zombi"
msgstr[1] "zombis"
msgstr[2] "zombis"

#. ~ Description of monster "zombie"
#: data/json/monsters/zed-classic.json
msgid ""
"A human body, swaying as it moves, an unstoppable rage visible in its oily "
"black eyes."
msgstr ""
"Es un cuerpo humano que se arrastra para moverse, y con una ira incontenible"
" en sus aceitosos ojos negros."

#. ~ Monster name
#: data/json/monsters/zed-classic.json
msgid "zombie cop"
msgid_plural "zombie cops"
msgstr[0] "zombi policía"
msgstr[1] "zombis policías"
msgstr[2] "zombis policías"

#. ~ Description of monster "zombie cop"
#: data/json/monsters/zed-classic.json
msgid ""
"A human body covered by a weather-beaten and badly damaged set of police "
"gear."
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed-classic.json
msgid "crawling zombie"
msgid_plural "crawling zombies"
msgstr[0] "zombi arrastrador"
msgstr[1] "zombis arrastradores"
msgstr[2] "zombis arrastradores"

#. ~ Description of monster "crawling zombie"
#: data/json/monsters/zed-classic.json
msgid ""
"This human corpse drags itself along slowly with its arms.  Its legs are "
"damaged beyond repair."
msgstr ""
"Este cadáver humano se va arrastrando lentamente con sus brazos. Sus piernas"
" están demasiado dañadas para caminar."

#. ~ Monster name
#: data/json/monsters/zed-classic.json
msgid "zombie dancer"
msgid_plural "zombie dancers"
msgstr[0] "zombi bailarín"
msgstr[1] "zombis bailarines"
msgstr[2] "zombis bailarines"

#. ~ Description of monster "zombie dancer"
#: data/json/monsters/zed-classic.json
msgid ""
"The foulest stench is in the air,\n"
"The funk of forty thousand years,\n"
"And grisly ghouls from every tomb,\n"
"Are closing in to seal your doom!\n"
"\n"
"The dancer doesn't even notice you, it seems like something nearby is controlling it."
msgstr ""
"The foulest stench is in the air,\n"
"The funk of forty thousand years,\n"
"And grisly ghouls from every tomb,\n"
"Are closing in to seal your doom!\n"
"(Canción \"Thriller\" de Michael Jackson).\n"
"El bailarín ni siquiera se da cuenta de ti, parece que algo cercano lo está controlando."

#. ~ Monster name
#: data/json/monsters/zed-classic.json
msgid "fat zombie"
msgid_plural "fat zombies"
msgstr[0] "zombi gordo"
msgstr[1] "zombis gordos"
msgstr[2] "zombis gordos"

#. ~ Description of monster "fat zombie"
#: data/json/monsters/zed-classic.json
msgid ""
"Stumbling as it moves, this corpse of an overweight human regards its "
"surroundings with an empty black gaze."
msgstr ""
"Va tropezando mientras se mueve, este cadáver de un humano con sobrepeso "
"observa sus alrededores con una mirada negra y vacía."

#. ~ Monster name
#: data/json/monsters/zed-classic.json
msgid "firefighter zombie"
msgid_plural "firefighter zombies"
msgstr[0] "zombi bombero"
msgstr[1] "zombis bomberos"
msgstr[2] "zombis bomberos"

#. ~ Description of monster "firefighter zombie"
#: data/json/monsters/zed-classic.json
msgid ""
"A decaying human body clad in tattered firefighting gear.  It staggers "
"aimlessly, reeking of smoke and decay.  Its protective mask prevents it from"
" attempting to bite you."
msgstr ""
"Un cuerpo humano en descomposición vestido con un equipo de bomberos hecho "
"jirones. Se tambalea sin rumbo, apestando a humo y podredumbre. Su máscara "
"protectora le impide intentar morderte"

#. ~ Monster name
#: data/json/monsters/zed-classic.json
msgid "hazmat zombie"
msgid_plural "hazmat zombies"
msgstr[0] "zombi con materiales peligrosos"
msgstr[1] "zombis con materiales peligrosos"
msgstr[2] "zombis con materiales peligrosos"

#. ~ Description of monster "hazmat zombie"
#: data/json/monsters/zed-classic.json
msgid ""
"This zombie is completely encased in a protective suit that apparently "
"failed to protect it from whatever this infection is.  At least it can't "
"bite you from inside that suit."
msgstr ""
"Este zombi está completamente enfundado en un traje protector que "
"aparentemente no lo protegió de lo que sea esta infección. Al menos no puede"
" morderte desde dentro de ese traje."

#. ~ Sentence fragment describing a weakpoint for monster "hazmat zombie"
#: data/json/monsters/zed-classic.json
msgid "a tear in its hazmat suit"
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed-classic.json
msgid "decayed zombie"
msgid_plural "decayed zombies"
msgstr[0] "zombi descompuesto"
msgstr[1] "zombis descompuestos"
msgstr[2] "zombis descompuestos"

#. ~ Description of monster "decayed zombie"
#: data/json/monsters/zed-classic.json
msgid ""
"A once-dead human corpse.  Its discolored, swollen flesh is riddled with "
"festering wounds and open sores."
msgstr ""
"Un cadáver humano, una vez muerto. Su carne descolorida e hinchada está "
"plagada de heridas purulentas y llagas abiertas."

#. ~ Monster name
#: data/json/monsters/zed-classic.json
msgid "SWAT zombie"
msgid_plural "SWAT zombies"
msgstr[0] "zombi SWAT"
msgstr[1] "zombis SWAT"
msgstr[2] "zombis SWAT"

#. ~ Description of monster "SWAT zombie"
#: data/json/monsters/zed-classic.json
msgid ""
"This zombie was part of a specialized unit of law enforcement.  It still "
"wears a battered armor with the SWAT logo emblazoned on the front.  The "
"protective mask makes its head a difficult target, but also prevents it from"
" biting you."
msgstr ""
"Este zombi formaba parte de una unidad especializada de las fuerzas del "
"orden. Todavía lleva una armadura maltrecha con el logotipo del SWAT "
"estampado en la parte delantera. La máscara protectora hace que su cabeza "
"sea un objetivo difícil, pero también impide que te muerda."

#. ~ Monster name
#: data/json/monsters/zed-classic.json
msgid "tough zombie"
msgid_plural "tough zombies"
msgstr[0] "zombi fuerte"
msgstr[1] "zombis fuertes"
msgstr[2] "zombis fuertes"

#. ~ Description of monster "tough zombie"
#: data/json/monsters/zed-classic.json
msgid ""
"This was once an athletic human, now a brutal monster.  Its facial features "
"are twisted into an expression of pure rage."
msgstr ""
"Lo que alguna vez fue un humano atlético, ahora es un monstruo brutal. Sus "
"gestos faciales están torcidos en una expresión de pura ira."

#. ~ Monster name
#: data/json/monsters/zed-classic.json
msgid "sleek zombie"
msgid_plural "sleek zombies"
msgstr[0] "zombi elegante"
msgstr[1] "zombis elegantes"
msgstr[2] "zombis elegantes"

#. ~ Description of monster "sleek zombie"
#: data/json/monsters/zed-classic.json
msgid "This zombie is rather sleek and scantily clothed."
msgstr "Este zombi es bastante elegante y está excasamente vestido."

#. ~ Monster name
#: data/json/monsters/zed-classic.json
msgid "bouncer zombie"
msgid_plural "bouncer zombies"
msgstr[0] "portero de bar zombi"
msgstr[1] "porteros de bar zombis"
msgstr[2] "porteros de bar zombis"

#. ~ Description of monster "bouncer zombie"
#: data/json/monsters/zed-classic.json
msgid ""
"This muscular zombie is dressed in the tattered remnants of a security "
"uniform."
msgstr ""
"Este musculoso zombi va vestido con los restos de un uniforme de seguridad."

#. ~ Monster name
#: data/json/monsters/zed-medical.json
msgid "zombie medic"
msgid_plural "zombie medics"
msgstr[0] "medico zombi"
msgstr[1] "medicos zombi"
msgstr[2] "medicos zombi"

#. ~ Description of monster "zombie medic"
#: data/json/monsters/zed-medical.json
msgid ""
"This shambling corpse is dressed like a medical professional.  It was either"
" a doctor, or only played one on TV."
msgstr ""
"Este cadáver ambulante está vestido como un profesional de la medicina. O "
"bien era un médico o interpretaba a uno en la televisión."

#. ~ Monster name
#: data/json/monsters/zed-medical.json
msgid "medical horror"
msgid_plural "medical horrors"
msgstr[0] "horror médico"
msgstr[1] "horrores médicos"
msgstr[2] "horrores médicos"

#. ~ Description of monster "medical horror"
#: data/json/monsters/zed-medical.json
msgid ""
"A former doctor of some sort, though its uniform has been torn apart.  You "
"assume the oversized muscles that cover it to be the culprit."
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed-medical.json
msgid "miracle lurker"
msgid_plural "miracle lurkers"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "miracle lurker"
#: data/json/monsters/zed-medical.json
msgid ""
"The zombified remains of a practitioner of medicine, you aren't certain what"
" field - your focus is instead drawn to the way that its pink flesh snakes "
"all over it, weaving its way over wounds and injuries."
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed-medical.json
msgid "sawbones"
msgid_plural "sawbones"
msgstr[0] "serrahueso"
msgstr[1] "serrahuesos"
msgstr[2] "serrahuesos"

#. ~ Description of monster "sawbones"
#: data/json/monsters/zed-medical.json
msgid ""
"A malformed armor of misshapen bone has grown over this zombie, having "
"pushed what remains of the skin out of the way.  The clothes of a medical "
"worker is still draped over it."
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed-medical.json
msgid "doctor burns"
msgid_plural "doctor burns"
msgstr[0] "doctor quemado"
msgstr[1] "doctores quemados"
msgstr[2] "doctores quemados"

#. ~ Description of monster "doctor burns"
#: data/json/monsters/zed-medical.json
msgid ""
"This is the body of a doctor or nurse of some kind.  It's hard to tell now "
"that most of its clothing has corroded away from whatever vile acid its "
"secreting."
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed-pupating.json
msgid "pupating zombie crawler"
msgid_plural "pupating zombie crawlers"
msgstr[0] "reptador zombi pupante"
msgstr[1] "reptadores zombi pupante"
msgstr[2] "reptadores zombi pupante"

#. ~ Description of monster "pupating zombie crawler"
#: data/json/monsters/zed-pupating.json
msgid ""
"This half of a human corpse is wrapped in sticky black fibers that cover "
"everything from the neck down.  Beneath the wrapping there is a strange "
"rhythmic movement, grotesque to behold."
msgstr ""
"Este medio cadáver humano está envuelto en pegajosas fibras negras que lo "
"cubren todo desde el cuello hacia abajo. Bajo la envoltura hay un extraño "
"movimiento rítmico, grotesco de contemplar."

#. ~ Monster message of special attack of monster "pupating zombie crawler"
#: data/json/monsters/zed-pupating.json
msgid ""
"The pupating zombie crawler bursts, and gore-smeared winged beasts climb out"
" of the corpse!"
msgstr ""
"¡El reptador zombi pupante estalla y del cadáver salen bestias aladas "
"cubiertas de sangre!."

#. ~ Monster name
#: data/json/monsters/zed-pupating.json
msgid "pupating zombie"
msgid_plural "pupating zombies"
msgstr[0] "zombi pupante"
msgstr[1] "zombis pupante"
msgstr[2] "zombis pupante"

#. ~ Description of monster "pupating zombie"
#: data/json/monsters/zed-pupating.json
msgid ""
"This human corpse is wrapped in sticky black fibers that cover everything "
"from the neck down.  Beneath the wrapping there is a strange rhythmic "
"movement, grotesque to behold."
msgstr ""
"Este cadáver humano está envuelto en pegajosas fibras negras que lo cubren "
"todo desde el cuello hacia abajo. Bajo la envoltura hay un extraño "
"movimiento rítmico, grotesco de contemplar."

#. ~ Monster message of special attack of monster "pupating zombie"
#: data/json/monsters/zed-pupating.json
msgid ""
"The pupating zombie bursts, and gore-smeared winged beasts climb out of the "
"corpse!"
msgstr ""
"¡El zombi pupante estalla y del cadáver salen bestias aladas untadas de "
"sangre!."

#. ~ Monster name
#: data/json/monsters/zed-pupating.json
msgid "pupating brute"
msgid_plural "pupating brutes"
msgstr[0] "bestia pupante"
msgstr[1] "bestias pupantes"
msgstr[2] "bestias pupantes"

#. ~ Description of monster "pupating brute"
#: data/json/monsters/zed-pupating.json
msgid ""
"This muscular human corpse is wrapped in sticky black fibers that cover "
"everything from the neck down.  Beneath the wrapping there is a strange "
"rhythmic movement, grotesque to behold."
msgstr ""
"Este musculoso cadáver humano está envuelto en pegajosas fibras negras que "
"lo cubren todo desde el cuello hacia abajo. Bajo la envoltura hay un extraño"
" movimiento rítmico, grotesco de contemplar."

#. ~ Monster message of special attack of monster "pupating brute"
#: data/json/monsters/zed-pupating.json
msgid ""
"The pupating brute bursts, and gore-smeared winged beasts climb out of the "
"corpse!"
msgstr ""
"¡El bruto pupante estalla y del cadáver salen bestias aladas untadas de "
"sangre!"

#. ~ Monster name
#: data/json/monsters/zed-pupating.json
msgid "hive hulk"
msgid_plural "hive hulks"
msgstr[0] "mole colmena"
msgstr[1] "moles colmenas"
msgstr[2] "moles colmenas"

#. ~ Description of monster "hive hulk"
#: data/json/monsters/zed-pupating.json
msgid ""
"The bloated torso of this gigantic corpse is wrapped in sticky black fibers."
"  Beneath the wrapping there is a strange rhythmic movement, grotesque to "
"behold."
msgstr ""
"El torso hinchado de este gigantesco cadáver está envuelto en pegajosas "
"fibras negras. Bajo la envoltura hay un extraño movimiento rítmico, grotesco"
" de contemplar."

#. ~ Monster message of special attack of monster "hive hulk"
#: data/json/monsters/zed-pupating.json
msgid ""
"The hive hulk opens its mouth, and a gore-smeared winged beast flies out of "
"it!"
msgstr ""
"La mole colmena abre la boca y de ella sale volando una bestia alada "
"embadurnada de sangre."

#. ~ Monster name
#: data/json/monsters/zed-pupating.json
msgid "shady pupating zombie"
msgid_plural "shady pupating zombies"
msgstr[0] "crisálida zombi sombría"
msgstr[1] "crisálidas zombis sombrías"
msgstr[2] "crisálidas zombis sombrías"

#. ~ Description of monster "shady pupating zombie"
#: data/json/monsters/zed-pupating.json
msgid ""
"An uncanny shadow envelops this creature.  You can make out the outline of "
"what once may have been a human being, but its edges bulge rhythmically in "
"places that are not anatomically possible for humans."
msgstr ""
"Una sombra misteriosa envuelven a esta criatura. Se puede distinguir el "
"contorno de lo que alguna vez pudo ser un ser humano, pero sus bordes se "
"abultan rítmicamente en lugares que no son anatómicamente posibles para los "
"humanos"

#. ~ Monster message of special attack of monster "shady pupating zombie"
#: data/json/monsters/zed-pupating.json
msgid ""
"The pupating zombie bursts, and shadowy winged beasts climb out of the "
"corpse!"
msgstr ""
"¡El zombi pupante estalla y del cadáver salen bestias aladas sombrias!."

#. ~ Monster name
#: data/json/monsters/zed-winged.json
msgid "batwing zombie"
msgid_plural "batwing zombies"
msgstr[0] "zombi alas de murciélago"
msgstr[1] "zombis alas de murciélago"
msgstr[2] "zombis alas de murciélago"

#. ~ Description of monster "batwing zombie"
#: data/json/monsters/zed-winged.json
msgid ""
"This zombie's arms have stretched far beyond human limits, the skin "
"lengthened into a gruesome, fleshy membrane.  The mutation does not suit it "
"well: it moves clumsily, even compared to other zombies, but can "
"occasionally leap a significant distance."
msgstr ""
"Los brazos de este zombi se han estirado mucho más allá de los límites "
"humanos, la piel se ha alargado hasta convertirse en una espantosa membrana "
"carnosa. La mutación no le sienta bien: Se mueve con torpeza, incluso en "
"comparación con otros zombis, pero puede saltar una distancia considerable "
"ocasionalmente."

#. ~ Monster name
#: data/json/monsters/zed-winged.json
msgid "garghoul"
msgid_plural "garghouls"
msgstr[0] "garghoul"
msgstr[1] "garghouls"
msgstr[2] "garghouls"

#. ~ Description of monster "garghoul"
#: data/json/monsters/zed-winged.json
msgid ""
"This zombie's arms have stretched far beyond human limits, the skin "
"lengthened into a gruesome, fleshy membrane.  The rest has become emaciated,"
" with thin, rope-like muscles ripping through taut flesh.  While it doesn't "
"appear to be able to fly, it uses its mutated arms to make shockingly fast "
"leaps through the air."
msgstr ""
"Los brazos de este zombi se han estirado mucho más allá de los límites "
"humanos, la piel se ha alargado hasta convertirse en una espantosa membrana "
"carnosa. El resto se ha vuelto escuálido, con finos músculos en forma de "
"sogas que atraviesan la carne tensa. Aunque no parece ser capaz de volar de "
"verdad, utiliza sus brazos mutados para dar saltos sorprendentemente rápidos"
" por el aire."

#. ~ Monster name
#: data/json/monsters/zed-winged.json
msgid "flesh-raptor"
msgid_plural "flesh-raptors"
msgstr[0] "carnerapaz"
msgstr[1] "carnerapaces"
msgstr[2] "carnerapaces"

#. ~ Description of monster "flesh-raptor"
#: data/json/monsters/zed-winged.json
msgid ""
"This small, winged predator darts through the air on three thinly-haired "
"wings that look like stretched human hands.  A sheer, jagged spike juts out "
"from the point where the wings meet.  It looks like nothing you've seen on "
"Earth, and yet strangely like it is made of human parts."
msgstr ""
"Este pequeño depredador alado se lanza por el aire con tres alas de pelo "
"fino que parecen manos humanas estiradas. En el punto de unión de las alas "
"sobresale un pico escarpado. No se parece a nada que se haya visto en la "
"Tierra y, sin embargo, parece extrañamente estar hecho de partes humanas."

#. ~ Monster name
#: data/json/monsters/zed-winged.json
msgid "shadow raptor"
msgid_plural "shadow raptors"
msgstr[0] "sombrarapaz"
msgstr[1] "sombrarapaces"
msgstr[2] "sombrarapaces"

#. ~ Description of monster "shadow raptor"
#: data/json/monsters/zed-winged.json
msgid ""
"An uncanny shadow envelops this creature.  You can make out the outline of "
"three flapping wings connected to a jagged, pointed object."
msgstr ""
"Una sombra misteriosa envuelven a esta criatura. Se puede distinguir el "
"contorno de tres alas que baten conectadas a un objeto puntiagudo."

#. ~ Monster name
#: data/json/monsters/zed-winged.json
msgid "unstable flesh-raptor"
msgid_plural "unstable flesh-raptor"
msgstr[0] "carnerapaz inestable"
msgstr[1] "carnerapaces inestables"
msgstr[2] "carnerapaces inestables"

#. ~ Description of monster "unstable flesh-raptor"
#: data/json/monsters/zed-winged.json
msgid ""
"This small, winged predator darts through the air on three thinly-haired "
"wings that look like stretched human hands.  A jagged spike juts out from "
"the point where the wings meet, and a bloated, fleshy belly hangs beneath.  "
"A sharp smell of rotten eggs hangs around it."
msgstr ""
"Este pequeño depredador alado se lanza por el aire con tres alas de pelo "
"fino que parecen manos humanas estiradas. En el punto de unión de las alas "
"sobresale una espiga dentada y debajo cuelga un vientre hinchado y carnoso. "
"Un fuerte olor a huevos podridos le rodea."

#. ~ Monster name
#: data/json/monsters/zed-winged.json
msgid "zaptor"
msgid_plural "zaptors"
msgstr[0] "electroraptor"
msgstr[1] "electroraptores"
msgstr[2] "electroraptores"

#. ~ Description of monster "zaptor"
#: data/json/monsters/zed-winged.json
msgid ""
"This small, winged predator darts through the air on three thinly-haired "
"wings that look like stretched human hands.  A jagged spike with a pulsing "
"electrical glow juts out from the point where the wings meet."
msgstr ""
"Este pequeño depredador alado se lanza por el aire con tres alas de pelo "
"fino que parecen manos humanas estiradas. En el punto en el que se unen las "
"alas sobresale una espiga dentada con un brillo eléctrico pulsante."

#. ~ Monster name
#: data/json/monsters/zed_acid.json
msgid "acidic zombie"
msgid_plural "acidic zombies"
msgstr[0] "zombi ácido"
msgstr[1] "zombis ácidos"
msgstr[2] "zombis ácidos"

#. ~ Description of monster "acidic zombie"
#: data/json/monsters/zed_acid.json
msgid ""
"A sickly-looking zombie.  Its skin looks especially thin, with a sticky, "
"yellow fluid flowing through the clearly visible veins."
msgstr ""
"Un zombi de apariencia enfermiza. Su piel parece especialmente delgada, con "
"un fluido pegajoso y amarillo corriéndole por sus venas claramente visibles."

#. ~ Monster name
#: data/json/monsters/zed_acid.json
msgid "corrosive zombie"
msgid_plural "corrosive zombies"
msgstr[0] "zombi corrosivo"
msgstr[1] "zombis corrosivos"
msgstr[2] "zombis corrosivos"

#. ~ Description of monster "corrosive zombie"
#: data/json/monsters/zed_acid.json
msgid ""
"This zombie has swollen to immense proportions, but still manages to hold "
"itself together with semi-congealed acid all over its bloated body.  It "
"moves clumsily, but spits from a large reserve of acid with uncanny "
"accuracy."
msgstr ""
"Este zombi se ha hinchado hasta alcanzar unas proporciones inmensas, pero "
"aún se las arregla para mantenerse unido con ácido semicongelado por todo su"
" cuerpo hinchado. Se mueve con torpeza, pero escupe de una gran reserva de "
"ácido con una precisión asombrosa."

#. ~ Description of special attack of monster "corrosive zombie"
#: data/json/monsters/zed_acid.json
msgid "The corrosive zombie spits a glob of acid!"
msgstr "¡El zombi corrosivo escupe un pegote de ácido!"

#. ~ Monster name
#: data/json/monsters/zed_acid.json
msgid "spitter zombie"
msgid_plural "spitter zombies"
msgstr[0] "zombi escupidor"
msgstr[1] "zombis escupidores"
msgstr[2] "zombis escupidores"

#. ~ Description of monster "spitter zombie"
#: data/json/monsters/zed_acid.json
msgid ""
"A hunched human body with its eyes pushed up into its forehead and drooping "
"cheeks, most of its face is occupied by a puckered mouth.  Its stomach is "
"swollen and nearly translucent, with a sickly yellow tint."
msgstr ""
"Es un cuerpo humano encorvado con los ojos apretados contra la frente y las "
"mejillas colgando, la mayor parte de su cara está ocupada por una boca "
"fruncida. Su estómago está hinchado y es casi transparente, de un tinte "
"amarillo enfermizo."

#. ~ Monster name
#: data/json/monsters/zed_acid.json
msgid "wretched puker"
msgid_plural "wretched pukers"
msgstr[0] "vomitador desgraciado"
msgstr[1] "vomitadores desgraciados"
msgstr[2] "vomitadores desgraciados"

#. ~ Description of monster "wretched puker"
#: data/json/monsters/zed_acid.json
msgid ""
"A degenerate corpse, shambling as it walks.  Various pieces of trash and "
"waste materials have melded into the black goo leaking from its skin."
msgstr ""
"Un cadáver degenerado, que se tambalea al caminar. Varios trozos de basura y"
" materiales de desecho se han fundido en la sustancia viscosa negra que "
"gotea de su piel."

#. ~ Monster name
#: data/json/monsters/zed_acid.json
msgid "acidic zombie dog"
msgid_plural "acidic zombie dogs"
msgstr[0] "perro zombi acido"
msgstr[1] "perros zombi acidos"
msgstr[2] "perros zombi acidos"

#. ~ Description of monster "acidic zombie dog"
#: data/json/monsters/zed_acid.json
msgid ""
"A deformed, sickly-looking animated corpse of a canine.  A dangerous-looking"
" yellow saliva drips from its mouth."
msgstr ""
"Un cadáver animado, deforme y de aspecto enfermizo, de un canino. De su boca"
" gotea una saliva amarilla de aspecto peligroso."

#. ~ Monster name
#: data/json/monsters/zed_acid.json
msgid "blistered horror"
msgid_plural "blistered horrors"
msgstr[0] "horror con quistes"
msgstr[1] "horrores con quistes"
msgstr[2] "horrores con quistes"

#. ~ Description of monster "blistered horror"
#: data/json/monsters/zed_acid.json
msgid ""
"A huge canine with multiple large, foul-looking blisters covering its body."
"  A corrosive liquid spills from its menacing-looking mouth."
msgstr ""
"Un enorme perro con múltiples y grandes ampollas de aspecto asqueroso que "
"cubren su cuerpo. Un líquido corrosivo brota de su boca de aspecto "
"amenazante."

#. ~ Monster name
#: data/json/monsters/zed_amalgamation.json
msgid "tiny meat cocoon"
msgid_plural "tiny meat cocoons"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "tiny meat cocoon"
#: data/json/monsters/zed_amalgamation.json
msgid ""
"A small, wet sack of pink skin, with something dog-sized moving around "
"underneath the surface.  Black roots anchor it to the ground."
msgstr ""

#. ~ Death message of monster "tiny meat cocoon"
#. ~ Death message of monster "small meat cocoon"
#. ~ Death message of monster "large meat cocoon"
#. ~ Death message of monster "gigantic meat cocoon"
#: data/json/monsters/zed_amalgamation.json
#, c-format
msgid "The %s explodes in a shower of gore!"
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed_amalgamation.json
msgid "small meat cocoon"
msgid_plural "small meat cocoons"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "small meat cocoon"
#: data/json/monsters/zed_amalgamation.json
msgid ""
"A sack of pink flesh sitting in the middle of a net of black roots.  At "
"irregular intervals it shudders as something (or multiple somethings?) "
"inside changes position.  You're not sure you want to know what's inside."
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed_amalgamation.json
msgid "large meat cocoon"
msgid_plural "large meat cocoons"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "large meat cocoon"
#: data/json/monsters/zed_amalgamation.json
msgid ""
"A mass of pink flesh the size of a fridge squirming constantly, black veins "
"anchoring it to the ground.  Occasionally a malformed limb pushes against "
"the skin from the inside, before a churn of the cocoon pushes it back.  Not "
"ready yet, it seems."
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed_amalgamation.json
msgid "gigantic meat cocoon"
msgid_plural "gigantic meat cocoons"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "gigantic meat cocoon"
#: data/json/monsters/zed_amalgamation.json
msgid ""
"A rigid, off-white lump of flesh the size of a small car constricted by "
"bands of rope-sized pulsing black veins that tie it to the floor below.  The"
" whole thing is shuddering constantly, and gives off an otherworldly stench."
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed_amalgamation.json
msgid "abstracted amalgamation"
msgid_plural "abstracted amalgamations"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Monster name
#: data/json/monsters/zed_amalgamation.json
msgid "swarming amalgamation"
msgid_plural "swarming amalgamations"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "swarming amalgamation"
#: data/json/monsters/zed_amalgamation.json
msgid ""
"An small, flat creature dashing around erratically on seven short legs.  Its"
" form is dominated by an oversized set of black mandibles on an almost "
"comically small head, featureless apart from a single, black eye.  The rest "
"of the body is covered with sickly white skin crisscrossed by black veins."
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed_amalgamation.json
msgid "vigilant amalgamation"
msgid_plural "vigilant amalgamations"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "vigilant amalgamation"
#: data/json/monsters/zed_amalgamation.json
msgid ""
"An inflated white body carried by five dainty legs, waving its remaining two"
" limbs constantly.  Each one is tipped by a head-sized compound eye, "
"independently scanning the horizon for prey."
msgstr ""

#. ~ Monster message of special attack of monster "vigilant amalgamation"
#: data/json/monsters/zed_amalgamation.json
msgid "The amalgamation screams!"
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed_amalgamation.json
msgid "caustic amalgamation"
msgid_plural "caustic amalgamations"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "caustic amalgamation"
#: data/json/monsters/zed_amalgamation.json
msgid ""
"A gangly creature running on six legs, its form made irregular by the green "
"pustules at the limbs' base, each feeding into a large vein leading to two "
"blackened claws.  What must have been a seventh leg fused with the "
"creature's head forming a jagged proboscis emerging from below its eyes, "
"dripping a caustic liquid."
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed_amalgamation.json
msgid "leaping amalgamation"
msgid_plural "leaping amalgamations"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "leaping amalgamation"
#: data/json/monsters/zed_amalgamation.json
msgid ""
"A four-legged white creature about the size of a human, running with a "
"decidedly feline gait, the three remaining limbs holding an almost-"
"translucent skin membrane outstretched on its side and rear.  Much of its "
"head is taken up by a beak like a raven's, which opens to reveal a set of "
"jagged black teeth."
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed_amalgamation.json
msgid "charged amalgamation"
msgid_plural "charged amalgamations"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "charged amalgamation"
#: data/json/monsters/zed_amalgamation.json
msgid ""
"A short, crablike creature waddling around on six multi-jointed legs, its "
"body dominated by a large glowing organ bulging from between the white armor"
" plates.  A single raised appendage connects to the mass, its tip surrounded"
" by brilliant white sparks."
msgstr ""

#. ~ Monster message of special attack of monster "charged amalgamation"
#: data/json/monsters/zed_amalgamation.json
#, c-format
msgid "A cloud of electricity explodes from the %s"
msgstr ""

#. ~ Monster message of special attack of monster "charged amalgamation"
#: data/json/monsters/zed_amalgamation.json
#, c-format
msgid "A bolt of electricity arcs from %s!"
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed_amalgamation.json
msgid "brutish amalgamation"
msgid_plural "brutish amalgamations"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "brutish amalgamation"
#: data/json/monsters/zed_amalgamation.json
msgid ""
"A large, thickly armored creature built not unlike a bear, if a bear had a "
"long, clubbed tail and two short limbs ending in black talons framing a "
"vertical mouth on an otherwise smooth, featureless head.  On second thought,"
" not that much like a bear at all."
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed_burned.json
msgid "zombie kinderling"
msgid_plural "zombie kinderlings"
msgstr[0] "zombi infantil"
msgstr[1] "zombis infantiles"
msgstr[2] "zombis infantiles"

#. ~ Description of monster "zombie kinderling"
#: data/json/monsters/zed_burned.json
msgid ""
"A tiny charred body, jumping and kicked and flailing around in a mockery of "
"playground exercise.  It does not need a face for you to feel bad about "
"killing it."
msgstr ""
"Es un pequeño cuerpo chamuscado, saltando y revolcándose en lo que parece "
"una burla al ejercicio. No necesita tener una cara para que te haga sentir "
"mal por matarlo."

#. ~ Monster name
#: data/json/monsters/zed_burned.json
msgid "fiend"
msgid_plural "fiends"
msgstr[0] "diablillo"
msgstr[1] "diablillos"
msgstr[2] "diablillos"

#. ~ Description of monster "fiend"
#: data/json/monsters/zed_burned.json
msgid ""
"A charred zombie covered with bony plates, spikes and protrusions.  Moves "
"stiffly, but swiftly."
msgstr ""
"Un zombi carbonizado cubierto de placas óseas, pinchos y protuberancias. Se "
"mueve con rigidez, pero rapidamente."

#. ~ Monster name
#: data/json/monsters/zed_burned.json
msgid "scorched zombie"
msgid_plural "scorched zombies"
msgstr[0] "zombi chamuscado"
msgstr[1] "zombis chamuscados"
msgstr[2] "zombis chamuscados"

#. ~ Description of monster "scorched zombie"
#: data/json/monsters/zed_burned.json
msgid ""
"A heavily burned zombie that still reeks of charred meat.  Its flesh has "
"mended into a leathery shell."
msgstr ""
"Un zombi muy quemado que todavía apesta a carne carbonizada. Su carne se ha "
"convertido en una cáscara de cuero."

#. ~ Monster name
#: data/json/monsters/zed_children.json
msgid "anklebiter"
msgid_plural "anklebiters"
msgstr[0] "mordedor de tobillo"
msgstr[1] "mordedores de tobillos"
msgstr[2] "mordedores de tobillos"

#. ~ Description of monster "anklebiter"
#: data/json/monsters/zed_children.json
msgid ""
"This horrifying little mutated wretch looks to have once been a child, but "
"its massive gaping jaws are now far more suggestive of a predatory beast."
msgstr ""
"Este horroroso y despreciable pequeño mutado parece haber sido un niño "
"alguna vez, pero sus inmensas mandíbulas ahora son más propias de una bestia"
" depredadora."

#. ~ Monster name
#: data/json/monsters/zed_children.json
msgid "zombie child"
msgid_plural "zombie children"
msgstr[0] "niño zombi"
msgstr[1] "niños zombis"
msgstr[2] "niños zombis"

#. ~ Description of monster "zombie child"
#: data/json/monsters/zed_children.json
msgid ""
"It was only a child, and little is different about it now aside from the "
"hungry look in its eyes.  You'd be hard-pressed to not feel like you were "
"killing an actual child by putting it down."
msgstr ""
"Era sólo un niño, y solo se diferencia ahora por la mirada hambrienta de sus"
" ojos. Sería difícil no sentir que estás matando a un niño de verdad al "
"abatirlo."

#. ~ Monster name
#: data/json/monsters/zed_children.json
msgid "creepy crawler"
msgid_plural "creepy crawlers"
msgstr[0] "reptante espeluznante"
msgstr[1] "reptantes espeluznantes"
msgstr[2] "reptantes espeluznantes"

#. ~ Description of monster "creepy crawler"
#: data/json/monsters/zed_children.json
msgid ""
"What was once a child is now a mutant beast with blackened skin and massive "
"eyes.  This abomination's vile form makes a mockery of its human origin."
msgstr ""
"Lo que alguna vez fue un niño, ahora es una bestia mutada con la piel "
"ennegrecida y ojos enormes. La vil forma de esta abominación se burla de sus"
" orígenes humanos."

#. ~ Monster name
#: data/json/monsters/zed_children.json
msgid "shriekling"
msgid_plural "shrieklings"
msgstr[0] "chillido"
msgstr[1] "chillidos"
msgstr[2] "chillidos"

#. ~ Description of monster "shriekling"
#: data/json/monsters/zed_children.json
msgid ""
"This heavily mutated child zombie twitches and flails its limbs in painful-"
"looking spasms as it runs about."
msgstr ""
"Este zombi niño ha sufrido varias mutaciones, retuerce y sacude sus miembros"
" con espasmos dolorosos mientras va corriendo."

#. ~ Monster name
#: data/json/monsters/zed_children.json
msgid "snotgobbler"
msgid_plural "snotgobblers"
msgstr[0] "mocoso"
msgstr[1] "mocosos"
msgstr[2] "mocosos"

#. ~ Description of monster "snotgobbler"
#: data/json/monsters/zed_children.json
msgid ""
"This swollen, gooey-looking mutant child looks bad, even for a zombie.  "
"Maybe that's why it seems to want a hug so badly."
msgstr ""
"Este niño mutante, hinchado y viscoso parece estar en mal estado... incluso "
"para un zombi. Quizás sea por eso que parece necesitar tanto un abrazo."

#. ~ Monster name
#: data/json/monsters/zed_children.json
msgid "sproglodyte"
msgid_plural "sproglodytes"
msgstr[0] "proleglodita"
msgstr[1] "prolegloditas"
msgstr[2] "prolegloditas"

#. ~ Description of monster "sproglodyte"
#: data/json/monsters/zed_children.json
msgid ""
"This crouching child-mutant's face is dominated by a pair of huge black "
"eyes, and its fingertips end in sharp claws."
msgstr ""
"La cara de este niño mutante encorvado está dominada por un par de ojos "
"negros enormes, y sus dedos terminan en unas garras afiladas."

#. ~ Monster name
#: data/json/monsters/zed_children.json
msgid "howling waif"
msgid_plural "howling waifs"
msgstr[0] "niño aullador"
msgstr[1] "niños aulladores"
msgstr[2] "niños aulladores"

#. ~ Description of monster "howling waif"
#: data/json/monsters/zed_children.json
msgid ""
"Undeath has not been kind to the children of the apocalypse.  This one is "
"little more than a reanimated membrane of skin stretched across tiny brittle"
" bones."
msgstr ""
"Esta muerte viviente no ha sido nada generosa con los niños del apocalipsis."
" Este es poco más que una membrana de piel reanimada estirada por los "
"pequeños y frágiles huesos."

#. ~ Monster name
#: data/json/monsters/zed_children.json
msgid "swollen wretch"
msgid_plural "swollen wretches"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "swollen wretch"
#: data/json/monsters/zed_children.json
msgid ""
"The hideously deformed corpse of what, you hesitate to guess, was once "
"either a mere child or adolescent.  Its skin has detached from its skeletal "
"and muscular structure and has overgrown into a malformed fleshy chrysalis "
"containing its rotting innards, with a faint glow emanating from within the "
"creature’s swollen body as various lighter than air decomposing gasses are "
"created and burned in a chain reaction.  This has caused its flesh, like a "
"nightmarish balloon, to distend to obscene proportions, causing its "
"overtaxed skin to become translucent and for the abomination to hover a few "
"feet off the floor at any given moment.  All of the orifices in its head "
"have sealed over into a transparent membrane, save for its narrow slit of a "
"maw, from which a stream of noxious gas escapes; seemingly allowing the "
"monstrosity to regulate its buoyancy.  From within its immensely swollen "
"body, you can just make out faint shadowy forms moving about."
msgstr ""

#. ~ Monster message of special attack of monster "swollen wretch"
#: data/json/monsters/zed_children.json
msgid ""
"With a high-pitched shriek, the bloated wretch bursts, and gore-smeared "
"winged beasts climb out of the corpse!"
msgstr ""
"¡Con un chillido agudo, el infeliz hinchado estalla y unas bestias aladas "
"untadas de sangre salen del cadáver!"

#. ~ Monster name
#: data/json/monsters/zed_command.json
msgid "skeletal master"
msgid_plural "skeletal masters"
msgstr[0] "maestro esquelético"
msgstr[1] "maestros esqueléticos"
msgstr[2] "maestros esqueléticos"

#. ~ Description of monster "skeletal master"
#: data/json/monsters/zed_command.json
msgid ""
"A strange zombie covered in bone plates from face to toe.  Despite the added"
" weight on its body its movements are coordinated, almost as if capable of "
"analyzing your movements."
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed_command.json
msgid "zombie lich"
msgid_plural "zombie liches"
msgstr[0] "liche zombi"
msgstr[1] "liches zombi"
msgstr[2] "liches zombi"

#. ~ Description of monster "zombie lich"
#: data/json/monsters/zed_command.json
msgid ""
"A twisted visage of the human body decked in bone from head to toe.  Its "
"vague shape reminiscent of some tabletop monster, it walks and watches your "
"actions with a cold and calculating demeanor."
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed_electric.json data/mods/Aftershock/mobs/zombies.json
msgid "shocker brute"
msgid_plural "shocker brutes"
msgstr[0] "bestia eléctrica"
msgstr[1] "bestias eléctricas"
msgstr[2] "bestias eléctricas"

#. ~ Description of monster "shocker brute"
#: data/json/monsters/zed_electric.json
msgid ""
"A huge beast covered in visible scarring from what you can only guess was "
"'research'.  Being near it, you can hear a slight humming, like that of an "
"electrical transformer."
msgstr ""
"Una enorme bestia cubierto de cicatrices de lo que puedes imaginar como "
"resultado de 'investigaciones'. Al estar cerca de él, puedes sentir un suave"
" zumbido, como el que hace un transformador eléctrico."

#. ~ Monster name
#: data/json/monsters/zed_electric.json data/mods/Aftershock/mobs/zombies.json
#: data/mods/CrazyCataclysm/crazy_monsters.json
msgid "shocker zombie"
msgid_plural "shocker zombies"
msgstr[0] "zombi lanzarayos"
msgstr[1] "zombis lanzarayos"
msgstr[2] "zombis lanzarayos"

#. ~ Description of monster "shocker zombie"
#: data/json/monsters/zed_electric.json
msgid "A human body with pale blue flesh, crackling with electrical energy."
msgstr ""
"Es un cuerpo humano con la piel de color azul pálido, y chisporroteando de "
"energía eléctrica."

#. ~ Monster name
#: data/json/monsters/zed_electric.json data/mods/Aftershock/mobs/zombies.json
msgid "incandescent husk"
msgid_plural "incandescent husks"
msgstr[0] "cáscara incandescente"
msgstr[1] "cáscaras incandescentes"
msgstr[2] "cáscaras incandescentes"

#. ~ Description of monster "incandescent husk"
#: data/json/monsters/zed_electric.json
msgid ""
"This zombie is visible only as a glowing white silhouette that you have to "
"squint to see, cloaked in a crackling field of lightning that pulses like a "
"beating heart.  It walks slowly and deliberately, the thunderstorm "
"surrounding it eagerly jumping to anything conductive within its grasp."
msgstr ""
"Este zombi es visible sólo como una silueta blanca y brillante que hay que "
"entrecerrar los ojos para ver, cubierta por un campo de rayos que late como "
"un corazón que late. Camina lenta y deliberadamente, la tormenta eléctrica "
"que lo rodea salta ansiosamente a cualquier cosa conductora a su alcance."

#. ~ Monster name
#: data/json/monsters/zed_electric.json
msgid "zapper zombie"
msgid_plural "zapper zombies"
msgstr[0] "zombi electríficado"
msgstr[1] "zombis electríficados"
msgstr[2] "zombis electríficados"

#. ~ Description of monster "zapper zombie"
#: data/json/monsters/zed_electric.json
msgid ""
"A very pale dead body with the worst case of static hair you have ever seen."
"  Sparks of electricity frequently jump off it, lighting it up in the dark."
"  You might not want to touch it with your bare hands, or anything "
"conductive."
msgstr ""
"Un cadáver muy pálido con el peor caso de pelo estático que jamás hayas "
"visto. De él saltan frecuentemente chispas de electricidad que lo iluminan "
"en la oscuridad. Es posible que no quieras tocarlo con las manos desnudas, o"
" con cualquier cosa conductora."

#. ~ Monster name
#: data/json/monsters/zed_explosive.json
msgid "boomer"
msgid_plural "boomers"
msgstr[0] "boomer"
msgstr[1] "boomers"
msgstr[2] "boomers"

#. ~ Description of monster "boomer"
#: data/json/monsters/zed_explosive.json
msgid ""
"A rotund human body, bloated beyond belief and layered in rolls of fat.  It "
"emits a horrible odor, and a putrid pink sludge dribbles from its mouth."
msgstr ""
"Es un cuerpo humano gordo, hinchado más allá de lo posible y cubierto con "
"rollos de grasa. Emite un olor horrible y de su boca gotea un pútrido cieno "
"rosa."

#. ~ Monster name
#: data/json/monsters/zed_explosive.json
msgid "huge boomer"
msgid_plural "huge boomers"
msgstr[0] "boomer enorme"
msgstr[1] "boomers enormes"
msgstr[2] "boomers enormes"

#. ~ Description of monster "huge boomer"
#: data/json/monsters/zed_explosive.json
msgid ""
"This boomer, normally swollen and ready to burst, has strengthened and "
"solidified.  The bile dribbling from its mouth also appears to have changed…"
msgstr ""
"Este boomer, normalmente hinchado y listo para explotar, se ha fortalecido y"
" solidificado. La bilis que gotea de su boca también parece haber "
"cambiado..."

#. ~ Monster name
#: data/json/monsters/zed_explosive.json
msgid "gasoline zombie"
msgid_plural "gasoline zombies"
msgstr[0] "zombi de gasolina"
msgstr[1] "zombis de gasolina"
msgstr[2] "zombis de gasolina"

#. ~ Description of monster "gasoline zombie"
#: data/json/monsters/zed_explosive.json
msgid ""
"A huge, bloated zombie that appears to have consumed gasoline; fumes and "
"flames escape from its mouth and liquid fuel leaks from its waddling form."
msgstr ""
"Un enorme zombi hinchado que parece haber consumido gasolina; de su boca "
"escapan humos y llamas y de su figura contoneante se escapa combustible "
"líquido."

#. ~ Monster name
#: data/json/monsters/zed_explosive.json
msgid "bloated zombie"
msgid_plural "bloated zombies"
msgstr[0] "zombi hinchado"
msgstr[1] "zombis hinchados"
msgstr[2] "zombis hinchados"

#. ~ Description of monster "bloated zombie"
#: data/json/monsters/zed_explosive.json
msgid ""
"With its gray skin swollen to near-rupture with putrid gas, this cyst-"
"covered zombie looks like it could violently burst under the slightest of "
"disturbances."
msgstr ""
"Con su piel gris hinchada con gas putrefacto hasta casi romperse, este zombi"
" cubierto de quistes parece como si pudiera explotar violentamente ante la "
"menor perturbación."

#. ~ Monster name
#: data/json/monsters/zed_explosive.json
msgid "sleepwalker zombie"
msgid_plural "sleepwalker zombies"
msgstr[0] "zombi sonámbulo"
msgstr[1] "zombis sonámbulos"
msgstr[2] "zombis sonámbulos"

#. ~ Description of monster "sleepwalker zombie"
#: data/json/monsters/zed_explosive.json
msgid ""
"A zombie swollen with a bluish, oddly sweet smelling gas.  It stumbles "
"around even more than regular zombies, as if heavily intoxicated."
msgstr ""
"Un zombi hinchado con un gas azulado y de extraño olor dulce. Se tambalea "
"aún más que los zombis normales, como si estuviera muy intoxicado."

#. ~ Monster name
#: data/json/monsters/zed_explosive.json
msgid "swollen tearjerker"
msgid_plural "swollen tearjerkers"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "swollen tearjerker"
#: data/json/monsters/zed_explosive.json
msgid ""
"A bloated corpse, its ballooning skin blistered and rashy and its face caked"
" in mucus.  The off-colour orange gas that occasionally leaks from it makes "
"your eyes water and smells faintly of pepper."
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed_explosive.json
msgid "boomer glutton"
msgid_plural "boomer gluttons"
msgstr[0] "glotón boomer"
msgstr[1] "glotones boomer"
msgstr[2] "glotones boomer"

#. ~ Description of monster "boomer glutton"
#: data/json/monsters/zed_explosive.json
msgid ""
"A large, grotesque ball of flesh and fat.  Seemingly vestigial limbs flop "
"around haphazardly as it rolls across the ground.  You occasionally catch a "
"glimpse of bulging eyes and a distended gaping maw oozing some sort of black"
" sludge."
msgstr ""
"Una gran y grotesca bola de carne y grasa. Sus miembros, aparentemente "
"vestigiales, se mueven al azar mientras rueda por el suelo. De vez en cuando"
" ves unos ojos saltones y unas fauces distendidas que rezuman una especie de"
" cieno negro."

#. ~ Monster message of special attack of monster "boomer glutton"
#: data/json/monsters/zed_explosive.json
msgid "The glutton vomits sludge!"
msgstr "¡El glotón vomita cieno!"

#. ~ Monster name
#: data/json/monsters/zed_explosive.json
msgid "bombardier boomer"
msgid_plural "bombardier boomers"
msgstr[0] "boomer bombardero"
msgstr[1] "boomers bombarderos"
msgstr[2] "boomers bombarderos"

#. ~ Description of monster "bombardier boomer"
#: data/json/monsters/zed_explosive.json
msgid ""
"This zombie's exposed ribcage is encircled by swollen lungs and other "
"organs.  You would prefer to be far away when they burst."
msgstr ""
"La caja torácica expuesta de este zombi está rodeada de pulmones hinchados y"
" otros órganos. Preferiría estar lejos cuando estallen."

#. ~ Monster message of special attack of monster "bombardier boomer"
#: data/json/monsters/zed_explosive.json
msgid "A bombardier boomer explodes!"
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed_ferrous.json
msgid "rust zombie"
msgid_plural "rust zombies"
msgstr[0] "zombi oxidado"
msgstr[1] "zombis oxidados"
msgstr[2] "zombis oxidados"

#. ~ Description of monster "rust zombie"
#: data/json/monsters/zed_ferrous.json
msgid ""
"A zombie impaled with a multitude of metal fragments, each covered with a "
"thick layer of rust that seems to propagate to other parts of its body.  You"
" can't remember the last time you got a tetanus shot, so it would be best "
"not to let this thing touch you."
msgstr ""
"Un zombi empalado con una multitud de fragmentos de metal, cada uno cubierto"
" con una gruesa capa de óxido que parece propagarse a otras partes de su "
"cuerpo. No recuerdañ la última vez que te vacunastes contra el tétanos, así "
"que sería mejor no dejar que esta cosa te toque."

#. ~ Monster name
#: data/json/monsters/zed_ferrous.json
msgid "rust shell zombie"
msgid_plural "rust shell zombies"
msgstr[0] "zombi cascara oxidado"
msgstr[1] "zombis cascara oxidado"
msgstr[2] "zombis cascara oxidado"

#. ~ Description of monster "rust shell zombie"
#: data/json/monsters/zed_ferrous.json
msgid ""
"Jagged fragments of rust-bitten metal have fused into this zombie's flesh "
"and displaced parts of its spine."
msgstr ""
"Fragmentos irregulares de metal oxidado se han fundido en la carne de este "
"zombi y han desplazado partes de su columna vertebral."

#. ~ Monster name
#: data/json/monsters/zed_ferrous.json
msgid "rust plated zombie"
msgid_plural "rust plated zombies"
msgstr[0] "zombi de placas oxidada"
msgstr[1] "zombis de placas oxidada"
msgstr[2] "zombis de placas oxidada"

#. ~ Description of monster "rust plated zombie"
#: data/json/monsters/zed_ferrous.json
msgid ""
"Ruptures in this zombie's skin expose fragments of metal arranged like armor"
" underneath.  Black sludge can be seen in places where the rust has receded."
msgstr ""
"Las roturas en la piel de este zombi dejan al descubierto fragmentos de "
"metal dispuestos como una armadura por debajo. Se puede ver cieno negro en "
"los lugares donde el óxido ha retrocedido."

#. ~ Monster name
#: data/json/monsters/zed_ferrous.json
msgid "rust urchin"
msgid_plural "rust urchins"
msgstr[0] "erizo oxidado"
msgstr[1] "erizos oxidados"
msgstr[2] "erizos oxidados"

#. ~ Description of monster "rust urchin"
#: data/json/monsters/zed_ferrous.json
msgid ""
"A spiked horror of a zombie covered in long, rusty spikes.  A walking "
"tetanus infection waiting to happen."
msgstr ""
"Un horror de zombi cubierto de largas y oxidadas púas. Una infección de "
"tétanos andante a punto de ocurrir."

#. ~ Monster name
#: data/json/monsters/zed_ferrous.json
msgid "rust fist brute"
msgid_plural "rust fist brutes"
msgstr[0] "bestia de puño oxidado"
msgstr[1] "bestias de puño oxidado"
msgstr[2] "bestias de puño oxidado"

#. ~ Description of monster "rust fist brute"
#: data/json/monsters/zed_ferrous.json
msgid ""
"This brute of a zombie is covered in rusted metal detritus.  Chunks of metal"
" smashed through its arms have deformed them into hammers."
msgstr ""
"Esta bestia de zombi está cubierta de restos de metal oxidado. Los trozos de"
" metal que han atravesado sus brazos los han deformado hasta convertirlos en"
" martillos."

#. ~ Monster name
#: data/json/monsters/zed_fusion.json
msgid "crawler"
msgid_plural "crawlers"
msgstr[0] "reptante"
msgstr[1] "reptantes"
msgstr[2] "reptantes"

#. ~ Description of monster "crawler"
#: data/json/monsters/zed_fusion.json
msgid ""
"A conglomeration of human parts fused together in a horrible mishmash of "
"function, slowly dragging its eldritch body across the ground."
msgstr ""
"Es una conglomeración de partes de cuerpos humanos, fusionadas juntas en un "
"horrible revoltijo de funciones. Va arrastrando lentamente su espeluznante "
"cuerpo por el suelo."

#. ~ Monster name
#: data/json/monsters/zed_fusion.json
msgid "dissoluted devourer"
msgid_plural "dissoluted devourers"
msgstr[0] "devorador disoluto"
msgstr[1] "devoradores disolutos"
msgstr[2] "devoradores disolutos"

#. ~ Description of monster "dissoluted devourer"
#: data/json/monsters/zed_fusion.json
msgid ""
"Human bodies fused together into a colossus, with heads and limbs sticking "
"out of its bloated body.  The nature of the thing makes it difficult to "
"estimate how close it is to dying, and its capabilities might change if it "
"manages to assimilate more zombies into itself."
msgstr ""
"Cuerpos humanos fusionados en un coloso, con cabezas y extremidades que "
"sobresalen de su cuerpo hinchado. La naturaleza de la cosa hace que sea "
"difícil estimar lo cerca que está de morir, y sus capacidades podrían "
"cambiar si consigue asimilar más zombis en sí mismo."

#. ~ Monster name
#: data/json/monsters/zed_fusion.json
msgid "melded task force"
msgid_plural "melded task forces"
msgstr[0] "equipo de trabajo fusionado"
msgstr[1] "equipos de trabajo fusionados"
msgstr[2] "equipos de trabajo fusionados"

#. ~ Description of monster "melded task force"
#: data/json/monsters/zed_fusion.json
msgid ""
"A tangle of security personnel fused with their gear and with each other, "
"warped limbs and flesh-covered equipment moving in strange unison.  Every so"
" often you glimpse a pitch-black figure at its center, limbs mirroring the "
"movements of the larger mass."
msgstr ""
"Un revoltijo de personal de seguridad fusionados entre sí con equipamiento,"
"  miembros retorcidos y carne cubierta por el uniforme, moviéndose a un "
"extraño unísono. De vez en cuando, puedes ver una figura negra en el centro "
"con sus miembros imitando los movimientos de la masa más grande."

#. ~ Death message of monster "melded task force"
#: data/json/monsters/zed_fusion.json
msgid ""
"The creature grows sluggish before freezing in place for a moment.  Suddenly"
" its flesh turns black and recedes to coat the central figure, which reaches"
" out towards you before collapsing into a pinprick of shimmering air.  Torn "
"uniforms and other gear tumble to the ground."
msgstr ""
"La criatura se va volviendo más lenta antes de congelarse en el lugar por un"
" instante. De repente, su carne se vuelve negra y se hasta cubrir a la "
"figura central que intenta avanzar hacia tí antes de colapsar en una punzada"
" de aire resplandeciente. Uniformes rotos y otro equipamiento golpean el "
"suelo."

#. ~ Monster message of special attack of monster "melded task force"
#: data/json/monsters/zed_fusion.json
msgid "A handful of flesh wriggles loose from the mass and takes flight!"
msgstr ""
"¡Un puñado de carne se retuerce y se libera de la masa para empieza a volar!"

#. ~ Monster name
#: data/json/monsters/zed_fusion.json
msgid "trapped tendril"
msgid_plural "trapped tendrils"
msgstr[0] "zarcillo atrapado"
msgstr[1] "zarcillos atrapados"
msgstr[2] "zarcillos atrapados"

#. ~ Description of monster "trapped tendril"
#: data/json/monsters/zed_fusion.json
msgid ""
"A great tendril of mutated flesh and sharpened bone.  Emerging from a "
"crevice in the ruined floor, hundreds of human limbs seek freedom and writhe"
" incessantly from underneath its grotesque carapace.  As enormous as it may "
"be, you feel certain that this is just part of a much bigger creature, for "
"when it moves, you can feel this whole ruin tremble, as though an unseen "
"giant is struggling against the weight of its concrete tomb."
msgstr ""
"Un gran zarcillo de carne mutada y hueso afilado. Emergiendo de una grieta "
"en el suelo en ruinas, cientos de miembros humanos buscan la libertad y se "
"retuercen incesantemente debajo de su grotesco caparazón. Por muy enorme que"
" ya sea, sientes con seguridad que esto es sólo parte de una criatura mucho "
"más grande, ya que cuando se mueve, se puede sentir toda esta ruina temblar,"
" como si un gigante invisible luchara contra el peso de su tumba de "
"hormigón."

#. ~ Monster name
#: data/json/monsters/zed_fusion.json
msgid "gangrenous flesh"
msgid_plural "gangrenous flesh"
msgstr[0] "carne gangrenosa"
msgstr[1] "carne gangrenosa"
msgstr[2] "carne gangrenosa"

#. ~ Description of monster "gangrenous flesh"
#: data/json/monsters/zed_fusion.json
msgid ""
"Covered in grievous wounds, this wretch's gray skin has bloated to near-"
"rupture with putrid gas.  Between lumps of unrecognizable gore, a human head"
" lamely follows your movements with empty, black eyes."
msgstr ""
"Cubierta de graves heridas, la piel gris de este desdichado se ha hinchado "
"hasta casi reventar de gases pútridos. Entre los bultos de vísceras "
"irreconocibles, una cabeza humana sigue torpemente tus movimientos con ojos "
"negros y vacíos"

#. ~ Monster name
#: data/json/monsters/zed_fusion.json
msgid "gangrenous crawler"
msgid_plural "gangrenous crawlers"
msgstr[0] "reptante gangrenado"
msgstr[1] "reptantes gangrenados"
msgstr[2] "reptantes gangrenados"

#. ~ Description of monster "gangrenous crawler"
#: data/json/monsters/zed_fusion.json
msgid ""
"A nightmarish, spidery abomination born from human gore.  It deftly crawls "
"between the walls and ceiling with limbs grown from its own disjointed ribs."
msgstr ""
"Una abominación delgada y espeluznante nacida de las entrañas humanas. Se "
"arrastra hábilmente entre las paredes y el techo con extremidades creadas a "
"partir de sus propias costillas desarticuladas."

#. ~ Monster name
#: data/json/monsters/zed_fusion.json
msgid "gangrenous impaler"
msgid_plural "gangrenous impalers"
msgstr[0] "empalador gangrenoso"
msgstr[1] "empaladores gangrenosos"
msgstr[2] "empaladores gangrenosos"

#. ~ Description of monster "gangrenous impaler"
#: data/json/monsters/zed_fusion.json
msgid ""
"A corpse hideously twisted into an insect-like form.  A hollow tendril "
"reaches out from its open thorax."
msgstr ""
"Un cadáver horriblemente retorcido en una forma de insecto. Un zarcillo "
"hueco se extiende desde su tórax abierto."

#. ~ Description of special attack of monster "gangrenous impaler"
#: data/json/monsters/zed_fusion.json
msgid "The impaler launches a barb!"
msgstr "¡El empalador lanza una púa!"

#. ~ Monster name
#: data/json/monsters/zed_fusion.json
msgid "scissorlimbs"
msgid_plural "scissorlimbs"
msgstr[0] "cortador de extremidades"
msgstr[1] "cortadores de extremidades"
msgstr[2] "cortadores de extremidades"

#. ~ Description of monster "scissorlimbs"
#: data/json/monsters/zed_fusion.json
msgid ""
"A nightmarish spider of gore standing tall among the ruins, keeping silent "
"watch of the blighted landscape.  Its spindly limbs of bone slip between the"
" rubble with otherworldly speed."
msgstr ""
"Una araña de pesadilla y sangre se alza entre las ruinas, vigilando en "
"silencio el paisaje asolado. Sus enjutas extremidades de hueso se deslizan "
"entre los escombros con una velocidad de otro mundo."

#. ~ Monster name
#: data/json/monsters/zed_fusion.json
msgid "hanging innards"
msgid_plural "hanging innards"
msgstr[0] "entraña colgante"
msgstr[1] "entrañas colgantes"
msgstr[2] "entrañas colgantes"

#. ~ Description of monster "hanging innards"
#: data/json/monsters/zed_fusion.json
msgid ""
"Great snakes of flesh hang from the ceiling above, madly thrashing and "
"reaching about."
msgstr ""
"Grandes serpientes de carne cuelgan del techo, se agitan y se extienden "
"locamente."

#. ~ Monster name
#: data/json/monsters/zed_fusion.json
msgid "spasming lump"
msgid_plural "spasming lumps"
msgstr[0] "bulto espasmódico"
msgstr[1] "bultos espasmódicos"
msgstr[2] "bultos espasmódicos"

#. ~ Description of monster "spasming lump"
#: data/json/monsters/zed_fusion.json
msgid ""
"A great pile of merged bodies and mutated flesh.  It spasms in an arrhythmic"
" and desperate manner."
msgstr ""
"Un gran montón de cuerpos fusionados y carne mutada. Tiene espasmos "
"arrítmicos y desesperados."

#. ~ Monster name
#: data/json/monsters/zed_fusion.json
msgid "flesh wall"
msgid_plural "flesh walls"
msgstr[0] "muro de carne"
msgstr[1] "muros de carne"
msgstr[2] "muros de carne"

#. ~ Description of monster "flesh wall"
#: data/json/monsters/zed_fusion.json
msgid ""
"A great lump of mutated flesh.  It resembles the innards of some gigantic "
"creature, and is covered in a grid of diminutive veins."
msgstr ""
"Un gran bulto de carne mutada. Se asemeja a las entrañas de una criatura "
"gigante y está cubierto por una red de venas diminutas."

#. ~ Monster name
#: data/json/monsters/zed_lab.json
msgid "zombie scientist"
msgid_plural "zombie scientists"
msgstr[0] "científico zombi"
msgstr[1] "científicos zombis"
msgstr[2] "científicos zombis"

#. ~ Description of monster "zombie scientist"
#: data/json/monsters/zed_lab.json
msgid ""
"Apart from the jet-black eyes, this zombie looks less decomposed and inhuman"
" than most.  Clad in a tattered lab coat, it seems to have a glimmer of "
"awareness - not human awareness, but something else.  As you watch, its "
"movements look almost marionette-like."
msgstr ""
"Aparte de los ojos negros, este zombi parece menos descompuesto e inhumano "
"que la mayoría. Vestido con una bata de laboratorio andrajosa, parece tener "
"un destello de conciencia, no de conciencia humana, sino de algo más "
"siniestro. Al verlo, sus movimientos parecen casi como de marioneta."

#. ~ Monster name
#: data/json/monsters/zed_lab.json
msgid "zombie security guard"
msgid_plural "zombie security guards"
msgstr[0] "guardia de seguridad zombi"
msgstr[1] "guardias de seguridad zombi"
msgstr[2] "guardias de seguridad zombi"

#. ~ Description of monster "zombie security guard"
#: data/json/monsters/zed_lab.json
msgid ""
"A shambling human corpse wearing a gray uniform and a bulletproof vest with "
"\"SECURITY\" emblazoned across the front.  It looks like this guard was "
"quite physically fit before its death; it moves quickly and powerfully, "
"albeit clumsily."
msgstr ""
"Un cadáver humano destartalado con un uniforme gris y un chaleco antibalas "
"con \"SEGURIDAD\" blasonado en la parte delantera. Parece que este guardia "
"estaba en buena forma física antes de su muerte; se mueve rápida y "
"poderosamente, aunque con torpeza."

#. ~ Monster name
#: data/json/monsters/zed_lab.json
msgid "phase skulker"
msgid_plural "phase skulkers"
msgstr[0] "acechador fase"
msgstr[1] "acechadores fase"
msgstr[2] "acechadores fase"

#. ~ Description of monster "phase skulker"
#: data/json/monsters/zed_lab.json
msgid ""
"What remains of a researcher lost to the portal storms, twisted and "
"enervated by the presences that lurk beneath natural perception.  It walks "
"and stumbles in a stuttered manner, and is granted tenuous corporality only "
"by grace of the experimental gear it wore when it died."
msgstr ""
"Lo que queda de un investigador perdido en las tormentas del portal, "
"retorcido y enervado por las presencias que acechan bajo la percepción "
"natural. Camina y tropieza de manera tartamuda, y sólo se le concede una "
"tenue corporalidad por gracia del equipo experimental que llevaba cuando "
"murió."

#. ~ Monster message of special attack of monster "phase skulker"
#: data/json/monsters/zed_lab.json
msgid "The skulker shifts and melts inwards before disappearing!"
msgstr ""
"¡El oculto se desplaza y se derrite hacia dentro antes de desaparecer!"

#. ~ Sentence fragment describing a weakpoint for monster "phase skulker"
#. ~ Sentence fragment describing a weakpoint for monster "phase shrike"
#. ~ Sentence fragment describing the "stomach_armour" weakpoint
#: data/json/monsters/zed_lab.json
#: data/mods/classic_zombies/monsters/weakpoints.json
msgid "a gap in the armor"
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed_lab.json
msgid "phase shrike"
msgid_plural "phase shrikes"
msgstr[0] "alcaudón de fase"
msgstr[1] "alcaudones de fase"
msgstr[2] "alcaudones de fase"

#. ~ Description of monster "phase shrike"
#: data/json/monsters/zed_lab.json
msgid ""
"What remains of a researcher lost to the portal storms, twisted and "
"enervated by the presences that lurk beneath natural perception.  It "
"unnaturally skitters on four bone-plated spikes, its every motion trailing "
"an aura of energetic distortion."
msgstr ""
"Lo que queda de un investigador perdido en las tormentas del portal, "
"retorcido y enervado por las presencias que acechan bajo la percepción "
"natural. Se desliza de forma antinatural sobre cuatro púas recubiertas de "
"hueso, y cada uno de sus movimientos arrastra un aura de distorsión "
"energética."

#. ~ Monster message of special attack of monster "phase shrike"
#: data/json/monsters/zed_lab.json
msgid "The shrike shifts and disappears amidst an electric surge!"
msgstr ""
"¡El alcaudón se desplaza y desaparece en medio de una oleada eléctrica!"

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "frog mother"
msgid_plural "frog mothers"
msgstr[0] "madre rana"
msgstr[1] "madres ranas"
msgstr[2] "madres ranas"

#. ~ Description of monster "frog mother"
#: data/json/monsters/zed_misc.json
msgid ""
"A large, bulbous creature with an extremely large mouth and small, stubby "
"legs with no feet.  Drenched in an oily greenish-black substance, its flesh "
"seems to rapidly decompose and reconstitute itself, and it is covered in "
"large, white pustules that seem ready to pop."
msgstr ""
"Una criatura grande y protuberante con una boca extremadamente grande y "
"piernas cortas y regordetas sin pies. Cubierta de un residuo aceitoso verde "
"y negro, su carne parece descomponerse rápidamente y reconstituirse sola, y "
"está cubierta de grandes pústulas blancas que parecen listas para reventar."

#. ~ Monster message of special attack of monster "frog mother"
#: data/json/monsters/zed_misc.json
msgid ""
"Some of the pustules pop, and the frog mother opens her mouth and vomits "
"tadpoles!"
msgstr ""
"Algunas pústulas estallan y la madre rana abre la boca y vomita renacuajos."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "tadpole constrictor"
msgid_plural "tadpole constrictors"
msgstr[0] "renacuajo constrictor"
msgstr[1] "renacuajos constrictores"
msgstr[2] "renacuajos constrictores"

#. ~ Description of monster "tadpole constrictor"
#: data/json/monsters/zed_misc.json
msgid ""
"The only resemblance this creature bears to a tadpole is its slick black-"
"green skin and slender body.  Its three appendages, resembling long "
"tentacles or pseudopods, propel it across the ground at maddening speed.  It"
" has no outward sensory organs or a mouth, and steam rises from its skin as "
"if it is burning away its own lifeforce to catch you."
msgstr ""
"El único parecido de esta criatura con un renacuajo es su resbaladiza piel "
"negro-verdosa y su esbelto cuerpo. Sus tres apéndices, que parecen largos "
"tentáculos o seudópodos, lo impulsan por el suelo a una velocidad "
"enloquecedora. No tiene órganos sensoriales externos ni boca, y de su piel "
"sale vapor como si quemara su propia fuerza vital para atraparte."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "zombullfrog"
msgid_plural "zombullfrogs"
msgstr[0] "rana toro zombi"
msgstr[1] "ranas toro zombi"
msgstr[2] "ranas toro zombi"

#. ~ Description of monster "zombullfrog"
#: data/json/monsters/zed_misc.json
msgid ""
"The wound covered skin of this large bullfrog appears to be peeling in "
"places, revealing a black goop beneath the surface.  Its vacant stare passes"
" by anything that isn't food, and it will leap to devour anything it can."
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "slavering biter"
msgid_plural "slavering biters"
msgstr[0] "mordedor esclavizante"
msgstr[1] "mordedores esclavizantes"
msgstr[2] "mordedores esclavizantes"

#. ~ Description of monster "slavering biter"
#: data/json/monsters/zed_misc.json
msgid ""
"A distorted and swollen human body.  Its jaws have elongated into a "
"crocodile-like snout, dripping with foul-smelling saliva."
msgstr ""
"Un cuerpo humano distorsionado e hinchado. Sus mandíbulas se han alargado "
"hasta convertirse en un hocico de cocodrilo que gotea una saliva maloliente."

#. ~ Sentence fragment describing a weakpoint for monster "slavering biter"
#. ~ Sentence fragment describing a weakpoint for monster "mangrove lurker"
#: data/json/monsters/zed_misc.json
#: data/mods/TropiCataclysm/monsters/zed_plant.json
msgid "the inside of its mouth"
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "brainless zombie"
msgid_plural "brainless zombies"
msgstr[0] "zombi descerebrado"
msgstr[1] "zombis descerebrados"
msgstr[2] "zombis descerebrados"

#. ~ Description of monster "brainless zombie"
#: data/json/monsters/zed_misc.json
msgid ""
"A zombie like any other, except that its facial features and skull have been"
" devastated.  It's unclear what caused the damage, but between the scraps of"
" flesh you can see that its face and brain are gone, though its ears remain "
"intact."
msgstr ""
"Un zombi como cualquier otro, salvo que sus rasgos faciales y su cráneo han "
"sido devastados. No está claro qué ha causado el daño, pero entre los restos"
" de carne se puede ver que su cara y su cerebro han desaparecido, aunque sus"
" orejas permanecen intactas."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "headless horror"
msgid_plural "headless horrors"
msgstr[0] "horror decapitado"
msgstr[1] "horrores decapitados"
msgstr[2] "horrores decapitados"

#. ~ Description of monster "headless horror"
#: data/json/monsters/zed_misc.json
msgid ""
"This headless zombie has swollen to frightening proportions, towering almost"
" nine feet tall.  Six-foot-long feelers of black ooze blindly wave from its "
"neck, violently twitching at nearby sounds.  Its long stride allows it to "
"quickly pursue its targets, which it pummels into pulp with its huge, "
"swollen fists."
msgstr ""
"Este zombi sin cabeza está hinchado hasta alcanzar proporciones aterradoras,"
" con una altura de casi dos metros. Unas antenas negras de dos metros de "
"largo se agitan ciegamente desde su cuello, retorciéndose violentamente ante"
" los sonidos cercanos. Su larga zancada le permite perseguir rápidamente a "
"sus objetivos, a los que hace papilla con sus enormes e hinchados puños."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "zombie brute"
msgid_plural "zombie brutes"
msgstr[0] "bestias zombi"
msgstr[1] "bestias zombi"
msgstr[2] "bestias zombi"

#. ~ Description of monster "zombie brute"
#: data/json/monsters/zed_misc.json
msgid ""
"This zombie's entire body bulges with distended muscles and swollen, "
"festering wounds."
msgstr ""
"Su cuerpo entero está abultado con músculos dilatados y heridas infectadas e"
" hinchadas."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "zombie wrestler"
msgid_plural "zombie wrestlers"
msgstr[0] "zombi luchador"
msgstr[1] "zombis luchadores"
msgstr[2] "zombis luchadores"

#. ~ Description of monster "zombie wrestler"
#: data/json/monsters/zed_misc.json
msgid ""
"A slab of festering muscle the size of a well-toned bodybuilder.  Seems "
"eager to strangle the life from you."
msgstr ""
"Es como un bloque de músculo infectado, del tamaño de un fisiculturista en "
"buena forma. Parece tener ganas de estrangularte la vida."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "zombie nightstalker"
msgid_plural "zombie nightstalkers"
msgstr[0] "zombi acosador nocturno"
msgstr[1] "zombis acosadores nocturnos"
msgstr[2] "zombis acosadores nocturnos"

#. ~ Description of monster "zombie nightstalker"
#: data/json/monsters/zed_misc.json
msgid ""
"Somehow, this brute hides in the dark like some kind of boogeyman.  Very "
"agile for such a large zombie."
msgstr ""
"De alguna manera, esta bestia se esconde en la oscuridad como si fuera el "
"coco. Es muy ágil para ser un zombi tan grande."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "listener zombie"
msgid_plural "listener zombies"
msgstr[0] "zombi oyente"
msgstr[1] "zombis oyentes"
msgstr[2] "zombis oyentes"

#. ~ Description of monster "listener zombie"
#: data/json/monsters/zed_misc.json
msgid ""
"This zombie's head was once obviously destroyed, the gaps in its scraps of "
"face now filling with a peculiar gray goo.  Human ears hang from the sides, "
"enormous and unsettling.  Thin slits at the front suggest it may have a "
"(very limited) sense of sight."
msgstr ""
"La cabeza de este zombi fue una vez obviamente destruida, los huecos en los "
"restos de su cara ahora se llenan con una peculiar sustancia viscosa gris. "
"Las orejas humanas cuelgan de los lados, enormes e inquietantes. Unas finas "
"hendiduras en la parte delantera sugieren que puede tener un sentido de la "
"vista (muy limitado)."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "relentless hulk"
msgid_plural "relentless hulks"
msgstr[0] "mole implacable"
msgstr[1] "moles implacables"
msgstr[2] "moles implacables"

#. ~ Description of monster "relentless hulk"
#: data/json/monsters/zed_misc.json
msgid ""
"A hulking zombie swollen to the size of six men.  Its inky black eyes are "
"locked on you.  No matter how far you run, it always seems to find you."
msgstr ""
"Un zombi mole del tamaño de seis hombres. Sus ojos negros y oscuros se fijan"
" en ti. No importa lo lejos que corras, siempre parece encontrarte."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "grabber zombie"
msgid_plural "grabber zombies"
msgstr[0] "zombi agarrador"
msgstr[1] "zombis agarradores"
msgstr[2] "zombis agarradores"

#. ~ Description of monster "grabber zombie"
#: data/json/monsters/zed_misc.json
msgid ""
"A badly deformed zombie.  Its arms dangle from its sides like the limbs of "
"some skinless ape, mindlessly groping at their surroundings."
msgstr ""
"Un zombi muy deformado. Sus brazos cuelgan de sus costados como las "
"extremidades de un simio sin piel, tanteando sin sentido su entorno."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "grappler zombie"
msgid_plural "grappler zombies"
msgstr[0] "zombi aferrador"
msgstr[1] "zombis aferradores"
msgstr[2] "zombis aferradores"

#. ~ Description of monster "grappler zombie"
#: data/json/monsters/zed_misc.json
msgid ""
"This zombie's elongated arms drag along the ground as it moves.  It looks to"
" almost have a hunchback from the swollen shoulder muscles tearing though "
"its skin."
msgstr ""
"Los brazos alargados de este zombi se arrastran por el suelo mientras se "
"mueve. Parece tener casi una joroba por los músculos hinchados de los "
"hombros que desgarran su piel."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "zombie hollow"
msgid_plural "zombie hollows"
msgstr[0] "zombi hueco"
msgstr[1] "zombis huecos"
msgstr[2] "zombis huecos"

#. ~ Description of monster "zombie hollow"
#: data/json/monsters/zed_misc.json
msgid ""
"This zombie's hollow black eyes survey its surroundings as it stretches and "
"bends in ways that whoever the original body belonged to never could.  The "
"only things that seem solid on this flexible, black-veined body are the rows"
" of sharp, black teeth.  You get the feeling that the only human thing "
"remaining is the skin, worn as one might wear clothes."
msgstr ""
"Los ojos negros y huecos de este zombi observan su entorno mientras se "
"estira y se dobla de un modo que nunca pudo hacer a quien pertenecía el "
"cuerpo original. Lo único que parece sólido en este cuerpo flexible y de "
"venas negras son las hileras de dientes negros y afilados. Se tiene la "
"sensación de que lo único humano que queda es la piel, llevada como se lleva"
" la ropa."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "zombie hulk"
msgid_plural "zombie hulks"
msgstr[0] "mole zombi"
msgstr[1] "moles zombis"
msgstr[2] "moles zombis"

#. ~ Description of monster "zombie hulk"
#: data/json/monsters/zed_misc.json
msgid ""
"A human corpse swollen to the size of six men, with arms as wide as trash "
"cans."
msgstr ""
"Un cadáver humano hinchado al tamaño de seis hombres, con brazos tan anchos "
"como cubos de basura."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "zombie hunter"
msgid_plural "zombie hunters"
msgstr[0] "cazador zombi"
msgstr[1] "cazadores zombi"
msgstr[2] "cazadores zombi"

#. ~ Description of monster "zombie hunter"
#: data/json/monsters/zed_misc.json
msgid ""
"You're barely able to believe this thing was ever human; it scrambles about "
"on all fours, its nails and teeth sharpened into dangerous-looking spikes."
msgstr ""
"Apenas puedes creer que esta cosa haya sido alguna vez humana; se mueve a "
"cuatro patas, con las uñas y los dientes afilados en forma de peligrosos "
"pinchos."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "Thriller"
msgid_plural "Thrillers"
msgstr[0] "Thriller"
msgstr[1] "Thrillers"
msgstr[2] "Thrillers"

#. ~ Description of monster "Thriller"
#: data/json/monsters/zed_misc.json
msgid ""
"And though you fight to stay alive,\n"
"Your body starts to shiver.\n"
"For no mere mortal can resist,\n"
"The evil of the thriller."
msgstr ""
"And though you fight to stay alive,\n"
"Your body starts to shiver.\n"
"For no mere mortal can resist,\n"
"The evil of the thriller.\n"
"(Canción \"Thriller\" de Michael Jackson)."

#. ~ Death message of monster "Thriller"
#: data/json/monsters/zed_misc.json
msgid "The music stops!"
msgstr "¡La música se detiene!"

#. ~ Sentence fragment describing a weakpoint for monster "Thriller"
#: data/json/monsters/zed_misc.json
msgid "the funky, funky head"
msgstr ""

#. ~ Sentence fragment describing a weakpoint for monster "Thriller"
#: data/json/monsters/zed_misc.json
msgid "the glittering, beautiful eye"
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "zombie snapper"
msgid_plural "zombie snappers"
msgstr[0] "chasqueador zombi"
msgstr[1] "chasqueadores zombis"
msgstr[2] "chasqueadores zombis"

#. ~ Description of monster "zombie snapper"
#: data/json/monsters/zed_misc.json
msgid ""
"With a crocodile-like snout and rows of protruding teeth, this swimwear-clad"
" zombie lurks in the water."
msgstr ""
"Con una trompa similar a la de un cocodrilo y varias filas de dientes "
"saltones, este zombi vestido con malla merodea por el agua."

#. ~ Sentence fragment describing a weakpoint for monster "zombie snapper"
#: data/json/monsters/zed_misc.json
msgid "the inside of the mouth"
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "zombie master"
msgid_plural "zombie masters"
msgstr[0] "maestro zombi"
msgstr[1] "maestros zombis"
msgstr[2] "maestros zombis"

#. ~ Description of monster "zombie master"
#: data/json/monsters/zed_misc.json
msgid ""
"This zombie's features have tightened, its lips pulled back into an "
"unnatural grin, revealing rows of blackened teeth beneath large, piercing "
"eyes.  It stands tall and its movements are fluid and tightly controlled.  A"
" feeling of danger permeates the surrounding air, and the light that falls "
"on it seems somehow harsher and more glaring."
msgstr ""
"El aspecto de este zombie, se han endurecido, sus labios se han retraído en "
"una sonrisa antinatural, revelando hileras de dientes ennegrecidos bajo sus "
"grandes y penetrantes ojos. Es alto y sus movimientos son fluidos y muy "
"controlados. Una sensación de peligro impregna el aire que lo rodea, y la "
"luz que incide sobre él parece más dura y deslumbrante."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "zombie necromancer"
msgid_plural "zombie necromancers"
msgstr[0] "zombi nigromante"
msgstr[1] "zombis nigromantes"
msgstr[2] "zombis nigromantes"

#. ~ Description of monster "zombie necromancer"
#: data/json/monsters/zed_misc.json
msgid ""
"A twisted mockery of the human form, emaciated, with jet-black skin and "
"glowing red eyes.  It is somehow painful to look at, awakening fears deep "
"within your psyche, and even the surrounding air seems more sinister, "
"somehow darker and more dangerous."
msgstr ""
"Una burla retorcida de la forma humana, demacrada, con piel negra como el "
"azabache y ojos rojos brillantes. Resulta doloroso mirarlo, despertando "
"miedos en lo más profundo de tu psique, e incluso el aire que lo rodea "
"parece más siniestro, más oscuro y peligroso."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "zombie necro-boomer"
msgid_plural "zombie necro-boomers"
msgstr[0] "necroboomer zombi"
msgstr[1] "necroboomers zombi"
msgstr[2] "necroboomers zombi"

#. ~ Description of monster "zombie necro-boomer"
#: data/json/monsters/zed_misc.json
msgid ""
"At first this creature looks like nothing more than a grotesque and "
"oleaginous husk, bloated and punctured by jet-black pustules.  When "
"approached, its glowing red eyes and an aching grin take form; its skin "
"tears and its guts teem with unmatched fecundity, as its gaze inspires fear "
"of nothing less than cosmic, inhuman ecstasy."
msgstr ""
"Al principio, esta criatura no parece más que una cáscara grotesca y "
"oleaginosa, hinchada y perforada por pústulas negras como el azabache. Al "
"acercarse, sus ojos rojos y brillantes y una sonrisa dolorosa toman forma; "
"su piel se desgarra y sus tripas rebosan de una fecundidad inigualable, "
"mientras su mirada inspira miedo nada menos que al éxtasis cósmico e "
"inhumano."

#. ~ Death message of monster "zombie necro-boomer"
#: data/json/monsters/zed_misc.json
#, c-format
msgid "The %s lets out an unholy screech, and the corpses around it stir."
msgstr ""
"%s deja escapar un chillido impío y los cadáveres a su alrededor se "
"retuerce."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "zombie runner"
msgid_plural "zombie runners"
msgstr[0] "corredor zombi"
msgstr[1] "corredores zombi"
msgstr[2] "corredores zombi"

#. ~ Description of monster "zombie runner"
#: data/json/monsters/zed_misc.json
msgid ""
"This recently-risen body moves quickly, darting its head back and forth and "
"gnawing at its hands."
msgstr ""
"Este cuerpo reanimado recientemente se mueve rápido, corriendo a toda "
"velocidad moviendo su cabeza hacia adelante y atrás y mordisqueando sus "
"manos."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "regenerating zombie"
msgid_plural "regenerating zombies"
msgstr[0] "zombi regenerador"
msgstr[1] "zombis regeneradores"
msgstr[2] "zombis regeneradores"

#. ~ Description of monster "regenerating zombie"
#: data/json/monsters/zed_misc.json
msgid ""
"A hairless zombie.  Its pale, pinkish flesh appears to be squirming and "
"moving across its body, quickly covering and fixing any wounds that it "
"receives.  Its clothing is riddled with holes, suggesting someone else "
"tried, and failed, to take it down."
msgstr ""
"Un zombi sin pelo; su carne pálida y rosada parece retorcerse y moverse por "
"su cuerpo, cubriendo y arreglando rápidamente las heridas que recibe.  Su "
"ropa está plagada de agujeros, lo que sugiere que alguien intentó, y no "
"consiguió, acabar con el."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "zombie predator"
msgid_plural "zombie predators"
msgstr[0] "depredador zombi"
msgstr[1] "depredadores zombi"
msgstr[2] "depredadores zombi"

#. ~ Description of monster "zombie predator"
#: data/json/monsters/zed_misc.json
msgid ""
"With its joints in odd places and angles, this humanoid creature prowls "
"across the landscape with surprising speed.  Its teeth and arms are "
"sharpened into fine points, and black ooze seeps out from cuts between its "
"muscles."
msgstr ""
"Con sus articulaciones en lugares y ángulos extraños, esta criatura "
"humanoide merodea por el paisaje a una velocidad sorprendente. Sus dientes y"
" brazos son muy afilados, y un fluido negro se filtro por los cortes entre "
"sus músculos."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "screecher zombie"
msgid_plural "screecher zombies"
msgstr[0] "zombi gritón"
msgstr[1] "zombis gritones"
msgstr[2] "zombis gritones"

#. ~ Description of monster "screecher zombie"
#: data/json/monsters/zed_misc.json
msgid ""
"A thin corpse, its chest swollen in what appears to be preparation.  A thick"
" black ooze drips from its open mouth."
msgstr ""
"Un cadáver delgado, con el pecho hinchado en lo que parece ser una "
"preparación. Un espeso líquido negro gotea de su boca abierta."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "shady zombie"
msgid_plural "shady zombies"
msgstr[0] "zombi sombrio"
msgstr[1] "zombis sombrios"
msgstr[2] "zombis sombrios"

#. ~ Description of monster "shady zombie"
#: data/json/monsters/zed_misc.json
msgid ""
"An uncanny shadow envelops this creature, as if light itself were too "
"repulsed to touch it.  All you can make out is its shambling, human-shaped "
"outline."
msgstr ""
"Una sombra misteriosa envuelven a esta criatura, como si la propia luz le "
"repugnara tocarla. Lo único que se puede distinguir es su contorno "
"vacilante, con forma humana."

#. ~ Monster name
#. ~ Name of map extra
#: data/json/monsters/zed_misc.json data/json/overmap/map_extras.json
msgid "Shia LaBeouf"
msgid_plural "Shia LaBeouf"
msgstr[0] "Shia LaBeouf"
msgstr[1] "Shia LaBeouf"
msgstr[2] "Shia LaBeouf"

#. ~ Description of monster "Shia LaBeouf"
#: data/json/monsters/zed_misc.json
msgid ""
"Living in the woods,\n"
"killing for sport,\n"
"eating all the bodies--\n"
"actual cannibal Shia LaBeouf."
msgstr ""
"Living in the woods,\n"
"killing for sport,\n"
"eating all the bodies,\n"
"actual cannibal Shia LaBeouf."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "shrieker zombie"
msgid_plural "shrieker zombies"
msgstr[0] "zombi aullador"
msgstr[1] "zombis aulladores"
msgstr[2] "zombis aulladores"

#. ~ Description of monster "shrieker zombie"
#: data/json/monsters/zed_misc.json
msgid ""
"An elongated human body with a swollen chest and a gaping hole where its jaw"
" used to be."
msgstr ""
"Un cadáver humano estirado con el pecho hinchado y un agujero grande en "
"donde antes estaba la mandíbula."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "skull zombie"
msgid_plural "skull zombies"
msgstr[0] "zombi calavera"
msgstr[1] "zombis calavera"
msgstr[2] "zombis calavera"

#. ~ Description of monster "skull zombie"
#: data/json/monsters/zed_misc.json
msgid ""
"This zombie's head is a hideous gray skull, formed of human bone fragments "
"and some sort of goo.  Jagged teeth are visible as the thing works its jaw, "
"and lidless, disturbingly human eyes stare at you from their sockets.  The "
"thing's fleshy ears are four sizes too large and droop under their own "
"weight."
msgstr ""
"La cabeza de este zombie es un horrible cráneo gris, formado por fragmentos "
"de hueso humano y algún tipo de sustancia viscosa. Los dientes dentados son "
"visibles cuando la cosa trabaja su mandíbula y los inquietantes ojos humanos"
" sin párpados te miran desde sus órbitas. Las orejas carnosas de la cosa son"
" cuatro tamaños demasiado grandes y se caen por su propio peso."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "smoker zombie"
msgid_plural "smoker zombies"
msgstr[0] "zombi humeante"
msgstr[1] "zombis humeantes"
msgstr[2] "zombis humeantes"

#. ~ Description of monster "smoker zombie"
#: data/json/monsters/zed_misc.json
msgid ""
"A blackened and twisted naked human body.  Strips of flesh hang from its "
"frame, and it emits a constant haze of thick black smoke."
msgstr ""
"Un cuerpo humano desnudo, ennegrecido y retorcido. De su armazón cuelgan "
"tiras de carne y emite una neblina constante de humo negro y espeso."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "ashen brawler"
msgid_plural "ashen brawlers"
msgstr[0] "matón ceniciento"
msgstr[1] "matones cenicientos"
msgstr[2] "matones cenicientos"

#. ~ Description of monster "ashen brawler"
#: data/json/monsters/zed_misc.json
msgid ""
"A gigantic, twisted human frame with a menacing stance and rapid movements."
"  Thick clouds of smoke pour from violent-looking eviscerations spread "
"across its muscular body, and its arms appear to have elongated massively."
msgstr ""
"Una estructura humana gigantesca y retorcida, con una postura amenazante y "
"movimientos rápidos. Densas nubes de humo brotan de violentas vísceras que "
"se extienden por su cuerpo musculoso, y sus brazos parecen haberse alargado "
"enormemente."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "swimmer zombie"
msgid_plural "swimmer zombies"
msgstr[0] "zombi nadador"
msgstr[1] "zombis nadadores"
msgstr[2] "zombis nadadores"

#. ~ Description of monster "swimmer zombie"
#: data/json/monsters/zed_misc.json
msgid ""
"A zombie clad in swimwear.  Probably not a very graceful swimmer anymore."
msgstr ""
"Un zombi vestido con traje de baño. Probablemente ya no sea un nadador muy "
"agraciado."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "webbed zombie"
msgid_plural "webbed zombies"
msgstr[0] "zombi aleta"
msgstr[1] "zombis aletas"
msgstr[2] "zombis aletas"

#. ~ Description of monster "webbed zombie"
#: data/json/monsters/zed_misc.json
msgid ""
"A slick and glistening human body clad in swimwear.  Its hands and feet are "
"heavily webbed, suggesting some kind of rapid evolutionary adaptation to "
"water."
msgstr ""
"Un cuerpo humano resbaladizo y reluciente vestido con traje de baño. Sus "
"manos y pies están fuertemente palmeados, lo que sugiere algún tipo de "
"adaptación evolutiva rápida al agua."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "zombie technician"
msgid_plural "zombie technicians"
msgstr[0] "zombi técnico"
msgstr[1] "zombis técnicos"
msgstr[2] "zombis técnicos"

#. ~ Description of monster "zombie technician"
#: data/json/monsters/zed_misc.json
msgid ""
"Still wearing its work clothes and hardhat, this zombie likely used to work "
"on power lines or other electrical equipment.  As it approaches, everything "
"metal you're carrying shifts very slightly in the zombie's direction, as if "
"attracted by a strong magnetic force."
msgstr ""
"Este zombi, que todavía lleva su ropa de trabajo y su casco, probablemente "
"trabajaba en líneas eléctricas u otros equipos eléctricos. Cuando se acerca,"
" todo el metal que llevas se desplaza ligeramente en dirección al zombi, "
"como si fuera atraído por una fuerte fuerza magnética."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "zombie miner"
msgid_plural "zombie miners"
msgstr[0] "minero zombi"
msgstr[1] "mineros zombi"
msgstr[2] "mineros zombi"

#. ~ Description of monster "zombie miner"
#: data/json/monsters/zed_misc.json
msgid ""
"This zombie's face, hands, work clothes, and miner's helmet are fully "
"covered with stains of coal dust."
msgstr ""
"La cara, las manos, la ropa de trabajo y el casco de minero de este zombi "
"están totalmente cubiertos de manchas de polvo de carbón."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "thorny shambler"
msgid_plural "thorny shamblers"
msgstr[0] "desastre espinoso"
msgstr[1] "desastres espinosos"
msgstr[2] "desastres espinosos"

#. ~ Description of monster "thorny shambler"
#: data/json/monsters/zed_misc.json
msgid ""
"A shambling undead humanoid, its body overgrown with a tangled mass of "
"otherworldly vegetation.  Hunched over and dragging its feet as it moves, "
"the bramble utterly enveloping its upper half twitches and moves with a life"
" of its own, tendrils tipped with a paralytic sting."
msgstr ""
"Un humanoide no muerto que se tambalea, con el cuerpo recubierto por una "
"masa enmarañada de vegetación de otro mundo. Encorvado y arrastrando los "
"pies mientras se mueve, la zarza que envuelve su mitad superior se retuerce "
"y se mueve con vida propia, con zarcillos que tienen un aguijón paralizante."

#. ~ Monster name
#: data/json/monsters/zed_misc.json
msgid "ravenous reenactor"
msgid_plural "ravenous reenactors"
msgstr[0] "recreador voraz"
msgstr[1] "recreadores voraces"
msgstr[2] "recreadores voraces"

#. ~ Description of monster "ravenous reenactor"
#: data/json/monsters/zed_misc.json
msgid ""
"This shambling corpse is dressed in the tatters of an antiquated soldier's "
"uniform.  Either it was a historical reenactor, or zombies have also started"
" to time travel."
msgstr ""
"Este cadáver tambaleante está vestido con los jirones de un anticuado "
"uniforme de soldado. O era un recreador histórico, o los zombis también han "
"empezado a viajar en el tiempo."

#. ~ Monster name
#: data/json/monsters/zed_prisoner.json
msgid "prisoner zombie"
msgid_plural "prisoner zombies"
msgstr[0] "zombi prisionero"
msgstr[1] "zombis prisioneros"
msgstr[2] "zombis prisioneros"

#. ~ Description of monster "prisoner zombie"
#: data/json/monsters/zed_prisoner.json
msgid ""
"Apparently this zombie was doing time when the Cataclysm struck.  It wears "
"black and white striped prisoner clothes, and tattoos can be seen on its "
"decaying skin."
msgstr ""
"Al parecer, este zombi estaba cumpliendo condena cuando se produjo el "
"Cataclismo. Lleva ropas de prisionero a rayas blancas y negras, y se pueden "
"ver tatuajes en su decadente piel."

#. ~ Monster name
#: data/json/monsters/zed_prisoner.json
msgid "prisoner brute"
msgid_plural "prisoner brutes"
msgstr[0] "bestia prisionero"
msgstr[1] "bestias prisioneros"
msgstr[2] "bestias prisioneros"

#. ~ Description of monster "prisoner brute"
#: data/json/monsters/zed_prisoner.json
msgid "This muscular zombie wears black and white striped prisoner clothes."
msgstr ""
"Este musculoso zombi lleva ropa de prisionero a rayas blancas y negras."

#. ~ Monster name
#: data/json/monsters/zed_prisoner.json
msgid "fat prisoner"
msgid_plural "fat prisoners"
msgstr[0] "prisionero gordo"
msgstr[1] "prisioneros gordos"
msgstr[2] "prisioneros gordos"

#. ~ Description of monster "fat prisoner"
#: data/json/monsters/zed_prisoner.json
msgid "This fat zombie wears black and white striped prisoner clothes."
msgstr "Este zombi gordo lleva ropa de prisionero a rayas blancas y negras."

#. ~ Monster name
#: data/json/monsters/zed_prisoner.json
msgid "tough prisoner"
msgid_plural "tough prisoners"
msgstr[0] "prisionero duro"
msgstr[1] "prisioneros duros"
msgstr[2] "prisioneros duros"

#. ~ Description of monster "tough prisoner"
#: data/json/monsters/zed_prisoner.json
msgid ""
"This tough-looking zombie wears black and white striped prisoner clothes."
msgstr ""
"Este zombi de aspecto duro lleva ropa de prisionero a rayas blancas y "
"negras."

#. ~ Monster name
#: data/json/monsters/zed_radiation.json
msgid "charred nightmare"
msgid_plural "charred nightmares"
msgstr[0] "pesadilla chamuscada"
msgstr[1] "pesadillas chamuscadas"
msgstr[2] "pesadillas chamuscadas"

#. ~ Description of monster "charred nightmare"
#: data/json/monsters/zed_radiation.json
msgid ""
"Intense radiation has spurred a unique form of necrosis and regeneration, it"
" is impossible to tell if this creature was ever human."
msgstr ""
"Algún tipo de radiación intensa ha generado una forma única de necrosis y "
"regeneración. Es imposible darse cuenta si esta criatura fue antes un "
"humano."

#. ~ Monster name
#: data/json/monsters/zed_radiation.json
msgid "irradiated wanderer"
msgid_plural "irradiated wanderers"
msgstr[0] "errante irradiado"
msgstr[1] "errantes irradiados"
msgstr[2] "errantes irradiados"

#. ~ Description of monster "irradiated wanderer"
#: data/json/monsters/zed_radiation.json
msgid ""
"This rotting corpse seeps a glowing ooze from its lesions.  A strange "
"tattered jumpsuit marks it as an oddity across the wasteland."
msgstr ""
"Este cadáver en descomposición tiene un líquido brillante escurriéndole de "
"sus lesiones. Un extraño mono deshilachado lo marca como una rareza en este "
"páramo."

#. ~ Monster name
#: data/json/monsters/zed_skeletal.json
msgid "skeletal zombie"
msgid_plural "skeletal zombies"
msgstr[0] "zombi esquelético"
msgstr[1] "zombis esqueléticos"
msgstr[2] "zombis esqueléticos"

#. ~ Description of monster "skeletal zombie"
#: data/json/monsters/zed_skeletal.json
msgid ""
"A monstrous overgrowth of ossified tissue has replaced this zombie's rotting"
" skin with an organic armor of dense bone.  Large clumps of black goo seep "
"from its joints as it shambles aimlessly, with sickening crackling sounds "
"filling the surrounding air."
msgstr ""
"Un monstruoso crecimiento de tejido osificado ha sustituido la piel "
"putrefacta de este zombi por una armadura orgánica de hueso denso. De sus "
"articulaciones se desprenden grandes masas de sustancia viscosa negra "
"mientras se tambalea sin rumbo fijo, con sonidos crepitantes que llenan el "
"aire circundante."

#. ~ Monster name
#: data/json/monsters/zed_skeletal.json
msgid "skeletal brute"
msgid_plural "skeletal brutes"
msgstr[0] "bestia esquelética"
msgstr[1] "bestias esqueléticas"
msgstr[2] "bestias esqueléticas"

#. ~ Description of monster "skeletal brute"
#: data/json/monsters/zed_skeletal.json
msgid ""
"Distorted outgrowths of calcified bone plates cover this zombie's rotten "
"skin.  Joints and cracks around its body ooze with black goo."
msgstr ""
"Los brotes distorsionados de las placas de hueso calcificadas cubren la piel"
" podrida de este zombi. Las articulaciones y grietas alrededor de su cuerpo "
"rezuman una sustancia viscosa negra."

#. ~ Monster name
#: data/json/monsters/zed_skeletal.json data/mods/Aftershock/mobs/zombies.json
msgid "skeletal shocker"
msgid_plural "skeletal shockers"
msgstr[0] "eléctrico esquelético"
msgstr[1] "eléctricos esqueléticos"
msgstr[2] "eléctricos esqueléticos"

#. ~ Description of monster "skeletal shocker"
#: data/json/monsters/zed_skeletal.json
msgid ""
"Heavy, jagged bone plates have grown out of the surface of this zombie's "
"skin.  Underneath, its flesh glows and crackles with the occasional jolt of "
"electricity."
msgstr ""
"Pesadas y dentadas placas óseas han crecido en la piel de este zombi. "
"Debajo, su carne brilla y cruje con la ocasional sacudida de electricidad."

#. ~ Monster name
#: data/json/monsters/zed_skeletal.json
msgid "skeletal juggernaut"
msgid_plural "skeletal juggernauts"
msgstr[0] "gigante esquelético"
msgstr[1] "gigantes esqueléticos"
msgstr[2] "gigantes esqueléticos"

#. ~ Description of monster "skeletal juggernaut"
#: data/json/monsters/zed_skeletal.json
msgid ""
"This hideous golem of plated bones and misshapen flesh drags its heavy, "
"pointed limbs behind it like an unwanted burden.  Formerly soft and "
"vulnerable, bones grew around its form to protect it - only, they kept "
"growing.  And growing.  And growing."
msgstr ""
"Este espantoso golem de placas óseas y carnes malformadas, se arrastra "
"pesadamente, con sus brazos hacia atrás como si fueran una carga indeseada. "
"Los huesos han crecido para proteger lo que antes era suave y vulnerable, "
"pero siguieron creciendo. Y creciendo. Y creciendo."

#. ~ Monster name
#: data/json/monsters/zed_soldiers.json data/mods/No_Hope/monsters.json
msgid "zombie soldier"
msgid_plural "zombie soldiers"
msgstr[0] "soldado zombi"
msgstr[1] "soldados zombis"
msgstr[2] "soldados zombis"

#. ~ Description of monster "zombie soldier"
#: data/json/monsters/zed_soldiers.json data/mods/No_Hope/monsters.json
msgid ""
"Once a soldier, it is dressed head to toe in combat gear and carries itself "
"rather steadily for a zombie."
msgstr ""
"Alguna vez fue un soldado, está vestido de los pies a la cabeza con equipo "
"de combate y se mueve de una manera bastante firme para ser un zombi."

#. ~ Monster name
#: data/json/monsters/zed_soldiers.json data/mods/No_Hope/monsters.json
msgid "black-ops zombie"
msgid_plural "black-ops zombies"
msgstr[0] "zombi  operaciones encubiertas"
msgstr[1] "zombis operaciones encubiertas"
msgstr[2] "zombis operaciones encubiertas"

#. ~ Description of monster "black-ops zombie"
#: data/json/monsters/zed_soldiers.json data/mods/No_Hope/monsters.json
msgid ""
"This soldier zombie's skin radiates a sort of shadowy smoke that obscures "
"its outline, making its camouflage even harder to see against the "
"background.  In the darkness it would be nigh invisible."
msgstr ""
"La piel de este soldado zombi irradia una especie de humo sombrío que "
"oscurece su contorno, haciendo que su camuflaje sea aún más difícil de ver "
"contra el fondo. En la oscuridad sería casi invisible."

#. ~ Monster name
#: data/json/monsters/zed_soldiers.json
msgid "hunter-killer zombie"
msgid_plural "hunter-killer zombies"
msgstr[0] "zombi cazador-asesino"
msgstr[1] "zombis cazador-asesino"
msgstr[2] "zombis cazador-asesino"

#. ~ Description of monster "hunter-killer zombie"
#: data/json/monsters/zed_soldiers.json
msgid ""
"Fragments of visible uniform hint that this monstrosity was once a soldier."
"  Anything human is invisible, hidden inside a sheath of living shadow.  It "
"moves with preternatural fluidity and grace."
msgstr ""
"Fragmentos de uniformes visibles insinúan que esta monstruosidad fue una vez"
" un soldado. Cualquier cosa humana es invisible, escondida dentro de una "
"envoltura de sombra viva. Se mueve con una fluidez y gracia preternaturales."

#. ~ Monster name
#: data/json/monsters/zed_soldiers.json
msgid "bilious soldier zombie"
msgid_plural "bilious soldier zombies"
msgstr[0] "zombi soldado bilioso"
msgstr[1] "zombis soldados biliosos"
msgstr[2] "zombis soldados biliosos"

#. ~ Description of monster "bilious soldier zombie"
#: data/json/monsters/zed_soldiers.json
msgid ""
"This staggering soldier wears a burnt gasmask, now fused to its face.  "
"Through the melted, bile-encrusted ruination of the mask protrudes some sort"
" of hardened, fleshy proboscis, with steaming corrosive fluid leaking from "
"the end."
msgstr ""
"Este asombroso soldado lleva una máscara de gas quemada, ahora fusionada a "
"su cara. A través de la ruina derretida e incrustada de bilis de la máscara "
"viene una especie de probóscide carnosa endurecida, con un fluido corrosivo "
"vaporoso que se filtra por el extremo."

#. ~ Description of special attack of monster "bilious soldier zombie"
#: data/json/monsters/zed_soldiers.json
#, c-format
msgid "The %s launches a corrosive dart!"
msgstr "¡%s lanza un dardo corrosivo!"

#. ~ Monster name
#: data/json/monsters/zed_soldiers.json
msgid "caustic soldier zombie"
msgid_plural "caustic soldier zombies"
msgstr[0] "zombi soldado caústico"
msgstr[1] "zombis soldado caústico"
msgstr[2] "zombis soldado caústico"

#. ~ Description of monster "caustic soldier zombie"
#: data/json/monsters/zed_soldiers.json
msgid ""
"This zombie wears what appears to have once been a soldier's uniform and "
"armor, now a series of cracked and melted plates that have fused to its skin"
" and thickened hide.  Its face and arms blister with strange, mutated tubes "
"that pulse and drip with acid."
msgstr ""
"Este zombi lleva lo que parece haber sido una vez el uniforme y la armadura "
"de un soldado, ahora una serie de placas agrietadas y derretidas  se han "
"fusionado con su grueso pellejo. Su cara y brazos se ampollan con extraños "
"tubos mutados que pulsan y gotean con ácido."

#. ~ Description of special attack of monster "caustic soldier zombie"
#: data/json/monsters/zed_soldiers.json
#, c-format
msgid "The %s launches a hail of corrosive darts!"
msgstr "¡%s lanza una lluvia de dardos corrosivos!"

#. ~ Monster name
#: data/json/monsters/zed_soldiers.json
msgid "Kevlar zombie"
msgid_plural "Kevlar zombies"
msgstr[0] "zombi Kevlar"
msgstr[1] "zombis Kevlar"
msgstr[2] "zombis Kevlar"

#. ~ Description of monster "Kevlar zombie"
#: data/json/monsters/zed_soldiers.json
msgid ""
"This zombie was once wearing some kind of uniform with heavy, bulletproof "
"materials sewn in.  At this point it's impossible to tell what kind of "
"uniform it was: the monster's skin has grown over the fabric, splitting and "
"tearing it to shreds, turning the remaining Kevlar and other bits of armor "
"material into part of its hide.  Its hands have similarly fused into large, "
"leathery cudgels."
msgstr ""
"Este zombi llevaba antes una especie de uniforme con materiales pesados y "
"antibalas cosidos. En este momento es imposible saber qué tipo de uniforme "
"era: la piel del monstruo ha crecido sobre la tela, partiéndola y haciéndola"
" pedazos, convirtiendo el kevlar restante y otros trozos de material de la "
"armadura en parte de su piel. Sus manos, igualmente, se han fusionado en "
"grandes porras de cuero."

#. ~ Monster name
#: data/json/monsters/zed_soldiers.json
msgid "Kevlar hulk"
msgid_plural "Kevlar hulks"
msgstr[0] "mole Kevlar"
msgstr[1] "moles Kevlar"
msgstr[2] "moles Kevlar"

#. ~ Description of monster "Kevlar hulk"
#: data/json/monsters/zed_soldiers.json
msgid ""
"This zombie was once wearing some kind of now long-shredded uniform with "
"heavy, bulletproof materials sewn in.  It has grown into a hulking, "
"leatherbacked beast, its mutated skin taking on a strange texture similar to"
" the Kevlar bits embedded in it.  Its arms have twisted into enormous clubs "
"of misshapen bone that it drags on the ground behind it."
msgstr ""
"Este zombi llevaba antes una especie de uniforme, ahora destrozado, con "
"materiales pesados y antibalas cosidos. Ha crecido hasta convertirse en una "
"bestia mole con espalda de cuero, cuya piel mutada adquiere una extraña "
"textura similar a la de los trozos de Kevlar incrustados en ella. Sus brazos"
" se han retorcido hasta convertirse en enormes garrotes de hueso deformado "
"que arrastra por el suelo tras de sí."

#. ~ Monster name
#: data/json/monsters/zed_soldiers.json
msgid "zombie military pilot"
msgid_plural "zombie military pilots"
msgstr[0] "zombi piloto de ejército"
msgstr[1] "zombis piloto de ejército"
msgstr[2] "zombis piloto de ejército"

#. ~ Description of monster "zombie military pilot"
#: data/json/monsters/zed_soldiers.json
msgid ""
"Once a pilot, it is dressed in basic military fatigues, aviator sunglasses, "
"and a sturdy-looking helmet."
msgstr ""
" Una vez un piloto, esta vestido con una ropa militar básica, gafas de sol "
"de aviador, y un casco de aspecto robusto."

#. ~ Monster name
#: data/json/monsters/zed_soldiers.json
msgid "uniformed zombie"
msgid_plural "uniformed zombies"
msgstr[0] "zombi uniformado"
msgstr[1] "zombis uniformados"
msgstr[2] "zombis uniformados"

#. ~ Description of monster "uniformed zombie"
#: data/json/monsters/zed_soldiers.json
msgid ""
"This undead soldier is adorned in standard military fatigues.  It carries "
"itself rather steadily for a zombie."
msgstr ""
"Este soldado no muerto está adornado con un traje militar estándar. Para ser"
" un zombi, sus movimientos son relativamente firmes."

#. ~ Monster name
#: data/json/monsters/zed_soldiers.json
msgid "zombie mariner"
msgid_plural "zombie mariners"
msgstr[0] "marinero zombi"
msgstr[1] "marineros zombi"
msgstr[2] "marineros zombi"

#. ~ Description of monster "zombie mariner"
#: data/json/monsters/zed_soldiers.json
msgid ""
"Still dressed in the ragged remains of deep blue naval fatigues, it’s clear "
"that this walking corpse was once a sailor of some description.  The US "
"Navy’s insignia is embroidered on the shredded sleeve and shoulder of its "
"bloodied jacket, the dead crewman’s battered cap is beaten into the remains "
"of its fractured skull and its inky black eyes are scanning the area around "
"it as dark ooze drips from its limply hanging maw."
msgstr ""
"Aún vestido con los restos desgarrados de un uniforme naval azul oscuro, "
"está claro que este cadáver andante fue una vez un marinero de alguna clase."
" La insignia de la Marina de los Estados Unidos está bordada en la manga y "
"hombro destrozados de su chaqueta ensangrentada, la gorra maltrecha del "
"tripulante muerto sigue en los restos de su cráneo fracturado y sus ojos "
"negros y entintados escudriñan la zona que le rodea mientras gotea un "
"líquido oscuro de sus fauces que cuelgan sin fuerzas."

#. ~ Monster name
#: data/json/monsters/zed_soldiers.json
msgid "zombie officer"
msgid_plural "zombie officers"
msgstr[0] "oficial zombi"
msgstr[1] "oficiales zombi"
msgstr[2] "oficiales zombi"

#. ~ Description of monster "zombie officer"
#: data/json/monsters/zed_soldiers.json
msgid ""
"Dressed in the shredded blue dress uniform of a naval officer, this undead "
"corpse was evidently a higher ranking crewman in life.  Having more than "
"likely not been clad in body armor, the result now staggers before you: "
"horrific wounds exposed to the air and large portions of flesh and muscle "
"ripped from its glistening skeleton."
msgstr ""
"Vestido con un uniforme destrozado de oficial naval, este cadáver "
"evidentemente fue un tripulante de alto rango durante su vida. Al no haber "
"tenido armadura, el resultado tambalea frente a vos: unas heridas horribles "
"expuestas y grandes porciones de carne y músculo arrancadas de su brillante "
"esqueleto."

#. ~ Monster name
#: data/json/monsters/zed_soldiers.json
msgid "Devil Dog"
msgid_plural "Devil Dogs"
msgstr[0] "Perro Maligno"
msgstr[1] "Perros Malignos"
msgstr[2] "Perros Malignos"

#. ~ Description of monster "Devil Dog"
#: data/json/monsters/zed_soldiers.json
msgid ""
"This lurching corpse would have been an intimidating sight even when it was "
"still a living human.  Dressed head to toe in naval combat equipment and "
"with Marine insignia embroidered on its gear, this former Marine still "
"retains its physical fitness in death.  From underneath its helmet, its inky"
" black eyes predatorily scan the area around it, and its rotting hands still"
" look perfectly capable of strangling the life out of you."
msgstr ""
"Este cadáver tambaleante debe haber sido intimidante cuando todavía era un "
"ser humano vivo. Vestido de pies a cabeza con equipamiento naval de combate "
"y con la insignia de la Marina bordada, este marino todavía mantiene su "
"estado físico en su muerte. Debajo de su casco, sus ojos negros buscan "
"alguna presa a su alrededor y sus manos putrefactas todavía parecen capaces "
"de estrangularte la vida que te queda."

#. ~ Monster name
#: data/json/monsters/zed_soldiers.json
msgid "twisted leatherneck"
msgid_plural "twisted leathernecks"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "twisted leatherneck"
#: data/json/monsters/zed_soldiers.json
msgid ""
"Horrifically mutated and twisted beyond all recognition, you’d be hard "
"pressed to tell that this swollen corpse had ever been human.  Lumbering "
"about on all fours, the beast’s newly developed dagger-like claws clack "
"against the ground as it predatorially moves: thick strands of exposed "
"muscle tissue running across its rotting body.  The addition of its new bulk"
" has caused the skin along its arms and back to split apart, and the beast’s"
" teeth have extended into spikes of bone.  The US Marine insignias on the "
"remains of the creature’s pulverized gear are the only testaments to the "
"soldier that this hulking abomination used to be."
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed_soldiers.json
msgid "armored zombie"
msgid_plural "armored zombies"
msgstr[0] "zombi blindado"
msgstr[1] "zombis blindados"
msgstr[2] "zombis blindados"

#. ~ Description of monster "armored zombie"
#: data/json/monsters/zed_soldiers.json
msgid ""
"Despite being encased in a what was once a nigh-impenetrable combat "
"exoskeleton, something still managed to kill this soldier."
msgstr ""
"A pesar de estar enfundado en lo que fue un exoesqueleto de combate casi "
"impenetrable, algo consiguió matar a este soldado."

#. ~ Monster name
#: data/json/monsters/zed_soldiers.json
msgid "zombie bio-operator"
msgid_plural "zombie bio-operators"
msgstr[0] "zombi bio-operador"
msgstr[1] "zombis bio-operador"
msgstr[2] "zombis bio-operador"

#. ~ Description of monster "zombie bio-operator"
#: data/json/monsters/zed_soldiers.json
msgid ""
"This armored soldier zombie appears to have been some sort of special forces"
" agent.  Its malfunctioning equipment sends out occasional showers of "
"sparks."
msgstr ""
"Este soldado blindado zombi parece haber sido una especie de agente de las "
"fuerzas especiales. Su equipo defectuoso emite de vez en cuando una serie de"
" chispas."

#. ~ Monster name
#: data/json/monsters/zed_soldiers.json
msgid "elite zombie bio-operator"
msgid_plural "elite zombie bio-operators"
msgstr[0] "bio-operador zombi elite"
msgstr[1] "bio-operadores zombi elite"
msgstr[2] "bio-operadores zombi elite"

#. ~ Description of monster "elite zombie bio-operator"
#: data/json/monsters/zed_soldiers.json
msgid ""
"Once a highly-trained soldier, this zombie is still equipped with heavy "
"military gear and dangerous physical abilities.  Its malfunctioning "
"equipment sends out occasional showers of sparks."
msgstr ""
"Este zombi, que en su día fue un soldado altamente entrenado, sigue llevando"
" un pesado equipo militar y una peligrosa condición física. Su equipo "
"defectuoso emite de vez en cuando una serie de chispas."

#. ~ Monster name
#: data/json/monsters/zed_survivor.json
msgid "survivor zombie"
msgid_plural "survivor zombies"
msgstr[0] "zombi superviviente"
msgstr[1] "zombis supervivientes"
msgstr[2] "zombis supervivientes"

#. ~ Description of monster "survivor zombie"
#: data/json/monsters/zed_survivor.json
msgid ""
"Still wearing the tattered remnants of improvised armor and weaponry, it is "
"plain to see that this zombie was once a survivor like you."
msgstr ""
"Todavía tiene puestos los restos de una armadura improvisada y armas, está "
"claro que este zombi fue antes un superviviente como tú."

#. ~ Monster name
#: data/json/monsters/zed_survivor.json
msgid "veteran survivor zombie"
msgid_plural "veteran survivor zombies"
msgstr[0] "zombi superviviente veterano"
msgstr[1] "zombis supervivientes veteranos"
msgstr[2] "zombis supervivientes veteranos"

#. ~ Description of monster "veteran survivor zombie"
#: data/json/monsters/zed_survivor.json
msgid ""
"This zombie once was a survivor like you, and a pretty good one at that.  "
"Unfortunately they didn't make it, despite the custom-made, heavy armor "
"pieces they wear and the gear that they are still lugging around."
msgstr ""
"Este zombi fue una vez un superviviente como tú, y uno bastante bueno en "
"eso. Desafortunadamente no lo logró, a pesar de las pesadas piezas de "
"armadura hechas a medida que usan y el equipo que aún llevan."

