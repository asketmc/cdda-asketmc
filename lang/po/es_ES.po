#. ~ Profession name for male
#: data/mods/package_bionic_professions/bionic_professions.json
msgctxt "profession_male"
msgid "Augmentation Associate"
msgstr "Asociado de Aumento"

#. ~ Description of profession "Augmentation Associate" for male
#: data/mods/package_bionic_professions/bionic_professions.json
msgctxt "prof_desc_male"
msgid ""
"When bionics first emerged, you were quick to make them into your career, "
"and spent your days overseeing their installation.  That makes you one of "
"the few non-zombies in the world that can calibrate an Autodoc, which might "
"come in handy."
msgstr ""
"Cuando aparecieron los biónicos por primera vez, te apresuraste a "
"convertirlos en tu carrera, y pasaste tus días supervisando su instalación. "
"Eso te convierte en uno de los pocos no zombis del mundo que puede calibrar "
"un Autodoc, lo que podría resultar útil."

#. ~ Profession name for female
#: data/mods/package_bionic_professions/bionic_professions.json
msgctxt "profession_female"
msgid "Augmentation Associate"
msgstr "Asociado de Aumento"

#. ~ Description of profession "Augmentation Associate" for female
#: data/mods/package_bionic_professions/bionic_professions.json
msgctxt "prof_desc_female"
msgid ""
