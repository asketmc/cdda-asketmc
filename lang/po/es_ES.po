#: data/json/furniture_and_terrain/furniture-fungal.json
#: data/json/furniture_and_terrain/furniture-terrains.json
#: data/mods/No_Fungi/furniture.json
msgid "poof."
msgstr "puf."

#. ~ Furniture name
#. ~ Plant name of seed "fungal seeds"
#: data/json/furniture_and_terrain/furniture-fungal.json
#: data/json/items/comestibles/seed.json data/mods/No_Fungi/furniture.json
msgid "fungal flower"
msgstr "flor fúngica"

#. ~ Description of furniture "fungal flower"
#: data/json/furniture_and_terrain/furniture-fungal.json
msgid ""
"This flower has been overgrown by gray, sinewy tendrils of fungus, and the "
"color has been leached from its petals and stem.  It gently sways of its own"
" volition, maintaining an unsettling rhythm."
msgstr ""
"Esta flor ha sido cubierta por zarcillos grises y fibrosos de hongos, y el "
"color se ha desprendido de sus pétalos y su tallo. Se balancea suavemente "
"por voluntad propia, manteniendo un ritmo inquietante."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-fungal.json
#: data/mods/No_Fungi/furniture.json
msgid "fungal mass"
msgstr "masa fúngica"

#. ~ Description of furniture "fungal mass"
#: data/json/furniture_and_terrain/furniture-fungal.json
msgid ""
"Thick ropes of Mycal matter have covered the ground here completely.  It's "
"soft to the touch, but not firm enough to hold any weight."
msgstr ""
"Gruesas cuerdas de materia Mycal han cubierto el suelo de aquí "
"completamente. Es suave al tacto, pero no lo suficientemente firme como para"
" sostener cualquier peso."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-fungal.json
#: data/mods/No_Fungi/furniture.json
msgid "fungal clump"
msgstr "grumo fúngico"

#. ~ Description of furniture "fungal clump"
#: data/json/furniture_and_terrain/furniture-fungal.json
msgid ""
"Alien mold and stems mingle tightly here, swaying around and weaving "
"together, creating a sort of fungal bush."
msgstr ""
"El moho y los tallos alienígenas se mezclan con fuerza aquí, balanceándose y"
" entrelazándose, creando una especie de arbusto de hongos."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-fungal.json
msgid "fungal tangle"
msgstr "enredo fúngico"

#. ~ Description of furniture "fungal tangle"
#: data/json/furniture_and_terrain/furniture-fungal.json
msgid ""
"Thick, ropy tendrils of fungus have risen from the ground and gathered into "
"an impenetrable clump."
msgstr ""
"Gruesos zarcillos de hongos se han levantado del suelo y se han reunido en "
"un grupo impenetrable."

#. ~ Bashing failed sound of furniture "fungal tangle"
#: data/json/furniture_and_terrain/furniture-fungal.json
msgid "squelch."
msgstr "silenciador"

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-graves.json
msgid "stone slab"
msgstr "escalón de piedra"

#. ~ Description of furniture "stone slab"
#: data/json/furniture_and_terrain/furniture-graves.json
msgid "A slab of heavy stone, with a reasonably flat surface."
msgstr "Una losa de piedra pesada, con una superficie razonablemente plana."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-graves.json
msgid "headstone"
msgstr "lápida"

#. ~ Description of furniture "headstone"
#: data/json/furniture_and_terrain/furniture-graves.json
msgid ""
"A large slab of stone, engraved with information on the deceased individual "
"buried beneath.  While only a solemn reminder of the uncountable losses of "
"the Cataclysm, a proper final resting place grants an odd sense of peace."
msgstr ""
"Una gran losa de piedra, grabada con información sobre el individuo "
"fallecido enterrado debajo. Aunque sólo es un solemne recordatorio de las "
"incontables pérdidas del Cataclismo, un lugar de descanso final adecuado "
"otorga una extraña sensación de paz."

#. ~ Bashing failed sound of furniture "headstone"
#. ~ Bashing failed sound of furniture "gravestone"
#. ~ Bashing failed sound of furniture "worn gravestone"
#. ~ Bashing sound of furniture "pallet of cement bags"
#. ~ Bashing failed sound of furniture "ergometer"
#. ~ Bashing failed sound of furniture "mechanical ergometer"
#. ~ Bashing failed sound of furniture "treadmill"
#. ~ Bashing failed sound of furniture "gravity treadmill"
