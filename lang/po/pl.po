"Thunder lizard, dragon, tyrant.  All these names pale before your majesty."
msgstr ""
"Jaszczur burz, smok, tyran. Wszystkie te imiona bledną przed waszą "
"wysokością."

#. ~ Mutation class name
#. ~ Mutation name
#: data/mods/DinoMod/mutations/mutations.json
msgid "Stego"
msgstr "Stego"

#. ~ "mutagen_message" of mutation class "Stego"
#: data/mods/DinoMod/mutations/mutations.json
