msgstr[0] "dron bezpieczeństwa BM"
msgstr[1] "drony bezpieczeństwa BM"
msgstr[2] "dronów bezpieczeństwa BM"
msgstr[3] "drona bezpieczeństwa BM"

#. ~ Spell name
#: data/json/monsters/lab_security_drones.json
msgid "Light Green Researcher Badge Trait"
msgstr "Cecha jasnozielonej odznaki naukowej"

#. ~ Monster name
#: data/json/monsters/lab_security_drones.json
msgid "LGR security drone"
msgid_plural "LGR security drones"
msgstr[0] "dron bezpieczeństwa LGR"
msgstr[1] "drony bezpieczeństwa LGR"
msgstr[2] "dronów bezpieczeństwa LGR"
msgstr[3] "drona bezpieczeństwa LGR"

#. ~ Spell name
#: data/json/monsters/lab_security_drones.json
msgid "Black Security Badge Trait"
msgstr "Cecha czarnej odznaki ochrony"

#. ~ Monster name
#: data/json/monsters/lab_security_drones.json
msgid "BS security drone"
msgid_plural "BS security drones"
msgstr[0] "dron bezpieczeństwa BS"
msgstr[1] "drony bezpieczeństwa BS"
