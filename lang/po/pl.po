#: data/json/recipes/practice/tailoring.json
msgid "leatherworking (advanced)"
msgstr "kaletnictwo (zaawansowany)"

#. ~ Description of practice "leatherworking (advanced)"
#: data/json/recipes/practice/tailoring.json
