"Loss of health - Entire Body\n"
"Your clothing and other equipment may be consumed by the flames."
msgstr ""
"Utrata zdrowia - całe ciało\n"
"Twoje ubranie i sprzęt może spłonąć w płomieniach."

#. ~ Apply message of effect type "On Fire"
#: data/json/effects.json
msgid "You're on fire!  Wait in place to attempt to put out the fire."
msgstr "Palisz się! Stój w miejscu, aby spróbować się ugasić."

#. ~ Male memorial apply log of effect type "On Fire"
#: data/json/effects.json
msgctxt "memorial_male"
msgid "Caught on fire."
msgstr "Zająłeś się ogniem."

#. ~ Female memorial apply log of effect type "On Fire"
#: data/json/effects.json
msgctxt "memorial_female"
msgid "Caught on fire."
msgstr "Zajęłaś się ogniem."

#. ~ Male memorial remove log of effect type "On Fire"
#: data/json/effects.json
msgctxt "memorial_male"
msgid "Put out the fire."
msgstr "Ugasiłeś ogień."

#. ~ Female memorial remove log of effect type "On Fire"
#: data/json/effects.json
msgctxt "memorial_female"
msgid "Put out the fire."
msgstr "Ugasiłaś ogień."

#. ~ Name of effect type id "bouldering"
#: data/json/effects.json
msgid "Unstable Footing"
msgstr "Niestabilne podłoże"

