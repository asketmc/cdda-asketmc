msgid "There's an arc furnace there."
msgstr "Jest tutaj piec łukowy."

#: src/iexamine.cpp:3123
#, c-format
msgid "It has finished burning, yielding %d calcium carbide."
msgstr "Zakończył spalać, dając %d węglika wapnia."

