msgstr[0] "nieaktywny łap-bot"
msgstr[1] "nieaktywne łap-boty"
msgstr[2] "nieaktywnych łap-botów"
msgstr[3] "nieaktywnego łap-bota"

#. ~ Description of "inactive grab-bot"
#: data/mods/Aftershock/items/inactiverobot.json
msgid ""
"A salvaged skitterbot repurposed to grab onto and immobilize enemies.  "
"Activate this item to deploy the robot."
msgstr ""
"Smyrgobot z odzysku przerobiony do chwytania i unieruchamiania wrogów. "
"Aktywuj, by uruchomić."

#. ~ Item name
#: data/mods/Aftershock/items/inactiverobot.json
