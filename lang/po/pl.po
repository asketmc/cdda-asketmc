msgstr[3] "zepsutego drona-balona Exodii"

#. ~ Description of "broken Exodii balloon-drone"
#: data/json/items/corpses/dead_exodii.json
msgid ""
"A broken balloon drone.  The balloon has been shredded, but most of the "
"chassis is still intact.  Could be gutted for parts."
msgstr ""
"Zepsuty balon-dron. Balon jest porwany, ale większa część korpusu jest cała."
" Można go wybebeszyć na części."

#. ~ Item name
#: data/json/items/corpses/dead_yrax.json
msgid "trifacet remains"
msgid_plural "trifacet remains"
msgstr[0] "szczątki trójfasetowca"
