#. ~ Item name
#: data/json/items/tool/explosives.json
msgid "firecracker"
msgid_plural "firecrackers"
msgstr[0] "petarda"
msgstr[1] "petardy"
msgstr[2] "petard"
msgstr[3] "petardy"

#. ~ Description of "firecracker"
#: data/json/items/tool/explosives.json
msgid ""
"A solitary firecracker with a short fuse.  Use this item to light the fuse."
"  Of course, you will need a lighter or some matches to do so.  Shortly "
"after you light the fuse it will explode, so throw it quickly!"
msgstr ""
"Pojedyncza petarda z krótkim lontem. Użyj, by ją zapalić. Będziesz "
"oczywiście potrzebować zapalniczki. Krótko po zapaleniu lontu wybuchnie, "
"więc bierz nogi za pas."

#. ~ Item name
#: data/json/items/tool/explosives.json
msgid "firecracker (lit)"
msgid_plural "firecrackers (lit)"
msgstr[0] "petarda (zapalone)"
msgstr[1] "petardy (zapalone)"
msgstr[2] "petard (zapalone)"
msgstr[3] "petardy (zapalone)"

#. ~ Description of "firecracker (lit)"
#: data/json/items/tool/explosives.json
msgid ""
"A firecracker that has been lit; the fuse is hissing.  Throw it quickly "
"before it explodes."
msgstr "Zapalona petarda. Lont syczy. Rzucaj zanim eksploduje."

#. ~ Item name
#: data/json/items/tool/explosives.json
msgid "pack of firecrackers"
msgid_plural "packs of firecrackers"
msgstr[0] "paczka petard"
msgstr[1] "paczki petard"
msgstr[2] "paczek petard"
msgstr[3] "paczki petard"

#. ~ Description of "pack of firecrackers"
#: data/json/items/tool/explosives.json
msgid ""
"This is a pack of 25 firecrackers with a starter fuse.  Use this item to "
"light the fuse.  Of course, you will need a lighter or some matches to do "
"so.  Shortly after you light the fuse they will begin to explode, so throw "
"them quickly!"
msgstr ""
"Paczka 25 petard z lontem zapalającym. Użyj tego przedmiotu, by zapalić "
"lont. Będziesz oczywiście potrzebować zapalniczki. Krótko po zapaleniu lontu"
" wybuchnie, więc bierz nogi za pas."

#. ~ Item name
#: data/json/items/tool/explosives.json
msgid "pack of firecrackers (lit)"
msgid_plural "packs of firecrackers (lit)"
msgstr[0] "paczka petard (zapalone)"
msgstr[1] "paczki petard (zapalone)"
msgstr[2] "paczek petard (zapalone)"
msgstr[3] "paczki petardy (zapalone)"

#. ~ Description of "pack of firecrackers (lit)"
#: data/json/items/tool/explosives.json
msgid ""
"A pack of 25 firecrackers that has been lit; the fuse is hissing.  Throw "
"them quickly before the start to explode."
msgstr "Zapalona paczka 25 petard. Lont syczy. Rzucaj zanim eksploduje."

#. ~ Item name
#: data/json/items/tool/explosives.json
msgid "flashbang"
msgid_plural "flashbangs"
msgstr[0] "granat ogłuszający"
msgstr[1] "granaty ogłuszające"
msgstr[2] "granatów ogłuszających"
msgstr[3] "granatu ogłuszającego"

#. ~ Description of "flashbang"
#: data/json/items/tool/explosives.json
msgid ""
"This is a military police style flashbang.  Use this item to pull the pin "
"and light the fuse.  You will then have five seconds before it detonates "
"with intense light and sound, blinding, deafening and disorienting anyone "
"nearby."
msgstr ""
"To policyjny i wojskowy granat ogłuszający. Użyj, by odpalić zapalnik. "
"Będziesz mieć pięć sekund zanim wybuchnie intensywnym błyskiem i hukiem, "
"ogłuszając, oślepiając i dezorientując wszystkich w pobliżu."

