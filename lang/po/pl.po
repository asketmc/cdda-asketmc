msgid "Overwrite the existing message on the sign?"
msgstr "Nadpisać obecną wiadomość na znaku?"

#: src/iexamine.cpp:4469
msgid "Add a message to the sign?"
msgstr "Dodać wiadomość do znaku?"

#: src/iexamine.cpp:4470
msgid "You leave the sign alone."
msgstr "Zostawiasz znak w spokoju."

#: src/iexamine.cpp:4473
msgid "Write what?"
msgstr "Napisz co?"

#: src/iexamine.cpp:4480
msgid "You overwrite the previous message on the sign with your graffiti."
msgstr "Nadpisujesz poprzednią wiadomość na znaku swoim graffiti."

