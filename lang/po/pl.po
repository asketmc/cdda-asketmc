msgstr "miechy"

#. ~ Description of recipe crafting
#. "faction_base_modular_workshop_room0_log_northeast"
#: data/json/recipes/basecamps/expansion/recipe_modular_workshop/version_1/recipe_modular_workshop_log.json
msgid ""
"We can use a log workshop.  Let's start by building a spot to protect the "
"workers from the rain."
msgstr ""
"Przyda się nam warsztat z kłód. Zacznijmy od zbudowania miejsca, aby "
"ochronić pracowników przed deszczem."

#. ~ Blueprint name of recipe crafting
#. "faction_base_modular_workshop_room0_log_northeast"
#: data/json/recipes/basecamps/expansion/recipe_modular_workshop/version_1/recipe_modular_workshop_log.json
msgid "log northeast wall"
msgstr "północno-wschodnia ściana z kłód"

#. ~ Description of recipe crafting
#. "faction_base_modular_workshop_room3_log_north"
#: data/json/recipes/basecamps/expansion/recipe_modular_workshop/version_1/recipe_modular_workshop_log.json
msgid ""
"Let's extend the north log wall to the west and add some storage space."
msgstr ""
"Przedłużmy północną ścianę z kłód na zachód i dodajmy trochę miejsca do "
"przechowywania."

#. ~ Blueprint name of recipe crafting
#. "faction_base_modular_workshop_room3_log_north"
#: data/json/recipes/basecamps/expansion/recipe_modular_workshop/version_1/recipe_modular_workshop_log.json
msgid "log north wall"
msgstr "północna ściana z kłód"

#. ~ Description of recipe crafting
#. "faction_base_modular_workshop_room4_log_east"
#: data/json/recipes/basecamps/expansion/recipe_modular_workshop/version_1/recipe_modular_workshop_log.json
msgid ""
"Let's expand our production by adding another charcoal kiln with log walls."
msgstr ""
"Rozszerzmy naszą produkcję dodając kolejny piec do węgla drzewnego ze "
"ścianami z kłód."

#. ~ Blueprint name of recipe crafting
#. "faction_base_modular_workshop_room4_log_east"
#: data/json/recipes/basecamps/expansion/recipe_modular_workshop/version_1/recipe_modular_workshop_log.json
msgid "log east forge wall"
msgstr "wschodnia ściana kuźni z kłód"

#. ~ Description of recipe crafting
#. "faction_base_modular_workshop_room5_log_center"
#: data/json/recipes/basecamps/expansion/recipe_modular_workshop/version_1/recipe_modular_workshop_log.json
msgid ""
"Let's expand work area with a log wall, and add a bookshelf for our "
"reference books."
msgstr ""
"Rozszerzmy obszar roboczy o ścianę z kłód i dodajmy półkę na książki na "
"nasze podręczniki."

#. ~ Blueprint name of recipe crafting
#. "faction_base_modular_workshop_room5_log_center"
#: data/json/recipes/basecamps/expansion/recipe_modular_workshop/version_1/recipe_modular_workshop_log.json
msgid "log west forge wall"
msgstr "zachodnia ściana kuźni z kłód"

#. ~ Description of recipe crafting
#. "faction_base_modular_workshop_room6_log_north"
#: data/json/recipes/basecamps/expansion/recipe_modular_workshop/version_1/recipe_modular_workshop_log.json
#: data/mods/Aftershock/recipes/basecamps/recipe_overwrites.json
msgid "Let's expand our production by adding a log walled pottery kiln area."
msgstr ""
"Rozszerzmy naszą produkcję o obszar pieca garncarskiego ze ścian z kłód."

#. ~ Blueprint name of recipe crafting
#. "faction_base_modular_workshop_room6_log_north"
#: data/json/recipes/basecamps/expansion/recipe_modular_workshop/version_1/recipe_modular_workshop_log.json
msgid "log north pottery wall"
msgstr "północna ściana garncarstwa z kłód"

#. ~ Description of recipe crafting
#. "faction_base_modular_workshop_room7to9_log_northwest"
#: data/json/recipes/basecamps/expansion/recipe_modular_workshop/version_1/recipe_modular_workshop_log.json
msgid ""
"Let's enclose this pottery with log walls and get some more storage set up."
msgstr ""
"Otoczmy tę garncarnię ścianami z kłód i przygotujmy więcej miejsca do "
"przechowywania."

#. ~ Blueprint name of recipe crafting
#. "faction_base_modular_workshop_room7to9_log_northwest"
