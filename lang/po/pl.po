"Ryzyko: bardzo niskie\n"
"Czas: 4 godziny, powtarzalne\n"
"Stanowiska: %d/3\n"

#: src/faction_camp.cpp:1026
msgid " Recover Foragers"
msgstr " Wycofaj zbieraczy"

#: src/faction_camp.cpp:1034
#, c-format
msgid ""
"Notes:\n"
"Send a companion to set traps for small game.\n"
