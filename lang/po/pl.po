msgctxt "profession_male"
msgid "Operator Sniper"
msgstr "Żołnierz sił specjalnych - strzelec wyborowy"

#. ~ Description of profession "Operator Sniper" for male
#: data/json/professions.json data/mods/Military_Professions/prof/spc.json
msgctxt "prof_desc_male"
msgid ""
"You spent days dueling an enemy sniper, then he just… died.  And then un-"
"died."
msgstr ""
"Spędziłeś całe dnie na walce ze snajperem wroga, po czym ten… nagle zmarł. "
"Po czym powstał."

#. ~ Profession name for female
