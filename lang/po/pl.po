#: data/json/items/tool/workshop.json
msgid "tin snips"
msgid_plural "tin snips"
msgstr[0] "nożyce do blachy"
msgstr[1] "nożyce do blachy"
msgstr[2] "nożyc do blachy"
msgstr[3] "nożyc do blachy"

#. ~ Loosely based on Stanley FATMAX straight cut 9-7/8-inch aviation snip
#. ~ Description of "tin snips"
#: data/json/items/tool/workshop.json
msgid ""
"This is a pair of tin snips, resembling a sturdy pair of scissors with beefy"
" blades designed to cut through thin sheets of soft metal.  These cannot cut"
" through thick metals like a hacksaw can, but are better suited to precision"
" work and leave a cleaner edge."
msgstr ""
"Jest to para nożyc do blachy, przypominających solidne nożyczki z grubymi "
"ostrzami przeznaczonymi do przecinania cienkich arkuszy miękkiego metalu. "
"Nie można nimi przecinać grubych metali, tak jak piłą ręczną, ale lepiej "
"nadają się do prac precyzyjnych i pozostawiają gładką krawędź."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "hammer"
msgid_plural "hammers"
msgstr[0] "młotek"
msgstr[1] "młotki"
msgstr[2] "młotków"
msgstr[3] "młotka"

#. ~ Description of "hammer"
#: data/json/items/tool/workshop.json
msgid ""
"This is a demagnetized steel claw hammer with a wooden grip.  With a hammer,"
" nails, and planks in your inventory, you could board up adjacent doors and "
"windows.  It has myriad other uses as well."
msgstr ""
"Jest to rozmagnesowany stalowy młotek z drewnianą rękojeścią. Mając młotek, "
"gwoździe i deski w ekwipunku, możesz zabić deskami sąsiednie drzwi i okna. "
"Ma on również wiele innych zastosowań."

#. ~ Item name
