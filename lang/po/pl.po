msgstr "Zachowaj czujność."

#. ~ Negative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Sleep when you feel tired."
msgstr "Śpij jak się zmęczysz."

#. ~ Affirmative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Stay quiet."
msgstr "Bądź cicho."

#. ~ Negative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Tell me when you need something."
msgstr "Powiedz mi jak czegoś potrzebujesz."

#. ~ Affirmative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Leave corpses alone."
msgstr "Nie ruszaj ciał."

#. ~ Negative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Smash zombie corpses."
msgstr "Rozbijaj zwłoki zombie."

#. ~ Affirmative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Leave doors open."
msgstr "Zostawiaj drzwi otwarte."

#. ~ Negative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Close the doors."
msgstr "Zamykaj za sobą drzwi."

#. ~ Affirmative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Open doors to get where you're going."
msgstr "Otwieraj drzwi, by iść tam gdzie chcesz."

#. ~ Negative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Don't walk through closed doors."
msgstr "Nie przechodź przez zamknięte drzwi."

#. ~ Affirmative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "If you hear a noise but can't see the source, move to investigate it."
msgstr "Jak usłyszysz dźwięk z nieznanego źródła, idź to sprawdzić."

#. ~ Negative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Don't investigate noises that you can't see."
msgstr "Nie sprawdzaj dźwięków z nieznanych źródeł."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Set up pickup rules."
msgstr "Ustaw zasady podnoszenia rzeczy."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Clear all overrides."
msgstr "Wyczyść wszystkie nadpisania."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "You're really leaving?"
msgstr "Naprawdę odchodzisz?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Yeah, I'm sure.  Bye."
msgstr "Tak, to pewne. Żegnaj."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Nah, I'm just kidding."
msgstr "Niee, to tylko żarty"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please go to this location…"
msgstr "Idź w to miejsce…"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Stay at your current position."
msgstr "Zostań na swojej obecnej pozycji."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "I'm currently <current_activity>."
msgstr "Obecnie <current_activity>."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "I'm not doing much currently."
msgstr "Nic konkretnego teraz nie robię."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "I meant what are your goals?"
msgstr "Mam na myśli jakie masz cele?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Carry on."
msgstr "Kontynuuj."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please stop your current activity."
msgstr "Zaprzestań swojej obecnej aktywności."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please sort out some of these items nearby."
msgstr "Posortuj trochę z tych przedmiotów w pobliżu."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please do any construction work that you can."
msgstr "Zajmij się pracami budowlanymi, jakie jesteś w stanie wykonać."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please do any mining work that you can."
msgstr "Zajmij się pracami wydobywczymi, jakie jesteś w stanie wykonać."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please go mop the area."
msgstr "Idź umyj mopem okolicę."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please study from a book."
msgstr "Ucz się z książki."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please start deconstructing any vehicles in a deconstruction zone."
msgstr "Rozpocznij rozmontowywać na części pojazdy w strefie rozmontowania"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please start repairing any vehicles in a repair zone."
msgstr "Rozpocznij naprawiać pojazdy w strefie napraw."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please chop logs into planks."
msgstr "Potnij kłody na deski."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please butcher any corpses that you can."
msgstr "Zajmij się cięciem dowolnych zwłok, jakie możesz."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please chop any trees in the designated areas."
msgstr "Zetnij drzewa w wyznaczonych strefach."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please go catch some fish."
msgstr "Złów trochę ryb."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please do some farming work."
msgstr "Zajmij się rolnictwem."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please disassemble anything in the designated areas."
msgstr "Rozłóż na części wszystko w wyznaczonych obszarach."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "*pssshht* ten-four, I'll make my way there, over."
msgstr "*pszzzzz* przyjąłem, udaję się tam, odbiór."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Sure thing, I'll make my way there."
msgstr "Jasna sprawa, udaję się tam."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "What about the camp?"
msgstr "Co z obozem?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "I want to assign you to work at this camp."
msgstr "Chcę przypisać cię do pracy w tym obozie."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please go to this location."
msgstr "Idź w to miejsce."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid ""
"Since we can't build a camp here, I want you to tell me where can we build a"
" camp?"
msgstr ""
"Z racji, że nie możemy wybudować tu obozu, to chciałbym dowiedzieć się gdzie"
" możemy wybudować obóz?"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Are you sure?"
msgstr "Na pewno?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Yes, I'm sure."
msgstr "Tak, to pewne."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
#: data/json/npcs/common_chat/TALK_FRIEND_CONVERSATION.json
msgid "Actually, never mind."
msgstr "W zasadzie nieważne."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Another survivor!  We should travel together."
msgstr "Kolejny ocalały! Powinniśmy podróżować razem."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "What are you doing?"
msgstr "Co robisz?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Put away weapon."
msgstr "Odłóż broń."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Drop weapon."
msgstr "Upuść broń."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Don't worry, I'm not going to hurt you"
msgstr "Nie martw się, nie zrobię ci krzywdy"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Drop your weapon!"
msgstr "Rzuć broń!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Get out of here or I'll kill you."
msgstr "Znikaj stąd, bo cię zabiję."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Hey there, <name_g>."
msgstr "Hej tam, <name_g>."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
#: data/json/npcs/refugee_center/surface_staff/NPC_free_merchant_guard1.json
msgid "Hello there."
msgstr "Witajcie."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Okay, no sudden movements…"
msgstr "Okej, żadnych gwałtownych ruchów…"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Keep your distance!"
msgstr "Trzymaj dystans!"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "This is my territory, <name_b>."
msgstr "To moje terytorium, <name_b>."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Calm down.  I'm not going to hurt you."
msgstr "Uspokój się. Nie zrobię ci krzywdy."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Screw you, no."
msgstr "Wypchaj się, nic z tego."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Put hands up."
msgstr "Podnieś ręce."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "*drops his weapon."
msgstr "*upuszcza jego broń."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "*drops her weapon."
msgstr "*upuszcza jej broń."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Now get out of here"
msgstr "A teraz wypad stąd"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Now get out of here, before I kill you."
msgstr "A teraz zmiataj, zanim cię zabiję."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
#: data/json/npcs/holdouts/Rural-Cowboy_Hostile.json
msgid "Okay, I'm going."
msgstr "Okej, idę."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "About one of those jobs…"
msgstr "W sprawie jednej z tych prac…"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "What's the matter?"
msgstr "Co się dzieje?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I don't care."
msgstr "Nie obchodzi mnie to."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I don't have any jobs for you."
msgstr "Nie mam żadnych prac dla ciebie."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I don't have any more jobs for you."
msgstr "Nie mam już więcej prac dla ciebie."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I have other jobs for you.  Want to hear about them?"
msgstr "Mam inne zadania dla ciebie. Chcesz o nich usłyszeć?"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I have more jobs for you.  Want to hear about them?"
msgstr "Mam kolejne zadania dla ciebie. Chcesz o nich usłyszeć?"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I have a job for you.  Want to hear about it?"
msgstr "Mam robotę dla ciebie. Chcesz o niej usłyszeć?"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I just have one job for you.  Want to hear about it?"
msgstr "Mam tylko jedną robotę. Chcesz posłuchać?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/refugee_center/surface_staff/NPC_free_merchant_guard1.json
#: data/mods/Aftershock/npcs/milly_whately_dialogue.json
#: data/mods/Aftershock/npcs/prepnet_dialogue.json
#: data/mods/Aftershock/npcs/whately_generic_dialogue.json
msgid "Oh, okay."
msgstr "Och, okej."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Never mind, I'm not interested."
msgstr "Nieważne, nie interesuje mnie to."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "You're not working on anything for me now."
msgstr "Nie pracujesz teraz nad żadnym moim zleceniem."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Which job?"
msgstr "Która praca?"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "What about it?"
msgstr "Co ty na to?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I'll do it!"
msgstr "Zrobię to."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Not a problem."
msgstr "Bez problemu."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Got any advice?"
msgstr "Jakieś rady?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Can you share some equipment?"
msgstr "Podzielisz się ekwipunkiem?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I'll be back soon!"
msgstr "Wkrótce wrócę."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/lumbermill_employees/TALK_lumbermill_logger.json
msgid "Sounds good, thanks."
msgstr "Brzmi dobrze, dzięki."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Sounds good.  Bye!"
msgstr "Brzmi dobrze. Żegnaj!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#: data/json/npcs/refugee_center/surface_staff/Smokes/free_merchant_shopkeep_talk_fluff.json
#: data/json/npcs/robofac/robofac_intercom/robofac_intercom_missions.json
msgid "I'm sorry."
msgstr "Przykro mi."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Whatever.  Bye."
msgstr "Nieważne. Żegnaj."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I'm sorry… I failed."
msgstr "Wybacz… zawiodłem."

#. ~ Affirmative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I killed him."
msgstr "Zabiłem go."

#. ~ Negative response to NPC dialogue
#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I killed it."
msgstr "Zabiłem to."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "No.  I'll get back to it, bye!"
msgstr "Nie. Wrócę do tego, na razie!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Yup!  Here it is!"
msgstr "Tak. Jest tutaj!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "We're here!"
msgstr "Jesteśmy!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Here I am."
msgstr "Oto jestem."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I talked to them."
msgstr "Rozmawiałem z nimi."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Here it is!"
msgstr "Oto jest!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Justice has been served."
msgstr "Sprawiedliwości stało się zadość."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I killed them.  All of them."
msgstr "Zabiłem ich. Co do jednego."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I brought 'em."
msgstr "Przyniosłem je."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I've taken care of it"
msgstr "Zająłem się tym"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid ""
"I found it, but I'm keeping it, and I'll find you another one.  Let's talk "
"about something else."
msgstr ""
"Znalazłem to, ale to zatrzymam, a tobie znajdę inny. Porozmawiajmy o czymś "
"innym."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I found it, but I'm keeping it, and I'll find you another one.  Bye!"
msgstr "Znalazłem to, ale to zatrzymam, a tobie znajdę inny. Na razie!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Mission success!  I don't know what else to say."
msgstr "Misja wykonana! Nie wiem co jeszcze dodać."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Glad to help.  I need no payment."
msgstr "Cieszę się że pomogłem. Nie potrzebuję zapłaty."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "How about some items as payment?"
msgstr "Co powiesz na jakiś sprzęt jako zapłatę?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/godco/NPC_Corrie_Kaja_Dosia.json
msgid "Maybe you can teach me something as payment?"
msgstr "Może nauczysz mnie czegoś w ramach zapłaty?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Glad to help.  I need no payment.  Bye!"
msgstr "Cieszę się że pomogłem. Nie potrzebuję zapłaty. Żegnaj!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_doctor.json
msgid "Glad to help."
msgstr "Miło było pomóc."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Glad to help.  Bye!"
msgstr "Miło było pomóc. Żegnaj!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Well, um, sorry."
msgstr "Cóż, um, przepraszam."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I'm sorry.  I did what I could."
msgstr "Wybacz mi, robiłem co się dało."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Sure, here you go!"
msgstr "Pewnie, proszę bardzo!"

#. ~ Response to NPC dialogue
#. ~ Dialogue line in mission "Retrieve the fertility supplements"
#. ~ Dialogue line in mission "Find cactus seeds"
#. ~ Dialogue line in mission "Fishy Business"
#. ~ Dialogue line in mission "Mathematical Measures"
#. ~ Dialogue line in mission "Plumbing Maintenance"
#. ~ Dialogue line in mission "Planning Planers"
#. ~ Dialogue line in mission "Purging Heresy"
#. ~ Dialogue line in mission "Find Chris Isherwood"
#. ~ Dialogue line in mission "Gather 2000 units of sand"
#. ~ Dialogue line in mission "Gather 100 units of clay"
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/godco/NPC_Helena_Misinter.json
#: data/json/npcs/godco/NPC_Maria_Serrano.json
#: data/json/npcs/godco/godco_missions.json
#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#: data/json/npcs/other/homeless/group_camp/TALK_homeless_broker.json
#: data/json/npcs/robofac/robofac_intercom/robofac_intercom.json
#: data/json/npcs/robofac/robofac_intercom/robofac_intercom_missions.json
#: data/mods/DinoMod/NPC/NC_BO_BARONYX.json
msgid "Thank you."
msgstr "Dziękuję"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Thanks, bye."
msgstr "Dziękuję, do zobaczenia."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/other/NPC_pizzaiolo.json
msgid "Are we there yet, <name_g>?  I can't wait to burn that building!"
msgstr "Daleko jeszcze, <name_g>? Nie mogę się doczekać, aż spalę tę budę!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/other/NPC_pizzaiolo.json
msgid "We're here.  Let's do it!"
msgstr "Jesteśmy. Bierzmy się za to!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/other/NPC_pizzaiolo.json
msgid "Be patient, <name_g>, we're getting there soon."
msgstr "Cierpliwości, <name_g>, wkrótce tam dotrzemy."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Well, I guess it's just us."
msgstr "Cóż, myślę, że tylko my zostaliśmy."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "At least we've got shelter."
msgstr "Przynajmniej mamy schronienie."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "What should we do now?"
msgstr "Co teraz zrobimy?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Any tips?"
msgstr "Jakieś wskazówki?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/other/meteorologist.json
msgid "Want to travel with me?"
msgstr "Chcesz podróżować ze mną?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Want to share some useful items with me?"
msgstr "Chcesz się podzielić jakimś użytecznym sprzętem?"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I don't know, look for supplies and other survivors I guess."
msgstr "Nie wiem, poszukaj zapasów lub innych ocalonych, jak myślę."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Maybe we should start boarding up this place."
msgstr "Może powinniśmy zabić to miejsce dechami."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid ""
"I suppose getting a car up and running should really be useful if we have to"
" disappear quickly from here."
msgstr ""
"Zgaduję, że jakiś wóz na chodzie byłby nie od rzeczy, gdyby trzeba było "
"szybko stąd wiać."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid ""
"We could look for one of those farms out here.  They can provide plenty of "
"food and aren't close to the cities."
msgstr ""
"Powinniśmy rozejrzeć się za jakimś gospodarstwem rolniczym. Mogą być źródłem"
" masy jedzenia i są oddalone od miast."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid ""
"We should probably stay away from those cities, even if there's plenty of "
"useful stuff there."
msgstr ""
"Powinniśmy się raczej trzymać z dala od miast, choć jest w nich wiele "
"przydatnych rzeczy. "

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Hmm, okay."
msgstr "Hmmm, okej."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Thanks!"
msgstr "Dzięki!"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Focus on the road, mate!"
msgstr "Skup się na drodze, kolego!"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I must focus on the road!"
msgstr "Muszę się skupić na drodze!"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'm too thirsty, give me something to drink."
msgstr "Pragnienie mnie męczy, daj mi coś do picia."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'm too hungry, give me something to eat."
msgstr "Żołądek mnie ssie, daj mi coś do jedzenia."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'm too tired, let me rest first."
msgstr "Jestem zbyt zmęczony, pozwól mi wpierw odpocząć."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Nothing comes to my mind now.  Ask me later perhaps?"
msgstr "Nic nie przychodzi mi na myśl. Może zapytaj mnie później?"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I have some reason for not telling you."
msgstr "Mam swoje powody by ci nie mówić."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Ah, okay."
msgstr "Och, okej."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Not until I get some antibiotics…"
msgstr "Nie, dopóki nie dostanę antybiotyków…"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "You asked me recently; ask again later."
msgstr "Niedawno mnie o to pytałeś. Poproś później."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Why should I travel with you?"
msgstr "Czemu mam z tobą podróżować?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Understood.  I'll get those antibiotics."
msgstr "Zrozumiałem. Przyniosę te antybiotyki."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Right, right, I'll ask later."
msgstr "Dobrze, dobrze, potem zapytam."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I can keep you safe."
msgstr "Mogę zapewnić ci bezpieczeństwo."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "You can keep me safe."
msgstr "Możesz zapewnić mi bezpieczeństwo."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'll kill you if you don't."
msgstr "W przeciwnym wypadku cię zabiję."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "You got it, I'm with you!"
msgstr "Rozumiem, jestem z tobą!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Awesome!"
msgstr "Doskonale!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, let's go!"
msgstr "Okej, ruszajmy!"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Yeah… I don't think so."
msgstr "Taaak… nie sądzę."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "What is it?"
msgstr "O co chodzi?"

#. ~ Response to NPC dialogue
#. ~ Dialogue line in mission "Return Barry to Eddie at the dairy."
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
msgid "How much further?"
msgstr "Daleko jeszcze?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'd like to lead for a while."
msgstr "Chciałbym poprowadzić przez pewien czas."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Step aside.  I'm leader now."
msgstr "Z drogi. Teraz ja dowodzę."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Alright.  You can lead now."
msgstr "W porządku. Prowadzisz."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Good.  Something else…"
msgstr "Dobrze. Coś jeszcze…"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Alright, let's go."
msgstr "W porządku, idziemy…"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, okay."
msgstr "Okej, okej."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Alright, show me how it's done."
msgstr "Dobra, pokaż mi jak to się robi."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, let's begin."
msgstr "W porządku, zaczynajmy."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay.  Lead the way."
msgstr "Okej, prowadź."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "No, we'll be okay here."
msgstr "Nie, tu nam dobrze."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "On second thought, never mind."
msgstr "Po zastanowieniu się, jednak nieważne."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Alright, who should participate?"
msgstr "W porządku, kto powinien wziąć udział?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Let's see…"
msgstr "Zobaczmy…"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Alright, let's begin."
msgstr "W porządku, zaczynamy."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Sounds good."
msgstr "Brzmi dobrze."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I can't train you properly while you're operating a vehicle!"
msgstr "Nie jestem w stanie cię trenować gdy prowadzisz pojazd!"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I can't train you properly while I'm operating a vehicle!"
msgstr "Nie jestem w stanie cię trenować gdy prowadzę pojazd!"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Give it some time, I'll show you something new later…"
msgstr "Odczekaj trochę, później pokażę ci coś nowego…"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I have some reason for denying you training."
msgstr "Mam swoje powody, by odmówić ci szkolenia."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid ""
"We'll talk about a training seminar after you're done operating that "
"vehicle."
msgstr ""
"Porozmawiamy o seminarium szkoleniowym po tym, jak przestaniesz obsługiwać "
"ten pojazd."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I can't host a seminar while I'm operating a vehicle!"
msgstr "Nie mogę prowadzić seminarium, kiedy kieruję pojazdem!"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Give it some time, we'll talk about a training seminar later…"
msgstr ""
"Potrzebuję trochę czasu, później porozmawiamy o seminarium szkoleniowym…"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I have some reason to refuse hosting a training seminar."
msgstr "Mam powody, aby odmówić zorganizowania seminarium szkoleniowego."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Not a bloody chance, I'm going to get left behind!"
msgstr "Nie ma bata, nie zostanę porzucony w tyle!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/holdouts/Rural-Cowboy_Nihilist.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_barber.json
msgid "Fine."
msgstr "W porządku."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'm on watch."
msgstr "Stoję na straży."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I need you to come with me."
msgstr "Chcę żebyś poszedł ze mną."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I really don't feel comfortable doing so…"
msgstr "Naprawdę nie czuję się z tym komfortowo…"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'll give you some space."
msgstr "Dam ci trochę przestrzeni."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'd prefer to keep that to myself."
msgstr "Wolę zachować to dla siebie."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I understand…"
msgstr "Rozumiem…"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "You just asked me for stuff; ask later."
msgstr "Dopiero mnie pytałeś o sprzęt. Zapytaj później."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Why should I share my equipment with you?"
msgstr "Czemu mam się dzielić ekwipunkiem?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, fine."
msgstr "Okej, w porządku."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Because I'm holding a thermal detonator!"
msgstr "Ponieważ trzymam detonator termiczny!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Because I'm your friend!"
msgstr "Ponieważ jestem twoim przyjacielem."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Well, I am helping you out…"
msgstr "Cóż, przecież ci pomagam…"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'll give it back!"
msgstr "Zwrócę to z powrotem!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Give it to me, or else!"
msgstr "Daj mi to, albo!…"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Eh, never mind."
msgstr "Ech, nieważne."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Never mind, I'll do without.  Bye."
msgstr "Nieważne, obejdę się. Żegnaj."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, here you go."
msgstr "Okej, proszę bardzo."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Thanks!  But can I have some more?"
msgstr "Dziękuję! Czy mogę jeszcze więcej?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Thanks, see you later!"
msgstr "Dziękuję, do zobaczenia!"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "You picked up something that does not belong to you…"
msgstr "Wziąłeś coś co nie należy do ciebie…"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, okay, this is all a misunderstanding.  Sorry, I'll drop it now."
msgstr "Okej, okej, to nieporozumienie. Wybacz, już to odkładam."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "No, I'm keeping it.  Try and take it off me, I dare you."
msgstr "Nie, zatrzymam to sobie. A spróbuj tylko to wziąć to ode mnie."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Look, I really need this.  Please let me have it."
msgstr "Słuchaj, naprawdę tego potrzebuję. Pozwól mi to wziąć."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "What, this?  It's not the same one, you are mistaken."
msgstr "Co, to? Mylisz się, to inny egzemplarz."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'm sorry.  Look, I already dropped it, okay?"
msgstr "Przepraszam. Patrz, już to odłożyłem, okej?"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Don't try and talk yourself out of this, drop it now."
msgstr "Nie próbuj się z tego wykręcić, rzuć to natychmiast."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, I'm dropping it…"
msgstr "Okej, zostawiam to…"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Just this once, you can keep it.  Don't tell anyone else."
msgstr "Wyjątkowo tym razem możesz to zatrzymać. Nie mów o tym nikomu."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/godco/NPC_Aunt_Theresa.json
#: data/json/npcs/godco/NPC_Helena_Misinter.json
#: data/json/npcs/godco/cook.json
