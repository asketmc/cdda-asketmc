#: data/json/npcs/other/homeless/group_camp/TALK_homeless_group_survivors.json
msgid "So, what's up?"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/cabin_chemist/chemist_npc.json
#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#: data/json/npcs/isolated_road/isolated_road_jay_dialogue.json
#: data/json/npcs/refugee_center/surface_staff/NPC_free_merchant_guard1.json
#: data/mods/Aftershock/npcs/cyrus_whately.json
#: data/mods/Aftershock/npcs/milly_whately_dialogue.json
#: data/mods/Aftershock/npcs/prepnet_dialogue.json
#: data/mods/Aftershock/npcs/whately_generic_dialogue.json
msgid "What is this place?"
msgstr "Co to za miejsce?"

#. ~ Response to NPC dialogue
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid "I'd like to buy in bulk."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/cabin_chemist/chemist_npc.json
#: data/json/npcs/holdouts/Mr_Lapin.json
#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#: data/json/npcs/isolated_road/isolated_road_jay_dialogue.json
#: data/json/npcs/lumbermill_employees/TALK_lumbermill_logger.json
#: data/json/npcs/lumbermill_employees/TALK_lumbermill_merchant.json
#: data/json/npcs/other/TALK_NPC_APARTMENT_SURVIVOR.json
#: data/json/npcs/other/TALK_NPC_CAMPER.json
#: data/json/npcs/other/TALK_NPC_PREPPER_SURVIVOR.json
#: data/json/npcs/other/TALK_shelter_survivors.json
#: data/json/npcs/other/homeless/TALK_homeless_survivor.json
#: data/json/npcs/other/homeless/group_camp/TALK_homeless_broker.json
#: data/json/npcs/other/homeless/group_camp/TALK_homeless_group_survivors.json
#: data/json/npcs/scrap_trader/scrap_trader.json
#: data/json/npcs/valhalla_cult/TALK_valhallist_gode.json
#: data/json/npcs/valhalla_cult/TALK_valhallist_leader.json
#: data/json/npcs/valhalla_cult/TALK_valhallist_mechanic.json
msgid "Any jobs you need done?"
msgstr "Jakieś prace masz może do wykonania?"

#. ~ NPC dialogue line
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid ""
"I used to be a chemist.  Well, I am a chemist.  I've been living out here in"
" the wilderness for a little while now since <the_cataclysm>.  Even brought "
"some of my equipment, though unfortunately missing some of the more "
"sensitive and expensive stuff.  I found a couple useful things here in the "
"cupboards, but other than that, entirely empty.  So, I moved in."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/cabin_chemist/chemist_npc.json
#: data/json/npcs/other/homeless/group_camp/TALK_homeless_group_survivors.json
#: data/json/npcs/scrap_trader/scrap_trader.json
msgid "Hmm."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid ""
"Not my place, just somewhere I ended up.  Some old shack, maybe a hunting "
"cabin or something more… criminal, at least judging by some of what I found "
"on the shelves.  You certainly wouldn't attract much attention synthesizing "
"illegal substances all the way out here, that's all I'm saying.  I found it "
"while I was trying to escape all the <zombies> in the city, and I decided to"
" stay."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid ""
"I'm out of some things, <name_g>.  It takes a while to source the good stuff"
" - days usually - but I'm working hard to replace it.  What can I get you in"
" the meantime?"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid ""
"I'll see what I've got around here for you.  I've gotta warn you: it's gonna"
" be expensive.  Hard to stay supplied in the apocalypse, you know.  What do "
"you need?"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid "[10$]  I'll buy some bandages."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid "[40$]  I'll buy some aspirin."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid "[50$]  I'll buy some sprayable fungicide."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid "[50$]  I'll buy some powder fungicide."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid "[50$]  I'll buy some disinfectant."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid "[120$]  I'll buy some antibiotics."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid "[140$]  I'll buy some antifungal drugs."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid "[200$]  I'll buy some black gunpowder."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid "[300$]  I'll buy some napalm."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid "Is there anything else you need?"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/cabin_chemist/chemist_npc.json
#: data/json/npcs/lumbermill_employees/TALK_lumbermill_fabricate.json
#: data/json/npcs/scrap_trader/scrap_trader.json
msgid "No, that's all."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "No, just <swear> no…"
msgstr "Nie, po prostu <swear> nie…"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Just let me sleep, <name_b>!"
msgstr "Po prostu pozwól mi spać, <name_b>!"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Make it quick, I want to go back to sleep."
msgstr "Tylko szybko, chcę spać."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Just few minutes more…"
msgstr "Jeszcze kilka minut…"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Anything to do before I go to sleep?"
msgstr "Jeszcze coś do zrobienia zanim pójdę spać?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Wake up!"
msgstr "Pobudka!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Go back to sleep."
msgstr "Śpij dalej."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid ""
"This character was previously put into a suspension state due to an AI bug."
"  If you have reason to believe the problem was fixed, you can wake them up."
"  Do you want to do that now?"
msgstr ""
"Ta postać była wcześniej w stanie zawieszenia z powodu błędu SI. Jeśli masz "
"powody sądzić, że problem został naprawiony, możesz ją obudzić. Czy chcesz "
"to zrobić teraz?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "yes, wake up!"
msgstr "tak, pobudka!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "no, go back to sleep."
msgstr "nie, śpij dalej."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid " *pshhhttt* I'm reading you boss, over."
msgstr " *pszzzzzz* słyszę cię szefie, odbiór."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "What is it, friend?"
msgstr "O co chodzi, przyjacielu?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "I want to give you some commands for combat."
msgstr "Chcę dać ci kilka poleceń do walki."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "I want to set some miscellaneous rules."
msgstr "Chcę ustalić różne zasady."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "I'd like to know a bit more about your abilities."
msgstr "Chcę dowiedzieć się nieco więcej o twoich umiejętnościach."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "There's something I want you to do."
msgstr "Jest coś co chcę, żebyś zrobił."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "I just wanted to talk for a bit."
msgstr "Chcę tylko przez chwilę pogadać."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Can you help me understand something?  (HELP/TUTORIAL)"
msgstr "Czy możesz mi pomóc coś zrozumieć? (POMOC/SAMOUCZEK)"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "I'm going to go my own way for a while."
msgstr "Pójdę na razie własną drogą."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid ""
" *tshk* Are you serious?  This isn't a cell phone.  Can it wait until we're "
"in the same place?"
msgstr ""
" *tshk* Serio? To nie telefon komórkowy. Czy to może zaczekać aż znajdziemy "
"się w tym samym miejscu?"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Sure, what did you want to say?"
msgstr "Jasne, co chciałeś powiedzieć?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Mind if we just chat for a bit about your history?"
msgstr "Masz coś przeciwko, aby porozmawiać o twojej historii?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Let's just chitchat for a while, I could use some relaxation."
msgstr "Po prostu pogadajmy przez chwilę, przydałby mi się relaks."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "I changed my mind, wanted to ask you something else."
msgstr "Zmieniłem zdanie, chcę zapytać o coś innego."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "I'm all ears, my friend."
msgstr "Zamieniam się w słuch, przyjacielu."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "You gonna give me orders?"
msgstr "Zamierzasz wydać mi polecenia?"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "What would you like?"
msgstr "Co byś chciał?"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Just say the word."
msgstr "Powiedz tylko słowo."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
#: data/json/npcs/godco/NPC_Olwen_Powell.json
msgid "Can you teach me anything?"
msgstr "Możesz mnie czegoś nauczyć?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Can you host a training seminar?"
msgstr "Czy możesz zorganizować seminarium szkoleniowe?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "I have something to teach you."
msgstr "Jest coś, czego chcę cię nauczyć."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Let's trade items"
msgstr "Pohandlujmy."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Hold on to this item."
msgstr "Weź ten przedmiot."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Guard this position."
msgstr "Stój tu na straży."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Find a horse and mount up!"
msgstr "Znajdź konia i go dosiądź!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Drop off any items you're not using."
msgstr "Odłóż wszystkie przedmioty, których nie używasz."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Get off your mount, please."
msgstr "Zejdź proszę z wierzchowca."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Let's talk about your current activity."
msgstr "Porozmawiajmy o twojej obecnej aktywności."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Let's talk about the camp."
msgstr "Porozmawiajmy o obozie."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "*will not engage enemies."
msgstr "*nie będzie walczyć z wrogami."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "*will engage nearby enemies."
msgstr "*będzie walczyć z pobliskimi wrogami."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "*will engage weak enemies."
msgstr "*będzie walczyć ze słabymi wrogami."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "*will engage enemies you attack."
msgstr "*będzie walczyć z wrogami, których zaatakujesz."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "*will engage distant enemies without moving."
msgstr "*będzie walczyć z odległymi wrogami nie ruszając się"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "*will engage enemies close enough to attack without moving."
msgstr "*będzie walczyć z wrogami, których dosięgnie bez poruszania się."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "*will engage all enemies."
msgstr "*będzie walczyć ze wszystkimi wrogami."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "  OVERRIDE: "
msgstr " NADPISANE:"

#. ~ NPC dialogue line
