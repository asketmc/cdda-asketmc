#. ~ Profession name for male
#: data/json/professions.json data/mods/Military_Professions/prof/spc.json
msgctxt "profession_male"
msgid "Operator Undercover"
msgstr "Żołnierz sił specjalnych - pod ukryciem"

#. ~ Description of profession "Operator Undercover" for male
#: data/json/professions.json data/mods/Military_Professions/prof/spc.json
msgctxt "prof_desc_male"
msgid ""
"You've been tailing your target for months and now he's a zombie.  So much "
"for that lead."
msgstr ""
"Śledziłeś cel przez miesiące a teraz to zombie. To by było na tyle jeśli "
"chodzi o ten wątek."

#. ~ Profession name for female
#: data/json/professions.json data/mods/Military_Professions/prof/spc.json
msgctxt "profession_female"
msgid "Operator Undercover"
