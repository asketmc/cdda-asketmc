#. ~ MOD name
#: data/mods/speedydex/modinfo.json
msgid "SpeedyDex"
msgstr "SpeedyDex"

#. ~ Description of MOD "SpeedyDex"
#: data/mods/speedydex/modinfo.json
msgid "Higher dex increases your speed."
msgstr "Wyższa zręczność zwiększa twoją szybkość."

#. ~ MOD name
#: data/mods/stats_through_kills/modinfo.json
