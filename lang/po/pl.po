msgid_plural "scale urchins"
msgstr[0] "jeżowiec z łuskami"
msgstr[1] "jeżowce z łuskami"
msgstr[2] "jeżowców z łuskami"
msgstr[3] "jeżowca z łuskami"

#. ~ Description of monster "scale urchin"
#: data/mods/TropiCataclysm/monsters/tropical_nether.json
msgid ""
"A tiny alien creature brought by the portal storms.  It vaguely resembles a "
"sea urchin with scales instead of spines."
msgstr ""
"Maleńkie obce stworzenie przyniesione przez burze portalowe. Nieco "
"przypomina jeżowca z łuskami zamiast kolców."

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_nether.json
