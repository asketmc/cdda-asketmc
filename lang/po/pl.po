msgstr[2] "magicznych świateł"
msgstr[3] "magicznego światła"

#. ~ Description of "magic light"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "A small magical light that you can read by."
msgstr "Małe magiczne światło, przy którym można czytać."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "large shield of magical ice"
msgid_plural "large shields of magical ice"
msgstr[0] "duża tarcza z magicznego lodu"
msgstr[1] "duże tarcze z magicznego lodu"
msgstr[2] "dużych tarcz z magicznego lodu"
msgstr[3] "dużej tarczy z magicznego lodu"

#. ~ Description of "large shield of magical ice"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "A lightweight but tough shield crafted entirely of magical ice."
msgstr "Lekka, ale wytrzymała tarcza wykonana w całości z magicznego lodu."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "slick icy coatings"
msgid_plural "slick icy coatings"
msgstr[0] "gładkie lodowe powłoki"
msgstr[1] "gładkie lodowe powłoki"
msgstr[2] "gładkich lodowych powłok"
msgstr[3] "gładkich lodowych powłok"

#. ~ Description of "slick icy coatings"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A magical slick icy coating on your feet.  While quite fast on flat floors, "
"they make it difficult to move on rough terrain."
msgstr ""
"Magiczna, śliska, lodowa powłoka na twoich stopach. Choć są dość szybka na "
"płaskich powierzchniach, utrudnia poruszanie się po nierównym terenie."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "The Stormhammer"
msgid_plural "The Stormhammers"
msgstr[0] "Młot Burz"
msgstr[1] "Młoty Burz"
msgstr[2] "Młotów Burz"
msgstr[3] "Młota Burz"

#. ~ Description of "The Stormhammer"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A crackling magical warhammer full of lightning to smite your foes with, and"
" of course, smash things to bits!"
msgstr ""
"Iskrzący magiczny młot wojenny pełen błyskawic, którym możesz razić swoich "
"wrogów i oczywiście rozbijać rzeczy na kawałki!"

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "vicious tentacle whip"
msgid_plural "vicious tentacle whips"
msgstr[0] "bicz nikczemnej macki"
msgstr[1] "bicze nikczemnej macki"
msgstr[2] "biczy nikczemnej macki"
msgstr[3] "bicza nikczemnej macki"

#. ~ Description of "vicious tentacle whip"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A long, writhing, tentacle covered in sharp bonelike blades and spikey "
"protrusions."
msgstr ""
"Długa, wijąca się macka pokryta ostrymi, kościstymi ostrzami i kolczastymi "
"wypustkami."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "flarewhip"
msgid_plural "flarewhips"
msgstr[0] "ognisty bicz"
msgstr[1] "ogniste bicze"
msgstr[2] "ognistych biczy"
msgstr[3] "ognistego bicza"

#. ~ Description of "flarewhip"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A long whip made of blue-hot magical flames.  The heat is horrendous when "
"touching an enemy."
msgstr ""
"Długi bicz wykonany z rozgrzanych do niebieskości magicznych płomieni. Żar "
"jest potworny, gdy dotknie przeciwnika."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "flesh pouch"
msgid_plural "flesh pouches"
msgstr[0] "cielista kieszeń"
msgstr[1] "cieliste kieszenie"
msgstr[2] "cielistych kieszeni"
msgstr[3] "cielistej kieszeni"

#. ~ Description of "flesh pouch"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A large pouch of tough flesh on your back, filled with tiny tentacles that "
"grasp and hold anything you place inside.  It shifts and adjusts itself to "
"minimize encumbrance."
msgstr ""
"Duża sakiewka ze stwardniałego ciała na plecach, wypełniona małymi mackami, "
"które chwytają i utrzymują wszystko, co umieścisz w środku. Przesuwa się i "
"dopasowuje, by zminimalizować obciążenia."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "Wicked Bonespear"
msgid_plural "Wicked Bonespears"
msgstr[0] "Nikczemna Kostna Włócznia"
msgstr[1] "Nikczemne Kostne Włócznie"
msgstr[2] "Nikczemnych Kostnych Włóczni"
msgstr[3] "Nikczemnej Kostnej Włóczni"

#. ~ Description of "Wicked Bonespear"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "This is a wicked spear/halberd hybrid entirely created of bone."
msgstr ""
"Jest to diabelska hybryda włóczni i halabardy wykonana w całości z kości."

#. ~ Name of a gun
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "Woodbow"
msgid_plural "Woodbows"
msgstr[0] "drewnołuk"
msgstr[1] "drewnołuki"
msgstr[2] "drewnołuków"
msgstr[3] "drewnołuku"

#. ~ Description of gun "Woodbow"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A magically conjured ornate recurve bow of solid flexible wood.  A matching "
"conjured wooden arrow appears when you draw the string back for firing."
msgstr ""
"Magicznie wyczarowany ozdobny łuk z litego, elastycznego drewna. Po "
"naciągnięciu cięciwy do wystrzału pojawia się dopasowana, wyczarowana "
"drewniana strzała."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "seed of purification"
msgid_plural "seeds of purification"
msgstr[0] "nasiono oczyszczenia"
msgstr[1] "nasiona oczyszczenia"
msgstr[2] "nasion oczyszczenia"
msgstr[3] "nasiona oczyszczenia"

#. ~ Description of "seed of purification"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A magical seed that can be squeezed to release purifying dust, which can "
"then be used to purify up to a gallon of water."
msgstr ""
"Magiczne nasiono, które może być ściśnięte, aby uwolnić oczyszczający pył, "
"który może być użyty do oczyszczenia wody w ilości do jednego galona."

#. ~ "menu_text" action message of item "seed of purification"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "Squeeze seed"
msgstr "Zgnieć nasiono"

#. ~ "msg" action message of item "seed of purification"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"You squeeze the seed in your palm, and it begins to turn to a fine dust."
msgstr "Ściskasz nasiono w dłoni, a ono zaczyna zamieniać się w drobny pył."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "faintly glowing dust"
msgid_plural "faintly glowing dusts"
msgstr[0] "lekko świecący pył"
msgstr[1] "lekko świecące pyły"
msgstr[2] "lekko świecących pyłów"
msgstr[3] "lekko świecącego pyłu"

#. ~ Description of "faintly glowing dust"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "This fine dust glows with a growing intensity."
msgstr "Ten drobny pył świeci z rosnącą intensywnością."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "seed of growth"
msgid_plural "seeds of growth"
msgstr[0] "ziarno wzrostu"
msgstr[1] "ziarna wzrostu"
msgstr[2] "ziaren wzrostu"
msgstr[3] "ziarna wzrostu"

#. ~ Description of "seed of growth"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A magical powder that can be scattered on growing crops and make them grow "
"faster."
msgstr ""
"Magiczny proszek, który można rozsypać na rosnące rośliny i sprawić, że będą"
" rosły szybciej."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "obfuscating aura"
msgid_plural "obfuscating auras"
msgstr[0] "zasłaniająca aura"
msgstr[1] "zasłaniające aury"
msgstr[2] "zasłaniających aur"
msgstr[3] "zasłaniającej aury"

#. ~ Description of "obfuscating aura"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"An all-encompassing, invisible layer of magic distorts light around your "
"body.  Allows you to dodge two extra attacks in a given turn."
msgstr ""
"Wszechogarniająca, niewidzialna warstwa magii zniekształca światło wokół "
"twojego ciała. Pozwala na uniknięcie dwóch dodatkowych ataków w danej turze."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "acid resistance aura"
msgid_plural "acid resistance auras"
msgstr[0] "aura odporności na kwas"
msgstr[1] "aury odporności na kwas"
msgstr[2] "aur odporności na kwas"
msgstr[3] "aury odporności na kwas"

#. ~ Description of "acid resistance aura"
#. ~ Description of "greater acid resistance aura"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "An all-encompassing, invisible layer of protection against acid."
msgstr "Wszechogarniająca, niewidzialna warstwa magii chroniąca przed kwasem."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "greater acid resistance aura"
msgid_plural "greater acid resistance auras"
msgstr[0] "większa aura odporności na kwas"
msgstr[1] "większe aury odporności na kwas"
msgstr[2] "większych aur odporności na kwas"
msgstr[3] "większej aury odporności na kwas"

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "frost armor"
msgid_plural "frost armor"
msgstr[0] "zbroja mrozu"
msgstr[1] "zbroje mrozu"
msgstr[2] "zbroi mrozu"
msgstr[3] "zbroi mrozu"

#. ~ Description of "frost armor"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "A thin layer of magical ice, covering the entire body."
msgstr "Cienka warstwa magicznego lodu, pokrywająca całe ciało."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "stoneskin coating"
msgid_plural "stoneskin coating"
msgstr[0] "powłoka kamiennej skóry"
msgstr[1] "powłoki kamiennej skóry"
msgstr[2] "powłok kamiennej skóry"
msgstr[3] "powłoki kamiennej skóry"

#. ~ Description of "stoneskin coating"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A thin layer of shifting, almost fluid living rock, covering the entire "
"body."
msgstr ""
"Cienka warstwa ruchomej, niemal płynnej żywej skały, pokrywająca całe ciało."

#. ~ Description of effect type "burn_scar"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "This burn really hurts!"
msgstr "To oparzenie naprawdę boli!"

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "overcharge burn"
msgid_plural "overcharge burns"
msgstr[0] "przeładowane spalanie"
msgstr[1] "przeładowane spalania"
msgstr[2] "przeładowanych spalań"
msgstr[3] "przeładowanego spalania"

#. ~ Description of "overcharge burn"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "Ouch, this really smarts!  It'll go away soon, maybe?"
msgstr "Auć, to naprawdę sprytne! Może wkrótce zniknie?"

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "aura of protection"
msgid_plural "auras of protection"
msgstr[0] "aura ochrony"
msgstr[1] "aury ochrony"
msgstr[2] "aur ochrony"
msgstr[3] "aury ochrony"

#. ~ Description of "aura of protection"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"An all-encompassing, invisible layer of magical aura that protects you from "
"the environment."
msgstr ""
"Wszechogarniająca, niewidzialna warstwa magicznej aury, która chroni cię "
"przed środowiskiem."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "aura of repelling arc"
msgid_plural "auras of repelling arc"
msgstr[0] "aura odpychającego łuku"
msgstr[1] "aury odpychającego łuku"
msgstr[2] "aur odpychającego łuku"
msgstr[3] "aury odpychającego łuku"

#. ~ Description of "aura of repelling arc"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"An invisible aura that strikes melee attackers with arcs of electricity."
msgstr ""
"Niewidzialna aura, która razi atakujących wręcz łukami elektryczności."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "feral aura"
msgid_plural "feral auras"
msgstr[0] "dzika aura"
msgstr[1] "dzikie aury"
msgstr[2] "dzikich aur"
msgstr[3] "dzikiej aury"

#. ~ Description of "feral aura"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"The manifestation of your rage.  It won't disappear until you calm down."
msgstr ""
"Manifestacja twojej wściekłości. Nie zniknie, dopóki się nie uspokoisz."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "flaming sword"
msgid_plural "flaming swords"
msgstr[0] "ognisty miecz"
msgstr[1] "ogniste miecze"
msgstr[2] "ognistych mieczy"
msgstr[3] "ognistego miecza"

#. ~ Description of "flaming sword"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"This wooden sword is ablaze!  It seems to be safe-ish to hold, but will burn"
" up soon."
msgstr ""
"Ten drewniany miecz jest w płomieniach! Wydaje się być dość bezpieczny do "
"trzymania, ale wkrótce się spali."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "decaying boneclub"
msgid_plural "decaying boneclubs"
msgstr[0] "gnijąca kościopałka"
msgstr[1] "gnijące kościopałki"
msgstr[2] "gnijących kościopałek"
msgstr[3] "gnijącej kościopałki"

#. ~ Description of "decaying boneclub"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A pulsating club made of bone, stained with an ever-moving blood coating "
"eager to absorb the living."
msgstr ""
"Pulsująca pałka z kości, zabarwiona wiecznie ruchomą krwawą powłoką, chętna "
"by pochłaniać żywych."

#. ~ Name of a gun
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "impact sling"
msgid_plural "impact slings"
msgstr[0] "proca przyłożenia"
msgstr[1] "proce przyłożenia"
msgstr[2] "procy przyłożenia"
msgstr[3] "procy przyłożenia"

#. ~ Description of gun "impact sling"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A leather sling, quivering with energy when in your palm to the point of "
"almost tearing.  A pebble appears when you begin spinning it."
msgstr ""
"Skórzana proca, która w twojej dłoni pulsuje energią do tego stopnia, że "
"prawie się rozrywa. Kamyk pojawia się, gdy zaczynasz nią kręcić."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "acid aura"
msgid_plural "acid auras"
msgstr[0] "kwasowa aura"
msgstr[1] "kwasowe aury"
msgstr[2] "kwasowych aur"
msgstr[3] "kwasowej aury"

#. ~ Description of "acid aura"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"An aura of thin acid, swirling around your body ready to corrode when struck"
" or while striking."
msgstr ""
"Aura rzadkiego kwasu, wirująca wokół twojego ciała, gotowa korodować, gdy "
"zostaniesz uderzony lub podczas uderzenia."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "werewolf aura"
msgid_plural "werewolf auras"
msgstr[0] "aura wilkołaka"
msgstr[1] "aury wilkołaka"
msgstr[2] "aur wilkołaka"
msgstr[3] "aury wilkołaka"

#. ~ Description of "werewolf aura"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "You have become the werewolf.  Boys becoming men, men becoming wolves."
msgstr ""
"Stałeś się wilkołakiem. Chłopcy stają się mężczyznami, mężczyźni wilkami."

#. ~ Description of "Black Dragon Shell"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"An aura of black and green draconic energy, swirling around your body "
"protecting you and punishing those who strike you."
msgstr ""
"Aura czarnej i zielonej smoczej energii, wirująca wokół twojego ciała, "
"chroniąca cię i rażąca tych, którzy cię uderzą."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "subzero talons"
msgid_plural "subzero talons"
msgstr[0] "zmrożony szpon"
msgstr[1] "zmrożone szpony"
msgstr[2] "zmrożonych szponów"
msgstr[3] "zmrożonego szponu"

#. ~ Description of "subzero talons"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"Claws made from ice, able to freeze on contact while mauling foes.  You, "
"however, feel only a slight chill on your hands."
msgstr ""
"Pazury wykonane z lodu, potrafią zamrażać przy kontakcie z przeciwnikiem. Ty"
" jednak czujesz tylko lekki chłód na dłoniach."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "spiritual armor"
msgid_plural "spiritual armor"
msgstr[0] "duchowa zbroja"
msgstr[1] "duchowe zbroje"
msgstr[2] "duchowych zbroi"
msgstr[3] "duchowej zbroi"

#. ~ Description of "spiritual armor"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "A summoned medieval armor.  It glows softly and looks sturdy."
msgstr ""
"Przyzwana średniowieczna zbroja. Delikatnie świeci i wygląda na solidną."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "jar of force"
msgid_plural "jars of force"
msgstr[0] "słój mocy"
msgstr[1] "słoje mocy"
msgstr[2] "słoi mocy"
msgstr[3] "słoja mocy"

#. ~ Description of "jar of force"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A three-liter container made out of transparent force.  Can be used to store"
" liquids."
msgstr ""
"Trzylitrowy słój zrobiony z przezroczystej mocy. Może przechowywać płyny."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "holy sword"
msgid_plural "holy swords"
msgstr[0] "święty miecz"
msgstr[1] "święte miecze"
msgstr[2] "świętych mieczy"
msgstr[3] "świętego miecza"

#. ~ Description of "holy sword"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"This is a summoned medieval sword, between the lighter arming sword and "
"later two-handed swords in size.  It glows slightly and its edge is "
"exceedingly sharp."
msgstr ""
"Jest to przywołany średniowieczny miecz, który pod względem wielkości, w "
"rozmiarze pomiędzy mieczem jednoręcznym a późniejszym mieczem dwuręcznym. "
"Lekko połyskuje, a jego krawędź jest niezwykle ostra."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "auroral shell"
msgid_plural "auroral shell"
msgstr[0] "skorupa zorzy"
msgstr[1] "skorupy zorzy"
msgstr[2] "skorup zorzy"
msgstr[3] "skorupy zorzy"

#. ~ Description of "auroral shell"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "A sturdy shell that wraps your body, gaining a sturdy defense."
msgstr ""
"Solidna powłoka, która otacza twoje ciało, zapewniając solidną obronę."

#. ~ Description of "Pocket Sun"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A small, capsule-shaped field containing a stable portal to the sun.  You "
"can feel a solar energy radiate from it, and it saturate your body."
msgstr ""

#. ~ "menu_text" action message of item "Pocket Sun"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "Cover"
msgstr "Zakryj"

#. ~ "msg" action message of item "Pocket Sun"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "You cover the pocket sun, and now the gap doesn't emit light."
msgstr "Zakrywasz kieszonkowe słońce i teraz szczelina nie emituje światła."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "Covered Pocket Sun"
msgid_plural "Covered Pocket Suns"
msgstr[0] "zakryte kieszonkowe Słońce"
msgstr[1] "zakryte kieszonkowe Słońca"
msgstr[2] "zakrytych kieszonkowych Słońc"
msgstr[3] "zakrytego kieszonkowego Słońca"

#. ~ Description of "Covered Pocket Sun"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A small, capsule-shaped field containing a stable portal to the sun.  It is "
"currently covered."
msgstr ""
"Małe pole w kształcie kapsuły, zawierające stabilny portal do słońca. "
"Obecnie zasłonięty."

#. ~ "menu_text" action message of item "Covered Pocket Sun"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "Relieve"
msgstr "Uwolnij"

#. ~ "msg" action message of item "Covered Pocket Sun"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"You remove the cover on the pocket sun, and now the gap emits light again."
msgstr ""
"Zdejmujesz pokrywę na kieszonkowym Słońcu i teraz szczelina znów emituje "
"światło."

#. ~ Item name
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "magical throwing knife"
msgid_plural "magical throwing knives"
msgstr[0] "magiczny nóż do rzucania"
msgstr[1] "magiczne noże do rzucania"
msgstr[2] "magicznych noży do rzucania"
msgstr[3] "magicznego noża do rzucania"

#. ~ Description of "magical throwing knife"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A thin and flat knife made for throwing, wrapped in ethereal flames.  Its "
"ineffective cutting edge and odd shape makes it unsuitable for use as a "
"tool."
msgstr ""
"Cienki i płaski nóż do rzucania, spowity w eteryczne płomienie. Jego "
"nieskuteczna krawędź tnąca i dziwny kształt sprawiają, że nie nadaje się do "
"użycia jako narzędzie."

#. ~ Description of "magical throwing knife"
#: data/mods/Magiclysm/items/ethereal_items.json
msgid ""
"A thin and flat knife made for throwing, emanates cold.  Its ineffective "
"cutting edge and odd shape makes it unsuitable for use as a tool."
msgstr ""
"Cienki i płaski nóż przeznaczony do rzucania, emanuje zimnem. Jego "
"nieskuteczna krawędź tnąca i dziwny kształt sprawiają, że nie nadaje się do "
"użycia jako narzędzie."

#. ~ Description of "magical throwing knife"
#: data/mods/Magiclysm/items/ethereal_items.json
