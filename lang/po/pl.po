msgstr[1] "podnośniki hydrauliczne"
msgstr[2] "podnośników hydraulicznych"
msgstr[3] "podnośnika hydraulicznego"

#. ~ Description of "bottle jack"
#: data/json/items/tool/workshop.json
msgid "A portable hydraulic bottle jack used for lifting vehicles."
msgstr "Przenośny podnośnik hydrauliczny używany do podnoszenia pojazdów."

#. ~ Item name
#: data/json/items/tool/workshop.json
