#: src/bionics.cpp:667
#, c-format
msgid "%s activates their %s."
msgstr "%s aktywuje swoje %s."

#: src/bionics.cpp:686
#, c-format
msgid "Your %s is shorting out and can't be activated."
msgstr "Twoje %s ma krótkie spięcie i nie może być aktywowane."

#: src/bionics.cpp:698
#, c-format
msgid "You don't have the power to activate your %s."
msgstr "Nie masz mocy, by aktywować %s."

#: src/bionics.cpp:793
#, c-format
msgid "Deactivate your %s first!"
msgstr "Zdezaktywuj swój %s najpierw!"

#: src/bionics.cpp:800 src/character.cpp:7233
#, c-format
msgid "Stop wielding %s?"
msgstr "Przestać trzymać %s?"

#: src/bionics.cpp:822 src/bionics.cpp:1721
#, c-format
msgid "There is not enough humidity in the air for your %s to function."
msgstr "Nie ma wystarczająco wilgoci w powietrzu by twoje %s funkcjonowało."

#: src/bionics.cpp:827
#, c-format
msgid "Your %s issues a low humidity warning.  Efficiency will be reduced."
msgstr ""
"Twój %s pokazuje ostrzeżenie o niskiej wilgotności. Efektywność będzie "
"ograniczona."

#: src/bionics.cpp:835
msgid "You change your mind and turn it off."
msgstr "Zmieniasz zdanie i wyłączasz to."

#. ~Sound of a bionic sonic-resonator shaking the area
#: src/bionics.cpp:841
msgid "VRRRRMP!"
msgstr "WRRRRMP!"

#: src/bionics.cpp:854 src/bionics.cpp:876
#, c-format
msgid "You cannot activate %s while mounted."
msgstr "Nie możesz aktywować %s podczas jazdy wierzchowcem."

#: src/bionics.cpp:861
msgid "Your speed suddenly increases!"
msgstr "Twoja prędkość nagle wzrasta!"

#: src/bionics.cpp:863
msgid "Your muscles tear with the strain."
msgstr "Twoje mięśnie rozdziera napięcie!"

#: src/bionics.cpp:911
msgid "Your torsion ratchet locks onto your joints."
msgstr "Przekładnie zębate zaciska się na twoich stawach."

#: src/bionics.cpp:914
msgid "You can now run faster, assisted by joint servomotors."
msgstr "Możesz teraz biegać szybciej, wspomagany przez serwomotory stawów."

#: src/bionics.cpp:916
msgid "Start a fire where?"
msgstr "Gdzie rozpalić ogień?"

#: src/bionics.cpp:923 src/iuse_actor.cpp:288 src/iuse_actor.cpp:1229
msgid "You happily light a fire."
msgstr "Radośnie rozpalasz ogień."

#: src/bionics.cpp:933
#, c-format
msgid "Your radiation level: %d"
msgstr "Twój poziom napromieniowania: %d"

#: src/bionics.cpp:944
msgid "Safeguards kick in, and the bionic refuses to activate!"
msgstr "Zabezpieczenia zaczęły działać i bionika nie włącza się!"

#: src/bionics.cpp:952
msgid "Create an EMP where?"
msgstr "Stworzyć EMP gdzie?"

#: src/bionics.cpp:962
msgid "Your muscles hiss as hydraulic strength fills them!"
msgstr "Twoje mięśnie syczą gdy wypełnia je hydrauliczna siła!"

#. ~ Sound of hissing hydraulic muscle! (not quite as loud as a car horn)
#: src/bionics.cpp:964 src/bionics.cpp:1647
msgid "HISISSS!"
msgstr "SSSSSYK!"

#: src/bionics.cpp:975
#, c-format
msgid "Extract water from the %s"
msgstr "Pobierz wodę z %s"

#: src/bionics.cpp:990
msgid "There is no suitable corpse on this tile."
msgstr "Brak odpowiedniego ciała na tym polu."

#: src/bionics.cpp:1057
msgid "You unleash a powerful shockwave!"
msgstr "Wyzwalasz potężną falę uderzeniową!"

#: src/bionics.cpp:1073
#, c-format
msgid "Temperature: %s."
msgstr "Temperatura: %s."

#: src/bionics.cpp:1075 src/iuse.cpp:9018
#, c-format
msgid "Relative Humidity: %s."
msgstr "Względna wilgotność: %s."

#: src/bionics.cpp:1079 src/iuse.cpp:9029
#, c-format
msgid "Pressure: %s."
msgstr "Ciśnienie: %s."

#: src/bionics.cpp:1081 src/iuse.cpp:9043
#, c-format
msgid "Wind Speed: %.1f %s."
msgstr "Prędkość wiatru: %.1f %s."

#: src/bionics.cpp:1084 src/iuse.cpp:9047
#, c-format
msgid "Feels Like: %s."
msgstr "Odczuwalna temperatura: %s."

#: src/bionics.cpp:1088 src/iuse.cpp:9051
#, c-format
msgid "Wind Direction: From the %s."
msgstr "Kierunek wiatru: z %s."

#: src/bionics.cpp:1091
msgid "Perform which function:"
