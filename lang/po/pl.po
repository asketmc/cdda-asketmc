msgstr[0] "hipergeometryczna fotonika"
msgstr[1] "hipergeometryczne fotoniki"
msgstr[2] "hipergeometrycznych fotonik"
msgstr[3] "hipergeometrycznej fotoniki"

#. ~ Description of "hypergeometric photonics"
#: data/mods/Aftershock/items/crafting_scrap/circuity_scrap.json
msgid ""
"In your hands lies a self-contained digital universe.  Its programs glowing "
"like stars fixed on computational shells infinitely layered."
msgstr ""
"W twoich rękach leży autonomiczny cyfrowy wszechświat. Jego programy świecą "
"jak gwiazdy osadzone na nieskończonych warstwach powłoki obliczeniowej."

#. ~ Item name
#: data/mods/Aftershock/items/crafting_scrap/circuity_scrap.json
