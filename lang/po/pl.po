msgid_plural "triglav stars"
msgstr[0] "trzygłowa rozgwiazda"
msgstr[1] "trzygłowe rozgwiazdy"
msgstr[2] "trzygłowych rozgwiazd"
msgstr[3] "trzygłowej rozgwiazdy"

#. ~ Description of monster "triglav star"
#: data/mods/TropiCataclysm/monsters/tropical_nether.json
msgid ""
"A tiny alien creature brought by the portal storms.  It vaguely resembles a "
"sea star crawling on three spindly legs."
msgstr ""
"Maleńkie obce stworzenie przyniesione przez burze portalowe. Nieco "
"przypomina rozgwiazdę, pełzającą na trzech wrzecionowatych nogach."

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_nether.json
