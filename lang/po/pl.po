msgstr[3] "aktywnej bomby rurowej"

#. ~ Description of "active pipebomb"
#: data/json/items/tool/explosives.json
msgid ""
"This pipebomb's fuse is lit, and it will explode any second now.  Throw it "
"immediately!"
msgstr ""
"To aktywna bomba rurowa z zapalonym lontem, która wybuchnie lada chwila. "
"Rzuć ją niezwłocznie!"

#. ~ Item name
