msgid "Innawood"
msgstr "Życie w lesie"

#. ~ Description of MOD "Innawood"
#: data/mods/innawood/modinfo.json
msgid ""
"An untouched land that mankind has yet to reach.  Disables most traces of "
"civilization for that 'innawood' experience.  Recommend size of cities be "
"set to 0."
msgstr ""
"Nietknięta ziemia, do której ludzkość jeszcze nie dotarła. Wyłącza większość"
" śladów cywilizacji dla doświadczenia „życia w lesie”. Zalecane ustawienie "
"wielkości miast na 0."

#. ~ Profession name for male
#: data/mods/innawood/professions.json
msgctxt "profession_male"
msgid "Goat Man"
msgstr "Wielbiciel kóz"

#. ~ Description of profession "Goat Man" for male
#: data/mods/innawood/professions.json
msgctxt "prof_desc_male"
msgid ""
"Nobody around?  Oh well, it doesn't matter.  Your beloved goats are all you "
"need!"
msgstr ""
"Nikogo nie ma w pobliżu? No cóż, nie ma to znaczenia. Twoje ukochane kozy są"
" wszystkim, czego potrzebujesz!"

#. ~ Profession name for female
#: data/mods/innawood/professions.json
