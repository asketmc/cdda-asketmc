#: data/mods/Magiclysm/items/spell_scrolls.json
msgid "Freezes the touched target with intense cold."
msgstr "Zamraża dotknięty cel intensywnym zimnem."

#. ~ Spell name
#: data/mods/Magiclysm/Spells/kelvinist.json
msgid "Glide on Ice"
msgstr "Ślizg po lodzie"

#. ~ Description of spell "Glide on Ice"
