msgstr ""
"BŁĄD Ocena poziomu bionicznego: PEŁNY CYBORG. Autodok XI generacji nie może "
"działać. Proszę przenieść pacjenta do odpowiedniej placówki. Zamykanie."

#: src/iexamine.cpp:5265
msgid "Autodoc Mk. XI.  Status: Online.  Please choose operation."
msgstr "Autodok XI generacji. Status: aktywny. Proszę wybrać operację."

#: src/iexamine.cpp:5266
msgid "Choose Compact Bionic Module to install."
msgstr "Wybierz kompaktowy moduł bioniczny do instalacji."

#: src/iexamine.cpp:5267
msgid "Choose installed bionic to uninstall."
msgstr "Wybierz zainstalowaną bionikę do usunięcia."

#: src/iexamine.cpp:5272
msgid "ERROR NO SPACE AVAILABLE.  Operation impossible.  Exiting."
msgstr "BŁĄD BRAK MIEJSCA. Operacja niemożliwa. Zamykanie."

#: src/iexamine.cpp:5277
msgid "Personality_Override"
msgstr "Personality_Override"

#: src/iexamine.cpp:5279
msgid "C0RR#PTED?D#TA"
msgstr "C0RR#PTED?D#TA"

#: src/iexamine.cpp:5281 src/iexamine.cpp:5436
msgid "Choose bionic to uninstall"
msgstr "Wybierz bionikę do usunięcia"

