msgstr "Skonsumowano mutagen skoncentrowanej many."

#. ~ Description of effect type "Windrunning"
#: data/mods/Magiclysm/effects/effects.json
msgid "You are bolstered and pushed along by the power of the wind."
msgstr "Siła wiatru wspiera cię i pcha do przodu."

#. ~ Apply message of effect type "Windrunning"
#: data/mods/Magiclysm/effects/effects.json
msgid "You are bolstered and pushed along by the power of the wind"
msgstr "Siła wiatru wspiera cię i pcha do przodu"

#. ~ Remove message of effect type "Windrunning"
#: data/mods/Magiclysm/effects/effects.json
msgid "The wind at your back dies down."
msgstr "Wiatr wiejący ci w plecy ustaje."

#. ~ Description of effect type "Dark Sight"
#. ~ Description of effect type "Night Sight"
#. ~ Description of effect type "Eye gleam"
#: data/mods/Magiclysm/effects/effects.json
#: data/mods/Xedra_Evolved/effects/effects.json
msgid "You can see in the dark."
msgstr "Widzisz w ciemności."

#. ~ Apply message of effect type "Dark Sight"
#. ~ Apply message of effect type "Night Sight"
#. ~ Apply message of effect type "Eye gleam"
#: data/mods/Magiclysm/effects/effects.json
#: data/mods/Xedra_Evolved/effects/effects.json
msgid "Your sight adjusts to the darkness."
msgstr "Twój wzrok przywyka do ciemności."

#. ~ Remove message of effect type "Dark Sight"
#. ~ Remove message of effect type "Eye gleam"
#: data/mods/Magiclysm/effects/effects.json
#: data/mods/Xedra_Evolved/effects/effects.json
msgid "The darkness loses its shape."
msgstr "Ciemność traci swój kształt."

#. ~ Name of effect type id "effect_ethereal_grasp"
#: data/mods/Magiclysm/effects/effects.json
msgid "Ethereal Hold"
msgstr "Wieczysty uścisk"

#. ~ Description of effect type "Ethereal Hold"
#: data/mods/Magiclysm/effects/effects.json
msgid "Ghostly arms are trying to hold you in place!"
msgstr "Duchowe ręce próbują zatrzymać cię w miejscu!"

#. ~ Apply message of effect type "Ethereal Hold"
#: data/mods/Magiclysm/effects/effects.json
msgid "Ethereal arms shoot out of the ground and grab onto you!"
msgstr "Eteryczne ręce wyłaniają się z ziemi i chwytają cię!"

#. ~ Remove message of effect type "Ethereal Hold"
#: data/mods/Magiclysm/effects/effects.json
msgid "The ghostly arms fade away."
msgstr "Duchowe ręce znikają."

#. ~ Description of effect type "Invisibility"
#: data/mods/Magiclysm/effects/effects.json
msgid "Nothing can see you."
msgstr "Nic nie może cię dostrzec."

#. ~ Apply message of effect type "Invisibility"
#: data/mods/Magiclysm/effects/effects.json
msgid "You fade away."
msgstr "Znikasz."

#. ~ Remove message of effect type "Invisibility"
#: data/mods/Magiclysm/effects/effects.json
msgid "You can see your hands again."
msgstr "Znów możesz zobaczyć swoje dłonie."

#. ~ Name of effect type id "bless"
#: data/mods/Magiclysm/effects/effects.json
msgid "Blessed"
msgstr "Błogosławieństwo"

#. ~ Description of effect type "Blessed"
#: data/mods/Magiclysm/effects/effects.json
msgid "You are filled with energy that improves everything you do."
msgstr "Wypełnia cię energia, która ulepsza każde twoje działanie."

#. ~ Apply message of effect type "Blessed"
#: data/mods/Magiclysm/effects/effects.json
msgid "You are filled with energy that improves everything you do!"
msgstr "Wypełnia cię energia, która ulepsza każde twoje działanie!"

#. ~ Remove message of effect type "Blessed"
#: data/mods/Magiclysm/effects/effects.json
msgid "Your energy fades."
msgstr "Twoje energia zanika."

#. ~ Description of effect type "Grotesque Enhancement"
#. ~ Apply message of effect type "Grotesque Enhancement"
#: data/mods/Magiclysm/effects/effects.json
msgid ""
"Your body ripples with writhing alien muscles, your limbs lengthen, and your"
" eyes glow with a faint green."
msgstr ""
"Twoje ciało pulsuje od wijącej się nieziemskiej masy mięśni, kończyny "
"wydłużają się, a oczy jarzą się zielonym blaskiem."

#. ~ Remove message of effect type "Grotesque Enhancement"
#: data/mods/Magiclysm/effects/effects.json
msgid "Your body rapidly returns to normal."
msgstr "Twoje ciało gwałtownie wraca do normalności."

#. ~ Description of effect type "Vegetative Grasp"
#. ~ Description of effect type "Root Impale"
#: data/mods/Magiclysm/effects/effects.json
msgid "Roots and vines entangle your foes."
msgstr "Korzenie i pnącza owijają twoich wrogów."

#. ~ Apply message of effect type "Vegetative Grasp"
#: data/mods/Magiclysm/effects/effects.json
