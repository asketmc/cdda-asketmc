msgstr[1] "skafandry kriokomory (wł.)"
msgstr[2] "skafandrów kriokomory (wł.)"
msgstr[3] "skafandra kriokomory (wł.)"

#. ~ Description of "cryopod bodyglove (on)"
#. ~ Description of "Magellan exosuit (on)"
#. ~ Description of "frontier cryo suit (on)"
#: data/mods/Aftershock/items/armor/winter_suits.json
#: data/mods/Aftershock/items/tool_armor.json
msgid ""
"The temperature control units of this high-tech garment are currently "
"active, and continuously draining battery power.  Use it to turn them off."
msgstr ""
"Jednostki kontroli temperatury w tym zaawansowanym technologicznie ubraniu "
"są aktualnie aktywne i stale pobierają energię z baterii. Użyj go, aby je "
"wyłączyć."

