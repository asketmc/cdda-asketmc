#: data/mods/Aftershock/recipes/basecamps/recipe_overwrites.json
msgid "Let's install an anvil, some quenching containers and a workbench."
msgstr ""
"Zainstalujmy kowadło, kilka pojemników do hartowania i stół warsztatowy."

