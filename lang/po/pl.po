#, c-format
msgid ""
"The %s already contains some %s, you can't add a different liquid to it."
msgstr "W %s jest już trochę %s, nie możesz tam dolać innego płynu."

#: src/iexamine.cpp:3803
#, c-format
msgid "The %s is full."
msgstr "%s jest pełny."

#: src/iexamine.cpp:3856
#, c-format
msgid "Dig up %s?  This kills the tree!"
msgstr "Wykopać %s? To zabije drzewo!"

#: src/iexamine.cpp:3868
msgid "You could dig this tree up for roots…"
msgstr "Można by wykopać drzewo dla korzeni…"

#: src/iexamine.cpp:3883
msgid "Use which container to collect sap?"
msgstr "Użyć jakiego pojemnika do zebrania soku?"

#: src/iexamine.cpp:3889
msgid "You need a tool to drill the crust to tap this maple tree."
msgstr ""
"Potrzebujesz narzędzia do przewiercenia kory, by drenować to drzewo klonowe."

#: src/iexamine.cpp:3895
msgid ""
"You need a tool to hammer the spile into the crust to tap this maple tree."
msgstr ""
"Potrzebujesz narzędzie do wbicia zatyczki w korę, by drenować to drzewo "
"klonowe."

#: src/iexamine.cpp:3902
#, c-format
msgid "You need a %s to tap this maple tree."
msgstr "Potrzebujesz %s, by drenować to drzewo klonowe."

#: src/iexamine.cpp:3914
msgid "You drill the maple tree crust and tap a spile into the prepared hole."
msgstr "Wiercisz skorupę klonu i wbijasz kołek w przygotowany otwór."

#: src/iexamine.cpp:3921 src/iexamine.cpp:3999
#, c-format
msgid "You hang the %s under the spile to collect sap."
msgstr "Wieszasz %s pod szpikulcem, aby zebrać sok."

#: src/iexamine.cpp:3924 src/iexamine.cpp:4002
msgid "No container added.  The sap will just spill on the ground."
msgstr "Nie dodano pojemnika. Sok rozleje się na ziemię."

#: src/iexamine.cpp:3961
msgid "Remove tap"
msgstr "Usuń kranik"

#: src/iexamine.cpp:3963
#, c-format
msgid "Add a container to receive the %s"
msgstr "Dodaj pojemnik, aby uzyskać %s"

#: src/iexamine.cpp:3964
#, c-format
msgid "Harvest current %s (%d)"
msgstr "Zbierz obecne %s (%d)"

#: src/iexamine.cpp:3966
msgid "Remove container"
msgstr "Usuń pojemnik"

#: src/iexamine.cpp:3974
msgid "You need a hammering tool to remove the spile from the crust."
msgstr "Potrzebujesz narzędzie do usunięcia zatyczki z kory."

#: src/iexamine.cpp:3979
#, c-format
msgid "You remove the %s."
msgstr "Usuwasz %s."

#: src/iexamine.cpp:4033
msgid "The shrub offers up a fruit, then crumbles into a fungal bed."
msgstr "Krzak oferuje owoc, po czym zapada się w grzybicze podłoże."

#: src/iexamine.cpp:4047
msgid ""
"We have located a particularly vital nutrient deposit underneath this "
"location."
msgstr ""
"Zlokalizowaliśmy szczególnie bogaty depozyt substancji odżywczych pod tą "
"lokalizacją."

#: src/iexamine.cpp:4048
msgid "Additional nourishment is available."
msgstr "Dodatkowy pokarm jest dostępny."

#: src/iexamine.cpp:4054
msgid "The tree offers up a fruit, then shrivels into a fungal tree."
msgstr "Drzewo oferuje owoc, po czym kurczy się w grzybicze drzewo."

#: src/iexamine.cpp:4068
#, c-format
msgid "Forage through %s?"
msgstr "Przejrzeć %s w poszukiwaniu żywności?"

#: src/iexamine.cpp:4073
#, c-format
msgid "You forage through the %s."
msgstr "Przeszukujesz %s."

#: src/iexamine.cpp:4099
#, c-format
msgid "That %s looks too dangerous to mess with.  Best leave it alone."
msgstr ""
"Ten %s wygląda na tyle groźnie, żeby z nim  nie kombinować. Najlepiej "
"zostawić go w spokoju."

#: src/iexamine.cpp:4105
#, c-format
msgid "There is a %s there.  Take down?"
msgstr "Jest tam %s. Rozebrać?"

#: src/iexamine.cpp:4108
#, c-format
msgid "The %s is taken down."
msgstr "%s jest rozebrane."

#: src/iexamine.cpp:4113
#, c-format
msgid "There is a %s there.  Disarm?"
msgstr "Jest tam %s. Rozbroić?"

#: src/iexamine.cpp:4141
msgid "You disarm the trap!"
msgstr "Rozbrajasz pułapkę!"

#: src/iexamine.cpp:4147
msgid "You fail to disarm the trap."
msgstr "Nie udaje ci się rozbroić pułapki."

#: src/iexamine.cpp:4152
msgid "You fail to disarm the trap, and you set it off!"
msgstr "Nie udaje ci się rozbroić pułapki; uruchamiasz ją!"

#: src/iexamine.cpp:4183
#, c-format
msgid "Unfinished task: %s, %d%% complete here, continue construction?"
msgstr "Nieukończone zadanie: %s, ukończono tu %d%%, kontynuować budowę?"

#: src/iexamine.cpp:4185
msgid "Cancel construction?"
msgstr "Przerwać budowę?"

#: src/iexamine.cpp:4282
#, c-format
msgid "This %s can not be reloaded!"
msgstr "Tego %s nie można przeładować!"

#: src/iexamine.cpp:4290
#, c-format
msgid "The %1$s contains %2$d %3$s.  Unload?"
msgstr "Ten %1$s zawiera %2$d %3$s. Rozładować?"

#: src/iexamine.cpp:4303
#, c-format
msgid "You remove %1$s from the %2$s."
msgstr ""

#. ~ Reloading or restocking a piece of furniture, for example a forge.
