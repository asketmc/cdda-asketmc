#. ~ Item name
#: data/mods/Magiclysm/items/black_dragon_items.json
msgid "black dragonscale helmet"
msgid_plural "black dragonscale helmets"
msgstr[0] "hełm z łuski czarnego smoka"
msgstr[1] "hełmy z łuski czarnego smoka"
msgstr[2] "hełmów z łuski czarnego smoka"
msgstr[3] "hełmu z łuski czarnego smoka"

#. ~ Description of "black dragonscale helmet"
#: data/mods/Magiclysm/items/black_dragon_items.json
msgid ""
"A helmet made from black incredibly durable dragonscale, held together with "
"black dragonhide.  It comes equipped with a full face visor with only a thin"
" slit to see out of.  Activate to raise the visor."
msgstr ""
"Hełm wykonany z czarnej, niezwykle wytrzymałej smoczej łuski, połączonej z "
"czarną smoczą skórą. Wyposażony jest w zasłonę zakrywającą całą twarz, przez"
" którą widać tylko cienką szczelinę. Aktywuj, aby podnieść zasłonę."

#. ~ Item name
#: data/mods/Magiclysm/items/black_dragon_items.json
msgid "black dragonscale helmet (raised visor)"
msgid_plural "black dragonscale helmets (raised visor)"
msgstr[0] "hełm z łuski czarnego smoka (uniesiona zasłona)"
msgstr[1] "hełmy z łuski czarnego smoka (uniesiona zasłona)"
msgstr[2] "hełmów z łuski czarnego smoka (uniesiona zasłona)"
msgstr[3] "hełmu z łuski czarnego smoka (uniesiona zasłona)"

#. ~ Description of "black dragonscale helmet (raised visor)"
#: data/mods/Magiclysm/items/black_dragon_items.json
msgid ""
"A helmet made from incredibly durable black dragonscale, held together with "
"black dragonhide.  The visor is raised."
msgstr ""
"Hełm wykonany z niewiarygodnie wytrzymałej czarnej smoczej łuski, połączonej"
" z czarną smoczą skórą. Zasłona jest podniesiona."

