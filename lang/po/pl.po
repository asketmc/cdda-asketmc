msgstr[2] "porcji słonej wody"
msgstr[3] "porcji słonej wody"

#. ~ Description of "salt water"
#: data/json/items/chemicals_and_resources.json
msgid "Water with salt added.  Not good for drinking."
msgstr "Woda z solą. Nie nadaje się do picia."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "soapy water"
msgid_plural "soapy water"
msgstr[0] "mydlana woda"
msgstr[1] "porcje mydlanej wody"
msgstr[2] "porcji mydlanej wody"
msgstr[3] "porcji mydlanej wody"

#. ~ Description of "soapy water"
#: data/json/items/chemicals_and_resources.json
msgid "Water with soap added.  Not good for drinking."
