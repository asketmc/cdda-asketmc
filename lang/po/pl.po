msgstr[2] "porcji żwiru"
msgstr[3] "porcji żwiru"

#. ~ Description of "gravel"
#: data/json/items/chemicals_and_resources.json
msgid "A handful of gravel, smaller than pebbles but larger than sand."
msgstr "Garść żwiru, mniejszego niż kamyki, ale większego niż piasek."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "shredded rubber"
msgid_plural "shredded rubber"
msgstr[0] "rozdrobniona guma"
msgstr[1] "kawałki rozdrobnionej gumy"
msgstr[2] "kawałków rozdrobnionej gumy"
msgstr[3] "kawałka rozdrobnionej gumy"

#. ~ Description of "shredded rubber"
#: data/json/items/chemicals_and_resources.json
msgid "A handful of shredded rubber, usable as a mulch now."
msgstr "Garstka rozdrobnionej gumy, użyteczna jako mulcz."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "limestone"
msgid_plural "limestone"
