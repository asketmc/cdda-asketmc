#. ~ Profession name for male
#: data/mods/CRT_EXPANSION/scenarios/crt_classes.json
msgctxt "profession_male"
msgid "C.R.I.T NCO"
msgstr "Podoficer CRIT"

#. ~ Description of profession "C.R.I.T NCO" for male
#: data/mods/CRT_EXPANSION/scenarios/crt_classes.json
msgctxt "prof_desc_male"
msgid ""
"You were a senior NCO, relaying orders to your squad was an everyday task.  "
"When the cataclysm struck, your expertise helped save everyone time and time"
" again until it all fell apart."
msgstr ""
"Byłeś starszym podoficerem, a przekazywanie rozkazów swojemu oddziałowi było"
" codziennym zadaniem. Kiedy nadszedł Kataklizm, twoja wiedza pomogła "
"uratować wszystkich, dopóki wszystko się nie rozpadło."

#. ~ Profession name for female
#: data/mods/CRT_EXPANSION/scenarios/crt_classes.json
msgctxt "profession_female"
msgid "C.R.I.T NCO"
msgstr "Podoficerka CRIT"

