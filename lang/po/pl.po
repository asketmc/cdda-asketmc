#: data/json/vehicleparts/boards.json
msgid ""
"A strong metal wall.  Keeps zombies outside the vehicle and prevents people "
"from seeing through it."
msgstr ""
"Wytrzymała metalowa ściana. Zatrzymuje zombie na zewnątrz i zapobiega "
"spoglądaniu do środka."

#. ~ Vehicle part name
#: data/json/vehicleparts/boards.json
msgid "heavy-duty board"
msgstr "wytrzymała deska"

#. ~ Vehicle part name
#: data/json/vehicleparts/boards.json
msgid "heavy-duty quarterpanel"
msgstr "wytrzymała karoseria"

#. ~ Description of vehicle part "heavy-duty quarterpanel"
#: data/json/vehicleparts/boards.json
msgid ""
"A half-height strong metal wall.  Keeps zombies outside the vehicle but "
"allows people to see over it."
msgstr ""
"Połowiczna wytrzymała metalowa ściana. Zatrzymuje zombie na zewnątrz "
"pojazdu, ale pozwala zajrzeć ponad nią."

#. ~ Vehicle part name
#: data/json/vehicleparts/boards.json
