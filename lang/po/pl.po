msgid_plural "aer jellies"
msgstr[0] "meduza aerozolowa"
msgstr[1] "meduzy aerozolowe"
msgstr[2] "meduz aerozolowych"
msgstr[3] "meduzy aerozolowej"

#. ~ Description of monster "aer jelly"
#: data/mods/TropiCataclysm/monsters/tropical_nether.json
msgid ""
"A tiny flying alien creature brought by the portal storms.  It vaguely "
"resembles a jellyfish with balloon-like body."
msgstr ""
"Małe latające obce stworzenie przyniesione przez burze portalowe. Nieco "
"przypomina meduzę o ciele przypominającym balon."

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_nether.json
