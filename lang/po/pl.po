msgstr[2] "fioletowych dywanów"
msgstr[3] "fioletowego dywanu"

#. ~ Description of terrain "purple carpet"
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "Soft purple carpet."
msgstr "Miękki fioletowy dywan."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "Carpet"
msgstr "Dywan"

#. ~ Description of terrain "Carpet"
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "Base concrete carpet!"
msgstr "Wykładzina betonowa!"

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "industrial red carpet"
msgstr "przemysłowy czerwony dywan"

#. ~ Description of terrain "industrial red carpet"
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"Firm, low-pile, high-durability carpet in a red color, for laying down on "
"bare concrete."
msgstr ""
"Mocna wykładzina o niskim profilu i wysokiej trwałości w kolorze czerwonym, "
"do układania na gołym betonie."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "industrial yellow carpet"
msgstr "przemysłowy żółty dywan"

#. ~ Description of terrain "industrial yellow carpet"
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"Firm, low-pile, high-durability carpet in a yellow color, for laying down on"
" bare concrete."
msgstr ""
"Mocna wykładzina o niskim profilu i wysokiej trwałości w kolorze żółtym, do "
"układania na gołym betonie."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "industrial green carpet"
msgstr "przemysłowy zielony dywan"

#. ~ Description of terrain "industrial green carpet"
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"Firm, low-pile, high-durability carpet in a green color, for laying down on "
"bare concrete."
msgstr ""
"Mocna wykładzina o niskim profilu i wysokiej trwałości w kolorze zielonym, "
"do układania na gołym betonie."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "industrial purple carpet"
msgstr "przemysłowy fioletowy dywan"

#. ~ Description of terrain "industrial purple carpet"
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"Firm, low-pile, high-durability carpet in a purple color, for laying down on"
" bare concrete."
msgstr ""
"Mocna wykładzina o niskim profilu i wysokiej trwałości w kolorze fioletowym,"
" do układania na gołym betonie."

#. ~ Description of terrain "carpet"
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "Base metal carpet!"
msgstr "Podstawowy metalowy dywan!"

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "bunker red carpet"
msgstr "czerwony dywan bunkra"

#. ~ Description of terrain "bunker red carpet"
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"Firm, low-pile, totally non-flammable carpet in a red color, with an "
"insulation layer beneath."
msgstr ""
"Mocna wykładzina o niskim profilu, całkowicie niepalna, w kolorze czerwonym,"
" z warstwą izolacyjną pod spodem."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "bunker yellow carpet"
msgstr "żółty dywan bunkra"

#. ~ Description of terrain "bunker yellow carpet"
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"Firm, low-pile, totally non-flammable carpet in a yellow color, with an "
"insulation layer beneath."
msgstr ""
"Mocna wykładzina o niskim profilu, całkowicie niepalna, w kolorze żółtym, z "
"warstwą izolacyjną pod spodem."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "bunker green carpet"
msgstr "zielony dywan bunkra"

#. ~ Description of terrain "bunker green carpet"
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"Firm, low-pile, totally non-flammable carpet in a green color, with an "
"insulation layer beneath."
msgstr ""
"Mocna wykładzina o niskim profilu, całkowicie niepalna, w kolorze zielonym, "
"z warstwą izolacyjną pod spodem."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "bunker carpet purple"
msgstr "fioletowy dywan bunkra"

#. ~ Description of terrain "bunker carpet purple"
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"Firm, low-pile, totally non-flammable carpet in a purple color, with an "
"insulation layer beneath."
msgstr ""
"Mocna wykładzina o niskim profilu, całkowicie niepalna, w kolorze "
"fioletowym, z warstwą izolacyjną pod spodem."

#. ~ Description of terrain "Carpet"
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "Base rock carpet!"
msgstr ""

