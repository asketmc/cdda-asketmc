msgid_plural "M2HB autonomous CROWS IIs"
msgstr[0] "autonomiczny CROWS II M2HB"
msgstr[1] "autonomiczne CROWS II M2HB"
msgstr[2] "autonomicznych CROWS II M2HB"
msgstr[3] "autonomicznego CROWS II M2HB"

#. ~ Description of monster "M2HB autonomous CROWS II"
#: data/json/monsters/turrets.json
msgid ""
"A remote weapon system derived from the M153 CROWS II and enhanced with "
"autonomous operation software.  This one is fitted with a .50 caliber M2HB "
"machine gun."
msgstr ""
"System zdalnego uzbrojenia wywodzący się z M153 CROWS II i wzbogacony o "
"oprogramowanie do autonomicznej obsługi. Ten egzemplarz jest wyposażony w "
"karabin maszynowy M2HB kalibru .50"

#. ~ Monster name
#: data/json/monsters/turrets.json
msgid "M249 autonomous CROWS II"
msgid_plural "M249 autonomous CROWS IIs"
msgstr[0] "autonomiczny CROWS II M249"
msgstr[1] "autonomiczne CROWS II M249"
msgstr[2] "autonomicznych CROWS II M249"
msgstr[3] "autonomicznego CROWS II M249"

#. ~ Description of monster "M249 autonomous CROWS II"
#: data/json/monsters/turrets.json
msgid ""
"A remote weapon system derived from the M153 CROWS II and enhanced with "
"autonomous operation software.  This one is fitted with a 5.56 caliber M249 "
"machine gun."
msgstr ""
"System zdalnego uzbrojenia wywodzący się z M153 CROWS II i wzbogacony o "
"oprogramowanie do autonomicznej obsługi. Ten egzemplarz jest wyposażony w "
"karabin maszynowy M249 kalibru 5,56 mm."

#. ~ Monster name
#: data/json/monsters/turrets.json data/mods/No_Hope/monsters.json
