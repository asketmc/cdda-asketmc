#: data/json/effects.json
msgid "At least one of your bionics is producing heat and warming you."
msgstr "Co najmniej jeden implant bioniczny produkuje ciepło i cię ogrzewa."

#. ~ Name of effect type id "winded"
#: data/json/effects.json
msgid "Winded"
msgstr "Bez tchu"

#. ~ Description of effect type "Winded"
#: data/json/effects.json
msgid ""
"You're short of breath.  Running and fighting will be difficult until you "
"recover."
msgstr ""
"Brakuje ci tchu. Bieganie i walka będą utrudnione zanim nie dojdziesz do "
"siebie."

