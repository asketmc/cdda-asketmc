msgstr[3] "napalmu"

#. ~ Description of "napalm"
#: data/json/items/fuel.json
msgid ""
"This is gasoline mixed with some other components to make it stick to the "
"surface and increase burning temperature, meant to be used with a "
"flamethrower."
msgstr ""
"To benzyna zmieszana z innymi dodatkami powodującymi jej przyleganie do "
"różnych powierzchni i zwiększającymi jej temperaturę spalania, przeznaczona "
"do miotaczy ognia."

#. ~ Item name
#: data/json/items/fuel.json
