#. ~ Snippet in category "tree_communion"
#: data/json/snippets/snippets.json
msgid "The trees speak of their far-flung relatives."
msgstr "Drzewa mówią o swoich dalekich krewnych."

#. ~ Snippet in category "tree_communion"
#: data/json/snippets/snippets.json
msgid "Visions of unfamiliar forests flicker through your mind."
msgstr "Wizje nieznanych lasów migoczą w twoim umyśle."

#. ~ Snippet in category "tree_communion"
#: data/json/snippets/snippets.json
msgid "You picture yourself as one branch among many."
msgstr "Przedstawiasz siebie jako jedną gałąź spośród wielu."

#. ~ Snippet in category "tree_communion"
#: data/json/snippets/snippets.json
msgid "New knowledge blooms within you."
msgstr "Nowa wiedza kwitnie w tobie."

#. ~ Snippet in category "tree_communion"
#: data/json/snippets/snippets.json
msgid "The horizon beckons with promises of pollen."
msgstr "Horyzont przywołuje obietnice pyłku."

#. ~ Snippet in category "tree_communion"
#: data/json/snippets/snippets.json
msgid "Your awareness grows in directions heretofore unknown."
msgstr "Twoja świadomość rośnie w nieznanych dotąd kierunkach."

#. ~ Snippet in category "tree_communion"
#: data/json/snippets/snippets.json
msgid "A tree falls in a forest, and you hear its sound."
msgstr "Drzewo spada w lesie i słyszysz jego dźwięk."

#. ~ Snippet in category "tree_communion"
#: data/json/snippets/snippets.json
msgid "You feel the hum of untold biomass."
msgstr "Czujesz pomruk niewypowiedzianej biomasy."

#. ~ Snippet in category "tree_communion"
#: data/json/snippets/snippets.json
msgid "A tingle of understanding runs from your roots and up your spine."
msgstr ""
"Dreszcz zrozumienia przebiega z twoich korzeni wprost w górę kręgosłupa."

#. ~ Snippet in category "tree_communion"
#: data/json/snippets/snippets.json
msgid "You gain new appreciation for the interconnectedness of life."
msgstr "Zaczynasz doceniać wspólnotę życia."

#. ~ Snippet in category "tree_communion"
#: data/json/snippets/snippets.json
msgid "You ask, and the trees answer."
msgstr "Pytasz, a drzewa odpowiadają."

#. ~ Snippet in category "tree_communion"
#: data/json/snippets/snippets.json
msgid "You see the forest for the trees."
msgstr "Widzisz las ponad drzewa."

#. ~ Snippet in category "tree_communion"
#: data/json/snippets/snippets.json
msgid ""
"In the minute shifts and pivots of the trees, you hear the language of the "
"universe."
msgstr "W mijaniu czasu i kołysaniu się drzew słyszysz język wszechświata."

#. ~ Snippet in category "headshop_graffiti"
#: data/json/snippets/snippets.json
