#. ~ Skill name
#: data/mods/Aftershock/skills.json
msgid "smart guns"
msgstr ""

#. ~ Description of skill "smart guns"
#: data/mods/Aftershock/skills.json
msgid ""
"Back in the 21st century marksmanship was an art whose mastery meant arduous"
" years of constant training and preparation.  There are computers for that "
"now."
msgstr ""

#. ~ Speech from speaker afs_mon_migoturret
#: data/mods/Aftershock/speech.json
msgid "\"I have no mouth and yet I scream!\""
msgstr "„Nie mam ust, a jednak krzyczę!”."

#. ~ Speech from speaker afs_mon_migoturret
#: data/mods/Aftershock/speech.json
msgid "\"¿Por qué?\""
msgstr "„¿Por qué?”"

#. ~ Speech from speaker afs_mon_migoturret
#: data/mods/Aftershock/speech.json
msgid "\"Come closer little one.\""
msgstr "„Podejdź bliżej malutki”."

#. ~ Speech from speaker afs_mon_migoturret
#: data/mods/Aftershock/speech.json
msgid "\"The better to eat you!  I don't actually think I eat anymore.\""
msgstr "„Lepiej cię zjeść! Tak naprawdę nie sądzę, żebym jeszcze jadł”."

#. ~ Speech from speaker afs_mon_migoturret
#: data/mods/Aftershock/speech.json
msgid "\"Cyrus said if I was patient, he could get me a new body.\""
msgstr "„Cyrus mówił, że jak będę cierpliwy to załatwi mi nowe ciało”."

#. ~ Speech from speaker afs_mon_migoturret
#: data/mods/Aftershock/speech.json
msgid "\"Quem é Você?\""
msgstr "„Quem é Você?”."

#. ~ Speech from speaker afs_mon_migoturret
#: data/mods/Aftershock/speech.json
msgid "\"Eu vou te matar!\""
msgstr "„Eu vou te matar!”."

#. ~ Speech from speaker afs_mon_migoturret
#: data/mods/Aftershock/speech.json
msgid "\"I can't keep myself from killing you, please run!\""
msgstr "„Nie mogę się powstrzymać by cię zabić, proszę uciekaj!”."

#. ~ Speech from speaker mon_utilibot_beehive
#: data/mods/Aftershock/speech.json
msgid "\"bzzzzzz.\""
msgstr "„bzzzzzz”."

#. ~ Speech from speaker mon_human_biomachine
#: data/mods/Aftershock/speech.json
msgid "\"west, west, west, west, west\""
msgstr "„zachód, zachód, zachód, zachód, zachód”"

#. ~ Speech from speaker mon_human_biomachine
#: data/mods/Aftershock/speech.json
msgid "\"east, east, east, east, east\""
msgstr "„wschód, wschód, wschód, wschód, wschód”"

#. ~ Speech from speaker mon_human_biomachine
#: data/mods/Aftershock/speech.json
msgid "\"south, south, south, south, south\""
msgstr "„południe, południe, południe, południe, południe”"

#. ~ Speech from speaker mon_human_biomachine
#: data/mods/Aftershock/speech.json
msgid "\"north, north, north, north, north\""
msgstr "„północ, północ, północ, północ, północ”"

#. ~ Speech from speaker mon_human_biomachine
#: data/mods/Aftershock/speech.json
msgid "\"Where am I?  Where am I?  Where am I?\""
msgstr "„Gdzie jestem? Gdzie jestem? Gdzie jestem?”"

#. ~ Speech from speaker mon_human_biomachine
#: data/mods/Aftershock/speech.json
msgid "\"It's very cold, It's very cold, It's very cold\""
msgstr "„Jest tak zimno, jest tak zimno, jest tak zimno”"

#. ~ Speech from speaker mon_human_biomachine
#: data/mods/Aftershock/speech.json
msgid "\"dark, dark, where is everything\""
msgstr "„ciemność, ciemność, gdzie się wszystko podziało”"

#. ~ Spell name
#: data/mods/Aftershock/spells.json
msgid "Cranial Explosion"
msgstr "Wybuch czaszki"

#. ~ Description of spell "Cranial Explosion"
#: data/mods/Aftershock/spells.json
