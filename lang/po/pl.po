msgstr[0] "permutator logiki bezprzyczynowej"
msgstr[1] "permutatory logiki bezprzyczynowej"
msgstr[2] "permutatorów logiki bezprzyczynowej"
msgstr[3] "permutatora logiki bezprzyczynowej"

#. ~ Description of "acausal logic permutator"
#: data/mods/Aftershock/items/crafting_scrap/circuity_scrap.json
msgid "It has given you an answer, but you are yet to ask anything."
msgstr "Udzielił ci odpowiedzi, ale nie padło jeszcze pytanie."

#. ~ Item name
#: data/mods/Aftershock/items/crafting_scrap/cloth_scrap.json
