msgid_plural "tequila"
msgstr[0] "tequila"
msgstr[1] "porcje tequili"
msgstr[2] "porcji tequili"
msgstr[3] "porcji tequili"

#. ~ Description of "tequila"
#: data/json/items/comestibles/alcohol.json
msgid ""
