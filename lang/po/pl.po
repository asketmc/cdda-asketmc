#. ~ Profession name for male
#: data/json/professions.json
msgctxt "profession_male"
msgid "Convict"
msgstr "Skazany"

#. ~ Description of profession "Convict" for male
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"Your trial was contentious, but ultimately you found yourself behind bars.  "
"The Cataclysm has offered you a chance to escape, but freedom may come with "
"a steep price."
msgstr ""
"Twój proces był kontrowersyjny, ale ostatecznie znalazłeś się za kratkami. "
"Kataklizm zaoferował ci szansę ucieczki, ale cena wolności może być wysoka."

#. ~ Profession name for female
#: data/json/professions.json
msgctxt "profession_female"
msgid "Convict"
msgstr "Skazana"

#. ~ Description of profession "Convict" for female
#: data/json/professions.json
msgctxt "prof_desc_female"
msgid ""
