#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Mommy?\""
msgstr "„Mamusiu?”."

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Come on, wake up…\""
msgstr "„Dalej, obudź się…”."

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Please help me.\""
msgstr "„Pomóż mi, proszę”."

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"It's so cold.\""
msgstr "„Jest tak zimno”."

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Take my hand.\""
msgstr "„Chwyć moją dłoń”."

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Cover your head, everyone!\""
msgstr "„Wszyscy uważać na głowy!”."

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"I love you and I'll never forget you.\""
msgstr "„Kocham cię i nigdy cię nie zapomnę”."

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Put it down!  We can talk about this…\""
msgstr "„Odłóż to, możemy o tym porozmawiać…”."

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"It'll be over quick.  I promise.\""
msgstr "„To się szybko skończy. Obiecuję”."

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "agonized screaming!"
msgstr "wrzask agonii!"

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"I DON'T WANT TO DIE!\""
msgstr "„NIE CHCĘ UMIERAĆ!”."

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"HELP!  HEEEEELP!\""
msgstr "„POMOCY! POMOOOCY!”."

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"What IS that?\""
msgstr "„Co TO było?”."

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Here!  Someone's here!\""
msgstr "„Tutaj! Ktoś tu jest!”."

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Come on, come on, they can help us!\""
msgstr "„Chodź, chodź, oni mogą nam pomóc!”."

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Get it OFF ME!\""
msgstr "„ZDEJMIJ to ze mnie!”."

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Don't look at the sky!\""
msgstr "„Nie patrz na niebo!”."

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Hello?  Hello?!\""
msgstr "„Halo? Halo?!”."

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "quiet crying."
msgstr "cichy płacz"

