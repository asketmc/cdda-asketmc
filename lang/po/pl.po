msgid "cotton patch"
msgid_plural "cotton patches"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ This is calculated from medium weight cotton at 203 GSM, with a size of 6
#. inches square
#. ~ Description of "cotton patch"
#: data/json/items/tool/toiletries.json
msgid ""
"A 6 inch square cotton patch, suitable for use in repairing and tailoring of"
" clothing."
msgstr ""
"Bawełniana łata kwadratowa o powierzchni około 15 cm kwadratowych, "
"odpowiednia do stosowania przy naprawach i krawiectwie odzieży."

#. ~ Item name
#: data/json/items/tool/toiletries.json
msgid "razor blade"
msgid_plural "razor blades"
msgstr[0] "żyletka"
msgstr[1] "żyletki"
msgstr[2] "żyletek"
msgstr[3] "żyletki"

#. ~ Description of "razor blade"
#: data/json/items/tool/toiletries.json
