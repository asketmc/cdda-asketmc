msgstr[1] "skrzynkowe stacje ładowania"
msgstr[2] "skrzynkowych stacji ładowania"
msgstr[3] "skrzynkowej stacji ładowania"

#. ~ Description of vehicle part "foot locker recharging station"
#: data/json/furniture_and_terrain/appliances.json
msgid ""
"An appliance for recharging batteries.  When turned on, it steadily charges "
"any rechargeable batteries (battery cells, lead-acid batteries, etc) placed "
"directly in the attached storage space."
msgstr ""
"Urządzenie do ładowania akumulatorów. Po włączeniu ładuje w sposób ciągły "
"wszystkie akumulatory (ogniwa, baterie kwasowo-ołowiowe itp.) umieszczone "
"bezpośrednio w dołączonym schowku."

#. ~ Vehicle part name
#. ~ Item name
#: data/json/furniture_and_terrain/appliances.json
