msgstr ""
"Skóry czarnych smoków, zwinięte ciasno razem do przechowywania. Demontuj, by"
" rozpakować."

#. ~ Item name
#: data/mods/Magiclysm/items/black_dragon_items.json
msgid "pair of black dragonscale boots"
