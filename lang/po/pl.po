#: data/mods/Magiclysm/Spells/kelvinist.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid ""
"You're pretty sure you saw this in a game somewhere.  You fire a short-range"
" cone of ice and cold."
msgstr ""
"Jesteś pewien, że widziałeś to gdzieś w jakiejś grze. Wystrzeliwujesz "
"krótkodystansowy stożek lodu i zimna."

