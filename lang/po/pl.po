msgstr ""
"Twoje sny o byciu super-człowiekiem mutantem poprzez manipulację genetyczną "
"trochę nie spełniły twoich oczekiwań, ale naukowcy twierdzą, że jesteś "
"gotowa. Czas na próby polowe."

#. ~ Profession name for male
#: data/json/professions.json
msgctxt "profession_male"
msgid "Hitchhiker"
msgstr "Autostopowicz"

#. ~ Description of profession "Hitchhiker" for male
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"Your house has been demolished and your planet destroyed, but at least you "
"still have your towel."
msgstr ""
"Twój dom wyburzono, planetę zniszczono, ale przynajmniej nadal masz swój "
"ręcznik."

#. ~ Profession name for female
#: data/json/professions.json
