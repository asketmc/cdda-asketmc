msgstr[3] "szeregu M203"

#. ~ Description of gun "M203 array"
#: data/json/items/gun/40x46mm.json
msgid ""
"An array of six M203 grenade launchers for use on the TALON UGV platform."
msgstr "Zestaw sześciu granatników M203 do użytku na UGV TALON."

#. ~ Name of a gun
#: data/json/items/gun/40x53mm.json
msgid "Mark 19 grenade launcher"
msgid_plural "Mark 19 grenade launchers"
msgstr[0] "granatnik Mark 19"
msgstr[1] "granatniki Mark 19"
msgstr[2] "granatników Mark 19"
msgstr[3] "granatniku Mark 19"

#. ~ Description of gun "Mark 19 grenade launcher"
#: data/json/items/gun/40x53mm.json
msgid ""
"A heavy, tripod-mounted belt-fed grenade launcher used by the US Military "
"since the start of the Cold War all the way to the Cataclysm, and if you can"
" find some 40mm grenades, maybe even beyond."
msgstr ""
"Ciężki granatnik na trójnogu zasilany taśmą amunicyjną, używany przez wojska"
" amerykańskie od początku zimnej wojny, aż do Kataklizmu, a jak znajdziesz "
"trochę 40 mm granatów to nawet i dłużej."

#. ~ Name of a gun
#: data/json/items/gun/410shot.json
msgid "Saiga-410"
msgid_plural "Saiga-410s"
msgstr[0] "Sajga-410"
msgstr[1] "Sajga-410"
msgstr[2] "Sajga-410"
msgstr[3] "Sajga-410"

#. ~ Description of gun "Saiga-410"
#: data/json/items/gun/410shot.json
msgid ""
"The Saiga-410 is a semi-automatic shotgun designed on the same Kalashnikov "
"pattern as the AK-47 rifle.  It reloads with a magazine, rather than one "
"shell at a time like most shotguns."
msgstr ""
"Sajga-410 to półautomatyczna strzelba oparta na tym samym wzorze "
"Kałasznikowa co karabinek AK-47. Posiada magazynek, w przeciwieństwie do "
"innych strzelb przeładowywanych nabój po naboju."

#. ~ Name of a gun
#: data/json/items/gun/410shot.json
