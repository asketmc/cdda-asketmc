msgstr "Asystują ci podczas praktyki chirurgicznej."

#. ~ Name of effect type id "masked_scent"
#: data/json/effects.json
msgid "Masked Scent"
msgstr "Zamaskowany zapach"

#. ~ Description of effect type "Masked Scent"
#: data/json/effects.json
msgid "Your scent is masked by another one."
msgstr "Inny zapach maskuje twój własny."

#. ~ Name of effect type id "got_checked"
#: data/json/effects.json
msgid "Got a Check-up"
msgstr "Badanie lekarskie"

#. ~ Description of effect type "Got a Check-up"
#: data/json/effects.json
msgid ""
"Your received a complete check-up and are now aware of the state of your "
"health."
msgstr ""
"Zbadano cię pod kątem medycznym i masz teraz świadomość swojego stanu "
