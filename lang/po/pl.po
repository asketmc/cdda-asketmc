msgid_plural "gunsmith repair kits"
msgstr[0] "zestaw rusznikarski"
msgstr[1] "zestawy rusznikarskie"
msgstr[2] "zestawów rusznikarskich"
msgstr[3] "zestawu rusznikarskiego"

