#. ~ Description of terrain "card reader"
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"This is a smartcard reader.  Text written on a post note above reads 'CO-OP "
"MEMBERS ONLY'."
msgstr ""
"Jest to czytnik kart elektronicznych. Tekst napisany na kartce pocztowej "
"powyżej brzmi: „TYLKO CZŁONKOWIE SPÓŁDZIELNI”."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "Maintenance: green zone card reader"
msgstr "Konserwacja: czytnik kart zielonej strefy"

#. ~ Description of terrain "Maintenance: green zone card reader"
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"This is a smartcard reader.  It sports the stylized symbol of an atom and a "
"wrench on a green background.  You could swipe a maintenance employee badge "
"near it to unlock the gates."
msgstr ""
"Jest to czytnik kart elektronicznych. Na zielonym tle widnieje stylizowany "
"symbol atomu i klucza nastawnego. Aby odblokować bramę, można przy nim "
"przeciągnąć identyfikator pracownika technicznego."

#. ~ Query message of terrain "Maintenance: green zone card reader"
#. ~ Query message of terrain "Freight hauler access card reader"
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "Are you sure you want to open this gate?"
msgstr ""

#. ~ Success message of terrain "Maintenance: green zone card reader"
#. ~ Success message of terrain "Freight hauler access card reader"
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "You opened the gate!"
msgstr ""

#. ~ Redundant message of terrain "Maintenance: green zone card reader"
#. ~ Redundant message of terrain "Freight hauler access card reader"
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "The gate is already open."
msgstr ""

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "Maintenance: ocher zone card reader"
msgstr "Konserwacja: czytnik kart ochrowej strefy"

#. ~ Description of terrain "Maintenance: ocher zone card reader"
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"This is a smartcard reader.  It sports the stylized symbol of an atom and a "
"wrench on a ocher background.  You could swipe a maintenance employee badge "
"near it to unlock the gates."
msgstr ""
"Jest to czytnik kart elektronicznych. Na ochrowym tle widnieje stylizowany "
"symbol atomu i klucza nastawnego. Aby odblokować bramę, można po nim "
"przeciągnąć identyfikator pracownika technicznego."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "Maintenance: blue zone card reader"
msgstr "Konserwacja: czytnik kart niebieskiej strefy"

#. ~ Description of terrain "Maintenance: blue zone card reader"
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"This is a smartcard reader.  It sports the stylized symbol of an atom and a "
"wrench on a blue background.  You could swipe a maintenance employee badge "
"near it to unlock the gates."
msgstr ""
"Jest to czytnik kart elektronicznych. Na niebieskim tle widnieje stylizowany"
" symbol atomu i klucza nastawnego. Aby odblokować bramę, można po nim "
"przeciągnąć identyfikator pracownika technicznego."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "Freight hauler access card reader"
msgstr "Czytnik kart dostępu dla przewoźników towarowych"

#. ~ Description of terrain "Freight hauler access card reader"
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"This is a smartcard reader.  It sports the stylized symbol of an atom and a "
"truck.  You could swipe a transporter's badge near it to unlock the gates."
msgstr ""
"Jest to czytnik kart elektronicznych. Widnieje na nim stylizowany symbol "
"atomu i ciężarówki. Można po nim przeciągnąć identyfikator pracownika "
"logistyki, aby odblokować bramę."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "Security: yellow zone card reader"
msgstr "Ochrona: czytnik kart żółtej strefy"

#. ~ Description of terrain "Security: yellow zone card reader"
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"This is a smartcard reader.  It sports the stylized symbol of an atom and a "
"taser on a yellow background.  You could swipe a security employee badge "
"near it to unlock the gates."
msgstr ""
"To jest czytnik kart elektronicznych. Na żółtym tle widnieje stylizowany "
"symbol atomu i paralizatora. Możesz przeciągnąć po nim odznaką pracownika "
"ochrony, aby odblokować bramę."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "Security: magenta zone card reader"
msgstr "Ochrona: czytnik kart strefy magenta"

#. ~ Description of terrain "Security: magenta zone card reader"
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"This is a smartcard reader.  It sports the stylized symbol of an atom and a "
"pistol on a magenta background.  You could swipe a security employee badge "
"near it to unlock the gates."
msgstr ""
"Jest to czytnik kart elektronicznych. Na magentowym tle widnieje stylizowany"
" symbol atomu i pistoletu. Można po nim przeciągnąć odznaką pracownika "
"ochrony, aby odblokować bramę."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "Security: black zone card reader"
msgstr "Ochrona: czytnik kart czarnej strefy"

#. ~ Description of terrain "Security: black zone card reader"
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"This is a smartcard reader.  It sports the stylized symbol of an atom and a "
"rifle on a black background.  You could swipe a security employee badge near"
" it to unlock the gates."
msgstr ""
"Jest to czytnik kart elektronicznych. Na czarnym tle widnieje stylizowany "
"symbol atomu i karabinu. Można po nim przeciągnąć odznaką pracownika "
"ochrony, aby odblokować bramę."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "Researcher: light green zone card reader"
msgstr "Naukowiec: czytnik kart jasnozielonej strefy"

#. ~ Description of terrain "Researcher: light green zone card reader"
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"This is a smartcard reader.  It sports the stylized symbol of an atom and a "
"flask on a light green background.  You could swipe a researcher scientist "
"badge near it to unlock the gates."
msgstr ""
"Jest to czytnik kart elektronicznych. Przedstawia stylizowany symbol atomu i"
" kolby na jasnozielonym tle. Aby odblokować bramę, można po nim przeciągnąć "
"odznaką naukowca."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "Researcher: pink zone card reader"
msgstr "Naukowiec: czytnik kart różowej strefy"

#. ~ Description of terrain "Researcher: pink zone card reader"
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"This is a smartcard reader.  It sports the stylized symbol of an atom and a "
"flask on a pink background.  You could swipe a researcher scientist badge "
"near it to unlock the gates."
msgstr ""
"Jest to czytnik kart elektronicznych. Przedstawia stylizowany symbol atomu i"
" kolby na różowym tle. Aby odblokować bramę, można po nim przeciągnąć "
"odznaką naukowca."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "Researcher: cyan zone card reader"
msgstr "Naukowiec: czytnik kart cyjanowej strefy"

#. ~ Description of terrain "Researcher: cyan zone card reader"
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"This is a smartcard reader.  It sports the stylized symbol of an atom and a "
"flask on a cyan background.  You could swipe a researcher scientist badge "
"near it to unlock the gates."
msgstr ""
"Jest to czytnik kart elektronicznych. Przedstawia stylizowany symbol atomu i"
" kolby na cyjanowym tle. Aby odblokować bramę, można po nim przeciągnąć "
"odznaką naukowca."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "Medical: red zone card reader"
msgstr "Medycyna: czytnik kart czerwonej strefy"

#. ~ Description of terrain "Medical: red zone card reader"
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"This is a smartcard reader.  It sports the stylized symbol of an atom and a "
"syringe on a red background.  You could swipe a researcher scientist badge "
"near it to unlock the gates."
msgstr ""
"Jest to czytnik kart elektronicznych. Przedstawia stylizowany symbol atomu i"
" strzykawki na czerwonym tle. Aby odblokować bramę, można po nim przeciągnąć"
" odznaką naukowca."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "broken card reader"
msgstr "uszkodzony czytnik kart"

#. ~ Description of terrain "broken card reader"
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"This is a smartcard reader, but it doesn't seem to be functioning.  Probably"
" because there's no more blinking red LED."
msgstr ""
"Jest to czytnik kart inteligentnych, ale wydaje się, że nie działa. "
"Prawdopodobnie dlatego, że nie miga już czerwona dioda LED."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "elevator controls"
msgstr "sterowanie windą"

#. ~ Description of terrain "elevator controls"
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"This is the control face for an elevator.  You could press the appropriate "
"button to take you to your choice of floor."
msgstr ""
"To jest panel sterowania windy. Możesz nacisnąć odpowiedni przycisk, który "
"zabierze cię na wybrane przez ciebie piętro."

#. ~ Message about the player in an effect
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "The elevator starts moving before you can touch the panel."
msgstr ""

#. ~ Message about the player in an effect
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"The control panels' screen flashes before displaying \"UNAUTHORIZED\" in "
"bold red letters."
msgstr ""

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "powerless controls"
msgstr "sterowanie niewymagające zasilania"

#. ~ Description of terrain "powerless controls"
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "This is the control face for an elevator.  It's currently unpowered."
msgstr "To jest panel sterowania windy. Obecnie nie ma zasilania."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "dark pedestal"
msgstr "mroczny piedestał"

#. ~ Description of terrain "dark pedestal"
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"A dark stone pedestal covered in ancient, unintelligible symbols.  Looks "
"ominous."
msgstr ""
"Mroczny kamienny piedestał pokryty starożytnymi, niezrozumiałymi symbolami. "
"Wygląda złowieszczo."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "light pedestal"
msgstr "jasny piedestał"

#. ~ Description of terrain "light pedestal"
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "A light stone pedestal covered in ancient, unintelligible symbols."
msgstr ""
"Lekki kamienny postument pokryty starożytnymi, niezrozumiałymi symbolami."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "yellow switch"
msgstr "żółty przełącznik"

#. ~ Description of terrain "yellow switch"
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "A yellow switch.  Should you activate it?"
msgstr "Żółty przełącznik. Czy masz chęć go aktywować?"

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "cyan switch"
msgstr "cyjanowy przełącznik"

#. ~ Description of terrain "cyan switch"
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "A cyan switch.  Should you activate it?"
msgstr "Cyjanowy przełącznik. Czy masz chęć go aktywować?"

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "purple switch"
msgstr "fioletowy przełącznik"

#. ~ Description of terrain "purple switch"
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "A purple switch.  Should you activate it?"
msgstr "Fioletowy przełącznik. Czy masz chęć go aktywować?"

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "checkered switch"
msgstr "przełącznik w kratę"

#. ~ Description of terrain "checkered switch"
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "A checkered switch.  Should you activate it?"
msgstr "Przełącznik w kratę. Czy masz chęć go aktywować?"

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-mechanisms.json
#: data/mods/Aftershock/maps/furniture_and_terrain/terrain.json
msgid "nuclear reactor core"
msgstr "rdzeń reaktora atomowego"

#. ~ Description of terrain "nuclear reactor core"
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"Naval A1B reactor, used in Gerald R. Ford-class aircraft carriers, and can "
"produce enough steam to generate 125 megawatts of energy."
msgstr ""
"Reaktor A1B marynarki wojennej, wykorzystywany na lotniskowcach klasy "
"Geralda R. Forda, może wytworzyć ilość pary wystarczającą do wygenerowania "
"125 megawatów energii."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-migo.json
msgid "resin wall"
msgstr "ściana z żywicy"

#. ~ Description of terrain "resin wall"
#: data/json/furniture_and_terrain/terrain-migo.json
msgid ""
"This wall is made of a glistening, nearly opaque, plastic-like substance.  "
"Deep within the material making it up, you can barely see a network of "
"pulsating green conduits, snaking like blood vessels through it.  The "
"material is hard, warm to the touch, and slightly damp."
msgstr ""
"Ściana ta wykonana jest z lśniącej, prawie nieprzezroczystej, "
"przypominającej plastik substancji. W głębi tworzącego ją materiału ledwo "
"widać sieć pulsujących, zielonych kanalików, wijących się przez nią niczym "
"naczynia krwionośne. Materiał jest twardy, ciepły w dotyku i lekko wilgotny."

#. ~ Bashing sound of terrain "resin wall"
#. ~ Bashing sound of terrain "resin cage"
#. ~ Bashing sound of terrain "resin floor"
#. ~ Bashing sound of terrain "resin roof"
#. ~ Bashing sound of terrain "closed resin portal"
#. ~ Bashing sound of terrain "open resin portal"
#. ~ Bashing sound of terrain "resin-lined hole"
#. ~ Bashing sound of terrain "coral floor"
#: data/json/furniture_and_terrain/terrain-migo.json
#: data/mods/Aftershock/maps/furniture_and_terrain/terrain_alienciv.json
msgid "boom!"
msgstr "bum!"

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-migo.json
msgid "resin cage"
msgstr "klatka z żywicy"

#. ~ Description of terrain "resin cage"
#: data/json/furniture_and_terrain/terrain-migo.json
msgid ""
"This resin wall opens into a series of small honeycomb-like hexagons, "
"allowing the passage of air and light.  While still made of the same sturdy "
"material, it is thinner and more delicate in appearance."
msgstr ""
"Ta żywiczna ściana otwiera się na serię małych sześciokątów przypominających"
" plaster miodu, umożliwiając przepływ powietrza i światła. Chociaż nadal "
"wykonana jest z tego samego wytrzymałego materiału, jest cieńsza i bardziej "
"delikatna w wyglądzie."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-migo.json
msgid "resin floor"
msgstr "podłoga z żywicy"

#. ~ Description of terrain "resin floor"
#: data/json/furniture_and_terrain/terrain-migo.json
msgid ""
"This nearly opaque, plastic-like floor has a gentle curve from wall to wall,"
" but in the central areas is quite flat.  The material is hard, warm to the "
"touch, and slightly damp."
msgstr ""
"Ta prawie nieprzezroczysta, przypominająca plastik podłoga jest delikatnie "
"zakrzywiona od ściany do ściany, ale w centralnej części jest dość płaska. "
"Materiał jest twardy, ciepły w dotyku i lekko wilgotny."

#. ~ Description of terrain "resin floor"
#: data/json/furniture_and_terrain/terrain-migo.json
msgid ""
"This nearly opaque, plastic-like floor is smooth and flat.  The material is "
"hard, warm to the touch, and slightly damp."
msgstr ""
"Ta prawie nieprzezroczysta, przypominająca plastik podłoga jest gładka i "
"płaska. Materiał jest twardy, ciepły w dotyku i lekko wilgotny."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-migo.json
msgid "resin roof"
msgstr "dach z żywicy"

#. ~ Description of terrain "resin roof"
#: data/json/furniture_and_terrain/terrain-migo.json
msgid ""
"A wide, domed section of nearly opaque, plastic-like material.  When the "
"light hits it, a network of multicolored conduits like blood vessels can be "
"seen snaking through its glistening interior."
msgstr ""
"Szeroki, kopulasty fragment niemal nieprzezroczystego, plastikowego "
"materiału. Kiedy światło pada na niego, można dostrzec sieć różnokolorowych "
"przewodów, przypominających naczynia krwionośne, wijących się przez jego "
"lśniące wnętrze."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-migo.json
msgid "closed resin portal"
msgstr "zamknięty portal z żywicy"

#. ~ Description of terrain "closed resin portal"
#: data/json/furniture_and_terrain/terrain-migo.json
msgid ""
"A tricuspid hatch of some sort of damp, flexible, resinous material.  This "
"one is closed tightly, but it looks like a firm push would cause it to snap "
"open."
msgstr ""
"Trójdzielny właz z jakiegoś wilgotnego, elastycznego, żywicznego materiału. "
"Ten jest szczelnie zamknięty, ale wygląda na to, że mocne naciśnięcie "
"spowodowałoby jego otwarcie."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-migo.json
msgid "open resin portal"
msgstr "otwarty portal z żywicy"

#. ~ Description of terrain "open resin portal"
#: data/json/furniture_and_terrain/terrain-migo.json
msgid ""
"A tricuspid hatch of some sort of damp, flexible, resinous material.  This "
"one is open, the flaps held out by some sort of stringy mucus-like "
"substance."
msgstr ""
"Trójdzielny właz z jakiegoś wilgotnego, elastycznego, żywicznego materiału. "
"Ten jest otwarty, klapy podtrzymywane przez jakąś sprężystą, śluzowatą "
"substancję."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-migo.json
msgid "resin-lined hole"
msgstr "otwór wyłożony żywicą"

#. ~ Description of terrain "resin-lined hole"
#: data/json/furniture_and_terrain/terrain-migo.json
msgid "An open hole in the resin wall, large enough to pass through."
msgstr ""
"Otwarty otwór w ściance żywicy, wystarczająco duży, aby można było przez "
"niego przejść."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-nether.json
msgid "black glass"
msgstr ""

#. ~ Description of terrain "black glass"
#: data/json/furniture_and_terrain/terrain-nether.json
msgid ""
"An endless expanse of black glass.  It perfectly reflects the darkness "
"around it."
msgstr ""

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-railroads.json
msgid "gravel"
msgstr "żwir"

#. ~ Description of terrain "gravel"
#: data/json/furniture_and_terrain/terrain-railroads.json
msgid ""
"Gravel is a collection of small stones often used for roads, as railroad "
"ballast, and in many other applications."
msgstr ""
"Żwir to zbiór małych kamieni często wykorzystywanych do budowy dróg, jako "
"tłuczeń kolejowy i w wielu innych zastosowaniach."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-railroads.json
msgid "railroad track"
msgstr "tory kolejowe"

#. ~ Description of terrain "railroad track"
#: data/json/furniture_and_terrain/terrain-railroads.json
msgid ""
"Trains used to chug along on these.  These rail tracks stand unused in the "
"face of the Cataclysm."
msgstr ""
"Kiedyś jeździły po nich pociągi. Te tory kolejowe stoją nieużywane w obliczu"
" Kataklizmu."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-railroads.json
msgid "railroad tie"
msgstr "podkład kolejowy"

#. ~ Description of terrain "railroad tie"
#: data/json/furniture_and_terrain/terrain-railroads.json
msgid "This crosstie is used to support the rails."
msgstr "Ten podkład kolejowy służy do podpierania szyn."

#. ~ Description of terrain "railroad track"
#: data/json/furniture_and_terrain/terrain-railroads.json
msgid ""
"Trains used to chug along on these.  These rail tracks stand unused in the "
"face of the Cataclysm.  A crosstie sits underneath, supporting the rails."
msgstr ""
"Kiedyś jeździły po nich pociągi. Te tory kolejowe stoją nieużywane w obliczu"
" Kataklizmu. Podkład kolejowy jest osadzony pod szynami, podpierając je."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-railroads.json
msgid "buffer stop"
msgstr "kozioł oporowy"

#. ~ Description of terrain "buffer stop"
#: data/json/furniture_and_terrain/terrain-railroads.json
msgid ""
"A tiny blockade on the train tracks, meant to signify the end of a track, or"
" mark a 'no-go' zone for trains."
msgstr ""
"Niewielka blokada na torach kolejowych, mająca oznaczać koniec toru lub "
"oznaczać strefę „zakaz wjazdu” dla pociągów."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-railroads.json
msgid "railroad crossing signal"
msgstr "znak przejazdu kolejowego"

#. ~ Description of terrain "railroad crossing signal"
#: data/json/furniture_and_terrain/terrain-railroads.json
msgid ""
"Traffic lights meant to light and make noise when a train approaches, to "
"prevent people from turning into meaty mush while they cross the tracks.  "
"Won't stop people from turning into meaty mush by other means, though."
msgstr ""
"Światła drogowe mają zapalać się i emitować dźwięk, gdy zbliża się pociąg, "
"aby zapobiec przerobieniu ludzi w mięsną papkę podczas przechodzenia przez "
"tory. Nie powstrzyma to jednak ludzi przed przemianą w mięsną papkę w inny "
"sposób."

#. ~ Bashing failed sound of terrain "railroad crossing signal"
#. ~ Bashing failed sound of terrain "crossbuck"
#. ~ Bashing failed sound of terrain "rain gutter"
#. ~ Bashing failed sound of terrain "gutter drop"
#. ~ Bashing failed sound of terrain "downspout"
#: data/json/furniture_and_terrain/terrain-railroads.json
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "clang."
msgstr "klang."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-railroads.json
msgid "crossbuck"
msgstr "krzyż św. Andrzeja"

#. ~ Description of terrain "crossbuck"
#: data/json/furniture_and_terrain/terrain-railroads.json
msgid ""
"A traffic sign intended to indicate a level railway crossing.  If the trains"
" were still running."
msgstr ""
"Znak drogowy przeznaczony do wskazywania przejazdu kolejowego. Gdyby pociągi"
" nadal jeździły."

#. ~ Terrain name
#. ~ Item name
#: data/json/furniture_and_terrain/terrain-railroads.json
#: data/json/items/generic.json
msgid "small railroad track"
msgid_plural "small railroad tracks"
msgstr[0] "małe tory kolejowe"
msgstr[1] "małe tory kolejowe"
msgstr[2] "małych torów kolejowych"
msgstr[3] "małych torów kolejowych"

#. ~ Description of terrain "small railroad track"
#: data/json/furniture_and_terrain/terrain-railroads.json
msgid ""
"Like a railroad track, only smaller.  You could probably run a small vehicle"
" on this."
msgstr ""
"Jak tory kolejowe, tylko mniejsze. Prawdopodobnie można by po nim przejechać"
" małym pojazdem."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-recreational.json
msgid "sandbox"
msgstr "piaskownica"

#. ~ Description of terrain "sandbox"
#: data/json/furniture_and_terrain/terrain-recreational.json
msgid ""
"Children used to play in this sandbox.  The population of lice probably "
"diminished considerably now that they no longer do."
msgstr ""
"Kiedyś dzieci bawiły się w tej piaskownicy. Populacja wszy prawdopodobnie "
"znacznie zmniejszyła się teraz, kiedy już tego nie robią."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-recreational.json
msgid "slide"
msgstr "osuwisko"

#. ~ Description of terrain "slide"
#: data/json/furniture_and_terrain/terrain-recreational.json
msgid "A children's slide.  Too small to slide on comfortably anymore."
msgstr "Zjeżdżalnia dla dzieci. Zbyt mała, by wygodnie się na niej ślizgać."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-recreational.json
msgid "monkey bars"
msgstr "małpi gaj"

#. ~ Description of terrain "monkey bars"
#: data/json/furniture_and_terrain/terrain-recreational.json
msgid ""
"A set of monkey bars, to be used by children to train their arms by hanging "
"from the bars, and have fun."
msgstr ""
"Zestaw drążków do trenowania rąk przez dzieci poprzez zwisanie z nich i "
"dobrą zabawę."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-recreational.json
msgid "backboard"
msgstr "tablica do kosza"

#. ~ Description of terrain "backboard"
#: data/json/furniture_and_terrain/terrain-recreational.json
msgid "A basketball backboard."
msgstr "Tablica do koszykówki."

#. ~ Description of terrain "backboard"
#: data/json/furniture_and_terrain/terrain-recreational.json
msgid "A metal backboard."
msgstr "Metalowa tablica."

#. ~ Terrain name
#. ~ Description of terrain "this should never actually show up, it's a pseudo
#. terrain"
#: data/json/furniture_and_terrain/terrain-regional-pseudo.json
msgid "this should never actually show up, it's a pseudo terrain"
msgstr "to nigdy nie powinno się pojawić, to pseudo teren"

#. ~ Description of terrain "this should never actually show up, it's a pseudo
#. terrain"
#: data/json/furniture_and_terrain/terrain-regional-pseudo.json
msgid ""
"this should never actually show up, it's a pseudo terrain.  For use where "
"people have trampled away grass, or otherwise cleared plant life."
msgstr ""
"to nigdy nie powinno się pojawić, to pseudo teren. Do użycia tam, gdzie "
"ludzie wydeptali trawę lub w inny sposób usunęli roślinność."

#. ~ Description of terrain "this should never actually show up, it's a pseudo
#. terrain"
#: data/json/furniture_and_terrain/terrain-regional-pseudo.json
msgid ""
"this should never actually show up, it's a pseudo terrain.  For use where "
"clean, curated grass is the only expected terrain - modified by whatever the"
" biome equivalent is"
msgstr ""
"to nigdy nie powinno się pojawić, to pseudo teren. Do użycia tam, gdzie "
"czysta, skoszona trawa jest jedynym oczekiwanym terenem - zmodyfikowana "
"przez jakikolwiek odpowiednik biomu"

#. ~ Description of terrain "this should never actually show up, it's a pseudo
#. terrain"
#: data/json/furniture_and_terrain/terrain-regional-pseudo.json
msgid ""
"this should never actually show up, it's a pseudo terrain.  For use where "
"plants have been planted and grass/groundcover kept clear"
msgstr ""
"To nie powinno się nigdy pojawić, to pseudo teren. Do użytku tam, gdzie "
"zasadzono rośliny i utrzymano czystą trawę/okrywę ziemną."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "rain gutter"
msgstr "rynna deszczowa"

#. ~ Description of terrain "rain gutter"
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "Channels water from the roof towards the ground, it looks flimsy."
msgstr "Odprowadza wodę z dachu w kierunku ziemi, wygląda niepewnie."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "gutter drop"
msgstr "wpust rynny"

#. ~ Description of terrain "gutter drop"
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid ""
"Funnels water from gutter system towards the ground, it looks flimsy.  You "
"may be able to climb down here."
msgstr ""
"Odprowadza wodę z systemu rynnowego w kierunku ziemi, wygląda chwiejnie. Być"
" może będzie można tu zejść na dół."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "downspout"
msgstr "rura spustowa"

#. ~ Description of terrain "downspout"
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid ""
"A length of gutter running from the roof to the ground, you could place a "
"container underneath it to collect rainwater.  It looks flimsy.  You may be "
"able to climb up here."
msgstr ""
"Odcinek rynny biegnący od dachu do ziemi, można umieścić pojemnik pod nim, "
"aby zebrać wodę deszczową. Wygląda na chwiejny. Możesz być w stanie się tu "
"wspiąć."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "flat roof"
msgstr "płaski dach"

#. ~ Description of terrain "flat roof"
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "A flat, gray section of rooftop."
msgstr "Płaska, szara część dachu."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "tar paper flat roof"
msgstr "kryty papą płaski dach"

#. ~ Description of terrain "tar paper flat roof"
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "A flat, gray section of rooftop covered with tar paper."
msgstr "Płaski, szary fragment dachu pokryty papą."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "shingle flat roof"
msgstr "kryty gontem płaski dach"

#. ~ Description of terrain "shingle flat roof"
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "A flat section of rooftop covered in shingles."
msgstr "Płaski fragment dachu pokryty gontem."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "thatched roof"
msgstr "dach kryty strzechą"

#. ~ Description of terrain "thatched roof"
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "A section of roof made out of straw."
msgstr "Fragment dachu wykonany ze słomy."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "metal flat roof"
msgstr "metalowy płaski dach"

#. ~ Description of terrain "metal flat roof"
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "A section of flat, sheet metal rooftop."
msgstr "Fragment płaskiego, blaszanego dachu."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "tile flat roof"
msgstr "kryty płytkami płaski dach"

#. ~ Description of terrain "tile flat roof"
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "A section of tiled, flat rooftop."
msgstr "Fragment płaskiego dachu pokrytego dachówką."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "skylight"
msgstr "świetlik"

#. ~ Description of terrain "skylight"
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid ""
"A giant sheet of glass inserted into the roof, lets light pass through."
msgstr ""
"Gigantyczny szklany panel włożony w dach, przepuszcza światło do wewnątrz."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "rock roof"
msgstr "skalny dach"

#. ~ Description of terrain "rock roof"
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "A section of flat natural rock."
msgstr "Powierzchnia z płaskiej skały naturalnej."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "warped roof"
msgstr "wypaczony dach"

#. ~ Description of terrain "warped roof"
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid ""
"A section of flat stone like roof.  It's pattern of grooves and lines is "
"constantly shifting."
msgstr ""
"Fragment płaskiego dachu przypominającego kamień. Wzór żłobień i linii ulega"
" ciągłym zmianom."

#. ~ Description of terrain "flat roof"
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "A flat surface made of pulpy mass, covered in sticky wasp saliva."
msgstr "Płaska powierzchnia z papierowej pulpy, pokryta lepką śliną os."

#. ~ Description of terrain "flat roof"
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid ""
"A flat surface made of hardened pulpy mass, covered in sticky wasp saliva."
msgstr ""
"Płaska powierzchnia z utwardzonej papierowej pulpy, pokryta lepką śliną os."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "concrete roof"
msgstr ""

#. ~ Description of terrain "concrete roof"
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "A flat, concrete section of rooftop."
msgstr ""

#. ~ Terrain name
#. ~ Vehicle part name
#: data/json/furniture_and_terrain/terrain-roofs.json
#: data/json/vehicleparts/vehicle_parts.json
msgid "wooden roof"
msgstr "drewniany dach"

#. ~ Description of terrain "wooden roof"
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "A flat section of wooden rooftop."
msgstr ""

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "treated wooden roof"
msgstr ""

#. ~ Description of terrain "treated wooden roof"
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "A flat section of flame resistant wooden rooftop."
msgstr ""

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "metal roof"
msgstr ""

#. ~ Description of terrain "metal roof"
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "A high-quality and sturdy section of metallic rooftop."
msgstr ""

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "sod roof"
msgstr ""

#. ~ Description of terrain "sod roof"
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "A section of roof made out of sod."
msgstr ""

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "brick roof"
msgstr ""

#. ~ Description of terrain "brick roof"
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "A brick section of rooftop."
msgstr ""

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-traps.json
msgid "empty space"
msgstr "puste miejsce"

#. ~ Description of terrain "empty space"
#: data/json/furniture_and_terrain/terrain-traps.json
msgid "This is empty space."
msgstr "To otwarta przestrzeń."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-traps.json
msgid "shallow pit"
msgstr "płytki dół"

#. ~ Description of terrain "shallow pit"
#: data/json/furniture_and_terrain/terrain-traps.json
msgid ""
"A pit that could be dug even deeper or filled up.  Also useful as a starting"
" foundation for some constructions."
msgstr ""
"Dziura w ziemi, którą można pogłębić albo zasypać. Zdatna również jako "
"podstawa niektórych budowli."

#. ~ Description of terrain "pit"
#: data/json/furniture_and_terrain/terrain-traps.json
msgid ""
"A steep hole that could seriously injure something if it fell in, "
"potentially fatal if it was filled with sharp and dangerous things.  Deep "
"enough for more advanced construction projects, and possibly to reach "
"groundwater if constructed properly."
msgstr ""
"Głęboka dziura o spadzistych krawędziach, która może zranić poważnie tego "
"kto by w nią wpadł, potencjalnie śmiertelnie, gdyby wypełnić ją ostrymi, "
"niebezpiecznymi przedmiotami. Wystarczająco głęboka do bardziej "
"zaawansowanych konstrukcji budowlanych, a może nawet do dostania się do wód "
"powierzchniowych jeżeli właściwe zabudowana."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-traps.json
msgid "corpse filled pit"
msgstr "dół zapełniony ciałami"

#. ~ Description of terrain "corpse filled pit"
#: data/json/furniture_and_terrain/terrain-traps.json
msgid ""
"A giant trench full of corpses, maybe even a mass graveyard.  The bodies "
"could be dug out but none of it looks remotely usable."
msgstr ""
"Olbrzymi dół pełen ciał, możliwe że masowy grób. Ciała można wykopać, ale "
"żadne z nich nie wydaje się być jakkolwiek użyteczne."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-traps.json
msgid "covered pit"
msgstr "zakryty dół"

#. ~ Description of terrain "covered pit"
#: data/json/furniture_and_terrain/terrain-traps.json
msgid ""
"A deep pit with a plank placed across it, looks sturdy enough to cross "
"safely or the plank could be removed to turn it back into trap fall."
msgstr ""
"Głęboki dół z ułożoną w poprzek deską, wygląda na wystarczająco solidną, by "
"można było bezpiecznie go przekroczyć lub można też usunąć deskę, by "
"zamienić go z powrotem w pułapkę."

#. ~ Description of terrain "spiked pit"
#: data/json/furniture_and_terrain/terrain-traps.json
msgid ""
"A narrow trench full of very pointy things that would easily puncture a "
"body."
msgstr "Wąski dół pełen ostrych rzeczy, które z łatwością przebiją ciało."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-traps.json
msgid "covered spiked pit"
msgstr "zakryty dół z kolcami"

#. ~ Description of terrain "covered spiked pit"
#: data/json/furniture_and_terrain/terrain-traps.json
msgid ""
"Menacing with sharp spears along the bottom, this pit has a plank across it "
"to allow someone or something to cross safely.  The plank could be removed "
"to revert it back into a trap."
msgstr ""
"Groźny dół z dnem nabitym kolcami i deską ułożoną nad nim w poprzek, która "
"wygląda na tyle solidnie, by bezpiecznie przejść i którą można zabrać, by "
"zmienić go z powrotem w pułapkę."

#. ~ Description of terrain "glass pit"
#: data/json/furniture_and_terrain/terrain-traps.json
msgid ""
"Looks like a ton of broken glass was dumped into this pit, maybe not fatal "
"to fall in but wouldn't be pleasant to try to crawl out."
msgstr ""
"Wygląda na to, że do tego dołu wsypano kilka wiader szkła, przez co może "
"wpadnięcie tam nie będzie śmiertelne, ale wygrzebanie się stamtąd na pewno "
"nie będzie przyjemne."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-traps.json
msgid "covered glass pit"
msgstr "zakryty dół ze szkłem"

#. ~ Description of terrain "covered glass pit"
#: data/json/furniture_and_terrain/terrain-traps.json
msgid ""
"A plank has been placed carefully to allow traversal over this ditch full of"
" large glass shards.  The wooden board could be removed so it couldn't be "
"safely crossed."
msgstr ""
"Deska nad tym dołem pełnym sterczących ostrych odłamków szkła pozwala "
"swobodnie przejść nad nim, a jej zabranie zmieni go w miejsce, którego nie "
"da się bezpiecznie przejść."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-traps.json
msgid "dead drop pit"
msgstr ""

#. ~ Description of terrain "dead drop pit"
#: data/json/furniture_and_terrain/terrain-traps.json
msgid ""
"A seemingly innocuous shallow pit.  Careful inspection reveals a black "
"canister half buried in the exposed soil."
msgstr ""

#. ~ Message about the player in an effect
#: data/json/furniture_and_terrain/terrain-traps.json
msgid "You prepare the drop as instructed"
msgstr ""

#. ~ Message about the player in an effect
#: data/json/furniture_and_terrain/terrain-traps.json
msgid "You dont have anything to deliver."
msgstr ""

#. ~ Terrain name
#. ~ Monster name
#: data/json/furniture_and_terrain/terrain-traps.json
#: data/json/monsters/slimes.json
msgid "slime"
msgid_plural "slimes"
msgstr[0] "śluz"
msgstr[1] "śluzu"
msgstr[2] "śluzów"
msgstr[3] "śluzu"

#. ~ Description of terrain "slime"
#: data/json/furniture_and_terrain/terrain-traps.json
msgid ""
"A disgusting and slippery mess that could be used to stash things because "
"who'd want to touch it?"
msgstr ""
"Ohydna i śliska masa, którą można użyć do schowania rzeczy, bo kto niby "
"chciały tego dotknąć?"

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "solid bark wall"
msgstr "solidna ściana z kory"

#. ~ Description of terrain "solid bark wall"
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid ""
"A solid wall of bark, enclosing the trunk of a massive tree.  It will "
"probably burn quite well."
msgstr ""
"Solidna ściana z kory, otaczająca pień masywnego drzewa. Prawdopodobnie "
"będzie się całkiem dobrze palić."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "chipped bark wall"
msgstr "ukruszona ściana z kory"

#. ~ Description of terrain "chipped bark wall"
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid ""
"A solid wall of bark enclosing the trunk of a massive tree.  Some of it has "
"been broken away."
msgstr ""
"Solidna ściana z kory otaczająca pień masywnego drzewa. Część z niej została"
" odłamana."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "broken bark wall"
msgstr "połamana ściana z kory"

#. ~ Description of terrain "broken bark wall"
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid ""
"A formerly solid wall of bark, now almost completely destroyed and waiting "
"to collapse."
msgstr ""
"Dawniej solidna ściana z kory, teraz prawie całkowicie zniszczona i gotowa "
"do zawalenia się."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "solid wood wall"
msgstr "solidna drewniana ściana"

#. ~ Description of terrain "solid wood wall"
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "A solid wall of naturally grown wood.  Likely very flammable."
msgstr ""
"Solidna ściana z naturalnego drewna. Prawdopodobnie bardzo łatwopalna."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "bark"
msgstr "kora"

#. ~ Description of terrain "bark"
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "A solid piece of bark covers the floor here."
msgstr "Podłogę pokrywa tu solidny kawałek kory."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "branches with leaves"
msgstr "gałęzie z liśćmi"

#. ~ Description of terrain "branches with leaves"
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "Thin branches emerge here, covered with thick, large leaves."
msgstr ""
"W tym miejscu wyrastają cienkie gałęzie, pokryte grubymi, dużymi liśćmi."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "root floor"
msgstr "podłoże z korzeni"

#. ~ Description of terrain "root floor"
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "A dirt floor covered with roots."
msgstr "Ziemia pokryta korzeniami."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "downward root slope"
msgstr "pochyłość w dół z korzeni"

#. ~ Description of terrain "downward root slope"
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "A downward-facing slope of root-covered dirt."
msgstr "Skierowany w dół stok pokrytej korzeniami ziemi."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "upward root slope"
msgstr "pochyłość w górę z korzeni"

#. ~ Description of terrain "upward root slope"
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "An upward-facing slope of root-covered dirt."
msgstr "Skierowany w górę stok pokrytej korzeniami ziemi."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "closed bramble roots"
msgstr "zamknięty splot korzeni"

#. ~ Description of terrain "closed bramble roots"
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid ""
"A bramble of roots are here, covering a hole.  They could easily be pulled "
"apart."
msgstr ""
"Jest tu gąszcz korzeni, które zasłaniają dziurę. Można je łatwo wyrwać."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "open bramble roots"
msgstr "otwarty splot korzeni"

#. ~ Description of terrain "open bramble roots"
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "A bramble of roots are here, they are pulled apart revealing a hole."
msgstr "Jest tu gąszcz korzeni, które są wyrywane i odsłaniają dziurę."

#. ~ Terrain name
#. ~ Overmap terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
#: data/json/overmap/overmap_terrain/overmap_terrain.json
#: data/mods/No_Hope/terrain.json
#: data/mods/Xedra_Evolved/furniture_and_terrain/terrain-doors.json
msgid "wall"
msgstr "ściana"

#. ~ Description of terrain "wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"The stereotypical wall with wooden support structure filled with insulation "
"and drywalled.  Paint job is the all too common and neutral off-white or "
"cream color, it could use more vibrant paint.  Appears as though the "
"material is still flammable."
msgstr ""
"Stereotypowa ściana z drewnianą strukturą nośną wypełnioną dociepleniem i "
"zagipsowana. Pokrywa ją nazbyt popularna farba w odcieniu bieli i beżu, a "
"przydałby się bardziej wyrazisty kolor. Wygląda na to że materiał jest "
"palny."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "half-built wall"
msgstr "nieukończona ściana"

#. ~ Description of terrain "half-built wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"An incomplete wall of refined wood, dotted with carefully placed nails to "
"provide proper support.  It requires some more planks and nails before it'd "
"be considered a suitable wall."
msgstr ""
"Niekompletna ściana z przetworzonego drewna, nabita ostrożnie "
"rozmieszczonymi gwoździami dla właściwego podparcia. Wymaga jeszcze nieco "
"desek i gwoździ zanim zmieni się w prawdziwą ścianę."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "pony wall"
msgstr "ścianka działowa"

#. ~ Description of terrain "pony wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A short divider wall with wooden support structure with drywall.  Paint job "
"is the all too common and neutral off-white or cream color.  Appears as "
"though the material is flammable."
msgstr ""
"Krótka ścianka działowa z drewnianą konstrukcją nośną z płytą gipsowo-"
"kartonową. Pomalowana jest zbyt często spotykanym i neutralnym kolorem "
"białym lub kremowym. Wygląda na to, że materiał jest łatwopalny."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
#: data/mods/No_Hope/terrain.json
msgid "red wall"
msgstr "czerwona ściana"

#. ~ Description of terrain "red wall"
#: data/json/furniture_and_terrain/terrain-walls.json
#: data/mods/No_Hope/terrain.json
msgid "Wall painted red."
msgstr "Ściana pomalowana na czerwono."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
#: data/mods/No_Hope/terrain.json
msgid "white wall"
msgstr "biała ściana"

#. ~ Description of terrain "white wall"
#: data/json/furniture_and_terrain/terrain-walls.json
#: data/mods/No_Hope/terrain.json
msgid "Wall painted white."
msgstr "Ściana pomalowana na biało."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
#: data/mods/No_Hope/terrain.json
msgid "blue wall"
msgstr "niebieska ściana"

#. ~ Description of terrain "blue wall"
#: data/json/furniture_and_terrain/terrain-walls.json
#: data/mods/No_Hope/terrain.json
msgid "Wall painted blue."
msgstr "Ściana pomalowana na niebiesko."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
#: data/mods/No_Hope/terrain.json
msgid "green wall"
msgstr "zielona ściana"

#. ~ Description of terrain "green wall"
#: data/json/furniture_and_terrain/terrain-walls.json
#: data/mods/No_Hope/terrain.json
msgid "Wall painted green."
msgstr "Ściana pomalowana na zielono."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
#: data/mods/No_Hope/terrain.json
msgid "yellow wall"
msgstr "żółta ściana"

#. ~ Description of terrain "yellow wall"
#: data/json/furniture_and_terrain/terrain-walls.json
#: data/mods/No_Hope/terrain.json
msgid "Wall painted yellow."
msgstr "Ściana pomalowana na żółto."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
#: data/mods/No_Hope/terrain.json
msgid "pink wall"
msgstr "różowa ściana"

#. ~ Description of terrain "pink wall"
#: data/json/furniture_and_terrain/terrain-walls.json
#: data/mods/No_Hope/terrain.json
msgid "Wall painted pink."
msgstr "Ściana pomalowana na różowo."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
#: data/mods/No_Hope/terrain.json
msgid "purple wall"
