"A self-contained camping mess kit, containing everything you might need for "
"wilderness cooking.  This model relies on a battery-operated hotplate, "
"rather than the more commonplace chemical-fueled Esbit stove."
msgstr ""
"Zamknięty w menażce zestaw, zawierający wszystko czego możesz potrzebować do"
" gotowania w głuszy. Ten model bazuje na kuchence turystycznej na baterie "
"zamiast na częściej spotykanym palniku chemicznym."

#. ~ Item name
#: data/json/items/tool/cooking.json
msgid "mess tin"
msgid_plural "mess tins"
msgstr[0] "menażka"
msgstr[1] "menażki"
msgstr[2] "menażek"
msgstr[3] "menażki"

