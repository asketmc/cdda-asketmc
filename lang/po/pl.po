msgstr[2] "drewnianych wiader"
msgstr[3] "drewnianego wiadra"

#. ~ Description of "wooden bucket"
#: data/json/items/containers.json
msgid ""
"A wooden bucket.  Carefully chiseled out of hardwood log section, almost "
"like a dugout canoe.  Holds 5 liters of water and has wooden handle for "
"carry."
msgstr ""
"Drewniane wiadro. Starannie wyciosane z twardego drewna, prawie jak czółno. "
"Mieści 5 litrów wody i ma drewniany uchwyt do przenoszenia."

