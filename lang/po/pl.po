msgstr[1] "zawiesiny monomeryczne"
msgstr[2] "zawiesin monomerycznych"
msgstr[3] "zawiesiny monomerycznej"

#. ~ Description of "monomeric slurry"
#: data/mods/Aftershock/items/crafting_scrap/biomaterial_scrap.json
msgid ""
"A collection of the building blocks of polymers.  With this and a whole lot "
"of know-how, you can create proteins and other building blocks of life."
msgstr ""
"Zbiór elementów składowych polimerów. Dzięki temu i sporej dawce wiedzy "
"można stworzyć białka i inne składniki budulcowe życia."

#. ~ Item name
#: data/mods/Aftershock/items/crafting_scrap/biomaterial_scrap.json
