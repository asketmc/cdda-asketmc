msgid_plural "electric kilns"
msgstr[0] "elektryczny piec"
msgstr[1] "elektryczne piece"
msgstr[2] "elektrycznych pieców"
msgstr[3] "elektrycznego pieca"

#. ~ Description of "electric kiln"
#: data/json/items/tool/workshop.json
