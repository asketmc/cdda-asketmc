#. on Amazon, 6.4 pounds.
#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "cordless impact wrench"
msgid_plural "cordless impact wrenches"
msgstr[0] "bezprzewodowy klucz udarowy"
msgstr[1] "bezprzewodowe klucze udarowe"
msgstr[2] "bezprzewodowych kluczy udarowych"
