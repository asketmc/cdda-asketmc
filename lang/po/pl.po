#, c-format
msgid "You need some %1$s to reload this %2$s."
msgstr "Potrzebujesz trochę %1$s do przeładowania tego %2$s."

#: src/iexamine.cpp:4349
#, c-format
msgid "Put how many of the %1$s into the %2$s?"
msgstr "Włożyć ile %1$s do %2$s?"

#. ~ %1$s - furniture, %2$d - number, %3$s items.
#: src/iexamine.cpp:4383
#, c-format
msgid "The %1$s contains %2$d %3$s."
msgstr "Ten %1$s zawiera %2$d %3$s."

#: src/iexamine.cpp:4386
#, c-format
msgid "You reload the %s."
msgstr "Przeładowujesz %s."

#: src/iexamine.cpp:4412
msgid "Do what with the curtains?"
msgstr "Co zrobić z zasłonami?"

#: src/iexamine.cpp:4414
msgid "Peek through the closed curtains."
msgstr "Zerknij przez zasłonięte zasłony."

#: src/iexamine.cpp:4415
msgid "Tear down the curtains."
msgstr "Porwij zasłony."

#: src/iexamine.cpp:4422 src/vehicle_use.cpp:1991
msgid "You carefully peek through the curtains."
msgstr "Ostrożnie zerkasz przez zasłony."

#: src/iexamine.cpp:4434
msgid "You tear the curtains and curtain rod off the windowframe."
msgstr "Zrywasz zasłony i pręt z karnisza."

#: src/iexamine.cpp:4448
msgid "You're illiterate, and can't read the message on the sign."
msgstr "Jesteś analfabetą i nie potrafisz przeczytać wiadomości na znaku."

#: src/iexamine.cpp:4452
msgid "Nothing legible on the sign."
msgstr "Nie ma nic czytelnego na znaku."

