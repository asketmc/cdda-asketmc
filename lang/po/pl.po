msgid_plural "wizard snails"
msgstr[0] "czarodziejski ślimak"
msgstr[1] "czarodziejskie ślimaki"
msgstr[2] "czarodziejskich ślimaków"
msgstr[3] "czarodziejskiego ślimaka"

#. ~ Description of monster "wizard snail"
#: data/mods/TropiCataclysm/monsters/tropical_nether.json
msgid ""
"A tiny alien creature brought by the portal storms.  It vaguely resembles a "
"gastropod with a hat-like shell."
msgstr ""
"Małe obce stworzenie przyniesione przez burze portalowe. Nieco przypomina "
"ślimaka z muszlą przypominającą kapelusz."

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_nether.json
msgid "hyolith conch"
msgid_plural "hyolith conchs"
msgstr[0] "hiolicka muszla"
msgstr[1] "hiolickie muszle"
msgstr[2] "hiolickich muszli"
msgstr[3] "hiolickiej muszli"

#. ~ Description of monster "hyolith conch"
#: data/mods/TropiCataclysm/monsters/tropical_nether.json
msgid ""
"An alien creature brought by the portal storms.  It vaguely resembles a "
"large conch snail with a straight shell."
msgstr ""
"Obce stworzenie przyniesione przez burze portalowe. Nieco przypomina dużego "
"ślimaka z prostą muszlą."

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_nether.json
msgid "nimbelemnite"
msgid_plural "nimbelemnites"
msgstr[0] "nimbelemnit"
msgstr[1] "nimbelemnity"
msgstr[2] "nimbelemnitów"
msgstr[3] "nimbelemnita"

#. ~ Description of monster "nimbelemnite"
#: data/mods/TropiCataclysm/monsters/tropical_nether.json
msgid ""
"An alien flying creature brought by the portal storms.  It vaguely resembles"
" an ancient cephalopod and moves quite fast."
msgstr ""
"Obce latające stworzenie przyniesione przez burze portalowe. Nieco "
"przypomina starożytnego głowonoga i porusza się dość szybko."

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_nether.json
msgid "atmmonoid"
msgid_plural "atmmonoids"
msgstr[0] "atmmonoid"
msgstr[1] "attmonoidy"
msgstr[2] "atmmonoidów"
msgstr[3] "atmmonoida"

#. ~ Description of monster "atmmonoid"
#: data/mods/TropiCataclysm/monsters/tropical_nether.json
msgid ""
"An alien flying creature brought by the portal storms.  It vaguely resembles"
" a prehistoric cephalopod with a helix shell."
msgstr ""
"Obce latające stworzenie przyniesione przez burze portalowe. Nieco "
"przypomina prehistorycznego głowonoga o spiralnej skorupie."

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_nether.json
msgid "ballistoceras"
msgid_plural "ballistocerae"
msgstr[0] "ballistocerae"
msgstr[1] "ballistocerae"
