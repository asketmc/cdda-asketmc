msgstr "Plony %s sprzedały się za %d kwitów…"

#: src/mission_companion.cpp:1658 src/mission_companion.cpp:1667
#, c-format
msgid "You receive %d %s…"
msgstr "Otrzymujesz %d %s…"

#: src/mission_companion.cpp:1697 src/mission_companion.cpp:1748
#: src/mission_companion.cpp:1853
#, c-format
msgid ""
"While scavenging, %s's party suddenly found itself set upon by a large mob "
