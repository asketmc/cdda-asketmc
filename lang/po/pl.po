#. ~ Profession name for male
#: data/json/hobbies.json
msgctxt "profession_male"
msgid "Butchering"
msgstr "Rzeźnictwo"

#. ~ Description of profession "Butchering" for male
#: data/json/hobbies.json
msgctxt "prof_desc_male"
msgid ""
"You absolutely love meat, and dislike eating fruits and vegetables.  Your "
"particular tastes have turned you into a decent amateur butcher."
msgstr ""
"Uwielbiasz mięso, a nie lubisz jeść warzyw i owoców. Twoje szczególne "
"upodobania uczyniły z ciebie przyzwoitego rzeźnika amatora."

#. ~ Profession name for female
#: data/json/hobbies.json
