#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#. ~ Speech from speaker afs_mon_migoturret
#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json data/mods/Aftershock/speech.json
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Hello?\""
msgstr "„Halo?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"Papaya!\""
msgstr "„Papaja!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Who's there?\""
msgstr "„Kto tam?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#. ~ Speech from speaker afs_mon_migoturret
#: data/json/speech.json data/mods/Aftershock/speech.json
msgid "\"Can you help me?\""
msgstr "„Czy możesz mi pomóc?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Over here!\""
msgstr "„Tutaj!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Can you repeat that?\""
msgstr "„Możesz powtórzyć?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"You're just copying me, aren't you?\""
msgstr "„Ty tylko mnie naśladujesz, prawda?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I'm not afraid of you!\""
msgstr "„Nie boję się ciebie!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Come here!\""
msgstr "„Chodź tu!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Please, don't!\""
msgstr "„Proszę, nie!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "a horrified scream!"
msgstr "przerażony krzyk!"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "a little girl's wailing!"
msgstr "zawodzenie małej dziewczynki!"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"So, what is this thing supposed to be, exactly?\""
msgstr "„Więc, co to w zasadzie ma być?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"Uncategorized object seven-seven-three-four.\""
msgstr "„Niesklasyfikowany obiekt siedem-siedem-trzy-cztery”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"We found it in a wreckage, barely alive.  Not the first one, either.\""
msgstr "„Znaleźliśmy to we wraku, ledwo żywe. Ale też nie pierwsze”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"Area nineteen has a few in cold storage.\""
msgstr "„Strefa 19 ma kilka w zamrażarce”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Mommy, help!\""
msgstr "„Mamo, pomocy!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"We're still trying to figure out what makes it tick.\""
msgstr "„Nadal próbujemy rozgryźć co sprawia, że to funkcjonuje”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"We're not even sure what it is.\""
msgstr "„Nawet nie jesteśmy pewni co to jest”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_surgeon
#: data/json/speech.json
msgid "\"The cell structure is unlike any we've ever seen.\""
msgstr ""
"„Struktura komórkowa jest odmienna od czegokolwiek co dotychczas "
"widzieliśmy”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"It does seem to have some form of higher level brain functioning.\""
msgstr "„Wygląda na to, że posiada jakąś formę wyższych funkcji mózgu”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"Problem solving, memory retention, that sort of thing.\""
msgstr "„Rozwiązywanie problemów, zdolność zapamiętywania, te sprawy”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"There appear to be some anomalous aspects to the mimicry.\""
msgstr "„Wygląda to na jakieś anomalne aspekty mimikry”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Members of the species have some kind of neurocognitive link.\""
msgstr "„Osobniki tego gatunku mają jakieś łącze neurokognitywne”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid ""
"\"This one's repeating phrases that the previous specimen was exposed to.\""
msgstr "„Ten tutaj powtarza zdania, które odtworzono poprzedniemu okazowi”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "a child shrieking!"
msgstr "wrzask dziecka!"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Oh God, my leg, Oh God!\""
msgstr "„O Boże, moja noga, o Boże!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "a long cry of agony!"
msgstr "długi wrzask agonii!"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"You mean it's not just parroting us?\""
msgstr "„Twierdzisz, że to nie tylko papugowanie?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"It's parroting us, but we're uncertain as to how or why.\""
msgstr "„Naśladuje nas jak papuga, ale nie mamy pewności jak i dlaczego”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"It may be a mechanism for attracting prey.\""
msgstr "„To może być mechanizm zwabiania zwierzyny”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"It could even be a way of trying to scare us off.\""
msgstr "„A także może to być sposób na wystraszenie nas”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"We just don't know.\""
msgstr "„Po prostu nie wiemy”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "an anguished wail!"
msgstr "udręczony skowyt!"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"You're gonna rot in hell for this!\""
msgstr "„Zgnijesz za to w piekle!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"You hear me!?\""
msgstr "„Słyszysz mnie?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"You're gonna rot in hell, you pieces of shit!\""
msgstr "„Zgnijecie w piekle, wy kupy gówna!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_surgeon
#: data/json/speech.json
msgid "\"Like we said, we have no idea what it's thinking.\""
msgstr "„Jak już mówiłem, nie mamy pojęcia o czym to myśli”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"Is that glass electrified?\""
msgstr "„Czy to szkło jest pod napięciem?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"Why don't you touch it and find out?\""
msgstr "„Czemu nie dotkniesz i nie sprawdzisz?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"Of course it is.\""
msgstr "„Oczywiście, że jest”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"What'll happen if the power goes out?\""
msgstr "„Co się stanie jak wysiądzie zasilanie?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Don't worry about it.\""
msgstr "„Nie martw się tym”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Don't worry.\""
msgstr "„Nie martw się”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"There are seven backup generators.\""
msgstr "„Mamy siedem zapasowych generatorów”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"And what if all the backups fail?\""
msgstr "„A jak zapasowe padną?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"We'd have to terminate the specimen.\""
msgstr "„Musielibyśmy uśmiercić okaz”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"The glass alone won't keep us safe for very long.\""
msgstr "„Samo szkło nie zapewniłoby nam bezpieczeństwa na długo”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"That fuckin' thing is horrible, man, it gives me the creeps.\""
msgstr "„Ta pieprzona rzecz jest potworna, człowieku, mam od tego dreszcze”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"It's probably more scared of us than we are of it.\""
msgstr "„Pewnie jest bardziej przerażona nami, niż my nią”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"Somehow, I doubt that.\""
msgstr "„Jakoś śmiem wątpić”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"Hey, we got other specimens that could withstand a grenade.\""
msgstr "„Hej, mamy inne okazy, które wytrzymują wybuch granatu”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"And that's supposed to comfort me?\""
msgstr "„I to mnie niby miało pocieszyć?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"At least we know they can die.\""
msgstr "„Przynajmniej wiemy, że mogą umrzeć”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"U-O Seven-Seven-Three-Four.\""
msgstr "„N-O Siedem-Siedem-Trzy-Cztery”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"Individual instances of U-O Seven-Seven-Three-Four.\""
msgstr "„Indywidualne przypadki N-O Siedem-Siedem-Trzy-Cztery”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"To be kept in a standard biohazardous containment chamber.\""
msgstr "„Trzymać w standardowej komorze izolacji zagrożeń biologicznych”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"Until such time as more permanent arrangements are made.\""
msgstr "„Do czasu, aż znajdą zastosowania bardziej trwałe rozwiązania”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"Shows a noted preference for human brain tissue.\""
msgstr "„Wykazuje wybitną preferencję do ludzkiej tkanki mózgowej”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"Destroy the specimen if it begins to interact with the lock.\""
msgstr "„Zniszczyć okaz gdy zacznie wchodzić w interakcję z zamkiem”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Kill them all and let God sort them out!\""
msgstr "„Zabić ich wszystkich! Bóg rozpozna swoich!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"I watched a snail crawl along the edge of a straight razor.\""
msgstr "„Obserwowałem jak ślimak pełnie wzdłuż prostego ostrza”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"I've seen horrors, horrors that you've seen.\""
msgstr "„Widziałem horror, horror który ty widziałeś”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"I love the smell of napalm in the morning.\""
msgstr "„Uwielbiam zapach napalmu o poranku”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"This is the way the fuckin' world ends.\""
msgstr "„I tak się kończy ten pieprzony świat”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Look at this fuckin' shit we're in, man.\""
msgstr "„Spójrz na to gówno w którym się znaleźliśmy, człowieku”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Every man has got a breaking point.\""
msgstr "„Każdy człowiek ma swoją wytrzymałość”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I'ma cut those fuckin' tentacles off, bitch!\""
msgstr "„Utnę ci te pieprzone macki, dziwko!”"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Watch you bleed out!\""
msgstr "„Będę patrzeć jak się wykrwawiasz!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I wonder if it understands us.\""
msgstr "„Ciekawe, czy nas rozumie?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"Do you understand what I'm saying?\""
msgstr "„Rozumiesz, co mówię?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi-go-surgeon
#: data/json/speech.json
msgid "\"Look, it's responding!\""
msgstr "„Zobacz, reaguje!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"That's the first time it moved all morning.\""
msgstr "„Po raz pierwszy się poruszyło od samego rana”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I'm certain it's trying to understand us.\""
msgstr "„Jestem pewien, że próbuje nas zrozumieć”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I'm not convinced it can actually comprehend us.\""
msgstr "„Jestem przekonany, że jest w stanie nas pojąć”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"It's just repeating us.\""
msgstr "„Tylko po nas powtarza”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Just being an alien creature doesn't mean it's intelligent.\""
msgstr "„To, że jest obce, nie oznacza, że jest inteligentne”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"Just because it doesn't look like you doesn't mean that it isn't.\""
msgstr "„To, że nie wygląda jak ty, nie oznacza. że nie jest”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Please open the door and enter the cell.\""
msgstr "„Proszę otworzyć drzwi i wejść do celi”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"Would it react differently with a child?\""
msgstr "„Zareagowało by inaczej w przypadku dziecka?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"Experiments to determine extent of cognitive abilities still underway.\""
msgstr ""
"„Eksperymenty mające stwierdzić rozmiar zdolności poznawczych są nadal w "
"trakcie”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid ""
"\"Subject has so far displayed a total lack of empathy toward human "
"suffering.\""
msgstr ""
"„Podmiot dotychczas wykazał zupełny brak empatii na ludzkie cierpienie”."

