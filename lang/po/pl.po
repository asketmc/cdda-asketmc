msgstr[2] "par stalowych naramienników"
msgstr[3] "pary stalowych naramienników"

#. ~ Description of "pair of steel bracers"
#: data/mods/Magiclysm/items/enchanted_bracers.json
msgid "A full assembly of medieval arm protection."
