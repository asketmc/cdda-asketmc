#: src/options.cpp:216
msgid "World Defaults"
msgstr "Domyślne świata"

#: src/options.cpp:218
msgid "Android"
msgstr "Android"

#: src/options.cpp:803
#, c-format
msgid "Default: %s - Values: %s"
