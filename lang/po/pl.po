#. ~ Profession name for male
#: data/json/professions.json
msgctxt "profession_male"
msgid "Kitted Survivor"
msgstr "Wyposażony ocalały"

#. ~ Description of profession "Kitted Survivor" for male
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"At the local mall, you saw a sign advertising a discount on survival kits.  "
"You bought one, more for show than for actual use.  Now it's all you have."
msgstr ""
"W lokalnym centrum handlowym zobaczyłeś tabliczkę reklamującą zniżkę na "
"zestawy surwiwalowe. Kupiłeś jeden, bardziej na pokaz niż do rzeczywistego "
"użytku. Teraz to wszystko, co masz."

#. ~ Profession name for female
#: data/json/professions.json
msgctxt "profession_female"
msgid "Kitted Survivor"
msgstr "Wyposażona ocalała"

#. ~ Description of profession "Kitted Survivor" for female
#: data/json/professions.json
msgctxt "prof_desc_female"
msgid ""
"At the local mall, you saw a sign advertising a discount on survival kits.  "
