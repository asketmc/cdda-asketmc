msgstr "Wymień wadliwą pompę wody"

#. ~ Success message of mending method "Faulty water pump" to fault "Replace
#. faulty water pump"
#: data/json/obsoletion/faults.json
#, c-format
msgid "You replace the faulty water pump of the %s."
msgstr "Wymieniasz wadliwą pompę wody %s."

#. ~ Mutation name
#: data/json/obsoletion/mutations.json
msgid "Reflex Photophore (on)"
msgstr "Refleksyjne fotofory (wł.)"

#. ~ Trigger message of mutation "Reflex Photophore (on)"
#: data/json/obsoletion/mutations.json
msgid "Your glow fades."
msgstr "Twój blask gaśnie."

