msgid_plural "alien lard"
msgstr[0] "smalec obcych"
msgstr[1] "smalce obcych"
msgstr[2] "smalców obcych"
msgstr[3] "smalcu obcych"

#. ~ Description of "alien lard"
#: data/mods/Aftershock/items/comestibles/alienfood.json
msgid ""
"A smooth white block of dry-rendered animal fat.  It'll last for a very long"
" time, but you are unsure of its edibility.  Can be used as an ingredient in"
" many foods and projects."
msgstr ""
"Gładki, biały blok wytopionego na sucho tłuszczu zwierzęcego. Zachowa "
"trwałość przez bardzo długi czas, ale nie masz pewności co do jego "
"jadalności. Może być używany jako składnik wielu potraw i projektów."

#. ~ Item name
#: data/mods/Aftershock/items/comestibles/alienfood.json
msgid "unidentifiable alien organs"
msgid_plural "unidentifiable alien organs"
msgstr[0] "nieidentyfikowalny obcy organ"
msgstr[1] "nieidentyfikowalne obce organy"
msgstr[2] "nieidentyfikowalnych obcych organów"
msgstr[3] "nieidentyfikowalnego obcego organu"

#. ~ Description of "unidentifiable alien organs"
#: data/mods/Aftershock/items/comestibles/alienfood.json
msgid ""
"An unidentifiable pile of organs; you have no idea how you'd prepare them."
msgstr ""
"Nieidentyfikowalna sterta organów; nie masz pojęcia, jak byś je przygotował."

#. ~ Item name
#: data/mods/Aftershock/items/comestibles/alienfood.json
msgid "alien cracklins"
msgid_plural "alien cracklins"
msgstr[0] "obce skwarki"
msgstr[1] "obce skwarki"
msgstr[2] "obcych skwarków"
msgstr[3] "obcego skwarka"

#. ~ Description of "alien cracklins"
#: data/mods/Aftershock/items/comestibles/alienfood.json
msgid ""
"Bits of alien fat and skin that have been fried until they are crispy and "
"delicious (at least, you hope they are)."
msgstr ""
"Kawałki obcego tłuszczu i skóry, które zostały usmażone, aż będą chrupiące i"
" pyszne (przynajmniej masz nadzieję, że takie są)."

#. ~ Item name
#: data/mods/Aftershock/items/comestibles/alienfood.json
