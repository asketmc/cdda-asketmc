#. ~ Profession name for male
#: data/json/hobbies.json
msgctxt "profession_male"
msgid "Swimming"
msgstr "Pływanie"

#. ~ Description of profession "Swimming" for male
#: data/json/hobbies.json
msgctxt "prof_desc_male"
msgid ""
"You're a strong swimmer, and you're pretty sure zombies aren't.  You can't "
"swim forever, but it's certainly an advantage over the undead."
msgstr ""
"Jesteś dobrym pływakiem a jesteś pewien, że zombie nie są. Nie możesz pływać"
" wiecznie, ale to na pewno przewaga nad nieumarłymi."

#. ~ Profession name for female
#: data/json/hobbies.json
