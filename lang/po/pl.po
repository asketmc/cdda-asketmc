msgstr[1] "podręczniki pracy z ostrzem CRIT"
msgstr[2] "podręczników pracy z ostrzem CRIT"
msgstr[3] "podręcznika pracy z ostrzem CRIT"

#. ~ Description of "C.R.I.T Blade-work manual"
#: data/mods/CRT_EXPANSION/martial/CRT_Bladework.json
msgid "An advanced military manual on C.R.I.T Blade-work."
msgstr "Zaawansowany podręcznik wojskowy dotyczący pracy z ostrzem CRIT."

#. ~ Name of martial art
#: data/mods/CRT_EXPANSION/martial/CRT_Bladework.json
msgid "C.R.I.T Blade-work"
