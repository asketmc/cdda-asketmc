msgstr "正確な一撃(素手)"

#. ~ Martial technique name
#: data/json/martialarts_fictional.json
msgid "Biojutsu Impale"
msgstr "串刺し(サイボーグ格闘術)"

#. ~ Message of martial technique "Biojutsu Impale"
#: data/json/martialarts_fictional.json
#, c-format
msgid "You brutally impale %s with your weapon"
msgstr "%sに対して武器による残忍な串刺し攻撃を繰り出しました"

#. ~ Message of martial technique "Biojutsu Impale"
#: data/json/martialarts_fictional.json
#, c-format
msgid "<npcname> brutally impales %s with their weapon"
msgstr "<npcname>は%sに対して武器による残忍な串刺し攻撃を繰り出しました"

#. ~ Martial technique name
#: data/json/martialarts_fictional.json
msgid "Biojutsu Takedown"
msgstr "テイクダウン(サイボーグ格闘術)"

#. ~ Message of martial technique "Biojutsu Takedown"
#: data/json/martialarts_fictional.json
#, c-format
msgid "You kick and slam %s to the ground"
msgstr "%sを蹴って叩き伏せました"

#. ~ Message of martial technique "Biojutsu Takedown"
#: data/json/martialarts_fictional.json
#, c-format
msgid "<npcname> kicks and slams %s to the ground"
msgstr "<npcname>は%sを蹴って叩き伏せました"

#. ~ Martial technique name
#: data/json/martialarts_fictional.json
msgid "Biojutsu Cleave"
msgstr "切り裂き(サイボーグ格闘術)"

#. ~ Message of martial technique "Biojutsu Cleave"
#: data/json/martialarts_fictional.json
#, c-format
msgid "You quickly cleave through %s and those nearby"
msgstr "周囲を巻き込みながら素早く%sを切り裂きました"

#. ~ Message of martial technique "Biojutsu Cleave"
#: data/json/martialarts_fictional.json
#, c-format
msgid "<npcname> quickly cleaves through %s and those nearby"
msgstr "<npcname>は周囲を巻き込みながら素早く%sを切り裂きました"

#. ~ Martial technique name
#: data/json/martialarts_fictional.json
msgid "Lizard Strike"
msgstr "ヤモリの一撃"

#. ~ Message of martial technique "Lizard Strike"
#: data/json/martialarts_fictional.json
#, c-format
msgid "You spearhand strike %s"
msgstr "%sに鋭く強烈な一撃を放ちました"

#. ~ Message of martial technique "Lizard Strike"
#: data/json/martialarts_fictional.json
#, c-format
msgid "<npcname> spearhand strikes %s"
msgstr "<npcname>は%sに鋭く強烈な一撃を放ちました"

#. ~ Martial technique name
#: data/json/martialarts_fictional.json
msgid "Lizard Tail"
msgstr "ヤモリの鞭尾"

#. ~ Message of martial technique "Lizard Tail"
#. ~ Message of martial technique "Crane Kick"
#: data/json/martialarts_fictional.json data/json/techniques.json
#, c-format
msgid "You leap and kick %s"
msgstr "跳躍して%sを蹴りました"

#. ~ Message of martial technique "Lizard Tail"
#. ~ Message of martial technique "Crane Kick"
#: data/json/martialarts_fictional.json data/json/techniques.json
#, c-format
msgid "<npcname> leaps and kicks %s"
msgstr "<npcname>は跳躍して%sを蹴りました"

#. ~ Martial technique name
#: data/json/martialarts_fictional.json data/json/techniques.json
msgid "Grab Break"
msgstr "拘束外し"

#. ~ Message of martial technique "Grab Break"
#: data/json/martialarts_fictional.json
#, c-format
msgid "The %s tries to grab you, but you outmaneuver it!"
msgstr "%sが掴みかかろうとしましたが、力を込めて抜け出しました！"

#. ~ Message of martial technique "Grab Break"
#: data/json/martialarts_fictional.json
#, c-format
msgid "The %s tries to grab <npcname>, but they outmaneuver it!"
msgstr "<npcname>は%sに掴まれそうになりましたが、力を込めて抜け出しました！"

#. ~ Martial technique name
#: data/json/martialarts_fictional.json
msgid "Lizard Wall Dive"
msgstr "ヤモリの壁撃"

#. ~ Message of martial technique "Lizard Wall Dive"
#: data/json/martialarts_fictional.json
#, c-format
msgid "You push off a nearby wall and strike down at %s"
msgstr "壁を押して勢いをつけ、%s目がけて飛び掛かりました"

#. ~ Message of martial technique "Lizard Wall Dive"
#: data/json/martialarts_fictional.json
#, c-format
msgid "<npcname> pushes off a nearby wall and strikes down at %s"
msgstr "<npcname>は壁を押して勢いをつけ、%s目がけて飛び掛かりました"

#. ~ Martial technique name
#: data/json/martialarts_fictional.json
msgid "Viper Hiss"
msgstr "毒蛇の威嚇"

#. ~ Message of martial technique "Viper Hiss"
#: data/json/martialarts_fictional.json
#, c-format
msgid "You hiss threateningly at %s"
msgstr "%sを威嚇しました"

#. ~ Message of martial technique "Viper Hiss"
#: data/json/martialarts_fictional.json
#, c-format
msgid "<npcname> hisses threateningly at %s"
msgstr "<npcname>は%sを威嚇しました"

#. ~ Martial technique name
#: data/json/martialarts_fictional.json
msgid "Viper Fist"
msgstr "毒蛇拳"

#. ~ Message of martial technique "Viper Fist"
#: data/json/martialarts_fictional.json
#, c-format
msgid "You quickly chop %s"
msgstr "%sに素早い突きを繰り出しました"

#. ~ Message of martial technique "Viper Fist"
#: data/json/martialarts_fictional.json
#, c-format
msgid "<npcname> quickly chops %s"
msgstr "<npcname> は%sに素早い突きを繰り出しました"

#. ~ Martial technique name
#: data/json/martialarts_fictional.json
msgid "Viper Bite"
msgstr "毒蛇咬"

#. ~ Message of martial technique "Viper Bite"
#: data/json/martialarts_fictional.json
#, c-format
msgid "You lash out at %s with a Viper Bite"
msgstr "毒蛇咬で%sに激しく襲い掛かりました"

#. ~ Message of martial technique "Viper Bite"
#: data/json/martialarts_fictional.json
#, c-format
msgid "<npcname> lash out at %s with a Viper Bite"
msgstr "<npcname>は毒蛇咬で%sに激しく襲い掛かりました"

#. ~ Martial technique name
