#. ~ Item name
#: data/json/items/generic/casing.json
msgid "40x46mm M212 casing"
msgid_plural "40x46mm M212 casings"
msgstr[0] "空薬莢(40x46mm/M212)"

#. ~ Description of "40x46mm M212 casing"
#: data/json/items/generic/casing.json
msgid ""
"A large casing from a spent 40x46mm cartridge, which used to hold a less-"
"lethal projectile."
msgstr "使用済みの40x46mm空薬莢です。致死性の低い弾薬として使われていました。"

#. ~ Item name
#: data/json/items/generic/casing.json
msgid "40x46mm M118 casing"
msgid_plural "40x46mm M118 casings"
msgstr[0] "空薬莢(40x46mm/M118)"

#. ~ Description of "40x46mm M118 casing"
#: data/json/items/generic/casing.json
msgid ""
"A large casing from a spent 40x46mm cartridge, which used to hold an HEDP "
"grenade.  Suitable for reloading with buckshot, slug or flechette loads."
msgstr "多目的榴弾として使われていた40x46mm空薬莢です。散弾、単発弾、矢弾の製作に適しています。"

#. ~ Item name
#: data/json/items/generic/casing.json
msgid "40x46mm M199 casing"
msgid_plural "40x46mm M199 casings"
msgstr[0] "空薬莢(40x46mm/M199)"

#. ~ Description of "40x46mm M199 casing"
#: data/json/items/generic/casing.json
msgid ""
"A large casing from a spent 40x46mm cartridge, which used to hold a buckshot"
" load.  Suitable for reloading with buckshot, slug or flechette loads."
msgstr "散弾として使われていた40x46mm空薬莢です。散弾、単発弾、矢弾の製作に適しています。"

#. ~ Item name
#: data/json/items/generic/casing.json
msgid "40x46mm M195 casing"
