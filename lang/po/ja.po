msgstr "%sを付け直す"

#: src/iuse.cpp:2196
#, c-format
msgid "Activate the %s"
msgstr "%sを起動する"

#: src/iuse.cpp:2196
#, c-format
msgid "Deactivate the %s"
msgstr "%sを停止する"

#: src/iuse.cpp:2198
#, c-format
msgid "Reload the %s"
msgstr "%sに装填する"

#: src/iuse.cpp:2199
#, c-format
msgid "Unload the %s"
msgstr "%sを取り外す"

#. ~ The player has nothing that fits in the modular exoskeleton's pocket
#: src/iuse.cpp:2260
msgid "You don't have anything compatible with this module!"
msgstr "このモジュールと互換性のあるアイテムがありません。"

#. ~ Prompt the player to select an item to attach to the modular
#. exoskeleton's pocket (%s)
#: src/iuse.cpp:2265
#, c-format
msgid "Which module to attach to the %s?"
msgstr "%sに取り付けるモジュールを選択"

#: src/iuse.cpp:2304
#, c-format
msgid "Your %s does not have any pockets to contain modules."
msgstr "%sにはモジュールを取り付けるポケットがありません。"

#: src/iuse.cpp:2315
msgid "The RM13 combat armor's fuel cells are dead."
msgstr "RM13コンバットアーマーの動力が切れました。"

#: src/iuse.cpp:2319
msgid "You activate your RM13 combat armor."
msgstr "RM13コンバットアーマーを起動しました。"

#: src/iuse.cpp:2320
msgid "Rivtech Model 13 RivOS v2.19:   ONLINE."
msgstr "Rivtech モデル 13 RivOS v2.19: オンライン"

#: src/iuse.cpp:2321
msgid "CBRN defense system:            ONLINE."
msgstr "CBRN防衛システム: オンライン"

#: src/iuse.cpp:2322
msgid "Acoustic dampening system:      ONLINE."
msgstr "音響減衰システム: オンライン"

#: src/iuse.cpp:2323
msgid "Thermal regulation system:      ONLINE."
msgstr "体温調整システム: オンライン"

#: src/iuse.cpp:2324
msgid "Vision enhancement system:      ONLINE."
msgstr "視覚増幅システム: オンライン"

#: src/iuse.cpp:2325
msgid "Electro-reactive armor system:  ONLINE."
msgstr "電子反応装甲システム: オンライン"

#: src/iuse.cpp:2326
msgid "All systems nominal."
msgstr "全システム異常なし。"

#: src/iuse.cpp:2344
msgid "RivOS v2.19 shutdown sequence initiated."
msgstr "RivOS v2.19 のシャットダウン処理を開始しました。"

#: src/iuse.cpp:2345
msgid "Shutting down."
msgstr "シャットダウンしています。"

#: src/iuse.cpp:2346
msgid "Your RM13 combat armor turns off."
msgstr "RM13コンバットアーマーが機能を停止しました。"

#: src/iuse.cpp:2361
#, c-format
msgid "You unpack your %s for use."
msgstr "%sを使うために開封しました。"

#: src/iuse.cpp:2372
msgid "Choose CBM to pack"
msgstr "密封するCBMを選択"

#: src/iuse.cpp:2372
msgid "You don't have any CBMs."
msgstr "CBMがありません。"

#: src/iuse.cpp:2378
msgid "This CBM is faulty.  You should mend it first.  Do you want to try?"
msgstr "このCBMは欠陥品であり、修復する必要があります。修復を試みますか？"

#: src/iuse.cpp:2386
msgid "You carefully prepare the CBM for sterilization."
msgstr "CBMの滅菌準備を慎重に進めました。"

#: src/iuse.cpp:2389
msgid "You fail to properly prepare the CBM."
msgstr "CBMの滅菌準備に失敗しました。"

#: src/iuse.cpp:2407
#, c-format
msgid "You can't pack your %s until you take it off."
msgstr "%sを所持していないと密封できません。"

#: src/iuse.cpp:2419
#, c-format
msgid "You pack your %s for storage."
msgstr "保管のため%sに封をしました。"

#: src/iuse.cpp:2435
msgid "Purify what?"
msgstr "浄水するアイテムを選択"

#: src/iuse.cpp:2435
msgid "You don't have water to purify."
msgstr "浄水できる水がありません。"

#: src/iuse.cpp:2450
msgid "That volume of water is too large to purify."
msgstr "浄水する量が多すぎます。"

#: src/iuse.cpp:2465 src/iuse.cpp:2654 src/iuse.cpp:2679
msgid "It's dead."
msgstr "反応がありません。"

#: src/iuse.cpp:2467
msgid "You turn the radio on."
msgstr "ラジオをつけました。"

#: src/iuse.cpp:2489
msgid "You must have an active radio to check for signal direction."
msgstr "信号の方向を調べるには、電源が入ったラジオが必要です。"

#: src/iuse.cpp:2496
msgid "You can't find the direction if your radio isn't tuned."
msgstr "ラジオがチューニングされていないと信号の方向が分かりません。"

#: src/iuse.cpp:2502
#, c-format
msgid "The signal seems strongest to the %s."
msgstr "最も強い信号は%sから来ています。"

#: src/iuse.cpp:2534
msgid "Radio: Kssssssssssssh."
msgstr "ラジオ: ザァァァァァ..."

#. ~ radio noise
#: src/iuse.cpp:2550
msgid "ksssh"
msgstr "ザアアァァ..."

#: src/iuse.cpp:2572
#, c-format
msgid "radio: %s"
msgstr "ラジオ: %s"

#: src/iuse.cpp:2586
msgid "Radio:"
msgstr "ラジオ: "

#: src/iuse.cpp:2587
msgid "Scan"
msgstr "スキャン"

#: src/iuse.cpp:2613
msgid "Select a station"
msgstr "周波数を選択"

#: src/iuse.cpp:2620
msgctxt "radio station"
msgid " (selected)"
msgstr " (選択中)"

#. ~ Selected radio station, %d is a number in sequence (1,2,3...),
#. ~ %s is ' (selected)' if this is the radio station playing, else nothing
#: src/iuse.cpp:2624
#, c-format
msgid "Station %d%s"
msgstr "%d%s"

#: src/iuse.cpp:2640
msgid "The radio dies."
msgstr "ラジオは静かになりました。"

#: src/iuse.cpp:2657
msgid "You turn the noise emitter on."
msgstr "ノイズ発生器を起動しました。"

#. ~ the sound of a noise emitter when turned on
#: src/iuse.cpp:2667
msgid "KXSHHHHRRCRKLKKK!"
msgstr "ガガザーガギャギャザピー！！"

#: src/iuse.cpp:2670
msgid "The infernal racket dies as the noise emitter turns off."
msgstr "悪夢のような酷い騒音を発するノイズ発生器のスイッチを切りました。"

#: src/iuse.cpp:2682
msgid "You turn the EMF detector on."
msgstr "電磁波計を起動しました。"

