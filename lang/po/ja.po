#. ~ Message in an effect
#: data/mods/My_Sweet_Cataclysm/sweet_field_type.json
msgid "Some gum sticks to you."
msgstr "ガムが付着しました。"

#. ~ Field intensity level
#: data/mods/My_Sweet_Cataclysm/sweet_field_type.json
msgid " gum webs"
