msgstr "美麗な飾り鍔を持つ、古代中国で使われた両刃の直剣...の安価で刃が鈍いレプリカです。"

#. ~ Item name
#: data/json/items/melee/swords_and_blades.json
#: data/mods/MMA/exemplar_weapons.json
msgid "scimitar"
msgid_plural "scimitars"
msgstr[0] "シミター"

#. ~ Description of "scimitar"
#: data/json/items/melee/swords_and_blades.json
msgid ""
"A curved sword associated with various Middle Eastern and Central Asian "
