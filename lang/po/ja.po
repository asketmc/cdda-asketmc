msgstr[0] "木箱S"

#. ~ ~7x20x15 or ~4x22x22
#. ~ Description of "small wooden box"
#: data/json/items/containers.json
msgid ""
"A small wooden box.  Beautifully made, perhaps it could hold something "
"precious."
msgstr "美しいデザインの小さな木箱です。何か大事なものが入っているかもしれません。"

#. ~ (25x40x50)
#. ~ Item name
#: data/json/items/containers.json
msgid "wooden box"
msgid_plural "wooden boxes"
msgstr[0] "木箱M"

#. ~ (25x40x50)
#. ~ Description of "wooden box"
#: data/json/items/containers.json
msgid "A hefty wooden box.  Great for storing items."
msgstr "小物入れにぴったりの、重そうな木箱です。"

#. ~ (60x60x90)
#. ~ Item name
#: data/json/items/containers.json
msgid "large wooden box"
msgid_plural "large wooden boxes"
msgstr[0] "木箱L"

#. ~ (60x60x90)
#. ~ Description of "large wooden box"
#: data/json/items/containers.json
msgid "A small wooden crate.  Sturdy, but still light enough to be moved."
msgstr "頑丈かつ持ち運べる程度には軽い、大型の木箱です。"

#. ~ (200x50x20)
#. ~ Item name
#: data/json/items/containers.json
msgid "oversize wooden box"
msgid_plural "oversize wooden boxes"
msgstr[0] "木箱XL"

#. ~ (200x50x20)
#. ~ Description of "oversize wooden box"
#: data/json/items/containers.json
