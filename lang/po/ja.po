msgstr[0] "記憶装置モジュール"

#. ~ Description of "memory banks module"
#: data/json/items/robot_parts.json
msgid "Allows for storage and recovery of information."
msgstr "情報の保存と復旧を可能にするモジュールです。"

#. ~ Item name
#: data/json/items/robot_parts.json
