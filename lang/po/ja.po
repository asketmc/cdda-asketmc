#. ~ Item name
#: data/mods/Aftershock/items/robotparts.json
msgid "military humaniform chassis"
msgid_plural "military humaniform chassis"
msgstr[0] "シャシー(人型ロボット)"

#. ~ Description of "military humaniform chassis"
#: data/mods/Aftershock/items/robotparts.json
msgid ""
"What's left when you remove all moving parts and electronics.  You still "
"feel deep down that its hollow eyes are studying you."
msgstr "人型ロボットから全ての稼働部品と電子機器を取り除いて残った骨組みです。空になった眼窩が未だにこちらを観察しているような気がしてなりません。"

#. ~ Item name
#: data/mods/Aftershock/items/seed.json
msgid "pineapple stem"
msgid_plural "pineapple stem"
msgstr[0] "茎(パイナップル)"

#. ~ Description of "pineapple stem"
#: data/mods/Aftershock/items/seed.json
msgid "Roots of a pineapple plant, for growing your own."
msgstr "パイナップルの根茎です。自家栽培できます。"

#. ~ Item name
#: data/mods/Aftershock/items/seed.json
#: data/mods/TropiCataclysm/items/comestibles/seed.json
msgid "melon seeds"
msgid_plural "melon seeds"
msgstr[0] "種(メロン)"

#. ~ Description of "melon seeds"
#: data/mods/Aftershock/items/seed.json
msgid "Some melon seeds."
msgstr "メロンの種です。"

#. ~ Item name
#: data/mods/Aftershock/items/seed.json
msgid "banana saplings"
msgid_plural "banana saplings"
msgstr[0] "苗(バナナ)"

#. ~ Description of "banana saplings"
#: data/mods/Aftershock/items/seed.json
