#. ~ MOD name
#: data/mods/Megafauna/modinfo.json
msgid "Megafauna"
msgstr "変更 - 絶滅した巨大生物"

#. ~ Description of MOD "Megafauna"
#: data/mods/Megafauna/modinfo.json
msgid ""
"Adds extinct pleistocene megafauna to the game, replacing modern day and "
"introduced animals."
msgstr "現代の動物や帰化動物に代わって、既に絶滅している更新世の生物をゲーム内に追加します。"

#. ~ Terrain name
#: data/mods/Megafauna/furniture_and_terrain/terrain-manufactured.json
msgid "glyptodont-shell shelter"
msgstr "甲羅シェルター"

#. ~ Description of terrain "glyptodont-shell shelter"
#: data/mods/Megafauna/furniture_and_terrain/terrain-manufactured.json
msgid ""
"Improvised shelter made of a glyptodont shell, providing a little bit of "
"protection against the elements or predators."
msgstr "具リプとドンの甲羅で作った簡易シェルターです。風雨や外敵から多少は身を守れます。"

#. ~ Item name
#: data/mods/Megafauna/items/animal_products.json
msgid "mammoth tusk"
msgid_plural "mammoth tusks"
msgstr[0] "マンモスの牙"

#. ~ Description of "mammoth tusk"
#: data/mods/Megafauna/items/animal_products.json
msgid "A huge curved tusk of a mammoth."
msgstr "マンモスの湾曲した巨大な牙です。"

#. ~ Item name
#: data/mods/Megafauna/items/animal_products.json
msgid "great auk egg"
msgid_plural "great auk eggs"
msgstr[0] "卵(オオウミガラス)"

#. ~ Description of "great auk egg"
#: data/mods/Megafauna/items/animal_products.json
msgid "An egg laid by a great auk.  Prized for its big, nutritious yolk."
msgstr "オオウミガラスの卵です。黄身が大きく栄養価が高いため、珍重されています。"

#. ~ Item name
#: data/mods/Megafauna/items/animal_products.json
msgid "glyptotherium shell"
msgid_plural "glyptotherium shells"
msgstr[0] "グリプトテリウムの装甲"

#. ~ Description of "glyptotherium shell"
#: data/mods/Megafauna/items/animal_products.json
msgid "A huge shell laboriously carved from a glyptotherium."
msgstr "グリプトテリウムから取り外された、巨大な装甲です。"

#. ~ Item name
#: data/mods/Megafauna/items/animal_products.json
msgid "large bone"
msgid_plural "large bones"
msgstr[0] "巨大骨"

#. ~ Description of "large bone"
#: data/mods/Megafauna/items/animal_products.json
msgid "A huge bone of a large creature."
msgstr "巨大な生物の骨です。"

#. ~ Item name
#: data/mods/Megafauna/items/tool/shelters.json
msgid "mammoth shelter kit"
msgid_plural "mammoth shelter kits"
msgstr[0] "マンモスシェルター"

#. ~ Description of "mammoth shelter kit"
#: data/mods/Megafauna/items/tool/shelters.json
msgid ""
"This is a small shelter, made of large bones, mammoth tusks, and skins.  Use"
" it to place."
msgstr "巨大な骨やマンモスの牙、皮などで作った、狭いシェルターです。使用すると設置します。"

#. ~ Item name
#: data/mods/Megafauna/items/tool/shelters.json
