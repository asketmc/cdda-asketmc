#. ~ Item name
#: data/json/items/ammo/shot.json
msgid "base shotshell"
msgid_plural "base shotshells"
msgstr[0] "弾薬(12ga/ﾍﾞｰｽ)"

#. ~ Item name
#: data/json/items/ammo/shot.json
msgid "00 shot"
msgid_plural "00 shot"
msgstr[0] "弾薬(12ga/散弾)"

#. ~ Description of "00 shot"
#: data/json/items/ammo/shot.json
msgid ""
"A shell filled with metal pellets.  Extremely damaging, plus the spread "
