msgid "What to do with the existing module?"
msgstr "既存のモジュールはどうしますか？"

#: src/iuse.cpp:2192
#, c-format
msgid "Unload everything from this %s"
msgstr "%sから全て取り外す"

#: src/iuse.cpp:2194
#, c-format
