#. ~ Item name
#: data/json/items/armor/storage.json
msgid "hiking backpack"
msgid_plural "hiking backpacks"
msgstr[0] "ハイキングバックパック"

#. ~ Description of "hiking backpack"
#: data/json/items/armor/storage.json
msgid "A large hiking backpack with plenty of storage space."
msgstr "収納力がある大型のハイキング用バックパックです。"

#. ~ "holster_prompt" action message of item "hiking backpack"
#. ~ "holster_prompt" action message of item "C.R.I.T web belt"
#. ~ "holster_prompt" action message of item "technomancer's toolbelt"
