#: src/dialogue_chatbin.h:114
msgid "Don't move a <swear> muscle…"
msgstr "その<swear>筋肉をぴくりとも動かすなよ..."

#: src/dialogue_chatbin.h:115
msgid "I've lost lot of blood."
msgstr "大量に出血してしまった。"

#: src/dialogue_chatbin.h:116
#, c-format
msgid "Hold on, I want to pulp that %s."
msgstr "ちょっと待ってくれ、その%sを破壊したいんだ。"

#: src/dialogue_chatbin.h:117
#, c-format
msgid "Hold still %s, I'm coming to help you."
msgstr "%s、じっとして、今助ける。"

#: src/dialogue_chatbin.h:118
#, c-format
msgid "My %s wound is infected…"
msgstr "%sの傷が感染症に罹っている..."

#: src/dialogue_chatbin.h:119
#, c-format
msgid "The bite wound on my %s looks bad."
msgstr "%sの傷がまずいことになっている。"

#: src/dialogue_chatbin.h:120
#, c-format
msgid "My %s is bleeding!"
msgstr "%sから出血している！"

#: src/dialogue_chatbin.h:121
#, c-format
msgid "My %s is bleeding badly!"
msgstr "%sから大量に出血している！"

#: src/dialogue_chatbin.h:122
msgid "I'm suffering from radiation sickness…"
msgstr "放射線障害で酷い状態だ..."

#: src/dialogue_chatbin.h:129
msgid "I don't <swear> trust you enough to eat THIS…"
msgstr "<swear>、こんなものを食べるほど信用はしてないよ..."

#: src/dialogue_chatbin.h:130 src/dialogue_chatbin.h:135
msgid "It doesn't look like a good idea to consume this…"
msgstr "これを摂取するのが良い考えだとは思えないね..."

#: src/dialogue_chatbin.h:131
msgid "This is rotten!  I won't eat that."
msgstr "これは腐っている！食べたくないね。"

#: src/dialogue_chatbin.h:132
msgid "Thanks, that hit the spot."
msgstr "ありがとう、ちょうど食べたかったんだ。"

#: src/dialogue_chatbin.h:133
#, c-format
msgid "I need a %s to consume that!"
msgstr "それを摂取するには%sが必要だ！"

#: src/dialogue_chatbin.h:134
msgid "Thanks, I feel better already."
msgstr "ありがとう、具合がよくなったよ。"

#: src/dialogue_chatbin.h:136
msgid "Thanks, I used it."
msgstr "ありがとう、使わせてもらうよ。"

#: src/dialogue_chatbin.h:139
msgid "Changed your mind?"
msgstr "気が変わった？"

#: src/dialogue_chatbin.h:140
msgid "Are you <swear> insane!?"
msgstr "おい <swear>！気でも狂ったか！？"

#: src/dialogue_chatbin.h:141
msgid "Thanks, I'll wield that now."
msgstr "ありがとう、さっそく装備するよ。"

#: src/dialogue_chatbin.h:142
msgid "My current weapon is better than this.\n"
msgstr "今装備している武器の方がいいな。\n"

#: src/dialogue_chatbin.h:143
msgid "Thanks, I'll carry that now."
msgstr "ありがとう、持っておくよ。"

#: src/dialogue_chatbin.h:144
msgid "I have no space to store it."
msgstr "収納するスペースがないな。"

#: src/dialogue_chatbin.h:145
#, c-format
msgid "I can only store %s %s more."
msgstr "あと%s %sしか所持できない。"

#: src/dialogue_chatbin.h:146
msgid "…or to store anything else for that matter."
msgstr "...何か別のものを持つよ。"

#: src/dialogue_chatbin.h:147
msgid "It is too heavy for me to carry."
msgstr "重すぎて持てないな。"

#: src/dialogue_chatbin.h:150
msgid "Thanks, I'll wear that now."
msgstr "ありがとう、さっそく着用するよ。"

