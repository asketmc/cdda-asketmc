msgstr "氷で作られた下り坂の斜面です。"

#. ~ Terrain name
#: data/mods/Aftershock/maps/furniture_and_terrain/terrain_groundxeno.json
msgid "upward glacial ice slope"
msgstr "上り坂(氷)"

#. ~ Description of terrain "upward glacial ice slope"
#: data/mods/Aftershock/maps/furniture_and_terrain/terrain_groundxeno.json
msgid "An upward-facing glacial slope."
msgstr "氷で作られた上り坂の斜面です。"

#. ~ Terrain name
#: data/mods/Aftershock/maps/furniture_and_terrain/terrain_groundxeno.json
msgid "downward basalt slope"
msgstr "下り坂(玄武岩)"

#. ~ Description of terrain "downward basalt slope"
#: data/mods/Aftershock/maps/furniture_and_terrain/terrain_groundxeno.json
msgid "A downward-facing slope of basalt."
msgstr "玄武岩で作られた下り坂の斜面です。"

#. ~ Terrain name
#: data/mods/Aftershock/maps/furniture_and_terrain/terrain_groundxeno.json
msgid "upward basalt slope"
msgstr "上り坂(玄武岩)"

#. ~ Description of terrain "upward basalt slope"
#: data/mods/Aftershock/maps/furniture_and_terrain/terrain_groundxeno.json
msgid "An upward-facing slope of basalt."
msgstr "玄武岩で作られた上り坂の斜面です。"

#. ~ Furniture name
#: data/mods/Aftershock/maps/furniture_and_terrain/terrain_groundxeno.json
msgid "small snow mound"
msgstr "小さな雪山"

#. ~ Description of furniture "small snow mound"
#: data/mods/Aftershock/maps/furniture_and_terrain/terrain_groundxeno.json
msgid "A small pile of snow."
msgstr "雪で作られた小さな山です。"

#. ~ Bashing sound of furniture "small snow mound"
#. ~ Bashing sound of furniture "snow mound"
#. ~ Bashing sound of furniture "large snow mound"
#: data/mods/Aftershock/maps/furniture_and_terrain/terrain_groundxeno.json
msgid "flump!"
msgstr "ボフッ！"

#. ~ Furniture name
#: data/mods/Aftershock/maps/furniture_and_terrain/terrain_groundxeno.json
msgid "snow mound"
msgstr "雪山"

#. ~ Description of furniture "snow mound"
#: data/mods/Aftershock/maps/furniture_and_terrain/terrain_groundxeno.json
