#. ~ Profession name for male
#: data/json/professions.json
msgctxt "profession_male"
msgid "Electrician"
msgstr "電気技師"

#. ~ Description of profession "Electrician" for male
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"Small businesses often hired you for electrical work.  You were halfway "
"through your latest job when the whole power grid went dead."
msgstr "電気工事に駆り出されることが多い、小規模業者です。仕事の最中に停電が発生しました。"

#. ~ Profession name for female
#: data/json/professions.json
msgctxt "profession_female"
msgid "Electrician"
msgstr "電気技師"

#. ~ Description of profession "Electrician" for female
#: data/json/professions.json
