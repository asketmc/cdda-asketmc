msgid_plural "debug monsters"
msgstr[0] "デバッグモンスター"

#. ~ Description of monster "debug monster"
#: data/json/monsters/misc.json
msgid "This monster exists only for testing purposes."
msgstr "このモンスターはデバッグテスト用に存在しています。"

