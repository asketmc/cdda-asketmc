#. ~ Conditional name for "meat soup" when FLAG matches STRICT_HUMANITARIANISM
#: data/json/items/comestibles/soup.json
msgid "goblin soup"
msgid_plural "goblin soup"
msgstr[0] "亜人肉煮込みスープ"

#. ~ Item name
#: data/json/items/comestibles/soup.json
msgid "fish soup"
msgid_plural "fish soups"
msgstr[0] "魚煮込みスープ"

#. ~ Description of "fish soup"
#: data/json/items/comestibles/soup.json
msgid "A nutritious and delicious hearty fish soup."
msgstr "栄養価が高く美味で健康的な魚煮込みスープです。"

#. ~ Item name
#: data/json/items/comestibles/soup.json
msgid "curry"
msgid_plural "curries"
msgstr[0] "カレー"

#. ~ Description of "curry"
#: data/json/items/comestibles/soup.json
msgid "A spicy South Indian dish filled with vegetables."
msgstr "野菜がたっぷり入ったスパイシーな南インド料理です。"

#. ~ Item name
#: data/json/items/comestibles/soup.json
msgid "curry with meat"
msgid_plural "curries with meat"
msgstr[0] "ミートカレー"

#. ~ Description of "curry with meat"
#: data/json/items/comestibles/soup.json
msgid "A spicy South Asian dish filled with chunks of meat and vegetables."
msgstr "野菜や肉がたっぷり入ったスパイシーな南インド料理です。"

#. ~ Conditional name for "curry with meat" when COMPONENT_ID_SUBSTRING
#. matches mutant
#: data/json/items/comestibles/soup.json
msgid "creature curry"
msgid_plural "creature curries"
msgstr[0] "変異肉カレー"

#. ~ Item name
#: data/json/items/comestibles/soup.json
msgid "woods meat soup"
msgid_plural "woods meat soups"
msgstr[0] "森のスープ(肉)"

#. ~ Description of "woods meat soup"
#: data/json/items/comestibles/soup.json
msgid "A nutritious and delicious soup packed with meat and vegetables."
msgstr "肉と野菜がたっぷり入った、栄養満点の美味しいスープです。"

#. ~ Conditional name for "woods meat soup" when COMPONENT_ID_SUBSTRING
#. matches mutant
#. ~ Conditional name for "woods egg soup" when COMPONENT_ID_SUBSTRING matches
#. mutant
#: data/json/items/comestibles/soup.json
msgid "Mirkwood soup"
msgid_plural "Mirkwood soups"
msgstr[0] "森の変異スープ"

#. ~ Item name
#: data/json/items/comestibles/soup.json
msgid "woods egg soup"
msgid_plural "woods egg soups"
msgstr[0] "森のスープ(卵)"

#. ~ Description of "woods egg soup"
#: data/json/items/comestibles/soup.json
msgid "A nutritious and delicious soup packed with eggs and vegetables."
msgstr "卵と野菜がたっぷり入った、栄養満点の美味しいスープです。"

#. ~ Item name
#: data/json/items/comestibles/soup.json
msgid "hellfire stew"
msgid_plural "hellfire stews"
msgstr[0] "ヘルファイアシチュー"

#. ~ Description of "hellfire stew"
#: data/json/items/comestibles/soup.json
msgid ""
"An old recipe from the American Civil War, designed to make hardtack more "
"palatable.  The hardtack is crushed and combined with water to make it "
"soggy, then fried up with melted chunks of fat until browned, and seasoned "
"with salt and pepper.  Surprisingly edible, considering its ingredients."
msgstr ""
"南北戦争時代のアメリカで生まれた、堅パンを食べやすくするための歴史あるレシピです。まず堅パンを砕き、水を加えてドロドロにします。そこへ溶かした脂肪を混ぜて焼き色が付くまで熱し、塩とコショウで味を調えて完成です。使った材料にしては、それなりに食べられる味がします。"

#. ~ Item name
#: data/json/items/comestibles/soup.json
msgid "chicken noodle soup"
msgid_plural "chicken noodle soups"
msgstr[0] "チキンヌードル"

#. ~ Description of "chicken noodle soup"
#: data/json/items/comestibles/soup.json
msgid ""
"Chicken chunks and noodles swimming in a salty broth.  Rumored to help cure "
"colds."
msgstr "塩気のある煮汁に鶏肉と麺が入っています。風邪を治す効果があるという噂がありますね。"

#. ~ Item name
#: data/json/items/comestibles/soup.json
msgid "mushroom soup"
msgid_plural "mushroom soups"
msgstr[0] "キノコスープ"

#. ~ Description of "mushroom soup"
#: data/json/items/comestibles/soup.json
msgid "A mushy, gray semi-liquid soup made from mushrooms."
msgstr "キノコで作った、とろみのある灰色のスープです。"

#. ~ Item name
#: data/json/items/comestibles/soup.json
msgid "blood soup"
msgid_plural "blood soup"
msgstr[0] "ブラッドスープ"

#. ~ Description of "blood soup"
#: data/json/items/comestibles/soup.json
msgid "A mushy, brown semi-liquid soup made from blood and flour."
msgstr "血液と小麦粉で作った、とろみのある茶色いスープです。"

#. ~ Item name
#: data/json/items/comestibles/soup.json
msgid "wheat-free blood soup"
msgid_plural "wheat-free blood soup"
msgstr[0] "穀物不使用ブラッドスープ"

#. ~ Description of "wheat-free blood soup"
#: data/json/items/comestibles/soup.json
msgid "A mushy, brown semi-liquid soup made from blood and wheat-free flour."
msgstr "血液とグルテンフリー粉で作った、とろみのある茶色いスープです。"

#. ~ Item name
#: data/json/items/comestibles/soup.json
msgid "tomato soup"
msgid_plural "tomato soups"
msgstr[0] "トマトスープ"

#. ~ Description of "tomato soup"
#: data/json/items/comestibles/soup.json
msgid ""
"Thin red tomato soup.  Not very filling, but it goes well with grilled "
"cheese."
msgstr "トマトが入った薄味の赤いスープです。あまり食べ応えはありませんが、焼いたチーズと一緒に食べたいですね。"

#. ~ Item name
#: data/json/items/comestibles/soup.json
msgid "chicken and dumplings"
msgid_plural "chicken and dumplings"
msgstr[0] "チキン&ダンプリング"

#. ~ Description of "chicken and dumplings"
#: data/json/items/comestibles/soup.json
msgid "A soup with chicken chunks and balls of dough.  Not bad."
msgstr "鶏肉の団子と穀粉の団子が入ったスープです。悪くありません。"

#. ~ Item name
#: data/json/items/comestibles/soup.json
msgid "cullen skink"
msgid_plural "cullen skinks"
msgstr[0] "カレンスキンク"

#. ~ Description of "cullen skink"
#: data/json/items/comestibles/soup.json
msgid ""
"A rich and tasty fish chowder from Scotland, made with preserved fish and "
"creamy milk."
msgstr "スコットランドの伝統料理、贅沢で美味しい魚のチャウダーです。塩漬けの魚とクリーミーな牛乳を使っています。"

#. ~ Item name
#: data/json/items/comestibles/soup.json
msgid "lobster stew"
msgid_plural "lobster stews"
msgstr[0] "ロブスターシチュー"

#. ~ Description of "lobster stew"
#: data/json/items/comestibles/soup.json
msgid ""
"A rich and tasty lobster stew from New England, made with fresh lobster, "
"milk, cream, and butter."
msgstr "新鮮なロブスターと牛乳、生クリーム、バターで作る、ニューイングランド地方名物の濃厚なシチューです。"

#. ~ Item name
#: data/json/items/comestibles/soup.json
msgid "instant chicken noodle soup"
msgid_plural "instant chicken noodle soups"
msgstr[0] "即席チキンヌードル(調理済)"

#. ~ Description of "instant chicken noodle soup"
#: data/json/items/comestibles/soup.json
msgid ""
"Instant chicken noodle soup made from dehydrated noodles and chicken "
"reconstituted with water.  Not the most exciting meal but better than plain "
"water."
msgstr "乾燥させた麺と鶏肉を水でもどして作った、即席品のチキンヌードルです。豪華な食事とは言えませんが、ただの水で腹を満たすよりはマシです。"

#. ~ Item name
#: data/json/items/comestibles/soup.json
msgid "instant chicken noodle soup powder"
msgid_plural "instant chicken noodle soup powders"
msgstr[0] "即席チキンヌードル(未調理)"

#. ~ Description of "instant chicken noodle soup powder"
#: data/json/items/comestibles/soup.json
msgid ""
"Instant chicken noodle soup powder made from dehydrated noodles and chicken."
"  Mix with water to create a mildly improved meal."
msgstr "脱水した麺と鶏肉が入っている、即席品のチキンヌードルです。水分を加えれば、多少は食べやすくなります。"

#. ~ Item name
#: data/json/items/comestibles/soup.json
msgid "instant spring vegetable soup"
msgid_plural "instant spring vegetable soups"
msgstr[0] "即席春野菜ヌードル(調理済)"

#. ~ Description of "instant spring vegetable soup"
#: data/json/items/comestibles/soup.json
msgid ""
"Instant spring vegetable soup made from dehydrated noodles and vegetables "
"reconstituted with water.  Not the most exciting meal but better than plain "
"water."
msgstr "乾燥させた麺と野菜を水でもどして作った、即席品の春野菜ヌードルです。豪華な食事とは言えませんが、ただの水で腹を満たすよりはマシです。"

#. ~ Item name
#: data/json/items/comestibles/soup.json
msgid "instant spring vegetable soup powder"
msgid_plural "instant spring vegetable soup powders"
msgstr[0] "即席春野菜ヌードル(未調理)"

#. ~ Description of "instant spring vegetable soup powder"
#: data/json/items/comestibles/soup.json
msgid ""
"Instant spring vegetable soup powder made from dehydrated noodles and "
"vegetables.  Mix with water to create a mildly improved meal."
msgstr "脱水した麺と野菜が入っている、即席品の春野菜ヌードルです。水分を加えれば、多少は食べやすくなります。"

#. ~ Item name
#: data/json/items/comestibles/spice.json
msgid "chili powder"
msgid_plural "chili powder"
msgstr[0] "チリパウダー"

#. ~ Description of "chili powder"
#: data/json/items/comestibles/spice.json
msgid ""
"Chili P, yo!  Not edible on its own, but it could be used to make seasoning."
msgstr "チリパウダー、ヨー！そのままでは食べられませんが、調味料として使えそうです。"

#. ~ Item name
#: data/json/items/comestibles/spice.json
msgid "garlic powder"
msgid_plural "garlic powder"
msgstr[0] "ガーリックパウダー"

#. ~ Description of "garlic powder"
#: data/json/items/comestibles/spice.json
msgid ""
"Garlic that has been dehydrated and ground into a powder.  A must-have "
"seasoning in any pantry."
msgstr "脱水したニンニクを粉末にした調味料です。キッチンに一つは常備したいですね。"

#. ~ hot sauces are very salty, hence the negative quench
#. ~ Item name
#: data/json/items/comestibles/spice.json
msgid "hot sauce"
msgid_plural "hot sauce"
msgstr[0] "ホットソース"

#. ~ hot sauces are very salty, hence the negative quench
#. ~ Description of "hot sauce"
#: data/json/items/comestibles/spice.json
msgid ""
"Flamin' hot sauce.  It'd be a bad idea to drink it on its own.  You should "
"probably wash your hands after handling it, too."
msgstr "激辛ホットソースです。そのまま飲むのは止めておきましょう。使った後は手を洗いましょう。"

#. ~ Item name
#: data/json/items/comestibles/spice.json
msgid "cinnamon"
msgid_plural "cinnamon"
msgstr[0] "シナモン"

#. ~ Description of "cinnamon"
#: data/json/items/comestibles/spice.json
msgid "Ground cinnamon bark with a sweet but slightly spicy aroma."
msgstr "挽いた桂皮に甘くてちょっとだけスパイシーな香りを添えて。"

#. ~ Item name
#: data/json/items/comestibles/spice.json
msgid "curry powder"
msgid_plural "curry powder"
msgstr[0] "カレー粉"

#. ~ Description of "curry powder"
#: data/json/items/comestibles/spice.json
msgid ""
"A blend of spices meant to be used in some South Asian dishes.  Can't be "
"eaten raw, why would you even try that?"
msgstr "南アジアの伝統料理に使われるブレンド香辛料です。このままでは食べられません。食べられると思ったんですか？"

#. ~ Item name
#: data/json/items/comestibles/spice.json
msgid "black pepper"
msgid_plural "black pepper"
msgstr[0] "黒胡椒"

#. ~ Description of "black pepper"
#: data/json/items/comestibles/spice.json
msgid "Ground black spice berries with a pungent aroma."
msgstr "黒い実を挽いて作る香辛料です。刺激的な香りがします。"

#. ~ Item name
#: data/json/items/comestibles/spice.json
msgid "salt"
msgid_plural "salt"
msgstr[0] "食塩"

#. ~ Description of "salt"
#: data/json/items/comestibles/spice.json
msgid ""
"Yuck!  You surely wouldn't want to eat this.  It's good for preserving meat "
"and cooking, though."
msgstr "塩です。このまま食べるものではありません。肉の保存性を上げたり、料理に使ったりするための調味料です。"

#. ~ Item name
#: data/json/items/comestibles/spice.json
msgid "Italian seasoning"
msgid_plural "Italian seasoning"
msgstr[0] "イタリアンスパイス"

#. ~ Description of "Italian seasoning"
#: data/json/items/comestibles/spice.json
msgid "A fragrant mix of dried oregano, basil, thyme and other spices."
msgstr "乾燥させたオレガノやバジル、タイム、その他の香辛料を混ぜた香り豊かなスパイスです。"

#. ~ Item name
#: data/json/items/comestibles/spice.json
msgid "seasoned salt"
msgid_plural "seasoned salt"
msgstr[0] "調味塩"

#. ~ Description of "seasoned salt"
#: data/json/items/comestibles/spice.json
msgid "Salt mixed with a fragrant blend of secret herbs and spices."
msgstr "香辛料と秘密のハーブをブレンドした香り豊かな塩です。"

#. ~ a tbsp is 4.2g of sugar, meaning the volume needed to be adjusted.
#. ~ Item name
#: data/json/items/comestibles/spice.json
#: data/mods/My_Sweet_Cataclysm/sweet_items.json
msgid "sugar"
msgid_plural "sugar"
msgstr[0] "砂糖"

#. ~ a tbsp is 4.2g of sugar, meaning the volume needed to be adjusted.
#. ~ Description of "sugar"
#: data/json/items/comestibles/spice.json
#: data/mods/My_Sweet_Cataclysm/sweet_items.json
msgid ""
"Sweet, sweet sugar.  Bad for your teeth and surprisingly not very tasty on "
"its own."
msgstr "とても甘い砂糖です。非常に歯に悪い上に、砂糖単体では驚くほど美味しくありません。"

#. ~ Item name
#: data/json/items/comestibles/spice.json
msgid "sprinkles"
msgid_plural "sprinkles"
msgstr[0] "スプリンクル"

#. ~ Description of "sprinkles"
#: data/json/items/comestibles/spice.json
msgid ""
"Known as nonpareils, sprinkles, jimmies, sugar strands or 'hundreds-and-"
"thousands', these colorful balls, rods or flakes of sugar and starch are "
"intended for use decorating soft surfaces of sweets.  Like sugar, they are "
"bad for your teeth and surprisingly not very tasty on their own."
msgstr ""
"ノンパレル "
"、スプリンクル、ジミー、シュガーストランド、「ハンドレッド&サウザンド」などの呼び名がある色鮮やかな丸い粒、縦長の粒、砂糖やデンプンの薄片です。菓子などの柔らかい食品の表面を飾り付けるために使われます。"

#. ~ Item name
#: data/json/items/comestibles/spice.json
msgid "wild herbs"
msgid_plural "wild herbs"
msgstr[0] "野草"

#. ~ Description of "wild herbs"
#: data/json/items/comestibles/spice.json
msgid ""
"A tasty collection of wild herbs including violet, sassafras, mint, clover, "
"purslane, and fireweed."
msgstr "スミレにサッサフラス、ミントにクローバー、スベリヒユにヤナギランといった食べられる野草を摘んだものです。"

#. ~ Item name
#: data/json/items/comestibles/spice.json
msgid "soy sauce"
msgid_plural "soy sauce"
msgstr[0] "醤油"

#. ~ Description of "soy sauce"
#: data/json/items/comestibles/spice.json
msgid "Salty fermented soybean sauce."
msgstr "大豆を発酵させて作る液体調味料です。"

#. ~ Description of "thyme"
#: data/json/items/comestibles/spice.json
msgid "A stalk of thyme.  Smells delicious."
msgstr "タイムの茎です。美味しそうな芳香を放っています。"

#. ~ Item name
#: data/json/items/comestibles/spice.json
msgid "mustard powder"
msgid_plural "mustard powder"
msgstr[0] "マスタードパウダー"

#. ~ Description of "mustard powder"
#: data/json/items/comestibles/spice.json
msgid "A fragrant yellow powder.  Not edible in this form."
msgstr "香りのよい黄色の粉末です。そのままでは食べられません。"

#. ~ Item name
#: data/json/items/comestibles/spice.json
msgid "artificial sweetener"
msgid_plural "artificial sweeteners"
msgstr[0] "人工甘味料"

#. ~ Description of "artificial sweetener"
#: data/json/items/comestibles/spice.json
msgid ""
"Sweet, sweet sugar?  No, it is bitter-sweet artificial sweetener.  No "
"calories, no worries."
msgstr "甘い甘い砂糖でしょうか？いいえ、ほろ苦い人工甘味料です。カロリーも、不安要素もありません。"

#. ~ Item name
#: data/json/items/comestibles/veggy_dishes.json
msgid "cooked cattail stalk"
msgid_plural "cooked cattail stalks"
msgstr[0] "ガマの茎(調理済)"

#. ~ Description of "cooked cattail stalk"
#: data/json/items/comestibles/veggy_dishes.json
msgid ""
"A cooked stalk from a cattail plant.  Its fibrous outer leaves have been "
"stripped away, and now it is quite delicious."
msgstr "加熱調理されたガマの茎です。繊維質の外皮が剥がれ落ち、美味しく食べられる状態になりました。"

#. ~ The flag below implies that part of root got burned and has to be removed
#. ~ Item name
#: data/json/items/comestibles/veggy_dishes.json
msgid "roasted cattail rhizome"
msgid_plural "roasted cattail rhizomes"
msgstr[0] "ガマの根茎(乾煎)"

#. ~ The flag below implies that part of root got burned and has to be removed
#. ~ Description of "roasted cattail rhizome"
#: data/json/items/comestibles/veggy_dishes.json
msgid ""
"A roasted root from a cattail plant.  Its fibrous outer core is charred "
"black, so you can remove it and chew on the dry inside."
msgstr "炙ったガマの根茎です。黒焦げになった繊維質の外皮を剥がし、乾燥した軸をかじって食べましょう。"

#. ~ Item name
#: data/json/items/comestibles/veggy_dishes.json
msgid "starch"
msgid_plural "starch"
msgstr[0] "デンプン"

#. ~ Description of "starch"
#: data/json/items/comestibles/veggy_dishes.json
msgid ""
"Sticky, gooey carbohydrate paste extracted from plants.  Spoils rather "
"quickly if not prepared for storage."
msgstr "植物から抽出した、べとつく炭水化物のペーストです。腐敗が速く保存には向きません。"

