msgstr "私は北欧の神々を崇拝している。"

#. ~ Name of an NPC class
#: data/json/npcs/valhalla_cult/npcs.json
msgid "Valhallist Shopkeeper"
msgstr "ヴァルハラ信奉者の商人"

#. ~ Snippet in category "<mycus_slur>"
