#. ~ Message of martial technique "Mirage Slash"
#: data/mods/CRT_EXPANSION/martial/CRT_Bladework.json
#, c-format
msgid ""
"You hold your blade taut, and then launch a piercing slash on %s's top half"
msgstr "刃を引き絞り、%sの上半身を貫く鮮烈な斬撃を繰り出しました"

#. ~ Message of martial technique "Mirage Slash"
#. ~ Message of martial technique "Calculated Pierce"
#: data/mods/CRT_EXPANSION/martial/CRT_Bladework.json
#: data/mods/CRT_EXPANSION/martial/CRT_MeleeBuffs.json
#, c-format
msgid "<npcname> lands a piercing blow on %s's face"
msgstr "<npcname>は%sの顔面に鋭い刺突を繰り出しました"

#. ~ Martial technique name
#: data/mods/CRT_EXPANSION/martial/CRT_Bladework.json
