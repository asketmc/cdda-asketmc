#. ~ Item name
#: data/json/items/containers.json
msgid "tiny wooden box"
msgid_plural "tiny wooden boxes"
msgstr[0] "木箱XS"

#. ~ Description of "tiny wooden box"
#: data/json/items/containers.json
msgid "A small wooden box with cap and small handles."
msgstr "蓋と小さな取っ手が付いた小箱です。"

#. ~ ~7x20x15 or ~4x22x22
#. ~ Item name
#: data/json/items/containers.json
msgid "small wooden box"
