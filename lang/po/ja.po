msgid_plural "HWP 60-round 9mm helical magazines"
msgstr[0] "弾倉(9mm/HWP/60発)"

#. ~ Description of magazine "HWP 60-round 9mm helical magazine"
#: data/json/items/gun/robofac_gun.json
