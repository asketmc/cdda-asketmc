msgstr "飴や果物を加えてより美味しくなったミルクセーキです。"

#. ~ Item name
#: data/json/items/comestibles/frozen.json
msgid "deluxe chocolate milkshake"
msgid_plural "deluxe chocolate milkshakes"
msgstr[0] "DXチョコミルクセーキ"

#. ~ Description of "deluxe chocolate milkshake"
#: data/json/items/comestibles/frozen.json
