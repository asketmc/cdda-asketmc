msgstr "アトミックコンパクトカー"

#. ~ Vehicle name
#: data/mods/Aftershock/vehicles/vehicles.json
msgid "Atomic SUV"
msgstr "アトミックSUV"

#. ~ Vehicle name
#: data/mods/Aftershock/vehicles/vehicles.json
msgid "Atomic Car"
msgstr "アトミックカー"

#. ~ Vehicle name
#: data/mods/Aftershock/vehicles/vehicles.json
