#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#: data/json/npcs/other/TALK_NPC_PREPPER_SURVIVOR.json
#: data/json/npcs/refugee_center/surface_staff/NPC_free_merchant_shopkeep.json
#: data/json/npcs/robofac/NPC_Cranberry_Foster.json
#: data/json/npcs/robofac/robofac_intercom/robofac_intercom_prototypes.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_foreman.json
#: data/json/npcs/valhalla_cult/TALK_valhallist_gode.json
#: data/json/npcs/valhalla_cult/TALK_valhallist_mechanic.json
#: data/json/npcs/valhalla_cult/TALK_valhallist_member.json
#: data/json/obsoletion/npcs/necropolis/NPC_Old_Guard_Commo.json
msgid "Thanks."
msgstr "ありがとう。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Right… I don't want any trouble."
msgstr "分かった...トラブルはごめんだ。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Smart choice."
msgstr "賢い選択だ。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "<no>, and if you ask again, <ill_kill_you>!"
msgstr "<no>、もう一度同じことを聞いてみろ、<ill_kill_you>!"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "<no><punc> <fuck_you>!"
msgstr "<no><punc> <fuck_you>!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, okay, sorry."
msgstr "分かった、分かった、すまなかったよ。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Seriously, give me more stuff!"
msgstr "冗談じゃない、何かくれよ！"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, fine, bye."
msgstr "分かった、いいよ、じゃあな。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid ""
"I'm willing to pay <topic_item_price> per batch for a total of "
"<topic_item_your_total_price>."
msgstr "1セットあたり<topic_item_price>だから、合計で<topic_item_your_total_price>支払おう。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Works for me."
msgstr "問題ない。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/other/NPC_pizzaiolo.json
#: data/json/npcs/other/meteorologist.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_crop_overseer.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_woodcutter1.json
msgid "Maybe later."
msgstr "また今度。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Pleasure doing business!"
msgstr "これからもよろしく頼むよ！"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "You might be seeing more of me…"
msgstr "これからもよろしく..."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_FRIEND_CONVERSATION.json
msgid ""
"Are you sure?  This doesn't seem like a particularly safe place for small "
"talk…"
msgstr "本気か？ここが下らない話ができるほど安全な場所だとは思えないな..."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_FRIEND_CONVERSATION.json
msgid "It's fine, we've got a moment."
msgstr "問題ない、ちょっと話そう。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_FRIEND_CONVERSATION.json
msgid "Good point, let's find a more appropriate place."
msgstr "そうだな、もう少し話しやすい場所に移ろう。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_FRIEND_CONVERSATION.json
msgid "You're right.  Forget I said anything, let's get moving."
msgstr "確かにそうだ。さっき言ったことは忘れてくれ。さあ行こう。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_FRIEND_CONVERSATION.json
msgid "What did you want to talk about?"
msgstr "何について話そうか？"

