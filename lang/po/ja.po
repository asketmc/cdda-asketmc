msgstr "「私達は貴方に危害は加えない事を約束します」"

#: src/monattack.cpp:4870
msgid "\"Do not fear\""
msgstr "「怖がらなくても大丈夫です」"

#: src/monattack.cpp:4873
msgid "\"We can help you\""
msgstr "「私達は貴方の助けになります」"

#: src/monattack.cpp:4876
msgid "\"We are friendly\""
msgstr "「私達は友好的です」"

#: src/monattack.cpp:4879
