#. ~ ~7x20x15 or ~4x22x22
#. ~ Description of "small metal box"
#: data/json/items/containers.json
msgid "A small metal box.  It could hold even the densest of items."
msgstr "重いものも入れられる金属製の小箱です。"

#. ~ (25x40x50)
#. ~ Item name
#: data/json/items/containers.json
msgid "metal box"
msgid_plural "metal boxes"
msgstr[0] "金属箱M"

#. ~ (25x40x50)
#. ~ Description of "metal box"
#: data/json/items/containers.json
msgid "A strong metal box.  Great for packing your heaviest items."
msgstr "重いものを入れるのにうってつけの、丈夫な金属製の箱です。"

#. ~ (60x60x90)
#. ~ Item name
#: data/json/items/containers.json
