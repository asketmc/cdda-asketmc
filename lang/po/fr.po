msgstr[2] "éthanol"

#. ~ Description of "ethanol"
#: data/json/items/fuel.json
msgid ""
"Extremely pure alcohol suitable for use as a component in chemical "
"reactions.  You could also water it down and drink it, or use it as fuel in "
"alcohol-burning stoves."
msgstr ""
"Alcool extrêmement pur utilisable comme composant chimique. Vous pourriez "
"aussi vous le verser et le boire ou alors l'utiliser comme carburant dans "
"des poêles fonctionnant à l'alcool."

#. ~ Item name
#: data/json/items/fuel.json
msgid "methylated spirits"
msgid_plural "methylated spirits"
msgstr[0] "alcool à bruler"
msgstr[1] "alcool à bruler"
msgstr[2] "alcool à bruler"

#. ~ Description of "methylated spirits"
#: data/json/items/fuel.json
msgid ""
"A high-strength ethanol solution mixed with methanol to make it toxic to "
"drink, so as to avoid pre-apocalyptic regulations on ethanol.  Intended for "
"use in alcohol-burning stoves and as a solvent."
msgstr ""
"Une solution d'éthanol hautement concentrée mélangée à du méthanol pour la "
"rendre toxique, afin d'éviter les réglementations pré-apocalyptiques sur "
"l'éthanol.  Destiné à être utilisé dans les poêles à alcool ou comme "
"dissolvant."

#. ~ Item name
#: data/json/items/fuel.json
