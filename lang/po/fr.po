msgid_plural "Labrador puppies"
msgstr[0] "labrador (chiot)"
msgstr[1] "labradors (chiots)"
msgstr[2] "labradors (chiots)"

#. ~ Description of monster "Labrador puppy"
#: data/json/monsters/mammal.json
msgid ""
"An adorable, defenseless Labrador puppy.  Much safer to tame than an adult "
"dog."
msgstr ""

#. ~ Monster name
#: data/json/monsters/mammal.json
