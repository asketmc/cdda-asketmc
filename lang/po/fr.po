msgctxt "memorial_male"
msgid "Stopped worrying and learned to love the cowbell."
msgstr "A cessé de s'inquiéter et appris à aimer la clochette."

#. ~ Memorial message of mutation class "Cattle" for female
#: data/json/mutations/mutation_category.json
msgctxt "memorial_female"
msgid "Stopped worrying and learned to love the cowbell."
msgstr "A cessée de s'inquiéter et appris à aimer la clochette."

#. ~ Mutation class name
#. ~ Mutation name
#: data/json/mutations/mutation_category.json
#: data/json/mutations/mutations.json
msgid "Cephalopod"
msgstr "Céphalopode"

#. ~ "mutagen_message" of mutation class "Cephalopod"
#: data/json/mutations/mutation_category.json
msgid ""
"Your mind is overcome by images of eldritch horrors… and then they pass."
msgstr ""
"Votre esprit est débordé d'images d'horreurs antiques, celles-ci "
"s'évanouissant presque immédiatement après."

#. ~ Memorial message of mutation class "Cephalopod" for male
#: data/json/mutations/mutation_category.json
msgctxt "memorial_male"
msgid "Began living the dreams."
msgstr "A commencé à vivre les rêves."

#. ~ Memorial message of mutation class "Cephalopod" for female
#: data/json/mutations/mutation_category.json
msgctxt "memorial_female"
msgid "Began living the dreams."
msgstr "A commencée à vivre les rêves."

#. ~ Mutation class name
#. ~ Mutation name
#: data/json/mutations/mutation_category.json
#: data/json/mutations/mutations.json
msgid "Bird"
msgstr "Oiseau"

#. ~ "mutagen_message" of mutation class "Bird"
#: data/json/mutations/mutation_category.json
msgid "Your body lightens and you long for the sky."
msgstr "Votre corps s'allège et vous désirez ardemment être dans le ciel."

#. ~ Memorial message of mutation class "Bird" for male
#: data/json/mutations/mutation_category.json
msgctxt "memorial_male"
msgid "Broke free of humanity."
msgstr "S'est libéré de son humanité."

#. ~ Memorial message of mutation class "Bird" for female
#: data/json/mutations/mutation_category.json
msgctxt "memorial_female"
msgid "Broke free of humanity."
msgstr "S'est libérée de son humanité."

#. ~ Mutation class name
#. ~ Mutation name
#: data/json/mutations/mutation_category.json
#: data/json/mutations/mutations.json
msgid "Lizard"
msgstr "Lézard"

#. ~ "mutagen_message" of mutation class "Lizard"
#: data/json/mutations/mutation_category.json
msgid "For a heartbeat, your blood cools down."
msgstr "Pendant un battement de cœur, vous sentez votre sang devenir froid."

#. ~ Memorial message of mutation class "Lizard" for male
#: data/json/mutations/mutation_category.json
msgctxt "memorial_male"
msgid "Shed the ugly human skin."
msgstr "S'est débarrassé de sa peau humaine repoussante."

#. ~ Memorial message of mutation class "Lizard" for female
#: data/json/mutations/mutation_category.json
msgctxt "memorial_female"
msgid "Shed the ugly human skin."
msgstr "S'est débarrassée de sa peau humaine repoussante."

#. ~ Mutation class name
#. ~ Mutation name
#: data/json/mutations/mutation_category.json
#: data/json/mutations/mutations.json
msgid "Batrachian"
msgstr "Batracien"

#. ~ "mutagen_message" of mutation class "Batrachian"
#: data/json/mutations/mutation_category.json
msgid "Like a tadpole you must transform."
msgstr "Vous êtes un têtard sur le point d'évoluer."

#. ~ Memorial message of mutation class "Batrachian" for male
#: data/json/mutations/mutation_category.json
msgctxt "memorial_male"
msgid "Found a bigger pond."
msgstr "A trouvé une plus grande mare."

#. ~ Memorial message of mutation class "Batrachian" for female
#: data/json/mutations/mutation_category.json
msgctxt "memorial_female"
msgid "Found a bigger pond."
msgstr "A trouvée une plus grande mare."

#. ~ Mutation class name
#. ~ Mutation name
#: data/json/mutations/mutation_category.json
#: data/json/mutations/mutations.json
msgid "Troglobite"
msgstr "Troglobite"

#. ~ "mutagen_message" of mutation class "Troglobite"
#: data/json/mutations/mutation_category.json
msgid "You yearn for a cool, dark place to hide."
msgstr "Vous rêvez d'un endroit frais et sombre où vous cacher."

#. ~ Memorial message of mutation class "Troglobite" for male
#: data/json/mutations/mutation_category.json
msgctxt "memorial_male"
msgid "Adapted to underground living."
msgstr "S'est adapté à la vie souterraine."

#. ~ Memorial message of mutation class "Troglobite" for female
#: data/json/mutations/mutation_category.json
msgctxt "memorial_female"
msgid "Adapted to underground living."
msgstr "S'est adaptée à la vie souterraine."

#. ~ Mutation class name
#: data/json/mutations/mutation_category.json
msgid "Alpha"
msgstr "Alpha"

#. ~ "mutagen_message" of mutation class "Alpha"
#: data/json/mutations/mutation_category.json
msgid "You feel… better.  Somehow."
msgstr "Vous vous sentez… suprême."

#. ~ Memorial message of mutation class "Alpha" for male
#: data/json/mutations/mutation_category.json
msgctxt "memorial_male"
msgid "Started representing."
msgstr ""

#. ~ Memorial message of mutation class "Alpha" for female
#: data/json/mutations/mutation_category.json
msgctxt "memorial_female"
msgid "Started representing."
msgstr ""

#. ~ Mutation class name
#: data/json/mutations/mutation_category.json
