#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "firearm repair kit"
msgid_plural "firearm repair kits"
msgstr[0] "kit de réparation d'arme à feu"
msgstr[1] "kits de réparation d'arme à feu"
msgstr[2] "kits de réparation d'arme à feu"

#. ~ Description of "firearm repair kit"
#: data/json/items/tool/workshop.json
