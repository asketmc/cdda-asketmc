msgstr ""

#. ~ Snippet in category "PORTAL_DEPENDENT_MESSAGES_VARIED_GOOD"
#: data/json/snippets/effect_on_conditions.json
msgid "Your hand seems to become full of vitality for a brief moment."
msgstr ""

#. ~ Snippet in category "PORTAL_DEPENDENT_MESSAGES_VARIED_GOOD"
#: data/json/snippets/effect_on_conditions.json
msgid ""
"For a split second, one of your fingers seems to glow in phosphorescent "
