msgstr[1] "tournevis"
msgstr[2] "tournevis"

#. ~ Description of "screwdriver"
#: data/json/items/tool/workshop.json
msgid ""
"This is a Philips-head screwdriver.  It is important for almost all "
"electronics crafting, most mechanics crafting, and has many more uses."
msgstr ""
"C'est un tournevis cruciforme. Il est important pour presque toute les "
"fabrications en électronique et la plupart des fabrications mécaniques, et "
"possède de nombreux autres usages."

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "screwdriver set"
msgid_plural "screwdriver sets"
msgstr[0] "ensemble de tournevis"
msgstr[1] "ensembles de tournevis"
msgstr[2] "ensembles de tournevis"

