#. ~ Profession name for male
#: data/json/professions.json
#: data/mods/Dark-Skies-Above/overrides/professions.json
msgctxt "profession_male"
msgid "Non Commissioned Officer"
msgstr ""

#. ~ Description of profession "Non Commissioned Officer" for male
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You're a veteran of several peacekeeping missions.  You led your squad as a "
"sort of parental figure, and they relied on you to give orders and keep them"
" alive.  You failed them.  And now you're alone."
msgstr ""

