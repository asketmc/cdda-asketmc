#. ~ Description of monster "rabbit"
#: data/json/monsters/mammal.json data/json/monsters/nether.json
msgid ""
"A small mammal with a cute wiggling nose, a cotton ball tail, and a body "
"made of delicious flesh."
msgstr ""

#. ~ Monster name
#: data/json/monsters/mammal.json data/mods/Tamable_Wildlife/mammal.json
msgid "raccoon"
