#. ~ Dialogue line in mission "Find Antibiotics"
#: data/json/npcs/missiondef.json
msgid "I'm infected.  Badly.  I need you to get some good antibiotics for me…"
msgstr ""

#. ~ Dialogue line in mission "Find Antibiotics"
