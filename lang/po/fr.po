#. ~ "msg" action message of item "laptop computer"
#. ~ "msg" action message of item "control laptop"
#: data/json/items/tool/electronics.json data/mods/Aftershock/items/tools.json
msgid "You light up the screen."
msgstr "Vous allumez l'écran."

#. ~ "need_charges_msg" action message of item "cellphone"
#: data/json/items/tool/electronics.json
msgid "The cellphone's batteries need more charge."
msgstr "La batterie du téléphone a besoin de plus de charge."

