#. ~ Item name
#: data/json/items/tool/smoking.json
msgid "advanced electronic cigarette"
msgid_plural "advanced electronic cigarettes"
msgstr[0] "cigarette électronique perfectionnée"
msgstr[1] "cigarettes électroniques perfectionnées"
msgstr[2] "cigarettes électroniques perfectionnées"

#. ~ Description of "advanced electronic cigarette"
#: data/json/items/tool/smoking.json
msgid ""
"An advanced version of the electronic cigarette.  A less harmful way to get "
"your nicotine fix than regular cigarettes, but still addictive.  It needs "
"batteries and nicotine liquid to function."
msgstr ""
"Une version évoluée de la cigarette électronique. Un moyen moins aggressif "
"de prendre votre dose de nicotine, mais ça reste addictif. Il lui faut des "
"piles et du liquide à la nicotine pour fonctionner."

#. ~ Item name
#: data/json/items/tool/smoking.json
msgid "crack pipe"
msgid_plural "crack pipes"
msgstr[0] "pipe à crack"
msgstr[1] "pipes à crack"
msgstr[2] "pipes à crack"

#. ~ Description of "crack pipe"
#: data/json/items/tool/smoking.json
msgid ""
"This is a fine glass tube with a bulb with a bowl on one end.  It's used to "
"partake of certain illicit substances."
msgstr ""
"Un petit tube en verre avec une ampoule à son extrémité. C'est utile pour "
"fumer de la drogue."

#. ~ Item name
#: data/json/items/tool/smoking.json
msgid "glass pipe"
msgid_plural "glass pipes"
msgstr[0] "pipe en verre"
msgstr[1] "pipes en verre"
msgstr[2] "pipes en verre"

#. ~ Description of "glass pipe"
#: data/json/items/tool/smoking.json
msgid ""
"This is a hand-blown glass pipe.  It's of the type most commonly used to "
"smoke recreational substances."
msgstr "Un petit tube en verre soufflé. C'est utile pour fumer de la drogue."

#. ~ Item name
#: data/json/items/tool/smoking.json
msgid "tobacco pipe"
msgid_plural "tobacco pipes"
msgstr[0] "pipe"
msgstr[1] "pipes"
msgstr[2] "pipes"

#. ~ Description of "tobacco pipe"
#: data/json/items/tool/smoking.json
msgid ""
"This is a hand-carved wooden smoking pipe.  It's designed to facilitate "
"consumption of fire cured tobacco leaves."
msgstr ""
"Une pipe taillée dans le bois. Utile pour fumer des feuilles de tabac."

#. ~ Item name
#: data/json/items/tool/stationary.json
msgid "stapler"
msgid_plural "staplers"
msgstr[0] "agrafeuse"
msgstr[1] "agrafeuses"
msgstr[2] "agrafeuses"

#. ~ Description of "stapler"
#: data/json/items/tool/stationary.json
msgid "A stapler for fastening sheets of paper together."
msgstr ""

#. ~ Item name
#: data/json/items/tool/stationary.json
msgid "hole puncher"
msgid_plural "hole punchers"
msgstr[0] "perforatrice"
msgstr[1] "perforatrices"
msgstr[2] "perforatrices"

#. ~ Description of "hole puncher"
#: data/json/items/tool/stationary.json
msgid ""
"This metal tool can help you punch a single hole in a piece of paper.  I "
"mean, you could do more if you wanted, but you'd have to do them one at a "
"time.  Or, if you really wanted more holes with one punch, I suppose you "
"could fold the paper….  This is a one cylinder hole puncher."
msgstr ""

#. ~ Item name
#: data/json/items/tool/stationary.json
msgid "letter opener"
msgid_plural "letter openers"
msgstr[0] "ouvre-lettre"
msgstr[1] "ouvre-lettres"
msgstr[2] "ouvre-lettres"

#. ~ Description of "letter opener"
#: data/json/items/tool/stationary.json
msgid ""
"This sterling silver letter opener resembling a small dagger has a sharp "
"point and no cutting edge.  It was used to open mail envelopes neatly and "
"quickly."
msgstr ""

#. ~ Item name
#: data/json/items/tool/stationary.json
msgid "pair of scissors"
msgid_plural "pairs of scissors"
msgstr[0] "paire de ciseaux"
msgstr[1] "paires de ciseaux"
msgstr[2] "paires de ciseaux"

#. ~ Description of "pair of scissors"
#: data/json/items/tool/stationary.json
msgid ""
"These are a long pair of heavy-duty scissors.  Use scissors to cut items "
"made from cotton (like clothing) into rags."
msgstr ""

#. ~ Item name
#: data/json/items/tool/stationary.json
msgid "pen"
msgid_plural "pens"
msgstr[0] "stylo"
msgstr[1] "stylos"
msgstr[2] "stylos"

#. ~ Description of "pen"
#: data/json/items/tool/stationary.json
msgid "This is a fine pen, of much better quality than a disposable model."
msgstr "C'est un bon stylo, de bien meilleur qualité qu'un modèle jetable."

#. ~ Description of "pencil"
#: data/json/items/tool/stationary.json
msgid "Sharpened HB #2 graphite pencil, equipped with an eraser."
msgstr "Un crayon graphite HB #2, accompagné de sa gomme"

#. ~ Item name
