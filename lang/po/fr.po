msgid_plural "PAP M77s"
msgstr[0] "PAP M77"
msgstr[1] "PAP M77s"
msgstr[2] "PAP M77s"

#. ~ Description of variant "7.62x51mm AK" of gun "PAP M77"
#: data/json/items/gun/308.json
