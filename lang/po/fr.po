msgstr[2] "rois des rats"

#. ~ Description of monster "rat king"
#: data/json/monsters/mammal.json
msgid ""
"A towering swarm of mutated rats, their tails knotted together in a filthy "
"mass.  A fetid stench flows from its filthy presence."
msgstr ""

#. ~ Death message of monster "rat king"
#: data/json/monsters/mammal.json
msgid "Rats suddenly swarm into view."
msgstr ""

#. ~ Monster name
#: data/json/monsters/mammal.json data/mods/Tamable_Wildlife/mammal.json
