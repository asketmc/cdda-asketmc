msgid "tent"
msgid_plural "tents"
msgstr[0] "tente"
msgstr[1] "tentes"
msgstr[2] "tentes"

#. ~ Description of "tent"
#: data/json/items/tool/shelters.json
msgid ""
"This is a small personal tent, it's just big enough to fit you comfortably."
msgstr ""
"Une petite tente personnelle, juste assez grande pour que vous soyez à "
"l'aise."

#. ~ Item name
#: data/json/items/tool/shelters.json
msgid "aluminum tent pole"
msgid_plural "aluminum tent poles"
msgstr[0] "piquet de tente en aluminium"
msgstr[1] "piquets de tente en aluminium"
msgstr[2] "piquets de tente en aluminium"

#. ~ Description of "aluminum tent pole"
#: data/json/items/tool/shelters.json
