#: src/options.cpp:2274
msgid "Overall brightness of pixel-detail minimap."
msgstr ""

#: src/options.cpp:2280
msgid "Pixel minimap height"
msgstr "Hauteur de la minicarte"

#: src/options.cpp:2281
msgid ""
"Height of pixel-detail minimap, measured in terminal rows.  Set to 0 for "
"default spacing."
msgstr ""
"Hauteur de la minicarte en lignes de terminal. '0' pour la taille par "
"défaut."

#: src/options.cpp:2287
msgid "Scale pixel minimap"
msgstr ""

#: src/options.cpp:2288
msgid ""
"If true, scale pixel minimap to fit its surroundings.  May produce crappy "
"results, especially in modes other than \"Solid\"."
msgstr ""

#: src/options.cpp:2294
msgid "Maintain pixel minimap aspect ratio"
msgstr "Garder la minicarte proportionnelle"

#: src/options.cpp:2295
msgid ""
"If true, preserves the square shape of tiles shown on the pixel minimap."
msgstr ""

#: src/options.cpp:2302
msgid "Creature beacon size"
msgstr ""

#: src/options.cpp:2303
msgid "Controls how big the creature beacons are.  Value is in minimap tiles."
msgstr ""

#: src/options.cpp:2309
msgid "Hostile creature beacon blink speed"
msgstr ""

#: src/options.cpp:2310
msgid ""
"Controls how fast the hostile creature beacons blink on the pixel minimap.  "
"Value is multiplied by 200ms.  0 = disabled."
msgstr ""

#: src/options.cpp:2316
msgid "Background color"
msgstr ""

#: src/options.cpp:2317
msgid ""
"What color the minimap background should be.  Either based on color theme or"
" (0,0,0) black."
msgstr ""

#: src/options.cpp:2319
msgid "Theme"
msgstr ""

#: src/options.cpp:2320
msgid "Black"
msgstr ""

#: src/options.cpp:2330
msgid "Display"
msgstr "Écran"

#: src/options.cpp:2331
msgid ""
"Sets which video display will be used to show the game.  Requires restart."
msgstr ""
"Permet de choisir l'écran sur lequel afficher le jeu. Requiert un "
"redémarrage."

#: src/options.cpp:2337 src/options.cpp:2339
msgid "Fullscreen"
msgstr "Plein écran"

#: src/options.cpp:2338
msgid "Starts Cataclysm in one of the fullscreen modes.  Requires restart."
msgstr ""
"Démarre Cataclysm dans l'un des modes plein écran. Requiert un redémarrage."

#: src/options.cpp:2339
msgid "Maximized"
msgstr ""

#: src/options.cpp:2339
msgid "Windowed borderless"
msgstr "Plein écran fenêtré"

#: src/options.cpp:2352 src/options.cpp:2366
msgid "Renderer"
msgstr ""

#: src/options.cpp:2353 src/options.cpp:2367
msgid "Set which renderer to use.  Requires restart."
msgstr ""

#: src/options.cpp:2372
msgid "Software rendering"
msgstr "Rendu logiciel"

#: src/options.cpp:2373
msgid ""
"Use software renderer instead of graphics card acceleration.  Requires "
"restart."
msgstr ""

#: src/options.cpp:2381
msgid "Allow render batching"
msgstr ""

#: src/options.cpp:2382
msgid ""
"If true, use render batching for 2D render API to make it more efficient.  "
"Requires restart."
msgstr ""

#: src/options.cpp:2386
msgid "Software framebuffer acceleration"
msgstr ""

#: src/options.cpp:2387
msgid ""
"If true, use hardware acceleration for the framebuffer when using software "
"rendering.  Requires restart."
msgstr ""

#: src/options.cpp:2397
msgid "Use color modulated textures"
msgstr ""

#: src/options.cpp:2398
msgid ""
"If true, tries to use color modulated textures to speed-up ASCII drawing.  "
"Requires restart."
msgstr ""

#: src/options.cpp:2402
msgid "Scaling mode"
msgstr "Mise à l'échelle"

#: src/options.cpp:2403
msgid ""
"Sets the scaling mode, 'none' (default) displays at the game's native "
"resolution, 'nearest' uses low-quality but fast scaling, and 'linear' "
"provides high-quality scaling."
msgstr ""

#. ~ Do not scale the game image to the window size.
#: src/options.cpp:2405
msgid "No scaling"
msgstr "Aucune"

#. ~ An algorithm for image scaling.
#: src/options.cpp:2407
msgid "Nearest neighbor"
msgstr "Au plus proche"

#. ~ An algorithm for image scaling.
#: src/options.cpp:2409
msgid "Linear filtering"
msgstr "Linéaire"

#: src/options.cpp:2414
msgid "Scaling factor"
msgstr ""

#: src/options.cpp:2415
msgid "Factor by which to scale the display.  Requires restart."
msgstr ""

#: src/options.cpp:2416
msgid "1x"
msgstr ""

#: src/options.cpp:2417
msgid "2x"
msgstr ""

#: src/options.cpp:2418
msgid "4x"
msgstr ""

#: src/options.cpp:2431
msgid "World end handling"
msgstr ""

#: src/options.cpp:2432
msgid "Handling of game world when last character dies."
msgstr ""

#: src/options.cpp:2434
msgid "Keep"
msgstr ""

#: src/options.cpp:2434
msgid "Query"
msgstr "Demander"

#: src/options.cpp:2440
msgid "Size of cities"
msgstr "Dimension des villes"

#: src/options.cpp:2441
msgid ""
"A number determining how large cities are.  A higher number means larger "
"cities.  0 disables cities, roads and any scenario requiring a city start."
msgstr ""

#: src/options.cpp:2445
msgid "City spacing"
msgstr "Espacement des villes"

#: src/options.cpp:2446
msgid ""
"A number determining how far apart cities are.  A higher number means cities"
" are further apart.  Warning, small numbers lead to very slow mapgen."
msgstr ""

#: src/options.cpp:2450
msgid "Spawn rate scaling factor"
msgstr "Taux d'apparition des monstres"

#: src/options.cpp:2451
msgid ""
"A scaling factor that determines density of monster spawns.  A higher number"
" means more monsters."
msgstr ""

#: src/options.cpp:2455
msgid "Item spawn scaling factor"
msgstr "Taux d'apparition des objets"

#: src/options.cpp:2456
msgid ""
"A scaling factor that determines density of item spawns.  A higher number "
"means more items."
msgstr ""

#: src/options.cpp:2460
msgid "Random NPC spawn time"
msgstr ""

#: src/options.cpp:2461
msgid ""
"Baseline average number of days between random NPC spawns.  Average duration"
" goes up with the number of NPCs already spawned.  A higher number means "
"fewer NPCs.  Set to 0 days to disable random NPCs."
msgstr ""

#: src/options.cpp:2466
msgid "Monster evolution scaling factor"
msgstr "Vitesse d'évolution des monstres"

#: src/options.cpp:2467
msgid ""
"A scaling factor that determines the time between monster upgrades.  A "
"higher number means slower evolution.  Set to 0.00 to turn off monster "
"upgrades."
msgstr ""
"Détermine la durée entre chaque évolution des monstres. Plus la valeur est "
"grande plus l'évolution est lente. '0.00' désactive l'évolution."

#: src/options.cpp:2473
msgid "Monster speed"
msgstr "Vitesse des monstres"

#: src/options.cpp:2474
msgid ""
"Determines the movement rate of monsters.  A higher value increases monster "
"speed and a lower reduces it.  Requires world reset."
msgstr ""

#: src/options.cpp:2478
msgid "Monster resilience"
msgstr "Résistance des monstres"

#: src/options.cpp:2479
msgid ""
"Determines how much damage monsters can take.  A higher value makes monsters"
" more resilient and a lower makes them more flimsy.  Requires world reset."
msgstr ""

#: src/options.cpp:2485
msgid "Default region type"
msgstr "Type de région par défaut"

#: src/options.cpp:2486
msgid "(WIP feature) Determines terrain, shops, plants, and more."
msgstr ""
"(fonction en travaux) Détermine le terrain, les magasins, les plantes et "
"autres sur un monde."

#: src/options.cpp:2492
msgid "Initial time"
msgstr "Heure initiale"

#: src/options.cpp:2493
msgid "Initial starting time of day on character generation."
msgstr "L'heure au début de chaque partie."

#: src/options.cpp:2497
msgid "Initial day"
msgstr ""

#: src/options.cpp:2498
msgid ""
"How many days into the year the Cataclysm ended.  Day 0 is Spring 1.  Day -1"
" randomizes the start date.  Can be overridden by scenarios.  This does not "
"advance food rot or monster evolution."
msgstr ""

#: src/options.cpp:2502
msgid "Spawn delay"
msgstr ""

#: src/options.cpp:2503
msgid ""
"How many days after the end of the Cataclysm the player spawns.  Day 0 is "
"immediately after the end of the Cataclysm.  Can be overridden by scenarios."
"  Increasing this will cause food rot and monster evolution to advance."
msgstr ""

#: src/options.cpp:2507
msgid "Season length"
msgstr "Durée des saisons"

#: src/options.cpp:2508
msgid ""
"Season length, in days.  Warning: Very little other than the duration of "
"seasons scales with this value, so adjusting it may cause nonsensical "
"results."
msgstr ""

#: src/options.cpp:2512
msgid "Construction scaling"
msgstr "Vitesse de construction"

#: src/options.cpp:2513
msgid ""
"Sets the time of construction in percents.  '50' is two times faster than "
"default, '200' is two times longer.  '0' automatically scales construction "
"time to match the world's season length."
msgstr ""
"Définit le temps de construction en pourcents. '50' est deux fois plus "
"rapide que la valeur par défaut, '200' est deux fois plus long. '0' définit "
"automatiquement le temps de construction pour correspondre à la longueur "
"d'une saison."

#: src/options.cpp:2517
msgid "Eternal season"
msgstr "Saison éternelle"

#: src/options.cpp:2518
msgid "If true, keep the initial season for ever."
msgstr ""

#: src/options.cpp:2522
msgid "Day/night cycle"
msgstr ""

#: src/options.cpp:2523
msgid ""
"Day/night cycle settings.  'Normal' sets a normal cycle.  'Eternal Day' sets"
" eternal day.  'Eternal Night' sets eternal night."
msgstr ""

#: src/options.cpp:2525
msgid "Eternal Day"
msgstr ""

#: src/options.cpp:2526
msgid "Eternal Night"
msgstr ""

#: src/options.cpp:2532
msgid "Wandering hordes"
msgstr ""

#: src/options.cpp:2533
msgid ""
"If true, emulates zombie hordes.  Zombies can group together into hordes, "
"which can wander around cities and will sometimes move towards noise.  Note:"
" the current implementation does not properly respect obstacles, so hordes "
"can appear to walk through walls under some circumstances.  Must reset world"
" directory after changing for it to take effect."
msgstr ""

#: src/options.cpp:2537
msgid "Surrounded start"
msgstr "Départ encerclé"

#: src/options.cpp:2538
msgid ""
"If true, spawn zombies at shelters.  Makes the starting game a lot harder."
msgstr ""
"Si vrai des zombies sont générés aux abris. Le début est donc beaucoup plus "
"difficile."

#: src/options.cpp:2544
msgid "Mutations by radiation"
msgstr "Mutations par radiation"

#: src/options.cpp:2545
msgid "If true, radiation causes the player to mutate."
msgstr "Si vrai, les radiations entrainent la mutation du joueur."

#: src/options.cpp:2551
msgid "Character point pools"
msgstr ""

#: src/options.cpp:2552
msgid "Allowed point pools for character generation."
msgstr ""

#: src/options.cpp:2553
msgid "Multi-pool only"
msgstr ""

#: src/options.cpp:2553
msgid "No freeform"
msgstr ""

#: src/options.cpp:2559
msgid "Meta Progression"
msgstr ""

#: src/options.cpp:2560
msgid ""
"Will you need to complete certain achievements to enable certain scenarios "
"and professions?  Achievements are tracked from your memorial file so "
"characters from any world will be checked.  Disabling this will spoil "
"factions and situations you may otherwise stumble upon naturally.  Some "
"scenarios are frustrating for the uninitiated and some professions skip "
"portions of the games content.  If new to the game meta progression will "
"help you be introduced to mechanics at a reasonable pace."
msgstr ""

#: src/options.cpp:2571
msgid "Distance initial visibility"
msgstr "Distance de visibilité initiale"

#: src/options.cpp:2572
msgid "Determines the scope, which is known in the beginning of the game."
msgstr "Détermine l'étendue qui est connu au début du jeu."

#: src/options.cpp:2578
msgid "Initial stat points"
msgstr "Points de stats initiaux"

#: src/options.cpp:2579
msgid "Initial points available to spend on stats on character generation."
msgstr "Les points initiaux à dépenser pour les statistiques du personnage."

#: src/options.cpp:2583
msgid "Initial trait points"
msgstr "Points de trait initiaux"

#: src/options.cpp:2584
msgid "Initial points available to spend on traits on character generation."
msgstr "Les points initiaux à dépenser pour les traits du personnage."

#: src/options.cpp:2588
msgid "Initial skill points"
msgstr "Points de compétences initiaux"

#: src/options.cpp:2589
msgid "Initial points available to spend on skills on character generation."
msgstr "Les points initiaux à dépenser pour les compétences du personnage."

#: src/options.cpp:2593
msgid "Maximum trait points"
msgstr "Maximum de points de trait"

#: src/options.cpp:2594
msgid "Maximum trait points available for character generation."
msgstr ""
"Le nombre maximum de points de trait disponibles lors de la création de "
"personnage."

#: src/options.cpp:2600
msgid "Skill training speed"
msgstr "Vitesse d'apprentissage"

#: src/options.cpp:2601
msgid ""
"Scales experience gained from practicing skills and reading books.  0.5 is "
"half as fast as default, 2.0 is twice as fast, 0.0 disables skill training "
"except for NPC training."
msgstr ""
"Règle la vitesse d'apprentissage des compétences par la pratique et la "
"lecture. 0.5 est deux fois plus lent et 2.0 deux fois plus rapide. 0.0 "
"désactive l'apprentissage, excepté pour les PNJ."

#: src/options.cpp:2607
msgid "Skill rust"
msgstr "Oubli des compétences"

#: src/options.cpp:2608
msgid ""
"Set the type of skill rust.  Vanilla: Skill rust can decrease levels.  - "
"Capped: Skill rust cannot decrease levels.  - Off: None at all."
msgstr ""

#. ~ plain, default, normal
#: src/options.cpp:2610
msgid "Vanilla"
msgstr "Vanilla"

#. ~ capped at a value
#: src/options.cpp:2612
msgid "Capped"
msgstr "Bloqué"

#: src/options.cpp:2619
msgid "Experimental 3D field of vision"
msgstr "Champ de vision 3D (expérimental)"

#: src/options.cpp:2620
msgid ""
"If true and the world is in Z-level mode, the vision will extend beyond "
"current Z-level.  If false, vision is limited to current Z-level.  Currently"
" very bugged!"
msgstr ""

#: src/options.cpp:2624
msgid "Vertical range of 3D field of vision"
msgstr ""

#: src/options.cpp:2625
msgid ""
"How many levels up and down the experimental 3D field of vision reaches.  "
"(This many levels up, this many levels down.)  3D vision of the full height "
"of the world can slow the game down a lot.  Seeing fewer Z-levels is faster."
msgstr ""

#: src/options.cpp:2631
msgid "Draw walls retracted in ISO tile-sets"
msgstr ""

#: src/options.cpp:2632
msgid "Draw walls normal, retracted, or automatically retracting near player."
msgstr ""

#: src/options.cpp:2633
msgid "Retracted"
msgstr ""

#: src/options.cpp:2634
msgid "Auto"
msgstr "Auto"

#: src/options.cpp:2638
msgid "Minimum distance for auto-retracting walls"
msgstr ""

#: src/options.cpp:2639
msgid ""
"Minimum distance for auto-retracting walls.  Values above zero overwrite "
"tileset settings."
msgstr ""

#: src/options.cpp:2643
msgid "Maximum distance for auto-retracting walls"
msgstr ""

#: src/options.cpp:2644
msgid ""
"Maximum distance for auto-retracting walls.  Values above zero overwrite "
"tileset settings."
msgstr ""

#: src/options.cpp:2658
msgid "Quicksave on app lose focus"
msgstr "Sauvegarde rapide quand l'app perd le focus"

#: src/options.cpp:2659
msgid ""
"If true, quicksave whenever the app loses focus (screen locked, app moved "
"into background etc.)  WARNING: Experimental.  This may result in corrupt "
"save games."
msgstr ""

#: src/options.cpp:2665
msgid "Trap Back button"
msgstr "Bouton Retour Piège"

#: src/options.cpp:2666
msgid ""
"If true, the back button will NOT back out of the app and will be passed to "
"the application as SDL_SCANCODE_AC_BACK.  Requires restart."
msgstr ""

#: src/options.cpp:2671
msgid "Use native Android UI menus"
msgstr ""

#: src/options.cpp:2672
msgid ""
"If true, native Android dialogs are used for some in-game menus, such as "
"popup messages and yes/no dialogs."
msgstr ""

#: src/options.cpp:2677
msgid "Auto-manage virtual keyboard"
msgstr "Gérer automatiquement le clavier virtuel"

#: src/options.cpp:2678
msgid ""
"If true, automatically show/hide the virtual keyboard when necessary based "
"on context.  If false, virtual keyboard must be toggled manually."
msgstr ""

#: src/options.cpp:2683
msgid "Virtual keyboard screen scale"
msgstr "Échelle  l’écran du clavier virtuel."

#: src/options.cpp:2684
msgid ""
"If true, when the virtual keyboard is visible, scale the screen to prevent "
"overlapping.  Useful for text entry so you can see what you're typing."
msgstr ""

#: src/options.cpp:2690
msgid "Vibration duration"
msgstr "Durée de vibration"

#: src/options.cpp:2691
msgid ""
"If non-zero, vibrate the device for this long on input, in milliseconds.  "
"Ignored if hardware keyboard connected."
msgstr ""

#: src/options.cpp:2697
msgid "Show virtual joystick"
msgstr "Afficher le joystick virtuel"

#: src/options.cpp:2698
msgid ""
"If true, show the virtual joystick when touching and holding the screen.  "
"Gives a visual indicator of deadzone and stick deflection."
msgstr ""

#: src/options.cpp:2702
msgid "Virtual joystick opacity"
msgstr "Opacité du joystick virtuel"

#: src/options.cpp:2703
msgid "The opacity of the on-screen virtual joystick, as a percentage."
msgstr "Opacité du joystick virtuel à l'écran, en pourcentage."

#: src/options.cpp:2707
msgid "Virtual joystick deadzone size"
msgstr "Taille de la zone morte du joystick virtuel"

#: src/options.cpp:2708
msgid ""
"While using the virtual joystick, deflecting the stick beyond this distance "
"will trigger directional input.  Specified as a percentage of longest screen"
" edge."
msgstr ""

#: src/options.cpp:2712
msgid "Virtual joystick size"
msgstr "Taille du joystick virtuel"

#: src/options.cpp:2713
msgid ""
"While using the virtual joystick, deflecting the stick by this much will "
"repeat input at the deflected rate (see below).  Specified as a percentage "
"of longest screen edge."
msgstr ""

#: src/options.cpp:2718
msgid "Virtual joystick follows finger"
msgstr "Le joystick virtuel suit le doigt"

#: src/options.cpp:2719
msgid ""
"If true, the virtual joystick will follow when sliding beyond its range."
msgstr "Si vrai, le joystick virtuel suivra en glissant au-delà de sa portée."

#: src/options.cpp:2724
msgid "Virtual joystick repeat rate (centered)"
msgstr "Fréquence de répétition du joystick virtuel (centré)"

#: src/options.cpp:2725
msgid ""
"When the virtual joystick is centered, how fast should input events repeat, "
"in milliseconds."
msgstr ""
"Lorsque le joystick virtuel est centré, vitesse a laquelle les événements "
"doivent êtres répétés, en millisecondes."

#: src/options.cpp:2730
msgid "Virtual joystick repeat rate (deflected)"
msgstr "Fréquence de répétition du joystick virtuel (décalé)"

#: src/options.cpp:2731
msgid ""
"When the virtual joystick is fully deflected, how fast should input events "
"repeat, in milliseconds."
msgstr ""
"Lorsque le joystick virtuel est totalement écarté, vitesse a laquelle les "
"événements doivent être répété en millisecondes."

#: src/options.cpp:2736
msgid "Virtual joystick repeat rate sensitivity"
msgstr "Sensibilité du taux de répétition du joystick virtuel"

#: src/options.cpp:2737
msgid ""
"As the virtual joystick moves from centered to fully deflected, this value "
"is an exponent that controls the blend between the two repeat rates defined "
"above.  1.0 = linear."
msgstr ""

#: src/options.cpp:2741
msgid "Input repeat delay"
msgstr "Délai de répétition de l'entrée."

#: src/options.cpp:2742
msgid ""
"While touching the screen, wait this long before showing the virtual "
"joystick and repeating input, in milliseconds.  Also used to determine "
"tap/double-tap detection, flick detection and toggling quick shortcuts."
msgstr ""

#: src/options.cpp:2746
msgid "Virtual joystick hides shortcuts"
msgstr "Le joystick virtuel cache les raccourcis"

#: src/options.cpp:2747
msgid ""
"If true, hides on-screen keyboard shortcuts while using the virtual "
"joystick.  Helps keep the view uncluttered while traveling long distances "
"and navigating menus."
msgstr ""

#: src/options.cpp:2753
msgid "Default gameplay shortcuts"
msgstr "Raccourcis de gameplay par défaut"

#: src/options.cpp:2754
msgid ""
"The default set of gameplay shortcuts to show.  Used on starting a new game "
"and whenever all gameplay shortcuts are removed."
msgstr ""

#: src/options.cpp:2759
msgid "Add shortcuts for action menu selections"
msgstr "Ajouter des raccourcis pour les sélections du menu d'action"

#: src/options.cpp:2760
msgid ""
"If true, automatically add a shortcut for actions selected via the in-game "
"action menu."
msgstr ""
"Si vrai, ajoute automatiquement un raccourci pour les actions sélectionnées "
"via le menu d'actions du jeu."

#: src/options.cpp:2765
msgid "Add shortcuts for inventory selections"
msgstr "Ajouter des raccourcis pour les sélections du menu d'inventaire"

#: src/options.cpp:2766
msgid ""
"If true, automatically add a shortcut for items selected via the inventory."
msgstr ""
"Si vrai, ajoute automatiquement un raccourci pour les éléments sélectionnés "
"via l'inventaire."

#: src/options.cpp:2772
msgid "Tap key (in-game)"
msgstr "Touche tap (en jeu)"

#: src/options.cpp:2773
msgid "The key to press when tapping during gameplay."
msgstr "La touche à presser lorsqu’on tape en jeu."

#: src/options.cpp:2777
msgid "Two-finger tap key (in-game)"
msgstr "Touche tap a deux doigts (en jeu)"

#: src/options.cpp:2778
msgid "The key to press when tapping with two fingers during gameplay."
msgstr ""
"La touche a presser lorsqu'un tap est effectué à deux doigts pendant le jeu."

#: src/options.cpp:2782
msgid "Two-finger swipe up key (in-game)"
msgstr "Touche balayage à deux doigts ascendant (en jeu)"

#: src/options.cpp:2783
msgid "The key to press when swiping up with two fingers during gameplay."
msgstr ""
"La touche a presser lorsqu'un balayage à deux doigts ascendant est effectué "
"pendant le jeu."

#: src/options.cpp:2788
msgid "Two-finger swipe down key (in-game)"
msgstr "Touche balayage descendant a deux doigts (en jeu)"

#: src/options.cpp:2789
msgid "The key to press when swiping down with two fingers during gameplay."
msgstr ""
"Touche à presser lors d'un balayage descendant à deux doigts pendant le jeu."

#: src/options.cpp:2794
msgid "Two-finger swipe left key (in-game)"
msgstr "Touche balayage à deux doigts gauche (en jeu)"

#: src/options.cpp:2795
msgid "The key to press when swiping left with two fingers during gameplay."
msgstr ""
"La touche a presser lorsqu'un balayage gauche à deux doigts est effectué "
"pendant le jeu."

#: src/options.cpp:2800
msgid "Two-finger swipe right key (in-game)"
msgstr "Touche balayage droite à deux doigts (en jeu)"

#: src/options.cpp:2801
msgid "The key to press when swiping right with two fingers during gameplay."
msgstr ""
"La touche a presser lorsqu'un balayage droite à deux doigts est effectué "
"pendant le jeu."

#: src/options.cpp:2805
msgid "Pinch in key (in-game)"
msgstr "Touche pincement (en jeu)"

#: src/options.cpp:2806
msgid "The key to press when pinching in during gameplay."
msgstr "La touche à presser lorsqu'un pincement est effectué pendant le jeu."

#: src/options.cpp:2810
msgid "Pinch out key (in-game)"
msgstr "Touche écartement (en jeu)"

#: src/options.cpp:2811
msgid "The key to press when pinching out during gameplay."
msgstr "la touche a presser lorsqu'un écartement est effectué pendant le jeu."

#: src/options.cpp:2818
msgid "Auto-manage contextual gameplay shortcuts"
msgstr "Gérer automatiquement les raccourcis de jeu"

#: src/options.cpp:2819
msgid ""
"If true, contextual in-game shortcuts are added and removed automatically as"
" needed: examine, close, butcher, move up/down, control vehicle, pickup, "
"toggle enemy + safe mode, sleep."
msgstr ""
"Si vrai, des raccourcis contextuels seront ajoutés et supprimés "
"automatiquement selon les besoins: examiner, fermer, dépecer, "
"monter/descendre, contrôler le véhicule, ramasser, basculer en mode "
"prudence, dormir."

#: src/options.cpp:2824
msgid "Move contextual gameplay shortcuts to front"
msgstr "Déplacer les raccourcis de jeu au premier plan"

#: src/options.cpp:2825
msgid ""
"If the option above is enabled, specifies whether contextual in-game "
"shortcuts will be added to the front or back of the shortcuts list.  If "
"true, makes them easier to reach.  If false, reduces shuffling of shortcut "
"positions."
msgstr ""

#: src/options.cpp:2829
msgid "Move used shortcuts to front"
msgstr "Déplacer les raccourcis utilisés au premier plan"

