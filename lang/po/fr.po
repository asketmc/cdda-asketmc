#: data/json/items/chemicals_and_resources.json
msgid "slaked lime"
msgid_plural "slaked lime"
msgstr[0] "hydroxyde de calcium"
msgstr[1] "hydroxyde de calcium"
msgstr[2] "hydroxyde de calcium"

#. ~ Description of "slaked lime"
#: data/json/items/chemicals_and_resources.json
msgid ""
" A white odorless powder with many uses.  Also known as calcium hydroxide."
msgstr ""

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgctxt "material"
msgid "sand"
msgid_plural "sand"
msgstr[0] "sable"
msgstr[1] "sable"
msgstr[2] "sable"

#. ~ Description of "sand"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A handful of New England sand.  If you had a stoked furnace, you could turn "
"it into glass.  Otherwise, it's only good for making cement."
msgstr ""
"Du sable. Avec un four alimenté vous pourriez en faire du verre. Sinon ce "
"n'est bon qu'a en faire du ciment."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "soil"
msgid_plural "soil"
msgstr[0] "terre"
msgstr[1] "terre"
msgstr[2] "terre"

#. ~ Description of "soil"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A pile of loosely-packed, slightly damp loamy soil.  This mixture of sand, "
"silt and clay is ideal for growing plants."
msgstr ""
"Un tas de terreaux argileux légèrement humide. Ce mélange de sable, de limon"
" et d'argile est idéal pour la croissance des plantes."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "limestone shard"
msgid_plural "limestone shards"
msgstr[0] "éclat de calcaire"
msgstr[1] "éclats de calcaire"
msgstr[2] "éclats de calcaire"

#. ~ Description of "limestone shard"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A small shard of limestone.  Pretty flimsy and not much of a weapon, but its"
" alkaline properties may yet find some use."
msgstr ""
"Un petit éclat de calcaire. Fragile et peu fiable en tant qu'arme, mes ses "
"propriétés alcalines pourraient être utiles."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "rock salt"
msgid_plural "rock salt"
msgstr[0] "sel gemme"
msgstr[1] "sels gemme"
msgstr[2] "sels gemme"

#. ~ Description of "rock salt"
#: data/json/items/chemicals_and_resources.json
msgid "A handful of rock salt crystals.  Could be refined into table salt."
msgstr ""
"Une poignée de sels gemme. Il pourrait être transformé en sel de table."

#. ~ density: 3.57–3.76 g/cm3
#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "rhodonite"
msgid_plural "rhodonite"
msgstr[0] "rhodonite"
msgstr[1] "rhodonite"
msgstr[2] "rhodonite"

#. ~ density: 3.57–3.76 g/cm3
#. ~ Description of "rhodonite"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A chunk of rhodonite.  It has manganese dioxide covering and going through "
"it in veins, which can be obtained using a chisel."
msgstr ""

#. ~ density: 5.64–5.68 g/cm3
#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "zincite"
msgid_plural "zincite"
msgstr[0] "zincite"
msgstr[1] "zincite"
msgstr[2] "zincite"

#. ~ density: 5.64–5.68 g/cm3
#. ~ Description of "zincite"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A chunk of zincite.  Could be refined into zinc oxide, then into zinc by "
"reduction with a source of carbon."
msgstr ""

#. ~ $0.67 per charge for a $10 15-charge gallon of bleach.
#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "bleach"
msgid_plural "bleach"
msgstr[0] "eau de Javel"
msgstr[1] "eau de Javel"
msgstr[2] "eau de Javel"

#. ~ $0.67 per charge for a $10 15-charge gallon of bleach.
#. ~ Description of "bleach"
#: data/json/items/chemicals_and_resources.json
msgid "This is sodium hypochlorite, a common household cleaning agent."
msgstr ""

#. ~ Conditional name for "bleach" when FLAG matches DIRTY
#: data/json/items/chemicals_and_resources.json
msgid "bleach spill"
msgid_plural "bleach spills"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "liquid ammonia"
msgid_plural "liquid ammonia"
msgstr[0] "ammoniaque liquide"
msgstr[1] "ammoniaque liquide"
msgstr[2] "ammoniaque liquide"

#. ~ Description of "liquid ammonia"
#: data/json/items/chemicals_and_resources.json
msgid ""
"This is anhydrous ammonia, a useful chemical compound.  It must be stored "
"under pressure or refrigerated.  Don't even think about drinking it."
msgstr ""

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "ammonia solution"
msgid_plural "ammonia solution"
msgstr[0] "solution ammoniacale"
msgstr[1] "solution ammoniacale"
msgstr[2] "solution ammoniacale"

#. ~ Description of "ammonia solution"
#: data/json/items/chemicals_and_resources.json
msgid "This is ammonium hydroxide, a common household cleaning agent."
msgstr ""
"De l'hydroxyde d'ammonium, souvent utilisé comme produit de nettoyage. "
"Extrêmement toxique en cas d'ingestion."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "liquid fertilizer"
msgid_plural "liquid fertilizer"
msgstr[0] "engrais liquide"
msgstr[1] "engrais liquide"
msgstr[2] "engrais liquide"

#. ~ Description of "liquid fertilizer"
#: data/json/items/chemicals_and_resources.json
msgid "A nutrient-rich elixir for plants."
msgstr ""

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "commercial fertilizer"
msgid_plural "commercial fertilizer"
msgstr[0] "engrais commercial"
msgstr[1] "engrais commercial"
msgstr[2] "engrais commercial"

#. ~ Description of "commercial fertilizer"
#: data/json/items/chemicals_and_resources.json
msgid "Nutrient-rich granules for plants."
msgstr ""

#. ~ Typically sold in larger quantities, but that's handled in the charge
#. count.
#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "fungicide"
msgid_plural "fungicide"
msgstr[0] "fongicide"
msgstr[1] "fongicide"
msgstr[2] "fongicide"

#. ~ Typically sold in larger quantities, but that's handled in the charge
#. count.
#. ~ Description of "fungicide"
#: data/json/items/chemicals_and_resources.json
msgid ""
"Agricultural-grade chemical anti-fungal powder designed to destroy "
"infections in plants."
msgstr ""

#. ~ Typically sold in larger quantities, but that's handled in the charge
#. count.
#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "insecticide"
msgid_plural "insecticide"
msgstr[0] "insecticide"
msgstr[1] "insecticide"
msgstr[2] "insecticide"

#. ~ Typically sold in larger quantities, but that's handled in the charge
#. count.
#. ~ Description of "insecticide"
#: data/json/items/chemicals_and_resources.json
msgid ""
"Agricultural-grade chemical insecticide powder designed to eradicate insect "
"pests."
msgstr ""
"Un agent chimique insecticide conçu pour éradiquer les insectes nuisibles."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "salt water"
msgid_plural "salt water"
msgstr[0] "eau salée"
msgstr[1] "eau salée"
msgstr[2] "eau salée"

#. ~ Description of "salt water"
#: data/json/items/chemicals_and_resources.json
msgid "Water with salt added.  Not good for drinking."
msgstr "De l'eau avec du sel. Mauvais à boire."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "soapy water"
msgid_plural "soapy water"
msgstr[0] "eau savonneuse"
msgstr[1] "eau savonneuse"
msgstr[2] "eau savonneuse"

#. ~ Description of "soapy water"
#: data/json/items/chemicals_and_resources.json
msgid "Water with soap added.  Not good for drinking."
msgstr "De l'eau avec du savon. Mauvais à boire."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "sewage sample"
msgid_plural "sewage samples"
msgstr[0] "échantillon d'eau usée"
msgstr[1] "échantillons d'eau usée"
msgstr[2] "échantillons d'eau usée"

#. ~ Description of "sewage sample"
#: data/json/items/chemicals_and_resources.json
msgid "A sample of sewage from a treatment plant.  Gross."
msgstr ""
"Un échantillon d'eau usée obtenue dans une station d'épuration. Répugnant."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "aluminum powder"
msgid_plural "aluminum powder"
msgstr[0] "poudre d'aluminium"
msgstr[1] "poudre d'aluminium"
msgstr[2] "poudre d'aluminium"

#. ~ Description of "aluminum powder"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A handful of finely-ground aluminum powder.  This strong reducing agent was "
"used in combination with various oxidants for chemical welding and "
"explosives alike.  Just before the Cataclysm, however, it was the basis of "
"virtually all commercial metallic-hued paints and anti-corrosive coatings."
msgstr ""
"Une poignée de poudre fine d'aluminium. Ce fort agent réducteur était "
"utilisé avec divers oxydants pour la soudure chimique et les explosifs. "
"Juste avant le cataclysme, il servait dans les peintures métalliques et les "
"revêtements anti-corrosion."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "nickel powder"
msgid_plural "nickel powder"
msgstr[0] "poudre de nickel"
msgstr[1] "poudre de nickel"
msgstr[2] "poudre de nickel"

#. ~ Description of "nickel powder"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A silvery-white metallic powder composed of nickel.  Common industrial uses "
"include production of stainless steel as well as other alloys."
msgstr ""

#. ~ density: 7.14 g/cm3
#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "zinc powder"
msgid_plural "zinc powder"
msgstr[0] "poudre de zinc"
msgstr[1] "poudre de zinc"
msgstr[2] "poudre de zinc"

#. ~ density: 7.14 g/cm3
#. ~ Description of "zinc powder"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A handful of zinc powder.  While commercially used mostly in cosmetics and "
"for paints, hobbyists used to mix it with sulfur to make basic rocket fuel "
"or a smokescreen.  When treated with a strong acid, it will produce "
"hydrogen."
msgstr ""
"Une poignée de poudre de zinc. Commercialement utilisée pour la cosmétique "
"et les peintures, les amateurs l'utilisait avec du soufre pour en faire du "
"combustible à roquette ou des écrans de fumée. Si on le traite avec un acide"
" fort, il produit de l'hydrogène."

#. ~ density: 5.1 g/cm3
#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "zinc oxide"
msgid_plural "zinc oxide"
msgstr[0] "oxyde de zinc"
msgstr[1] "oxydes de zinc"
msgstr[2] "oxydes de zinc"

#. ~ density: 5.1 g/cm3
#. ~ Description of "zinc oxide"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A handful of zinc oxide.  It can be reduced into zinc, or used for some "
"other reactions of its own."
msgstr ""
"Une poignée d'oxyde de zinc. Elle peut être réduite en zinc, ou utilisée "
"pour d'autres réactions qui lui sont propre."

#. ~ density: 5.026 g/cm3
#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "manganese dioxide"
msgid_plural "manganese dioxide"
msgstr[0] "dioxydes de manganèse"
msgstr[1] "dioxydes de manganèse"
msgstr[2] "dioxydes de manganèse"

#. ~ density: 5.026 g/cm3
#. ~ Description of "manganese dioxide"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A handful of manganese dioxide powder.  Occurring naturally in the mineral "
"pyrolusite, it is used commercially in the production of alkaline and zinc-"
"carbon batteries."
msgstr ""
"Une poignée de poudre de dioxyde de manganèse. Se trouvant naturellement "
"dans le minerai de pyrolusite, elle est utilisée dans la production "
"commerciale des piles alcalines et des piles zinc-carbone."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "acidic electrolyte paste"
msgid_plural "acidic electrolyte paste"
msgstr[0] "pâte électrolytique acidique"
msgstr[1] "pâte électrolytique acidique"
msgstr[2] "pâte électrolytique acidique"

#. ~ Description of "acidic electrolyte paste"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A moisturized mixture of zinc chloride and manganese dioxide, slightly "
"acidic.  It can be used in the production of zinc-carbon batteries."
msgstr ""

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "ferric chloride"
msgid_plural "ferric chloride"
msgstr[0] "chlorure de fer"
msgstr[1] "chlorure de fer"
msgstr[2] "chlorure de fer"

#. ~ Description of "ferric chloride"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A dark green crystalline powder with a weak pungent smell similar to that of"
" hydrochloric acid.  Commonly used as a Lewis acid for catalyzing various "
"chemical reactions."
msgstr ""

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "antimony trichloride"
msgid_plural "antimony trichloride"
msgstr[0] "trichlorure d'antimoine"
msgstr[1] "trichlorure d'antimoine"
msgstr[2] "trichlorure d'antimoine"

#. ~ Description of "antimony trichloride"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A soft colorless powder with a sharp pungent odor, also known as butter of "
"antimony.  It's a catalyst for polymerization, hydrocracking, and "
"chlorination reactions, and has some other niche uses."
msgstr ""
"Une poudre molle et incolore à l'odeur âcre, également connue sous le nom de"
" beurre d'antimoine. C'est un catalyseur pour les réactions de "
"polymérisation, d'hydrocraquage et de chloration, et il a d'autres "
"utilisations de niche."

#. ~ density: 1.984 g/cm3
#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "potassium chloride"
msgid_plural "potassium chloride"
msgstr[0] "chlorure de potassium"
msgstr[1] "chlorures de potassium"
msgstr[2] "chlorures de potassium"

#. ~ density: 1.984 g/cm3
#. ~ Description of "potassium chloride"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A handful of potassium chloride.  Although it occurs naturally in the "
"mineral sylvite, it can be produced as a byproduct of the reaction of "
"saltpeter and hydrochloric acid.  It can be used for making fertilizer, or "
"potassium hydroxide by way of electrolysis."
msgstr ""
"Une poignée de chlorure de potassium. Bien que trouvable naturellement dans "
"la sylvine minérale, il peut être produit artificiellement par la réaction "
"du salpêtre et de l'acide chlorhydrique. Il peut est utilisé pour faire des "
"engrais, ou de l’hydroxyde de potassium par électrolyse."

#. ~ density: 2.12 g/cm3 (25 °C)
#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "potassium hydroxide"
msgid_plural "potassium hydroxide"
msgstr[0] "hydroxyde de potassium"
msgstr[1] "hydroxydes de potassium"
msgstr[2] "hydroxydes de potassium"

#. ~ density: 2.12 g/cm3 (25 °C)
#. ~ Description of "potassium hydroxide"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A handful of potassium hydroxide.  Commonly called caustic potash, it was "
"mainly used industrially for its caustic nature.  It can be used as an "
"electrolyte in alkaline batteries, among other applications."
msgstr ""
"Une poignée d'hydroxyde de potassium. Communément appelé potasse caustique, "
"il était principalement utilisé industriellement pour sa nature caustique. "
"Il peut être utilisé comme électrolyte dans des piles alcalines, parmi "
"d'autres utilisations."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "sulfuric acid"
msgid_plural "sulfuric acid"
msgstr[0] "acide sulfurique"
msgstr[1] "acide sulfurique"
msgstr[2] "acide sulfurique"

#. ~ Description of "sulfuric acid"
#: data/json/items/chemicals_and_resources.json
msgid ""
"Sulfuric acid: viscous, foul-smelling and extremely corrosive, particularly "
"to organic matter and evil clowns.  Although used to prepare a number of "
"chemicals, it is mostly known as battery acid, due to its widest commercial "
"application."
msgstr ""
"Acide sulfurique: visqueux, nauséabond et très corrosif, particulièrement "
"avec les matières organiques et les mauvais clowns. Il est utilisé dans de "
"nombreuses formules chimiques mais est principalement connu pour son "
"utilisation en tant qu'acide de batterie."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "hydrochloric acid"
msgid_plural "hydrochloric acid"
msgstr[0] "acide chlorhydrique"
msgstr[1] "acides chlorhydriques"
msgstr[2] "acides chlorhydriques"

#. ~ Description of "hydrochloric acid"
#: data/json/items/chemicals_and_resources.json
msgid ""
"Hydrochloric acid, also known as muriatic acid.  It is a strong acid that "
"has a distinctive smell, important and frequently used ever since its "
"discovery.  It still has a vast multitude of uses."
msgstr ""
"Acide chlorhydrique, aussi appelé acide muriatique. C'est un acide puissant "
"qui a une odeur distincte, important et fréquemment utilisé depuis sa "
"découverte. Il a encore une multitude d'utilités."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "acetone"
msgid_plural "acetone"
msgstr[0] "acétone"
msgstr[1] "acétone"
msgstr[2] "acétone"

#. ~ Description of "acetone"
#: data/json/items/chemicals_and_resources.json
msgid ""
"Acetone, best known as the primary constituent of most nail polish removers."
"  Flammable, and can be easily used for potent home-made explosives, as "
"demonstrated by the terrorist attacks of 2016."
msgstr ""
"L'acétone est principalement connu pour ses propriétés de décapant. "
"Inflammable, il peut facilement servir pour faire des explosifs, comme l'a "
"démontré l'attentat terroriste de 2016."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "nitric acid"
msgid_plural "nitric acid"
msgstr[0] "a"
msgstr[1] "acide nitrique"
msgstr[2] "acide nitrique"

#. ~ Description of "nitric acid"
#: data/json/items/chemicals_and_resources.json
msgid ""
"Nitric acid, a strong oxidant and an extremely corrosive material.  Mainly "
"used in the production of synthetic fertilizers, for etching of circuit "
"boards and in woodworking.  Remains quite useful both for making a vast "
"array of pyrotechnic and explosive agents and as a direct weapon: not many "
"beings enjoy being doused in nitric acid."
msgstr ""
"L'acide nitrique est très oxydant et très corrosif. Principalement utilisé "
"dans la fabrication d'engrais et en microélectronique. Il peut faire de bons"
" explosifs, ou s'utiliser comme arme en l'état."

#. ~ density: 5.22 g/cm3
#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "chromium oxide"
msgid_plural "chromium oxide"
msgstr[0] "Oxyde de chrome"
msgstr[1] "oxyde de chrome"
msgstr[2] "oxyde de chrome"

#. ~ density: 5.22 g/cm3
#. ~ Description of "chromium oxide"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A handful of chromium oxide.  This substance, typically known as the only "
"stable green pigment for paints, is also a mild oxidizer, which can be mixed"
" with aluminum powder to make thermite for welding.  If one had access to a "
"CVD machine and a laboratory worth of reagents, they might be able to "
"produce very durable ceramic layers."
msgstr ""
"Une poignée d'oxyde de chrome. Cette substance, connue comme le seul pigment"
" vert pour les peintures, et également utilisée comme comburant, qui "
"mélangée avec de la poudre d'aluminium peut produire de la thermite pour la "
"soudure. Celui qui a accès à un laboratoire avec les composants nécessaires "
"pourrait produire de la céramique très résistante."

#. ~ density: 2.22 g/cm3
#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "calcium carbide"
msgid_plural "calcium carbide"
msgstr[0] "carbure de calcium"
msgstr[1] "carbure de calcium"
msgstr[2] "carbure de calcium"

#. ~ density: 2.22 g/cm3
#. ~ Description of "calcium carbide"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A handful of calcium carbide, giving off a faint, garlic-like smell.  "
"Commercially, calcium carbide was used for on-the-spot manufacture of "
"acetylene and historically to power acetylene lamps.  If mixed with water "
"and sealed, it will explode with little strength, but with relatively loud "
"noise and could maybe be used as a decoy."
msgstr ""
"Une poignée de carbure de calcium qui sent légèrement l'ail. Utilisé pour "
"fabriquer de l'acétylène et alimenter les lampes à acétylène. Si on le "
"mélange à de l'eau dans un récipient fermé, cela peut créer une petite "
"explosion, mais plutôt bruyante qui peut détourner l'attention."

#. ~ Description of "hexamine"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A handful of waxy hexamine tablets.  This ubiquitous fuel was used to start "
"up almost every garden grill, and no 'real' camping trip could do its "
"cooking without it, until the Cataclysm.  Nowadays, it is even more valuable"
" than before, being the key component in the preparation of several "
"military-grade explosives."
msgstr ""
"Une poignée de tablettes cireuses d'hexamine. Ce carburant omniprésent était"
" utilisé pour démarrer a peut prêt n'importe quel barbecue et aucune "
"'véritable' sortie camping ne pouvais avoir lieu sans elle, jusqu'au "
"cataclysme. Elle est maintenant encore plus précieuse qu'avant étant le "
"composant clé dans la préparation de nombreux explosifs de qualité "
"militaire."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "hydrogen peroxide (concentrated)"
msgid_plural "hydrogen peroxide (concentrated)"
msgstr[0] "peroxyde d'hydrogène (concentré)"
msgstr[1] "peroxyde d'hydrogène (concentré)"
msgstr[2] "peroxyde d'hydrogène (concentré)"

#. ~ Description of "hydrogen peroxide (concentrated)"
#: data/json/items/chemicals_and_resources.json
msgid ""
"Concentrated hydrogen peroxide is a powerful oxidant, violently decomposing "
"in contact with most reducing agents.  Can be used as rocket fuel or to make"
" high explosives.  Causes severe burns to any organic matter and may ignite "
"it on contact."
msgstr ""
"De l'eau oxygénée concentrée. Peut s'utiliser pour fabriquer du combustible "
"à roquettes ou des explosifs. Provoque de sérieuses brûlures sur les "
"matières organiques et peut même les enflammer au contact."

#. ~ Description of "plutonium"
#: data/json/items/chemicals_and_resources.json
msgid ""
"Some plutonium.  You should probably get very far away from this, if you "
"enjoy not being irradiated."
msgstr ""

#. ~ Description of "uranium"
#: data/json/items/chemicals_and_resources.json
msgid ""
"Some uranium.  You should probably get very far away from this, if you enjoy"
" not being irradiated."
msgstr ""

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "ammonium nitrate"
msgid_plural "ammonium nitrate"
msgstr[0] "nitrate d'ammonium"
msgstr[1] "nitrate d'ammonium"
msgstr[2] "nitrate d'ammonium"

#. ~ Description of "ammonium nitrate"
#: data/json/items/chemicals_and_resources.json
msgid ""
"Some ammonium nitrate.  This white, crystalline powder is commonly used as a"
" component of fertilizers and explosives.  Could also be dissolved in water "
"to sharply lower its temperature, but is there any use for this quality in "
"this new world?"
msgstr ""
"Une poignée de nitrate d'ammonium. Cette poudre blanche cristalline est "
"couramment utilisée dans les fertilisants et les explosifs. On peut aussi la"
" dissoudre dans l'eau pour en diminuer nettement la température, mais est-ce"
" utile dans ce nouveau monde?"

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "ammonium nitrate pellets"
msgid_plural "ammonium nitrate pellets"
msgstr[0] "granules de nitrate d’ammonium"
msgstr[1] "granules de nitrate d’ammonium"
msgstr[2] "granules de nitrate d’ammonium"

#. ~ Description of "ammonium nitrate pellets"
#: data/json/items/chemicals_and_resources.json
msgid ""
"Some ammonium nitrate pellets.  These pellets are commonly used as a "
"component of fertilizers and explosives.  Could also be dissolved in water "
"to sharply lower its temperature, but is there any use for this quality in "
"this new world?"
msgstr ""
"Des granules de nitrate d'ammonium. Ces granules sont couramment utilisés "
"dans les fertilisants et les explosifs. On peut aussi la dissoudre dans "
"l'eau pour en diminuer nettement la température, mais est-ce utile dans ce "
"nouveau monde?"

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "saltpeter"
msgid_plural "saltpeter"
msgstr[0] "salpêtre"
msgstr[1] "salpêtre"
msgstr[2] "salpêtre"

#. ~ Description of "saltpeter"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A handful of saltpeter.  Sometimes used as a fertilizer, this ubiquitous "
"nitrate is the principal constituent of black gunpowder and simple rocket "
"propellants, such as rocket candy."
msgstr ""
"Une poignée de salpêtre. Parfois utilisé comme fertilisant, ce nitrate "
"omniprésent est le composant principal de la poudre à canon et des "
"combustibles de simple fusées tel que le rocket candy."

#. ~ Item name
#. ~ Terrain name
#: data/json/items/chemicals_and_resources.json
#: data/mods/innawood/mining/furniture_and_terrain/veins.json
msgid "niter"
msgid_plural "niter"
msgstr[0] "nitre"
msgstr[1] "nitre"
msgstr[2] "nitre"

#. ~ Description of "niter"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A large crystal of niter, the mineral form of potassium nitrate.  It can be "
"processed into saltpeter."
msgstr ""
"Un grand cristal de nitre, forme minérale du nitrate de potassium.  il peut "
"être raffiné en salpêtre."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "aluminum sulfate"
msgid_plural "aluminum sulfate"
msgstr[0] "sulfate d'aluminium"
msgstr[1] "sulfate d'aluminium"
msgstr[2] "sulfate d'aluminium"

#. ~ Description of "aluminum sulfate"
#: data/json/items/chemicals_and_resources.json
msgid ""
"Several crystals of aluminum sulfate.  Historically, an agent for purifying "
"water and as molluscicide, due to the fact that it degenerates their slime."
"  Just before the Cataclysm, its main uses were for adjusting the acidity of"
" the soil and as an additive to baking powder.  If mixed with a strong acid,"
" it could be used to saturate the soil with aluminum, causing all but the "
"most resistant of plants to wither and die."
msgstr ""
"Plusieurs cristaux de sulfate d'aluminium. Il sert notamment comme agent de "
"purification de l'eau. Avant le cataclysme il servait pour ajuster l'acidité"
" des sols et comme aditif pour certaines poudres de cuisson. Si on le "
"mélange à un acide puissant il peut saturé le sol en aluminium empêchant les"
" plantes les moins résistantes de se développer."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "acetic acid"
msgid_plural "acetic acid"
msgstr[0] "acide acétique"
msgstr[1] "acide acétique"
msgstr[2] "acide acétique"

#. ~ Description of "acetic acid"
#: data/json/items/chemicals_and_resources.json
msgid ""
"Concentrated acetic acid, typically used as a chemical reagent and "
"antifungal agent.  Despite its horrid smell, it was used to prepare several "
"types of perfumes, but would making perfume not be too fancy for post-"
"apocalyptic New England?"
msgstr ""

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "formaldehyde"
msgid_plural "formaldehyde"
msgstr[0] "méthanal"
msgstr[1] "méthanal"
msgstr[2] "méthanal"

#. ~ Description of "formaldehyde"
#: data/json/items/chemicals_and_resources.json
msgid ""
"Formaldehyde, here dissolved in water, was widely used before the Cataclysm "
"as a precursor to production of many chemicals and materials and as an "
"embalming agent.  Easily identifiable by its pungent odor.  Terribly toxic, "
"carcinogenic, and volatile."
msgstr ""
"Formaldéhyde, ici dissout dans l'eau, était largement utilisé avant le "
"Cataclysme comme précurseur à la production de nombreux produits chimiques "
"et matériaux ainsi que comme agent d'embaumement. Facilement identifiable à "
"son odeur âcre. Terriblement toxique, cancérigène et volatile."

#. ~ Weight might not be accurate.
#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "thermite"
msgid_plural "thermite"
msgstr[0] "thermite"
msgstr[1] "thermite"
msgstr[2] "thermite"

#. ~ Weight might not be accurate.
#. ~ Description of "thermite"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A handful of silvery-greenish powder, produced by mixing aluminum and "
"chromium oxide.  This mixture, burning at a constant pace and at extremely "
"high temperature, was once used for on-the-spot welding.  Can be used as an "
"incendiary material in a pinch."
msgstr ""
"Un mélande d'aluminium et d'oxyde de fer. Il brûle à des températures "
"extrêmes, et s'utilisait pour les soudures. C'est une très bonne matière "
"incendiaire."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "ANFO"
msgid_plural "ANFO"
msgstr[0] "ANFO"
msgstr[1] "ANFO"
msgstr[2] "ANFO"

#. ~ Description of "ANFO"
#: data/json/items/chemicals_and_resources.json
msgid ""
"Several brownish pellets that were made by allowing ammonium nitrate to "
"absorb an organic fuel.  This ammonium nitrate/fuel oil mixture, or ANFO, is"
" a common industrial explosive due to its stability and low price.  Burns "
"fast, but needs an explosive primer to detonate."
msgstr ""
"Plusieurs pastilles brunes qui ont été créées en absorbant le combustible "
"organique du nitrate d'ammonium. Ce nitrate d'ammonium-huile combustible ou "
"ANFO, comme il est appelé, est un explosif industriel commun dû à son faible"
" prix et à sa stabilité. Brûle vite mais nécessite un explosif d'amorçage "
"pour pouvoir exploser."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "black gunpowder"
msgid_plural "black gunpowder"
msgstr[0] "poudre noire"
msgstr[1] "poudre noire"
msgstr[2] "poudre noire"

#. ~ Description of "black gunpowder"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A handful of black gunpowder, a mix of saltpeter, charcoal and sulfur.  "
"Pretty useless for making modern cartridges, as the soot produced when it "
"burns will quickly clog any firearm, but it could be used to make some "
"vicious bombs."
msgstr ""
"Une poignée de poudre noire salpêtre, charbon de bois, et de souffre. Plutôt"
" inutile pour fabriquer des cartouches, vu que la suie produite lorsqu'elle "
"brûle bouchera l'arme, mais peut être utilisé pour faire des bombes "
"vicieuses."

#. ~ Density of RDX is 1.858 g/cm3
#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "RDX"
msgid_plural "RDX"
msgstr[0] "RDX"
msgstr[1] "RDX"
msgstr[2] "RDX"

#. ~ Density of RDX is 1.858 g/cm3
#. ~ Description of "RDX"
#: data/json/items/chemicals_and_resources.json
msgid ""
"Several off-white crystals of RDX, or hexogen: a military-grade, shelf-"
"stable high explosive.  Can be cast into shaped charges, or mixed with scrap"
" to pepper the blast area with high-velocity shrapnel."
msgstr ""
"Quelques cristaux blanchâtres de RDX, ou hexogène : un explosif de classe "
"militaire, soufflant et stable. Peut être moulé en charges formées, ou "
"mélangé avec de la ferraille pour poivrer la zone de shrapnels à haute-"
"vélocité."

#. ~ Density of composition B is 1.65 g/cm3. Slightly rounded the volume from
#. 303 to 300
#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "composition B"
msgid_plural "composition B"
msgstr[0] "composition B"
msgstr[1] "composition B"
msgstr[2] "composition B"

#. ~ Density of composition B is 1.65 g/cm3. Slightly rounded the volume from
#. 303 to 300
#. ~ Description of "composition B"
#: data/json/items/chemicals_and_resources.json
msgid ""
"Composition B is an explosive consisting of castable mixtures of RDX and "
"TNT.  It is used as the main explosive filling in artillery projectiles, "
"rockets, land mines, hand grenades and various other munitions."
msgstr ""
"La composition B est un explosif constitué de RDX et de TNT. Elle est le "
"composant explosif principal des projectiles d’artilleries, missiles, mines "
"terrestres, grenades à main et autres munitions."

#. ~ Density of RDX is 1.57 g/cm3
#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "HMTD"
msgid_plural "HMTD"
msgstr[0] "HMTD"
msgstr[1] "HMTD"
msgstr[2] "HMTD"

#. ~ Density of RDX is 1.57 g/cm3
#. ~ Description of "HMTD"
#: data/json/items/chemicals_and_resources.json
msgid ""
"Hexamine peroxide: this fine, yellowish powder is a powerful primary "
"explosive, used to initiate detonation of more stable explosives, such as "
"RDX.  Relatively stable, but best not store it for too long."
msgstr ""
"Peroxyde d'hexamine : cette fine poudre jaunâtre est un explosif primaire "
"puissant utilisé pour amorcer la détonation d'explosifs plus stables comme "
"le RDX. Relativement stable mais mieux vaut ne pas le stocker trop "
"longtemps."

#. ~ Detonation velocity about 2500–3000 m/s near 0.5 g/cm3
#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "APEX"
msgid_plural "APEX"
msgstr[0] "APEX"
msgstr[1] "APEX"
msgstr[2] "APEX"

#. ~ Detonation velocity about 2500–3000 m/s near 0.5 g/cm3
#. ~ Description of "APEX"
#: data/json/items/chemicals_and_resources.json
msgid ""
"Acetone peroxide: this fine, white crystalline powder is a powerful primary "
"explosive, used to initiate detonation of more stable explosives, such as "
"RDX.  Relatively stable, with a fruit like smell when pure."
msgstr ""
"Peroxyde d'acétone : cette fine poudre blanche est un puissant explosif "
"primaire, utilisé pour initié la détonation d'explosifs plus stables tels "
"que du RDX. Relativement stable, avec une odeur fruitée lorsqu'elle est "
"pure."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "improvised rocket fuel"
msgid_plural "improvised rocket fuel"
msgstr[0] "carburant de fusée improvisé"
msgstr[1] "carburant de fusée improvisé"
msgstr[2] "carburant de fusée improvisé"

#. ~ Description of "improvised rocket fuel"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A chunk of a zinc powder and sulfur mixture, bound together by superglue, "
"that can be used as an impromptu rocket fuel."
msgstr ""
"Un mélange de zinc et de soufre qui sert de combustible à fusée improvisé."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "water purification tablet"
msgid_plural "water purification tablets"
msgstr[0] "tablette de purification d'eau"
msgstr[1] "tablettes de purification d'eau"
msgstr[2] "tablettes de purification d'eau"

#. ~ Description of "water purification tablet"
#: data/json/items/chemicals_and_resources.json
msgid ""
"Intended for the clarification and disinfection of unsafe drinking water, "
"these halazone-based purification tablets remove dangerous contaminants "
"using powerful chemicals.  The label says to use one tablet per unit of "
"water."
msgstr ""
"Conçues pour la clarification et la désinfection des eaux dangereuses, ces "
"pastilles de purification d'eau à base de halazone neutralisent les "
"contaminants dangereux grâce à des produits chimiques puissants. L'emballage"
" précise qu'il faut une pastille par unité d'eau."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "hickory root"
msgid_plural "hickory roots"
msgstr[0] "racine de caryer"
msgstr[1] "racines de caryer"
msgstr[2] "racines de caryer"

#. ~ Description of "hickory root"
#: data/json/items/chemicals_and_resources.json
msgid "A root from a hickory tree.  It has an earthy smell."
msgstr "Un racine de caryer. Il à une senteur terreuse."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "hickory nuts"
msgid_plural "hickory nuts"
msgstr[0] "noix de caryer"
msgstr[1] "noix de caryer"
msgstr[2] "noix de caryer"

#. ~ Description of "hickory nuts"
#: data/json/items/chemicals_and_resources.json
msgid "A handful of hard nuts from a hickory tree, still in their shell."
msgstr "Une poignée de noix de caryer, encore dans leur cosse."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "pecans"
msgid_plural "pecans"
msgstr[0] "noix de pécan"
msgstr[1] "noix de pécan"
msgstr[2] "noix de pécan"

#. ~ Description of "pecans"
#: data/json/items/chemicals_and_resources.json
msgid "A handful of hard nuts from a pecan tree, still in their shell."
msgstr "Une poignée de noix de pécan toujours dans leur coquilles."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "pistachios"
msgid_plural "pistachios"
msgstr[0] "pistaches"
msgstr[1] "pistaches"
msgstr[2] "pistaches"

#. ~ Description of "pistachios"
#: data/json/items/chemicals_and_resources.json
msgid "A handful of hard nuts from a pistachio tree, still in their shell."
msgstr ""
"Une poignée de noix dures d'un pistachier, toujours dans leur coquille."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "almonds"
msgid_plural "almonds"
msgstr[0] "amandes"
msgstr[1] "amandes"
msgstr[2] "amandes"

#. ~ Description of "almonds"
#: data/json/items/chemicals_and_resources.json
msgid "A handful of hard nuts from an almond tree, still in their shell."
msgstr "Une poignée d'amandes toujours dans leur coquilles."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "peanuts"
msgid_plural "peanuts"
msgstr[0] "cacahuètes"
msgstr[1] "cacahuètes"
msgstr[2] "cacahuètes"

#. ~ Description of "peanuts"
#: data/json/items/chemicals_and_resources.json
msgid "A handful of hard nuts from a peanut bush, still in their shell."
msgstr "Une poignée de noix dures d'un arachide, toujours dans leur coquille."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "hazelnuts"
msgid_plural "hazelnuts"
msgstr[0] "noisettes"
msgstr[1] "noisettes"
msgstr[2] "noisettes"

#. ~ Description of "hazelnuts"
#: data/json/items/chemicals_and_resources.json
msgid "A handful of hard nuts from a hazelnut tree, still in their shell."
msgstr ""
"Une poignée de noix dures d'un noisetier, toujours dans leur coquille."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "chestnuts"
msgid_plural "chestnuts"
msgstr[0] "marrons"
msgstr[1] "marrons"
msgstr[2] "marrons"

#. ~ Description of "chestnuts"
#: data/json/items/chemicals_and_resources.json
msgid "A handful of hard nuts from a chestnut tree, still in their shell."
msgstr ""
"Une poignée de noix dures d'un marronnier, toujours dans leur coquille."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "walnuts"
msgid_plural "walnuts"
msgstr[0] "noix"
msgstr[1] "noix"
msgstr[2] "noix"

#. ~ Description of "walnuts"
#: data/json/items/chemicals_and_resources.json
msgid "A handful of hard nuts from a walnut tree, still in their shell."
msgstr "Une poignée de noix dures d'un noyer, toujours dans leur coquille."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "sewage water"
msgid_plural "sewage water"
msgstr[0] "eaux usées"
msgstr[1] "eaux usées"
msgstr[2] "eaux usées"

#. ~ Description of "sewage water"
#: data/json/items/chemicals_and_resources.json
msgid "Turbid liquid from the sewers with an awful stench."
msgstr ""
"Un échantillon de liquide d'égout possédant une puanteur conforme à son "
"origine."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "detergent"
msgid_plural "detergent"
msgstr[0] "détergent"
msgstr[1] "détergent"
msgstr[2] "détergent"

#. ~ Description of "detergent"
#: data/json/items/chemicals_and_resources.json
msgid "A popular pre-Cataclysm washing powder."
msgstr "Une poudre de lavage populaire avant le Cataclysme."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "soap flakes"
msgid_plural "soap flakes"
msgstr[0] "copeau de savon"
msgstr[1] "copeaux de savon"
msgstr[2] "copeaux de savon"

#. ~ Description of "soap flakes"
#: data/json/items/chemicals_and_resources.json
msgid "A bar of soap cut into flakes suitable for use in a washing machine."
msgstr ""
"Une barre de savon coupée en copeaux utilisables dans une machine à laver."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "lye"
msgid_plural "lye"
msgstr[0] "soude"
msgstr[1] "soude"
msgstr[2] "soude"

#. ~ Description of "lye"
#: data/json/items/chemicals_and_resources.json
msgid ""
"This is a liquid form of sodium hydroxide.  It is highly corrosive; handle "
"with care."
msgstr ""
"Une solution liquide d'hydroxide de sodium. Hautement corrosif, à manipuler "
"avec précautions."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "potassium lye"
msgid_plural "potassium lye"
msgstr[0] "hydroxyde de potassium"
msgstr[1] "hydroxyde de potassium"
msgstr[2] "hydroxyde de potassium"

#. ~ Description of "potassium lye"
#: data/json/items/chemicals_and_resources.json
msgid ""
"This is a liquid form of potassium hydroxide.  It is highly corrosive; "
"handle with care."
msgstr ""
"Une solution liquide d'hydroxide de potassium. Hautement corrosif, à "
"manipuler avec précautions."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "nanomaterial canister"
msgid_plural "nanomaterial canisters"
msgstr[0] "baril de nano-matériel"
msgstr[1] "barils de nano-matériel"
msgstr[2] "barils de nano-matériel"

#. ~ Description of "nanomaterial canister"
#: data/json/items/chemicals_and_resources.json
msgid ""
"Steel canisters containing carbon, iron, titanium, copper and other elements"
" in specifically engineered atomic-scale configurations.  A nanofabricator "
"can assemble them into usable items."
msgstr ""
"Bidons en acier contenant du carbone, fer, titane, cuivre, et d'autres "
"éléments dans des configurations spécifiques au niveau atomique. Un "
"nanofabricateur peut les transformer en objets utilisables."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "wood ash"
msgid_plural "wood ashes"
msgstr[0] "cendre de bois"
msgstr[1] "cendres de bois"
msgstr[2] "cendres de bois"

#. ~ Description of "wood ash"
#: data/json/items/chemicals_and_resources.json
msgid ""
"This is almost-weightless residue left after the burning of some substance."
msgstr ""
"Ceci est le résidu très léger laissé après la combustion d'une substance."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "corpse ash"
msgid_plural "corpse ashes"
msgstr[0] "cendre de cadavre"
msgstr[1] "cendre de cadavre"
msgstr[2] "cendre de cadavre"

#. ~ Description of "corpse ash"
#: data/json/items/chemicals_and_resources.json
msgid "The unburnt remains of a person or animal."
msgstr "Les restes incombustibles d'une personne ou d'un animal."

#. ~ 0.7134 g/cm3
#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "ether"
msgid_plural "ether"
msgstr[0] "ether"
msgstr[1] "ether"
msgstr[2] "ether"

#. ~ 0.7134 g/cm3
#. ~ Description of "ether"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A useful industrial solvent, and the first inhalative anesthetic in "
"widespread use.  Its uncomfortable side effects and tendency to explode "
"caused it to fall out of favor decades ago in the developed world.  If you "
"can't get the good stuff, however, it might make a passable substitute."
msgstr ""

#. ~ 1.1004 g/cm3
#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "dimethyl sulfoxide"
msgid_plural "dimethyl sulfoxide"
msgstr[0] "diméthylsulfoxyde"
msgstr[1] "diméthylsulfoxyde"
msgstr[2] "diméthylsulfoxyde"

#. ~ 1.1004 g/cm3
#. ~ Description of "dimethyl sulfoxide"
#: data/json/items/chemicals_and_resources.json
msgid ""
"Dimethyl sulfoxide, or DMSO, is a common and important aprotic solvent, "
"capable of dissolving a huge range of things.  It has the weird property "
"that it absorbs very quickly through the skin, causing a garlic flavor in "
"the mouth, even if it touched your arm."
msgstr ""

#. ~ 1.489 g/cm3 at 25C
#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "chloroform"
msgid_plural "chloroform"
msgstr[0] "chloroforme"
msgstr[1] "chloroforme"
msgstr[2] "chloroforme"

#. ~ 1.489 g/cm3 at 25C
#. ~ Description of "chloroform"
#: data/json/items/chemicals_and_resources.json
msgid ""
"Famous for its properties as an illicit sedative, this substance is also a "
"very good solvent.  In particular, it's used a lot in nuclear magnetic "
"resonance spectroscopy."
msgstr ""

#. ~ 1.07 g/cm3
#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "phenol"
msgid_plural "phenol"
msgstr[0] "phénol"
msgstr[1] "phénol"
msgstr[2] "phénol"

#. ~ 1.07 g/cm3
#. ~ Description of "phenol"
#: data/json/items/chemicals_and_resources.json
msgid ""
"This useful stuff is a potent solvent and has a wide range of reactive "
"applications.  It can be used to make a huge number of plastics and "
"polymers, it can be an antiseptic, it can strip paint and break down epoxy, "
"and it can burn your skin away like tissue paper under a heat gun.  Wear "
"gloves."
msgstr ""

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "benzene"
msgid_plural "benzene"
msgstr[0] "benzène"
msgstr[1] "benzène"
msgstr[2] "benzène"

#. ~ Description of "benzene"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A colorless highly flammable liquid with a sweet odor, one of the elementary"
" petrochemicals.  Being used primarily as a precursor to the manufacture of "
"chemicals with more complex structure, it's a major industrial chemical, but"
" finds limited use in consumer items because of its toxicity."
msgstr ""

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "toluene"
msgid_plural "toluene"
msgstr[0] "toluène"
msgstr[1] "toluène"
msgstr[2] "toluène"

#. ~ Description of "toluene"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A colorless toxic and highly flammable liquid which smells like paint "
"thinner.  It's predominantly used as an industrial feedstock and a solvent, "
"and is also used as an intoxicative inhalant in a manner unintended by "
"manufacturers."
msgstr ""

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "glycerol"
msgid_plural "glycerol"
msgstr[0] "glycérol"
msgstr[1] "glycérol"
msgstr[2] "glycérol"

#. ~ Description of "glycerol"
#: data/json/items/chemicals_and_resources.json
msgid ""
"Also called glycerin, this clear, odorless liquid is both a handy skin "
"moisturizer and an ingredient necessary to make dynamite."
msgstr ""

#. ~ Bulk density is around 0.5 g/mL
#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "peptone broth powder"
msgid_plural "peptone broth powder"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Bulk density is around 0.5 g/mL
#. ~ Description of "peptone broth powder"
#: data/json/items/chemicals_and_resources.json
msgid ""
"This is a pre-mixed salty solution of protein and sugar.  It's meant for "
"bacteria to eat, but if you were desperate, you could eat it too; it's not "
"much different from cup noodle stock."
msgstr ""

#. ~ Bulk density is around 0.55 g/mL
#. ~ Item name
