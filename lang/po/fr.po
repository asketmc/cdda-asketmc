msgid_plural "pickaxes"
msgstr[0] "pioche"
msgstr[1] "pioches"
msgstr[2] "pioches"

#. ~ Description of "pickaxe"
#: data/json/items/tool/workshop.json
msgid ""
"This is a large steel pickaxe, suitable for breaking up hard things or (with"
" enough skill) hard targets.  Strike the earth!"
msgstr ""
"Une grosse pioche en acier, idéale pour casser des choses dures ou (avec la "
"compétence nécessaire) les cibles difficiles. Frapper la terre!"

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "bronze pickaxe"
msgid_plural "bronze pickaxes"
msgstr[0] "pioche en bronze"
msgstr[1] "pioches en bronze"
msgstr[2] "pioches en bronze"

