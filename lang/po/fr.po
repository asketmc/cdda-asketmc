msgstr "\"Si tu le construis, il viendra.\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Hasta la vista, baby.\""
