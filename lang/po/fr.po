msgstr[0] "kit d'abri"
msgstr[1] "kits d'abri"
msgstr[2] "kits d'abri"

#. ~ Description of "shelter kit"
#: data/json/items/tool/shelters.json
msgid "This is a small shelter, made of sticks and skins.  Use it to place."
msgstr ""
"Un petit abri fabriqué avec des peaux et des bâtons. Activez le pour "
"l'installer."

#. ~ Item name
