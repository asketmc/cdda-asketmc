#. ~ Overmap terrain name
#: data/mods/Aftershock/maps/overmap_terrain.json
msgid "astrobiology lab"
msgstr "laboratoire d'astrobiologie"

#. ~ Overmap terrain name
#: data/mods/Aftershock/maps/overmap_terrain.json
msgid "county mortuary"
msgstr "morgue du comté"

#. ~ Overmap terrain name
#: data/mods/Aftershock/maps/overmap_terrain.json
