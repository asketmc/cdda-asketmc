msgid "wooden armor"
msgstr "armure en bois"

#. ~ Description of vehicle part "spiked plating"
#: data/json/vehicleparts/vehicle_parts.json
msgid ""
"A spiked plate that will increase the damage delivered to someone else in "
"collisions."
msgstr ""
"Une plaque hérissée qui augmentera les dégâts subis par quelque chose "
"heurtant le véhicule."

#. ~ Vehicle part name
#: data/json/vehicleparts/vehicle_parts.json
msgid "military composite armor plating"
msgstr ""

#. ~ Description of vehicle part "bicycle horn"
#: data/json/vehicleparts/vehicle_parts.json
msgid ""
"A small horn.  Use the vehicle controls and select the honk option to make "
"noise."
msgstr ""
"Un petit klaxon. Utilisez les options de contrôle de véhicule et "
"sélectionnez l'option \"klaxonner\" pour faire du bruit avec."

#. ~ Description of vehicle part "car horn"
#: data/json/vehicleparts/vehicle_parts.json
msgid ""
"A horn.  Use the vehicle controls and select the honk option to make noise."
msgstr ""
"Un klaxon. Utilisez les options de contrôle de véhicule et sélectionnez "
"l'option \"klaxonner\" pour faire du bruit avec."

#. ~ Description of vehicle part "truck horn"
#: data/json/vehicleparts/vehicle_parts.json
msgid ""
"A powerful truck horn.  Use the vehicle controls and select the honk option "
"to make noise."
msgstr ""
"Un puissant klaxon de camion. Utilisez les options de contrôle de véhicule "
"et sélectionnez l'option \"klaxonner\" pour faire du bruit avec."

#. ~ Description of vehicle part "back-up beeper"
#: data/json/vehicleparts/vehicle_parts.json
msgid ""
"An electronic noise maker.  It will automatically make noise when you drive "
"in reverse, alerting things behind you to move out of the way."
msgstr ""

