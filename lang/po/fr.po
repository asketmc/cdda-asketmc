msgstr[1] "marteaux"
msgstr[2] "marteaux"

#. ~ Description of "hammer"
#: data/json/items/tool/workshop.json
msgid ""
"This is a demagnetized steel claw hammer with a wooden grip.  With a hammer,"
" nails, and planks in your inventory, you could board up adjacent doors and "
"windows.  It has myriad other uses as well."
msgstr ""

#. ~ Item name
#: data/json/items/tool/workshop.json
msgid "hand drill"
msgid_plural "hand drills"
msgstr[0] "chignole"
msgstr[1] "chignoles"
msgstr[2] "chignoles"

