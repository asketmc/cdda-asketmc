#: data/json/npcs/refugee_center/surface_staff/NPC_free_merchant_teamster.json
msgid "Thanks for the directions.  I'll check it out."
msgstr ""

#. ~ Mission name
#: data/json/npcs/Backgrounds/OtherSurvivorStories/Brigitte_LaCroix_Background.json
msgid "Check out that graveyard"
msgstr ""

#. ~ Description of mission "Check out that graveyard"
#. ~ Dialogue line in mission "Check out that graveyard"
