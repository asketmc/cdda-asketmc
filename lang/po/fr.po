msgid_plural "bulldogs"
msgstr[0] "bulldog"
msgstr[1] "bulldogs"
msgstr[2] "bulldogs"

#. ~ Description of monster "bulldog"
#: data/json/monsters/mammal.json
msgid ""
"The American bulldog is a hardy, well-built dog that seems suited for "
"surviving the apocalypse."
msgstr ""

#. ~ Monster name
#: data/json/monsters/mammal.json
msgid "bulldog puppy"
msgid_plural "bulldog puppies"
msgstr[0] "bulldog (chiot)"
msgstr[1] "bulldogs (chiots)"
msgstr[2] "bulldogs (chiots)"

#. ~ Description of monster "bulldog puppy"
#: data/json/monsters/mammal.json
