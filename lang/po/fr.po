"Êtes-vous sûr d'avoir terminé ? Le nom du monde sera généré aléatoirement."

#: src/worldfactory.cpp:1889
msgid "Are you sure you want to reset this world?"
msgstr "Êtes-vous sûr de vouloir réinitialiser ce monde?"

#: src/worldfactory.cpp:1918
msgid ""
"Currently using customized advanced options.  Reset world options to "
"defaults?"
msgstr ""
"Vous utilisez actuellement des options avancées customisées. Voulez-vous "
"réinitialiser ces options à leurs valeurs par défaut?"

#: src/worldfactory.cpp:1951
msgid "Do you want to abort World Generation?"
msgstr "Voulez-vous annuler la création du Monde?"

#: src/worldfactory.cpp:2005
#, c-format
msgid ""
"[<color_yellow>%s</color>] = save <color_cyan>Mod Load Order</color> as "
"default <color_red>|</color> "
"[<color_yellow>%s</color>/<color_yellow>%s</color>] = switch Main-Tab "
"<color_red>|</color> [<color_yellow>%s</color>/<color_yellow>%s</color>] = "
"switch <color_cyan>Mod List</color> and <color_cyan>Mod Load Order</color> "
"<color_red>|</color> [<color_yellow>%s</color>/<color_yellow>%s</color>] = "
"switch <color_cyan>Mod List</color> Tab <color_red>|</color> "
"[<color_yellow>%s</color>] = keybindings"
msgstr ""
"[<color_yellow>%s</color>] = sauvegarde <color_cyan>Ordre de Chargement de "
"Mods</color> par défaut <color_red>|</color> "
"[<color_yellow>%s</color>/<color_yellow>%s</color>] = changer Onglet "
"Principal <color_red>|</color> "
"[<color_yellow>%s</color>/<color_yellow>%s</color>] = changer "
"<color_cyan>Liste de Mods</color> et <color_cyan>Ordre de Chargement de "
"Mods</color> <color_red>|</color> "
"[<color_yellow>%s</color>/<color_yellow>%s</color>] = changer "
"<color_cyan>Liste de Mods</color> Onglet  <color_red>|</color> "
"[<color_yellow>%s</color>] = raccourcis"

