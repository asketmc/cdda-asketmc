#. ~ Dialogue line in mission "Emancipation"
#: data/json/npcs/valhalla_cult/missions.json
msgid "The world will be a better place without thieves walking its surface."
msgstr ""

#. ~ Dialogue line in mission "Emancipation"
#: data/json/npcs/valhalla_cult/missions.json
