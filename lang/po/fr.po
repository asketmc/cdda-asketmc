msgstr[1] "radios (on)"
msgstr[2] "radios (on)"

#. ~ Description of "radio (on)"
#: data/json/items/tool/radio_tools.json
msgid ""
"This portable radio is turned on, and continually draining its batteries.  "
"It is playing the broadcast being sent from any nearby radio towers."
msgstr ""
"Cette radio portable est active, et draine ses piles. Vous pouvez entendre "
"les émissions envoyées par les tours radio les plus proches."

#. ~ Item name
#: data/json/items/tool/radio_tools.json
msgid "two-way radio"
msgid_plural "two-way radios"
msgstr[0] "radio bidirectionnelle"
msgstr[1] "radios bidirectionnelles"
msgstr[2] "radios bidirectionnelles"

#. ~ Description of "two-way radio"
#: data/json/items/tool/radio_tools.json
msgid ""
"This is a radio with a transmitting unit.  You could use it to contact "
"someone who also has one.  Unfortunately no one seems to use those nowadays…"
msgstr ""

