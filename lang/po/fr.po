msgstr[1] "chihuahuas"
msgstr[2] "chihuahuas"

#. ~ Description of monster "Chihuahua"
#: data/json/monsters/mammal.json
msgid ""
"It's a tiny Chihuahua.  How it has managed to survive is a miracle, although"
" its small size and aggressive nature may have proven useful."
msgstr ""

#. ~ Monster name
#: data/json/monsters/mammal.json
