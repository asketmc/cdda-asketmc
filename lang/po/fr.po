#: data/json/proficiencies/weakpoints.json
msgid "Beetle Anatomy"
msgstr "Anatomie Coléoptèrienne"

#. ~ Description of proficiency "Beetle Anatomy"
#: data/json/proficiencies/weakpoints.json
msgid ""
"You are familiar with the anatomy of mutated beetles - bypassing their thick"
" armor should be easier."
msgstr ""

#. ~ Proficiency name
#: data/json/proficiencies/weakpoints.json
msgid "Centipede Anatomy"
msgstr "Anatomie Chilopodienne"

#. ~ Description of proficiency "Centipede Anatomy"
#: data/json/proficiencies/weakpoints.json
msgid ""
"You are familiar with the anatomy of mutated centipedes, letting you target "
"their less-deadly parts with ease."
msgstr ""

#. ~ Proficiency name
#: data/json/proficiencies/weakpoints.json
msgid "Hymenopteran Anatomy"
msgstr "Anatomie Hyménoptèrienne"

#. ~ Description of proficiency "Hymenopteran Anatomy"
#: data/json/proficiencies/weakpoints.json
msgid ""
"Familiarity with the comparative anatomy of mutant Hymenopterans - ants, "
"bees, and wasps of all kinds.  You find it easier to exploit their weak "
"points, and possibly disable their natural weaponry."
msgstr ""

#. ~ Proficiency name
#: data/json/proficiencies/weakpoints.json
msgid "Arachnid Anatomy"
msgstr "Anatomie Arachnéenne"

#. ~ Description of proficiency "Arachnid Anatomy"
#: data/json/proficiencies/weakpoints.json
msgid ""
"You are familiar with the anatomy of mutated spiders of all shapes and "
"sizes."
msgstr ""

#. ~ Proficiency name
#: data/json/proficiencies/weakpoints.json
msgid "Creatures of Flight"
msgstr "Anatomie des Créatures Volantes"

#. ~ Description of proficiency "Creatures of Flight"
#: data/json/proficiencies/weakpoints.json
msgid ""
"Basic understanding of what's needed for certain creatures to fly, as well "
"as ways of preventing it."
msgstr ""

#. ~ Proficiency name
#: data/json/proficiencies/weakpoints.json
msgid "Ossified Exoskeletons"
msgstr "Exosquelettes Ossifiés"

#. ~ Description of proficiency "Ossified Exoskeletons"
#: data/json/proficiencies/weakpoints.json
msgid ""
"You're familiar with creatures presenting unsettling bones on their outer "
"structure."
msgstr ""

#. ~ Proficiency name
#: data/json/proficiencies/weakpoints.json
