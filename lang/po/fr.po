msgid "transparent rain coat"
msgid_plural "transparent rain coats"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "transparent rain coat"
#: data/mods/Aftershock/items/armor/cyberpunk.json
msgid "A mostly transparent raincoat with no pockets.  Essential urban wear."
msgstr ""

