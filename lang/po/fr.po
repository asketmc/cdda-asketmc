msgid ""
"Disposable ballpoint pen, offers a smooth writing experience on paper.  "
"Shares the same logo as those disposable lighters.  This pen is black."
msgstr ""

#. ~ Item name
#: data/json/items/tool/stationary.json
msgid "blue pen"
msgid_plural "blue pens"
msgstr[0] "stylo bleu"
msgstr[1] "stylos bleus"
msgstr[2] "stylos bleus"

#. ~ Description of "blue pen"
#: data/json/items/tool/stationary.json
