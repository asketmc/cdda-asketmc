#. ~ Bashing failed sound of furniture "everfrost crystal"
#: data/mods/Magiclysm/furniture.json
msgid "mana crackling!"
msgstr "crépitements de mana!"

#. ~ Furniture name
#: data/mods/Magiclysm/furniture.json
msgid "stone altar"
msgstr "autel en pierre"

#. ~ Description of furniture "stone altar"
#: data/mods/Magiclysm/furniture.json
