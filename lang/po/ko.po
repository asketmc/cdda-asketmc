msgid "tiny pistol ammo, JHP (black powder)"
msgid_plural "tiny pistol ammo, JHP (black powder)"
msgstr[0] "초소형 권총탄, JHP (흑색 화약)"

#. ~ Item name
#: data/mods/Generic_Guns/ammo/pistol_tiny.json
msgid "pistol blank"
msgid_plural "pistol blank"
