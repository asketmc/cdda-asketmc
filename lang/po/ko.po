#: data/json/items/tool/lighting.json
msgid "lightstrip (inactive)"
msgid_plural "lightstrips (inactive)"
msgstr[0] "케이블 조명 (미사용)"

#. ~ This doesn't make too much sense, flavor-wise, but it's the best I can
#. come up with.  Put it on the todo list.
#. ~ Description of "lightstrip (inactive)"
#: data/json/items/tool/lighting.json
msgid ""
"This is a light-emitting circuit that can be wired directly to a battery.  "
"It provides some weak light and can't be turned off until the battery dies."
msgstr ""

#. ~ "msg" action message of item "lightstrip (inactive)"
#: data/json/items/tool/lighting.json
