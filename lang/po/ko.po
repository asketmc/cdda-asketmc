msgid "slave"
msgstr "노예"

#. ~ Name of an NPC class
#: data/json/npcs/slaves/npcs.json
msgid "Slave"
msgstr ""

#. ~ Job description of "Slave" NPC class
#: data/json/npcs/slaves/npcs.json
