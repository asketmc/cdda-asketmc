#: data/mods/Magiclysm/items/enchanted_melee.json
msgid "warhammer +1"
msgid_plural "warhammers +1"
msgstr[0] "워해머 +1"

#. ~ Item name
#: data/mods/Magiclysm/items/enchanted_melee.json
