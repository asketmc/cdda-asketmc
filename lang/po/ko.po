#. ~ Snippet in category "PORTAL_DEPENDENT_MESSAGES_VARIED_BAD"
#: data/json/snippets/effect_on_conditions.json
msgid "Some sparks appear in front of you for a brief moment."
msgstr ""

#. ~ Snippet in category "PORTAL_DEPENDENT_MESSAGES_VARIED_BAD"
#: data/json/snippets/effect_on_conditions.json
