#: data/json/items/tool/metalworking.json
msgid "These are long, metal tongs.  They are commonly used for cooking."
msgstr "긴 금속 집게. 주로 요리에 쓰입니다."

#. ~ Item name
#: data/json/items/tool/metalworking.json
msgid "pair of flatjaw tongs"
msgid_plural "pairs of flatjaw tongs"
msgstr[0] "납작한 집게"

