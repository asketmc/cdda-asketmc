#. ~ Description of "lump of mithril"
#: data/mods/Magiclysm/items/metals.json
msgid ""
"A lump of raw mithril.  Needs to be reformed into an ingot to be useful."
msgstr "미스릴 덩어리. 사용하려면 주괴로 바꿔야 합니다."

#. ~ density of aluminum
#. ~ Item name
#: data/mods/Magiclysm/items/metals.json
msgid "mithril ingot"
msgid_plural "mithril ingots"
msgstr[0] "미스릴 주괴"

#. ~ density of aluminum
#. ~ Description of "mithril ingot"
#: data/mods/Magiclysm/items/metals.json
msgid ""
"An ingot of mithril.  About 3cm by 7cm by 12cm in size, ready to be used for"
