msgstr "놋쇠 카우벨. 이런 게 더 필요한 것 같은 느낌이 듭니다."

#. ~ Item name
#: data/json/items/tool/misc.json
msgid "crystal urn"
msgid_plural "crystal urns"
msgstr[0] "크리스탈 유골 단지"

#. ~ Description of "crystal urn"
#: data/json/items/tool/misc.json
