msgid_plural "tiny flying fish"
msgstr[0] ""

#. ~ Description of monster "tiny flying fish"
#: data/mods/TropiCataclysm/monsters/tropical_nether.json
msgid "A tiny flying fish."
msgstr ""

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_nether.json
