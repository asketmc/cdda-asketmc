msgstr "종이 바닥"

#. ~ Description of terrain "paper floor"
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "Floor made of pulpy mass, covered in sticky wasp saliva."
msgstr "끈적한 말벌 타액으로 덮인, 펄프질 물질로 만들어진 바닥입니다."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "hard paper floor"
msgstr "단단한 종이 바닥"

#. ~ Description of terrain "hard paper floor"
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"Hardened cardboard floor made of chewed up trees and resin mixed with wasp "
"saliva."
msgstr ""

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "paper brood cap"
msgstr ""

#. ~ Description of terrain "paper brood cap"
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"A thin paper floor, protecting the pupating wasp larva until it's ready to "
"emerge."
msgstr ""

